        _record_size('time_analysis_section(总)', time_analysis_section)
        _record_size('input_all_total_list', f'count={len(all_total_list)}', is_html=False)
        # 同时按维度单独统计
        for _key in time_analysis_info:
            if _key.startswith('by_'):
                _dim_html = time_analysis_info[_key].get('html', '')
                _record_size(f'time_analysis[{_key}]', _dim_html)
        
        # 4. 详情部分
        detail_header = ('<section id="detail-section">'
                         '<div style="display: flex; justify-content: space-between; align-items: center;">'
                         '<h2>SQL详情列表</h2>'
                         '<a href="#top10-ranking" class="back-to-top" title="返回Top 10排名" onclick="collapseAllDetails()">↑ Top 10</a>'
                         '</div>')
        detail_html_parts = [detail_header + '<table class="detail-table"><thead>']
        detail_html_parts.append("""
        <tr>
            <th>Unique ID<span class="col-divider"></span></th>
            <th>IP<span class="col-divider"></span></th>
            <th>Database<span class="col-divider"></span></th>
            <th>User<span class="col-divider"></span></th>
