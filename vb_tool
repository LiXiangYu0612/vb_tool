# _osw_netstat_one <interface> <file>  -- analyze ONE oswnetstat archive file.
# Prints the delta table for the given interface. Returns 1 on format/interface error.

_osw_netstat_one() {
    local INTERFACE="$1"
    local LOG_FILE="$2"

    if [[ ! -f "$LOG_FILE" ]]; then
        echo "Error: file not found: $LOG_FILE" >&2
