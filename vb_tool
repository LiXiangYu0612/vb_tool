    def _sess_sum(rows):
        _vals = [to_num(r.get("total", 0) or 0) for r in rows]
        _n = len(_vals); _s = sum(_vals)
        return (_n, _s, (_s / _n if _n else 0), (max(_vals) if _vals else 0))
    _bs = _sess_sum(win["db"].get(("begin", "session_by_sess"), []))
    _es = _sess_sum(win["db"].get(("end", "session_by_sess"), []))
