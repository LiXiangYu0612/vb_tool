            max_execute_stmt = f"execute bind_sql({', '.join(stat['max_param_values'])});" if stat['max_param_values'] else "execute bind_sql;"
            min_execute_stmt = f"execute bind_sql({', '.join(stat['min_param_values'])});" if stat['min_param_values'] else "execute bind_sql;"

            qry_text_full = stat['qry_text']
            is_qry_long = len(qry_text_full) > MAX_HTML_INLINE_SQL_LEN
            max_execute_html = html.escape(max_execute_stmt, quote=True)
            min_execute_html = html.escape(min_execute_stmt, quote=True)

            def _build_prepared_text(query_template, execute_stmt, params_text=''):
                """预先生成完整 Prepared 语句文本（与前端 generatePreparedStatement 逻辑一致）。

                参数类型优先取 parameters 日志的 type = xxx 标注，缺失时回退 text。
                """
                types_pipe = _prepare_param_types(query_template, params_text)
                if types_pipe:
                    decl = f"bind_sql({', '.join(types_pipe.split('|'))})"
                else:
                    # 无绑定变量时不带括号: prepare bind_sql as ...
                    decl = 'bind_sql'
                return f"prepare {decl} as {query_template.strip()};\n{execute_stmt}"

            # 列表 Query Text 列：截断展示(独立阈值控制 HTML 体积)
            qry_text_cell = html.escape(qry_text_full[:MAX_HTML_INLINE_SQL_LEN], quote=True)
