    #   hostname(端口) 形态, 两解析器判定口径一致
    pattern = r'(\d{1,3}\.){3}\d{1,3}\(\d+\)|[a-zA-Z0-9_-]*[.-][a-zA-Z0-9._-]*\(\d+\)|\[local\]'
