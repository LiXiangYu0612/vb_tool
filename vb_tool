        if [ -z "${_VB_TOOL_SUBS[$cmd]+x}" ]; then
            # timeout guard: a few commands treat "help" as an argument and
            # start real work (e.g. net) -- never let TAB freeze the shell;
            # the empty result is cached so the probe runs once per shell
            h="$( timeout 2 "${_VB_TOOL_BIN:-vb_tool}" "$cmd" help 2>/dev/null )"
            _VB_TOOL_SUBS[$cmd]="$( printf '%s\n' "$h" \
                | sed -n "s/^Usage: vb_tool $cmd <\([^>]*\)>.*/\1/p" | head -1 \
                | awk -F'|' 'NF>1{for(i=1;i<=NF;i++) printf "%s ", $i}' )"
            if [ -z "${_VB_TOOL_SUBS[$cmd]}" ]; then
                _VB_TOOL_SUBS[$cmd]="$( printf '%s\n' "$h" \
                    | awk '/^ *Types:/{f=1;next} f && /^    [a-z]/{print $1} f && /^[^ ]/{exit}' | tr '\n' ' ' )"
            fi
        fi
        [ -n "${_VB_TOOL_SUBS[$cmd]}" ] && COMPREPLY=( $(compgen -W "${_VB_TOOL_SUBS[$cmd]}" -- "$cur") )
    fi
