                    border-radius: 3px;
                }}
                
                /* 响应式 */
                @media (max-width: 768px) {{
                    .stats-grid {{ grid-template-columns: 1fr; }}
                    .top10-container {{ grid-template-columns: 1fr; }}
                    .nav-links {{ flex-direction: column; }}
                    .nav-links a {{ width: 100%; text-align: center; }}
                }}
            </style>
        </head>
        <body>
            {nav_html}
            
            <!-- 汇总统计部分 -->
            {summary_section}

            <!-- 错误日志分析部分 -->
            {error_section_html}

            <!-- 锁/死锁详情分析部分 -->
            {lock_section_html}
            
            <!-- 分时段分析部分 -->
            {time_analysis_section}
            
            <!-- SQL详情部分 -->
            {detail_section}
            
            <!-- 内联JavaScript -->
            <script>
                // 图表数据
                const chartData = {chart_js_data_json};
                
                // 复制到剪贴板函数
                function copyToClipboard(button) {{
                    const text = JSON.parse(button.getAttribute('data-copy-text'));
                    const originalText = button.textContent;
                    const copiedClass = 'copied';
                    const reset = () => {{
                        button.textContent = originalText;
                        button.classList.remove(copiedClass);
                    }};
                    const markCopied = () => {{
                        button.textContent = '已复制';
                        button.classList.add(copiedClass);
                        setTimeout(reset, 600);
                    }};
                    if (navigator.clipboard && window.isSecureContext) {{
                        navigator.clipboard.writeText(text).then(() => {{
                            markCopied();
                        }}, (err) => {{
                            console.error('无法复制文本: ', err);
                            reset();
                        }});
                    }} else {{
                        const textArea = document.createElement("textarea");
                        textArea.value = text;
                        textArea.style.position = "fixed";
                        textArea.style.left = "-999999px";
                        textArea.style.top = "-999999px";
                        document.body.appendChild(textArea);
                        textArea.focus();
                        textArea.select();
                        try {{
                            document.execCommand('copy');
                            markCopied();
                        }} catch (err) {{
                            console.error('无法复制文本: ', err);
                            reset();
                        }}
                        document.body.removeChild(textArea);
                    }}
                }}

                // 下载内嵌文本：data-sql-b64 为 Base64 编码内容，点击时解码并通过 Blob 触发 txt 下载
                // 用于超长 SQL / Prepared 语句，避免完整文本直接塞进 DOM 影响渲染性能
                function downloadEmbeddedText(button) {{
                    const b64 = button.getAttribute('data-sql-b64') || '';
                    const filename = button.getAttribute('data-filename') || 'download.txt';
                    if (!b64) {{ alert('无可下载内容'); return; }}
                    try {{
                        // Base64 -> Uint8Array（按字节处理，避免中文等多字节字符乱码）
                        const binStr = atob(b64);
                        const len = binStr.length;
                        const bytes = new Uint8Array(len);
                        for (let i = 0; i < len; i++) {{ bytes[i] = binStr.charCodeAt(i); }}
                        const blob = new Blob([bytes], {{ type: 'text/plain;charset=utf-8' }});
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = filename;
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        URL.revokeObjectURL(url);
                    }} catch (err) {{
                        console.error('下载失败: ', err);
                        alert('下载失败: ' + err);
                    }}
                }}

                // 生成Prepared语句
                function generatePreparedStatement(button) {{
                    const queryTemplate = button.getAttribute('data-query-template');
                    const executeStmt = button.getAttribute('data-execute-stmt');
                    
                    // 提取参数占位符
                    const paramPattern = /\\$([0-9]+)/g;
                    const matches = [];
                    let match;
                    while ((match = paramPattern.exec(queryTemplate)) !== null) {{
                        matches.push(parseInt(match[1]));
                    }}
                    
                    // 生成参数类型声明（简化处理，均为text类型）
                    const paramTypes = Array(matches.length).fill('text');
                    const paramTypesStr = paramTypes.join(', ');
                    
                    // 生成prepare语句
                    const preparedName = 'bind_sql';
                    const prepareStmt = `prepare ${{preparedName}}(${{paramTypesStr}}) as ${{queryTemplate.trim()}};`;
                    
                    // 组合完整语句
                    const fullStmt = prepareStmt + '\\n' + executeStmt;
                    
                    // 复制到剪贴板
                    if (navigator.clipboard && window.isSecureContext) {{
                        navigator.clipboard.writeText(fullStmt).then(() => {{
                            alert('Prepared语句已复制到剪贴板!\\n 默认全部使用的text类型，注意语句中的实际数据类型');
                        }}, (err) => {{
                            console.error('无法复制文本: ', err);
                        }});
                    }} else {{
                        const textArea = document.createElement("textarea");
                        textArea.value = fullStmt;
                        textArea.style.position = "fixed";
                        textArea.style.left = "-999999px";
                        textArea.style.top = "-999999px";
                        document.body.appendChild(textArea);
                        textArea.focus();
                        textArea.select();
                        try {{
                            document.execCommand('copy');
                            alert('Prepared语句已复制到剪贴板!\\n 默认全部使用的text类型，注意语句中的实际数据类型');
                        }} catch (err) {{
                            console.error('无法复制文本: ', err);
                        }}
                        document.body.removeChild(textArea);
                    }}
                }}
                
                // 绘制饼图
                function renderPieChart(containerId, data) {{
                    const container = document.getElementById(containerId);
                    if (!container) {{
                        console.error('Pie chart container not found:', containerId);
                        return;
                    }}
                    
                    if (!data || data.length === 0) {{
                        container.innerHTML = '<div style="padding: 40px; text-align: center; color: #999;">暂无数据</div>';
                        return;
                    }}
                    
                    const width = 400, height = 400;
                    const radius = Math.min(width, height) / 2 - 20;
                    const centerX = width / 2, centerY = height / 2;
                    
                    let svg = `<svg width="${{width}}" height="${{height}}" viewBox="0 0 ${{width}} ${{height}}">`;
                    
                    // 计算总和和起始角度
                    const total = data.reduce((sum, item) => sum + item.count, 0);
                    let startAngle = 0;
                    
                    // 绘制扇形
                    data.forEach(item => {{
                        const percent = item.count / total;
                        const endAngle = startAngle + percent * 2 * Math.PI;
                        
                        // 计算扇形路径
                        const x1 = centerX + radius * Math.cos(startAngle);
                        const y1 = centerY + radius * Math.sin(startAngle);
                        const x2 = centerX + radius * Math.cos(endAngle);
                        const y2 = centerY + radius * Math.sin(endAngle);
                        
                        let pathData;
                        // 特殊处理：当只有一个数据项（100%）时，直接绘制完整圆形
                        if (data.length === 1) {{
                            pathData = `M ${{centerX}} ${{centerY - radius}} A ${{radius}} ${{radius}} 0 1 1 ${{centerX - 0.01}} ${{centerY - radius}} Z`;
                        }} else {{
                            const largeArcFlag = percent > 0.5 ? 1 : 0;
                            pathData = [
                                `M ${{centerX}} ${{centerY}}`,
                                `L ${{x1}} ${{y1}}`,
                                `A ${{radius}} ${{radius}} 0 ${{largeArcFlag}} 1 ${{x2}} ${{y2}}`,
                                'Z'
                            ].join(' ');
                        }}
                        
                        svg += `<path d="${{pathData}}" fill="${{item.color}}" stroke="white" stroke-width="2" 
                                  data-name="${{item.name}}" data-count="${{item.count}}" data-percent="${{(percent*100).toFixed(1)}}%"
                                  onmouseover="showTooltip(event, '${{item.name}}: ${{item.count}}条 (${{(percent*100).toFixed(1)}}%)')"
                                  onmouseout="hideTooltip()">`;
                        svg += `<title>${{item.name}}: ${{item.count}}条 (${{(percent*100).toFixed(1)}}%)</title>`;
                        svg += `</path>`;
                        
                        startAngle = endAngle;
                    }});
                    
                    // 添加中心文字
                    svg += `<circle cx="${{centerX}}" cy="${{centerY}}" r="${{radius*0.3}}" fill="white" stroke="#ddd" stroke-width="1"/>`;
                    svg += `<text x="${{centerX}}" y="${{centerY-10}}" text-anchor="middle" font-weight="bold" font-size="16">总计</text>`;
                    svg += `<text x="${{centerX}}" y="${{centerY+15}}" text-anchor="middle" font-size="14">${{total}} 条</text>`;
                    
                    svg += `</svg>`;
                    
                    container.innerHTML = svg;
                }}
                
                // 存储每个折线图的完整数据和视图状态
                const chartViews = {{}};

                // 绘制折线图
                function renderLineChart(containerId, fullChartData, title, viewRange = null) {{
                    const container = document.getElementById(containerId);
                    if (!container || !fullChartData.series || fullChartData.series.length === 0) {{
                        return;
                    }}

                    const fullTimeLabels = fullChartData.time_labels;
                    if (!fullTimeLabels || fullTimeLabels.length < 2) {{
                        container.innerHTML = '<div style="padding: 20px; text-align: center; color: #999;">数据点不足，无法生成折线图（至少需要2个时间点）</div>';
                        return;
                    }}

                    const hasValidData = fullChartData.series.some(s => {{
                        const validPoints = s.data.filter(v => v > 0).length;
                        return validPoints >= 2;
                    }});

                    if (!hasValidData) {{
                        container.innerHTML = '<div style="padding: 20px; text-align: center; color: #999;">有效数据点不足，无法生成折线图</div>';
                        return;
                    }}

                    // 确定当前视图范围
                    let startIndex = 0;
                    let endIndex = fullTimeLabels.length - 1;
                    if (viewRange) {{
                        startIndex = Math.max(0, Math.min(viewRange.startIndex, fullTimeLabels.length - 1));
                        endIndex = Math.max(startIndex, Math.min(viewRange.endIndex, fullTimeLabels.length - 1));
                    }}
                    // 视图范围至少包含2个点
                    if (endIndex - startIndex + 1 < 2) {{
                        startIndex = 0;
                        endIndex = fullTimeLabels.length - 1;
                    }}

                    // 存储/更新视图状态
                    if (!chartViews[containerId]) {{
                        chartViews[containerId] = {{ fullData: fullChartData, title: title }};
                    }}
                    chartViews[containerId].startIndex = startIndex;
                    chartViews[containerId].endIndex = endIndex;

                    // 截取当前视图的数据
                    const timeLabels = fullTimeLabels.slice(startIndex, endIndex + 1);
                    const seriesList = fullChartData.series.map(s => ({{
                        uid: s.uid,
                        uid_display: s.uid_display,
                        color: s.color,
                        data: s.data.slice(startIndex, endIndex + 1)
                    }}));

                    const width = 800, height = 400;
                    const margin = {{top: 30, right: 150, bottom: 50, left: 60}};
                    const chartWidth = width - margin.left - margin.right;
                    const chartHeight = height - margin.top - margin.bottom;

                    const allValues = seriesList.flatMap(s => s.data);
                    const maxValue = allValues.reduce((a, b) => Math.max(a, b), 0);

                    let lastValidIndex = timeLabels.length - 1;
                    const allLastZero = seriesList.every(s => s.data[s.data.length - 1] === 0);
                    if (allLastZero && lastValidIndex > 0) {{
                        lastValidIndex--;
                    }}

                    // 创建SVG
                    let svg = `<svg width="${{width}}" height="${{height}}" viewBox="0 0 ${{width}} ${{height}}" class="line-chart-svg">`;

                    const xScale = chartWidth / (lastValidIndex || 1);
                    const yScale = chartHeight / (maxValue || 1);

                    // 绘制网格线
                    for (let i = 0; i <= 5; i++) {{
                        const y = margin.top + chartHeight - (i * chartHeight / 5);
                        const value = (i * maxValue / 5).toFixed(1);
                        svg += `<line x1="${{margin.left}}" y1="${{y}}" x2="${{margin.left + chartWidth}}" y2="${{y}}" stroke="#eee" stroke-width="1"/>`;
                        svg += `<text x="${{margin.left - 10}}" y="${{y + 4}}" text-anchor="end" font-size="12" fill="#666">${{value}}</text>`;
                    }}

                    // 绘制时间标签
                    const labelInterval = Math.ceil((lastValidIndex + 1) / 10) || 1;
                    for (let i = 0; i <= lastValidIndex; i += labelInterval) {{
                        const x = margin.left + i * xScale;
                        svg += `<text x="${{x}}" y="${{margin.top + chartHeight + 20}}" text-anchor="middle" font-size="11" fill="#666" transform="rotate(45, ${{x}}, ${{margin.top + chartHeight + 20}})">${{timeLabels[i]}}</text>`;
                        svg += `<line x1="${{x}}" y1="${{margin.top + chartHeight}}" x2="${{x}}" y2="${{margin.top + chartHeight + 5}}" stroke="#666" stroke-width="1"/>`;
                    }}

                    // 绘制每条线
                    seriesList.forEach((series) => {{
                        if (series.data.length === 0 || series.data[0] === undefined) return;
                        let endIndexLocal = lastValidIndex;
                        if (endIndexLocal < 0) return;

                        let pathData = `M ${{margin.left}} ${{margin.top + chartHeight - series.data[0] * yScale}}`;
                        for (let i = 1; i <= endIndexLocal; i++) {{
                            const x = margin.left + i * xScale;
                            const y = margin.top + chartHeight - series.data[i] * yScale;
                            const prevX = margin.left + (i-1) * xScale;
                            const prevY = margin.top + chartHeight - series.data[i-1] * yScale;
                            const cp1x = prevX + xScale * 0.3;
                            const cp1y = prevY;
                            const cp2x = x - xScale * 0.3;
                            const cp2y = y;
                            pathData += ` C ${{cp1x}} ${{cp1y}}, ${{cp2x}} ${{cp2y}}, ${{x}} ${{y}}`;
                        }}

                        svg += `<path d="${{pathData}}" fill="none" stroke="${{series.color}}" stroke-width="3"
                                  data-uid="${{series.uid}}"
                                  onmouseover="highlightLine('${{series.uid}}', '${{containerId}}')"
                                  onmouseout="unhighlightLine('${{series.uid}}')"
                                  onclick="clickLine('${{series.uid}}')"
                                  style="cursor: pointer;"/>`;

                        for (let i = 0; i <= lastValidIndex; i++) {{
                            if (series.data[i] > 0) {{
                                const x = margin.left + i * xScale;
                                const y = margin.top + chartHeight - series.data[i] * yScale;
                                // 可见数据点
                                svg += `<circle cx="${{x}}" cy="${{y}}" r="4" fill="${{series.color}}"
                                          data-uid="${{series.uid}}" data-index="${{i}}" data-value="${{series.data[i]}}"
                                          onmouseover="showPointTooltip(event, '${{series.uid}}', '${{timeLabels[i]}}', ${{series.data[i]}}, '${{containerId}}')"
                                          onmouseout="hidePointTooltip(); unhighlightLine('${{series.uid}}')"
                                          onclick="clickLine('${{series.uid}}')"
                                          style="cursor: pointer; pointer-events: all;"/>`;
                                // 透明命中热区，覆盖更大区域以便鼠标容易命中
                                svg += `<circle cx="${{x}}" cy="${{y}}" r="10" fill="transparent"
                                          data-uid="${{series.uid}}" data-index="${{i}}" data-value="${{series.data[i]}}"
                                          onmouseover="showPointTooltip(event, '${{series.uid}}', '${{timeLabels[i]}}', ${{series.data[i]}}, '${{containerId}}')"
                                          onmouseout="hidePointTooltip(); unhighlightLine('${{series.uid}}')"
                                          onclick="clickLine('${{series.uid}}')"
                                          style="cursor: pointer; pointer-events: all;"/>`;
                            }}
                        }}
                    }});

                    // 添加图例
                    let legendY = margin.top;
                    seriesList.forEach(series => {{
                        const legendUid = series.uid_display || series.uid;
                        svg += `<g class="chart-legend-item" data-uid="${{series.uid}}">`;
                        svg += `<rect x="${{margin.left + chartWidth + 20}}" y="${{legendY}}" width="15" height="15" fill="${{series.color}}"/>`;
                        svg += `<text x="${{margin.left + chartWidth + 40}}" y="${{legendY + 12}}" font-size="12">${{legendUid}}</text>`;
                        svg += `</g>`;
                        legendY += 20;
                    }});

                    svg += `<text x="${{width/2}}" y="${{margin.top - 10}}" text-anchor="middle" font-size="16" font-weight="bold">${{title}}</text>`;
                    svg += `<text x="${{width/2}}" y="${{height - 10}}" text-anchor="middle" font-size="14">时间</text>`;
                    svg += `<text x="10" y="${{height/2}}" text-anchor="middle" font-size="14" transform="rotate(-90, 10, ${{height/2}}) translate(0, -20)">执行次数</text>`;
                    svg += `</svg>`;

                    // 渲染控件层
                    container.innerHTML = `
                        <div class="line-chart-controls" style="margin-bottom: 5px; text-align: right;">
                            <button onclick="resetChartView('${{containerId}}')" title="恢复全量视图">重置</button>
                            <button onclick="zoomInChart('${{containerId}}')" title="放大当前视图">放大</button>
                            <button onclick="zoomOutChart('${{containerId}}')" title="缩小当前视图">缩小</button>
                        </div>
                        <div class="line-chart-svg-wrapper" style="position: relative; width: ${{width}}px; height: ${{height}}px;">
                            ${{svg}}
                            <div class="line-chart-overlay" style="position: absolute; top: 0; left: 0; width: ${{width}}px; height: ${{height}}px; pointer-events: none;"
                                 data-container-id="${{containerId}}">
                            </div>
                            <div class="line-chart-selection" style="position: absolute; top: 0; height: ${{height}}px; background: rgba(52, 152, 219, 0.2); border: 1px solid #3498db; display: none; pointer-events: none;"></div>
                        </div>
                    `;

                    setupChartInteractions(containerId, width, height, margin, chartWidth, fullTimeLabels.length, startIndex, endIndex);
                }}

                function setupChartInteractions(containerId, width, height, margin, chartWidth, fullLen, startIndex, endIndex) {{
                    const container = document.getElementById(containerId);
                    const wrapper = container.querySelector('.line-chart-svg-wrapper');
                    const overlay = container.querySelector('.line-chart-overlay');
                    const selection = container.querySelector('.line-chart-selection');
                    if (!wrapper || !overlay || !selection) return;

                    let isDragging = false;
                    let startX = 0;
                    let isPanning = false;
                    let panStartX = 0;
                    let dragMoved = false;
                    let dragStartTimer = null;

                    function getRelativeX(e) {{
                        const rect = wrapper.getBoundingClientRect();
                        return e.clientX - rect.left;
                    }}

                    function onMouseDown(e) {{
                        dragMoved = false;
                        const x = getRelativeX(e);
                        if (e.shiftKey) {{
                            isPanning = true;
                            panStartX = x;
                            wrapper.style.cursor = 'grabbing';
                        }} else {{
                            // 延迟200ms显示竖线，避免点击线条时误出现
                            dragStartTimer = setTimeout(() => {{
                                isDragging = true;
                                startX = x;
                                selection.style.left = x + 'px';
                                selection.style.width = '0px';
                                selection.style.display = 'block';
                                wrapper.style.cursor = 'crosshair';
                            }}, 200);
                        }}
                    }}

                    function onMouseMove(e) {{
                        const x = getRelativeX(e);
                        if (isDragging) {{
                            dragMoved = true;
                            const left = Math.min(x, startX);
                            const w = Math.abs(x - startX);
                            selection.style.left = left + 'px';
                            selection.style.width = w + 'px';
                        }} else if (isPanning) {{
                            dragMoved = true;
                            const dx = x - panStartX;
                            if (Math.abs(dx) > 5) {{
                                panChart(containerId, dx, chartWidth);
                                panStartX = x;
                            }}
                        }}
                    }}

                    function onMouseUp(e) {{
                        const x = getRelativeX(e);
                        if (dragStartTimer) {{
                            clearTimeout(dragStartTimer);
                            dragStartTimer = null;
                        }}
                        if (isDragging) {{
                            const left = Math.min(x, startX);
                            const right = Math.max(x, startX);
                            const minSelectWidth = 10;
                            if (dragMoved && right - left > minSelectWidth) {{
                                const pixelsPerIndex = chartWidth / (endIndex - startIndex);
                                const newStartIndex = Math.floor((left - margin.left) / pixelsPerIndex) + startIndex;
                                const newEndIndex = Math.ceil((right - margin.left) / pixelsPerIndex) + startIndex;
                                zoomChartToRange(containerId, Math.max(0, Math.min(newStartIndex, fullLen - 1)), Math.max(0, Math.min(newEndIndex, fullLen - 1)));
                            }}
                            selection.style.display = 'none';
                            isDragging = false;
                            dragMoved = false;
                            wrapper.style.cursor = '';
                        }} else if (isPanning) {{
                            isPanning = false;
                            dragMoved = false;
                            wrapper.style.cursor = '';
                        }}
                    }}

                    function onMouseLeave() {{
                        if (dragStartTimer) {{
                            clearTimeout(dragStartTimer);
                            dragStartTimer = null;
                        }}
                        if (isDragging) {{
                            selection.style.display = 'none';
                            isDragging = false;
                            dragMoved = false;
                        }}
                        isPanning = false;
                        wrapper.style.cursor = '';
                    }}

                    function onContextMenu(e) {{
                        e.preventDefault();
                        resetChartView(containerId);
                    }}

                    wrapper.addEventListener('mousedown', onMouseDown);
                    wrapper.addEventListener('mousemove', onMouseMove);
                    wrapper.addEventListener('mouseup', onMouseUp);
                    wrapper.addEventListener('mouseleave', onMouseLeave);
                    wrapper.addEventListener('contextmenu', onContextMenu);
                }}

                function zoomChartToRange(containerId, startIndex, endIndex) {{
                    const view = chartViews[containerId];
                    if (!view) return;
                    const fullLen = view.fullData.time_labels.length;
                    if (endIndex - startIndex + 1 < 2) {{
                        startIndex = Math.max(0, endIndex - 1);
                    }}
                    startIndex = Math.max(0, Math.min(startIndex, fullLen - 1));
                    endIndex = Math.max(startIndex + 1, Math.min(endIndex, fullLen - 1));
                    renderLineChart(containerId, view.fullData, view.title, {{ startIndex, endIndex }});
                }}

                function resetChartView(containerId) {{
                    const view = chartViews[containerId];
                    if (!view) return;
                    renderLineChart(containerId, view.fullData, view.title);
                }}

                function zoomInChart(containerId) {{
                    const view = chartViews[containerId];
                    if (!view) return;
                    const range = view.endIndex - view.startIndex + 1;
                    const newRange = Math.max(2, Math.floor(range * 0.7));
                    const center = Math.floor((view.startIndex + view.endIndex) / 2);
                    const half = Math.floor(newRange / 2);
                    let startIndex = center - half;
                    let endIndex = startIndex + newRange - 1;
                    zoomChartToRange(containerId, startIndex, endIndex);
                }}

                function zoomOutChart(containerId) {{
                    const view = chartViews[containerId];
                    if (!view) return;
                    const fullLen = view.fullData.time_labels.length;
                    const range = view.endIndex - view.startIndex + 1;
                    const newRange = Math.min(fullLen, Math.ceil(range / 0.7));
                    const center = Math.floor((view.startIndex + view.endIndex) / 2);
                    const half = Math.floor(newRange / 2);
                    let startIndex = center - half;
                    let endIndex = startIndex + newRange - 1;
                    if (startIndex < 0) {{
                        endIndex -= startIndex;
                        startIndex = 0;
                    }}
                    if (endIndex >= fullLen) {{
                        startIndex -= (endIndex - fullLen + 1);
                        endIndex = fullLen - 1;
                    }}
                    startIndex = Math.max(0, startIndex);
                    endIndex = Math.min(fullLen - 1, endIndex);
                    if (endIndex - startIndex + 1 < 2) {{
                        endIndex = fullLen - 1;
                        startIndex = 0;
                    }}
                    zoomChartToRange(containerId, startIndex, endIndex);
                }}

                function panChart(containerId, dx, chartWidth) {{
                    const view = chartViews[containerId];
                    if (!view) return;
                    const range = view.endIndex - view.startIndex + 1;
                    const pixelsPerIndex = chartWidth / (range - 1);
                    const shift = Math.round(dx / pixelsPerIndex);
                    if (shift === 0) return;
                    let startIndex = view.startIndex - shift;
                    let endIndex = startIndex + range - 1;
                    const fullLen = view.fullData.time_labels.length;
                    if (startIndex < 0) {{
                        endIndex -= startIndex;
                        startIndex = 0;
                    }}
                    if (endIndex >= fullLen) {{
                        startIndex -= (endIndex - fullLen + 1);
                        endIndex = fullLen - 1;
                    }}
                    startIndex = Math.max(0, startIndex);
                    endIndex = Math.min(fullLen - 1, endIndex);
                    if (startIndex !== view.startIndex || endIndex !== view.endIndex) {{
