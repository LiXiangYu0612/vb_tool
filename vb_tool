        deadlock_list = deadlock_list or []
        lock_event_list = lock_event_list or []
        lock_chain_list = lock_chain_list or []
        error_list = error_list or []

        def _b64(text):
            """将文本 UTF-8 编码后做 Base64，用于安全内嵌进 HTML data 属性。"""
            return base64.b64encode((text or '').encode('utf-8')).decode('ascii')
        # 2. 生成锁/死锁相关章节
