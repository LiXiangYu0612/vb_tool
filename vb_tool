    }
    
    if [ -z "$begin_time" ] && [ -z "$end_time" ]; then
        begin_time=$(date +'%Y-%m-%d 00:00:00')
        end_time=$(date -d 'tomorrow 00:00:00' +'%Y-%m-%d %H:%M:%S')
    else
        begin_time=$(format_time "$begin_time")
        if [ $? -ne 0 ]; then
            return 1
        fi
        
        end_time=$(format_time "$end_time")
        if [ $? -ne 0 ]; then
            return 1
        fi
    fi
    
    local query_begin=$(date -d "$begin_time 1 hour ago" +'%Y-%m-%d %H:%M:%S')
    local query_end=$(date -d "$end_time 1 hour" +'%Y-%m-%d %H:%M:%S')
    
    psql -d postgres <<EOF
\pset footer off
\echo '===================='
\echo '   topsql summary   '
\echo '===================='
\echo '                          '
with grt as (
  select r.snapshot_id, max(r.snap_reset_time) gen
  from (select distinct snapshot_id, snap_node_name, snap_reset_time
        from snapshot.snap_global_record_reset_time) r
  group by r.snapshot_id),
time_range as (
select * from (
SELECT a.snapshot_id,
       to_char(lag(a.start_ts) over(order by a.snapshot_id),'mmdd hh24:mi')||'-'||to_char(a.start_ts,'hh24:mi') time_range,
       trunc(extract(epoch from (a.start_ts - lag(a.start_ts) over(order by a.snapshot_id)))) el,
       case when lag(grt.gen) over(order by a.snapshot_id) IS NOT DISTINCT FROM grt.gen then 1 end valid_gen
FROM snapshot.snapshot a join grt on a.snapshot_id = grt.snapshot_id
  where start_ts >= '$query_begin'::timestamp and start_ts <= '$query_end'::timestamp
  ) where el<=7200 and valid_gen=1),
gens as (
  select g.snapshot_id, g.gen from (
    select d.snapshot_id, max(d.snap_stats_reset) gen
    from snapshot.snap_summary_stat_database d
    group by d.snapshot_id) g),
base as (
select snapshot_id,snap_user_name user_name,snap_unique_sql_id unique_sql_id,
       snap_n_calls n_calls, snap_total_elapse_time total_elapse_time, snap_execution_time execution_time,
       snap_cpu_time cpu_time, snap_data_io_time data_io_time,
       snap_n_blocks_fetched n_blocks_fetched, snap_n_blocks_hit n_blocks_hit
from snapshot.snap_summary_statement
union all
select t1.snapshot_id, s.user_name, s.unique_sql_id, s.n_calls, s.total_elapse_time,
       s.execution_time, s.cpu_time, s.data_io_time, s.n_blocks_fetched, s.n_blocks_hit
from dbe_perf.statement s
cross join (select max(snapshot_id)+1 snapshot_id from snapshot.snap_summary_statement) t1
),
with_gen as (
select b.snapshot_id, b.user_name, b.unique_sql_id, b.n_calls, b.total_elapse_time,
       b.execution_time, b.cpu_time, b.data_io_time, b.n_blocks_fetched, b.n_blocks_hit, g.gen
from base b left join gens g on b.snapshot_id = g.snapshot_id
),
total_sql as (
select snapshot_id,user_name,unique_sql_id,n_calls,round(n_blocks_fetched-n_blocks_hit) total_pr,
round(total_elapse_time/1e3/n_calls,1) avg_tt_ms,
round(execution_time/1e3/n_calls,1) avg_et_ms,
round(cpu_time/1e3/n_calls,1) avg_cpu_ms,
round(data_io_time/1e3/n_calls,1) avg_io_ms,
round(n_blocks_fetched/n_calls,1) avg_cr,
round((n_blocks_fetched-n_blocks_hit)/n_calls,1) avg_pr,
round(100*ratio_to_report(total_elapse_time)over(partition by snapshot_id),1) time_pct,
round(100*ratio_to_report(cpu_time)over(partition by snapshot_id),1)  cpu_pct,
round(100*ratio_to_report(data_io_time)over(partition by snapshot_id),1) io_pct,
row_number()over(partition by snapshot_id order by
                 case $order_type
                   when 1 then total_elapse_time
                   when 2 then cpu_time
                   when 3 then data_io_time
                   else total_elapse_time
                 end desc) rn
from (select w.snapshot_id, w.user_name, w.unique_sql_id,
        case when lag(gen) over pw IS NOT DISTINCT FROM gen and w.n_calls - coalesce(lag(w.n_calls) over pw,0) > 0
             then w.n_calls - coalesce(lag(w.n_calls) over pw,0) end n_calls,
        case when lag(gen) over pw IS NOT DISTINCT FROM gen and w.total_elapse_time - coalesce(lag(w.total_elapse_time) over pw,0) >= 0
             then w.total_elapse_time - coalesce(lag(w.total_elapse_time) over pw,0) end total_elapse_time,
        case when lag(gen) over pw IS NOT DISTINCT FROM gen and w.execution_time - coalesce(lag(w.execution_time) over pw,0) >= 0
             then w.execution_time - coalesce(lag(w.execution_time) over pw,0) end execution_time,
        case when lag(gen) over pw IS NOT DISTINCT FROM gen and w.cpu_time - coalesce(lag(w.cpu_time) over pw,0) >= 0
             then w.cpu_time - coalesce(lag(w.cpu_time) over pw,0) end cpu_time,
        case when lag(gen) over pw IS NOT DISTINCT FROM gen and w.data_io_time - coalesce(lag(w.data_io_time) over pw,0) >= 0
             then w.data_io_time - coalesce(lag(w.data_io_time) over pw,0) end data_io_time,
        case when lag(gen) over pw IS NOT DISTINCT FROM gen and w.n_blocks_fetched - coalesce(lag(w.n_blocks_fetched) over pw,0) >= 0
             then w.n_blocks_fetched - coalesce(lag(w.n_blocks_fetched) over pw,0) end n_blocks_fetched,
        case when lag(gen) over pw IS NOT DISTINCT FROM gen and w.n_blocks_hit - coalesce(lag(w.n_blocks_hit) over pw,0) >= 0
             then w.n_blocks_hit - coalesce(lag(w.n_blocks_hit) over pw,0) end n_blocks_hit
from with_gen w
window pw as (partition by w.user_name, w.unique_sql_id order by w.snapshot_id))
where n_calls>0)
select t1.time_range,user_name uname,unique_sql_id sql_id,n_calls calls,total_pr,avg_tt_ms avg_tt,avg_et_ms avg_et,avg_cpu_ms avg_cpu,avg_io_ms avg_io,avg_cr,avg_pr,
       case $order_type
         when 1 then time_pct
         when 2 then cpu_pct
         when 3 then io_pct
         else time_pct
       end "pct%"
from time_range t1
left join total_sql t2 on t1.snapshot_id=t2.snapshot_id
where rn<=$top_n
order by 1 desc,
         case $order_type
           when 1 then time_pct
           when 2 then cpu_pct
           when 3 then io_pct
           else time_pct
         end desc;
EOF
}

