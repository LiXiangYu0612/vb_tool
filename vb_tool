            _vtop_lv REPL "" \
                "standby|${r_app:--}" "state|${r_state:--}" "sync_state|${r_sync:--}" "slot_status|${r_slot:--}" \
                "sent/s|$( [ -n "$r_dsent" ] && _vtop_fmt_b "$r_dsent" || echo - )" \
                "write/s|$( [ -n "$r_dwr" ] && _vtop_fmt_b "$r_dwr" || echo - )" \
                "flush/s|$( [ -n "$r_dfl" ] && _vtop_fmt_b "$r_dfl" || echo - )" \
                "replay/s|$( [ -n "$r_drp" ] && _vtop_fmt_b "$r_drp" || echo - )" \
                "net_lag|$( [ -n "$r_net" ] && _vtop_fmt_b "$r_net" || echo - )" \
                "fsync_lag|$( [ -n "$r_fs" ] && _vtop_fmt_b "$r_fs" || echo - )" \
                "apply_lag|$( [ -n "$r_ap" ] && _vtop_fmt_b "$r_ap" || echo - )" \
                "total_lag|$( [ -n "$r_tot" ] && _vtop_fmt_b "$r_tot" || echo - )"
                        local mem_col=""
                        if awk -v p="$m_used" -v m="$m_max" -v y="$m_dyu" -v n="$m_dym" 'BEGIN{exit !((m>0 && p/m*100>=90) || (n>0 && y/n*100>=90))}'; then mem_col=$c_red
                        elif awk -v p="$m_used" -v m="$m_max" 'BEGIN{exit !(m>0 && p/m*100>=75)}'; then mem_col=$c_ylw; fi
                        if [ -n "$m_used" ]; then
                            printf '%s' "$mem_col"
                            # one column per MONITOR ITEM (user's call 2026-09-26), named after
                            # the dbe_perf.memory_node_detail memorytype it comes from:
                            #   max_process_memory / process_used_memory / dynamic_used_memory /
                            #   dynamic_peak_memory / dynamic_used_shrctx
                            # one column per monitor item; label <- memorytype of
                            # gs_total_memory_detail / dbe_perf.memory_node_detail:
                            #   proc_max    <- max_process_memory       proc_used  <- process_used_memory
                            #   shared_max  <- max_shared_memory        shared_used <- shared_used_memory
                            #   dyn_used    <- dynamic_used_memory      dyn_max    <- max_dynamic_memory
                            #   dyn_peak    <- dynamic_peak_memory      shrctx_used  <- dynamic_used_shrctx
                            #   shrctx_peak <- dynamic_peak_shrctx      other_used   <- other_used_memory
                            # ★abbreviated on purpose (user's call 2026-09-26): the full names would
                            # blow past the 147-column box; this form is 121.
                            _vtop_lv DBMEM "" \
                                "proc_max|${m_max}G" \
                                "proc_used|${m_used}G" \
                                "shared_max|${m_shmax}G" \
                                "shared_used|${m_shused}G" \
                                "dyn_used|${m_dyu}G" \
                                "dyn_max|${m_dym}G" \
                                "dyn_peak|${m_dyp}G" \
                                "shrctx_used|${m_shr}G" \
                                "shrctx_peak|${m_shrp}G" \
                                "other_used|${m_other}G" \
                                "shared_buffers|${m_sbuf:--}"
                            printf '%s' "$c_off"
                        fi
