                    }});
                    
                    const isCollapsing = hasHidden;
                    
                    tables.forEach(table => {{
                        const rows = table.querySelectorAll('tbody tr, tr');
                        let dataRowCount = 0;
                        rows.forEach(row => {{
                            if (row.querySelector('th')) return;
                            dataRowCount++;
