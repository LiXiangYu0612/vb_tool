                }}

                // 点击顶部导航后，显式滚动到 SQL 详情栏目标题，避免锚点落在中部
                function scrollToDetailSection(event) {{
                    event.preventDefault();
                    const section = document.getElementById('detail-section');
                    const top = section.getBoundingClientRect().top + window.scrollY - 12;
                    window.scrollTo({{ top: Math.max(0, top), behavior: 'smooth' }});
                    history.replaceState(null, '', '#detail-section');
                }}

                // 通过 Unique ID 跳转到详情行（自动展开、高亮、居中）
                function goToDetail(uid, event) {{
                    if (event) {{
                        event.preventDefault();
                        event.stopPropagation();
                    }}
                    
                    const detailRow = document.getElementById(`detail-${{uid}}`);
                    if (!detailRow) {{
                        // 如果没有找到行，仍然更新 hash，便于刷新后重试
                        if (event) {{
                            window.location.hash = `#detail-${{uid}}`;
                        }}
                        return;
                    }}
                    
                    // 如果目标行是隐藏的，先展开之前的所有行
                    if (detailRow.classList.contains('detail-row-hidden') || detailRow.style.display === 'none') {{
                        const targetIndex = parseInt(detailRow.getAttribute('data-row-index'));
                        if (!isNaN(targetIndex)) {{
                            expandDetailRowsUpTo(targetIndex);
                        }}
                    }}
                    
                    // 移除所有现有的高亮
                    document.querySelectorAll('.detail-table tr.highlighted').forEach(row => {{
                        row.classList.remove('highlighted');
                    }});
                    
                    // 添加高亮类
                    detailRow.classList.add('highlighted');
                    
                    // 更新 URL hash
                    history.pushState(null, '', `#detail-${{uid}}`);
                    
                    // 平滑滚动到目标行（居中显示）
                    const header = document.querySelector('.detail-table thead');
                    const headerHeight = header ? header.offsetHeight : 0;
                    const viewportHeight = window.innerHeight;
                    const rowHeight = detailRow.offsetHeight || 100;
                    const rowRect = detailRow.getBoundingClientRect();
                    const currentScroll = window.scrollY || window.pageYOffset;
                    const rowTopAbsolute = rowRect.top + currentScroll;
                    const targetScrollTop = rowTopAbsolute - (viewportHeight / 2) + (rowHeight / 2) - headerHeight;
                    
                    window.scrollTo({{
                        top: Math.max(0, targetScrollTop),
                        behavior: 'smooth'
                    }});
                }}
                
                // 慢 SQL 连续热力图：面积轮廓表示触发次数，横向渐变表示分摊后的总耗时
                function renderSqlHeatmap(dimId, sqlType = 'dml', viewRange = null) {{
                    const container = document.getElementById('sql-heatmap-' + dimId);
                    if (!container) return;
                    const title = '<h3 class="chart-title">慢 SQL 次数 / 总耗时热力图</h3>';
                    const dimensionData = chartData.time_analysis && chartData.time_analysis['by_' + dimId];
                    const heatmapData = dimensionData && dimensionData.heatmap;
                    if (!heatmapData || !heatmapData[sqlType] || !heatmapData.time_labels || heatmapData.time_labels.length === 0) {{
                        container.innerHTML = title + '<div class="sql-heatmap-empty">暂无慢 SQL 数据</div>';
                        return;
                    }}

                    const allLabels = heatmapData.time_labels;
                    const diffLabels = heatmapData.diff_time_labels || [];
                    const diffAvailable = Boolean(heatmapData.diff_available);
                    const typeData = heatmapData[sqlType];
                    const normalizeNumbers = (values) => allLabels.map((_, index) => Number(values && values[index]) || 0);
                    const currentCounts = normalizeNumbers(typeData.current_counts);
                    const currentDurations = normalizeNumbers(typeData.current_durations);
                    const diffCounts = normalizeNumbers(typeData.diff_counts);
                    const diffDurations = normalizeNumbers(typeData.diff_durations);
                    let effectiveRange = viewRange;
                    if (!effectiveRange && dimId === 'minute' && chartViews['minute-chart']) {{
                        effectiveRange = chartViews['minute-chart'];
                    }}
                    let startIndex = 0;
                    let endIndex = allLabels.length - 1;
                    if (effectiveRange) {{
                        startIndex = Math.max(0, Math.min(Number(effectiveRange.startIndex) || 0, endIndex));
                        endIndex = Math.max(startIndex, Math.min(Number(effectiveRange.endIndex) || 0, allLabels.length - 1));
                    }}
                    const visibleGroups = [];
                    for (let sourceIndex = startIndex; sourceIndex <= endIndex; sourceIndex++) {{
                        const currentCount = currentCounts[sourceIndex];
                        const diffCount = diffCounts[sourceIndex];
                        if (currentCount <= 0 && (!diffAvailable || diffCount <= 0)) continue;
                        visibleGroups.push({{
                            sourceIndex: sourceIndex,
                            label: allLabels[sourceIndex],
                            diffLabel: diffLabels[sourceIndex] || '-',
                            currentCount: currentCount,
                            currentDuration: currentDurations[sourceIndex],
                            diffCount: diffCount,
                            diffDuration: diffDurations[sourceIndex]
                        }});
                    }}
                    if (visibleGroups.length === 0) {{
                        const emptyText = effectiveRange ? '当前时间范围暂无慢 SQL 数据' : '暂无慢 SQL 数据';
                        container.innerHTML = title + `<div class="sql-heatmap-empty">${{emptyText}}</div>`;
                        return;
                    }}

                    const escapeText = (value) => String(value).replace(/[&<>"']/g, char => ({{
                        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
                    }}[char]));
                    const formatDuration = (value) => {{
                        const seconds = Number(value) || 0;
                        if (seconds >= 3600) return (seconds / 3600).toFixed(2) + ' 小时';
                        if (seconds >= 60) return (seconds / 60).toFixed(2) + ' 分钟';
                        if (seconds >= 1) return seconds.toFixed(2) + ' 秒';
                        if (seconds > 0) return (seconds * 1000).toFixed(1) + ' 毫秒';
                        return '0 秒';
                    }};
                    const maxCount = Math.max(1, visibleGroups.reduce((max, group) =>
                        Math.max(max, group.currentCount, diffAvailable ? group.diffCount : 0), 0
                    ));
                    const maxDuration = Math.max(0,
                        currentDurations.reduce((max, value) => Math.max(max, value), 0),
                        diffAvailable ? diffDurations.reduce((max, value) => Math.max(max, value), 0) : 0
                    );
                    const getHeatColor = (value) => {{
                        const duration = Number(value) || 0;
                        if (duration <= 0 || maxDuration <= 0) return '#e5e7eb';
                        const ratio = Math.max(0, Math.min(1, duration / maxDuration));
                        if (ratio >= 1) return '#dc2626';
                        const interpolate = (from, to, amount) => Math.round(from + (to - from) * amount);
                        const interpolateColor = (from, to, amount) => '#' + from.map((channel, index) =>
                            interpolate(channel, to[index], amount).toString(16).padStart(2, '0')
                        ).join('');
                        if (ratio <= 0.5) {{
                            return interpolateColor([254, 243, 199], [245, 158, 11], ratio * 2);
                        }}
                        return interpolateColor([245, 158, 11], [220, 38, 38], (ratio - 0.5) * 2);
                    }};

                    const widthAvailable = Math.max(container.clientWidth || 600, 320);
                    const margin = {{ top: 20, right: 24, bottom: 48, left: 68 }};
                    const plotHeight = 220;
                    const bandHeight = diffAvailable ? plotHeight / 2 : plotHeight;
                    const minGroupWidth = 20;
                    const plotWidth = Math.max(widthAvailable - margin.left - margin.right, visibleGroups.length * minGroupWidth);
                    const svgWidth = plotWidth + margin.left + margin.right;
                    const svgHeight = plotHeight + margin.top + margin.bottom;
                    const groupWidth = plotWidth / visibleGroups.length;
                    const plotBottom = margin.top + plotHeight;
                    const labelStep = Math.max(1, Math.ceil(visibleGroups.length / 15));
                    const tickCount = Math.min(5, Math.max(1, Math.round(maxCount)));
                    const buildHeatGradient = (series) => {{
                        if (series === 'diff' && !diffAvailable) return '';
                        const stops = [];
                        visibleGroups.forEach((group, groupIndex) => {{
                            const duration = series === 'diff' ? group.diffDuration : group.currentDuration;
                            const centerOffset = (groupIndex + 0.5) * groupWidth;
                            stops.push({{
                                offset: centerOffset / plotWidth * 100,
                                color: getHeatColor(duration)
                            }});
                        }});
                        if (stops.length === 0) return '';
                        const gradientId = `sql-heatmap-${{dimId}}-${{sqlType}}-${{series}}-gradient`;
                        if (stops.length === 1) {{
                            return `<linearGradient id="${{gradientId}}"><stop offset="0%" stop-color="${{stops[0].color}}"/><stop offset="100%" stop-color="${{stops[0].color}}"/></linearGradient>`;
                        }}
                        const stopSvg = stops.map(stop =>
                            `<stop offset="${{stop.offset}}%" stop-color="${{stop.color}}"/>`
                        ).join('');
                        return `<linearGradient id="${{gradientId}}" gradientUnits="userSpaceOnUse" x1="${{margin.left}}" y1="0" x2="${{margin.left + plotWidth}}" y2="0">${{stopSvg}}</linearGradient>`;
                    }};
                    const currentGradientId = `sql-heatmap-${{dimId}}-${{sqlType}}-current-gradient`;
                    const diffGradientId = `sql-heatmap-${{dimId}}-${{sqlType}}-diff-gradient`;
                    const buildCountProfile = (series) => {{
                        const bandTop = series === 'diff' && diffAvailable ? margin.top + bandHeight : margin.top;
                        const baseline = bandTop + bandHeight;
                        const points = visibleGroups.map((group, groupIndex) => {{
                            const count = series === 'diff' ? group.diffCount : group.currentCount;
                            return [
                                margin.left + (groupIndex + 0.5) * groupWidth,
                                baseline - count / maxCount * (bandHeight - 8)
                            ];
                        }});
                        if (points.length === 0) return '';
                        let path = `M ${{points[0][0]}} ${{points[0][1]}}`;
                        for (let index = 1; index < points.length; index++) {{
                            const previous = points[index - 1];
                            const current = points[index];
                            const middleX = (previous[0] + current[0]) / 2;
                            path += ` C ${{middleX}} ${{previous[1]}}, ${{middleX}} ${{current[1]}}, ${{current[0]}} ${{current[1]}}`;
                        }}
                        const curvePath = path.includes(' C') ? path.slice(path.indexOf(' C')) : '';
                        const areaPath = `M ${{margin.left}} ${{baseline}} L ${{margin.left}} ${{points[0][1]}} L ${{points[0][0]}} ${{points[0][1]}}${{curvePath}} L ${{margin.left + plotWidth}} ${{points[points.length - 1][1]}} L ${{margin.left + plotWidth}} ${{baseline}} Z`;
                        const linePath = `M ${{margin.left}} ${{points[0][1]}} L ${{points[0][0]}} ${{points[0][1]}}${{curvePath}} L ${{margin.left + plotWidth}} ${{points[points.length - 1][1]}}`;
                        return `<path d="${{areaPath}}" data-count-profile="${{series}}" fill="rgba(255,255,255,0.28)" stroke="none"/><path d="${{linePath}}" fill="none" stroke="rgba(120,53,15,0.72)" stroke-width="1.5" stroke-linejoin="round"/>`;
                    }};
                    let svg = `<svg width="${{svgWidth}}" height="${{svgHeight}}" viewBox="0 0 ${{svgWidth}} ${{svgHeight}}" role="img" aria-label="慢 SQL 次数和总耗时热力图">`;
                    svg += '<rect x="0" y="0" width="100%" height="100%" fill="#ffffff"/>';
                    svg += `<defs>${{buildHeatGradient('current')}}${{buildHeatGradient('diff')}}</defs>`;

                    const bandCount = diffAvailable ? 2 : 1;
                    for (let bandIndex = 0; bandIndex < bandCount; bandIndex++) {{
                        const bandTop = margin.top + bandIndex * bandHeight;
                        for (let tick = 0; tick <= tickCount; tick++) {{
                            const value = maxCount * tick / tickCount;
                            const y = bandTop + bandHeight - (value / maxCount) * bandHeight;
                            svg += `<line x1="${{margin.left}}" y1="${{y}}" x2="${{margin.left + plotWidth}}" y2="${{y}}" stroke="#e5e7eb" stroke-width="1"/>`;
                            svg += `<text x="${{margin.left - 9}}" y="${{y + 4}}" text-anchor="end" font-size="11" fill="#64748b">${{Math.round(value)}}</text>`;
                        }}
                    }}
                    svg += `<text x="18" y="${{margin.top + plotHeight / 2}}" text-anchor="middle" font-size="12" fill="#475569" transform="rotate(-90 18 ${{margin.top + plotHeight / 2}})">慢 SQL 触发次数</text>`;
                    svg += `<rect x="${{margin.left}}" y="${{margin.top}}" width="${{plotWidth}}" height="${{bandHeight}}" data-heat-band="current" fill="url(#${{currentGradientId}})"/>`;
                    if (diffAvailable) {{
                        svg += `<rect x="${{margin.left}}" y="${{margin.top + bandHeight}}" width="${{plotWidth}}" height="${{bandHeight}}" data-heat-band="diff" fill="url(#${{diffGradientId}})"/>`;
                    }}
                    svg += buildCountProfile('current');
                    if (diffAvailable) svg += buildCountProfile('diff');
                    svg += `<line x1="${{margin.left}}" y1="${{plotBottom}}" x2="${{margin.left + plotWidth}}" y2="${{plotBottom}}" stroke="#94a3b8"/>`;

                    const parseHeatmapTime = (value) => {{
                        const match = String(value).match(/^(\\d{{4}})-(\\d{{2}})-(\\d{{2}})(?: (\\d{{2}}):(\\d{{2}}))?/);
                        if (!match) return null;
                        return {{
                            month: Number(match[2]),
                            day: Number(match[3]),
                            hour: match[4] === undefined ? null : Number(match[4]),
                            minute: match[5] === undefined ? null : Number(match[5])
                        }};
                    }};
                    const pad2 = (value) => String(value).padStart(2, '0');
                    let lastTickDay = null;
                    visibleGroups.forEach((group, groupIndex) => {{
                        const groupX = margin.left + groupIndex * groupWidth;
                        if (groupIndex % labelStep === 0) {{
                            const labelX = groupX + groupWidth / 2;
                            const info = parseHeatmapTime(group.label);
                            let displayLabel = String(group.label);
                            if (info) {{
                                if (info.hour === null) {{
                                    displayLabel = pad2(info.month) + '-' + pad2(info.day);
                                }} else if (groupIndex === 0) {{
                                    displayLabel = pad2(info.month) + '-' + pad2(info.day) + ' ' + pad2(info.hour) + ':' + pad2(info.minute);
                                }} else if ((info.hour === 0 && info.minute === 0) || (lastTickDay !== null && info.day !== lastTickDay)) {{
                                    displayLabel = pad2(info.month) + '-' + pad2(info.day);
                                }} else {{
                                    displayLabel = pad2(info.hour) + ':' + pad2(info.minute);
                                }}
                                lastTickDay = info.day;
                            }} else if (displayLabel.length > 24) {{
                                displayLabel = displayLabel.slice(0, 24) + '…';
                            }}
                            svg += `<text x="${{labelX}}" y="${{plotBottom + 20}}" text-anchor="middle" font-size="11" fill="#666">${{escapeText(displayLabel)}}</text>`;
                            svg += `<line x1="${{labelX}}" y1="${{plotBottom}}" x2="${{labelX}}" y2="${{plotBottom + 5}}" stroke="#666"/>`;
                        }}
                        let tooltip = `<b>当前</b><br><b>时间:</b> ${{escapeText(group.label)}}<br><b>触发次数:</b> ${{group.currentCount}}<br><b>总慢 SQL 耗时:</b> ${{formatDuration(group.currentDuration)}}`;
                        if (diffAvailable) {{
                            tooltip += `<br><br><b>diff 前同期</b><br><b>时间:</b> ${{escapeText(group.diffLabel)}}<br><b>触发次数:</b> ${{group.diffCount}}<br><b>总慢 SQL 耗时:</b> ${{formatDuration(group.diffDuration)}}`;
                        }} else {{
                            tooltip += '<br><br>对比区间无数据';
                        }}
                        svg += `<rect x="${{groupX}}" y="${{margin.top}}" width="${{groupWidth}}" height="${{plotHeight}}" fill="transparent" data-source-index="${{group.sourceIndex}}" data-group-index="${{groupIndex}}" data-count="${{group.currentCount}}" data-duration="${{group.currentDuration}}" data-diff-count="${{group.diffCount}}" data-diff-duration="${{group.diffDuration}}" data-tooltip="${{escapeText(tooltip)}}" onmouseover="showTooltip(event, this.getAttribute('data-tooltip'))" onmouseout="hideTooltip()"/>`;
                    }});
                    svg += '</svg>';

                    const diffLegend = diffAvailable
                        ? '<span class="sql-heatmap-legend-item"><span class="sql-heatmap-series-swatch diff"></span>diff 前同期</span>'
                        : '<span class="sql-heatmap-no-diff">对比区间无数据</span>';
                    const legend = `<div class="sql-heatmap-legend"><span class="sql-heatmap-legend-item"><span class="sql-heatmap-series-swatch current"></span>当前</span>${{diffLegend}}<span class="sql-heatmap-legend-item">总慢 SQL 耗时：0</span><span class="sql-heatmap-color-scale"></span><span>${{formatDuration(maxDuration)}}</span></div>`;
                    container.innerHTML = title + legend + `<div class="sql-heatmap-scroll">${{svg}}</div><div class="sql-heatmap-note">上半区为当前，下半区为 diff 前同期；连续热力颜色表示总耗时，面积轮廓高度表示慢 SQL 触发次数。双方均为 0 的时间桶已忽略，颜色与轮廓在非零桶之间连续过渡；悬浮提示为各桶真实统计值。</div>`;
                }}

                // 工具提示
                function showTooltip(event, text) {{
                    let tooltip = document.getElementById('chart-tooltip');
                    if (!tooltip) {{
                        tooltip = document.createElement('div');
                        tooltip.id = 'chart-tooltip';
                        tooltip.style.cssText = 'position: absolute; background: rgba(0,0,0,0.85); color: white; padding: 8px 12px; border-radius: 4px; font-size: 12px; pointer-events: none; z-index: 10000; max-width: 400px; white-space: normal; word-break: break-all; line-height: 1.5;';
                        document.body.appendChild(tooltip);
                    }}
                    tooltip.innerHTML = text;
                    tooltip.style.left = (event.pageX + 12) + 'px';
                    tooltip.style.top = (event.pageY - 20) + 'px';
                    tooltip.style.display = 'block';
                }}
                
                function hideTooltip() {{
                    const tooltip = document.getElementById('chart-tooltip');
                    if (tooltip) tooltip.style.display = 'none';
                }}
                
                function showPointTooltip(event, uid, time, value, containerId) {{
                    if (containerId === 'connection-chart') {{
                        showTooltip(event, `<b>时间:</b> ${{time}}<br><b>连接数:</b> ${{value}}`);
                        return;
                    }}
                    const chartView = chartViews[containerId];
                    if (uid === '__bug__') {{
                        const pointIndex = (chartView.startIndex || 0) + Number(event.currentTarget.dataset.index || 0);
                        const distribution = (chartView.fullData.point_types || [])[pointIndex] || [];
                        const escapeText = value => String(value).replace(/[&<>"']/g, char => ({{
                            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
                        }}[char]));
                        const lines = distribution.map(item => `${{escapeText(item.type)}}：${{item.count}} 次`).join('<br>');
                        showTooltip(event, `<b>时间:</b> ${{time}}<br><b>特殊事件总次数:</b> ${{value}}` +
                            (lines ? `<br><b>事件类型:</b><br>${{lines}}` : ''));
                        return;
                    }}
                    const series = chartView && chartView.fullData && chartView.fullData.series
                        ? chartView.fullData.series.find(s => s.uid === uid)
                        : null;
                    const displayUid = series ? (series.uid_display || series.uid) : uid;
                    if (uid === '__overall__') {{
                        showTooltip(event, `<b>时间:</b> ${{time}}<br><b>总慢SQL个数:</b> ${{value}}`);
                        return;
                    }}
                    showTooltip(event, `<b>Unique ID:</b> ${{displayUid}}<br><b>时间:</b> ${{time}}<br><b>执行次数:</b> ${{value}}`);
                }}
                
                function hidePointTooltip() {{
                    hideTooltip();
                }}
                
                // 控制 SQL 详情列表中 "点击详情" 的展开/收起，并同步高亮当前行
                function toggleSqlDetail(event, summary) {{
                    event.preventDefault();
                    event.stopPropagation();
                    
                    const details = summary.closest('details');
                    if (!details) return;
                    
                    const row = details.closest('tr');
                    const wasOpen = details.open;
                    
                    // 先关闭所有其他已展开的 SQL 详情
                    document.querySelectorAll('#detail-section details[open]').forEach(openDetails => {{
                        if (openDetails !== details) {{
                            openDetails.removeAttribute('open');
                            const otherRow = openDetails.closest('tr');
                            if (otherRow) {{
                                otherRow.classList.remove('highlighted');
                            }}
                        }}
                    }});
                    
                    if (wasOpen) {{
                        // 收起当前详情
                        details.removeAttribute('open');
                        if (row) {{
                            row.classList.remove('highlighted');
                        }}
                        // 检查是否还有展开的详情，没有则恢复列宽
                        if (document.querySelectorAll('#detail-section details[open]').length === 0) {{
                            queryTextExpanded = true;
                            detailColumnExpanded = false;
                            updateColumnWidths();
                        }}
                    }} else {{
