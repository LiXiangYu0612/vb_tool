                            font-weight: bold; font-size: 24px; margin: 0; }
details.secfold > summary .totop { float: right; color: #663300; background: #fff; text-decoration: none;
                            border: 1px solid #663300; padding: 1px 10px; font-size: 12px; font-weight: bold; margin-top: 8px; }
