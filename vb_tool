                ) d
        WHERE rn <= 3
        GROUP BY attname,tablename,schemaname
        ) b ON a.attname=b.attname and a.tablename=b.tablename and a.schemaname=b.schemaname;
"""



def query_sqlhc_tabstats(tables, db_name, timeout=120, debug=False):
    """查询单个 uid 表集合的表统计信息（table + index + column + partition + subpartition + extended）。

    SQL 取自 vb_tool v2.0.8 run_sqlhc 的 tabstat 段（含视图定义回退查询），
    连接 SQL 实际执行的库查询，对齐格式输出（类似 t_1_1.stats.txt）。

    Args:
        tables: [(owner, table_name), ...]
        db_name: 数据库名（SQL 执行的库）
        timeout: vsql 超时时间（秒）
        debug: 是否打印调试日志

    Returns:
        str: 格式化的文本结果（vsql 对齐格式）
    """
    if not tables:
        if debug:
            print(f"[DEBUG] sqlhc tabstats: 表列表为空, db={db_name}", file=sys.stderr)
        return "No tables found."

    if debug:
        print(f"[DEBUG] sqlhc tabstats: db={db_name}, tables={tables}", file=sys.stderr)

    query = _build_sqlhc_tabstats_query(tables)

    if debug:
        print(f"[DEBUG] sqlhc tabstats 执行命令: vsql -d {db_name} -X -P footer=off", file=sys.stderr)
        print(f"[DEBUG] sqlhc tabstats 完整 SQL:\n{query}", file=sys.stderr)
    try:
        # 对齐格式输出（不加 -A -t，footer=off），与 vb_tool psql -d <db> -X -P footer=off 一致
        process = subprocess.Popen(
            ['vsql', '-d', db_name, '-X', '-P', 'footer=off'],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            universal_newlines=True
        )
        stdout, stderr = process.communicate(input=query, timeout=timeout)
    except FileNotFoundError:
        return "vsql not found, skip tabstat."
    except subprocess.TimeoutExpired:
        process.kill()
        process.communicate()
        return f"Query timeout after {timeout}s."
    except Exception as e:
        return f"Query error: {e}"

    if debug and stderr.strip():
        print(f"[DEBUG] sqlhc tabstats vsql stderr:\n{stderr.strip()}", file=sys.stderr)
    if process.returncode != 0:
        return f"Query failed: {stderr.strip()}"

    result = stdout.rstrip()
    if debug:
        print(f"[DEBUG] sqlhc tabstats: db={db_name}, 返回长度={len(result)}", file=sys.stderr)
    return result


def _build_sqlhc_statement_stats_query(uid):
    """构建单个 uid 的 sqlstat 查询 SQL。

    SQL 取自 vb_tool v2.0.8 run_sqlhc 的 postgres 段（psql -d postgres）。

    Args:
        uid: unique_sql_id（int）

    Returns:
        str: 完整查询文本（vsql 脚本，含 \\echo 分段标题）
    """
    return f"""
\\echo '======================'
\\echo 'sqlstat from statement'
\\echo '======================'
\\echo '                          '
SELECT user_name,n_calls,
round(db_time/1e3/nullif(n_calls,0),1) avg_db_ms,
round(execution_time/1e3/nullif(n_calls,0),1) avg_et_ms,
round(cpu_time/1e3/nullif(n_calls,0),1) avg_cpu_ms,
round(data_io_time/1e3/nullif(n_calls,0),1) avg_io_ms,
round((parse_time+plan_time+rewrite_time)/1e3/nullif(n_calls,0),1) avg_plan_ms,
round(pl_execution_time/1e3/nullif(n_calls,0),1) avg_plsql_ms,
round(sort_time/1e3/nullif(n_calls,0),1) a_sort_ms,
round(hash_time/1e3/nullif(n_calls,0),1) a_hash_ms,
round(n_blocks_fetched/nullif(n_calls,0),1) avg_cr,
round((n_blocks_fetched-n_blocks_hit)/nullif(n_calls,0),1) avg_pr,
round((n_returned_rows+n_tuples_inserted+n_tuples_updated+n_tuples_deleted)/nullif(n_calls,0),1) avg_rows
FROM dbe_perf.statement WHERE unique_sql_id={uid};
"""


