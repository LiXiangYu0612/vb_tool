def _run_vsql_batch(db_name, blocks, timeout=120, debug=False, label='sqlhc batch'):
    """单次 vsql 会话批量执行多个查询块，按标记拆分输出。

    每个 block 前自动加 \\echo '<marker>' 行，会话输出中该行作为分隔标记，
    据此把输出拆分为各 block 的结果（单条语句出错不影响其他 block）。

    Args:
        db_name: 目标数据库名
        blocks: [(marker, query_text), ...]，marker 仅允许 [A-Za-z0-9_:-]
        timeout: 单块超时时间（秒），会话超时按块数放大
        debug: 是否打印调试日志
        label: 日志标签

    Returns:
        (dict, str): marker -> 该块输出文本；错误信息（无错为 None）
    """
    results, error = {}, None
    if not blocks:
        return results, error

    script_parts = []
    for marker, query in blocks:
        script_parts.append(f"\\echo '{marker}'")
        script_parts.append(query)
    script = '\n'.join(script_parts) + '\n'
    # 会话级超时: 每块原本独立享有 timeout, 批量时按块数放大
    session_timeout = timeout * max(1, len(blocks))

    if debug:
        print(f"[DEBUG] {label}: vsql -d {db_name} -X -P footer=off, 共 {len(blocks)} 块, 会话超时 {session_timeout}s", file=sys.stderr)
    try:
        process = subprocess.Popen(
            ['vsql', '-d', db_name, '-X', '-P', 'footer=off'],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            universal_newlines=True
        )
        stdout, stderr = process.communicate(input=script, timeout=session_timeout)
    except FileNotFoundError:
        return results, "vsql not found."
    except subprocess.TimeoutExpired:
        process.kill()
        process.communicate()
        return results, f"batch query timeout after {session_timeout}s."
    except Exception as e:
        return results, f"batch query error: {e}"

    if debug and stderr.strip():
        print(f"[DEBUG] {label} vsql stderr:\n{stderr.strip()}", file=sys.stderr)
    if process.returncode != 0:
        error = stderr.strip() or f"vsql exit code {process.returncode}"

    # 按标记行拆分输出: parts = [前导, marker1, body1, marker2, body2, ...]
    pattern = re.compile('^(' + '|'.join(re.escape(m) for m, _ in blocks) + r')\s*$', re.M)
    parts = pattern.split(stdout)
    for i in range(1, len(parts), 2):
        marker = parts[i]
        body = parts[i + 1] if i + 1 < len(parts) else ''
        results[marker] = body.strip('\n')
    if debug:
        print(f"[DEBUG] {label}: 解析出 {len(results)}/{len(blocks)} 块", file=sys.stderr)
    return results, error


def batch_query_sqlhc_statement_stats(unique_ids, timeout=120, debug=False):
    """批量查询所有 uid 的 sqlstat（postgres 库，一次 vsql 会话）。

    Args:
        unique_ids: unique_query_id 集合/列表
        timeout: 单块超时时间（秒）
        debug: 是否打印调试日志

    Returns:
        dict: uid字符串 -> 格式化文本；查询失败的 uid 不在结果中（由调用方回退单查）
    """
    blocks, uid_by_marker = [], {}
    for uid in unique_ids:
        uid_str = str(uid).strip()
        try:
            u = int(uid_str)
        except (ValueError, TypeError):
            continue
        marker = f"__SQLHC_BLOCK__:{u}:sqlstat__"
        blocks.append((marker, _build_sqlhc_statement_stats_query(u)))
        uid_by_marker[marker] = uid_str

    results, error = _run_vsql_batch(
        'postgres', blocks, timeout=timeout, debug=debug, label='sqlhc statement stats batch')
    if error:
        print(f"WARNING: sqlhc statement stats 批量查询: {error}", file=sys.stderr)
    return {uid_by_marker[m]: body for m, body in results.items()}


def batch_query_sqlhc_table_info(uid_tables, db_name, timeout=120, debug=False, workers=6):
    """批量查询多个 uid 的 tabstat + tabsize（同一库）。

    优化:
      1. 表集合去重 —— 表集合完全相同的 uid 只查一次，结果共享（输出一致）
      2. 动态并行 —— 每个唯一表集合一个任务，工作线程做完即取下一个，
         避免静态分片时慢表集合（大分区表 tabsize）拖尾

    Args:
        uid_tables: [(uid_str, resolved_tables), ...]，resolved_tables 为
                    已解析 schema 的表列表 [(schema, table), ...]
        db_name: 数据库名（SQL 执行的库）
        timeout: 单块超时时间（秒）
        debug: 是否打印调试日志
        workers: 并行 vsql 会话数

    Returns:
        (dict, dict): uid -> tabstat文本, uid -> tabsize文本；
                      查询失败的 uid 不在结果中（由调用方回退单查）
    """
    # 1. 按"表集合"去重: 相同集合的 uid 共享同一次查询
    set_key_to_uids = {}  # 表集合key -> [uid_str, ...]
    for uid_str, tables in uid_tables:
        uid_str = str(uid_str).strip()
        if not tables or not re.fullmatch(r'[A-Za-z0-9_-]+', uid_str):
            continue
        key = tuple(sorted(set(tables)))
        set_key_to_uids.setdefault(key, []).append(uid_str)

    unique_sets = list(set_key_to_uids.keys())
    if not unique_sets:
        return {}, {}

    # 2. 动态并行: 一个表集合一个任务（单次 vsql 会话含 tabstat+tabsize 两块）
    workers = max(1, min(workers, len(unique_sets)))

    def _run_set(idx, key):
        m_stat = f"__SQLHC_BLOCK__:s{idx}:tabstat__"
        m_size = f"__SQLHC_BLOCK__:s{idx}:tabsize__"
        blocks = [
            (m_stat, _build_sqlhc_tabstats_query(list(key))),
            (m_size, _build_sqlhc_tabsize_query(list(key))),
        ]
        _t = time.monotonic()
        results, error = _run_vsql_batch(
            db_name, blocks, timeout=timeout, debug=debug,
            label=f'sqlhc table info({db_name})#{idx}')
        if debug:
            tables_show = ','.join(f'{o}.{t}' for o, t in key)
            print(f"[DEBUG] sqlhc table info({db_name})#{idx}: {tables_show} 耗时 {time.monotonic() - _t:.1f}s", file=sys.stderr)
        return idx, key, results, error

    with ThreadPoolExecutor(max_workers=workers) as executor:
        set_results = list(executor.map(
            lambda arg: _run_set(*arg), list(enumerate(unique_sets))))

    # 3. 汇总: marker -> 表集合key，再映射回所有共享 uid
    key_to_tabstats, key_to_tabsize = {}, {}
    for idx, key, results, error in set_results:
        if error:
            print(f"WARNING: sqlhc table info 批量查询({db_name})#{idx}: {error}", file=sys.stderr)
        for marker, body in results.items():
            if marker.endswith(':tabstat__'):
                key_to_tabstats[key] = body
            else:
                key_to_tabsize[key] = body

    tabstats_map, tabsize_map = {}, {}
    for key, uids in set_key_to_uids.items():
        if key in key_to_tabstats or key in key_to_tabsize:
            for uid_str in uids:
                if key in key_to_tabstats:
                    tabstats_map[uid_str] = key_to_tabstats[key]
                if key in key_to_tabsize:
                    tabsize_map[uid_str] = key_to_tabsize[key]
    if debug:
        print(f"[DEBUG] sqlhc table info({db_name}): {len(uid_tables)} 个 uid 去重为 {len(unique_sets)} 个表集合, {workers} 并行会话(动态)", file=sys.stderr)
    return tabstats_map, tabsize_map


def _format_wait_events_for_sqlhc(records):
    """把等待事件记录格式化为 SQLHC 文本块。

    每个 SQL 输出最大/最小执行时间点两条记录，分三部分:
      1. statement_history 记录  —— 指定业务列(_SH_COLS)一行输出 col=val | ...
      2. 执行计划 query_plan      —— 单独列出
      3. 等待事件 event_text      —— 单独列出 (statement_detail_decode 解码, 保留多行)

    Args:
        records: query_wait_events_for_sql_ids 返回的记录列表(含 pick 标签)

    Returns:
        str: 文本块；records 为空时返回空串
    """
    if not records:
        return ''

    def _oneline(v):
        return str(v if v is not None else '').replace('\r', ' ').replace('\n', ' ')

    max_recs = [r for r in records if str(r.get('pick', '')) == 'max']
    min_recs = [r for r in records if str(r.get('pick', '')) == 'min']
    # 兼容无 pick 标签的记录：按一条处理
    if not max_recs and not min_recs:
        max_recs = records[:1]

    groups = []  # [(标签, record)]
    if max_recs:
        groups.append(('最大执行时间点', max_recs[0]))
    if min_recs:
        groups.append(('最小执行时间点', min_recs[0]))
    if len(groups) == 1:
        # 时间范围内仅 1 条记录（最大/最小为同一次执行）
        groups = [('最大/最小执行时间点(同一次执行)', groups[0][1])]

    lines = ["================", "等待事件信息", "================"]

    # 1. statement_history 记录（指定业务列，一行输出）
    for tag, rec in groups:
        lines.append("")
        lines.append(f"------ statement_history 记录 ({tag}) ------")
        pairs = [f"{c}={_oneline(rec.get(c))}" for c in _SH_COLS if c in rec]
        lines.append(' | '.join(pairs) if pairs else '(无记录)')

    # 2. 执行计划 query_plan（单独列出，最大/最小各一个）
    for tag, rec in groups:
        lines.append("")
        lines.append(f"------ 执行计划 query_plan ({tag}) ------")
        plan = str(rec.get('query_plan', '') or '').strip('\r\n')
        lines.append(plan if plan else '(无执行计划)')

    # 3. 等待事件（单独列出，最大/最小各一个，保留原始多行）
    for tag, rec in groups:
        lines.append("")
        lines.append(f"------ 等待事件 ({tag}) ------")
        event_text = str(rec.get('event_text', '') or '').strip('\r\n')
        lines.append(event_text if event_text else '(无等待事件明细)')

    return '\n'.join(lines).rstrip()


def generate_sqlhc_content(unique_id, stat, db_name, timeout=120, wait_events_records=None, debug=False,
                           statement_stats_text=None, resolved_tables=None, tabstats_text=None, tabsize_text=None):
    """生成单个 SQL 的 SQLHC 报告文本。

    信息收集参考 vb_tool v2.0.8 run_sqlhc:
      1. sqltext            —— 日志中提取（参数已填充）
      2. 执行统计            —— 日志侧统计（次数/耗时/锁等待）
      3. 等待事件信息        —— dbe_perf.statement_history（postgres 库）: 指定业务列一行输出，\n                              query_plan 和等待事件(statement_detail_decode)单独列出，最大/最小各一条
      4. sqlstat            —— postgres 库: sqlstat from statement
      5. tabstat            —— SQL 执行的库: table/index/column/partition/subpartition/extended statistics
      6. tabsize            —— SQL 执行的库: table/indexes/toast/total size
      7. opt params         —— postgres 库: 优化器相关参数(报告末尾)

    Args:
        unique_id: SQL 的 unique_query_id
        stat: 该 SQL 的统计信息字典（含 database/user/qry_text/max_duration_query 等）
        db_name: 数据库名（SQL 执行的库，用于表统计/表大小查询）
        timeout: vsql 超时时间
        wait_events_records: 该 SQL 的等待事件记录列表（query_wait_events_for_sql_ids 返回）
        debug: 是否打印调试日志
        statement_stats_text: 批量收集的 sqlstat 文本；None 时本函数内单查（回退）
        resolved_tables: 批量解析 schema 后的表列表 [(schema, table), ...]；
                         None 时本函数内提取并解析（回退）
        tabstats_text: 批量收集的 tabstat 文本；None 时本函数内单查（回退）
        tabsize_text: 批量收集的 tabsize 文本；None 时本函数内单查（回退）

    Returns:
        str: 完整的 SQLHC 文本报告
    """
    lines = []
    lines.append("================")
    lines.append(f"SQLHC Report for unique_query_id: {unique_id}")
    lines.append("================")
    lines.append("")

    sql_text = stat.get('max_duration_query', '') or stat.get('qry_text', '')
    user = (stat.get('user') or 'public').strip().lower()
    if user == 'vastbase':
        user = 'public'
    if debug:
        print(f"[DEBUG] sqlhc[{unique_id}]: db={db_name}, user={user}, wait_events={len(wait_events_records or [])}", file=sys.stderr)

    # 1. SQL 文本（日志中获取，参数已填充）
    lines.append("================")
    lines.append(f"sqltext(database: {db_name}  user: {user})")
    lines.append("================")
    lines.append(sql_text)
    lines.append("")

    # 2. 执行统计（日志侧）
    lines.append("================")
    lines.append("Execution Statistics (from log)")
    lines.append("================")
    lines.append(f"Total calls : {stat.get('count', 0)}")
    lines.append(f"Sum duration: {stat.get('sum_duration', 0):.3f}s")
    lines.append(f"Avg duration: {stat.get('avg_duration', 0):.3f}s")
    lines.append(f"Max duration: {stat.get('max_duration', 0):.3f}s")
    lines.append(f"Min duration: {stat.get('min_duration', 0):.3f}s")
    lines.append(f"Stddev      : {stat.get('duration_stddev', 0):.3f}s")
    lines.append(f"Lock wait   : {stat.get('sum_lock_wait_time_ms', 0)/1000:.3f}s")
    lines.append("")

    # 3. 等待事件信息（postgres 库 dbe_perf.statement_history，
    #    最大/最小执行时间点各 1 条: 业务列一行输出 + query_plan 单独列出
    #    + statement_detail_decode 等待事件单独列出）
    wait_events_block = _format_wait_events_for_sqlhc(wait_events_records)
    if wait_events_block:
        lines.append(wait_events_block)
    else:
        lines.append("================")
        lines.append("等待事件信息")
        lines.append("================")
        lines.append("No wait events found in statement_history.")
    lines.append("")

    # 4. sqlstat（postgres 库: dbe_perf.statement 实时统计 / opt params）
    if statement_stats_text is not None:
        lines.append(statement_stats_text)
    else:
        lines.append(query_sqlhc_statement_stats(unique_id, timeout=timeout, debug=debug))
    lines.append("")

    # 5. tabstat（SQL 执行的库: 表/索引/列/分区/子分区/扩展统计，对齐格式）
    if resolved_tables is not None:
        # 批量模式: 表已在主流程提取并解析 schema
        tables = resolved_tables
    else:
        tables = _extract_tables_from_sql(sql_text, default_user=user)
        if debug:
            print(f"[DEBUG] sqlhc[{unique_id}]: 提取表数量={len(tables)}, 默认 user={user}, tables={tables}", file=sys.stderr)
        if tables:
            # 在目标库解析表的实际 schema（未带 schema 的表可能不在执行用户同名 schema 下）
            tables = _resolve_table_schemas(tables, db_name, timeout=timeout, debug=debug)
    if tables:
        lines.append(f"Tables found: {', '.join(f'{o}.{t}' for o, t in tables)}")
        lines.append("")
        if tabstats_text is not None:
            lines.append(tabstats_text)
        else:
            lines.append(query_sqlhc_tabstats(tables, db_name, timeout, debug=debug))
    else:
        lines.append("No tables extracted from SQL, skip table statistics.")
    lines.append("")

    # 6. tabsize（SQL 执行的库: 表/索引/toast 大小）
    if tables:
        if tabsize_text is not None:
            lines.append(tabsize_text)
        else:
            lines.append(query_sqlhc_tabsize(tables, db_name, timeout, debug=debug))
    else:
        lines.append("No tables extracted from SQL, skip table size.")
    lines.append("")

    # 7. opt params 已从 sqlhc 文本移除（与具体 SQL 无关），
    #    改为在"汇总信息"栏目展示数据库版本并提供参数下载

    return '\n'.join(lines)


