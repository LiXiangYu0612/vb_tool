                     % esc(ts))
            continue
        cnt, itx, act, pid, xstart, state, ws, we, usi, oxmin, txid = (f + [""] * 11)[:11]
        te, xe = _ts_epoch(ts), _ts_epoch(xstart)
        if te is not None and xe is not None:
            age_v = te - xe
            dur_cell = '<td class="n%s">%s</td>' % (thr_cell_cls(age_v, 300.0, 1800.0), _fmt_duration(age_v))
        else:
            dur_cell = '<td class="n">-</td>'
        def _n(v):
            try:
                return '<td class="n%s">%s</td>' % (thr_cell_cls(float(v), 0.5, 10.0), fmt_int(float(v)))
            except ValueError:
                return '<td class="n">%s</td>' % (esc(v) if v else "-")
        cnt_cell = _n(cnt) + _n(itx) + _n(act)
        # prefer wait_event; show wait_status before it when both exist and differ
        if ws and we and ws != we and ws != "none":
            wait = "%s / %s" % (ws, we)
        else:
            wait = we or ws or "-"
        if usi in ("", "0"):
            usi_cell = '<span class="muted">-</span>'
        else:
