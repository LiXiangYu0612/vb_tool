    parts.append('<table class="t"><tr><th>Metric</th><th class="n">Begin</th><th class="n">End</th>'
                 '<th class="n">Δ</th></tr>')
    for _lbl, _b, _e, _fmt in (("session count", _bs[0], _es[0], lambda v: fmt_int(v)),
