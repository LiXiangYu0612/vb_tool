                min_prepared_text = _build_prepared_text(qry_text_full, min_execute_stmt, stat.get('qry_params', ''))
                min_prepared_btn = f"<button class='copy-btn' data-sql-b64=\"{_gz_b64(min_prepared_text)}\" data-filename=\"prepared_{unique_id_safe}_min.txt.gz\" onclick=\"downloadEmbeddedText(this)\">📥 下载 Prepared(.gz)</button>"
            else:
                qry_text_html = html.escape(qry_text_full, quote=True)
