                    HDR)  IFS='|' read -r h_node h_ver h_up <<< "$line";;
                    SESS) IFS='|' read -r s_tot s_act s_iit s_idle s_ltx s_avac s_smp s_jdbc <<< "$line";;
                    ISTAT) IFS='|' read -r i_xc i_xr i_br i_bh i_tb i_lsn i_nc i_pw i_dl <<< "$line"
