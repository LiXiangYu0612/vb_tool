            os.chmod(final_path, 0o664)
            
PYTHON_EOF

    # Execute the python script with the provided arguments
    python3 "$TEMP_SCRIPT" "$@"
    _vb_py_rc=$?
    # Clean up (rc captured BEFORE rm: the trailing rm used to mask python's rc)
    rm -f "$TEMP_SCRIPT"
    return $_vb_py_rc
}

