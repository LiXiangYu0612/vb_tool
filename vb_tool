            # as the label (collector emits $PGDATA first-level dirs, then
            # $PGHOME, then "reg other"). NO separate Deleted rows: a reg
            # row's count cells read "live(deleted deleted)" -- e.g.
            # "22(2 deleted)" -- and the delta column sums BOTH numbers
            # (live+deleted on each side). Old snaps carry the old flat role
            # classes (data files (base), device, ...): "device" folds into
            # "dev" in _fdmap, the remaining old classes render as reg
            # sub-rows via _FD_DISP's pretty names, and the reg top row is
            # recomputed as their sum when the collector row is absent.
            _FD_DISP = {"data files (base)": "Data Files (Base)",
                        "data files (global)": "Data Files (Global)",
