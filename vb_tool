def _extract_tables_from_sql(sql_text, default_user='public', _depth=0,
                             include_system=False, include_ddl=False):
    """从 SQL 文本中提取涉及的表名列表。

    参考 vb_tool sqlhc 的 extract_tables 逻辑，简化版：
    - 支持 UPDATE/INSERT/DELETE/MERGE 目标表提取
    - 支持 FROM/JOIN/USING 表提取
    - 支持 CTE 名称过滤
    - 默认 schema 补全

    Args:
        sql_text: SQL 文本（已填充参数）
        default_user: 默认 schema（通常为执行用户）

    Returns:
        list: [(owner, table_name), ...]
    """
    def normalize_user(user):
        user = user.strip().lower()
        return 'public' if user == 'vastbase' else user

    def strip_literals(s):
        out = []
        i = 0
        while i < len(s):
            if s[i] == "'":
                out.append("''")
                i += 1
                while i < len(s):
                    if s[i] == "'" and i + 1 < len(s) and s[i + 1] == "'":
                        i += 2
                    elif s[i] == "'":
                        i += 1
                        break
                    else:
                        i += 1
            elif s[i] == '"':
                out.append(s[i])
                i += 1
                while i < len(s) and s[i] != '"':
                    out.append(s[i])
                    i += 1
                if i < len(s):
                    out.append(s[i])
                    i += 1
            elif s[i] == '-' and i + 1 < len(s) and s[i + 1] == '-':
                while i < len(s) and s[i] != '\n':
                    i += 1
                out.append(' ')
            elif s[i] == '/' and i + 1 < len(s) and s[i + 1] == '*':
                i += 2
                while i < len(s) - 1 and not (s[i] == '*' and s[i + 1] == '/'):
                    i += 1
                i += 2
                out.append(' ')
            else:
                out.append(s[i])
                i += 1
        return ''.join(out)

    clean = strip_literals(sql_text)
    tokens = re.findall(
        r'(?:"[^"]*"|[a-zA-Z_]\w*)(?:\.(?:"[^"]*"|[a-zA-Z_]\w*))*'
        r'|[(),;]',
        clean
    )
    n = len(tokens)

    def is_kw(tok):
        return tok.lstrip('"').rstrip('"').lower() in _SQL_KW

    def add_table(raw):
        parts = re.findall(r'"[^"]*"|[^.]+', raw.strip())
        parts = [p.strip().strip('"').lower() for p in parts]
        if len(parts) == 1:
            owner = normalize_user(default_user)
            tname = parts[0]
        elif len(parts) == 2:
            owner, tname = parts
        else:
            owner, tname = parts[-2], parts[-1]
        if not include_system and (
                owner in ('pg_catalog', 'information_schema', 'sys', 'snapshot')
                or owner.startswith('pg_toast') or owner.startswith('cstore')
                or tname in _SYSTEM_TABLE_NAMES or tname in _SQL_FUNCS):
            return
        if tname and tname not in _SQL_KW:
            seen[(owner, tname)] = True

    def skip_subquery(pos):
        depth = 1
        pos += 1
        while pos < n and depth > 0:
            if tokens[pos] == '(':
                depth += 1
            elif tokens[pos] == ')':
                depth -= 1
            pos += 1
        return pos

    def skip_alias(pos):
        if pos >= n:
            return pos
        if tokens[pos].upper() == 'AS':
            pos += 1
        if pos < n and tokens[pos] not in (',', '(', ')', ';') and not is_kw(tokens[pos]):
            pos += 1
        return pos

    # CTE 收集
    cte_names = set()

    def collect_ctes():
        i = 0
        while i < n:
            if tokens[i].upper() == 'WITH':
                prev = tokens[i - 1].upper() if i > 0 else ''
                if prev == 'START':
                    i += 1
                    continue
                i += 1
                while i < n:
                    if tokens[i].upper() == 'RECURSIVE':
                        i += 1
                        continue
                    if is_kw(tokens[i]) or tokens[i] in ('(', ')', ',', ';'):
                        break
                    cte_name = tokens[i].lower().strip('"')
                    i += 1
                    if i >= n or tokens[i].upper() != 'AS':
                        break
                    i += 1
                    if i >= n or tokens[i] != '(':
                        break
                    cte_names.add(cte_name)
                    i = skip_subquery(i)
                    if i < n and tokens[i] == ',':
                        i += 1
                        continue
                    break
            i += 1

    collect_ctes()

    def add_table_checked(raw):
        name = raw.strip('"').lower().split('.')[-1]
        if name not in cte_names:
            add_table(raw)

    FROM_TRIGGERS = {
        'FROM', 'JOIN', 'INNER', 'LEFT', 'RIGHT', 'FULL',
        'CROSS', 'NATURAL', 'STRAIGHT_JOIN',
    }
    JOIN_NOISE = {'JOIN', 'OUTER', 'SEMI', 'ANTI', 'INTO', 'BY'}

    seen = {}
    i = 0
    while i < n:
        tok_up = tokens[i].upper()

        if tok_up == 'UPDATE' or (include_ddl and tok_up in (
                'CREATE', 'ALTER', 'DROP', 'TRUNCATE', 'REINDEX', 'VACUUM', 'ANALYZE')):
            j = i + 1
            if include_ddl:
                while j < n and tokens[j].upper() in (
                        'TABLE', 'INDEX', 'VIEW', 'MATERIALIZED', 'UNIQUE', 'CONCURRENTLY',
                        'IF', 'EXISTS', 'ONLY', 'GLOBAL', 'LOCAL', 'TEMP', 'TEMPORARY', 'UNLOGGED'):
                    j += 1
            if j < n and not is_kw(tokens[j]) and tokens[j] not in ('(', ')'):
                add_table_checked(tokens[j])
                j = skip_alias(j + 1)
            i = j if j > i else i + 1
            continue

        if tok_up in ('INSERT', 'MERGE'):
            j = i + 1
            if j < n and tokens[j].upper() == 'INTO':
                j += 1
            if j < n and not is_kw(tokens[j]) and tokens[j] not in ('(', ')'):
                add_table_checked(tokens[j])
                j = skip_alias(j + 1)
            i = j if j > i else i + 1
            continue

        if tok_up == 'DELETE':
            j = i + 1
            if j < n and tokens[j].upper() == 'FROM':
                j += 1
            if j < n and not is_kw(tokens[j]) and tokens[j] not in ('(', ')'):
                add_table_checked(tokens[j])
                j = skip_alias(j + 1)
            i = j if j > i else i + 1
            continue

        if tok_up in FROM_TRIGGERS:
            j = i + 1
            while j < n and tokens[j].upper() in JOIN_NOISE:
                j += 1
            while j < n:
                t = tokens[j]
                t_up = t.upper()
                if t == '(':
                    i = j
                    break
                if t in (')', ';'):
                    i = j
                    break
                if t_up in _SQL_KW and t_up not in ('AS',):
                    i = j
                    break
                add_table_checked(t)
                j = skip_alias(j + 1)
                if j < n and tokens[j] == ',':
                    j += 1
                    continue
                i = j
                break
            else:
                i = j
            continue

        if tok_up == 'USING':
            j = i + 1
            if j < n and tokens[j] == '(':
                j = skip_subquery(j)
                j = skip_alias(j)
            elif j < n and not is_kw(tokens[j]):
                add_table_checked(tokens[j])
                j = skip_alias(j + 1)
            i = j if j > i else i + 1
            continue

        i += 1

    result = [(o, t) for (o, t) in seen.keys() if t not in cte_names]

    # 递归提取字符串字面量中的 SQL（如 SELECT cb_run(4,'x','SELECT ... FROM tree_deep ...')：
    # 存储过程/函数参数里嵌套的真实 SQL 会被 strip_literals 抹掉，这里找回）
    if _depth < 2:
        for m in re.finditer(r"'((?:[^']|'')*)'", sql_text, re.DOTALL):
            literal = m.group(1).replace("''", "'")
            # 内容像 SQL 才递归（以 DML 关键字开头）
            if re.match(r"^\s*(select|insert|update|delete|merge|with)\b", literal, re.IGNORECASE):
                for ot in _extract_tables_from_sql(
                        literal, default_user, _depth + 1, include_system, include_ddl):
                    if ot not in result:
                        result.append(ot)

    return result


def _query_object_kinds(names, db_name, timeout=60, debug=False):
    """在指定库中按名称批量解析对象的实际 schema 与类型（V2 对象分类解析）。

    合并查询 pg_class（表/视图/物化视图/序列/外表）与 pg_proc（自定义函数/
    存储过程），系统 schema 已排除；同名重载函数全部返回。

    Args:
        names: 对象名列表（可含重复，会自动去重）
        db_name: 数据库名（SQL 执行的库）
        timeout: vsql 超时时间（秒）
        debug: 是否打印调试日志

    Returns:
        dict: {name: [(schema, name, kind), ...]}，kind ∈
              'table'/'view'/'matview'/'sequence'/'foreign'/'function'/'procedure'；
              查询失败返回 {}
    """
    kinds = {}
    names = sorted({t for t in names if t})
    if not names:
        return kinds
    names_csv = ','.join(f"'{t}'" for t in names)
    query = (
        "SELECT n.nspname, c.relname,"
        "       CASE c.relkind"
        "         WHEN 'r' THEN 'table'"
        "         WHEN 'p' THEN 'table'"
        "         WHEN 'v' THEN 'view'"
        "         WHEN 'm' THEN 'matview'"
        "         WHEN 'S' THEN 'sequence'"
        "         WHEN 'f' THEN 'foreign'"
        "         ELSE 'table' END"
        " FROM pg_catalog.pg_class c"
        " JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace"
        " WHERE c.relkind IN ('r','p','v','m','S','f')"
        "   AND n.nspname <> 'pg_catalog'"
        "   AND n.nspname !~ '^pg_toast'"
        "   AND n.nspname <> 'information_schema'"
        f"  AND c.relname IN ({names_csv})"
        " UNION ALL"
        " SELECT n.nspname, p.proname,"
        "        CASE p.prokind WHEN 'p' THEN 'procedure' ELSE 'function' END"
        " FROM pg_catalog.pg_proc p"
        " JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace"
        " WHERE p.prokind IN ('f','p')"
        "   AND n.nspname <> 'pg_catalog'"
        "   AND n.nspname <> 'information_schema'"
        f"  AND p.proname IN ({names_csv});"
    )
    if debug:
        print(f"[DEBUG] 对象分类解析: vsql -d {db_name} -X -q -A -t -F '|', 对象数={len(names)}", file=sys.stderr)
        print(f"[DEBUG] 对象分类解析 SQL:\n{query}", file=sys.stderr)
    try:
        process = subprocess.Popen(
            ['vsql', '-d', db_name, '-X', '-q', '-A', '-t', '-F', '|', '-c', query],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            universal_newlines=True
        )
        stdout, stderr = process.communicate(timeout=timeout)
    except Exception as e:
        if debug:
            print(f"[DEBUG] 对象分类解析失败: {e}", file=sys.stderr)
        return kinds
    if process.returncode != 0:
        if debug:
            print(f"[DEBUG] 对象分类解析失败: {stderr.strip()}", file=sys.stderr)
        return kinds

    for line in stdout.strip().split('\n'):
        line = line.strip()
        if not line or line.count('|') < 2:
            continue
        schema, oname, kind = [p.strip() for p in line.split('|')[:3]]
        if schema and oname and kind:
            kinds.setdefault(oname, []).append((schema, oname, kind))
    return kinds


def _query_view_dependencies(views, db_name, timeout=120, debug=False):
    """批量查询视图的直接依赖对象，供逐层递归展开。

    Returns:
        dict: {(view_schema, view_name): [(table_schema, table_name), ...]}
    """
    dependencies = {}
    views = sorted(set(views or []))
    if not views:
        return dependencies
    values = ','.join(
        "('" + schema.replace("'", "''") + "','" + name.replace("'", "''") + "')"
        for schema, name in views)
    query = (
        "SELECT view_schema, view_name, table_schema, table_name"
        " FROM information_schema.view_table_usage"
        f" WHERE (view_schema, view_name) IN ({values});"
    )
    if debug:
        print(f"[DEBUG] 视图依赖查询: db={db_name}, 视图数={len(views)}", file=sys.stderr)
    try:
        process = subprocess.Popen(
            ['vsql', '-d', db_name, '-X', '-q', '-A', '-t', '-F', '|', '-c', query],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            universal_newlines=True
        )
        stdout, stderr = process.communicate(timeout=timeout)
    except Exception as e:
        if debug:
            print(f"[DEBUG] 视图依赖查询失败: {e}", file=sys.stderr)
        return dependencies
    if process.returncode != 0:
        if debug:
            print(f"[DEBUG] 视图依赖查询失败: {stderr.strip()}", file=sys.stderr)
        return dependencies
    for line in stdout.splitlines():
        fields = [field.strip() for field in line.strip().split('|')]
        if len(fields) != 4 or not all(fields):
            continue
        view_schema, view_name, table_schema, table_name = fields
        key = (view_schema, view_name)
        dependency = (table_schema, table_name)
        dependencies.setdefault(key, [])
        if dependency not in dependencies[key]:
            dependencies[key].append(dependency)
    return dependencies


def _query_object_definitions(views, funcs, db_name, timeout=120, debug=False):
    """在指定库中批量查询视图/物化视图与函数/存储过程的完整定义（供递归提取引用对象）。

    复用 _run_vsql_batch block 模式：每个视图/函数一个 block，按 \\echo 标记
    切分输出。pg_get_viewdef(pretty)/pg_get_functiondef 返回多行文本，此前的
    行协议(vsql -A -t -F '|')按"一行=一条记录"解析会截断到首个物理行（SELECT
    列表），FROM/JOIN 所在的后续行被整体丢弃，递归展开在首层断链；block 模式
    按 marker 切分天然规避该问题，且单块查询失败（权限不足/对象被删）不再拖垮
    同会话的其他对象。定义文本经 SQL 侧 replace(chr(13)/chr(10), ' ') 折叠为
    单行并加 'DEF|' 前缀：对齐格式的列头/分隔线行被前缀过滤天然排除；同名函数
    重载时每个 oid 一行、每行一条定义。折叠不影响 _extract_tables_from_sql
    （token 级解析）与 _extract_routine_signature 签名提取。

    Args:
        views: [(schema, name), ...] 视图/物化视图
        funcs: [(schema, name), ...] 函数/存储过程
        db_name: 数据库名（SQL 执行的库）
        timeout: 单块超时时间（秒）
        debug: 是否打印调试日志

    Returns:
        dict: {(schema, name): [定义文本, ...]}；查询失败的键不在结果中
    """
    defs = {}
    blocks, key_by_marker = [], {}
    for idx, (schema, name) in enumerate(sorted(set(views or []))):
        if not schema or not name:
            continue
        marker = f"__SQLHC_BLOCK__:qdef{idx}:view__"
        query = (
            "SELECT 'DEF|' || replace(replace(pg_catalog.pg_get_viewdef(c.oid, true),"
            " chr(13), ' '), chr(10), ' ')"
            " FROM pg_catalog.pg_class c"
            " JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace"
            " WHERE c.relkind IN ('v','m')"
            f"  AND n.nspname = '{schema}' AND c.relname = '{name}';"
        )
        blocks.append((marker, query))
        key_by_marker[marker] = (schema, name)
    for idx, (schema, name) in enumerate(sorted(set(funcs or []))):
        if not schema or not name:
            continue
        marker = f"__SQLHC_BLOCK__:qdef{idx}:func__"
        query = (
            "SELECT 'DEF|' || replace(replace(pg_catalog.pg_get_functiondef(p.oid),"
            " chr(13), ' '), chr(10), ' ')"
            " FROM pg_catalog.pg_proc p"
            " JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace"
            " WHERE p.prokind IN ('f','p')"
            f"  AND n.nspname = '{schema}' AND p.proname = '{name}';"
        )
        blocks.append((marker, query))
        key_by_marker[marker] = (schema, name)
    if not blocks:
        return defs
    if debug:
        print(f"[DEBUG] 对象定义查询(block模式): vsql -d {db_name}, "
              f"视图={len(set(views or []))}, 函数={len(set(funcs or []))}, 块数={len(blocks)}", file=sys.stderr)
    results, error = _run_vsql_batch(
        db_name, blocks, timeout=timeout, debug=debug,
        label=f'sqlhc 递归定义查询({db_name})')
    if error:
        print(f"WARNING: sqlhc 递归定义批量查询({db_name}): {error}", file=sys.stderr)
    for marker, body in results.items():
        key = key_by_marker.get(marker)
        if key is None:
            continue
        for line in (body or '').splitlines():
            line = line.strip()
            if line.startswith('DEF|'):
                defs.setdefault(key, []).append(line[4:].strip())
    return defs


def _is_system_object(schema, name):
    """系统对象判定：系统 schema / 系统表名 / 内置函数名，不取定义、不递归。"""
    return (schema in ('pg_catalog', 'information_schema', 'sys', 'snapshot')
            or schema.startswith('pg_toast') or schema.startswith('cstore')
            or name in _SYSTEM_TABLE_NAMES or name in _SQL_FUNCS)


def _classify_frontier(frontier, kinds, db_name, default_schema='public'):
    """按对象分类结果拆分 frontier 为 表/视图/函数/跳过 四类。

    跨 schema 规则：
      - 对象显式带 schema（如 hr.employees）→ 只取该 schema 下的分类结果，
        即便其他 schema 存在同名对象也不混入
      - 未带 schema → 用 default_schema（与 SQL 相同的 schema）优先匹配；
        该 schema 无此对象时回退到全库唯一同名对象；多 schema 同名时按
        default_schema 归属（与 search_path 行为一致），避免跨 uid/schema 误挂
      - 解析不到的对象按表处理并保留原 schema 猜测（生成友好提示）
    """
    tables, views, funcs, unresolved = [], [], [], []
    for owner, name in frontier:
        if _is_system_object(owner, name):
            continue
        entries = kinds.get(name)
        if not entries:
            if (owner, name) not in unresolved:
                unresolved.append((owner, name))
            continue
        exact = [e for e in entries if e[0] == owner]
        if exact:
            use = exact
        else:
            # owner 为猜测 schema（未带 schema 时=default_schema）：优先同 schema，
            # 否则仅在全库唯一同名时采用，避免歧义时跨 schema 误挂
            preferred = [e for e in entries if e[0] == default_schema]
            use = preferred or (entries if len(entries) == 1 else
                                [e for e in entries if e[0] == owner])
        for schema, oname, kind in use:
            key = (schema, oname)
            if kind in ('table', 'foreign', 'matview'):
                if key not in tables:
                    tables.append(key)
            elif kind == 'view':
                if key not in views:
                    views.append(key)
            elif kind in ('function', 'procedure'):
                if key not in funcs:
                    funcs.append(key)
            # sequence 等其他类型：跳过统计收集
    return tables, views, funcs, unresolved


def _extract_routine_signature(funcdef):
    """从 pg_get_functiondef 输出提取函数签名（CREATE ... FUNCTION xxx(参数) 部分）。"""
    m = re.search(r'FUNCTION\s+([^\s(]+)\s*\(([^)]*)\)', funcdef or '', re.IGNORECASE | re.DOTALL)
    if not m:
        return ''
    args = ' '.join(m.group(2).split())
    return f"{m.group(1)}({args})"


def _expand_objects_recursive(objs0, db_name, timeout=60, debug=False, max_depth=5):
    """按 information_schema.view_table_usage 逐层展开视图依赖。

    表计入最终结果；视图记录定义供展示，并查询其直接依赖进入下一轮；
    函数/存储过程仅保留定义，不再解析定义文本递归内部对象。

    Returns:
        (tables_final, def_groups, truncated): 最终表集合、按层级排列的
        视图/函数定义组、是否达到最大递归深度。
    """
    tables_final = []
    def_groups = []
    visited = set()
    frontier = list(objs0 or [])
    truncated = False

    for depth in range(1, max_depth + 1):
        frontier = [o for o in frontier if o not in visited]
        if not frontier:
            break
        visited.update(frontier)

        kinds = _query_object_kinds([t for _, t in frontier], db_name, timeout=timeout, debug=debug)
        # 逐对象分类：default_schema 取该对象的 owner（显式 schema 或与来源 SQL
        # 相同的 schema），跨 schema 同名对象不会混入
        tables, views, funcs, unresolved = [], [], [], []
        for owner, name in frontier:
            t1, v1, f1, u1 = _classify_frontier(
                [(owner, name)], kinds, db_name, default_schema=owner or 'public')
            for key in t1:
                if key not in tables:
                    tables.append(key)
            for key in v1:
                if key not in views:
                    views.append(key)
            for key in f1:
                if key not in funcs:
                    funcs.append(key)
            for key in u1:
                if key not in unresolved:
                    unresolved.append(key)
        if debug:
            print(f"[DEBUG] 递归展开 depth={depth}: 表={tables}, 视图={views}, 函数={funcs}, 未解析={unresolved}", file=sys.stderr)
        for key in tables + unresolved:
            if key not in tables_final:
                tables_final.append(key)

        if not views and not funcs:
            break  # 已收敛为纯表

        def_map = _query_object_definitions(views, funcs, db_name, timeout=timeout, debug=debug)
        dependency_map = _query_view_dependencies(views, db_name, timeout=timeout, debug=debug)
        objects = []
        new_objs = []
        for schema, name in views:
            defs = def_map.get((schema, name), [])
            objects.append({'type': 'view', 'schema': schema, 'name': name,
                            'signature': '', 'define_sql': '',
                            'defs': defs,
                            'errors': [] if defs else ['无法获取定义（权限不足/对象被删/查询失败）']})
            for dependency in dependency_map.get((schema, name), []):
                if dependency not in new_objs:
                    new_objs.append(dependency)
        for schema, name in funcs:
            defs = def_map.get((schema, name), [])
            signature = _extract_routine_signature(defs[0]) if defs else ''
            objects.append({'type': 'function', 'schema': schema, 'name': name,
                            'signature': signature, 'define_sql': '',
                            'defs': defs,
                            'errors': [] if defs else ['无法获取定义（权限不足/对象被删/查询失败）']})
        def_groups.append({'depth': depth, 'objects': objects})
        frontier = new_objs
    else:
        truncated = True  # 达到 max_depth 仍有新对象：可能循环依赖

    if debug:
        print(f"[DEBUG] 递归展开完成: 表={len(tables_final)}, 定义组={len(def_groups)}, 深度超限={truncated}", file=sys.stderr)
    return tables_final, def_groups, truncated


def _format_object_definitions(def_groups, truncated=False):
    """把递归展开的视图/函数定义格式化为 sqlhc 的 object definitions 段。

    批量收集的 define_sql 优先；缺失时回退到折叠版 defs（换行折叠为空格）。
    """
    if not def_groups:
        return ''
    lines = ["==========================",
             "object definitions (视图/函数)",
             "=========================="]
    for group in def_groups:
        depth = group.get('depth', 1)
        for obj in group.get('objects', []):
            lines.append("")
            sig = obj.get('signature') or ''
            if sig:
                sig_base = sig.split('.', 1)[-1] if sig.split('(', 1)[0].count('.') else sig
                label = f"{obj.get('schema', '')}.{sig_base}"
            else:
                label = f"{obj.get('schema', '')}.{obj.get('name', '')}"
            lines.append(f"------ {obj.get('type', 'view')}: {label} (depth {depth}) ------")
            text = (obj.get('define_sql') or '').strip('\r\n')
            if not text:
                fold = [d for d in obj.get('defs', []) if d]
                text = '\n\n'.join(fold).strip()
            if text:
                lines.append(text)
            for err in obj.get('errors', []):
                lines.append(f"({err})")
    if truncated:
        lines.append("")
        lines.append("(递归深度超限，可能存在循环依赖)")
    return '\n'.join(lines)


def _build_sqlhc_tabstats_queries(tables):
    """按统计类型构建 8 个可独立执行的 tabstat SQL 查询。

    SQL 与 vb_tool v2.0.8 run_sqlhc 的 tabstat 段保持一致（含视图定义回退查询）。

    说明：Oracle 兼容性视图 dba_part_key_columns / dba_subpart_key_columns
    已按视图定义等价改写为 pg_partition/pg_class/pg_attribute/pg_namespace
    的原生写法（见下方 part_key_cols_sql / subpart_key_cols_sql），
    不再依赖兼容视图是否存在。

    Args:
        tables: [(owner, table_name), ...]

    Returns:
        list[tuple[str, str]]: (统计类型, 查询 SQL)，不含 \\echo 元命令
    """
    tables_in_clause = ','.join(f"('{o}','{t}')" for o, t in tables)

    # ---------------------------------------------------------------
    # dba_part_key_columns 的原生等价改写（PG 9.2 语法，无 LATERAL，
    # generate_subscripts 放在子查询 SELECT 列表中展开，与原视图定义一致）
    #   语义：每张分区表（pg_class.parttype in ('p','s')）对应 pg_partition 中
    #   parttype='r' 的根行，partkey(int2vector) 为分区键的 attnum 数组；
    #   展开后关联 pg_attribute 取列名，按 column_position(=ordinal+1) 顺序拼接。
    #   保留原视图的权限校验与系统 schema 排除；object_type='TABLE' 为常量，省略。
    # ---------------------------------------------------------------
    part_key_cols_sql = """
        select lower(s.rootschema) schema_name, lower(s.rootrelname) as name,
               lower(string_agg(a.attname::text, ',' order by s.ordinal)) cols
        from (
            select pd.parentid, pd.partkey,
                   generate_subscripts(pd.partkey, 1) ordinal,
                   ns.nspname rootschema, class.relname rootrelname,
                   class.oid classoid, ns.oid nsoid
            from pg_partition pd
            join pg_class class on class.oid = pd.parentid
            join pg_namespace ns on ns.oid = class.relnamespace
            where class.parttype in ('p', 's')
              and pd.parttype = 'r'
        ) s
        join pg_attribute a on a.attrelid = s.parentid and a.attnum = s.partkey[s.ordinal]
        where has_column_privilege(s.classoid, a.attnum, 'SELECT, INSERT, UPDATE, REFERENCES')
          and has_schema_privilege(s.nsoid, 'USAGE')
          and s.rootschema not in ('pg_catalog', 'information_schema', 'pg_toast')
        group by s.rootschema, s.rootrelname
    """

    # ---------------------------------------------------------------
    # dba_subpart_key_columns 的原生等价改写（PG 9.2 语法，无 LATERAL）
    #   语义：每张二级分区表（pg_class.parttype='s'）在 pg_partition 中
    #   parentid=表oid 且 parttype='p' 的行（一级分区），其 partkey 即子分区键；
    #   原视图用标量子查询取 LIMIT 1，这里保持完全相同的写法；
    #   若该子查询为 NULL，generate_subscripts 不产生行，inner join 自然过滤。
    # ---------------------------------------------------------------
    subpart_key_cols_sql = """
        select lower(s.rootschema) schema_name, lower(s.rootrelname) as name,
               lower(string_agg(a.attname::text, ',' order by s.ordinal)) cols
        from (
            select ns.nspname rootschema, class.relname rootrelname,
                   class.oid classoid,
                   (select p.partkey from pg_partition p
                    where p.parentid = class.oid and p.parttype = 'p'
                    limit 1) subpartkey,
                   generate_subscripts((select p.partkey from pg_partition p
                    where p.parentid = class.oid and p.parttype = 'p'
                    limit 1), 1) ordinal
            from pg_class class
            join pg_namespace ns on ns.oid = class.relnamespace
            where class.parttype = 's'
        ) s
        join pg_attribute a on a.attrelid = s.classoid and a.attnum = s.subpartkey[s.ordinal]
        group by s.rootschema, s.rootrelname
    """

    table_query = f"""
SELECT n.nspname AS "owner"
        ,c.relname AS "tab_name"
        ,CASE c.relpersistence
                WHEN 'p' THEN 'perm'
                WHEN 't' THEN 'temp'
                WHEN 'u' THEN 'unlog'
                END AS "tabtype"
        ,(select CASE p.partstrategy
            WHEN 'r'::"char" THEN 'RANGE'::varchar(9)
            WHEN 'i'::"char" THEN 'INTERVAL'::varchar(9)
            WHEN 'l'::"char" THEN 'LIST'::varchar(9)
            WHEN 'h'::"char" THEN 'HASH'::varchar(9)
            WHEN 'd'::"char" THEN 'HASH'::varchar(9)
            WHEN 'v'::"char" THEN 'VALUE'::varchar(9)
            WHEN 's'::"char" THEN 'SYSTEM'::varchar(9)
            WHEN 'n'::"char" THEN 'NONE'::varchar(9)
         ELSE NULL end from pg_partition p where p.parentid=c.oid limit 1)
         ||(CASE WHEN p2.cols is not null then '('||p2.cols||')' else '' end)
         ||(case when (select CASE p1.partstrategy
            WHEN 'r'::"char" THEN 'RANGE'::varchar(9)
            WHEN 'i'::"char" THEN 'INTERVAL'::varchar(9)
            WHEN 'l'::"char" THEN 'LIST'::varchar(9)
            WHEN 'h'::"char" THEN 'HASH'::varchar(9)
            WHEN 'd'::"char" THEN 'HASH'::varchar(9)
            WHEN 'v'::"char" THEN 'VALUE'::varchar(9)
            WHEN 's'::"char" THEN 'SYSTEM'::varchar(9)
            WHEN 'n'::"char" THEN 'NONE'::varchar(9)
         ELSE NULL end from pg_partition p,pg_partition p1 where p.parentid=c.oid and p1.parentid=p.oid limit 1) is not null
         then '-'||(select CASE p1.partstrategy
            WHEN 'r'::"char" THEN 'RANGE'::varchar(9)
            WHEN 'i'::"char" THEN 'INTERVAL'::varchar(9)
            WHEN 'l'::"char" THEN 'LIST'::varchar(9)
            WHEN 'h'::"char" THEN 'HASH'::varchar(9)
            WHEN 'd'::"char" THEN 'HASH'::varchar(9)
            WHEN 'v'::"char" THEN 'VALUE'::varchar(9)
            WHEN 's'::"char" THEN 'SYSTEM'::varchar(9)
            WHEN 'n'::"char" THEN 'NONE'::varchar(9)
         ELSE NULL end from pg_partition p,pg_partition p1 where p.parentid=c.oid and p1.parentid=p.oid limit 1)||'('||p1.cols||')'
         else '' end) parttype
        ,c.relpages
        ,c.reltuples
        ,c.relallvisible allvisible
        ,pg_catalog.pg_size_pretty(pg_catalog.pg_table_size(c.oid)) AS "size"
        ,replace(replace(replace(c.reloptions::text,'orientation','ori'),'compression','comp'),'fillfactor','fill') as options
FROM pg_catalog.pg_class c
LEFT JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
LEFT JOIN ({subpart_key_cols_sql}) p1 ON lower(c.relname)=p1.name and p1.schema_name=lower(n.nspname)
LEFT JOIN ({part_key_cols_sql}) p2 ON lower(c.relname)=p2.name and p2.schema_name=lower(n.nspname)
WHERE c.relkind IN ('r','p','v','m','S','f','')
        AND n.nspname <> 'pg_catalog'
        AND n.nspname !~ '^pg_toast'
        AND n.nspname <> 'information_schema'
        AND ((n.nspname, c.relname) IN ({tables_in_clause}) or (n.nspname, c.relname) IN (select table_schema,table_name from information_schema.view_table_usage where (view_schema,view_name) IN ({tables_in_clause})));
"""

    table_activity_query = f"""
select schemaname,relname,n_tup_ins,n_tup_upd,n_tup_del,n_tup_hot_upd,n_live_tup,n_dead_tup,
       to_char(last_vacuum,'yyyy-mm-dd hh24:mi:ss') last_vacuum,
       to_char(last_analyze,'yyyy-mm-dd hh24:mi:ss') last_analyze
from pg_stat_all_tables
where ((schemaname, relname) IN ({tables_in_clause}) or (schemaname, relname) IN (select table_schema,table_name from information_schema.view_table_usage where (view_schema,view_name) IN ({tables_in_clause})));
"""

    index_query = f"""
SELECT n.nspname AS "ind_owner"
        ,c2.relname AS "tab_name"
        ,c.relname AS "ind_name"
        ,replace(am.amname||' '||decode(i.indisunique,'t','unique')||' '
            ||CASE WHEN c.relkind = 'i' and pg_catalog.pg_get_indexdef(i.indexrelid, 0, true) ~ '\\)\\s*LOCAL' then 'local'
                   WHEN c.relkind = 'I' then 'global'
               ELSE NULL END,'  ',' ') ind_type
        ,decode(i.indisusable,'t','usable','unusable') status
        ,lower(REGEXP_REPLACE(TRIM(BOTH FROM SUBSTRING(pg_catalog.pg_get_indexdef(i.indexrelid, 0, true)
            FROM 'USING\\s+\\w+\\s+\\(((?:[^()]+|\\([^()]*\\))*)\\)')),
            '(,|^)\\s*([^,]+?)(?<!DESC)(?<!ASC)\\b\\s*(DESC|ASC)\\b','\\1\\2','gi')) col_list
        ,c.relpages
        ,c.reltuples
        ,pg_catalog.pg_size_pretty(pg_catalog.pg_table_size(c.oid)) AS "Size"
FROM pg_catalog.pg_class c
LEFT JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
LEFT JOIN pg_catalog.pg_am am ON am.oid = c.relam
LEFT JOIN pg_catalog.pg_index i ON i.indexrelid = c.oid
LEFT JOIN pg_catalog.pg_class c2 ON i.indrelid = c2.oid
LEFT JOIN pg_catalog.pg_namespace n1 ON n1.oid = c2.relnamespace
WHERE c.relkind IN ('i','I','')
        AND n.nspname <> 'pg_catalog'
        AND n.nspname !~ '^pg_toast'
        AND n.nspname <> 'information_schema'
        AND ((n1.nspname, c2.relname) IN ({tables_in_clause}) or (n1.nspname, c2.relname) IN (select table_schema,table_name from information_schema.view_table_usage where (view_schema,view_name) IN ({tables_in_clause})))
        order by 1,2;
"""

    index_activity_query = f"""
select schemaname,relname tab_name,indexrelname index_name,idx_scan,idx_tup_read,idx_tup_fetch
from pg_stat_all_indexes
where ((schemaname, relname) IN ({tables_in_clause}) or (schemaname, relname) IN (select table_schema,table_name from information_schema.view_table_usage where (view_schema,view_name) IN ({tables_in_clause})))
order by 1,2;
"""

    column_query = f"""
SELECT
    relname AS tab_name,
    t.attname AS col_name,
    CASE
        WHEN t.type LIKE '%without time zone%' THEN replace(t.type, ' without time zone', '')
        WHEN t.type LIKE '%with time zone%' THEN replace(replace(t.type, ' with time zone', ''), 'timestamp', 'timestamptz')
        ELSE t.type
    END AS type,
    decode(attstorage, 'p', 'plain', 'e', 'external', 'm', 'main', 'x', 'extended') AS attstorage,
    decode(attnotnull, 'true', 'not null', round(null_frac, 5)) AS nullfreq,
    avg_width,
    round(n_distinct, 5) AS n_dist,
    round(correlation, 5) AS corr,
    t1.top3_freqs
FROM (
    SELECT
        c.relname,
        a.attname,
        a.attnum,
        pg_catalog.format_type(a.atttypid, a.atttypmod) AS type,
        a.attnotnull,
        b.null_frac,
        b.avg_width,
        b.n_distinct,
        b.correlation,
        a.attstorage,
        d.nspname
    FROM pg_catalog.pg_attribute a
    JOIN pg_class c ON a.attrelid = c.oid
    JOIN pg_catalog.pg_namespace d ON c.relnamespace = d.oid
    LEFT JOIN pg_catalog.pg_stats b ON a.attname = b.attname
        AND c.relname = b.tablename
        AND b.schemaname = d.nspname
    WHERE a.attrelid = c.oid
        AND a.attnum > 0
        AND NOT a.attisdropped
        AND (d.nspname, c.relname) IN ({tables_in_clause})
) t
LEFT JOIN (
    SELECT
        tablename,
        schemaname,
        attname,
        CONCAT(
            COALESCE(split_part(val_string, '|', 1), '') ||
            CASE WHEN split_part(val_string, '|', 1)  is not null  and split_part(val_string, '|', 1) is distinct from ''
                 THEN '(' || COALESCE(split_part(freq_string, '|', 1)::NUMERIC::TEXT, '0') || ')'
                 ELSE ''
            END,
            CASE WHEN split_part(val_string, '|', 2)  is not null  and split_part(val_string, '|', 2) is distinct from ''
                 THEN CHR(10) || split_part(val_string, '|', 2) ||
                      '(' || COALESCE(split_part(freq_string, '|', 2)::NUMERIC::TEXT, '0') || ')'
                 ELSE ''
            END,
            CASE WHEN split_part(val_string, '|', 3)  is not null  and split_part(val_string, '|', 3) is distinct from ''
                 THEN CHR(10) || split_part(val_string, '|', 3) ||
                      '(' || COALESCE(split_part(freq_string, '|', 3)::NUMERIC::TEXT, '0') || ')'
                 ELSE ''
            END
        ) AS top3_freqs
    FROM (
        SELECT
            tablename,
            schemaname,
            attname,
            array_to_string(most_common_vals, '|') AS val_string,
            array_to_string(most_common_freqs, '|') AS freq_string
        FROM pg_stats
        WHERE (schemaname, tablename) IN ({tables_in_clause})
            AND most_common_freqs IS NOT NULL
    ) t2
) t1 ON t.attname = t1.attname
    AND t.relname = t1.tablename
    AND t.nspname = t1.schemaname
ORDER BY t.nspname, t.relname, t.attnum;
"""

    partition_query = f"""
select n.nspname schema_name,c.relname tab_name,partitionno partno,p.relname part_name,
       CASE p.partstrategy
            WHEN 'r'::"char" THEN 'RANGE'::varchar(9)
            WHEN 'i'::"char" THEN 'INTERVAL'::varchar(9)
            WHEN 'l'::"char" THEN 'LIST'::varchar(9)
            WHEN 'h'::"char" THEN 'HASH'::varchar(9)
            WHEN 'd'::"char" THEN 'HASH'::varchar(9)
            WHEN 'v'::"char" THEN 'VALUE'::varchar(9)
            WHEN 's'::"char" THEN 'SYSTEM'::varchar(9)
            WHEN 'n'::"char" THEN 'NONE'::varchar(9)
         ELSE NULL end parttype,
       cols partkey,p.relpages,p.reltuples,
       pg_size_pretty(pg_partition_size(p.parentid,p.oid)) as size,boundaries
from pg_partition p
    ,pg_class c
    ,({part_key_cols_sql}) p1
    ,pg_namespace n
where p.parttype in ('p')
  and c.oid=p.parentid
  and p.subpartitionno is null
  and p1.name=c.relname
  and n.oid=c.relnamespace
  and p1.schema_name=n.nspname
  and ((n.nspname, c.relname) IN ({tables_in_clause}) or (n.nspname, c.relname) IN (select table_schema,table_name from information_schema.view_table_usage where (view_schema,view_name) IN ({tables_in_clause})))
order by 1,2,3;
"""

    subpartition_query = f"""
select c.relname tab_name,p.relname part_name,ps.relname subpart_name,
       CASE p.partstrategy
            WHEN 'r'::"char" THEN 'RANGE'::varchar(9)
            WHEN 'i'::"char" THEN 'INTERVAL'::varchar(9)
            WHEN 'l'::"char" THEN 'LIST'::varchar(9)
            WHEN 'h'::"char" THEN 'HASH'::varchar(9)
            WHEN 'd'::"char" THEN 'HASH'::varchar(9)
            WHEN 'v'::"char" THEN 'VALUE'::varchar(9)
            WHEN 's'::"char" THEN 'SYSTEM'::varchar(9)
            WHEN 'n'::"char" THEN 'NONE'::varchar(9)
         ELSE NULL end||'('||p1.cols||')-'
       ||CASE ps.partstrategy
            WHEN 'r'::"char" THEN 'RANGE'::varchar(9)
            WHEN 'i'::"char" THEN 'INTERVAL'::varchar(9)
            WHEN 'l'::"char" THEN 'LIST'::varchar(9)
            WHEN 'h'::"char" THEN 'HASH'::varchar(9)
            WHEN 'd'::"char" THEN 'HASH'::varchar(9)
            WHEN 'v'::"char" THEN 'VALUE'::varchar(9)
            WHEN 's'::"char" THEN 'SYSTEM'::varchar(9)
            WHEN 'n'::"char" THEN 'NONE'::varchar(9)
         ELSE NULL end||'('||p2.cols||')' part_type,
       ps.relpages,ps.reltuples,
       pg_size_pretty(pg_partition_size(ps.parentid,ps.oid)) as size,
       p.boundaries partbound,ps.boundaries subpartbound
from pg_partition p
    ,pg_partition ps
    ,pg_class c
    ,pg_namespace n
    ,({part_key_cols_sql}) p1
    ,({subpart_key_cols_sql}) p2
where (p.parttype='s' or (p.parttype='p' and p.subpartitionno is not null))
  and c.oid=p.parentid
  and c.relname=p1.name
  and n.oid=c.relnamespace
  and p1.schema_name=n.nspname
  and ps.parentid=p.oid
  and ((n.nspname, c.relname) IN ({tables_in_clause}) or (n.nspname, c.relname) IN (select table_schema,table_name from information_schema.view_table_usage where (view_schema,view_name) IN ({tables_in_clause})))
order by 1,2,3;
"""

    extended_query = f"""
SELECT a.schemaname as owner
        ,a.tablename tab_name
        ,a.attname
        ,null_frac
        ,avg_width
        ,n_distinct
        ,n_dndistinct
        ,top3_freqs
FROM (
        SELECT schemaname,tablename,attname,null_frac,avg_width,n_distinct,n_dndistinct
        FROM pg_catalog.pg_ext_stats
        WHERE (schemaname, tablename) IN ({tables_in_clause})
        ) a
LEFT JOIN (
        SELECT tablename,schemaname,attname,
               string_agg(top3_freq::TEXT,',' ORDER BY top3_freq DESC) top3_freqs
        FROM (
                SELECT tablename,schemaname,attname,
                       round(UNNEST(most_common_freqs)::DECIMAL,4) top3_freq,
                       row_number() OVER (PARTITION BY tablename,attname
                           ORDER BY round(UNNEST(most_common_freqs)::DECIMAL,4) DESC) rn
                FROM pg_catalog.pg_ext_stats
                WHERE ((schemaname, tablename) IN ({tables_in_clause}) or (schemaname, tablename) IN (select table_schema,table_name from information_schema.view_table_usage where (view_schema,view_name) IN ({tables_in_clause})))
                ) d
        WHERE rn <= 3
        GROUP BY attname,tablename,schemaname
        ) b ON a.attname=b.attname and a.tablename=b.tablename and a.schemaname=b.schemaname;
"""
    return [
        ('table statistics', table_query),
        ('table activity', table_activity_query),
        ('index statistics', index_query),
        ('index activity', index_activity_query),
        ('column statistics', column_query),
        ('partition statistics', partition_query),
        ('subpartition statistics', subpartition_query),
        ('extended statistics', extended_query),
    ]


def _append_vsql_commands(args, script):
    r"""把 SQL 和 \echo 标题合并为单个 -c 命令，不依赖 stdin 管道或 \echo 输出。

    Vastbase vsql 同一进程多个 -c 时仅输出最后一条查询结果，因此脚本内的
    所有语句（\echo 标题已等价转为 SELECT 常量）必须拼接为一个 -c 传入；
    vsql 经简单查询协议按顺序执行并输出全部结果集。stdin 管道方式会导致
    vsql 连接不释放只能等超时，故不使用。
    """
    commands = []
    for command in re.findall(r'(?ms)^\s*(\\echo[^\n]*|.*?;)\s*', script):
        command = command.strip()
        if not command:
            continue
        if command.startswith('\\echo '):
            text = command[6:].strip()
            if len(text) >= 2 and text[0] == text[-1] and text[0] in "'\"":
                text = text[1:-1]
            command = 'SELECT ' + repr(text).replace('\\', '\\\\') + ';'
        commands.append(command)
    if commands:
        args.extend(['-c', '\n'.join(commands)])
    return args


# \echo 标题经 SELECT 常量执行后, vsql 对齐格式为其输出的
# "?column?" 列头行 + "----" 分隔线行(仅这两行, 标题值行保留)
_ECHO_COLUMN_HEADER_RE = re.compile(
    r'^[ \t]*\?column\?[ \t]*\r?\n[ \t]*-{2,}[ \t]*\r?\n', re.MULTILINE)


def _strip_echo_headers(text):
    r"""过滤 \echo 标题(SELECT 常量)输出附带的 ?column? 列头与分隔线。

    真实查询的输出列均有别名(如 owner/tab_name), 其列头+分隔线不受影响;
    已带 -A -t 的调用方(对象定义等)本就无列头, 过滤为空操作。
    """
    if not text or '?column?' not in text:
        return text
    return _ECHO_COLUMN_HEADER_RE.sub('', text)


def query_sqlhc_tabstats(tables, db_name, timeout=120, debug=False, label='sqlhc tabstats'):
    """按 8 类统计分别执行 vsql -c，单段失败不影响其他段。

    连接 SQL 实际执行的库查询，对齐格式输出；每段使用独立超时，
    按原顺序拼接结果，便于从日志定位具体慢查询类型。

    Args:
        tables: [(owner, table_name), ...]
        db_name: 数据库名（SQL 执行的库）
        timeout: 每个统计段的 vsql 超时时间（秒）
        debug: 是否打印调试日志
        label: 调试日志前缀（批量路径含表集合编号）

    Returns:
        str: 格式化的文本结果（vsql 对齐格式）
    """
    if not tables:
        if debug:
            print(f"[DEBUG] {label}: 表列表为空, db={db_name}", file=sys.stderr)
        return "No tables found."

    results = []
    for section, query in _build_sqlhc_tabstats_queries(tables):
        args = ['vsql', '-d', db_name, '-X', '-P', 'footer=off', '-c', query]
        started = time.monotonic()
        process = None
        if debug:
            print(f"[DEBUG] {label}({section}): 开始, timeout={timeout}s", file=sys.stderr)
        try:
            process = subprocess.Popen(
                args, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                universal_newlines=True
            )
            stdout, stderr = process.communicate(timeout=timeout)
        except FileNotFoundError:
            stdout, stderr = '', 'vsql not found.'
        except subprocess.TimeoutExpired:
            process.kill()
            process.communicate()
            stdout, stderr = '', f'Query timeout after {timeout}s.'
        except Exception as e:
            stdout, stderr = '', f'Query error: {e}'

        if process is not None and process.returncode:
            stdout = ''
            stderr = stderr.strip() or f'vsql exit code {process.returncode}'
        body = _strip_echo_headers(stdout).strip() if not stderr else stderr.strip()
        if debug:
            print(f"[DEBUG] {label}({section}): 耗时 {time.monotonic() - started:.1f}s, "
                  f"returncode={process.returncode if process is not None else 'N/A'}, "
                  f"输出长度={len(stdout)}, stderr={stderr.strip()!r}", file=sys.stderr)
        results.append(f"================\n{section}\n================\n{body}")
    return '\n\n'.join(results)


def _build_sqlhc_statement_stats_query(uid):
    """构建单个 uid 的 sqlstat 查询 SQL。

    SQL 取自 vb_tool v2.0.8 run_sqlhc 的 postgres 段（psql -d postgres）。

    Args:
        uid: unique_sql_id（int）

    Returns:
        str: 完整查询文本（vsql 脚本，含 \\echo 分段标题）
    """
    return f"""
\\echo '======================'
\\echo 'sqlstat from statement'
\\echo '======================'
\\echo '                          '
SELECT user_name,n_calls,
round(db_time/1e3/nullif(n_calls,0),1) avg_db_ms,
round(execution_time/1e3/nullif(n_calls,0),1) avg_et_ms,
round(cpu_time/1e3/nullif(n_calls,0),1) avg_cpu_ms,
round(data_io_time/1e3/nullif(n_calls,0),1) avg_io_ms,
round((parse_time+plan_time+rewrite_time)/1e3/nullif(n_calls,0),1) avg_plan_ms,
round(pl_execution_time/1e3/nullif(n_calls,0),1) avg_plsql_ms,
round(sort_time/1e3/nullif(n_calls,0),1) a_sort_ms,
round(hash_time/1e3/nullif(n_calls,0),1) a_hash_ms,
round(n_blocks_fetched/nullif(n_calls,0),1) avg_cr,
round((n_blocks_fetched-n_blocks_hit)/nullif(n_calls,0),1) avg_pr,
round((n_returned_rows+n_tuples_inserted+n_tuples_updated+n_tuples_deleted)/nullif(n_calls,0),1) avg_rows
FROM dbe_perf.statement WHERE unique_sql_id={uid};
"""


def query_sqlhc_statement_stats(unique_id, timeout=120, debug=False):
    """连接 postgres 库查询单个 uid 的 SQL 统计信息（sqlstat from statement）。

    对齐格式输出。批量收集场景请用 batch_query_sqlhc_statement_stats。

    Args:
        unique_id: unique_query_id
        timeout: vsql 超时时间（秒）
        debug: 是否打印调试日志

    Returns:
        str: 格式化的文本结果（vsql 对齐格式）
    """
    try:
        uid = int(str(unique_id).strip())
    except (ValueError, TypeError):
        return f"无效的 unique_query_id: {unique_id}"

    query = _build_sqlhc_statement_stats_query(uid)

    if debug:
        print("[DEBUG] sqlhc statement stats 执行命令: vsql -d postgres -X -P footer=off -c <command>", file=sys.stderr)
        print(f"[DEBUG] sqlhc statement stats 完整 SQL:\n{query}", file=sys.stderr)
    args = _append_vsql_commands(
        ['vsql', '-d', 'postgres', '-X', '-P', 'footer=off'], query)
    try:
        # dbe_perf.statement 固定连接 postgres 库查询
        process = subprocess.Popen(
            args, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            universal_newlines=True
        )
        stdout, stderr = process.communicate(timeout=timeout)
    except FileNotFoundError:
        return "vsql not found, skip statement stats."
    except subprocess.TimeoutExpired:
        process.kill()
        process.communicate()
        return f"Query timeout after {timeout}s."
    except Exception as e:
        return f"Query error: {e}"

    if debug and stderr.strip():
        print(f"[DEBUG] sqlhc statement stats vsql stderr:\n{stderr.strip()}", file=sys.stderr)
    if process.returncode != 0:
        return f"Query failed: {stderr.strip()}"

    result = _strip_echo_headers(stdout).rstrip()
    if debug:
        print(f"[DEBUG] sqlhc statement stats: uid={uid}, 返回长度={len(result)}", file=sys.stderr)
    return result


def query_sqlhc_opt_params(timeout=120, debug=False):
    """连接 postgres 库查询优化器相关参数（opt params）与数据库版本。

    SQL 取自 vb_tool v2.0.8 run_sqlhc 的 opt params 段。
    与具体 SQL 无关，整个报告只需查询一次，结果展示在"汇总信息"栏目。

    Args:
        timeout: vsql 超时时间（秒）
        debug: 是否打印调试日志

    Returns:
        dict: {
            'version': 数据库版本+兼容性文本（含原始对齐输出，用于汇总信息展示）,
            'params_text': opt params 完整文本（含版本头，用于下载）,
            'error': 查询失败时的错误信息（成功时为 None）
        }
    """
    # 版本查询: vsql 默认对齐输出,直接展示到汇总信息
    version_query = "select vb_version(),(select distinct datcompatibility from pg_database);"
    # 参数查询: 纯 SELECT 输出，下载为文本
    params_query = """
SELECT name,
       decode(unit, '8kB', setting*8||'kB', setting||COALESCE(unit,' ')) setting,
       context,
       short_desc
FROM pg_settings
WHERE (
    lower(short_desc) LIKE '%plan%'
    OR lower(short_desc) LIKE '%rewrite%'
    OR lower(short_desc) LIKE '%expr%'
    OR lower(short_desc) LIKE '%from-list%'
    OR name LIKE 'geqo%'
    OR name LIKE '%cost%'
    OR short_desc LIKE '%partition%'
    OR short_desc LIKE '%elimination%'
    OR name IN ('work_mem', 'shared_buffers')
    OR category LIKE 'Query Tuning%'
    OR short_desc LIKE '%targetlist%'
)
AND name NOT IN ('num_internal_lock_partitions', 'partition_lock_upgrade_timeout', 'log_max_size')
ORDER BY CASE WHEN short_desc LIKE '%planner%' THEN 'planner' ELSE short_desc END;
"""

    def _run(q, tag):
        if debug:
            print(f"[DEBUG] sqlhc opt params({tag}) 执行命令: vsql -d postgres -X -P footer=off -c <command>", file=sys.stderr)
            print(f"[DEBUG] sqlhc opt params({tag}) 完整 SQL:\n{q}", file=sys.stderr)
        try:
            args = _append_vsql_commands(
                ['vsql', '-d', 'postgres', '-X', '-P', 'footer=off'], q)
            process = subprocess.Popen(
                args, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                universal_newlines=True
            )
            out, err = process.communicate(timeout=timeout)
        except FileNotFoundError:
            return None, "vsql not found"
        except subprocess.TimeoutExpired:
            process.kill()
            process.communicate()
            return None, f"query timeout after {timeout}s"
        except Exception as e:
            return None, f"query error: {e}"
        if debug and err.strip():
            print(f"[DEBUG] sqlhc opt params({tag}) vsql stderr:\n{err.strip()}", file=sys.stderr)
        if process.returncode != 0:
            return None, '数据库不可用或查询失败'
        return _strip_echo_headers(out).rstrip(), None

    version_text, ver_err = _run(version_query, 'version')
    params_body, par_err = _run(params_query, 'params')
    err = ver_err or par_err

    header = ("==========================\n"
              "        opt params        \n"
              "==========================\n")
    parts = []
    if version_text:
        parts.append(version_text)
    if params_body:
        parts.append(params_body)
    params_text = header + "\n\n".join(parts) if parts else ""

    if debug:
        print(f"[DEBUG] sqlhc opt params: version长度={len(version_text or '')}, params长度={len(params_body or '')}, error={err}", file=sys.stderr)

    return {
        'version': version_text or '',
        'params_text': params_text,
        'error': err,
    }


def _build_sqlhc_tabsize_query(tables):
    """构建 tabsize 查询：所有表、索引及 TOAST 均使用数据库真实尺寸函数。

    目标表 OID 集合驱动查询，分区父表的尺寸函数已包含其分区，不重复累加；
    table_size 只计算一次，total_size 复用各分项。
    """
    tables_in_clause = ','.join(f"('{o}','{t}')" for o, t in tables)

    return f"""
\\echo '================'
\\echo 'table size'
\\echo '================'
WITH target_oids AS (
    SELECT c.oid
    FROM pg_class c
    JOIN pg_namespace n ON n.oid = c.relnamespace
    WHERE c.relkind IN ('r', 'p', 'l')
      AND (n.nspname, c.relname) IN ({tables_in_clause})
      AND NOT EXISTS (SELECT 1 FROM pg_inherits i WHERE i.inhrelid = c.oid)
), table_sizes AS (
    SELECT c.oid, c.relname, n.nspname,
           pg_table_size(c.oid) AS table_size,
           pg_indexes_size(c.oid) AS indexes_size,
           pg_table_size(c.reltoastrelid) AS toast_size,
           pg_indexes_size(c.reltoastrelid) AS toast_indexes_size
    FROM target_oids t
    JOIN pg_class c ON c.oid = t.oid
    JOIN pg_namespace n ON n.oid = c.relnamespace
), final_sizes AS (
    SELECT *,
           table_size + indexes_size + toast_size + toast_indexes_size AS total_size
    FROM table_sizes
)
SELECT current_database() AS dbname, nspname AS schemaname, relname AS tablename,
       pg_size_pretty(table_size) AS "table_size",
       pg_size_pretty(indexes_size) AS "indexes_size",
       pg_size_pretty(toast_size) AS "toast_size",
       pg_size_pretty(toast_indexes_size) AS "toast_indexes_size",
       pg_size_pretty(total_size) AS "total_size"
FROM final_sizes
ORDER BY total_size DESC;
"""


def query_sqlhc_tabsize(tables, db_name, timeout=120, debug=False):
    """查询单个 uid 表集合的表大小信息（table + indexes + toast）。

    SQL 取自 vb_tool v2.0.8 tabsize 段（分区表特殊处理：主表 + 所有分区），
    连接 SQL 实际执行的库查询，对齐格式输出。

    Args:
        tables: [(owner, table_name), ...]
