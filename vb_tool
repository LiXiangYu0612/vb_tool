    # default): the ESC that opens the command line and every arrow/function key
    # (ESC-led sequences) flashed a stray "^" at the bottom of the frame. top/htop
    # run noecho for exactly this reason. The "Enter:" prompt does NOT re-enable echo
    # -- _vtop_cmd_line hand-echoes each accepted char itself and the tty stays noecho
    # the whole time; the EXIT trap restores. stdin must
    # be the tty -- a piped stdin echoes nothing anyway (and stty would fail).
    if [ "$interactive" = "1" ] && [ -t 0 ]; then
        stty -echo 2>/dev/null && _vtop_stty=1
    fi
    local prev_rsent= prev_rwr= prev_rfl= prev_rrp=
    # ★HINT 光标 (用户令 2026-11-17: 方向键移动、回车进对应子屏): hint_cur = 选中项
    #   (1..15; 0=框在 HINT 标签上, 2026-11-27 用户令 "默认框放在HINT那里吧" 推翻
    #   11-18 "默认放第一个" -- 框在 s=sess 时开屏一按回车就直进 [SESS], ENTER:
    #   命令行够不着)。_hint_screens 与 HINT 行的 15 个条目一一对应 (顺序也是)。
    #   开屏 0=框在 [HINT]: Enter=原命令行, 方向键走进条目; ESC/子屏返回回 0=框回 HINT。
    local hint_cur=0
    local _hint_screens=(sess ltx istat wait xlog repl memctx topsql lock stack iostat cpu vmstat net osmem)
    local prev_xc="" prev_xr="" prev_br="" prev_bh="" prev_tb="" prev_lsn="" prev_nc="" prev_pw=""
    local ist_qps= ist_cm= ist_roll= ist_tps= ist_lg= ist_ph= ist_pw= ist_rd= ist_tp= ist_dl=

