def _split_param_segments(params):
    """按引号外的逗号拆分 parameters 字符串。

    引号内的逗号（如 '$1 = "a,b"'）不作为分隔符；
    括号内的逗号（如 type = numeric(10,2)）也不作为分隔符。
    """
    segments, buf = [], []
    i, in_quote, depth = 0, False, 0
    while i < len(params):
        c = params[i]
        if in_quote:
            buf.append(c)
            if c == "'":
                if i + 1 < len(params) and params[i + 1] == "'":
                    buf.append(params[i + 1])
                    i += 2
                    continue
                in_quote = False
            i += 1
        else:
            if c == "'":
                in_quote = True
                buf.append(c)
                i += 1
            elif c == '(':
                depth += 1
                buf.append(c)
                i += 1
            elif c == ')':
                depth = max(0, depth - 1)
                buf.append(c)
                i += 1
            elif c == ',' and depth == 0:
                segments.append(''.join(buf))
                buf = []
                i += 1
            else:
                buf.append(c)
                i += 1
    segments.append(''.join(buf))
    return segments


def _parse_bind_params(params):
    """解析 parameters 字符串为 (编号, 值, 类型) 列表。

    支持两种格式:
      - 新格式（带绑定变量类型）: $1 = '100' type = bigint, $2 = 'abc' type = text
      - 旧格式: $1 = 'value1', $2 = 'value2'

    type = xxx 是绑定变量的类型标注而非值的一部分；仅在引号外识别，
    避免把值内部的 " type = " 字样误判为类型标注。

    Returns:
        list: [(param_num_str, value, type_or_None), ...] 按出现顺序
    """
    parsed = []
    for seg in _split_param_segments(params):
        seg = seg.strip()
        if not seg:
            continue
        m = re.match(r'\$(\d+)\s*=\s*(.*)$', seg, re.DOTALL)
        if not m:
            continue
        param_num, rest = m.group(1), m.group(2).strip()
        ptype = None
        if rest.startswith("'"):
            # 带引号值: 提取到闭引号（'' 转义），尾部再识别 type = xxx
            j = 1
            while j < len(rest):
                if rest[j] == "'":
                    if j + 1 < len(rest) and rest[j + 1] == "'":
                        j += 2
                        continue
                    break
                j += 1
            value = rest[:j + 1] if j < len(rest) else rest
            tail = rest[len(value):].strip()
            tm = re.match(r'type\s*=\s*(.+)$', tail, re.DOTALL)
            if tm:
                ptype = tm.group(1).strip()
        else:
            # 无引号值（NULL/数字/标识符）: 按空白分割出 type = xxx 后缀
            tm = re.search(r'\s+type\s*=\s*(\S.*)$', rest, re.DOTALL)
            if tm:
                value = rest[:tm.start()].strip()
                ptype = tm.group(1).strip()
            else:
                value = rest
        parsed.append((param_num, value, ptype))
    return parsed


def _is_numeric_bind_type(ptype):
    """判断绑定变量类型是否为数值类型（如 bigint、numeric(10,2)、double precision）。"""
    if not ptype:
        return False
    base = ptype.strip().lower().split('(')[0].strip()
    return base in _NUMERIC_TYPE_NAMES


def _prepare_param_types(query_template, params_text):
    """生成 prepare 声明用的参数类型序列（按占位符编号升序）。

    类型来自 parameters 日志的 type = xxx 标注；缺失/无标注的参数回退为 text。
    类型间用 '|' 连接（类型名不会含 '|'，且能容纳 numeric(10,2) 这类带逗号类型），
    供前端 data-param-types 属性使用。

    Returns:
        str: 如 'varchar|bigint|text'；无占位符时返回 ''
    """
    params = sorted({int(n) for n in re.findall(r'\$(\d+)', query_template)})
    if not params:
        return ''
    type_map = {}
    for num, _val, ptype in _parse_bind_params(params_text or ''):
        type_map[int(num)] = (ptype or 'text').strip()
    return '|'.join(type_map.get(n, 'text') for n in params)


def _substitute_placeholders(query_text, param_dict):
    """单次扫描替换 SQL 中的 $n 占位符，跳过字面量与注释。

    逐占位符正则替换的复杂度为 O(参数个数 × SQL 长度)，对超长 SQL 耗时不可控；
    这里按字符单次扫描：仅在引号（'' / ""）和注释（-- / /* */）之外替换 $n，
    复杂度降为 O(SQL 长度)，且 $1 天然不会误吃 $10。

    替换值来自字典查找，不存在反斜杠/分组符被 re 解释的问题；
    无对应参数的占位符保留原文，便于排查参数缺失。
    """
    out = []
    i, n = 0, len(query_text)
    while i < n:
        c = query_text[i]
        # -- 行注释
        if c == '-' and i + 1 < n and query_text[i + 1] == '-':
            j = query_text.find('\n', i)
            j = n if j < 0 else j
            out.append(query_text[i:j])
            i = j
        # /* */ 块注释（支持嵌套）
        elif c == '/' and i + 1 < n and query_text[i + 1] == '*':
            depth = 1
            j = i + 2
            while j < n and depth > 0:
                if query_text[j] == '/' and j + 1 < n and query_text[j + 1] == '*':
                    depth += 1
                    j += 2
                elif query_text[j] == '*' and j + 1 < n and query_text[j + 1] == '/':
                    depth -= 1
                    j += 2
                else:
                    j += 1
            out.append(query_text[i:j])
            i = j
        # ' 单引号字面量（'' 转义）
        elif c == "'":
            j = i + 1
            while j < n:
                if query_text[j] == "'":
                    if j + 1 < n and query_text[j + 1] == "'":
                        j += 2
                        continue
                    j += 1
                    break
                j += 1
            out.append(query_text[i:j])
            i = j
        # " 双引号标识符（"" 转义）
        elif c == '"':
            j = i + 1
            while j < n:
                if query_text[j] == '"':
                    if j + 1 < n and query_text[j + 1] == '"':
                        j += 2
                        continue
                    j += 1
                    break
                j += 1
            out.append(query_text[i:j])
            i = j
        # $n 占位符：仅在此处替换
        elif c == '$' and i + 1 < n and query_text[i + 1].isdigit():
            j = i + 1
            while j < n and query_text[j].isdigit():
                j += 1
            placeholder = query_text[i:j]
            out.append(param_dict.get(placeholder, placeholder))
            i = j
        else:
            out.append(c)
            i += 1
    return ''.join(out)


def fill_sql_params(query_text, params):
    """
    填充SQL变量，将参数值替换到SQL语句中

    数值类型的绑定变量（type = bigint 等）替换时去掉引号；
    parameters 原文以 -- 注释置于 SQL 文本顶部，便于对照。

    Args:
        query_text (str): 原始SQL语句
        params (str): 参数字符串

    Returns:
        tuple: (filled_query, param_values) - 填充变量后的SQL语句和参数值列表
    """
    if not params or params.strip() == '':
        return query_text, []

    # 所有 SQL（含超长）都执行占位符替换；超长带来的体积/卡顿风险由
    # 展示层的 MAX_HTML_INLINE_SQL_LEN 截断与 Base64 压缩下载承担。

    # 解析参数字符串: $1 = 'value1' [type = xxx], $2 = 'value2', ...
    param_dict = {}   # 占位符 -> 替换用值（数值类型已去引号）
    param_list = []   # 按参数编号顺序存储原始参数值（保留引号，用于 execute 语句拼接）
    for param_num, value, ptype in _parse_bind_params(params):
        # 替换值: 数值类型且值是带引号纯数字时去引号（如 '100' -> 100）
        subst = value
        if (_is_numeric_bind_type(ptype) and len(value) >= 2
                and value[0] == "'" and value[-1] == "'"
                and _NUMERIC_LITERAL_RE.match(value[1:-1])):
            subst = value[1:-1]
        param_dict[f'${param_num}'] = subst

        # 确保param_list按参数编号顺序排列
        param_index = int(param_num) - 1
        while len(param_list) <= param_index:
            param_list.append(None)
        param_list[param_index] = value

    # 过滤掉None值（如果没有按顺序提供所有参数）
    filtered_param_list = [param for param in param_list if param is not None]

    # parameters 原文以 -- 注释置于 SQL 文本顶部，便于值与语句对照
    param_lines = params.strip().splitlines()
    param_comment = '-- parameters: ' + param_lines[0]
    for line in param_lines[1:]:
        param_comment += '\n-- ' + line

    # 单次扫描替换全部 $n 占位符，跳过字符串字面量/标识符与注释
    filled_query = _substitute_placeholders(query_text, param_dict)

    return param_comment + '\n' + filled_query.lstrip('\n'), filtered_param_list


def normalize_sql_for_display(sql_text):
    """
    规范化用于 HTML 展示的 SQL 文本：
    - 统一换行符
    - 删除空行（只含空白字符的行），避免出现大片空白
    - 去除首尾空白
    """
    if not sql_text:
        return sql_text
    text = sql_text.replace('\r\n', '\n').replace('\r', '\n')
    # 删除空行：将连续的空行（只含空白字符）压缩为一个换行
    text = re.sub(r'\n\s*\n+', '\n', text)
    if text.startswith('-- parameters:'):
        # 保留参数块与 SQL 正文之间的两个空行，其他区域仍压缩空行
        parts = re.split(r'(\n)(?!-- )', text, maxsplit=1)
        return parts[0] + '\n\n\n' + re.sub(r'\n\s*\n+', '\n', parts[-1]).lstrip('\n')
    return re.sub(r'\n\s*\n+', '\n', text).strip()


def _sql_fingerprint_id(sql_text):
    """对 unique id 为 0/空的语句生成归一化指纹 ID（0_<md5前16位>）。

    归一化：小写、去除 parameters 注释头注、去除单行注释、压缩空白。
    相同 SQL 文本（结构一致）得到相同指纹，可作为统计归一维度，
    避免 queryid（每条执行都不同）无法聚合的问题。

    Args:
        sql_text: SQL 文本（已填充参数或原始）

    Returns:
        str: '0_' + md5 前 16 位十六进制
    """
    
    if not sql_text:
        return '0_' + hashlib.md5(b'').hexdigest()[:16]
    text = sql_text.lower()
    # 去除 parameters 注释头注（fill_sql_params 前置的 -- parameters: 首行及其 -- 续行）
    text = re.sub(r'^--\s*parameters:[^\n]*(?:\n--[^\n]*)*', '', text)
    # 去除单行注释与多余空白
    text = re.sub(r'--[^\n]*', ' ', text)
    text = re.sub(r'\s+', ' ', text).strip()
    return '0_' + hashlib.md5(text.encode('utf-8')).hexdigest()[:16]



def new_connection_stats():
    """分钟 -> 来源地址 -> 认证结果次数。"""
    return defaultdict(lambda: defaultdict(lambda: {'success': 0, 'failed': 0, 'users': {}}))


def merge_connection_stats(target, source):
    for minute, sources in source.items():
        for source_ip, counts in sources.items():
            target[minute][source_ip]['success'] += counts['success']
            target[minute][source_ip]['failed'] += counts['failed']
            for user, user_counts in counts.get('users', {}).items():
                user_counts_target = target[minute][source_ip]['users'].setdefault(
                    user, {'success': 0, 'failed': 0, 'failure_types': {}})
                user_counts_target['success'] += user_counts['success']
                user_counts_target['failed'] += user_counts['failed']
                for failure_type, count in user_counts.get('failure_types', {}).items():
                    target_types = user_counts_target['failure_types']
                    target_types[failure_type] = target_types.get(failure_type, 0) + count


def _parse_connection_prefix(prefix, log_format_info):
    """按字段语义校验并自适应修正连接日志的用户名和来源 IP。"""
    if not log_format_info:
        return {}
    parsed = log_format_info['parse_func'](prefix)
    if parsed and _is_parse_suspicious(parsed):
        fixed = _remap_by_token_features(prefix, log_format_info.get('fields') or [])
        if fixed:
            parsed = {**parsed, **fixed}
    return parsed or {}


def _is_invalid_connection_user(user):
    """IP、端口、日志级别或会话标识不能作为用户名。"""
    if not user:
        return True
    value = user.strip().strip('[]')
    return (_is_likely_ip_token(value)
            or value.rstrip(':').upper() in _ADAPTIVE_LEVEL_TOKENS
            or bool(_ADAPTIVE_SESSION_RE.fullmatch(value))
            or ':' in value
            or any(char.isspace() for char in value))


def _connection_id(prefix):
    match = CONNECTION_ID_PATTERN.search(prefix)
    return match.group(1) if match else ''


def record_connection_result(timestamp_str, log_block, log_format_info, connection_stats,
                             received_connections=None):
    """记录认证结果；优先通过连接 ID 关联来源 IP，失败按类型分组。"""
    if connection_stats is None:
        return
    is_received = bool(CONNECTION_RECEIVED_PATTERN.search(log_block))
    is_success = bool(CONNECTION_SUCCESS_PATTERN.search(log_block))
    is_failed = bool(CONNECTION_FAILURE_PATTERN.search(log_block))
    if not is_received and not is_success and not is_failed:
        return
    prefix = re.split(r'\b(?:LOG|FATAL)\s*:', log_block, maxsplit=1)[0]
    parsed_prefix = _parse_connection_prefix(prefix, log_format_info)
    connection_id = _connection_id(prefix)
    if is_received:
        if received_connections is not None and connection_id:
            received_connections[connection_id] = prefix
        return
    if received_connections and connection_id in received_connections:
        # 认证失败前缀可能不含可靠来源 IP，用同连接 ID 的 received 记录补齐。
        received_prefix = received_connections[connection_id]
        received_parsed = _parse_connection_prefix(received_prefix, log_format_info)
        source_ip = received_parsed.get('remote_host', '')
        if not _is_likely_ip_token(source_ip):
            ip_match = re.search(r'(?:^|\s)((?:\d{1,3}\.){3}\d{1,3}(?:\(\d+\)|:\d+)?)(?:\s|$)', received_prefix)
            source_ip = ip_match.group(1) if ip_match else ''
        if source_ip:
            parsed_prefix['remote_host'] = _normalize_ip(source_ip)

    user_match = re.search(r'\bconnection authorized:\s*user=(\S+)', log_block, re.IGNORECASE) if is_success else None
    user = user_match.group(1) if user_match else parsed_prefix.get('user', '')
    if _is_invalid_connection_user(user):
        # 优先取 IP 前最近的普通标识符；标准格式不匹配时不信任固定位置。
        prefix_tokens = prefix.split()
        ip_index = next((i for i, token in enumerate(prefix_tokens)
                         if _is_likely_ip_token(token)), -1)
        candidates = prefix_tokens[:ip_index] if ip_index > 0 else prefix_tokens[:2]
        user = next((token for token in reversed(candidates)
                     if not _is_invalid_connection_user(token)
                     and token not in ('[local]', 'localhost')
                     and not token.isdigit()
                     and not (token.startswith('[') and token.endswith(']'))), '')
    if not user or user == '[unknown]':
        user = '未知'
    local_match = CONNECTION_LOCAL_PATTERN.search(prefix)
    if local_match:
        source_ip = local_match.group(1)
    else:
        source_ip = parsed_prefix.get('remote_host', '')
        if not _is_likely_ip_token(source_ip):
            ip_match = re.search(r'(?:^|\s)((?:\d{1,3}\.){3}\d{1,3}(?:\(\d+\)|:\d+)?)(?:\s|$)', prefix)
            source_ip = ip_match.group(1) if ip_match else ''
    source_ip = _normalize_ip(source_ip) if source_ip else '未知'
    minute = timestamp_str[:16]
    result_key = 'success' if is_success else 'failed'
    connection_stats[minute][source_ip][result_key] += 1
    user_counts = connection_stats[minute][source_ip].setdefault('users', {}).setdefault(
        user, {'success': 0, 'failed': 0, 'failure_types': {}})
    user_counts[result_key] += 1
    if is_failed:
        user_counts['failure_types']['用户名/密码错误'] = user_counts['failure_types'].get('用户名/密码错误', 0) + 1


def build_connection_chart_data(connection_stats):
    minutes = []
    total = 0
    for minute in sorted(connection_stats):
        sources = []
        user_totals = defaultdict(lambda: {'success': 0, 'failed': 0, 'failure_types': {}})
        for source_ip, counts in connection_stats[minute].items():
            source = {key: value for key, value in counts.items() if key != 'users'}
            for user, user_counts in counts.get('users', {}).items():
                for result_key in ('success', 'failed'):
                    user_totals[user][result_key] += user_counts[result_key]
                for failure_type, count in user_counts.get('failure_types', {}).items():
                    target_types = user_totals[user]['failure_types']
                    target_types[failure_type] = target_types.get(failure_type, 0) + count
            source['ip'] = source_ip
            source['total'] = counts['success'] + counts['failed']
            sources.append(source)
            total += source['total']
        sources.sort(key=lambda item: (-item['total'], item['ip']))
        users = []
        for user, counts in user_totals.items():
            users.append({'user': user, **counts, 'total': counts['success'] + counts['failed']})
        users.sort(key=lambda item: (-item['total'], item['user']))
        minutes.append({'minute': minute, 'total': sum(s['total'] for s in sources), 'sources': sources, 'users': users})
    return {'total': total, 'minutes': minutes}


def build_connection_line_chart_data(connection_stats):
    """转换为慢SQL公共折线图使用的数据结构。"""
    minutes = [connection_stats[minute] for minute in sorted(connection_stats)]
    return {
        'time_labels': sorted(connection_stats),
        'series': [{
            'uid': 'connections',
            'uid_display': '总连接数',
            'color': '#16a085',
            'data': [sum(counts['success'] + counts['failed'] for counts in sources.values())
                     for sources in minutes],
        }],
        'y_axis_label': '连接数',
        'allow_single_point': True,
    }


