@lru_cache(maxsize=16384)
def parse_datetime(date_str):
    formats = [
        '%Y-%m-%d %H:%M:%S.%f', 
        '%Y-%m-%d %H:%M:%S', 
        '%Y-%m-%d %H:%M', 
        '%Y-%m-%d %H'
    ]
    for fmt in formats:
        try:
            return datetime.strptime(date_str, fmt)
        except ValueError:
            continue
    return None



