    @staticmethod
    def _get_interval_minutes(dim_id):
        """根据维度ID获取间隔分钟数"""
        if dim_id == 'minute':
            return 1
        elif dim_id == '10minute':
            return 10
        elif dim_id == 'hour':
            return 60
        elif dim_id == 'day':
            return 1440
        elif dim_id.endswith('minute'):
            return int(dim_id.replace('minute', ''))
        else:
            return 9999
    
    @staticmethod
    def _get_time_bucket_start(dt, dim_id):
        """将时间向下对齐到维度桶边界，动态分钟维度按绝对时间连续对齐。"""
        if dim_id == 'minute':
            return dt.replace(second=0, microsecond=0)
        if dim_id == 'hour':
            return dt.replace(minute=0, second=0, microsecond=0)
        if dim_id == 'day':
            return dt.replace(hour=0, minute=0, second=0, microsecond=0)
        interval = ReportGenerator._get_interval_minutes(dim_id)
        epoch = datetime(1970, 1, 1)
        elapsed_minutes = int((dt - epoch).total_seconds() // 60)
        return epoch + timedelta(minutes=(elapsed_minutes // interval) * interval)

    @staticmethod
    def _get_time_key(dt, dim_id):
        """根据维度ID生成时间键"""
        interval = ReportGenerator._get_interval_minutes(dim_id)
        start_dt = ReportGenerator._get_time_bucket_start(dt, dim_id)
        if dim_id == 'minute':
            return start_dt.strftime('%Y-%m-%d %H:%M')
        elif dim_id == 'hour':
            return start_dt.strftime('%Y-%m-%d %H:00')
        elif dim_id == 'day':
            return start_dt.strftime('%Y-%m-%d')
        else:
            # 10minute 或其他动态维度：格式 YYYY-MM-DD HH:MM-HH:MM 或 YYYY-MM-DD HH:MM-YYYY-MM-DD HH:MM
            end_dt = start_dt + timedelta(minutes=interval - 1)
            # 如果跨天了，结束时间显示完整日期
            if end_dt.date() != start_dt.date():
                return f"{start_dt.strftime('%Y-%m-%d %H:%M')}-{end_dt.strftime('%Y-%m-%d %H:%M')}"
            else:
                return f"{start_dt.strftime('%Y-%m-%d %H:%M')}-{end_dt.strftime('%H:%M')}"
    
    @staticmethod
    def _parse_time_label(time_label, dim_id):
        """将时间标签解析为datetime对象"""
        if dim_id == 'minute':
            return datetime.strptime(time_label, '%Y-%m-%d %H:%M')
        elif dim_id == 'hour':
            return datetime.strptime(time_label, '%Y-%m-%d %H:00')
        elif dim_id == 'day':
            return datetime.strptime(time_label, '%Y-%m-%d')
        else:
            # 10minute 或其他动态维度：格式 2025-06-04 07:35-08:09 或 2025-06-04 23:30-2025-06-05 00:09
            # 前16个字符是开始时间：YYYY-MM-DD HH:MM
            start_part = time_label[:16]
            return datetime.strptime(start_part, '%Y-%m-%d %H:%M')

    @staticmethod
    def _get_overlapping_time_keys(start_dt, end_dt, dim_id, include_bucket_start=False):
        """生成 SQL 生命周期覆盖的时间桶，同一桶内只返回一次。"""
        current = ReportGenerator._get_time_bucket_start(start_dt, dim_id)
        delta = timedelta(minutes=ReportGenerator._get_interval_minutes(dim_id))
        while current <= end_dt:
            time_key = ReportGenerator._get_time_key(current, dim_id)
            if include_bucket_start:
                yield time_key, current
            else:
                yield time_key
            current += delta

    @staticmethod
    def _get_time_bucket_overlap_seconds(start_dt, end_dt, time_key, dim_id, bucket_start=None):
        """计算 SQL 生命周期与指定时间桶的实际交叠秒数。"""
        if bucket_start is None:
            bucket_start = ReportGenerator._parse_time_label(time_key, dim_id)
        bucket_end = bucket_start + timedelta(minutes=ReportGenerator._get_interval_minutes(dim_id))
        overlap_seconds = (min(end_dt, bucket_end) - max(start_dt, bucket_start)).total_seconds()
        return max(0.0, overlap_seconds)

    @staticmethod
    def generate_time_analysis(all_total_list, overall_min_time, overall_max_time, diff_interval=None, diff_interval_str=None):
        """生成SQL分时段分析部分的HTML和图表数据。
        
        Args:
            all_total_list: 所有慢查询记录列表
            overall_min_time: 报告整体开始时间
            overall_max_time: 报告整体结束时间
            diff_interval: 对比时间间隔（timedelta对象），None表示不生成对比数据
            diff_interval_str: 对比时间间隔字符串（如 30m, 1h, 1d），用于显示
        
        Returns:
            dict: 包含各维度HTML片段和图表数据的字典
        """
        # 将字符串时间转换为datetime对象（如果传入的是字符串）
        if isinstance(overall_min_time, str):
            overall_min_time = parse_datetime(overall_min_time)
        if isinstance(overall_max_time, str):
            overall_max_time = parse_datetime(overall_max_time)
        
        # 检查时间范围是否有效
        if overall_min_time is None or overall_max_time is None:
            print("警告: 时间范围无效，无法生成时段分析")
            return {'by_minute': {'show': False, 'html': '', 'chart_data': {}},
                   'by_10minute': {'show': False, 'html': '', 'chart_data': {}},
                   'by_hour': {'show': False, 'html': '', 'chart_data': {}},
                   'by_day': {'show': False, 'html': '', 'chart_data': {}}}
        
        # 初始化维度配置（复制基础配置）
        dimensions = [dim.copy() for dim in ReportGenerator.TIME_DIMENSIONS]
        
        # 根据 diff_interval 动态添加额外的维度
        if diff_interval and diff_interval_str:
            diff_minutes = int(diff_interval.total_seconds() / 60)
            # 检查是否需要添加动态维度（不在固定维度列表中）
            existing_intervals = [dim['interval_minutes'] for dim in dimensions]
            if diff_minutes not in existing_intervals and diff_minutes > 1:
                # 添加动态维度
                dynamic_dim = {
                    'id': f"{diff_minutes}minute",
                    'name': f"每{diff_minutes}分钟",
                    'interval_minutes': diff_minutes,
                    'always_show': True,
                    'diff_threshold_minutes': diff_minutes
                }
                dimensions.append(dynamic_dim)
        
        # 初始化结果字典
        analysis_result = {}
        for dim in dimensions:
            analysis_result[f"by_{dim['id']}"] = {'show': False, 'html': '', 'chart_data': {}}

        # 聚合数据（按所有维度和SQL类型）
        all_dim_data_dml = {}  # {dim_id: {time_key: {uid: count}}}
        all_dim_data_ddl = {}  # {dim_id: {time_key: {uid: count}}}
        heatmap_data = {'dml': {}, 'ddl': {}}  # {sql_type: {dim_id: {time_key: {count, duration}}}}
        for dim in dimensions:
            all_dim_data_dml[dim['id']] = defaultdict(lambda: defaultdict(int))
            all_dim_data_ddl[dim['id']] = defaultdict(lambda: defaultdict(int))
            for sql_type in heatmap_data:
                heatmap_data[sql_type][dim['id']] = defaultdict(lambda: {'count': 0, 'duration': 0.0})

        # 折线图 Top 10 按实际慢 SQL 执行次数排名，不受跨桶覆盖次数影响。
        execution_counts = {'dml': defaultdict(int), 'ddl': defaultdict(int)}
        for record in all_total_list:
            end_dt = record.get('time')
            if not end_dt:
                continue
            duration = record.get('duration', 0)
            try:
                start_dt = end_dt - timedelta(seconds=max(0, duration))
            except (TypeError, ValueError):
                start_dt = end_dt
            uid = record['unique_id']
            sql_type = 'ddl' if record.get('sql_type', 'dml') == 'ddl' else 'dml'
            if overall_min_time <= end_dt <= overall_max_time:
                execution_counts[sql_type][uid] += 1
            dim_data = all_dim_data_ddl if sql_type == 'ddl' else all_dim_data_dml
            if end_dt < overall_min_time or start_dt > overall_max_time:
                continue
            overlap_start = max(start_dt, overall_min_time)
            overlap_end = min(end_dt, overall_max_time)
            for dim in dimensions:
                for time_key, bucket_start in ReportGenerator._get_overlapping_time_keys(
                    overlap_start, overlap_end, dim['id'], include_bucket_start=True
                ):
                    dim_data[dim['id']][time_key][uid] += 1
                    heat_bucket = heatmap_data[sql_type][dim['id']][time_key]
                    heat_bucket['count'] += 1
                    heat_bucket['duration'] += ReportGenerator._get_time_bucket_overlap_seconds(
                        overlap_start, overlap_end, time_key, dim['id'], bucket_start
                    )
        
        # 确定需要展示哪些维度
        # 根据--diff参数调整维度的always_show属性
        # 如果--diff参数指定的间隔小于某个维度的间隔时，该维度的always_show设为False
        diff_minutes_val = diff_interval.total_seconds() / 60 if diff_interval else None
        if diff_minutes_val is not None:
            for dim in dimensions:
                if dim['interval_minutes'] > diff_minutes_val:
                    dim['always_show'] = False
        
        # 确定需要展示哪些维度
        for dim in dimensions:
            if dim['always_show']:
                analysis_result[f"by_{dim['id']}"]['show'] = True
        
        # 生成对比数据：同样按 SQL 生命周期与对比区间的交集统计。
        diff_data = None
        diff_heatmap_data = {'dml': {}, 'ddl': {}}
        for dim in dimensions:
            for sql_type in diff_heatmap_data:
                diff_heatmap_data[sql_type][dim['id']] = defaultdict(lambda: {'count': 0, 'duration': 0.0})
        if diff_interval:
            diff_minutes = diff_interval.total_seconds() / 60

            diff_start = overall_min_time - diff_interval
            diff_end = overall_max_time - diff_interval
            diff_records = []
            for record in all_total_list:
                end_dt = record.get('time')
                if not end_dt:
                    continue
                duration = record.get('duration', 0)
                try:
                    start_dt = end_dt - timedelta(seconds=max(0, duration))
                except (TypeError, ValueError):
                    start_dt = end_dt
                if end_dt >= diff_start and start_dt <= diff_end:
                    diff_records.append((max(start_dt, diff_start), min(end_dt, diff_end), record))

            if diff_records:
                diff_data = {
                    'start': diff_start,
                    'end': diff_end
                }

                for dim in dimensions:
                    if diff_minutes >= dim['diff_threshold_minutes']:
                        diff_dim_data = defaultdict(lambda: defaultdict(int))
                        for start_dt, end_dt, record in diff_records:
                            uid = record['unique_id']
                            sql_type = 'ddl' if record.get('sql_type', 'dml') == 'ddl' else 'dml'
                            for time_key, bucket_start in ReportGenerator._get_overlapping_time_keys(
                                start_dt, end_dt, dim['id'], include_bucket_start=True
                            ):
                                diff_dim_data[time_key][uid] += 1
                                heat_bucket = diff_heatmap_data[sql_type][dim['id']][time_key]
                                heat_bucket['count'] += 1
                                heat_bucket['duration'] += ReportGenerator._get_time_bucket_overlap_seconds(
                                    start_dt, end_dt, time_key, dim['id'], bucket_start
                                )
                        diff_data[dim['id']] = diff_dim_data

                print(f"找到对比数据，时间范围: {diff_start.strftime('%Y-%m-%d %H:%M:%S')} 至 {diff_end.strftime('%Y-%m-%d %H:%M:%S')}，对比间隔: {diff_interval_str}")
            else:
                print(f"未找到对比时间范围 {diff_start.strftime('%Y-%m-%d %H:%M:%S')} 至 {diff_end.strftime('%Y-%m-%d %H:%M:%S')} 内的数据，不生成对比数据，对比间隔: {diff_interval_str}")
        
        # 生成各维度HTML和图表数据
        for dim in dimensions:
            if analysis_result[f"by_{dim['id']}"]['show']:
                # 分别生成 DML 和 DDL 的图表数据
                chart_data_dml = ReportGenerator._generate_chart_data_for_dimension(
                    all_dim_data_dml[dim['id']], dim['id'], overall_min_time, overall_max_time, execution_counts['dml'], include_overall=True
                )
                chart_data_ddl = ReportGenerator._generate_chart_data_for_dimension(
                    all_dim_data_ddl[dim['id']], dim['id'], overall_min_time, overall_max_time, execution_counts['ddl'], include_overall=True
                )
                
                # 热力图使用共享时间轴和数组，避免为每个时间桶重复生成 HTML。
                time_labels = chart_data_dml.get('time_labels', [])
                diff_time_labels = []
                if diff_interval and time_labels:
                    bucket_start = ReportGenerator._get_time_bucket_start(
                        ReportGenerator._parse_time_label(time_labels[0], dim['id']), dim['id']
                    )
                    delta = timedelta(minutes=ReportGenerator._get_interval_minutes(dim['id']))
                    for _ in time_labels:
                        diff_time_labels.append(ReportGenerator._get_time_key(
                            bucket_start - diff_interval, dim['id']
                        ))
                        bucket_start += delta
                heatmap_chart_data = {
                    'time_labels': time_labels,
                    'diff_time_labels': diff_time_labels,
                    'diff_available': bool(diff_data and dim['id'] in diff_data)
                }
                for heat_sql_type in ('dml', 'ddl'):
                    current_heat = heatmap_data[heat_sql_type][dim['id']]
                    diff_heat = diff_heatmap_data[heat_sql_type][dim['id']]
                    heatmap_chart_data[heat_sql_type] = {
                        'current_counts': [current_heat.get(label, {}).get('count', 0) for label in time_labels],
                        'current_durations': [round(current_heat.get(label, {}).get('duration', 0.0), 6) for label in time_labels],
                        'diff_counts': [diff_heat.get(label, {}).get('count', 0) for label in diff_time_labels],
                        'diff_durations': [round(diff_heat.get(label, {}).get('duration', 0.0), 6) for label in diff_time_labels]
                    }

                # 合并为统一结构
                combined_chart_data = {
                    'dml': chart_data_dml,
                    'ddl': chart_data_ddl,
                    'heatmap': heatmap_chart_data
                }
                
                # 生成HTML表格（分别生成 DQL 和 DDL 两套）
                html_parts_dml, _ = ReportGenerator._generate_time_dimension_html(
                    all_dim_data_dml[dim['id']], dim['id'], dim['name'], overall_min_time, overall_max_time,
                    diff_data.get(dim['id']) if diff_data else None,
                    diff_interval, diff_interval_str, sql_type='dml'
                )
                html_parts_ddl, _ = ReportGenerator._generate_time_dimension_html(
                    all_dim_data_ddl[dim['id']], dim['id'], dim['name'], overall_min_time, overall_max_time,
                    diff_data.get(dim['id']) if diff_data else None,
                    diff_interval, diff_interval_str, sql_type='ddl'
                )

                # 合并两套表格到一个维度容器中，通过 data-sql-type 控制显隐
                combined_html = f'''
                <div class="time-dimension" id="dim-{dim['id']}">
                    <div class="chart-container sql-heatmap-container" id="sql-heatmap-{dim['id']}"></div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <h3>{dim['name']}维度统计 (Top 10)</h3>
                        <a href="#top10-ranking" class="back-to-top" title="返回Top 10排名" onclick="collapseAllDetails()">↑ Top 10</a>
                    </div>
                    <div class="time-range-note">
                        <span>统计时间范围: {overall_min_time.strftime('%Y-%m-%d %H:%M:%S')} 至 {overall_max_time.strftime('%Y-%m-%d %H:%M:%S')}<br>按 SQL 生命周期（日志时间 - 执行耗时 至 日志时间）统计；跨时段的 SQL 在每个覆盖时段各计 1 次，各时段合计可能大于总触发次数。</span>
                        <button class="expand-btn expand-btn-all-inline" onclick="expandPeriodDimensionAll('{dim['id']}', this)" style="display:none;">
                            <span class="expand-text">展开全部</span>
                            <span class="collapse-text" style="display:none;">收起全部</span>
                        </button>
                    </div>
                    <div class="period-sql-type-container" data-sql-type="dml">
                        {html_parts_dml}
                    </div>
                    <div class="period-sql-type-container" data-sql-type="ddl" style="display:none;">
                        {html_parts_ddl}
                    </div>
                </div>
                '''

                analysis_result[f"by_{dim['id']}"]['html'] = combined_html
                analysis_result[f"by_{dim['id']}"]['chart_data'] = combined_chart_data
        
        return analysis_result

    @staticmethod
    def _generate_chart_data_for_dimension(time_data, dim_id, start_dt, end_dt, execution_counts=None, include_overall=False):
        """生成指定时间维度的生命周期覆盖折线图（不含HTML表格）。

        Args:
            time_data: 当前时间数据 {time_label: {uid: count}}
            dim_id: 维度ID (minute/hour/day/10minute)
            start_dt: 开始时间
            end_dt: 结束时间
            execution_counts: 实际执行次数 {uid: count}，用于 Top 10 排名

        Returns:
            dict: {time_labels: [...], series: [...]}
        """
        chart_data = {'time_labels': [], 'series': []}

        # 根据维度ID确定时间间隔，聚合与图表共用同一桶边界
        interval_minutes = ReportGenerator._get_interval_minutes(dim_id)
        delta = timedelta(minutes=interval_minutes)
        current = ReportGenerator._get_time_bucket_start(start_dt, dim_id)
        end = ReportGenerator._get_time_bucket_start(end_dt, dim_id)

        # 收集所有时间点
        while current <= end:
            time_label = ReportGenerator._get_time_key(current, dim_id)
            chart_data['time_labels'].append(time_label)
            current += delta

        full_labels = chart_data['time_labels']
        if len(full_labels) < 2 and not include_overall:
            return {'time_labels': [], 'series': []}

        label_indices = list(range(len(full_labels)))

        # 取实际执行次数 Top 10 的 UID，避免长 SQL 因跨桶覆盖被额外放大。
        if execution_counts is not None:
            total_counts_per_uid = execution_counts
        else:
            total_counts_per_uid = defaultdict(int)
            for time_label, uid_counts in time_data.items():
                for uid, count in uid_counts.items():
                    total_counts_per_uid[uid] += count
        top10_uids = [uid for uid, _ in sorted(total_counts_per_uid.items(), key=lambda x: x[1], reverse=True)[:10]]

        # 为Top 10 UID分配颜色
        color_palette = [
            '#FF6B6B', '#4ECDC4', '#FFD166', '#06D6A0', '#118AB2',
            '#EF476F', '#7BDFF2', '#B388EB', '#8093F1', '#FF9A76'
        ]
        uid_colors = {}
        for i, uid in enumerate(top10_uids):
            uid_colors[uid] = color_palette[i % len(color_palette)]

        # 为每个Top UID生成数据序列
        for uid in top10_uids:
            uid_escaped = html.escape(str(uid).strip(), quote=True)
            uid_safe = ReportGenerator._make_id_safe(uid)
            series = {'uid': uid_safe, 'uid_display': uid_escaped, 'color': uid_colors[uid], 'data': []}
            for idx in label_indices:
                time_label = full_labels[idx]
                series['data'].append(time_data.get(time_label, {}).get(uid, 0))
            chart_data['series'].append(series)

        if include_overall and dim_id == 'minute':
            overall_data = []
            overall_top10 = []
            for time_label in full_labels:
                uid_counts = time_data.get(time_label, {})
                overall_data.append(sum(uid_counts.values()))
                overall_top10.append([
                    {'uid': str(uid).strip(), 'count': count}
                    for uid, count in sorted(uid_counts.items(), key=lambda item: (-item[1], str(item[0])))[:10]
                ])
            chart_data['overall'] = {
                'time_labels': full_labels,
                'series': [{
                    'uid': '__overall__', 'uid_display': '总慢SQL个数',
                    'color': '#2c80ff', 'data': overall_data
                }] if any(overall_data) else [],
                'point_top10': overall_top10,
                'y_axis_label': '时段内执行数',
                'allow_single_point': True
            }

        return chart_data
    
    @staticmethod
    def _generate_time_dimension_html(time_data, dim_id, dim_name, start_dt, end_dt, diff_data=None, diff_interval=None, diff_interval_str=None, sql_type=None):
        """生成指定时间维度（分/时/天）的HTML表格和图表数据。

        Args:
            time_data: 当前时间数据 {time_label: {uid: count}}
            dim_id: 维度ID (minute/hour/day/10minute)
            dim_name: 维度名称
            start_dt: 开始时间
            end_dt: 结束时间
            diff_data: 对比数据 {time_label: {uid: count}}，None表示不生成对比数据
            diff_interval: 对比时间间隔（timedelta对象），用于计算对比时间标签
            diff_interval_str: 对比时间间隔字符串（如 30m, 1h, 1d），用于显示
            sql_type: SQL类型 ('dml' 或 'ddl')，用于标记表格归属
        """
