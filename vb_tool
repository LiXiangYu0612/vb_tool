def _extract_tables_from_sql(sql_text, default_user='public', _depth=0):
    """从 SQL 文本中提取涉及的表名列表。

    参考 vb_tool sqlhc 的 extract_tables 逻辑，简化版：
    - 支持 UPDATE/INSERT/DELETE/MERGE 目标表提取
    - 支持 FROM/JOIN/USING 表提取
    - 支持 CTE 名称过滤
    - 默认 schema 补全

    Args:
        sql_text: SQL 文本（已填充参数）
        default_user: 默认 schema（通常为执行用户）

    Returns:
        list: [(owner, table_name), ...]
    """
    def normalize_user(user):
        user = user.strip().lower()
        return 'public' if user == 'vastbase' else user

    def strip_literals(s):
        out = []
        i = 0
        while i < len(s):
            if s[i] == "'":
                out.append("''")
                i += 1
                while i < len(s):
                    if s[i] == "'" and i + 1 < len(s) and s[i + 1] == "'":
                        i += 2
                    elif s[i] == "'":
                        i += 1
                        break
                    else:
                        i += 1
            elif s[i] == '"':
                out.append(s[i])
                i += 1
                while i < len(s) and s[i] != '"':
                    out.append(s[i])
                    i += 1
                if i < len(s):
                    out.append(s[i])
                    i += 1
            elif s[i] == '-' and i + 1 < len(s) and s[i + 1] == '-':
                while i < len(s) and s[i] != '\n':
                    i += 1
                out.append(' ')
            elif s[i] == '/' and i + 1 < len(s) and s[i + 1] == '*':
                i += 2
                while i < len(s) - 1 and not (s[i] == '*' and s[i + 1] == '/'):
                    i += 1
                i += 2
                out.append(' ')
            else:
                out.append(s[i])
                i += 1
        return ''.join(out)

    clean = strip_literals(sql_text)
    tokens = re.findall(
        r'"[^"]*"'
        r'|[a-zA-Z_]\w*(?:\.[a-zA-Z_]\w*)*'
        r'|[(),;]',
        clean
    )
    n = len(tokens)

    def is_kw(tok):
        return tok.lstrip('"').rstrip('"').lower() in _SQL_KW

    def add_table(raw):
        raw = raw.strip('"').lower()
        if raw in _SQL_KW:
            return
        parts = raw.split('.')
        if len(parts) == 1:
            owner = normalize_user(default_user)
            tname = parts[0]
        elif len(parts) == 2:
            owner, tname = parts
        else:
            owner, tname = parts[-2], parts[-1]
        # 系统表不需要收集 tabstat/tabsize（SQLHC 仅关心业务表，
        # 且对系统视图跑 tabstat 很慢），与 tabstat SQL 的排除条件保持一致
        if owner in ('pg_catalog', 'information_schema', 'sys', 'snapshot') \
                or owner.startswith('pg_toast') or owner.startswith('cstore'):
            return
        # 不带 schema 的系统表名（会被补成 public.*）和内置函数名误判
        if tname in _SYSTEM_TABLE_NAMES or tname in _SQL_FUNCS:
            return
        if tname and tname not in _SQL_KW:
            seen[(owner, tname)] = True

    def skip_subquery(pos):
        depth = 1
        pos += 1
        while pos < n and depth > 0:
            if tokens[pos] == '(':
                depth += 1
            elif tokens[pos] == ')':
                depth -= 1
            pos += 1
        return pos

    def skip_alias(pos):
        if pos >= n:
            return pos
        if tokens[pos].upper() == 'AS':
            pos += 1
        if pos < n and tokens[pos] not in (',', '(', ')', ';') and not is_kw(tokens[pos]):
            pos += 1
        return pos

    # CTE 收集
    cte_names = set()

    def collect_ctes():
        i = 0
        while i < n:
            if tokens[i].upper() == 'WITH':
                prev = tokens[i - 1].upper() if i > 0 else ''
                if prev == 'START':
                    i += 1
                    continue
                i += 1
                while i < n:
                    if tokens[i].upper() == 'RECURSIVE':
                        i += 1
                        continue
                    if is_kw(tokens[i]) or tokens[i] in ('(', ')', ',', ';'):
                        break
                    cte_name = tokens[i].lower().strip('"')
                    i += 1
                    if i >= n or tokens[i].upper() != 'AS':
                        break
                    i += 1
                    if i >= n or tokens[i] != '(':
                        break
                    cte_names.add(cte_name)
                    i = skip_subquery(i)
                    if i < n and tokens[i] == ',':
                        i += 1
                        continue
                    break
            i += 1

    collect_ctes()

    def add_table_checked(raw):
        name = raw.strip('"').lower().split('.')[-1]
        if name not in cte_names:
            add_table(raw)

    FROM_TRIGGERS = {
        'FROM', 'JOIN', 'INNER', 'LEFT', 'RIGHT', 'FULL',
        'CROSS', 'NATURAL', 'STRAIGHT_JOIN',
    }
    JOIN_NOISE = {'JOIN', 'OUTER', 'SEMI', 'ANTI', 'INTO', 'BY'}

    seen = {}
    i = 0
    while i < n:
        tok_up = tokens[i].upper()

        if tok_up == 'UPDATE':
            j = i + 1
            if j < n and not is_kw(tokens[j]) and tokens[j] not in ('(', ')'):
                add_table_checked(tokens[j])
                j = skip_alias(j + 1)
            i = j if j > i else i + 1
            continue

        if tok_up in ('INSERT', 'MERGE'):
            j = i + 1
            if j < n and tokens[j].upper() == 'INTO':
                j += 1
            if j < n and not is_kw(tokens[j]) and tokens[j] not in ('(', ')'):
                add_table_checked(tokens[j])
                j = skip_alias(j + 1)
            i = j if j > i else i + 1
            continue

        if tok_up == 'DELETE':
            j = i + 1
            if j < n and tokens[j].upper() == 'FROM':
                j += 1
            if j < n and not is_kw(tokens[j]) and tokens[j] not in ('(', ')'):
                add_table_checked(tokens[j])
                j = skip_alias(j + 1)
            i = j if j > i else i + 1
            continue

        if tok_up in FROM_TRIGGERS:
            j = i + 1
            while j < n and tokens[j].upper() in JOIN_NOISE:
                j += 1
            while j < n:
                t = tokens[j]
                t_up = t.upper()
                if t == '(':
                    i = j
                    break
                if t in (')', ';'):
                    i = j
                    break
                if t_up in _SQL_KW and t_up not in ('AS',):
                    i = j
                    break
                add_table_checked(t)
                j = skip_alias(j + 1)
                if j < n and tokens[j] == ',':
                    j += 1
                    continue
                i = j
                break
            else:
                i = j
            continue

        if tok_up == 'USING':
            j = i + 1
            if j < n and tokens[j] == '(':
                j = skip_subquery(j)
                j = skip_alias(j)
            elif j < n and not is_kw(tokens[j]):
                add_table_checked(tokens[j])
                j = skip_alias(j + 1)
            i = j if j > i else i + 1
            continue

        i += 1

    result = [(o, t) for (o, t) in seen.keys() if t not in cte_names]

    # 递归提取字符串字面量中的 SQL（如 SELECT cb_run(4,'x','SELECT ... FROM tree_deep ...')：
    # 存储过程/函数参数里嵌套的真实 SQL 会被 strip_literals 抹掉，这里找回）
    if _depth < 2:
        for m in re.finditer(r"'((?:[^']|'')*)'", sql_text, re.DOTALL):
            literal = m.group(1).replace("''", "'")
            # 内容像 SQL 才递归（以 DML 关键字开头）
            if re.match(r"^\s*(select|insert|update|delete|merge|with)\b", literal, re.IGNORECASE):
                for ot in _extract_tables_from_sql(literal, default_user, _depth + 1):
                    if ot not in result:
                        result.append(ot)

    return result


def _query_table_schemas(names, db_name, timeout=60, debug=False):
    """在指定库中按 relname 批量解析表的实际 schema。

    Args:
        names: 表名列表（可含重复，会自动去重）
        db_name: 数据库名（SQL 执行的库）
        timeout: vsql 超时时间（秒）
        debug: 是否打印调试日志

    Returns:
        dict: {relname: [(schema, relname), ...]}，同名表多 schema 时全部保留；
              查询失败返回 {}
    """
    resolved = {}
    names = sorted({t for t in names if t})
    if not names:
        return resolved
    names_csv = ','.join(f"'{t}'" for t in names)
    query = (
        "SELECT n.nspname, c.relname"
        " FROM pg_catalog.pg_class c"
        " JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace"
        " WHERE c.relkind IN ('r','p','v','m','S','f')"
        "   AND n.nspname <> 'pg_catalog'"
        "   AND n.nspname !~ '^pg_toast'"
        "   AND n.nspname <> 'information_schema'"
        f"  AND c.relname IN ({names_csv});"
    )
    if debug:
        print(f"[DEBUG] 解析表 schema: vsql -d {db_name} -X -q -A -t -F '|', 表数={len(names)}", file=sys.stderr)
        print(f"[DEBUG] 解析表 schema SQL:\n{query}", file=sys.stderr)
    try:
        process = subprocess.Popen(
            ['vsql', '-d', db_name, '-X', '-q', '-A', '-t', '-F', '|', '-c', query],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            universal_newlines=True
        )
        stdout, stderr = process.communicate(timeout=timeout)
    except Exception as e:
        if debug:
            print(f"[DEBUG] 批量解析表 schema 失败: {e}", file=sys.stderr)
        return resolved
    if process.returncode != 0:
        if debug:
            print(f"[DEBUG] 批量解析表 schema 失败: {stderr.strip()}", file=sys.stderr)
        return resolved

    for line in stdout.strip().split('\n'):
        line = line.strip()
        if not line or '|' not in line:
            continue
        schema, tname = line.split('|', 1)
        schema, tname = schema.strip(), tname.strip()
        if schema and tname:
            resolved.setdefault(tname, []).append((schema, tname))
    return resolved


def _apply_schema_resolution(tables, resolved):
    """按解析结果映射 (owner, table) -> (实际schema, table)。

    解析不到的表保留原 (owner, table) 猜测；同名表多 schema 时全部保留。
    解析到系统 schema 的结果直接丢弃（系统表不收集 tabstat/tabsize）。
    """

    def _is_system(schema, tname):
        return (schema in ('pg_catalog', 'information_schema', 'sys', 'snapshot')
                or schema.startswith('pg_toast') or schema.startswith('cstore')
                or tname in _SYSTEM_TABLE_NAMES or tname in _SQL_FUNCS)

    result = []
    for owner, tname in tables:
        actual = resolved.get(tname)
        if actual:
            # 解析到实际 schema, 用实际值替换猜测(同名表多 schema 时全部保留)
            for pair in actual:
                if not _is_system(*pair) and pair not in result:
                    result.append(pair)
        else:
            # 解析不到, 保留原猜测
            if not _is_system(owner, tname) and (owner, tname) not in result:
                result.append((owner, tname))
    return result


def _resolve_table_schemas(tables, db_name, timeout=60, debug=False):
    """在 SQL 执行的库中解析表的实际 schema（单组表版本）。

    SQL 中未带 schema 限定的表默认按执行用户猜测归属，但实际表可能在其他
    schema（如 public），直接用 (user, table) 查询统计会查不到数据。
    这里先按 relname 在 pg_class 中解析实际 schema；解析不到时保留原
    (owner, table) 猜测。

    Args:
        tables: [(owner, table_name), ...]
        db_name: 数据库名（SQL 执行的库）
        timeout: vsql 超时时间（秒）
        debug: 是否打印调试日志

    Returns:
        list: [(实际schema, table_name), ...]
    """
    if not tables:
        return tables
    resolved = _query_table_schemas([t for _, t in tables], db_name, timeout=timeout, debug=debug)
    result = _apply_schema_resolution(tables, resolved)
    if debug:
        print(f"[DEBUG] 表 schema 解析: {tables} -> {result}", file=sys.stderr)
    return result


def _build_sqlhc_tabstats_query(tables):
    """构建 tabstat 查询 SQL（单个 uid 的表集合）。

    SQL 与 vb_tool v2.0.8 run_sqlhc 的 tabstat 段保持一致（含视图定义回退查询）。

    说明：Oracle 兼容性视图 dba_part_key_columns / dba_subpart_key_columns
    已按视图定义等价改写为 pg_partition/pg_class/pg_attribute/pg_namespace
    的原生写法（见下方 part_key_cols_sql / subpart_key_cols_sql），
    不再依赖兼容视图是否存在。

    Args:
        tables: [(owner, table_name), ...]

    Returns:
        str: 完整查询文本（vsql 脚本，含 \\echo 分段标题）
    """
    tables_in_clause = ','.join(f"('{o}','{t}')" for o, t in tables)

    # ---------------------------------------------------------------
    # dba_part_key_columns 的原生等价改写（PG 9.2 语法，无 LATERAL，
    # generate_subscripts 放在子查询 SELECT 列表中展开，与原视图定义一致）
    #   语义：每张分区表（pg_class.parttype in ('p','s')）对应 pg_partition 中
    #   parttype='r' 的根行，partkey(int2vector) 为分区键的 attnum 数组；
    #   展开后关联 pg_attribute 取列名，按 column_position(=ordinal+1) 顺序拼接。
    #   保留原视图的权限校验与系统 schema 排除；object_type='TABLE' 为常量，省略。
    # ---------------------------------------------------------------
    part_key_cols_sql = """
        select lower(s.rootschema) schema_name, lower(s.rootrelname) as name,
               lower(string_agg(a.attname::text, ',' order by s.ordinal)) cols
        from (
            select pd.parentid, pd.partkey,
                   generate_subscripts(pd.partkey, 1) ordinal,
                   ns.nspname rootschema, class.relname rootrelname,
                   class.oid classoid, ns.oid nsoid
            from pg_partition pd
            join pg_class class on class.oid = pd.parentid
            join pg_namespace ns on ns.oid = class.relnamespace
            where class.parttype in ('p', 's')
              and pd.parttype = 'r'
        ) s
        join pg_attribute a on a.attrelid = s.parentid and a.attnum = s.partkey[s.ordinal]
        where has_column_privilege(s.classoid, a.attnum, 'SELECT, INSERT, UPDATE, REFERENCES')
          and has_schema_privilege(s.nsoid, 'USAGE')
          and s.rootschema not in ('pg_catalog', 'information_schema', 'pg_toast')
        group by s.rootschema, s.rootrelname
    """

    # ---------------------------------------------------------------
    # dba_subpart_key_columns 的原生等价改写（PG 9.2 语法，无 LATERAL）
    #   语义：每张二级分区表（pg_class.parttype='s'）在 pg_partition 中
    #   parentid=表oid 且 parttype='p' 的行（一级分区），其 partkey 即子分区键；
    #   原视图用标量子查询取 LIMIT 1，这里保持完全相同的写法；
    #   若该子查询为 NULL，generate_subscripts 不产生行，inner join 自然过滤。
    # ---------------------------------------------------------------
    subpart_key_cols_sql = """
        select lower(s.rootschema) schema_name, lower(s.rootrelname) as name,
               lower(string_agg(a.attname::text, ',' order by s.ordinal)) cols
        from (
            select ns.nspname rootschema, class.relname rootrelname,
                   class.oid classoid,
                   (select p.partkey from pg_partition p
                    where p.parentid = class.oid and p.parttype = 'p'
                    limit 1) subpartkey,
                   generate_subscripts((select p.partkey from pg_partition p
                    where p.parentid = class.oid and p.parttype = 'p'
                    limit 1), 1) ordinal
            from pg_class class
            join pg_namespace ns on ns.oid = class.relnamespace
            where class.parttype = 's'
        ) s
        join pg_attribute a on a.attrelid = s.classoid and a.attnum = s.subpartkey[s.ordinal]
        group by s.rootschema, s.rootrelname
    """

    return f"""
\\echo '================'
\\echo 'table statistics'
\\echo '================'
SELECT n.nspname AS "owner"
        ,c.relname AS "tab_name"
        ,CASE c.relpersistence
                WHEN 'p' THEN 'perm'
                WHEN 't' THEN 'temp'
                WHEN 'u' THEN 'unlog'
                END AS "tabtype"
        ,(select CASE p.partstrategy
            WHEN 'r'::"char" THEN 'RANGE'::varchar(9)
            WHEN 'i'::"char" THEN 'INTERVAL'::varchar(9)
            WHEN 'l'::"char" THEN 'LIST'::varchar(9)
            WHEN 'h'::"char" THEN 'HASH'::varchar(9)
            WHEN 'd'::"char" THEN 'HASH'::varchar(9)
            WHEN 'v'::"char" THEN 'VALUE'::varchar(9)
            WHEN 's'::"char" THEN 'SYSTEM'::varchar(9)
            WHEN 'n'::"char" THEN 'NONE'::varchar(9)
         ELSE NULL end from pg_partition p where p.parentid=c.oid limit 1)
         ||(CASE WHEN p2.cols is not null then '('||p2.cols||')' else '' end)
         ||(case when (select CASE p1.partstrategy
            WHEN 'r'::"char" THEN 'RANGE'::varchar(9)
            WHEN 'i'::"char" THEN 'INTERVAL'::varchar(9)
            WHEN 'l'::"char" THEN 'LIST'::varchar(9)
            WHEN 'h'::"char" THEN 'HASH'::varchar(9)
            WHEN 'd'::"char" THEN 'HASH'::varchar(9)
            WHEN 'v'::"char" THEN 'VALUE'::varchar(9)
            WHEN 's'::"char" THEN 'SYSTEM'::varchar(9)
            WHEN 'n'::"char" THEN 'NONE'::varchar(9)
         ELSE NULL end from pg_partition p,pg_partition p1 where p.parentid=c.oid and p1.parentid=p.oid limit 1) is not null
         then '-'||(select CASE p1.partstrategy
            WHEN 'r'::"char" THEN 'RANGE'::varchar(9)
            WHEN 'i'::"char" THEN 'INTERVAL'::varchar(9)
            WHEN 'l'::"char" THEN 'LIST'::varchar(9)
            WHEN 'h'::"char" THEN 'HASH'::varchar(9)
            WHEN 'd'::"char" THEN 'HASH'::varchar(9)
            WHEN 'v'::"char" THEN 'VALUE'::varchar(9)
            WHEN 's'::"char" THEN 'SYSTEM'::varchar(9)
            WHEN 'n'::"char" THEN 'NONE'::varchar(9)
         ELSE NULL end from pg_partition p,pg_partition p1 where p.parentid=c.oid and p1.parentid=p.oid limit 1)||'('||p1.cols||')'
