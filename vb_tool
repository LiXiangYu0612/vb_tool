                // 锁事件跳转：从慢SQL 详情中的"锁等待详情"跳转到 Top10 锁事件栏目的对应行
                // 跳转流程：阻止默认行为 -> 查找目标元素 -> 自动展开详情卡片 ->
                //          移除旧高亮 -> 添加新高亮 -> 更新 URL hash -> 平滑滚动居中
                // 失败排查：浏览器 F12 控制台查看 [jumpToLockDetail] 开头的日志
                // ============================================================
                function jumpToLockDetail(anchorId, event) {{
                    console.log('%c[jumpToLockDetail] === 跳转开始 ===', 'color:#0066cc;font-weight:bold;', 'anchorId=', anchorId, 'event=', event);
                    if (event) {{
                        try {{
                            event.preventDefault();
                            event.stopPropagation();
                            console.log('[jumpToLockDetail] 已阻止默认行为和事件冒泡');
                        }} catch (e) {{
                            console.error('[jumpToLockDetail] 阻止默认行为失败:', e);
                        }}
                    }} else {{
                        console.warn('[jumpToLockDetail] 未传入 event 对象,无法阻止默认行为');
                    }}

                    console.log('[jumpToLockDetail] 查找目标元素: #' + anchorId);
                    const targetElement = document.getElementById(anchorId);
                    if (!targetElement) {{
                        console.error('[jumpToLockDetail] ✗ 未找到锚点元素: #' + anchorId);
                        console.warn('[jumpToLockDetail] 可能原因:')
                        console.warn('[jumpToLockDetail]   1) Top10 锁事件栏目未渲染该事件(可能被 Top50 限制截断)');
                        console.warn('[jumpToLockDetail]   2) 锚点 id 不匹配(慢SQL 详情与 Top10 表生成的 id 不一致)');
                        console.warn('[jumpToLockDetail]   3) 锁事件栏目在隐藏的 tab/折叠面板中');
                        // 输出现有所有 lock-anchor 元素列表,便于诊断
                        const allLockAnchors = document.querySelectorAll('[id^="lock-anchor-"]');
                        console.log('[jumpToLockDetail] 当前页面共找到 ' + allLockAnchors.length + ' 个 lock-anchor 元素:');
                        allLockAnchors.forEach((el, i) => {{
                            console.log('[jumpToLockDetail]   [' + i + '] id=' + el.id + ' tagName=' + el.tagName + ' class=' + el.className);
                        }});
                        alert('未找到锁详情锚点: ' + anchorId + '\\n请查看浏览器控制台(F12)获取详细诊断信息');
                        return;
                    }}
                    console.log('[jumpToLockDetail] ✓ 找到目标元素: tagName=' + targetElement.tagName + ' id=' + targetElement.id + ' class=' + targetElement.className);

                    // 检查目标元素是否在隐藏的容器中(如被 tab 隐藏、display:none 等)
                    let hiddenAncestor = null;
                    let parent = targetElement.parentElement;
                    while (parent && parent !== document.body) {{
                        const cs = window.getComputedStyle(parent);
                        if (cs.display === 'none' || cs.visibility === 'hidden' || cs.height === '0px') {{
                            hiddenAncestor = parent;
                            console.warn('[jumpToLockDetail] ⚠ 发现隐藏的祖先元素: tagName=' + parent.tagName + ' class=' + parent.className + ' display=' + cs.display + ' visibility=' + cs.visibility);
                            break;
                        }}
                        parent = parent.parentElement;
                    }}
                    if (!hiddenAncestor) {{
                        console.log('[jumpToLockDetail] ✓ 目标元素所有祖先均可见');
                    }}

                    // 如果目标行处于折叠状态,自动展开详情卡片(便于查看上下文)
                    if (targetElement.classList.contains('lock-summary-row')) {{
                        const detailBtn = targetElement.querySelector('.lock-detail-btn');
                        if (detailBtn) {{
                            console.log('[jumpToLockDetail] 详情按钮当前文本: "' + detailBtn.textContent.trim() + '"');
                            if (detailBtn.textContent.trim() === '详情') {{
                                console.log('[jumpToLockDetail] 目标行处于折叠状态,自动展开...');
                                try {{
                                    toggleLockDetail(detailBtn);
                                    console.log('[jumpToLockDetail] ✓ 已调用 toggleLockDetail 展开详情');
                                }} catch (e) {{
                                    console.error('[jumpToLockDetail] 调用 toggleLockDetail 失败:', e);
                                }}
                            }} else {{
                                console.log('[jumpToLockDetail] 目标行已展开,无需展开操作');
                            }}
                        }} else {{
                            console.warn('[jumpToLockDetail] 目标行内未找到 .lock-detail-btn 按钮');
                        }}
                    }} else {{
                        console.log('[jumpToLockDetail] 目标元素不是 .lock-summary-row,跳过展开逻辑(class=' + targetElement.className + ')');
                    }}

                    // 移除所有现有的高亮(避免残留)
                    const oldHighlights = document.querySelectorAll('.lock-highlight-flash');
                    console.log('[jumpToLockDetail] 清理旧高亮: 共 ' + oldHighlights.length + ' 个元素');
                    oldHighlights.forEach((el, i) => {{
                        console.log('[jumpToLockDetail]   移除高亮 [' + i + ']: id=' + el.id + ' class=' + el.className);
                        el.classList.remove('lock-highlight-flash');
                    }});

                    // 添加新高亮类
                    targetElement.classList.add('lock-highlight-flash');
                    console.log('[jumpToLockDetail] ✓ 已添加高亮类 lock-highlight-flash');

                    // 更新 URL hash(便于刷新后重试或分享链接)
                    try {{
                        history.pushState(null, '', '#' + anchorId);
                        console.log('[jumpToLockDetail] ✓ 已更新 URL hash: #' + anchorId);
                    }} catch (e) {{
                        console.warn('[jumpToLockDetail] 更新 URL hash 失败(不影响跳转):', e);
                    }}

                    // 平滑滚动到目标行(居中显示,留出表头空间)
                    setTimeout(() => {{
                        try {{
                            const headerHeight = document.querySelector('.deadlock-table thead, .lock-event-table thead')?.offsetHeight || 0;
                            const viewportHeight = window.innerHeight;
                            const rowHeight = targetElement.offsetHeight || 100;
                            const rect = targetElement.getBoundingClientRect();
                            const currentScroll = window.scrollY || window.pageYOffset;
                            const rowTopAbsolute = rect.top + currentScroll;
                            const targetScrollTop = rowTopAbsolute - (viewportHeight / 2) + (rowHeight / 2) - headerHeight;
                            console.log('[jumpToLockDetail] 滚动参数: rowTopAbsolute=' + rowTopAbsolute + ' viewportHeight=' + viewportHeight + ' rowHeight=' + rowHeight + ' headerHeight=' + headerHeight + ' targetScrollTop=' + targetScrollTop);
                            window.scrollTo({{
                                top: Math.max(0, targetScrollTop),
                                behavior: 'smooth'
                            }});
                            console.log('%c[jumpToLockDetail] === 跳转完成 ===', 'color:#0066cc;font-weight:bold;');
                        }} catch (e) {{
                            console.error('[jumpToLockDetail] 滚动失败:', e);
                        }}
                    }}, 150);
                }}

                function expandPeriodTableStep(tableId, dimId, arrowEl) {{
                    const table = document.getElementById(tableId);
                    const hiddenRows = table.querySelectorAll('tr.period-row-hidden:not(.row-hidden)');
                    const STEP = 10;
                    
                    if (hiddenRows.length === 0) {{
                        arrowEl.classList.remove('expanded');
                        return;
                    }}
                    
                    const toShow = Math.min(STEP, hiddenRows.length);
                    for (let i = 0; i < toShow; i++) {{
                        if (!hiddenRows[i].classList.contains('row-hidden')) {{
                            hiddenRows[i].style.display = '';
                        }}
                        hiddenRows[i].classList.remove('period-row-hidden');
                    }}
                    
                    const remainingHidden = table.querySelectorAll('tr.period-row-hidden:not(.row-hidden)').length;
                    if (remainingHidden === 0) {{
                        arrowEl.classList.add('expanded');
                    }}
                    
                    updateExpandAllButtonVisibility(dimId);
                }}
                
                function expandPeriodDimensionAll(dimId, btn) {{
                    const container = document.getElementById(`period-dim-container-${{dimId}}`);
                    const tables = container ? container.querySelectorAll('.period-table') : [];
                    
                    let hasHidden = false;
                    tables.forEach(table => {{
                        const hiddenRows = table.querySelectorAll('tr.period-row-hidden:not(.row-hidden)');
                        if (hiddenRows.length > 0) hasHidden = true;
                    }});
                    
                    const isCollapsing = hasHidden;
                    
                    tables.forEach(table => {{
                        const rows = table.querySelectorAll('tbody tr, tr');
                        let dataRowCount = 0;
                        rows.forEach(row => {{
                            if (row.querySelector('th')) return;
                            dataRowCount++;
                            if (isCollapsing) {{
                                if (!row.classList.contains('row-hidden')) {{
                                    row.style.display = '';
                                }}
                                row.classList.remove('period-row-hidden');
                            }} else {{
                                if (dataRowCount <= 10) {{
                                    if (!row.classList.contains('row-hidden')) {{
                                        row.style.display = '';
                                    }}
                                    row.classList.remove('period-row-hidden');
                                }} else {{
                                    row.style.display = 'none';
                                    row.classList.add('period-row-hidden');
                                }}
                            }}
                        }});
                    }});
                    
                    if (isCollapsing) {{
                        btn.querySelector('.expand-text').style.display = 'none';
                        btn.querySelector('.collapse-text').style.display = '';
                        document.querySelectorAll(`.period-table-arrow[data-dim-id="${{dimId}}"]`).forEach(arrow => {{
                            arrow.classList.add('expanded');
                        }});
                    }} else {{
                        btn.querySelector('.expand-text').style.display = '';
                        btn.querySelector('.collapse-text').style.display = 'none';
                        document.querySelectorAll(`.period-table-arrow[data-dim-id="${{dimId}}"]`).forEach(arrow => {{
                            arrow.classList.remove('expanded');
                        }});
                    }}
                }}
                
                function updateExpandAllButtonVisibility(dimId) {{
                    const container = document.getElementById(`period-dim-container-${{dimId}}`);
                    const tables = container ? container.querySelectorAll('.period-table') : [];
                    let hasHidden = false;
                    tables.forEach(table => {{
                        if (table.querySelectorAll('tr.period-row-hidden:not(.row-hidden)').length > 0) hasHidden = true;
                    }});
                    
                    const dimEl = document.getElementById(`dim-${{dimId}}`);
                    if (dimEl) {{
                        const btn = dimEl.querySelector('.expand-btn-all-inline');
                        if (btn) {{
                            btn.style.display = hasHidden ? '' : 'none';
                        }}
                    }}
                }}
                
                let detailVisibleCount = 10;
                const DETAIL_LOAD_STEP = 10;
                let errorVisibleCount = 10;
                const ERROR_LOAD_STEP = 10;

                // ---- 用户/数据库/级别多选筛选（Top SQL 与错误表共用） ----
                function multiFilterValues(tableId, kind) {{
                    const host = document.querySelector('.multi-filter[data-table="' + tableId + '"][data-filter-kind="' + kind + '"]');
                    return host ? new Set(host._selected || []) : new Set();
                }}

                function rowMatchesMulti(row, tableId, kind) {{
                    const selected = multiFilterValues(tableId, kind);
                    if (!selected.size) return true;
                    const attr = tableId === 'error-detail-table' || tableId === 'detail-table'
                        ? 'data-' + kind : 'data-' + (kind === 'user' ? 'users' : 'dbs');
                    const raw = row.getAttribute(attr) || (tableId === 'error-detail-table' || tableId === 'detail-table' ? '' : '[]');
                    const values = tableId === 'error-detail-table' || tableId === 'detail-table' ? [raw] : JSON.parse(raw || '[]');
                    return values.some(value => selected.has(value));
                }}

                function refreshMultiFilter(host) {{
                    const kind = host.getAttribute('data-filter-kind');
                    const selected = host._selected || new Set();
                    const label = kind === 'user' ? '用户' : (kind === 'db' ? '数据库' : '级别');
                    host.querySelector('.multi-filter-toggle').textContent =
                        selected.size === 0 ? '全部' + label :
                        (selected.size === 1 ? Array.from(selected)[0] : label + '(' + selected.size + ')');
                    host.querySelectorAll('input[type="checkbox"]').forEach(box => {{
                        box.checked = selected.has(box.value);
                    }});
                }}

                function applyTableMultiFilters(tableId) {{
                    if (tableId === 'error-detail-table') {{
                        applyErrorSearch();
                        return;
                    }}
                    if (tableId === 'detail-table') {{
                        applyDetailFilters();
                        return;
                    }}
                    const rows = tableId === 'top10'
                        ? document.querySelectorAll('.top10-container tbody tr')
                        : document.querySelectorAll('#' + tableId + ' tbody tr');
                    rows.forEach(row => {{
                        row.style.display = ['user', 'db'].every(kind => rowMatchesMulti(row, tableId, kind)) ? '' : 'none';
                    }});
                }}

                function initMultiFilters() {{
                    document.querySelectorAll('.multi-filter').forEach(host => {{
                        const tableId = host.getAttribute('data-table');
                        const kind = host.getAttribute('data-filter-kind');
                        const values = new Set();
                        const rows = tableId === 'top10'
                            ? document.querySelectorAll('.top10-container tbody tr')
                            : document.querySelectorAll('#' + tableId + ' tbody tr');
                        rows.forEach(row => {{
                            const attr = tableId === 'error-detail-table' || tableId === 'detail-table'
                                ? 'data-' + kind : 'data-' + (kind === 'user' ? 'users' : 'dbs');
                            const raw = row.getAttribute(attr) || (tableId === 'error-detail-table' || tableId === 'detail-table' ? '' : '[]');
                            const items = tableId === 'error-detail-table' || tableId === 'detail-table' ? [raw] : JSON.parse(raw || '[]');
                            items.filter(Boolean).forEach(value => values.add(value));
                        }});
                        host._selected = new Set();
                        host.innerHTML = '<button type="button" class="multi-filter-toggle"></button>' +
                            '<div class="multi-filter-menu" hidden><input type="text" class="multi-filter-search" placeholder="搜索选项...">' +
                            '<div class="multi-filter-options"></div><div class="multi-filter-actions">' +
                            '<button type="button" data-action="all">全选</button><button type="button" data-action="clear">清空</button></div></div>';
                        const options = host.querySelector('.multi-filter-options');
                        Array.from(values).sort().forEach(value => {{
                            const label = document.createElement('label');
                            label.className = 'multi-filter-option';
                            const box = document.createElement('input');
                            box.type = 'checkbox';
                            box.value = value;
                            box.addEventListener('change', () => {{
                                if (box.checked) host._selected.add(value); else host._selected.delete(value);
                                refreshMultiFilter(host);
                                applyTableMultiFilters(tableId);
                            }});
                            label.append(box, document.createTextNode(value));
                            options.appendChild(label);
                        }});
                        host.querySelector('.multi-filter-toggle').addEventListener('click', () => {{
                            const menu = host.querySelector('.multi-filter-menu');
                            menu.hidden = !menu.hidden;
                        }});
                        host.querySelector('.multi-filter-search').addEventListener('input', event => {{
                            const term = event.target.value.toLowerCase();
                            options.querySelectorAll('.multi-filter-option').forEach(option => {{
                                option.style.display = option.textContent.toLowerCase().includes(term) ? '' : 'none';
                            }});
                        }});
                        host.querySelector('[data-action="all"]').addEventListener('click', () => {{
                            host._selected = new Set(values); refreshMultiFilter(host); applyTableMultiFilters(tableId);
                        }});
                        host.querySelector('[data-action="clear"]').addEventListener('click', () => {{
                            host._selected.clear(); refreshMultiFilter(host); applyTableMultiFilters(tableId);
                        }});
                        refreshMultiFilter(host);
                    }});
                }}

                document.addEventListener('click', event => {{
                    document.querySelectorAll('.multi-filter-menu:not([hidden])').forEach(menu => {{
                        if (!menu.closest('.multi-filter').contains(event.target)) menu.hidden = true;
                    }});
                }});

                function errDetailPassesFilter(row, f) {{
                    return ['level', 'user', 'db'].every(kind => rowMatchesMulti(row, 'error-detail-table', kind));
                }}

                function getErrDetailFilterVals() {{
                    return {{ level: true, user: true, db: true }};
                }}

                // ---- 错误明细表:统一筛选 + 分页模型 ----
                // 每行根据当前筛选条件标记 err-filtered-out;可见性由 errorVisibleCount 控制,
                // 只对"匹配筛选"的行生效,加载更多/全部展开/收起均保持过滤状态。
                function buildSearchMatcher(searchValue, useRegex, exclude) {{
                    if (!searchValue) return {{ matches: () => true, regex: null }};
                    const escaped = Array.from(searchValue, ch =>
                        '\\^$.*+?()[]{{}}|'.includes(ch) ? String.fromCharCode(92) + ch : ch).join('');
                    // 勾选"正则"时区分大小写(与 grep 等标准正则行为一致);普通关键词模式忽略大小写
                    const regex = new RegExp(useRegex ? searchValue : escaped, useRegex ? 'g' : 'gi');
                    return {{
                        regex,
                        matches: text => {{
                            regex.lastIndex = 0;
                            const matched = regex.test(text);
                            return exclude ? !matched : matched;
                        }}
                    }};
                }}

                function searchOptions(prefix) {{
                    const input = document.getElementById(prefix + '-search');
                    const useRegex = document.getElementById(prefix + '-search-regex').checked;
                    const exclude = document.getElementById(prefix + '-search-exclude').checked;
                    const value = input.value.trim();
                    let matcher;
                    try {{
                        matcher = buildSearchMatcher(value, useRegex, exclude);
                        input.setCustomValidity('');
                    }} catch (e) {{
                        input.setCustomValidity('无效正则表达式');
                        input.reportValidity();
                        return null;
                    }}
                    return {{ value, exclude, useRegex, matcher }};
                }}

                function highlightSearchMatches(root, regex) {{
                    root.querySelectorAll('mark.search-highlight').forEach(mark => {{
                        mark.replaceWith(document.createTextNode(mark.textContent));
                    }});
                    root.normalize();
                    if (!regex) return;
                    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {{
                        acceptNode: node => {{
                            if (!node.nodeValue.trim() || ['SCRIPT', 'STYLE', 'MARK', 'TEXTAREA'].includes(node.parentElement.tagName)) {{
                                return NodeFilter.FILTER_REJECT;
                            }}
                            return NodeFilter.FILTER_ACCEPT;
                        }}
                    }});
                    const nodes = [];
                    while (walker.nextNode()) nodes.push(walker.currentNode);
                    nodes.forEach(node => {{
                        regex.lastIndex = 0;
                        const fragment = document.createDocumentFragment();
                        let last = 0, match;
                        while ((match = regex.exec(node.nodeValue)) !== null) {{
                            if (match.index > last) fragment.appendChild(document.createTextNode(node.nodeValue.slice(last, match.index)));
                            const mark = document.createElement('mark');
                            mark.className = 'search-highlight';
                            mark.textContent = match[0];
                            fragment.appendChild(mark);
                            last = match.index + match[0].length;
                            if (!match[0].length) regex.lastIndex++;
                        }}
                        if (!last) return;
                        fragment.appendChild(document.createTextNode(node.nodeValue.slice(last)));
                        node.replaceWith(fragment);
                    }});
                }}

                function errRowMatches(row, options, f) {{
                    const msgCell = row.querySelector('.error-msg-cell');
                    if (!msgCell) return false;
                    return options.matcher.matches(msgCell.textContent)
                        && errDetailPassesFilter(row, f);
                }}

                function errDetailRefresh() {{
                    // 按 err-filtered-out 标记 + errorVisibleCount 重排可见性
                    const allRows = document.querySelectorAll('#error-detail-table tbody tr');
                    const matched = [];
                    allRows.forEach(row => {{
                        if (row.classList.contains('err-filtered-out')) {{
                            row.style.display = 'none';
                            row.classList.remove('error-row-shown');
                            row.classList.add('error-row-hidden');
                        }} else {{
                            matched.push(row);
                        }}
                    }});
                    matched.forEach((row, i) => {{
                        if (i < errorVisibleCount) {{
                            row.style.display = '';
                            row.classList.remove('error-row-hidden');
                            row.classList.add('error-row-shown');
                        }} else {{
                            row.style.display = 'none';
                            row.classList.add('error-row-hidden');
                            row.classList.remove('error-row-shown');
                        }}
                    }});
                    errUpdateExpandUI(matched.length);
                }}

                function errUpdateExpandUI(matchedCount) {{
                    const loadBtn = document.getElementById('error-expand-btn');
                    const expandAllBtn = document.getElementById('error-expand-all-btn');
                    if (!loadBtn || !expandAllBtn) return;
                    const expandText = expandAllBtn.querySelector('.expand-text');
                    const collapseText = expandAllBtn.querySelector('.collapse-text');
                    const allShown = errorVisibleCount >= matchedCount;
                    // 展开全部按钮状态
                    expandText.style.display = allShown ? 'none' : '';
                    collapseText.style.display = allShown ? '' : 'none';
                    // 加载更多按钮状态
                    const remaining = matchedCount - Math.min(errorVisibleCount, matchedCount);
                    if (remaining > 0) {{
                        loadBtn.innerHTML = `加载更多 (剩余 ${{remaining}} 行)`;
                        loadBtn.disabled = false;
                        loadBtn.style.opacity = '';
                        loadBtn.style.cursor = '';
                    }} else {{
                        loadBtn.innerHTML = '已全部加载';
                        loadBtn.disabled = true;
                        loadBtn.style.opacity = '0.5';
                        loadBtn.style.cursor = 'default';
                    }}
                }}

                function loadMoreErrorRows() {{
                    errorVisibleCount += ERROR_LOAD_STEP;
                    errDetailRefresh();
                }}

                function toggleAllErrorRows() {{
                    const matchedCount = document.querySelectorAll('#error-detail-table tbody tr:not(.err-filtered-out)').length;
                    if (errorVisibleCount < matchedCount) {{
                        errorVisibleCount = matchedCount;  // 展开全部(仅匹配行)
                    }} else {{
                        errorVisibleCount = 10;            // 收起
                    }}
                    errDetailRefresh();
                }}

                function applyErrorSearch() {{
                    const options = searchOptions('error');
                    if (!options) return;
                    const filterVals = getErrDetailFilterVals();
                    const allRows = document.querySelectorAll('#error-detail-table tbody tr');
                    // 先标记每行是否匹配当前筛选
                    allRows.forEach(row => {{
                        const msgCell = row.querySelector('.error-msg-cell');
                        highlightSearchMatches(msgCell, null);
                        row.classList.toggle('err-filtered-out', !errRowMatches(row, options, filterVals));
                    }});
                    // 有搜索词时展开全部匹配行；清空搜索后恢复默认前 10 条
                    errorVisibleCount = options.value ? Number.MAX_SAFE_INTEGER : 10;
                    errDetailRefresh();
                    allRows.forEach(row => {{
                        if (!options.exclude && !row.classList.contains('err-filtered-out')) {{
                            highlightSearchMatches(row.querySelector('.error-msg-cell'), options.matcher.regex);
                        }}
                    }});
                }}

                function resetErrorSearch() {{
                    document.getElementById('error-search').value = '';
                    document.querySelectorAll('.multi-filter[data-table="error-detail-table"]').forEach(host => {{
                        host._selected.clear(); refreshMultiFilter(host);
                    }});
                    // 清除筛选后回到默认前 10 条
                    const allRows = document.querySelectorAll('#error-detail-table tbody tr');
                    allRows.forEach(row => row.classList.remove('err-filtered-out'));
                    errorVisibleCount = 10;
                    errDetailRefresh();
                }}

                function toggleErrorDetail(btn) {{
                    const cell = btn.closest('.error-msg-cell');
                    const detail = cell.querySelector('.error-context-detail');
                    if (detail.style.display === 'none') {{
                        detail.style.display = 'block';
                        btn.textContent = '收起';
                    }} else {{
                        detail.style.display = 'none';
                        btn.textContent = '详情';
                    }}
                }}

                function detailRefresh() {{
                    const matched = [];
                    document.querySelectorAll('#detail-section tbody tr').forEach(row => {{
                        if (row.classList.contains('detail-filtered-out')) {{
                            row.style.display = 'none';
                            row.classList.remove('detail-row-hidden');
                        }} else {{
                            matched.push(row);
                        }}
                    }});
                    matched.forEach((row, index) => {{
                        const hidden = index >= detailVisibleCount;
                        row.style.display = hidden ? 'none' : '';
                        row.classList.toggle('detail-row-hidden', hidden);
                    }});
                    detailUpdateExpandUI(matched.length);
                }}

                function detailUpdateExpandUI(matchedCount) {{
                    const loadBtn = document.getElementById('detail-expand-btn');
                    const expandAllBtn = document.getElementById('detail-expand-all-btn');
                    if (!loadBtn || !expandAllBtn) return;
                    const remaining = Math.max(0, matchedCount - detailVisibleCount);
                    loadBtn.innerHTML = remaining ? `加载更多 (剩余 ${{remaining}} 行)` : '已全部加载';
                    loadBtn.disabled = remaining === 0;
                    loadBtn.style.opacity = remaining === 0 ? '0.5' : '';
                    loadBtn.style.cursor = remaining === 0 ? 'default' : '';
                    expandAllBtn.querySelector('.expand-text').style.display = remaining ? '' : 'none';
                    expandAllBtn.querySelector('.collapse-text').style.display = remaining ? 'none' : '';
                }}

                // SQL详情行筛选文本: 仅搜索 Unique ID/IP/数据库/用户/SQL摘要。
                // 排除 Duration (s)、Calls 和"详细执行语句"列,避免数字或折叠SQL误命中。
                // 高亮标记(mark)不改变 textContent, 行内容静态, 按行缓存一次即可。
                function detailRowSearchText(row) {{
                    if (row._searchText === undefined) {{
                        const clone = row.cloneNode(true);
                        [5, 6, 7].forEach(index => clone.children[index]?.remove());
                        row._searchText = clone.textContent;
                    }}
                    return row._searchText;
                }}

                function applyDetailFilters() {{
                    const options = searchOptions('detail');
                    if (!options) return;
                    document.querySelectorAll('#detail-section tbody tr').forEach(row => {{
                        highlightSearchMatches(row, null);
                        const matched = options.matcher.matches(detailRowSearchText(row))
                            && ['user', 'db'].every(kind => rowMatchesMulti(row, 'detail-table', kind));
                        row.classList.toggle('detail-filtered-out', !matched);
                        if (!options.exclude && matched) highlightSearchMatches(row, options.matcher.regex);
                    }});
                    detailVisibleCount = options.value ? Number.MAX_SAFE_INTEGER : 10;
                    detailRefresh();
                }}

                function loadMoreDetailRows() {{
                    detailVisibleCount += DETAIL_LOAD_STEP;
                    detailRefresh();
                }}
                
                function expandDetailRowsUpTo(targetIndex) {{
                    document.querySelectorAll('#detail-section tbody tr').forEach(row => {{
                        if (parseInt(row.getAttribute('data-row-index')) <= targetIndex) {{
                            row.classList.remove('detail-row-hidden');
                            row.classList.remove('detail-filtered-out');
                        }}
                    }});
                    detailVisibleCount = Math.max(detailVisibleCount, targetIndex + 1);
                    detailRefresh();
                    updateDetailExpandAllButton(false);
                }}
                
                function toggleAllDetailRows() {{
                    const matchedCount = document.querySelectorAll('#detail-section tbody tr:not(.detail-filtered-out)').length;
                    detailVisibleCount = detailVisibleCount < matchedCount ? matchedCount : 10;
                    detailRefresh();
                }}
                
                function updateDetailExpandAllButton(canExpand) {{
                    const btn = document.getElementById('detail-expand-all-btn');
                    if (btn) {{
                        const expandText = btn.querySelector('.expand-text');
                        const collapseText = btn.querySelector('.collapse-text');
                        if (canExpand) {{
                            expandText.style.display = '';
                            collapseText.style.display = 'none';
                        }} else {{
                            expandText.style.display = 'none';
                            collapseText.style.display = '';
                        }}
                    }}
                }}
                
                function setupDetailsToggleListeners() {{
                    // 现在由 summary 的 onclick 统一处理，这里保留函数避免报错，但不注册 toggle 事件
                }}

                // 右下角常驻悬浮回到顶部按钮: 滚动超过300px时显示, 点击平滑回到顶部
                // 按钮元素位于本 <script> 之后, 解析脚本时还不存在,
                // 必须等 DOMContentLoaded(整个文档解析完毕)后再查找并绑定事件
                document.addEventListener('DOMContentLoaded', function() {{
                    const btn = document.getElementById('floatBackTop');
                    if (!btn) return;
                    btn.addEventListener('click', function() {{
                        window.scrollTo({{ top: 0, behavior: 'smooth' }});
                    }});
                    window.addEventListener('scroll', function() {{
                        const scrollPos = window.scrollY || document.documentElement.scrollTop || 0;
                        btn.classList.toggle('visible', scrollPos > 300);
                    }}, {{ passive: true }});
                }});
            </script>
        <button class="float-back-top" id="floatBackTop" title="回到顶部">↑</button>
        </body>
        <div style="text-align: center; margin: 20px 0;">
            <a href="#top10-ranking" class="back-to-top" title="返回Top 10排名" onclick="collapseAllDetails()">↑ Top 10</a>
        </div>
        </html>
        """
        # ===== 体积统计输出(仅 debug 模式) =====
        if _debug:
            _record_size('full_html(最终)', full_html)
            _elapsed = _time_mod.time() - _html_size_t0
            print("\n" + "=" * 80)
            print(f"[HTML 体积统计] generate_full_html_report 耗时: {_elapsed:.2f}s")
            print(f"[HTML 体积统计] 最终 HTML 字符数: {len(full_html):,}  字节(UTF-8): {len(full_html.encode('utf-8')):,}  ({len(full_html.encode('utf-8'))/1024/1024:.2f} MB)")
            print("-" * 80)
            _sorted_stats = sorted(_html_size_stats.items(), key=lambda x: x[1].get('bytes', 0), reverse=True)
            print(f"{'栏目':<50} {'字符数':>15} {'字节(MB)':>12} {'<tr行数':>10}")
            print("-" * 80)
            for _name, _st in _sorted_stats:
                _mb = _st.get('bytes', 0) / 1024 / 1024
                print(f"{_name:<50} {_st.get('chars', 0):>15,} {_mb:>10.2f} MB {_st.get('rows', 0):>10,}")
            print("=" * 80 + "\n")
        # ===== 统计输出结束 =====
        return full_html


def parse_all_events(start_n, blocks, total_list, deadlock_list, lock_event_list, lock_chain_list, total_elapsed_time=0, log_format_info=None, error_list=None, connection_stats=None):
    """
    单次扫描日志块，同时解析慢查询、死锁和锁事件。
    优化：每个 block 只解析一次前缀/时间戳、慢查询 SQL 只提取一次。
    """
    total_blocks = len(blocks) // 2
    processed = 0
    start_time = datetime.now()

    if log_format_info is None:
        log_format_info = parse_log_prefix_format('%m %u %d %r %p %S')
    parse_func = log_format_info['parse_func']

    # ---- 错误日志聚合状态(内存优化) ----
    # 按 (level, 归一化消息) 聚合,只保留首尾 2 条完整记录的 context/full_log,
    # 中间记录在 error_list 里只存轻量字段。处理结束后把首尾数据填回 error_list。
    _error_groups = {}

    # ---- 慢查询相关状态 ----
    pending_lock_events = defaultdict(list)
    last_sql_time = {}

    # ---- 死锁相关状态 ----
    deadlock_seen = set()
    lock_event_buffer = []
    buffer_window_seconds = 5.0
    process_sql_multiline = re.compile(
        r'Process\s+(\d+):\s*(.*?)(?=\s+Process\s+\d+:|$)',
        re.IGNORECASE | re.DOTALL
    )
    process_wait = re.compile(
        r'Process\s+(\d+)\s+waits for\s+.*?(?:transaction\s+(\d+))?\s*;\s*blocked by process\s+(\d+)\.?',
        re.IGNORECASE
    )
    # 预存死锁检测原始块，全部扫描结束后再统一解析（避免同毫秒其他块被提前消耗）
    deadlock_candidates = []

    # ---- 锁事件相关状态 ----
    lock_seen = set()
    recent_sql_by_connection = {}
    unique_id_by_connection = {}
    thread_to_unique_id = {}
    # 事务号 -> 该事务执行过的语句列表，用于锁等待链关联
    tx_activity = defaultdict(list)
    # thread_id -> waiting 事件缓存，用于 waiting → acquired 合并
    pending_waiting_events = {}

    # 缓存前缀解析结果，避免同一块重复解析
    prefix_cache = {}
    prefix_txid_cache = {}

    # ---- 容量上限 (2026-11-26 复核): 逐行级关联容器在 GB 级日志上只增不减 ⇒
    #      OOM。超限时整体清空并只警告一次——损失的是超旧记录的锁链关联/事件
    #      去重(降级不崩), 换取分析继续。上限取正常库远达不到的保守大量。 ----
    _CACHE_CAP = 400000
    _cache_cap_warned = [False]
    def _cap_caches():
        hit = False
        for c in (tx_activity, lock_seen, thread_to_unique_id,
                  recent_sql_by_connection, unique_id_by_connection,
                  last_sql_time, prefix_cache, prefix_txid_cache,
                  pending_waiting_events, received_connections,
                  pending_lock_events):
            if len(c) > _CACHE_CAP:
                c.clear()
                hit = True
        if hit and not _cache_cap_warned[0]:
            _cache_cap_warned[0] = True
            print("WARNING: 单遍扫描关联缓存超过 %d 条(日志过大), 已清空重置: "
                  "锁链关联/事件去重只覆盖重置之后的窗口" % _CACHE_CAP)
    _cap_tick = 0

    _PREFIX_MARKERS = ('LOG:', 'ERROR:', 'WARNING:', 'FATAL:', 'PANIC:',
                       'DETAIL:', 'STATEMENT:', 'HINT:', 'CONTEXT:')

    def _prefix_key(log_block):
        """取日志块前缀作为缓存 key，避免用完整 block 浪费内存。"""
        # 前缀一般不超过 256 个字符；找到第一个标记后截断
        prefix = log_block[:300]
        for marker in _PREFIX_MARKERS:
            pos = prefix.find(marker)
            if pos > 0:
                return prefix[:pos].strip()
        return prefix.strip()

    def _parse_prefix(log_block):
        """解析日志前缀，返回 (connection_key, thread_id, IP, database, user)

        自适应增强: 主路径解析后做合理性校验,可疑时按 IP 锚点重新分配字段。
        保证在 log_line_prefix 与实际日志格式不匹配(如 user/database/remote_host 错位)
        时仍能提取出正确字段。
        """
        prefix = _prefix_key(log_block)
        parsed_line = parse_func(prefix)
        # Layer 2 校验: 检测字段串位
        if parsed_line and _is_parse_suspicious(parsed_line):
            # Layer 3: 用 IP 锚点重建字段映射
            _unique_fields = (log_format_info or {}).get('fields') or []
            _fixed = _remap_by_token_features(prefix, _unique_fields)
            if _fixed:
                # 重建成功,采用修正结果(保留原 parsed_line 中未冲突的字段)
                _merged = dict(parsed_line)
                _merged.update(_fixed)
                parsed_line = _merged
        if parsed_line:
            connection_key = parsed_line.get('remote_host')
            thread_id = parsed_line.get('thread_id') or parsed_line.get('session_id')
            IP = parsed_line.get('remote_host', '')
            database = parsed_line.get('database', '')
            user = parsed_line.get('user', '')
            # 合法性校验:前缀截断失败时消息文本会混入 token,导致 user/database 错位
            # (如 database 被解析成 'WARNING:'),此类值一律视为无效置空
            _invalid_tokens = ('ERROR', 'WARNING', 'FATAL', 'PANIC', 'LOG',
                               'DETAIL', 'STATEMENT', 'HINT', 'CONTEXT')
            def _bad_field(v):
                return (':' in v or ' ' in v
                        or v.rstrip(':').upper() in _invalid_tokens)
            if user and _bad_field(user):
                user = ''
            if database and _bad_field(database):
                database = ''
            return connection_key, thread_id, IP, database, user
        return None, None, '', '', ''

    def _get_prefix(log_block):
        key = _prefix_key(log_block)
        cached = prefix_cache.get(key)
        if cached is not None:
            return cached
        result = _parse_prefix(log_block)
        prefix_cache[key] = result
        return result

    def _get_prefix_txid(log_block):
        """从日志块前缀中解析事务号 [%x]，供锁等待链关联。"""
        key = _prefix_key(log_block)
        cached = prefix_txid_cache.get(key)
        if cached is not None:
            return cached
        prefix = _prefix_key(log_block)
        parsed_line = parse_func(prefix)
        txid = ''
        if parsed_line:
            txid = parsed_line.get('transaction_id', '') or ''
        prefix_txid_cache[key] = txid
        return txid

    def _match_lock_event(log_text):
        """一次性匹配 waiting/acquired 锁事件，返回 (type, lock_type, wait_ms, target, holder_txid)。"""
        m = LOCK_WAITING_PATTERN.search(log_text)
        if m:
            target, holder_txid = _parse_lock_target(m.group(0))
            return 'waiting', m.group(2), float(m.group(3)), target, holder_txid
        m = LOCK_ACQUIRED_PATTERN.search(log_text)
        if m:
            target, holder_txid = _parse_lock_target(m.group(0))
            return 'acquired', m.group(2), float(m.group(3)), target, holder_txid
        return None, None, None, None, None

    def _parse_lock_target(match_text):
        """从锁事件文本中解析锁目标及阻塞者事务号。"""
        target = ''
        holder_txid = None
        m = LOCK_TARGET_PATTERN.search(match_text)
        if m:
            target = m.group(1).strip()
        m = BLOCKER_TXID_PATTERN.search(match_text)
        if m:
            holder_txid = m.group(1)
        return target, holder_txid

    def _add_lock_event_to_buffer(ts_str, log_text, thread_id):
        ev_type, ev_lock_type, ev_wait_ms, _, _ = _match_lock_event(log_text)
        if ev_type is None:
            return
        lock_event_buffer.append({
            'timestamp': ts_str,
            'thread_id': thread_id,
            'event_type': ev_type,
            'lock_type': ev_lock_type,
            'wait_time_ms': ev_wait_ms,
            'log_text': log_text.strip()
        })

    def _cleanup_lock_event_buffer(current_ts):
        if current_ts is None or not lock_event_buffer:
            return
        cutoff = current_ts - timedelta(seconds=buffer_window_seconds)
        while lock_event_buffer:
            first_ts = parse_datetime(lock_event_buffer[0]['timestamp'])
            if first_ts is None:
                lock_event_buffer.pop(0)
                continue
            if first_ts < cutoff:
                lock_event_buffer.pop(0)
            else:
                break

    def _find_related_lock_events(process_a, process_b, current_ts, future_events=None):
        if current_ts is None:
            return []
        cutoff = current_ts - timedelta(seconds=buffer_window_seconds)
        related = []
        for event in lock_event_buffer:
            event_ts = parse_datetime(event['timestamp'])
            if event_ts is None:
                continue
            if event_ts < cutoff:
                continue
            if event['thread_id'] in (process_a, process_b):
                related.append(event)
        if future_events:
            for event in future_events:
                if event['thread_id'] in (process_a, process_b):
                    related.append(event)
        related.sort(key=lambda x: x['timestamp'])
        return related

    def _extract_sql_text_from_block(block, allow_deadlock=True):
        m = re.search(r'(?:(?:execute|bind)\s+(?:<[^>]*>|\S+)\s*:\s*|statement:\s*)(.+)', block, re.IGNORECASE | re.DOTALL)
        if m:
            sql = m.group(1).strip()
            sql = re.split(r'\n\s*(?:DETAIL\s*:\s*)?parameters\s*:', sql, flags=re.IGNORECASE)[0]
            return sql
        # 死锁回退仅锁事件路径可用; 慢 SQL 路径必须关(无锚点但含 Process N: 的
        # duration 块会经此伪造记录, 2026-11-26 第四轮复核构造复现)
        if allow_deadlock:
            m = DEADLOCK_SQL_PATTERN.search(block)
            if m:
                sql = m.group(2).strip()
                if sql:
                    return sql
        return ''

    def _is_related_follow_up_block(block, session_id):
        if not re.search(r'\b(DETAIL|STATEMENT|ERROR|HINT|CONTEXT)\s*:', block, re.IGNORECASE):
            return False
        if session_id in block:
            return True
        return False

    parse_datetime_cached = lru_cache(maxsize=8)(parse_datetime)
    received_connections = {}

    for i in range(start_n, len(blocks), 2):
        processed += 1
        if processed % 500 == 0:
            show_progress(processed, total_blocks, "解析事件", start_time, total_elapsed_time)
        # 每 4096 块查一次关联缓存容量(热路径零成本化)
        _cap_tick += 1
        if _cap_tick >= 4096:
            _cap_tick = 0
            _cap_caches()

        timestamp_str = blocks[i]
        log_block = blocks[i + 1]
        if connection_stats is not None and 'connection ' in log_block:
            record_connection_result(timestamp_str, log_block, log_format_info, connection_stats,
                                     received_connections)
        elif connection_stats is not None and 'Invalid username/password' in log_block:
            record_connection_result(timestamp_str, log_block, log_format_info, connection_stats,
                                     received_connections)
        timestamp = parse_datetime(timestamp_str)
        current_ts = timestamp

        # 错误、连接、锁和死锁仍按日志时间过滤；慢 SQL 按生命周期与报告区间的交集过滤。
        if timestamp:
            _begin_dt = parse_datetime_cached(args.begin) if args.begin else None
            if _begin_dt is not None and timestamp < _begin_dt:
                continue
            _end_dt = parse_datetime_cached(args.end) if args.end else None
            if _end_dt is not None and timestamp > _end_dt:
                continue

        # 快速分类：只使用廉价的字符串判断
        is_slow_sql = "duration:" in log_block and ("execute" in log_block or "statement:" in log_block or "bind" in log_block)
        has_lock_event = 'still waiting' in log_block or 'acquired' in log_block
        has_deadlock = 'detected deadlock' in log_block

        if args.debug and 'deadlock' in log_block.lower():
            _log_block_preview = log_block[:200].replace('\n', ' | ')
            print(f"[DEBUG] 块含 deadlock 关键词，ts={timestamp_str}, has_deadlock={has_deadlock}, DEADLOCK_DETECT_PATTERN={bool(DEADLOCK_DETECT_PATTERN.search(log_block))}, preview={_log_block_preview}")

        # 按需解析前缀
        connection_key = thread_id = None
        IP = database = user = ''
        if is_slow_sql or has_lock_event or has_deadlock or UNIQUE_SQL_CLEANUP_PATTERN.search(log_block):
            connection_key, thread_id, IP, database, user = _get_prefix(log_block)

        # 仅回收 1 个 UniqueSQL 的自动清理视为 BUG；其他回收数量只进入特殊事件趋势。
        if UNIQUE_SQL_CLEANUP_PATTERN.search(log_block):
            cleanup_match = UNIQUE_SQL_CLEANUP_PATTERN.search(log_block)
            is_cleanup_bug = cleanup_match.group(1) == '1'
            error_list.append({
                'time': timestamp,
                'timestamp': timestamp_str,
                'level': 'BUG' if is_cleanup_bug else 'SPECIAL',
                'special_type': None if is_cleanup_bug else 'uniquesql_cleanup',
                'user': user or '',
                'database': database or '',
                'IP': IP or '',
                'message': '[UniqueSQL] Auto-cleanup over',
                'context_before': [],
                'context_after': [],
                'full_log': log_block.strip(),
            })
            continue

        # 资源不足仅用于特殊事件趋势，不属于 BUG，也不进入错误日志分析。
        if SORT_LACKS_MEM_PATTERN.search(log_block):
            error_list.append({
                'time': timestamp,
                'timestamp': timestamp_str,
                'level': 'SPECIAL',
                'special_type': 'sort_lacks_mem',
                'message': 'Sort lacks mem',
                'full_log': log_block.strip(),
            })
            continue

        # ---- 0. 捕获 ERROR / WARNING / FATAL / PANIC 错误日志 ----
        if error_list is not None and args.mode.lower() in ('error', 'all'):
            head = log_block[:400]
            m_err = ERROR_LEVEL_PATTERN.search(head)
            # TRUNCATE 识别：RelationSetNewRelfilenode 为 TRUNCATE 重建表文件的内部日志
            # （[BACKEND] LOG 级，不在 ERROR/WARNING 级别内，单独检测），
            # 归一为 TRUNCATE TABLE <relname>，完整日志保留到 full_log
            m_trunc = None
            if not m_err and 'RelationSetNewRelfilenode' in log_block:
                m_trunc = re.search(
                    r'RelationSetNewRelfilenode\s+Relation\s+([^\s(]+)\((\d+)\)',
                    log_block, re.IGNORECASE)
            if m_trunc:
                if connection_key is None:
                    connection_key, thread_id, IP, database, user = _get_prefix(log_block)
                # include/exclude 过滤（TRUNCATE 按 db/user/表对象）
                if _EVENT_FILTER_ACTIVE and not _event_passes_filter(
                        database, user, '', _EVENT_INCLUDE, _EVENT_EXCLUDE,
                        sql_text=f"truncate table {m_trunc.group(1)}" if _EVENT_TABLE_FILTER_ACTIVE else None):
                    m_trunc = None
            if m_trunc:
                rel_name = m_trunc.group(1)
                # 归一化 DDL（按表名聚合），完整内部日志原文保留
                err_msg = f"truncate table {rel_name}"
                _trunc_full = log_block.strip()
                _trunc_key = ('TRUNCATE', rel_name.lower())
                _cur_idx = len(error_list)
                _g = _error_groups.get(_trunc_key)
                if _g is None:
                    _error_groups[_trunc_key] = {
                        'first_idx': _cur_idx, 'last_idx': _cur_idx,
                        'first_ctx': {'context_before': [], 'context_after': [],
                                      'full_log': _trunc_full},
                        'last_ctx': None, 'count': 1,
                    }
                else:
                    _g['count'] += 1
                    _g['last_idx'] = _cur_idx
                    _g['last_ctx'] = {'context_before': [], 'context_after': [],
                                      'full_log': _trunc_full}
                error_list.append({
                    'time': timestamp,
                    'timestamp': timestamp_str,
                    'level': 'TRUNCATE',
                    'user': user or '',
                    'database': database or '',
                    'IP': IP or '',
                    'message': err_msg,
                    'context_before': [],
                    'context_after': [],
                    'full_log': '',
                })
                continue  # truncate 块不再走其他解析

            # DROP 识别：兼容两种日志格式
            #   1) statement: drop table xxx
            #   2) CONTEXT:  SQL statement "drop procedure if exists ymtc.p_purge_lothist"
            # 支持 table / view / index / sequence / schema / function / procedure / trigger 等
            # 独立级别 'DROP'，与 TRUNCATE 分开统计，但共用同一聚合表展示
            m_drop = None
            if not m_err and not m_trunc and 'drop' in log_block.lower():
                m_drop = re.search(
                    r'statement:\s*drop\s+(\w+)\s+(?:if\s+exists\s+)?([^\s;"\']+)',
                    log_block, re.IGNORECASE)
                if not m_drop:
                    # CONTEXT:  SQL statement "drop procedure if exists ymtc.xxx"
                    m_drop = re.search(
                        r'CONTEXT:\s*SQL\s+statement\s*"\s*drop\s+(\w+)\s+(?:if\s+exists\s+)?([^"\']+?)\s*"',
                        log_block, re.IGNORECASE)
            if m_drop:
                if connection_key is None:
                    connection_key, thread_id, IP, database, user = _get_prefix(log_block)
                if _EVENT_FILTER_ACTIVE and not _event_passes_filter(
                        database, user, '', _EVENT_INCLUDE, _EVENT_EXCLUDE,
                        sql_text=f"drop {m_drop.group(1)} {m_drop.group(2)}" if _EVENT_TABLE_FILTER_ACTIVE else None):
                    m_drop = None
            if m_drop:
                obj_type = m_drop.group(1).lower()
                obj_name = m_drop.group(2).rstrip(';')
                err_msg = f"drop {obj_type} {obj_name}"
                _drop_full = log_block.strip()
                _drop_key = ('DROP', f"drop:{obj_type}:{obj_name.lower()}")
                _cur_idx = len(error_list)
                _g = _error_groups.get(_drop_key)
                if _g is None:
                    _error_groups[_drop_key] = {
                        'first_idx': _cur_idx, 'last_idx': _cur_idx,
                        'first_ctx': {'context_before': [], 'context_after': [],
                                      'full_log': _drop_full},
                        'last_ctx': None, 'count': 1,
                    }
                else:
                    _g['count'] += 1
                    _g['last_idx'] = _cur_idx
                    _g['last_ctx'] = {'context_before': [], 'context_after': [],
                                      'full_log': _drop_full}
                error_list.append({
                    'time': timestamp,
                    'timestamp': timestamp_str,
                    'level': 'DROP',
                    'user': user or '',
                    'database': database or '',
                    'IP': IP or '',
                    'message': err_msg,
                    'context_before': [],
                    'context_after': [],
                    'full_log': '',
                })
                continue  # drop 块不再走其他解析

            # ALTER 识别：兼容两种日志格式
            #   1) statement: alter table xxx
            #   2) CONTEXT:  SQL statement "alter table ymtc.lot_hist_p truncate partition sys_p15 update global index;"
            # 支持 table / index / view / sequence / schema / function / procedure / trigger 等
            # 独立级别 'ALTER'，与 TRUNCATE/DROP 分开统计，但共用同一聚合表展示
            m_alter = None
            if not m_err and not m_trunc and not m_drop and 'alter' in log_block.lower():
                m_alter = re.search(
                    r'statement:\s*alter\s+(\w+)\s+(?:if\s+exists\s+)?([^\s;"\']+)',
                    log_block, re.IGNORECASE)
                if not m_alter:
                    # CONTEXT:  SQL statement "alter table ymtc.xxx ..."
                    m_alter = re.search(
                        r'CONTEXT:\s*SQL\s+statement\s*"\s*alter\s+(\w+)\s+(?:if\s+exists\s+)?([^"\']+?)\s*"',
                        log_block, re.IGNORECASE)
            if m_alter:
                if connection_key is None:
                    connection_key, thread_id, IP, database, user = _get_prefix(log_block)
                if _EVENT_FILTER_ACTIVE and not _event_passes_filter(
                        database, user, '', _EVENT_INCLUDE, _EVENT_EXCLUDE,
                        sql_text=f"alter {m_alter.group(1)} {m_alter.group(2)}" if _EVENT_TABLE_FILTER_ACTIVE else None):
                    m_alter = None
            if m_alter:
                obj_type = m_alter.group(1).lower()
                obj_name = m_alter.group(2).rstrip(';')
                # 截断过长的对象名（如 alter table ... truncate partition ... 整段）
                if len(obj_name) > 80:
                    obj_name = obj_name[:80] + ' ...'
                err_msg = f"alter {obj_type} {obj_name}"
                _alter_full = log_block.strip()
                _alter_key = ('ALTER', f"alter:{obj_type}:{obj_name.lower()}")
                _cur_idx = len(error_list)
                _g = _error_groups.get(_alter_key)
                if _g is None:
                    _error_groups[_alter_key] = {
                        'first_idx': _cur_idx, 'last_idx': _cur_idx,
                        'first_ctx': {'context_before': [], 'context_after': [],
                                      'full_log': _alter_full},
                        'last_ctx': None, 'count': 1,
                    }
                else:
                    _g['count'] += 1
                    _g['last_idx'] = _cur_idx
                    _g['last_ctx'] = {'context_before': [], 'context_after': [],
                                      'full_log': _alter_full}
                error_list.append({
                    'time': timestamp,
                    'timestamp': timestamp_str,
                    'level': 'ALTER',
                    'user': user or '',
                    'database': database or '',
                    'IP': IP or '',
                    'message': err_msg,
                    'context_before': [],
                    'context_after': [],
                    'full_log': '',
                })
                continue  # alter 块不再走其他解析
            if m_err:
                # 排除级别关键字出现在 duration/statement 正文里的误判
                stmt_pos = head.find('statement:')
                dur_pos = head.find('duration:')
                if (stmt_pos != -1 and stmt_pos < m_err.start()) or \
                        (dur_pos != -1 and dur_pos < m_err.start()):
                    m_err = None
            if m_err:
                if connection_key is None:
                    connection_key, thread_id, IP, database, user = _get_prefix(log_block)
                # include/exclude 过滤（错误日志没有 unique_id，按 db/user 过滤）
                if _EVENT_FILTER_ACTIVE and not _event_passes_filter(database, user, '', _EVENT_INCLUDE, _EVENT_EXCLUDE):
                    m_err = None
            if m_err:
                err_msg = log_block[m_err.end():].strip()

                # 归一化:去掉数值/引号内容,只保留消息骨架用于聚合
                _err_key = (m_err.group(1), _ERR_NORM_AGG_RE.sub('?', err_msg[:200]).strip())
                _cur_idx = len(error_list)  # 当前记录在 error_list 中的 index
                _is_first = _err_key not in _error_groups

                # 收集前后3行日志上下文,按会话ID(thread_id)过滤
                # 默认窗口:前后各3行(按位置),在窗口内只保留匹配会话ID或无会话ID的行
                # 如果窗口内没有匹配行,context_before/after 为空,详情卡片只显示当前块
                context_lines = []
                context_before = []
                context_after = []
                cur_thread_id = thread_id or ''
                if cur_thread_id:
                    # 前3行窗口内按会话ID过滤
                    for j in range(max(start_n, i - 6), i, 2):
                        if j + 1 < len(blocks):
                            ctx_block = blocks[j + 1].strip()
                            if not ctx_block:
                                continue
                            ctx_thread = _get_prefix(ctx_block)[1]
                            if not ctx_thread or ctx_thread == cur_thread_id:
                                context_before.append(ctx_block)
                    # 后3行窗口内按会话ID过滤
                    for j in range(i + 2, min(len(blocks), i + 8), 2):
                        if j + 1 < len(blocks):
                            ctx_block = blocks[j + 1].strip()
                            if not ctx_block:
                                continue
                            ctx_thread = _get_prefix(ctx_block)[1]
                            if not ctx_thread or ctx_thread == cur_thread_id:
                                context_after.append(ctx_block)
                else:
                    # 无会话ID:退化为按位置取前后3行
                    for j in range(max(start_n, i - 6), i, 2):
                        if j + 1 < len(blocks):
                            ctx_block = blocks[j + 1].strip()
                            if ctx_block:
                                context_before.append(ctx_block)
                    for j in range(i + 2, min(len(blocks), i + 8), 2):
                        if j + 1 < len(blocks):
                            ctx_block = blocks[j + 1].strip()
                            if ctx_block:
                                context_after.append(ctx_block)
                # 当前块
                context_lines.append(log_block.strip())

                # 内存优化:按 (level, 归一化消息) 聚合,每类只保留首尾 2 条完整记录,
                # 中间记录只存轻量字段(time/level/user/database/IP),节省 90%+ 内存。
                if _is_first:
                    # 首次出现:记录 first 完整数据 + index
                    _error_groups[_err_key] = {
                        'first_idx': _cur_idx,
                        'last_idx': _cur_idx,
                        'first_ctx': {
                            'context_before': context_before,
                            'context_after': context_after,
                            'full_log': log_block.strip(),
                        },
                        'last_ctx': None,  # 只有 1 条时为 None
                        'count': 1,
                    }
                else:
                    # 后续出现:更新 last 为当前完整数据 + index
                    _g = _error_groups[_err_key]
                    _g['count'] += 1
                    _g['last_idx'] = _cur_idx
                    _g['last_ctx'] = {
                        'context_before': context_before,
                        'context_after': context_after,
                        'full_log': log_block.strip(),
                    }
                # 追加轻量记录到 error_list(不含 context/full_log,处理结束后再填回首尾)
                error_list.append({
                    'time': timestamp,
                    'timestamp': timestamp_str,
                    'level': m_err.group(1),
                    'user': user or '',
                    'database': database or '',
                    'IP': IP or '',
                    'message': err_msg[:2000],
                    'context_before': [],
                    'context_after': [],
                    'full_log': '',
                })

        # ---- 1. 缓存 SQL 文本和 Unique ID（供锁事件关联） ----
        # include/exclude 过滤：被过滤掉的慢SQL不写入关联缓存，避免污染锁事件/死锁的 unique_id 回填
        _slow_passes_filter = True
        if is_slow_sql and _EVENT_FILTER_ACTIVE:
            _m_uid = re.search(r'unique\s+id\s+(\S+)', log_block, re.IGNORECASE)
            _uid_for_filter = _m_uid.group(1).strip() if _m_uid else ''
            _slow_passes_filter = _event_passes_filter(
                database, user, _uid_for_filter, _EVENT_INCLUDE, _EVENT_EXCLUDE,
                sql_text=_extract_sql_text_from_block(log_block) if _EVENT_TABLE_FILTER_ACTIVE else None)
        if is_slow_sql and not _slow_passes_filter:
            # 被过滤的慢SQL：不更新 recent_sql_by_connection / unique_id_by_connection / tx_activity，
            # 但仍需更新 last_sql_time，避免影响后续同连接 SQL 的锁事件关联
            if connection_key and timestamp:
                last_sql_time[connection_key] = timestamp
        elif is_slow_sql:
            sql_text = _extract_sql_text_from_block(log_block)
            if sql_text and connection_key:
                if len(sql_text) > 2000:
                    sql_text = sql_text[:2000] + '...'
                recent_sql_by_connection[connection_key] = sql_text
                # 从慢查询块中提取 unique id
                m = re.search(r'unique\s+id\s+(\S+)', log_block, re.IGNORECASE)
                if m:
                    unique_id = m.group(1).strip()
                    unique_id_by_connection[connection_key] = unique_id
                    if thread_id:
                        thread_to_unique_id[thread_id] = unique_id
                # 记录事务活动：供锁等待链关联阻塞者语句
                txid = _get_prefix_txid(log_block)
                if txid and txid != '0':
                    # 按 (connection_key, sql_text) 去重，避免同一事务同一语句重复记录
                    is_dup = False
                    for act in tx_activity[txid]:
                        if act.get('connection_key') == connection_key and act.get('sql_text') == sql_text:
                            is_dup = True
                            break
                    if not is_dup:
                        tx_activity[txid].append({
                            'timestamp': timestamp_str,
                            'sql_text': sql_text,
                            'unique_id': unique_id if m else '',
                            'connection_key': connection_key,
                            'thread_id': thread_id
                        })
        elif 'statement:' in log_block.lower() or 'detail:' in log_block.lower():
            if connection_key is None:
                connection_key = _get_prefix(log_block)[0]
            sql_text = _extract_sql_text_from_block(log_block)
            if sql_text and connection_key:
                if len(sql_text) > 2000:
                    sql_text = sql_text[:2000] + '...'
                recent_sql_by_connection[connection_key] = sql_text
                # 记录事务活动：statement/detail 也计入事务语句
                txid = _get_prefix_txid(log_block)
                if txid and txid != '0':
                    is_dup = False
                    for act in tx_activity[txid]:
                        if act.get('connection_key') == connection_key and act.get('sql_text') == sql_text:
                            is_dup = True
                            break
                    if not is_dup:
                        tx_activity[txid].append({
                            'timestamp': timestamp_str,
                            'sql_text': sql_text,
                            'unique_id': '',
                            'connection_key': connection_key,
                            'thread_id': thread_id
                        })

        # ---- 2. 处理 still waiting / acquired（慢查询关联 + 死锁上下文 + 锁事件） ----
        if has_lock_event:
            ev_type, lock_type, wait_time, target_from_match, holder_txid = _match_lock_event(log_block)

            if ev_type is not None:
                tid_match = LOCK_WAITING_PATTERN.search(log_block) if ev_type == 'waiting' else LOCK_ACQUIRED_PATTERN.search(log_block)
                tid = tid_match.group(1) if tid_match else thread_id
                # 死锁上下文缓冲区
                _add_lock_event_to_buffer(timestamp_str, log_block, tid)

                # 慢查询 pending_lock_events 关联
                if connection_key:
                    new_event = {
                        'type': ev_type,
                        'lock_type': lock_type,
                        'wait_time_ms': wait_time,
                        'timestamp': timestamp_str,
                        'log_text': log_block.strip(),
                        'target': target_from_match or ''
                    }
                    is_duplicate = False
                    for existing_event in pending_lock_events[connection_key]:
                        if (existing_event['timestamp'] == new_event['timestamp'] and
                                existing_event['log_text'] == new_event['log_text']):
                            is_duplicate = True
                            break
                    if not is_duplicate:
                        pending_lock_events[connection_key].append(new_event)

                # ---- 统一锁事件列表（Top10 用，保持原有逻辑：waiting/acquired 独立入列） ----
                event_match = LOCK_EVENT_PATTERN.search(log_block)
                if event_match:
                    session_id = event_match.group(1)
                    event_kind_raw = event_match.group(2).strip().lower()
                    lock_type_from_pattern = event_match.group(3)
                    target_from_pattern = event_match.group(4)
                    wait_time_ms_from_pattern = float(event_match.group(5))

                    if 'deadlock' in event_kind_raw:
                        event_kind = 'deadlock'
                    elif 'acquired' in event_kind_raw:
                        event_kind = 'acquired'
                    else:
                        event_kind = 'waiting'

                    # 统一 target/lock_type 来源：优先使用 _match_lock_event 的结果,
                    # 与慢 SQL 详情侧 pending_lock_events 的 target 保持一致,
                    # 否则 LOCK_EVENT_PATTERN 会把 "transaction 1234" 提取为 "1234",
                    # 导致两侧 lock-anchor id 不一致、跳转失败
                    if target_from_match:
                        target_from_pattern = target_from_match
                    if lock_type:
                        lock_type_from_pattern = lock_type

                    key = f"{timestamp_str}_{session_id}_{event_kind}_{target_from_pattern}_{wait_time_ms_from_pattern}"
                    if key not in lock_seen:
                        lock_seen.add(key)
                        sql_text = recent_sql_by_connection.get(connection_key, '') if connection_key else ''
                        unique_id = unique_id_by_connection.get(connection_key, '') if connection_key else ''
                        full_log_parts = []
                        if log_block.strip():
                            full_log_parts.append(f"[{timestamp_str}] {log_block.strip()}")
                        try:
                            max_look_ahead = min(50, len(blocks) - i - 2)
                            for j in range(2, max_look_ahead * 2 + 2, 2):
                                next_idx = i + j
                                if next_idx + 1 >= len(blocks):
                                    break
                                next_ts_str = blocks[next_idx]
                                next_block = blocks[next_idx + 1]
                                next_ts = parse_datetime(next_ts_str)
                                if next_ts and current_ts:
                                    if (next_ts - current_ts).total_seconds() > 5.0:
                                        break
                                next_thread = _get_prefix(next_block)[1]
                                # 遇到不同 thread 的锁事件才停止，同 thread 的相关日志继续收集
                                if next_thread != session_id and LOCK_EVENT_PATTERN.search(next_block):
                                    break
                                if next_thread == session_id and _is_related_follow_up_block(next_block, session_id):
                                    full_log_parts.append(f"[{next_ts_str}] {next_block.strip()}")
                                    if not sql_text:
                                        follow_sql = _extract_sql_text_from_block(next_block)
                                        if follow_sql:
                                            sql_text = follow_sql
                                            if len(sql_text) > 2000:
                                                sql_text = sql_text[:2000] + '...'
                                    if not unique_id:
                                        m = re.search(r'unique\s+id\s+(\S+)', next_block, re.IGNORECASE)
                                        if m:
                                            unique_id = m.group(1).strip()
                        except Exception:
                            pass

                        # 提取当前事务号（等待者自己的事务）
                        current_txid = _get_prefix_txid(log_block)
                        # 如果 tx_activity 中已有该事务的语句，回填 unique_id 和 sql_text
                        if current_txid and current_txid != '0':
                            current_acts = tx_activity.get(current_txid, [])
                            if current_acts:
                                # 取最后一条有 unique_id 的语句
                                for act in reversed(current_acts):
                                    if act.get('unique_id'):
                                        if not unique_id:
                                            unique_id = act['unique_id']
                                        if not sql_text:
                                            sql_text = act['sql_text']
                                        break
                                if not sql_text:
                                    sql_text = current_acts[-1]['sql_text']

                        # 收集前后3行日志上下文
                        le_context_before = []
                        le_context_after = []
                        for j in range(max(start_n, i - 6), i, 2):
                            if j + 1 < len(blocks):
                                ctx_block = blocks[j + 1].strip()
                                if ctx_block:
                                    le_context_before.append(ctx_block)
                        for j in range(i + 2, min(len(blocks), i + 8), 2):
                            if j + 1 < len(blocks):
                                ctx_block = blocks[j + 1].strip()
                                if ctx_block:
                                    le_context_after.append(ctx_block)

                        # include/exclude 过滤（锁事件：按 db/user/unique_id/关联 SQL 的表对象）
                        if not _EVENT_FILTER_ACTIVE or _event_passes_filter(
                                database, user, unique_id, _EVENT_INCLUDE, _EVENT_EXCLUDE,
                                sql_text=sql_text if _EVENT_TABLE_FILTER_ACTIVE else None):
                            lock_event_list.append({
                                'timestamp': timestamp_str,
                                'session_id': session_id,
                                'lock_type': lock_type_from_pattern,
                                'target': target_from_pattern,
                                'wait_time_ms': wait_time_ms_from_pattern,
                                'event_kind': event_kind,
                                'connection_key': connection_key or '',
                                'log_text': '\n'.join(full_log_parts),
                                'sql_text': sql_text,
                                'unique_id': unique_id,
                                'txid': current_txid or '',
                                'context_before': le_context_before,
                                'context_after': le_context_after
                            })

                # ---- 锁等待链：waiting → acquired 合并（新逻辑，不影响 Top10） ----
                if ev_type == 'waiting':
                    # 缓存 waiting 事件，等待 acquired 合并
                    pending_waiting_events[tid] = {
                        'timestamp': timestamp_str,
                        'log_block': log_block,
                        'connection_key': connection_key,
                        'thread_id': tid,
                        'lock_type': lock_type,
                        'target': target_from_match or '',
                        'holder_txid': holder_txid,
                        'wait_time_ms': wait_time
                    }
                elif ev_type == 'acquired':
                    # 合并 waiting + acquired
                    waiting_ev = pending_waiting_events.pop(tid, None)
                    if waiting_ev:
                        # 总等待时间 = waiting 的 1s + acquired 的 after 时间
                        merged_wait_ms = waiting_ev['wait_time_ms'] + wait_time
                        # 合并日志：waiting + acquired
                        merged_log = f"[{waiting_ev['timestamp']}] {waiting_ev['log_block'].strip()}\n[{timestamp_str}] {log_block.strip()}"
                        # 用 waiting 的 target/holder_txid（更完整），acquired 的 wait_time
                        merged_target = waiting_ev['target'] or (target_from_match or '')
                        merged_holder_txid = waiting_ev['holder_txid'] or holder_txid
                    else:
                        # 没有 waiting，只有 acquired（如等待时间极短，只打印 acquired）
                        merged_wait_ms = wait_time
                        merged_log = f"[{timestamp_str}] {log_block.strip()}"
                        merged_target = target_from_match or ''
                        merged_holder_txid = holder_txid

                    # 向后查找被阻塞语句的 duration 日志，获取 unique_id 和 sql_text
                    blocked_unique_id = ''
                    blocked_sql = ''
                    try:
                        max_look_ahead = min(100, len(blocks) - i - 2)
                        for j in range(2, max_look_ahead * 2 + 2, 2):
                            next_idx = i + j
                            if next_idx + 1 >= len(blocks):
                                break
                            next_ts_str = blocks[next_idx]
                            next_block = blocks[next_idx + 1]
                            next_ts = parse_datetime(next_ts_str)
                            if next_ts and current_ts:
                                if (next_ts - current_ts).total_seconds() > 10.0:
                                    break
                            # 只找同 thread 的 duration 日志
                            next_thread = _get_prefix(next_block)[1]
                            if next_thread != tid:
                                continue
                            if 'duration:' in next_block and ('execute' in next_block or 'statement:' in next_block):
                                # 提取 unique id
                                m = re.search(r'unique\s+id\s+(\S+)', next_block, re.IGNORECASE)
                                if m:
                                    blocked_unique_id = m.group(1).strip()
                                # 提取 SQL
                                blocked_sql = _extract_sql_text_from_block(next_block)
                                if blocked_sql and len(blocked_sql) > 2000:
                                    blocked_sql = blocked_sql[:2000] + '...'
                                # 追加到 merged_log
                                merged_log += f"\n[{next_ts_str}] {next_block.strip()}"
                                break
                    except Exception:
                        pass

                    # ---- 锁等待链：关联阻塞者事务及其语句 ----
                    holder_session = ''
                    holder_unique_id = ''
                    holder_sql = ''
                    holder_all_sql = []
                    holder_txid_val = merged_holder_txid
                    if holder_txid_val and holder_txid_val != '0':
                        # 从 tx_activity 中查找阻塞者事务的语句
                        holder_activity = tx_activity.get(holder_txid_val, [])
                        if holder_activity:
                            holder_all_sql = [act['sql_text'] for act in holder_activity]
                            # 取最后一条有 unique_id 的语句作为代表
                            for act in reversed(holder_activity):
                                if act.get('unique_id'):
                                    holder_unique_id = act['unique_id']
                                    holder_sql = act['sql_text']
                                    break
                            if not holder_sql:
                                holder_sql = holder_all_sql[-1]
                            # 会话ID取第一条记录的 connection_key
                            holder_session = holder_activity[0].get('connection_key', '')

                    # 提取当前事务号（等待者自己的事务）
                    current_txid = _get_prefix_txid(log_block)
                    # 如果 tx_activity 中已有该事务的语句，回填 unique_id 和 sql_text
                    current_unique_id = blocked_unique_id
                    current_sql_text = blocked_sql
                    if current_txid and current_txid != '0':
                        current_acts = tx_activity.get(current_txid, [])
                        if current_acts:
                            for act in reversed(current_acts):
                                if act.get('unique_id'):
                                    if not current_unique_id:
                                        current_unique_id = act['unique_id']
                                    if not current_sql_text:
                                        current_sql_text = act['sql_text']
                                    break
                            if not current_sql_text:
                                current_sql_text = current_acts[-1]['sql_text']

                    # 收集前后3行日志上下文
                    lc_context_before = []
                    lc_context_after = []
                    for j in range(max(start_n, i - 6), i, 2):
                        if j + 1 < len(blocks):
                            ctx_block = blocks[j + 1].strip()
                            if ctx_block:
                                lc_context_before.append(ctx_block)
                    for j in range(i + 2, min(len(blocks), i + 8), 2):
                        if j + 1 < len(blocks):
                            ctx_block = blocks[j + 1].strip()
                            if ctx_block:
                                lc_context_after.append(ctx_block)

                    # include/exclude 过滤（锁等待链：按 db/user/unique_id/关联 SQL 的表对象）
                    if not _EVENT_FILTER_ACTIVE or _event_passes_filter(
                            database, user, current_unique_id, _EVENT_INCLUDE, _EVENT_EXCLUDE,
                            sql_text=current_sql_text if _EVENT_TABLE_FILTER_ACTIVE else None):
                        lock_chain_list.append({
                            'timestamp': timestamp_str,
                            'session_id': tid,
                            'lock_type': lock_type,
                            'target': merged_target,
                            'wait_time_ms': merged_wait_ms,
                            'event_kind': 'acquired',
                            'connection_key': connection_key or '',
                            'log_text': merged_log,
                            'sql_text': current_sql_text or (recent_sql_by_connection.get(connection_key, '') if connection_key else ''),
                            'unique_id': current_unique_id or (unique_id_by_connection.get(connection_key, '') if connection_key else ''),
                            'holder_txid': holder_txid_val or '',
                            'holder_session': holder_session,
                            'holder_unique_id': holder_unique_id,
                            'holder_sql': holder_sql,
                            'holder_all_sql': holder_all_sql,
                            'waiting_timestamp': waiting_ev['timestamp'] if waiting_ev else '',
                            'waiting_log': waiting_ev['log_block'].strip() if waiting_ev else '',
                            'txid': current_txid or '',
                            'context_before': lc_context_before,
                            'context_after': lc_context_after
                        })

        # ---- 3. 处理死锁 ----
        if has_deadlock:
            detect_match = DEADLOCK_DETECT_PATTERN.search(log_block)
            if detect_match:
                # include/exclude 过滤（死锁 SQL 在候选解析完成后统一按对象筛选）
                if _EVENT_FILTER_ACTIVE and not _EVENT_TABLE_FILTER_ACTIVE and not _event_passes_filter(
                        database, user, '', _EVENT_INCLUDE, _EVENT_EXCLUDE):
                    detect_match = None
            if detect_match:
                if args.debug:
                    print(f"[DEBUG] 检测到死锁行，ts={timestamp_str}, thread={detect_match.group(1)}, txid={detect_match.group(3)}")
                _cleanup_lock_event_buffer(current_ts)

                detail_for_parsing = log_block
                j = i + 2
                while j + 1 < len(blocks):
                    next_ts_str = blocks[j]
                    next_block = blocks[j + 1]
                    next_ts = parse_datetime(next_ts_str)
                    # 允许相邻毫秒（50ms 内）的 Process SQL DETAIL 块，避免死锁 DETAIL 与 LOG 时间戳差 1ms 导致丢失
                    if next_ts is None or (next_ts - current_ts).total_seconds() > 0.050:
                        break
                    # 只合并包含 Process X: SQL 的 DETAIL 块，避免 ERROR/HINT/STATEMENT 等后续日志混入 SQL 提取
                    if re.search(r'Process\s+\d+:\s', next_block, re.IGNORECASE):
                        detail_for_parsing += '\n' + next_block
                    j += 2

                if args.debug:
                    _has_process_sql_flag = bool(re.search(r'Process\s+\d+:\s', detail_for_parsing, re.IGNORECASE))
                    print(f"[DEBUG] 预存死锁候选，ts={timestamp_str}, detail_len={len(detail_for_parsing)}, has_process_sql={_has_process_sql_flag}")

                deadlock_candidates.append({
                    'timestamp_str': timestamp_str,
                    'current_ts': current_ts,
                    'log_block': log_block,
                    'detail_for_parsing': detail_for_parsing,
                    'index': i,
                    'connection_key_a': connection_key,
                    'thread_id_a': thread_id,
                    'database': database,
                    'user': user
                })

        # ---- 4. 处理慢查询 ----
        if is_slow_sql:
            try:
                # 前缀已经解析过，直接使用缓存结果
                if connection_key is None and IP == '' and database == '' and user == '':
                    connection_key, thread_id, IP, database, user = _get_prefix(log_block)

                query_content = EXECUTE_PATTERN.split(log_block)
                # split 产物现仅两用: ① <3 门块级粗筛(锚点存在 ⟹ ≥3 段, 门不会拦掉
                # 成功的锚点提取) ② 时长兜底取 query_content[1]。SQL 文本不走段取法
                # (字面量含 bind x:/execute x: 会被二次切开), 由下方锚点整段提取;
                # 无 uid 记录由此保留并归 0_<md5> 指纹桶
                if len(query_content) < 3:
                    continue
                # SQL 文本提取 + 参数余料/空段守卫(2026-11-26 第四轮实测修正):
                # EXECUTE_PATTERN.split 会在 SQL 字面量含 'bind x:'/'execute x:' 字样处
                # 二次切开, 段取法([2]/[3])从根上拿不到完整 SQL——改用"duration: 之后
                # 首个 execute/bind/statement: 锚点"整段提取(复用锁事件路径的同款助手):
                #   ① 字面量含 'bind x: parameters:' 的合法 SQL 完整保留(不再误杀/不再碎段)
                #   ② bind 参数余料行(提取段 ^parameters: 开头)与空语句段丢弃
                #   ③ 同块参数尾巴(\nparameters: / \nDETAIL: parameters:)剥除,
                #      同语句不同绑定值归同一指纹桶
                # 丢弃位置与放宽前 <4 门等价(不消费 pending_lock_events/不更新 last_sql_time)
                _dur_pos = log_block.find('duration:')
                query_text = _extract_sql_text_from_block(
                    log_block[_dur_pos:] if _dur_pos >= 0 else log_block,
                    allow_deadlock=False)
                # unique_id 提取: 直接用正则从 log_block 提取(与切分段无关)
                _uid_m = re.search(r'unique\s+id\s+(\S+)', log_block, re.IGNORECASE)
                unique_id = _uid_m.group(1).strip() if _uid_m else ''
                # 记录原始 queryid（每条执行都不同，仅用于页面悬停展示，不作统计维度）
                _qid_m = re.search(r'queryid\s+(\d+)', log_block, re.IGNORECASE)
                queryid = _qid_m.group(1) if _qid_m else ''
                # 防御: 锚点后紧跟 uid 的形态, 剥掉开头 uid
                if unique_id and query_text.lstrip().startswith(unique_id):
                    query_text = query_text.lstrip()[len(unique_id):].lstrip()
                query_text = query_text.strip()
                if not query_text or re.match(r'parameters\s*:', query_text, re.IGNORECASE):
                    continue

                duration_match = DURATION_EXTRACT_PATTERN.search(log_block)
                if duration_match:
                    duration_value = float(duration_match.group(1))
                    matched_text = duration_match.group(0).lower()
                    if 'ms' in matched_text:
                        duration = duration_value / 1000.0
                    else:
                        duration = duration_value
                else:
                    duration_str_parts = SPLIT_PATTERN.split(query_content[1])
                    if len(duration_str_parts) < 2:
                        continue
                    duration = float(duration_str_parts[1].strip()) / 1000

                if timestamp:
                    sql_start_time = timestamp - timedelta(seconds=max(0, duration))
                    _begin_dt = parse_datetime_cached(args.begin) if args.begin else None
                    if _begin_dt is not None and timestamp < _begin_dt:
                        continue
                    _end_dt = parse_datetime_cached(args.end) if args.end else None
                    if _end_dt is not None and timestamp > _end_dt:
                        continue

                lock_wait_time_ms = 0.0
                lock_events = []
                if connection_key and connection_key in pending_lock_events:
                    sql_start_time = None
                    if timestamp:
                        sql_start_time = timestamp - timedelta(seconds=duration)
                    last_time = last_sql_time.get(connection_key)

                    filtered_events = []
                    for event in pending_lock_events[connection_key]:
                        event_time = parse_datetime(event['timestamp'])
                        if not event_time:
                            continue
                        if sql_start_time and event_time < sql_start_time:
                            continue
                        if timestamp and event_time > timestamp:
                            continue
                        if last_time and event_time <= last_time:
                            continue
                        filtered_events.append(event)

                    lock_events = filtered_events
                    for event in lock_events:
                        lock_wait_time_ms += event['wait_time_ms']
                    del pending_lock_events[connection_key]

                if connection_key and timestamp:
                    last_sql_time[connection_key] = timestamp

                # SQL类型打标：只取第一个有效词元判断
                # EXPLAIN (ANALYZE ...) 前缀保留整段，按 EXPLAIN 后第一个 DML/DDL
                # 关键字归类（如 EXPLAIN ... SELECT 归为 dml）
                stripped_text = query_text.lstrip()
                first_token = stripped_text.split(None, 1)[0].rstrip(';').upper() if stripped_text else ''
                is_explain = first_token == 'EXPLAIN'
                type_token = first_token
                if is_explain:
                    # 跳过 EXPLAIN 及可选的 (options...)，取其后第一个词元判型
                    rest = stripped_text[len(first_token):].lstrip()
                    if rest.startswith('('):
                        depth = 0
                        pos = 0
                        while pos < len(rest):
                            if rest[pos] == '(':
                                depth += 1
                            elif rest[pos] == ')':
                                depth -= 1
                                if depth == 0:
                                    pos += 1
                                    break
                            pos += 1
                        rest = rest[pos:].lstrip()
                    # 跳过 EXPLAIN 的裸关键字选项（ANALYZE/VERBOSE/COSTS 等）
                    while rest:
                        tok = rest.split(None, 1)[0].rstrip(';').upper()
                        if tok in ('ANALYZE', 'VERBOSE', 'COSTS', 'BUFFERS', 'TIMING',
                                   'SUMMARY', 'FORMAT', 'TRUE', 'FALSE', 'ON', 'OFF'):
                            parts = rest.split(None, 1)
                            rest = parts[1].lstrip() if len(parts) > 1 else ''
                        else:
                            break
                    type_token = rest.split(None, 1)[0].rstrip(';').upper() if rest else 'SELECT'
                dml_keywords = frozenset((
                    'SELECT', 'INSERT', 'UPDATE', 'DELETE', 'MERGE', 'WITH', 'CALL', 'BEGIN', 'COMMIT', 'ROLLBACK',
                    'EXECUTE', 'PREPARE', 'DEALLOCATE', 'COPY', 'DECLARE'
                ))
                ddl_keywords = frozenset((
                    'CREATE', 'DROP', 'ALTER', 'TRUNCATE', 'GRANT', 'REVOKE', 'INDEX', 'TABLESPACE',
                    'SCHEMA', 'DATABASE', 'SEQUENCE', 'VIEW', 'FUNCTION', 'PROCEDURE', 'TRIGGER',
                    'TYPE', 'COMMENT', 'OWNER', 'RULE', 'VACUUM', 'ANALYZE', 'REINDEX', 'CLUSTER',
                    'LOCK', 'UNLOCK', 'SAVEPOINT', 'RELEASE', 'SET'
                ))

                is_dml = type_token in dml_keywords
                is_ddl = type_token in ddl_keywords
                sql_type = 'ddl' if is_ddl else 'dml'

                # 清理 query_text 的前导非关键词元（保留原行为）
                if not is_dml and not is_ddl:
                    first_space_pos = stripped_text.find(' ')
                    if first_space_pos > 0:
                        query_text = stripped_text[first_space_pos:].strip()
                    else:
                        query_text = stripped_text
                    # 重新判断
                    first_token = query_text.split(None, 1)[0].rstrip(';').upper() if query_text else ''
                    is_dml = first_token in dml_keywords
                    is_ddl = first_token in ddl_keywords
                    sql_type = 'ddl' if is_ddl else 'dml'

                v_params = ''
                if i + 3 < len(blocks) and "parameters:" in blocks[i + 3]:
                    try:
                        v_params = PARAMETERS_PATTERN.split(blocks[i + 3])[1].strip()
                    except IndexError:
                        v_params = ''

                # --mode error 模式不提取 SQL；query/all 模式保留所有 SQL（DML+DDL）
                if statement_filter == 'error':
                    continue

                # include/exclude 过滤（此时 unique_id 已从 EXECUTE_PATTERN 拆出）
                if _EVENT_FILTER_ACTIVE and not _event_passes_filter(
                        database, user, unique_id, _EVENT_INCLUDE, _EVENT_EXCLUDE,
                        sql_text=query_text if _EVENT_TABLE_FILTER_ACTIVE else None):
                    continue

                # unique id 为 0/空时，用 SQL 文本指纹（0_<md5>）归一，
                # 保证相同文本聚合到同一统计维度；queryid 仅记录展示
                if unique_id in ('', '0'):
                    unique_id = _sql_fingerprint_id(query_text)

                total_list.append({
                    'time': timestamp,
                    'qry_text': query_text,
                    'qry_params': v_params,
                    'IP': IP,
                    'database': database,
                    'user': user,
                    'duration': duration,
                    'unique_id': unique_id,
                    'queryid': queryid,
                    'connection_key': connection_key,
                    'lock_wait_time_ms': lock_wait_time_ms,
                    'lock_events': lock_events,
                    'sql_type': sql_type
                })
            except (IndexError, ValueError, Exception):
                continue

    # ---- 3.1 循环结束后统一解析死锁候选 ----
    if args.debug:
        print(f"[DEBUG] 主循环结束，死锁候选总数: {len(deadlock_candidates)}")

    for candidate in deadlock_candidates:
        timestamp_str = candidate['timestamp_str']
        current_ts = candidate['current_ts']
        log_block = candidate['log_block']
        detail_for_parsing = candidate['detail_for_parsing']
        i = candidate['index']
        connection_key_a = candidate.get('connection_key_a')

        has_process_sql = bool(re.search(r'Process\s+\d+:\s', detail_for_parsing, re.IGNORECASE))
        if not has_process_sql:
            if args.debug:
                print(f"[DEBUG] 死锁候选无 Process SQL，跳过，ts={timestamp_str}")
            continue

        detect_match = DEADLOCK_DETECT_PATTERN.search(log_block)
        if not detect_match:
            if args.debug:
                print(f"[DEBUG] 死锁候选未匹配 DEADLOCK_DETECT_PATTERN，跳过，ts={timestamp_str}")
            continue

        process_a = detect_match.group(1)
        lock_type = detect_match.group(2)
        txid_a = detect_match.group(3)
        wait_ms = float(detect_match.group(4))

        if args.debug:
            print(f"[DEBUG] 开始解析死锁候选，ts={timestamp_str}, process_a={process_a}, lock_type={lock_type}")

        process_b = None
        full_context_parts = [log_block.strip()]
        future_lock_events = []
        try:
            max_look_ahead = min(50, len(blocks) - i - 2)
            for j in range(2, max_look_ahead * 2 + 2, 2):
                next_idx = i + j
                if next_idx + 1 >= len(blocks):
                    break
                next_ts_str = blocks[next_idx]
                next_block = blocks[next_idx + 1]
                next_ts = parse_datetime(next_ts_str)
                if next_ts and current_ts:
                    if (next_ts - current_ts).total_seconds() > 2.0:
                        break
                if DEADLOCK_DETECT_PATTERN.search(next_block):
                    break
                if "duration:" in next_block and ("execute" in next_block or "statement:" in next_block):
                    break
                next_thread = _get_prefix(next_block)[1]
                if next_thread in (process_a, process_b):
                    if re.search(r'\b(DETAIL|ERROR|HINT|STATEMENT|CONTEXT)\s*:', next_block, re.IGNORECASE) or \
                       LOCK_WAITING_PATTERN.search(next_block) or LOCK_ACQUIRED_PATTERN.search(next_block) or \
                       ("duration:" in next_block and ("execute" in next_block or "statement:" in next_block)):
                        full_context_parts.append(next_block.strip())
                        waiting_match = LOCK_WAITING_PATTERN.search(next_block)
                        acquired_match = LOCK_ACQUIRED_PATTERN.search(next_block)
                        if waiting_match or acquired_match:
                            if waiting_match:
                                thread_id = waiting_match.group(1)
                                ev_lock_type = waiting_match.group(2)
                                wait_ms_ev = float(waiting_match.group(3))
                                event_type = 'waiting'
                            else:
                                thread_id = acquired_match.group(1)
                                ev_lock_type = acquired_match.group(2)
                                wait_ms_ev = float(acquired_match.group(3))
                                event_type = 'acquired'
                            future_lock_events.append({
                                'timestamp': next_ts_str,
                                'thread_id': thread_id,
                                'event_type': event_type,
                                'lock_type': ev_lock_type,
                                'wait_time_ms': wait_ms_ev,
                                'log_text': next_block.strip()
                            })
        except Exception:
            pass

        full_context = '\n'.join(full_context_parts)
        normalized_detail = re.sub(r'\n\s+', ' ', detail_for_parsing)

        txid_b = None

        for wait_match in process_wait.finditer(normalized_detail):
            p_a = wait_match.group(1)
            t_a = wait_match.group(2)
            p_b = wait_match.group(3)
            if p_a == process_a:
                process_b = p_b
                txid_a = t_a or txid_a
            elif p_b == process_a and process_b is None:
                process_b = p_a
                txid_b = t_a or txid_b
            elif p_b == process_a and process_b:
                txid_b = t_a or txid_b
            elif process_b and p_a == process_b:
                txid_b = t_a or txid_b

        sql_map = {}
        for sql_match in process_sql_multiline.finditer(normalized_detail):
            pid = sql_match.group(1)
            raw_sql = sql_match.group(2)
            # 去掉可能混入的日志前缀（形如 midb01 f1dmpdb 10.42.40.25(57882) 22688469415680 ...）
            cleaned_sql = re.split(
                r'\s+[a-zA-Z_][a-zA-Z0-9_]*(?:\s+[a-zA-Z_][a-zA-Z0-9_]*)*\s+\d+\.\d+\.\d+\.\d+\(\d+\)\s+\d+',
                raw_sql, maxsplit=1
            )[0]
            # 去掉同一行内后续跟进的 LOG/ERROR/DETAIL/HINT/STATEMENT 等日志标记
            cleaned_sql = re.split(
                r'\s+(?:LOG|ERROR|DETAIL|HINT|STATEMENT|CONTEXT)\s*:',
                cleaned_sql, maxsplit=1
            )[0]
            sql_text = ' '.join(cleaned_sql.split())
            if sql_text:
                sql_map[pid] = sql_text

        if not process_b:
            for pid in sql_map:
                if pid != process_a:
                    process_b = pid
                    break

        if args.debug:
            print(f"[DEBUG] 死锁候选解析结果，ts={timestamp_str}, process_a={process_a}, process_b={process_b}, sql_map_keys={list(sql_map.keys())}")

        if process_b:
            current_deadlock_event = {
                'timestamp': timestamp_str,
                'thread_id': process_a,
                'event_type': 'deadlock',
                'lock_type': lock_type,
                'wait_time_ms': wait_ms,
                'log_text': log_block.strip()
            }
            related_lock_events = _find_related_lock_events(process_a, process_b, current_ts, future_lock_events)
            related_lock_events.insert(0, current_deadlock_event)

            key = f"{timestamp_str}_{process_a}_{process_b}"
            if key not in deadlock_seen:
                deadlock_seen.add(key)
                # 尝试从后续上下文中解析 process_b 所在日志块，以找到其 connection_key
                connection_key_b = None
                try:
                    for j in range(2, min(50, len(blocks) - i - 2) * 2 + 2, 2):
                        next_idx = i + j
                        if next_idx + 1 >= len(blocks):
                            break
                        next_block = blocks[next_idx + 1]
                        if DEADLOCK_DETECT_PATTERN.search(next_block):
                            break
                        if "duration:" in next_block and ("execute" in next_block or "statement:" in next_block):
                            break
                        next_thread = _get_prefix(next_block)[1]
                        if next_thread == process_b:
                            connection_key_b = _get_prefix(next_block)[0]
                            break
                except Exception:
                    pass

                # 优先通过 thread_id 查找 unique_id，避免同 IP 多连接导致覆盖
                unique_id_a = thread_to_unique_id.get(process_a, '')
                unique_id_b = thread_to_unique_id.get(process_b, '')
                if not unique_id_a and connection_key_a:
                    unique_id_a = unique_id_by_connection.get(connection_key_a, '')
                if not unique_id_b and connection_key_b:
                    unique_id_b = unique_id_by_connection.get(connection_key_b, '')

                # 从 full_context_parts 中补充提取 unique_id（处理 unique_id 出现在死锁之后的情况）
                if not unique_id_a or not unique_id_b:
                    for ctx_block in full_context_parts:
                        ctx_thread = _get_prefix(ctx_block)[1]
                        m = re.search(r'unique\s+id\s+(\S+)', ctx_block, re.IGNORECASE)
                        if m:
                            uid = m.group(1).strip()
                            if ctx_thread == process_a and not unique_id_a:
                                unique_id_a = uid
                            elif ctx_thread == process_b and not unique_id_b:
                                unique_id_b = uid

                # 收集前3行日志上下文（死锁的后续上下文已在 full_context 中）
                # 注意：block 是按时间戳切的，单个 block 可能包含多行 SQL 续行
                # （如其他会话正在执行的大段 statement），直接 append 会把整段 SQL
                # 塞进详情卡导致渲染错乱，因此只取每个 block 的首行日志。
                dl_context_before = []
                for j in range(max(start_n, i - 6), i, 2):
                    if j + 1 < len(blocks):
                        ctx_block = blocks[j + 1].strip()
                        if ctx_block:
                            dl_context_before.append(ctx_block.split('\n', 1)[0])

                deadlock_record = {
                    'timestamp': timestamp_str,
                    'process_a': process_a,
                    'txid_a': txid_a or '',
                    'process_b': process_b,
                    'txid_b': txid_b or '',
                    'lock_duration_ms': wait_ms,
                    'lock_type': lock_type,
                    'sql_a': sql_map.get(process_a, ''),
                    'sql_b': sql_map.get(process_b, ''),
                    'unique_id_a': unique_id_a,
                    'unique_id_b': unique_id_b,
                    'related_lock_events': related_lock_events,
                    'full_context': full_context,
                    'context_before': dl_context_before
                }
                if _EVENT_TABLE_FILTER_ACTIVE:
                    sql_a = deadlock_record['sql_a']
                    sql_b = deadlock_record['sql_b']
                    passes_a = _event_passes_filter(
                        candidate.get('database', ''), candidate.get('user', ''), unique_id_a,
                        _EVENT_INCLUDE, _EVENT_EXCLUDE, sql_text=sql_a or None)
                    passes_b = _event_passes_filter(
                        candidate.get('database', ''), candidate.get('user', ''), unique_id_b,
                        _EVENT_INCLUDE, _EVENT_EXCLUDE, sql_text=sql_b or None)
                    if not (passes_a or passes_b):
                        continue
                deadlock_list.append(deadlock_record)
                if args.debug:
                    print(f"[DEBUG] 成功加入死锁记录，ts={timestamp_str}, process_a={process_a}, process_b={process_b}")

    if args.debug:
        print(f"[DEBUG] 统一解析死锁候选完成，最终死锁记录数: {len(deadlock_list)}")

    show_progress(total_blocks, total_blocks, "解析事件", start_time, total_elapsed_time)

    # 内存优化收尾:把每类(按归一化消息聚合)首尾 2 条记录的 context/full_log 填回 error_list
