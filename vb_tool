# ---- global -P <port>: multi-instance support (all database commands) ------
# Resolved ONCE here (before dispatch) and exported as PGPORT for this process
# only: every child psql/vsql connection inherits it; nothing persists after
# the run. Without -P the current $PGPORT environment variable applies
# (libpq's built-in 5432 is reached only when PGPORT is unset).
# NOTE: keep this block OUTSIDE the awr region (above its header): the awr
# build/merge chain replaces [awr header .. column-0 'case "$1" in'] verbatim.
_vb_port_args=()
while [ $# -gt 0 ]; do
    case "$1" in
        -P)
            if [ $# -lt 2 ] || ! printf '%s' "${2:-}" | grep -qE '^[0-9]+$' || [ "${2:-}" -lt 1 ] || [ "${2:-}" -gt 65535 ]; then
                echo "Error: -P expects a port number (1-65535), e.g. -P 5433" >&2
                exit 2
            fi
            export PGPORT="$2"; shift 2;;
        -P[0-9]*)
            _vb_p="${1#-P}"
            if [ "$_vb_p" -lt 1 ] || [ "$_vb_p" -gt 65535 ]; then
                echo "Error: -P expects a port number (1-65535), e.g. -P 5433" >&2
                exit 2
            fi
            export PGPORT="$_vb_p"; shift
            unset _vb_p;;
        *)
            _vb_port_args+=("$1"); shift;;
    esac
done
set -- ${_vb_port_args[@]+"${_vb_port_args[@]}"}
unset _vb_port_args

# ================== awr management (v1) ==================
#
# Oracle-style single-point performance snapshots. Each `awr create` captures one
# instantaneous OS+DB sample (a "snap") tagged with a monotonic snap_id. A report
# (`awr awrrpt`) is the cumulative-counter delta between two snaps (end - begin),
# like an AWR single-period report. Periodic capture via `awr enable` (crontab).

awr_help() {
    cat <<'EOF'
Usage: vb_tool awr <create|enable|disable|awrrpt|awrdiff|list|show|delete|config> [options]

Single-point performance snapshots (Oracle AWR style). Each snapshot is an
instantaneous OS+DB sample assigned a monotonic snap_id. An AWR report is the
counter delta between two snapshots (end - begin).

  create                    capture ONE single-point snapshot now (foreground,
                            ~5-10s), assigns the next snap_id. No html.
  enable                    install crontab entries: snapshot every <interval>
                            MINUTES (see 'config interval', default 60) +
                            replication sampler every 1 minute; expired data
                            auto-purged after each capture
  disable                   remove both crontab entries (snapshot + sampler).
  awrrpt  begin <id> end <id>
                            render AWR html = snap<end_id> - snap<begin_id>;
                            written to ~/.vb_tool/awr_reports/awr_{db}_{begin}_{end}.html
  awrdiff begin <a> end <b> begin <c> end <d>
                            render AWR DIFF html (3-col: Period1 | Period2 | Δ);
                            period1 = snap a->b, period2 = snap c->d;
                            written to awrdiff_{db}_{p1_begin}_{p2_begin}.html
  list    [YYYY-MM-DD]     list stored snapshots (snap_id / ts / host / db),
                            newest first; default latest 30, a date lists
                            that whole day
  show                      awr overview: run status (crontab entries),
                            sampling interval, retention, oldest/newest
                            snapshot, snapshot count; while ENABLED also
                            last-snap age (ok / STALE liveness hint)
  delete  until <time>      delete snapshots (by ts), html reports (by mtime) and
                            old repl_*.log (by whole day) older than <time>;
                            e.g. '2026-08-11' or '2026-08-11 12:00:00'
  config  retention <days>  set retention in days (default 30; 0 = never purge).
                            Immediately purges already-expired snaps, repl/slot
                            logs and html reports.
  config  interval <min>    set sampling interval in minutes (default 60,
                            1-60, cron minute-field limit). If periodic capture
                            is enabled the crontab entry is rewritten at once.

Storage (per snapshot; <root> = $VB_TOOL_HOME/awrs/<port>, per instance):
  snapshot:   <root>/snap_<id>/{meta.json, os/<proc files>, db/<views>.csv}
  sequence:   <root>/sequence            (next snap_id to allocate)
  retention:  <root>/retention           (days to keep; default 30, 0 = forever)
  interval:   <root>/interval            (snapshot interval min; default 60)
  html:       ~/.vb_tool/awr_reports/awr_{db}_{begin}_{end}.html  (by compare_render.py)
  repl logs:  <root>/repl_<YYYYMMDD>.log  per-minute pg_stat_replication samples
              (ts,app,addr,state,sync,sent,write,flush,replay LSN; no standby -> ts,null)
  slot logs:  <root>/slot_<YYYYMMDD>.log  per-minute pg_replication_slots samples
              (ts,slot,plugin,type,db,active,xmin,cat_xmin,restart_lsn,dummy,conf_flush;
               no slot -> ts,null)

Env: VB_TOOL_HOME  base dir (default ~/.vb_tool); snaps under $VB_TOOL_HOME/awrs/<port>/snap_<id>/
Port:   -P <port> anywhere on the command line selects the instance (default: current $PGPORT)
Multi-instance: storage, config and crontab entries are all PER PORT -- each
        instance gets its own snap_id sequence / retention / interval / repl
        logs and its own crontab pair (port pinned via PGPORT= in the entry),
        so several instances can be enabled side by side; enable/disable/show/
        list/config always operate on the current port only.

Requirements: dbe_perf + gs_instance_time (same as `workload`). Not on PG-only
kernels lacking dbe_perf (e.g. E100/v0).
EOF
}

# _awr_root  -- per-PORT storage root: <VB_TOOL_HOME>/awrs/<port>/. Every awr
# subcommand (create/list/show/reports/purge/config) operates on the instance
# the CURRENT port points at (from $PGPORT, or -P which exports it), so several
# instances can run awr side by side without sharing snap_ids, config or logs.
# Migrates the pre-multi-instance flat layout once, under a lock.
_awr_root() {
    local base="${VB_TOOL_HOME:-$HOME/.vb_tool}/awrs"
    local port="${PGPORT:-5432}"
    local root="$base/$port"
    if [ -d "$base" ] && [ ! -d "$root" ] && ls "$base"/snap_* >/dev/null 2>&1; then
        (
            flock -n 9 || exit 0
            [ ! -d "$root" ] && ls "$base"/snap_* >/dev/null 2>&1 || exit 0
            mkdir -p "$root"
            mv "$base"/snap_* "$base"/sequence "$base"/retention "$base"/interval \
               "$base"/repl_*.log "$base"/slot_*.log "$root"/ 2>/dev/null
            echo "awr: migrated existing snapshots/config into per-port layout $root" >&2
        ) 9>"$base/.migrate.lock"
    fi
    echo "$root"
}

# _awr_next_id  -- atomically allocate and return the next snap_id.
# Maintains <root>/sequence (= next id). Concurrent-safe via flock (util-linux).
_awr_next_id() {
    local root; root=$(_awr_root)
    mkdir -p "$root" 2>/dev/null || { echo "Error: cannot create $root" >&2; return 1; }
    local seq="$root/sequence"
    local cur
    cur=$(
        flock 9
        v=$(cat "$seq" 2>/dev/null)
        case "$v" in ''|*[!0-9]*) v=1;; esac
        echo $((v + 1)) > "$seq"
        echo "$v"
    ) 9>"$seq.lock"
    [ -z "$cur" ] && { echo "Error: snap_id allocation failed" >&2; return 1; }
    echo "$cur"
}

# _awr_collect <target_dir>  -- single-point snapshot into target/{os,db}.
# (Renamed from _awr_collect_window <target> <phase>; phase dropped: files live
#  directly under os/ and db/, no begin/end subdir.)
_awr_collect() {
    local target="$1"
    local osd="$target/os" dbd="$target/db"
    mkdir -p "$osd" "$dbd" || { echo "  [ERROR] cannot mkdir $osd / $dbd" >&2; return 1; }
    # ---- OS (/proc) ----
    local f
    for f in diskstats stat interrupts softirqs meminfo cpuinfo; do
        if [ -r "/proc/$f" ]; then cp "/proc/$f" "$osd/$f" 2>/dev/null
        else echo "  [WARN] /proc/$f not readable" >&2; fi
    done
    if [ -r /proc/net/dev ]; then cp /proc/net/dev "$osd/net_dev" 2>/dev/null
    else echo "  [WARN] /proc/net/dev not readable" >&2; fi
    if [ -r /proc/net/snmp ]; then cp /proc/net/snmp "$osd/net_snmp" 2>/dev/null; fi
    if [ -r /proc/net/netstat ]; then cp /proc/net/netstat "$osd/net_netstat" 2>/dev/null; fi
    # ---- NUMA topology + numastat (per-node cumulative counters; renderer computes end-begin) ----
    # File format (one stanza per node, blank-line separated):
    #   node <id>
    #   cpulist <0-15>
    #   MemTotal:       <kB> / MemFree:        <kB>   (from node meminfo, node prefix stripped)
    #   distance <row>
    #   stat <name> <value>   (numa_hit numa_miss numa_foreign interleave_hit local_node other_node)
    {
        _nd=/sys/devices/system/node
        if [ -d "$_nd" ]; then
            for _n in $(ls "$_nd" 2>/dev/null | grep '^node[0-9]*$' | sort -V); do
                echo "node ${_n#node}"
                [ -r "$_nd/$_n/cpulist" ] && echo "cpulist $(cat "$_nd/$_n/cpulist")"
                [ -r "$_nd/$_n/meminfo" ] && grep -E 'MemTotal|MemFree' "$_nd/$_n/meminfo" | sed 's/^Node [0-9]* //'
                [ -r "$_nd/$_n/distance" ] && echo "distance $(cat "$_nd/$_n/distance")"
                [ -r "$_nd/$_n/numastat" ] && sed 's/^/stat /' "$_nd/$_n/numastat"
                echo ""
            done
        fi
    } > "$osd/numa" 2>/dev/null
    [ -s "$osd/numa" ] || echo "  [WARN] NUMA info unavailable (no /sys/devices/system/node or empty)" >&2
    # ---- block-device / NIC / DMI identity (END-snap state; renderer joins by name) ----
    # blockdev_meta: run_lsds --raw TSV (name|size|type|sched|rot|qdepth|nr_rq|wcache|model|vendor)
    run_lsds --raw > "$osd/blockdev_meta" 2>/dev/null || rm -f "$osd/blockdev_meta"
    # netdev_meta: iface|speed|duplex|nrxq|ntxq|rx_max|rx_cur|tx_max|tx_cur  ('-' = unavailable)
    {
        for _if in $(ls /sys/class/net 2>/dev/null | grep -vE '^(lo|vir)'); do
            _p="/sys/class/net/$_if"
            [ -d "$_p" ] || continue
            _sp=$(cat "$_p/speed"  2>/dev/null) || _sp=-
            _dp=$(cat "$_p/duplex" 2>/dev/null) || _dp=-
            _nrx=$(ls -d "$_p/queues/rx-"* 2>/dev/null | wc -l)
            _ntx=$(ls -d "$_p/queues/tx-"* 2>/dev/null | wc -l)
            _rmax=-; _rcur=-; _tmax=-; _tcur=-
            if command -v ethtool >/dev/null 2>&1; then
                _ring=$(ethtool -g "$_if" 2>/dev/null | awk '
                    /Pre-set maximums:/         {sec="max"; next}
                    /Current hardware settings:/{sec="cur"; next}
                    sec=="max" && /^RX:/ {rmax=$2}
                    sec=="max" && /^TX:/ {tmax=$2}
                    sec=="cur" && /^RX:/ {rcur=$2}
                    sec=="cur" && /^TX:/ {tcur=$2}
                    END { printf "%s|%s|%s|%s",
                          (rmax==""?"-":rmax), (rcur==""?"-":rcur),
                          (tmax==""?"-":tmax), (tcur==""?"-":tcur) }')
                IFS='|' read -r _rmax _rcur _tmax _tcur <<< "$_ring"
            fi
            echo "$_if|$_sp|$_dp|$_nrx|$_ntx|$_rmax|$_rcur|$_tmax|$_tcur"
        done
    } > "$osd/netdev_meta" 2>/dev/null
    # dmi: vendor/product lines (world-readable; absent on some ARM/containers -> empty file)
    {
        [ -r /sys/class/dmi/id/sys_vendor ]   && echo "vendor $(cat /sys/class/dmi/id/sys_vendor)"
        [ -r /sys/class/dmi/id/product_name ] && echo "product $(cat /sys/class/dmi/id/product_name)"
    } > "$osd/dmi" 2>/dev/null
    # ---- DB reachability probe + bounded timeouts ----
    # One cheap probe before ~30 psql invocations below (heredoc + per-db object
    # loops + meta queries): if the DB is unreachable, fail fast ONCE instead of
    # hanging through every invocation (kernel SYN retries ~127s each when the
    # network blackholes). Timeouts are passed as PER-COMMAND env prefixes
    # (session-level, only that psql process sees them) -- never exported into
    # the script's global environment.
    local _ct=15 _st="-c statement_timeout=60000"
    if ! PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAc "select 1" >/dev/null 2>&1; then
        echo "  [ERROR] cannot reach the database (connect probe failed, skipped DB collection)" >&2
        return 1
    fi
    # ---- DB: \copy views to CSV with header (column order stable per view) ----
    # unquoted heredoc so $dbd expands; no other $ in the SQL. psql continues
    # past a missing view (no ON_ERROR_STOP) -> we warn about empty CSVs below.
    PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres 2>&1 <<PSQL | grep -v '^$' >&2 || true
\copy (SELECT * FROM dbe_perf.statement)                TO '$dbd/statement.csv'     WITH CSV HEADER
\copy (SELECT * FROM dbe_perf.wait_events)              TO '$dbd/wait_events.csv'   WITH CSV HEADER
\copy (SELECT * FROM gs_instance_time)                  TO '$dbd/instance_time.csv' WITH CSV HEADER
\copy (SELECT * FROM pg_stat_database)                  TO '$dbd/database.csv'      WITH CSV HEADER
\copy (SELECT * FROM dbe_perf.global_pagewriter_status) TO '$dbd/pagewriter.csv'    WITH CSV HEADER
\copy (SELECT memorytype, sum(memorymbytes) AS mb FROM dbe_perf.memory_node_detail WHERE memorymbytes>0 GROUP BY memorytype) TO '$dbd/memory_node_detail.csv' WITH CSV HEADER
\copy (SELECT contextname, count(*) AS cnt, sum(totalsize) AS total FROM gs_shared_memory_detail GROUP BY contextname) TO '$dbd/shared_memory.csv' WITH CSV HEADER
\copy (SELECT contextname, count(*) AS cnt, sum(totalsize) AS total FROM gs_session_memory_detail GROUP BY contextname) TO '$dbd/session_memory.csv' WITH CSV HEADER
\copy (SELECT sessid, sum(totalsize) AS total FROM gs_session_memory_detail GROUP BY sessid) TO '$dbd/session_by_sess.csv' WITH CSV HEADER
\copy (SELECT name,setting,unit,context,short_desc FROM pg_settings ORDER BY name) TO '$dbd/pg_settings.csv' WITH CSV HEADER
\copy (SELECT application_name, client_addr, state, sync_state, sender_sent_location, receiver_write_location, receiver_flush_location, receiver_replay_location FROM pg_stat_replication ORDER BY application_name) TO '$dbd/replication.csv' WITH CSV HEADER
\copy (SELECT slot_name, plugin, slot_type, database, active, xmin, catalog_xmin, restart_lsn, dummy_standby, confirmed_flush FROM pg_replication_slots ORDER BY slot_name) TO '$dbd/replication_slots.csv' WITH CSV HEADER
PSQL
    local t
    for t in statement wait_events instance_time database pagewriter memory_node_detail shared_memory session_memory session_by_sess pg_settings; do
        [ -s "$dbd/$t.csv" ] || echo "  [WARN] db/$t.csv missing/empty (view unavailable or DB error)" >&2
    done
    # ---- replication single-point: normalize empty states ----
    # \copy ok + 0 rows      -> header-only csv  -> append literal "null" row (no standby)
    # view missing/DB error  -> no csv at all    -> write header + "error" row + WARN
    if [ ! -f "$dbd/replication.csv" ]; then
        echo "  [WARN] db/replication.csv not created (view unavailable or DB error)" >&2
        echo "application_name,client_addr,state,sync_state,sender_sent_location,receiver_write_location,receiver_flush_location,receiver_replay_location" > "$dbd/replication.csv"
        echo "error" >> "$dbd/replication.csv"
    elif [ "$(wc -l < "$dbd/replication.csv")" -le 1 ]; then
        echo "null" >> "$dbd/replication.csv"
    fi
    # ---- replication slots single-point: same normalization, its own file ----
    if [ ! -f "$dbd/replication_slots.csv" ]; then
        echo "  [WARN] db/replication_slots.csv not created (view unavailable or DB error)" >&2
        echo "slot_name,plugin,slot_type,database,active,xmin,catalog_xmin,restart_lsn,dummy_standby,confirmed_flush" > "$dbd/replication_slots.csv"
        echo "error" >> "$dbd/replication_slots.csv"
    elif [ "$(wc -l < "$dbd/replication_slots.csv")" -le 1 ]; then
        echo "null" >> "$dbd/replication_slots.csv"
    fi
    # ---- object stats across all databases (cumulative counters; renderer computes end-begin) ----
    local _odbs _odb
    _odbs=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAc "select datname from pg_database where datallowconn and not datistemplate order by 1" 2>/dev/null)
    { echo "dbname,schema,object,seq_scan,seq_tup_read,idx_scan,idx_tup_fetch,n_tup_ins,n_tup_upd,n_tup_del,n_tup_hot_upd,n_live_tup,n_dead_tup"
      for _odb in $_odbs; do
          psql -d "$_odb" -tAF',' -c "select '$_odb',schemaname,relname,coalesce(seq_scan,0),coalesce(seq_tup_read,0),coalesce(idx_scan,0),coalesce(idx_tup_fetch,0),coalesce(n_tup_ins,0),coalesce(n_tup_upd,0),coalesce(n_tup_del,0),coalesce(n_tup_hot_upd,0),coalesce(n_live_tup,0),coalesce(n_dead_tup,0) from pg_stat_user_tables" 2>/dev/null
      done; } > "$dbd/object_tables.csv"
    { echo "dbname,schema,object,index,idx_scan,idx_tup_read,idx_tup_fetch"
      for _odb in $_odbs; do
          psql -d "$_odb" -tAF',' -c "select '$_odb',schemaname,relname,indexrelname,coalesce(idx_scan,0),coalesce(idx_tup_read,0),coalesce(idx_tup_fetch,0) from pg_stat_user_indexes" 2>/dev/null
      done; } > "$dbd/object_indexes.csv"
    { echo "dbname,schema,object,table_age,relpages,reltuples,n_dml_tup,n_live_tup,n_dead_tup"
      for _odb in $_odbs; do
          psql -d "$_odb" -tAF',' -c "select '$_odb',n.nspname,c.relname,age(c.relfrozenxid64),c.relpages,c.reltuples,coalesce(pg_stat_get_tuples_changed(c.oid),0),coalesce(pg_stat_get_live_tuples(c.oid),0),coalesce(pg_stat_get_dead_tuples(c.oid),0) from pg_class c left join pg_namespace n on n.oid=c.relnamespace where c.relkind in ('r','t','m')" 2>/dev/null
      done; } > "$dbd/object_dead.csv"
    return 0
}

# _awr_write_meta <dir> <snap_id> <ts> <ts_epoch>
# Single-point meta: no begin/end/duration (those are synthesized at awrrpt time).
_awr_write_meta() {
    local dir="$1" sid="$2" ts="$3" ts_ep="$4"
    local m_host m_dbver m_dbname m_start
    local _ct=15 _st="-c statement_timeout=60000"
    m_host=$(hostname 2>/dev/null | tr -d '"\r\n')
    m_dbver=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAq -c "select vb_version();" 2>/dev/null | head -1 | tr -d '"\r\n')
    [ -z "$m_dbver" ] && m_dbver=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAq -c "select version();" 2>/dev/null | head -1 | tr -d '"\r\n')
    m_dbname=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAq -c "select node_name from pg_node_env limit 1;" 2>/dev/null | head -1 | tr -d '"\r\n')
    [ -z "$m_dbname" ] && m_dbname=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAq -c "show pgxc_node_name;" 2>/dev/null | head -1 | tr -d '"\r\n')
    # postmaster start time: stable per DB uptime, changes on restart. Used by
    # awrrpt to refuse a diff that spans a restart (cumulative counters reset).
    m_start=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAq -c "select pg_postmaster_start_time();" 2>/dev/null | tr -d '"\r\n')
    [ -z "$m_host" ]  && m_host="?"
    [ -z "$m_dbver" ] && m_dbver="unavailable"
    [ -z "$m_dbname" ] && m_dbname="?"
    python3 -c "
import json, sys, os
def _int(v):
    v = str(v).strip()
    return int(v) if v.isdigit() else v
print(json.dumps({
  'snap_id': _int(sys.argv[1]),
  'ts': sys.argv[2],
  'ts_epoch': _int(sys.argv[3]),
  'hostname': sys.argv[4],
  'db_name': sys.argv[5],
  'db_version': sys.argv[6],
  'db_start_time': sys.argv[7],
  'vb_tool_version': sys.argv[8],
  'port': _int(os.environ.get('PGPORT') or 5432),
}, indent=2, ensure_ascii=False))
" "$sid" "$ts" "$ts_ep" "$m_host" "$m_dbname" "$m_dbver" "$m_start" "${VB_TOOL_VERSION:-unknown}" > "$dir/meta.json"
}

# _awr_render <args...> -- write the python renderer to a temp file and run it.
# python body is the verbatim compare_render.py; quoted heredoc => no shell expansion.
_awr_render() {
    local tmp; tmp=$(mktemp /tmp/vb_tool_awr_render.XXXXXX.py) 2>/dev/null
    if [ -z "$tmp" ]; then echo "  [ERROR] mktemp failed" >&2; return 1; fi
    cat > "$tmp" <<'VB_BL_COMPARE_PY'
#!/usr/bin/env python3
"""awr compare renderer.

Reads two window directories (awr + current), each with the layout:
  <dir>/{meta.json, os/{begin,end}/{stat,net_dev,diskstats,interrupts,softirqs},
                         db/{begin,end}/{statement,wait_events,instance_time,database,pagewriter}.csv}

Cumulative-counter model:
  window_delta(metric) = end_value - begin_value
  diff(metric)         = current_delta - awr_delta

Emits a self-contained HTML report. Standalone here; embedded as a heredoc in
vb_tool_dev (so keep it dependency-free stdlib only, single file, no argv trickery).
"""
import csv, json, os, sys, html, subprocess, glob, re

# -----------------------------------------------------------------------------
# number formatting
# -----------------------------------------------------------------------------
def to_num(v):
    if v is None:
        return 0.0
    if isinstance(v, (int, float)):
        return float(v)
    s = str(v).strip()
    if not s:
        return 0.0
    try:
        return float(s)
    except ValueError:
        # hex LSN etc. -> 0 for arithmetic
        return 0.0

def fmt_us(v):
    """microseconds -> human."""
    v = to_num(v)
    a = abs(v)
    sign = "-" if v < 0 else ""
    if a >= 60_000_000:
        return "%s%.2f min" % (sign, a / 60_000_000)
    if a >= 1_000_000:
        return "%s%.2f s" % (sign, a / 1_000_000)
    if a >= 1_000:
        return "%s%.2f ms" % (sign, a / 1_000)
    return "%s%.0f μs" % (sign, a)

def fmt_num(v):
    v = to_num(v)
    if abs(v) >= 1_000_000_000:
        return "%.2fB" % (v / 1_000_000_000)
    if abs(v) >= 1_000_000:
        return "%.2fM" % (v / 1_000_000)
    if abs(v) >= 1_000:
        return "%.2fK" % (v / 1_000)
    return "%.0f" % v

def fmt_int(v):
    return "{:,.0f}".format(to_num(v))

def fmt_pct(v):
    v = to_num(v)
    return "%.2f%%" % v

def fmt_bytes(v):
    v = to_num(v)
    a = abs(v)
    sign = "-" if v < 0 else ""
    if a >= 1024**3:
        return "%s%.2f GB" % (sign, a / 1024**3)
    if a >= 1024**2:
        return "%s%.2f MB" % (sign, a / 1024**2)
    if a >= 1024:
        return "%s%.2f KB" % (sign, a / 1024)
    return "%s%.0f B" % (sign, a)

def fmt_kb(v):
    """kilobytes (sysfs node meminfo unit) -> human MB/GB"""
    return fmt_bytes(to_num(v) * 1024)

def pct_change(base, cur):
    base = to_num(base); cur = to_num(cur)
    if base == 0:
        return None  # caller decides (NEW / ∞)
    return (cur - base) / base * 100.0

def arrow_delta(base, cur):
    """Δ string like '+18.00 s (10.00x)' for display."""
    base = to_num(base); cur = to_num(cur)
    d = cur - base
    parts = []
    parts.append(("%+s" % fmt_us(d)) if abs(d) >= 1000 else "%+.0f μs" % d)
    if base > 0 and cur > 0:
        parts.append("(%.2fx)" % (cur / base))
    elif base == 0 and cur > 0:
        parts.append("(new)")
    elif cur == 0 and base > 0:
        parts.append("(gone)")
    return " ".join(parts)

# -----------------------------------------------------------------------------
# IO helpers
# -----------------------------------------------------------------------------
def read_csv_rows(path):
    if not os.path.isfile(path):
        return []
    try:
        with open(path, newline="") as f:
            return list(csv.DictReader(f))
    except (csv.Error, UnicodeDecodeError, OSError):
        return []

def fetch_pg_settings():
    """Live-query pg_settings via psql (point-in-time config; not persisted to disk).
    Returns list of dicts; empty if psql/DB unavailable (offline render)."""
    try:
        out = subprocess.check_output(
            ["psql", "-d", "postgres", "-AtF", "\t", "-c",
             "SELECT name,setting,unit,context,short_desc FROM pg_settings ORDER BY name"],
            stderr=subprocess.DEVNULL, timeout=30).decode("utf-8", "replace")
    except Exception:
        return []
    rows = []
    for line in out.splitlines():
        f = line.split("\t")
        if len(f) >= 5:
            rows.append({"name": f[0], "setting": f[1], "unit": f[2],
                         "context": f[3], "short_desc": "\t".join(f[4:])})
    return rows

def psql_query(sql, dbname="postgres"):
    """Run SQL via psql (unaligned, tab-separated, header kept, footer off).
    Returns list of dict rows; empty on error/offline. dbname selects the database."""
    try:
        out = subprocess.check_output(
            ["psql", "-d", dbname, "-A", "-F", "\t", "-P", "footer=off", "-c", sql],
            stderr=subprocess.DEVNULL, timeout=60).decode("utf-8", "replace")
    except Exception:
        return []
    try:
        return list(csv.DictReader(out.splitlines(), delimiter="\t"))
    except Exception:
        return []

def list_databases():
    """Connectable, non-template user databases."""
    return [r["datname"] for r in psql_query(
        "SELECT datname FROM pg_database WHERE datallowconn AND NOT datistemplate ORDER BY 1")
        if r.get("datname")]

def psql_show(guc):
    """Run `show <guc>` via psql, return trimmed value. Empty on error."""
    try:
        return subprocess.check_output(
            ["psql", "-d", "postgres", "-AtF", "\t", "-c", "show " + guc],
            stderr=subprocess.DEVNULL, timeout=15).decode("utf-8", "replace").strip()
    except Exception:
        return ""

def fetch_meminfo():
    """Parse /proc/meminfo into {field: kB_int}. Empty if unavailable."""
    fields = {}
    try:
        for line in open("/proc/meminfo"):
            if ":" not in line:
                continue
            k, v = line.split(":", 1)
            v = v.strip().split()[0]
            fields[k.strip()] = int(v) if v.isdigit() else 0
    except Exception:
        pass
    return fields

def parse_meminfo(txt):
    """Parse /proc/meminfo text into {field: kB_int}."""
    fields = {}
    for line in (txt or "").splitlines():
        if ":" not in line:
            continue
        k, v = line.split(":", 1)
        v = v.strip().split()[0] if v.strip() else ""
        fields[k.strip()] = int(v) if v.isdigit() else 0
    return fields

def normalize_sql(q):
    """Collapse redundant whitespace for compact display: drop blank lines,
    collapse runs of spaces/tabs to one space, trim each line. Keeps newlines."""
    if not q:
        return q
    out = []
    for line in q.splitlines():
        line = " ".join(line.split())
        if line:
            out.append(line)
    return "\n".join(out)

def load_window(d):
    w = {"meta": {}, "os": {}, "db": {}}
    mp = os.path.join(d, "meta.json")
    if os.path.isfile(mp):
        try:
            w["meta"] = json.load(open(mp))
        except Exception:
            w["meta"] = {}
    for phase in ("begin", "end"):
        for f in ("stat", "net_dev", "net_snmp", "net_netstat", "diskstats", "interrupts", "softirqs", "vmstat", "loadavg", "meminfo", "cpuinfo", "numa", "blockdev_meta", "netdev_meta", "dmi"):
            p = os.path.join(d, "os", phase, f)
            w["os"][(phase, f)] = open(p).read() if os.path.isfile(p) else ""
        for t in ("statement", "wait_events", "instance_time", "database", "pagewriter",
                  "memory_node_detail", "shared_memory", "session_memory", "session_by_sess",
                  "object_tables", "object_indexes", "object_dead"):
            w["db"][(phase, t)] = read_csv_rows(os.path.join(d, "db", phase, t + ".csv"))
    return w

def load_snap(d):
    """Load a single-point snapshot dir (snap_<id>/) -> {meta, os:{file:txt}, db:{table:rows}}.
    Single-phase layout: files live directly under os/ and db/ (no begin/end subdir).
    Tolerant: missing os files -> "", missing db csv -> []."""
    s = {"meta": {}, "os": {}, "db": {}}
    mp = os.path.join(d, "meta.json")
    if os.path.isfile(mp):
        try:
            s["meta"] = json.load(open(mp))
        except Exception:
            s["meta"] = {}
    for f in ("stat", "net_dev", "net_snmp", "net_netstat", "diskstats", "interrupts", "softirqs", "vmstat", "loadavg", "meminfo", "cpuinfo", "numa", "blockdev_meta", "netdev_meta", "dmi"):
        p = os.path.join(d, "os", f)
        s["os"][f] = open(p).read() if os.path.isfile(p) else ""
    for t in ("statement", "wait_events", "instance_time", "database", "pagewriter",
              "memory_node_detail", "shared_memory", "session_memory", "session_by_sess",
              "pg_settings",
              "object_tables", "object_indexes", "object_dead"):
        s["db"][t] = read_csv_rows(os.path.join(d, "db", t + ".csv"))
    return s

def build_window_from_snaps(begin_dir, end_dir):
    """Compose a load_window-shaped `win` from two single-point snapshots.
    win["os"/"db"] keyed by (phase, name); meta synthesized for the awrrpt header
    (hostname/db_name/db_version from END snap; begin_ts/end_ts/duration from the pair)."""
    b = load_snap(begin_dir)
    e = load_snap(end_dir)
    win = {"meta": {}, "os": {}, "db": {}}
    for f in ("stat", "net_dev", "net_snmp", "net_netstat", "diskstats", "interrupts", "softirqs", "vmstat", "loadavg", "meminfo", "cpuinfo", "numa", "blockdev_meta", "netdev_meta", "dmi"):
        win["os"][("begin", f)] = b["os"].get(f, "")
        win["os"][("end", f)] = e["os"].get(f, "")
    for t in ("statement", "wait_events", "instance_time", "database", "pagewriter",
              "memory_node_detail", "shared_memory", "session_memory", "session_by_sess",
              "pg_settings",
              "object_tables", "object_indexes", "object_dead"):
        win["db"][("begin", t)] = b["db"].get(t, [])
        win["db"][("end", t)] = e["db"].get(t, [])
    bm, em = b["meta"], e["meta"]
    bx = str(bm.get("snap_id", "?"))
    ex = str(em.get("snap_id", "?"))
    begin_ep = to_num(bm.get("ts_epoch"))
    end_ep = to_num(em.get("ts_epoch"))
    duration = int(end_ep - begin_ep) if (begin_ep and end_ep and end_ep >= begin_ep) else 0
    win["meta"] = {
        "name": "awrrpt_%s_%s" % (bx, ex),
        "hostname": em.get("hostname", "?"),
        "db_name": em.get("db_name", "?"),
        "db_version": em.get("db_version", "?"),
        "vb_tool_version": em.get("vb_tool_version", "?"),
        "begin_ts": bm.get("ts", ""),
        "end_ts": em.get("ts", ""),
        "duration": duration,
    }
    return win

# ================= Replication sampler (awrrpt only) =================
# repl_<YYYYMMDD>.log row grammar (written by _awr_repl_sample in bash):
#   data : ts,application_name,client_addr,state,sync_state,sent,write,flush,replay LSN
#   null : ts,null          (pg_stat_replication returned 0 rows = no standby)
#   error: ts,error         (psql failed; sampler stays alive)

def _lsn64(s):
    """'X/YYYYYYYY' hex LSN -> full 64-bit int, or None if unparseable."""
    try:
        hi, lo = str(s).strip().split("/")
        return (int(hi, 16) << 32) | int(lo, 16)
    except Exception:
        return None

def load_repl_samples(repl_dir, begin_ts, end_ts):
    """Read repl_<YYYYMMDD>.log samples with ts in [begin_ts, end_ts] (inclusive).
    ts format '%F %T' is zero-padded => lexicographic compare == chronological.
    Files are pre-filtered by their YYYYMMDD name; rows re-filtered by ts.
    Returns {"rows":[(ts, kind, fields)], "n_data":N, "n_null":N, "n_error":N, "files":[names]}."""
    out = {"rows": [], "n_data": 0, "n_null": 0, "n_error": 0, "files": []}
    if not repl_dir or not os.path.isdir(repl_dir):
        return out
    bd = str(begin_ts or "")[:10].replace("-", "")
    ed = str(end_ts or "")[:10].replace("-", "")
    for f in sorted(glob.glob(os.path.join(repl_dir, "repl_*.log"))):
        m = re.search(r"repl_(\d{8})\.log$", f)
        if m:
            fd = m.group(1)
            if bd and fd < bd: continue
            if ed and fd > ed: continue
        try:
            lines = open(f).read().splitlines()
        except Exception:
            continue
        out["files"].append(os.path.basename(f))
        for ln in lines:
            ln = ln.strip()
            if not ln: continue
            ts, rest = (ln.split(",", 1) + [""])[:2]
            if begin_ts and ts < str(begin_ts): continue
            if end_ts and ts > str(end_ts): continue
            if rest == "null":
                out["rows"].append((ts, "null", [])); out["n_null"] += 1
            elif rest == "error":
                out["rows"].append((ts, "error", [])); out["n_error"] += 1
            elif ln.count(",") == 8:
                # strict 9-field data row; a row with any other comma count
                # (e.g. application_name containing a comma) is silently dropped.
                out["rows"].append((ts, "data", ln.split(",")[1:])); out["n_data"] += 1
    return out

def replication_section_html(repl):
    """Replication section body html (self-contained; caller emits the sec() title).
    `repl` = load_repl_samples() result. Shows the last-seen state per standby."""
    parts = []
    if not repl["files"]:
        return '<div class="note">no replication samples in this period</div>'
    last = {}
    for ts, kind, f in repl["rows"]:
        if kind == "data":
            last[f[0]] = (ts, f)          # rows are in ts order; later overwrite = last seen
    if not last:
        parts.append('<div class="note">no standby connected at any sample in this period</div>')
    else:
        parts.append('<table class="t"><tr><th>Standby</th><th>Client Addr</th>'
                     '<th>State</th><th>Sync</th><th>Sent LSN</th><th>Write LSN</th><th>Flush LSN</th>'
                     '<th>Replay LSN</th><th>Net lag</th><th>Fsync lag</th><th>Apply lag</th>'
                     '<th>Total lag</th><th>Last seen</th></tr>')
        for name in sorted(last):
            ts, f = last[name]
            sent, write, flush, replay = f[4], f[5], f[6], f[7]
            L = [_lsn64(x) for x in (sent, write, flush, replay)]
            def _seg(i, j):   # bytes between pipeline stages; n/a if either LSN unparseable
                a, b = L[i], L[j]
                return fmt_bytes(a - b) if (a is not None and b is not None and a >= b) else "n/a"
            parts.append('<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td>'
                         '<td>%s</td><td>%s</td><td>%s</td><td>%s</td>'
                         '<td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td><td class="n">%s</td><td>%s</td></tr>'
                         % (esc(name), esc(f[1]), esc(f[2]), esc(f[3]),
                            esc(sent), esc(write), esc(flush), esc(replay),
                            _seg(0, 1), _seg(1, 2), _seg(2, 3), _seg(0, 3), esc(ts)))
        parts.append('</table>')
        parts.append('<div class="note">lag = LSN byte distance: '
                     'Net = sent&minus;write, Fsync = write&minus;flush, '
                     'Apply = flush&minus;replay, Total = sent&minus;replay.</div>')
    return "".join(parts)

# ---- Replication slots sampler (awrrpt only; mirrors the repl stat sampler) ----
# slot_<YYYYMMDD>.log row grammar (written by _awr_repl_sample in bash):
#   data : ts,slot_name,plugin,slot_type,database,active,xmin,catalog_xmin,
#          restart_lsn,dummy_standby,confirmed_flush   (10 commas)
#   null : ts,null   (pg_replication_slots = 0 rows = no slot)
#   error: ts,error  (psql failed)

def load_slot_samples(repl_dir, begin_ts, end_ts):
    """Read slot_<YYYYMMDD>.log samples with ts in [begin_ts, end_ts] (inclusive).
    Same pre-filter + row-filter discipline as load_repl_samples().
    Returns {"rows":[(ts, kind, fields)], "n_data":N, "n_null":N, "n_error":N, "files":[names]}."""
    out = {"rows": [], "n_data": 0, "n_null": 0, "n_error": 0, "files": []}
    if not repl_dir or not os.path.isdir(repl_dir):
        return out
    bd = str(begin_ts or "")[:10].replace("-", "")
    ed = str(end_ts or "")[:10].replace("-", "")
    for f in sorted(glob.glob(os.path.join(repl_dir, "slot_*.log"))):
        m = re.search(r"slot_(\d{8})\.log$", f)
        if m:
            fd = m.group(1)
            if bd and fd < bd: continue
            if ed and fd > ed: continue
        try:
            lines = open(f).read().splitlines()
        except Exception:
            continue
        out["files"].append(os.path.basename(f))
        for ln in lines:
            ln = ln.strip()
            if not ln: continue
            ts, rest = (ln.split(",", 1) + [""])[:2]
            if begin_ts and ts < str(begin_ts): continue
            if end_ts and ts > str(end_ts): continue
            if rest == "null":
                out["rows"].append((ts, "null", [])); out["n_null"] += 1
            elif rest == "error":
                out["rows"].append((ts, "error", [])); out["n_error"] += 1
            elif ln.count(",") == 10:
                # strict 11-field data row; any other comma count (e.g. a
                # slot_name containing a comma) is silently dropped.
                out["rows"].append((ts, "data", ln.split(",")[1:])); out["n_data"] += 1
    return out

def slots_subtable_html(slots):
    """Replication Slots sub-table body html, rendered inside the Replication
    section (after the standby stat table). `slots` = load_slot_samples() result.
    Shows the last-seen state per slot, with its sample timestamp."""
    if not slots["files"]:
        return '<div class="note">no slot samples in this period</div>'
    last = {}
    for ts, kind, f in slots["rows"]:
        if kind == "data":
            last[f[0]] = (ts, f)          # rows are in ts order; later overwrite = last seen
    if not last:
        return ('<div class="note">no replication slots at any sample in this period '
                '(%d samples: %d null, %d error)</div>'
                % (len(slots["rows"]), slots["n_null"], slots["n_error"]))
    parts = ['<table class="t"><tr><th>Slot</th><th>Type</th><th>Plugin</th><th>DB</th>'
             '<th>Active</th><th>Restart LSN</th><th>Xmin</th><th>Catalog Xmin</th>'
             '<th>Dummy Stby</th><th>Confirmed Flush</th><th>Last seen</th></tr>']
    for name in sorted(last):
        ts, f = last[name]
        parts.append('<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td>'
                     '<td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td>'
                     '<td>%s</td></tr>'
                     % (esc(f[0]), esc(f[2]), esc(f[1]), esc(f[3]), esc(f[4]),
                        esc(f[7]), esc(f[5]), esc(f[6]), esc(f[8]), esc(f[9]), esc(ts)))
    parts.append('</table>')
    return "".join(parts)

def delta_rows(win, table, key, num_cols):
    """For one table in one window: dict keyed by `key` -> {col: end-begin delta for num_cols, '__row': label row}.
    Rows sharing the same key (e.g. same unique_sql_id across multiple users) are summed per phase
    before differencing, so multi-user counters are not silently lost."""
    def _agg(rows):
        buckets = {}
        for r in rows:
            k = r.get(key, "")
            if k == "":
                continue
            if k not in buckets:
                buckets[k] = {"__row": r}
                for c in num_cols:
                    buckets[k][c] = 0.0
            for c in num_cols:
                buckets[k][c] += to_num(r.get(c, 0))
        return buckets
    begin = _agg(win["db"][("begin", table)])
    end = _agg(win["db"][("end", table)])
    out = {}
    for k in set(begin) | set(end):
        b = begin.get(k, {})
        e = end.get(k, {})
        d = {}
        for c in num_cols:
            d[c] = e.get(c, 0.0) - b.get(c, 0.0)
        d["__row"] = (e.get("__row") if e else b.get("__row")) or {}
        d["__present_begin"] = k in begin
        d["__present_end"] = k in end
        out[k] = d
    return out

# -----------------------------------------------------------------------------
# /proc parsing (window delta inside one window, then we diff the two windows)
# -----------------------------------------------------------------------------
def proc_cpu_full(txt):
    """Aggregate 'cpu ' jiffies: user/nice/system/idle/iowait/irq/softirq/steal/busy/total."""
    z = {"user":0.0,"nice":0.0,"system":0.0,"idle":0.0,"iowait":0.0,
         "irq":0.0,"softirq":0.0,"steal":0.0,"busy":0.0,"total":0.0}
    for line in (txt or "").splitlines():
        if line.startswith("cpu ") or line.rstrip() == "cpu":
            vals = [to_num(x) for x in line.split()[1:]]
            # user nice system idle iowait irq softirq steal guest guest_nice
            z["user"]    = vals[0] if len(vals) > 0 else 0.0
            z["nice"]    = vals[1] if len(vals) > 1 else 0.0
            z["system"]  = vals[2] if len(vals) > 2 else 0.0
            z["idle"]    = vals[3] if len(vals) > 3 else 0.0
            z["iowait"]  = vals[4] if len(vals) > 4 else 0.0
            z["irq"]     = vals[5] if len(vals) > 5 else 0.0
            z["softirq"] = vals[6] if len(vals) > 6 else 0.0
            z["steal"]   = vals[7] if len(vals) > 7 else 0.0
            z["busy"]    = z["user"]+z["nice"]+z["system"]+z["irq"]+z["softirq"]+z["steal"]
            z["total"]   = z["busy"] + z["idle"] + z["iowait"]
            return z
    return z

def parse_cpuinfo(txt):
    """CPU hardware info from /proc/cpuinfo (mirrors vb_tool workload _print_sysinfo):
    model / sockets / cores per socket / threads per core / logical CPUs + MHz summary.
    Sockets: distinct 'physical id' (VMs without it -> 1). Freq: per-cpu 'cpu MHz'
    min/max/avg. Returns {} when cpuinfo absent (older snaps) so callers degrade gracefully."""
    info = {"model": "", "sockets": 0, "cores_per_socket": 0, "total_cores": 0,
            "threads_per_core": 0, "logical_cpus": 0,
            "freq_min_mhz": 0.0, "freq_max_mhz": 0.0, "freq_avg_mhz": 0.0}
    phys_ids = set()
    freqs = []
    logical = 0
    for line in (txt or "").splitlines():
        f = line.split(":", 1)
        if len(f) != 2:
            continue
        k = f[0].strip(); v = f[1].strip()
        if k == "processor":
            logical += 1
        elif k == "model name" and not info["model"]:
            info["model"] = v
        elif k == "physical id":
            phys_ids.add(v)
        elif k == "cpu cores" and not info["cores_per_socket"]:
            try: info["cores_per_socket"] = int(v)
            except Exception: pass
        elif k == "cpu MHz":
            try: freqs.append(float(v))
            except Exception: pass
    if not logical:
        return {}
    info["logical_cpus"] = logical
    info["sockets"] = len(phys_ids) if phys_ids else 1
    if not info["cores_per_socket"]:
        info["cores_per_socket"] = logical // info["sockets"]
    info["total_cores"] = info["sockets"] * info["cores_per_socket"]
    info["threads_per_core"] = (logical // info["total_cores"]) if info["total_cores"] else 1
    if freqs:
        info["freq_min_mhz"] = min(freqs); info["freq_max_mhz"] = max(freqs)
        info["freq_avg_mhz"] = sum(freqs) / len(freqs)
    return info

def parse_numa(txt):
    """Parse the `os/numa` snapshot file (format documented in _awr_collect).
    Returns {"nodes": {id: {"cpus","mem_total_kb","mem_free_kb","distance",
    "stats": {name: value}}}}; {} when file empty/absent (older snaps degrade)."""
    out = {"nodes": {}}
    cur = None
    for line in (txt or "").splitlines():
        f = line.split()
        if not f:
            continue
        if f[0] == "node" and len(f) >= 2:
            cur = f[1]
            out["nodes"][cur] = {"cpus": "", "mem_total_kb": 0, "mem_free_kb": 0,
                                 "distance": "", "stats": {}}
        elif cur is None:
            continue
        elif f[0] == "cpulist" and len(f) >= 2:
            out["nodes"][cur]["cpus"] = f[1]
        elif f[0] == "MemTotal:" and len(f) >= 2:
            try: out["nodes"][cur]["mem_total_kb"] = int(f[1])
            except Exception: pass
        elif f[0] == "MemFree:" and len(f) >= 2:
            try: out["nodes"][cur]["mem_free_kb"] = int(f[1])
            except Exception: pass
        elif f[0] == "distance":
            out["nodes"][cur]["distance"] = " ".join(f[1:])
        elif f[0] == "stat" and len(f) >= 3:
            try: out["nodes"][cur]["stats"][f[1]] = float(f[2])
            except Exception: pass
    if not out["nodes"]:
        return {}
    return out

def _numa_stat_delta(numa_a, numa_b, nid, key):
    """Window delta of one numastat counter (end - begin); missing -> None."""
    if not numa_a or not numa_b:
        return None
    sa = numa_a.get("nodes", {}).get(nid, {}).get("stats", {})
    sb = numa_b.get("nodes", {}).get(nid, {}).get("stats", {})
    if key not in sb:
        return None
    return sb[key] - sa.get(key, sb[key])

def numa_html_table(topology, stats_delta_factory):
    """Emit the NUMA table(s) shared by awrrpt/awrdiff.
    topology: parse_numa() result (static info; any snap's copy works).
    stats_delta_factory(nid, key) -> value or None (window delta; None = unavailable)."""
    parts = []
    nodes = topology.get("nodes", {})
    parts.append('<table class="t"><tr><th>NUMA Nodes</th><th class="n">%d</th></tr></table>'
                 % len(nodes))
    parts.append('<table class="t"><tr><th>Node</th><th>CPU list</th><th>MemTotal</th>'
                 '<th>MemFree</th><th>Distance</th></tr>')
    for nid in sorted(nodes, key=lambda x: int(x) if x.isdigit() else 0):
        nd = nodes[nid]
        parts.append('<tr><td>%s</td><td>%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td></tr>' % (
                         esc(nid), esc(nd["cpus"]),
                         fmt_kb(nd["mem_total_kb"]), fmt_kb(nd["mem_free_kb"]),
                         esc(nd["distance"])))
    parts.append('</table>')
    parts.append('<table class="t"><tr><th>Node</th><th>numa_hit</th><th>numa_miss</th>'
                 '<th>interleave_hit</th><th>local_node</th><th>other_node</th>'
                 '<th>local ratio</th></tr>')
    any_stat = False
    for nid in sorted(nodes, key=lambda x: int(x) if x.isdigit() else 0):
        hit = stats_delta_factory(nid, "numa_hit")
        miss = stats_delta_factory(nid, "numa_miss")
        ih = stats_delta_factory(nid, "interleave_hit")
        loc = stats_delta_factory(nid, "local_node")
        oth = stats_delta_factory(nid, "other_node")
        if hit is None and miss is None and loc is None and oth is None:
            continue   # node has no numastat delta data at all
        any_stat = True
        _loc_den = (loc or 0) + (oth or 0)
        ratio = "%.2f%%" % ((loc or 0) / _loc_den * 100.0) if _loc_den > 0 else "n/a"
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td></tr>' % (
                         esc(nid),
                         fmt_int(hit) if hit is not None else "?",
                         fmt_int(miss) if miss is not None else "?",
                         fmt_int(ih) if ih is not None else "?",
                         fmt_int(loc) if loc is not None else "?",
                         fmt_int(oth) if oth is not None else "?",
                         ratio))
    if not any_stat:
        parts.append('<tr><td colspan="7" class="note">no data</td></tr>')
    parts.append('</table>')
    return "".join(parts)

def proc_stat_extras(txt):
    """context switches (ctxt), total interrupts (intr first col), procs_running."""
    ctxt = 0.0; intr = 0.0; runq = 0
    for line in (txt or "").splitlines():
        f = line.split()
        if len(f) < 2:
            continue
        if f[0] == "ctxt":
            try: ctxt = float(f[1])
            except Exception: pass
        elif f[0] == "intr":
            try: intr = float(f[1])
            except Exception: pass
        elif f[0] == "procs_running":
            try: runq = int(float(f[1]))
            except Exception: pass
    return {"ctxt": ctxt, "intr": intr, "runq": runq}

def proc_net_ifaces(txt):
    """Per-interface counters from /proc/net/dev: rx/tx bytes/packets/errs/drop/fifo/frame/compressed/multicast/colls/carrier."""
    out = []
    for line in (txt or "").splitlines():
        if ":" not in line:
            continue
        name, rest = line.split(":", 1)
        name = name.strip()
        if not name or name in ("Inter-|", "face"):
            continue
        if name == "lo" or name.startswith("vir"):
            continue
        f = rest.split()
        if len(f) < 12:
            continue
        out.append({
            "name": name,
            "rx_bytes": to_num(f[0]), "rx_packets": to_num(f[1]),
            "rx_errs":  to_num(f[2]), "rx_drop":   to_num(f[3]),
            "tx_bytes": to_num(f[8]), "tx_packets": to_num(f[9]),
            "tx_errs":  to_num(f[10]),"tx_drop":   to_num(f[11]),
        })
    return out

def proc_disk_devs(txt):
    """Per-device diskstats: rd_ios/rd_sectors/rd_ticks/wr_ios/wr_sectors/wr_ticks/weighted_ticks (ms)
    + discard/flush counters (kernel 4.18+; None on older kernels)."""
    out = []
    for line in (txt or "").splitlines():
        f = line.split()
        if len(f) < 14:
            continue
        try:
            out.append({
                "name": f[2],
                "rd_ios": to_num(f[3]), "rd_sectors": to_num(f[5]), "rd_ticks": to_num(f[6]),
                "wr_ios": to_num(f[7]), "wr_sectors": to_num(f[9]), "wr_ticks": to_num(f[10]),
                "weighted_ticks": to_num(f[13]),
                # kernel 4.18+ extra fields; None when the kernel does not report them
                "dc_ios": to_num(f[14]) if len(f) > 14 else None,
                "dc_sectors": to_num(f[16]) if len(f) > 16 else None,
                "dc_ticks": to_num(f[17]) if len(f) > 17 else None,
                "fl_ios": to_num(f[18]) if len(f) > 18 else None,
                "fl_ticks": to_num(f[19]) if len(f) > 19 else None,
            })
        except Exception:
            pass
    # drop partition entries (sda1, nvme0n1p1, ...) — keep whole disks only, to avoid double counting
    _names = [d["name"] for d in out]
    def _is_part(name):
        for parent in _names:
            if parent != name and name.startswith(parent):
                suf = name[len(parent):]
                if (suf.startswith("p") and suf[1:].isdigit()) or suf.isdigit():
                    return True
        return False
    out = [d for d in out if not _is_part(d["name"])]
    return out

def parse_blockdev_meta(txt):
    """os/blockdev_meta (run_lsds --raw): '# name|size|...' header + one line per device.
    Returns {name: {size,type,sched,rot,qdepth,nr_rq,wcache,model,vendor}}; {} when absent."""
    out = {}
    for line in (txt or "").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        f = line.split("|")
        if len(f) < 10:
            continue
        out[f[0]] = {"size": f[1], "type": f[2], "sched": f[3], "rot": f[4],
                     "qdepth": f[5], "nr_rq": f[6], "wcache": f[7],
                     "model": f[8], "vendor": f[9]}
    return out

def parse_netdev_meta(txt):
    """os/netdev_meta: iface|speed|duplex|nrxq|ntxq|rx_max|rx_cur|tx_max|tx_cur.
    Returns {iface: {...}}; {} when absent."""
    out = {}
    for line in (txt or "").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        f = line.split("|")
        if len(f) < 9:
            continue
        out[f[0]] = {"speed": f[1], "duplex": f[2], "nrxq": f[3], "ntxq": f[4],
                     "rx_max": f[5], "rx_cur": f[6], "tx_max": f[7], "tx_cur": f[8]}
    return out

VM_KEYWORDS = ("kvm", "qemu", "vmware", "openstack", "bochs", "xen", "hyper-v", "hyperv",
               "virtualbox", "ovirt", "powerkvm", "powervm", "ldom", "parallels", "zvm",
               "virtuozzo")

def platform_label(dmi_txt, cpuinfo_txt):
    """'Virtual (<dmi vendor+product>)' / 'Physical' / None (undeterminable).
    dmi keyword match wins; else cpuinfo 'hypervisor' flag; dmi present w/o match -> Physical."""
    dmi = {}
    for line in (dmi_txt or "").splitlines():
        f = line.split(None, 1)
        if len(f) == 2 and f[0] in ("vendor", "product"):
            dmi[f[0]] = f[1].strip()
    hay = " ".join(dmi.values()).lower()
    if hay:
        for kw in VM_KEYWORDS:
            if re.search(r'\b' + re.escape(kw) + r'\b', hay):
                return "Virtual (%s)" % " ".join(
                    dmi.get(k, "") for k in ("vendor", "product") if dmi.get(k)).strip()
        return "Physical"
    if "hypervisor" in (cpuinfo_txt or "").lower():
        return "Virtual (hypervisor)"
    return None

def _dd(e, b, k):
    """Delta of an optional counter (None on either side -> None)."""
    ev, bv = e.get(k), b.get(k)
    return None if (ev is None or bv is None) else ev - bv

def _cell(m, k):
    """Trimmed meta value; '-' for empty or literal '-'."""
    v = (m.get(k) or "").strip()
    return v if v and v != "-" else "-"

def disk_meta_cells(name, meta):
    """7 identity cells (Size/Type/Rot/Sched/QDepth/NR_RQ/WC); '-' when unavailable."""
    m = meta.get(name)
    if not m:
        return ["-"] * 7
    return [_cell(m, "size"), _cell(m, "type"), _cell(m, "rot"), _cell(m, "sched"),
            _cell(m, "qdepth"), _cell(m, "nr_rq"), _cell(m, "wcache")]

def net_meta_cells(name, meta):
    """Speed/Duplex/Queues/RX ring/TX ring cells; ring as 'cur/max'; '-' when unavailable."""
    m = meta.get(name)
    if not m:
        return ["-"] * 5
    nrx, ntx = _cell(m, "nrxq"), _cell(m, "ntxq")
    queues = nrx if nrx == ntx else "rx%s/tx%s" % (nrx, ntx)
    rxr = "-" if (_cell(m, "rx_cur") == "-" and _cell(m, "rx_max") == "-") else "%s/%s" % (_cell(m, "rx_cur"), _cell(m, "rx_max"))
    txr = "-" if (_cell(m, "tx_cur") == "-" and _cell(m, "tx_max") == "-") else "%s/%s" % (_cell(m, "tx_cur"), _cell(m, "tx_max"))
    return [_cell(m, "speed"), _cell(m, "duplex"), queues, rxr, txr]

# generic on purpose: "collapse"/"discard" catch resource-pressure counters (TCPBacklogCollapse, InDiscards) — intentional
NET_ERR_KEYWORDS = ("err", "drop", "retrans", "timeout", "fail", "overflow", "abort",
                    "reset", "rst", "lost", "prune", "collapse", "discard", "noroute")

NET_ERR_CORE = [
    ("Ip", "InHdrErrors", "InHdrErrors"), ("Ip", "InAddrErrors", "InAddrErrors"),
    ("Ip", "InUnknownProtos", "InUnknownProtos"), ("Ip", "InDiscards", "InDiscards"),
    ("Ip", "OutDiscards", "OutDiscards"), ("Ip", "OutNoRoutes", "OutNoRoutes"),
    ("Ip", "ReasmFails", "ReasmFails"), ("Ip", "FragFails", "FragFails"),
    ("Icmp", "InErrors", "InErrors"), ("Icmp", "OutErrors", "OutErrors"),
    ("Tcp", "AttemptFails", "AttemptFails"), ("Tcp", "EstabResets", "EstabResets"),
    ("Tcp", "RetransSegs", "RetransSegs"), ("Tcp", "InErrs", "InErrs"),
    ("Tcp", "OutRsts", "OutRsts"),
    ("Udp", "InErrors", "InErrors"), ("Udp", "RcvbufErrors", "RcvbufErrors"),
    ("Udp", "SndbufErrors", "SndbufErrors"),
    ("TcpExt", "ListenOverflows", "ListenOverflows"), ("TcpExt", "ListenDrops", "ListenDrops"),
    ("TcpExt", "TCPTimeouts", "Timeouts"), ("TcpExt", "TCPLostRetransmit", "LostRetransmit"),
    ("TcpExt", "TCPAbortOnData", "AbortOnData"), ("TcpExt", "TCPAbortOnClose", "AbortOnClose"),
    ("TcpExt", "TCPAbortOnMemory", "AbortOnMemory"), ("TcpExt", "TCPAbortOnTimeout", "AbortOnTimeout"),
    ("TcpExt", "TCPBacklogDrop", "BacklogDrop"), ("TcpExt", "TCPRcvCollapsed", "RcvCollapsed"),
    ("TcpExt", "TCPSynRetrans", "SynRetrans"), ("TcpExt", "TCPFastRetrans", "FastRetrans"),
]

def parse_netstat_pairs(txt):
    """/proc/net/{snmp,netstat}: paired lines 'X: n1 n2...' + 'X: v1 v2...' ->
    {proto: {name: float}}; unpaired/trailing lines skipped; {} when empty."""
    lines = [l for l in (txt or "").splitlines() if l.strip()]
    out = {}
    i = 0
    while i + 1 < len(lines):
        a, b = lines[i].split(None, 1), lines[i + 1].split(None, 1)
        if len(a) == 2 and len(b) == 2 and a[0] == b[0] and a[0].endswith(":"):
            keys = a[1].split(); vals = b[1].split()
            if len(keys) == len(vals):
                proto = a[0][:-1]
                out.setdefault(proto, {}).update(
                    {k: to_num(v) for k, v in zip(keys, vals)})
                i += 2
                continue
        i += 1
    return out

# assumes disjoint proto names between snmp/netstat ("Ip"/"Tcp" vs "IpExt"/"TcpExt"); an overlap would silently update-merge
def _netstat_merged(pairs):
    """Merge (filekey, text) pairs into single {proto: {name: float}} dict."""
    m = {}
    for _k, txt in pairs:
        for proto, kv in parse_netstat_pairs(txt).items():
            m.setdefault(proto, {}).update(kv)
    return m

def netstat_core_cols(bm, em, dur):
    """Core counter columns for horizontal rendering. Returns (cols, data) where:
    cols = [{"proto","name","label"}] for counters present in at least one side
    data = {proto: {name: {"delta": float|None, "per_sec": float|None}}}
    A column appears if the counter exists in EITHER side; delta=None if missing from one side."""
    cols = []
    data = {}
    for proto, raw_name, label in NET_ERR_CORE:
        bv = bm.get(proto, {}).get(raw_name)
        ev = em.get(proto, {}).get(raw_name)
        if bv is None and ev is None:
            continue  # omit if absent from BOTH sides
        cols.append({"proto": proto, "name": raw_name, "label": label})
        delta = (ev - bv) if (bv is not None and ev is not None) else None
        per_sec = (delta / dur) if (dur and delta is not None) else None
        if proto not in data:
            data[proto] = {}
        data[proto][raw_name] = {"delta": delta, "per_sec": per_sec}
    return cols, data

def netstat_core_rows(os_data, dur):
    """Core counter rows for vertical rendering. Returns list of (proto, name, label, delta, per_sec)
    tuples in NET_ERR_CORE fixed order for counters present in at least one side.
    os_data: win["os"] dict with (phase, filename) keys."""
    bm = _netstat_merged([("snmp", os_data.get(("begin", "net_snmp"), "")),
                         ("netstat", os_data.get(("begin", "net_netstat"), ""))])
    em = _netstat_merged([("snmp", os_data.get(("end", "net_snmp"), "")),
                         ("netstat", os_data.get(("end", "net_netstat"), ""))])
    rows = []
    for proto, raw_name, label in NET_ERR_CORE:
        bv = bm.get(proto, {}).get(raw_name)
        ev = em.get(proto, {}).get(raw_name)
        if bv is None and ev is None:
            continue  # omit if absent from BOTH sides
        delta = (ev - bv) if (bv is not None and ev is not None) else None
        per_sec = (delta / dur) if (dur and delta is not None) else None
        rows.append((proto, raw_name, label, delta, per_sec))
    return rows

def netstat_core_rows_awrdiff(os_data1, dur1, os_data2, dur2):
    """Core counter rows for awrdiff vertical rendering. Returns list of (proto, name, label, delta1, delta2, delta_diff)
    tuples in NET_ERR_CORE fixed order for counters present in at least one side of either period."""
    bm1 = _netstat_merged([("snmp", os_data1.get(("begin", "net_snmp"), "")),
                          ("netstat", os_data1.get(("begin", "net_netstat"), ""))])
    em1 = _netstat_merged([("snmp", os_data1.get(("end", "net_snmp"), "")),
                          ("netstat", os_data1.get(("end", "net_netstat"), ""))])
    bm2 = _netstat_merged([("snmp", os_data2.get(("begin", "net_snmp"), "")),
                          ("netstat", os_data2.get(("begin", "net_netstat"), ""))])
    em2 = _netstat_merged([("snmp", os_data2.get(("end", "net_snmp"), "")),
                          ("netstat", os_data2.get(("end", "net_netstat"), ""))])
    rows = []
    for proto, raw_name, label in NET_ERR_CORE:
        bv1 = bm1.get(proto, {}).get(raw_name)
        ev1 = em1.get(proto, {}).get(raw_name)
        bv2 = bm2.get(proto, {}).get(raw_name)
        ev2 = em2.get(proto, {}).get(raw_name)
        if (bv1 is None and ev1 is None) and (bv2 is None and ev2 is None):
            continue  # omit if absent from BOTH sides of BOTH periods
        delta1 = (ev1 - bv1) if (bv1 is not None and ev1 is not None) else None
        delta2 = (ev2 - bv2) if (bv2 is not None and ev2 is not None) else None
        delta_diff = None
        if delta1 is not None and delta2 is not None:
            delta_diff = delta2 - delta1
        rows.append((proto, raw_name, label, delta1, delta2, delta_diff))
    return rows

def netstat_err_deltas(begins, ends, dur):
    """Error-class netstat counter deltas across the window.
    begins/ends: [(filekey, text)] for ('snmp','netstat'); a counter needs BOTH sides
    present. Returns [{'proto','name','delta','per_sec'}] filtered to delta != 0,
    sorted by abs(delta) desc; empty list when nothing changed / files absent."""
    bm, em = _netstat_merged(begins), _netstat_merged(ends)
    core_names = {(proto, name) for proto, name, _ in NET_ERR_CORE}
    rows = []
    for proto, ekv in em.items():
        for name, ev in ekv.items():
            bv = bm.get(proto, {}).get(name)
            if bv is None:
                continue
            if (proto, name) in core_names:
                continue  # skip core counters (handled by horizontal table)
            low = name.lower()
            if not any(kw in low for kw in NET_ERR_KEYWORDS):
                continue
            d = ev - bv
            if d != 0:
                rows.append({"proto": proto, "name": name, "delta": d,
                             "per_sec": d / dur if dur else 0.0})
    rows.sort(key=lambda r: -abs(r["delta"]))
    return rows

def proc_vmstat(txt):
    """Key /proc/vmstat counters: pgpgin/pgpgout/pswpin/pswpout/pgfault/pgmajfault."""
    keys = ("pgpgin", "pgpgout", "pswpin", "pswpout", "pgfault", "pgmajfault")
    out = {k: 0.0 for k in keys}
    for line in (txt or "").splitlines():
        f = line.split()
        if len(f) >= 2 and f[0] in out:
            try:
                out[f[0]] = to_num(f[1])
            except Exception:
                pass
    return out

def proc_loadavg(txt):
    """/proc/loadavg -> 1/5/15-min load average. Gauge (EWMA), not cumulative."""
    out = {"load_1": 0.0, "load_5": 0.0, "load_15": 0.0}
    f = (txt or "").split()
    if len(f) >= 3:
        try:
            out["load_1"], out["load_5"], out["load_15"] = to_num(f[0]), to_num(f[1]), to_num(f[2])
        except Exception:
            pass
    return out

def proc_softirqs(txt):
    """Per-category softirq totals summed across CPUs. /proc/softirqs lines: '<CAT>:'."""
    out = {}
    for line in (txt or "").splitlines():
        f = line.split()
        if not f or not f[0].endswith(":"):
            continue
        cat = f[0][:-1]
        try:
            out[cat] = sum(to_num(x) for x in f[1:])
        except Exception:
            pass
    return out

def os_window_deltas(win):
    dur = to_num(win.get("meta", {}).get("duration"))
    if not dur or dur <= 0:
        dur = 1.0

    # ---- CPU breakdown ----
    bcpu = proc_cpu_full(win["os"].get(("begin", "stat"), ""))
    ecpu = proc_cpu_full(win["os"].get(("end", "stat"), ""))
    dt = ecpu["total"] - bcpu["total"]
    def cpupct(field):
        return ((ecpu[field] - bcpu[field]) / dt * 100.0) if dt > 0 else 0.0

    # ---- ctxt / intr / vmstat ----
    bx = proc_stat_extras(win["os"].get(("begin", "stat"), ""))
    ex = proc_stat_extras(win["os"].get(("end", "stat"), ""))
    bvm = proc_vmstat(win["os"].get(("begin", "vmstat"), ""))
    evm = proc_vmstat(win["os"].get(("end", "vmstat"), ""))
    bld = proc_loadavg(win["os"].get(("begin", "loadavg"), ""))
    eld = proc_loadavg(win["os"].get(("end", "loadavg"), ""))

    # ---- network per-iface ----
    bn = {i["name"]: i for i in proc_net_ifaces(win["os"].get(("begin", "net_dev"), ""))}
    en = {i["name"]: i for i in proc_net_ifaces(win["os"].get(("end", "net_dev"), ""))}
    ifaces = []
    net_bytes = 0.0
    for nm in sorted(set(bn) | set(en)):
        e = en.get(nm, {}); b = bn.get(nm, {})
        d = {"name": nm}
        for k in ("rx_bytes","rx_packets","rx_errs","rx_drop",
                  "tx_bytes","tx_packets","tx_errs","tx_drop"):
            d[k] = e.get(k,0) - b.get(k,0)
        ifaces.append(d)
        net_bytes += d["rx_bytes"] + d["tx_bytes"]

    # ---- disk per-device ----
    bd = {d["name"]: d for d in proc_disk_devs(win["os"].get(("begin", "diskstats"), ""))}
    ed = {d["name"]: d for d in proc_disk_devs(win["os"].get(("end", "diskstats"), ""))}
    disks = []
    discard_seen = False
    rd_bytes = wr_bytes = 0.0
    for nm in sorted(set(bd) | set(ed)):
        e = ed.get(nm, {}); b = bd.get(nm, {})
        rd_ios_d = e.get("rd_ios",0)   - b.get("rd_ios",0)
        wr_ios_d = e.get("wr_ios",0)   - b.get("wr_ios",0)
        rd_sec_d = e.get("rd_sectors",0) - b.get("rd_sectors",0)
        wr_sec_d = e.get("wr_sectors",0) - b.get("wr_sectors",0)
        rd_tick_d = e.get("rd_ticks",0) - b.get("rd_ticks",0)
        wr_tick_d = e.get("wr_ticks",0) - b.get("wr_ticks",0)
        wtick_d  = e.get("weighted_ticks",0) - b.get("weighted_ticks",0)
        dc_ios_d  = _dd(e, b, "dc_ios")
        dc_sec_d  = _dd(e, b, "dc_sectors")
        fl_ios_d  = _dd(e, b, "fl_ios")
        if dc_ios_d is not None:
            discard_seen = True
        ios_d = rd_ios_d + wr_ios_d
        if rd_sec_d == 0 and wr_sec_d == 0 and ios_d == 0:
            continue  # skip idle devices
        await_ms = (wtick_d / ios_d) if ios_d > 0 else 0.0
        disks.append({
            "name": nm,
            "read_iops":  rd_ios_d / dur,
            "write_iops": wr_ios_d / dur,
            "read_bytes":  rd_sec_d * 512,
            "write_bytes": wr_sec_d * 512,
            "await_ms":  await_ms,
            "r_await_ms": (rd_tick_d / rd_ios_d) if rd_ios_d > 0 else 0.0,
            "w_await_ms": (wr_tick_d / wr_ios_d) if wr_ios_d > 0 else 0.0,
            "discard_iops":  (dc_ios_d / dur) if dc_ios_d is not None else None,
            "discard_bytes": (dc_sec_d * 512) if dc_sec_d is not None else None,
            "flush_iops":    (fl_ios_d / dur) if fl_ios_d is not None else None,
        })
        rd_bytes += rd_sec_d * 512
        wr_bytes += wr_sec_d * 512

    # ---- softirqs delta ----
    bs = proc_softirqs(win["os"].get(("begin", "softirqs"), ""))
    es = proc_softirqs(win["os"].get(("end", "softirqs"), ""))
    softirqs = {}
    for cat in set(bs) | set(es):
        d = es.get(cat, 0) - bs.get(cat, 0)
        if d != 0:
            softirqs[cat] = d

    return {
        # legacy fields (kept for summary cards)
        "cpu_busy_pct": cpupct("busy"),
        "net_bytes": net_bytes,
        "disk_read_bytes": rd_bytes,
        "disk_write_bytes": wr_bytes,
        # new
        "dur": dur,
        "cpu": {"busy": cpupct("busy"), "user": cpupct("user"), "nice": cpupct("nice"),
                "system": cpupct("system"),
                "iowait": cpupct("iowait"), "irq": cpupct("irq"),
                "softirq": cpupct("softirq"), "steal": cpupct("steal"),
                "idle": cpupct("idle")},
        "ctxt_per_sec": (ex["ctxt"] - bx["ctxt"]) / dur,
        "intr_per_sec": (ex["intr"] - bx["intr"]) / dur,
        "runq_begin": bx["runq"],
        "runq_end": ex["runq"],
        "load_begin": bld,
        "load_end": eld,
        "vm": {k: ((evm[k] - bvm[k]) / dur) for k in bvm},
        "disks": disks,
        "ifaces": ifaces,
        "softirqs": softirqs,
        "discard_supported": discard_seen,
        "disk_meta": parse_blockdev_meta(win["os"].get(("end", "blockdev_meta"), "")),
        "net_meta": parse_netdev_meta(win["os"].get(("end", "netdev_meta"), "")),
        "platform": platform_label(win["os"].get(("end", "dmi"), ""),
                                   win["os"].get(("end", "cpuinfo"), "")
                                   or win["os"].get(("begin", "cpuinfo"), "")),
        "netstat_errs": netstat_err_deltas(
            [("snmp", win["os"].get(("begin", "net_snmp"), "")),
             ("netstat", win["os"].get(("begin", "net_netstat"), ""))],
            [("snmp", win["os"].get(("end", "net_snmp"), "")),
             ("netstat", win["os"].get(("end", "net_netstat"), ""))], dur),
        "netstat_ok": bool(win["os"].get(("begin", "net_snmp"), "") or
                           win["os"].get(("begin", "net_netstat"), "")) and
                      bool(win["os"].get(("end", "net_snmp"), "") or
                           win["os"].get(("end", "net_netstat"), "")),
    }

