    # ================= SQL Statistics =================
    sec("SQL Statistics")
    note("SQL Id = unique_sql_id (click for full text in SQL Text section).\n"
         "Sort metric = total + per-exec (the column each table is ordered by).\n"
         "CPU Time / IO Time = window total (s); IO Time = data_io_time.\n"
         "logical reads/exec = n_blocks_fetched / n_calls.\n"
         "physical reads/exec = (n_blocks_fetched - n_blocks_hit) / n_calls.\n"
         "rows/exec = n_returned_rows / n_calls.\n"
         "plan_time / sort_time / hash_time = per-execution (ms).\n"
         "Top %d per ordering." % top_n)

    shown_sql = {}   # uid -> statement row (collected for the SQL Text section)

    def sql_block(label, order_col, dim_header, dim_fmt, dim_mode, pct_base):
        # dim_mode: total_pe = dim total + per-exec; total_only = dim total; none = Executions is dim
        sub(label)
        keys = sorted(ST.keys(), key=lambda k: ST[k].get(order_col, 0.0), reverse=True)[:top_n]
        hdr = ['<th>#</th>', '<th>SQL Id</th>', '<th>User</th>', '<th class="n">Executions</th>']
        if dim_mode in ("total_pe", "total_only"):
            hdr.append('<th class="n">%s</th>' % dim_header)
        if dim_mode == "total_pe":
            hdr.append('<th class="n">%s/exec</th>' % dim_header)
        # the table's own dim column already shows cpu/io time when it IS the dim --
        # skip the static copy then, otherwise the column appears twice
        if dim_header != "CPU Time (s)":
            hdr.append('<th class="n">CPU Time (s)</th>')
        if dim_header != "IO Time (s)":
            hdr.append('<th class="n">IO Time (s)</th>')
        hdr += ['<th class="n">logical reads/exec</th>',
                '<th class="n">physical reads/exec</th>',
                '<th class="n">rows/exec</th>',
                '<th class="n">% Total</th>',
                '<th class="n">plan_time/exec (ms)</th>',
                '<th class="n">sort_time/exec (ms)</th>',
                '<th class="n">hash_time/exec (ms)</th>']
        parts.append('<table class="t"><tr>' + ''.join(hdr) + '</tr>')
        if not keys:
            parts.append('<tr><td colspan="%d" class="note">no data</td></tr>' % len(hdr))
        for i, k in enumerate(keys, 1):
            d = ST[k]; row = d.get("__row") or {}
            if k not in shown_sql:
                shown_sql[k] = row
            v = d.get(order_col, 0.0)
            calls = d.get("n_calls", 0.0) or 1.0
            log_r = d.get("n_blocks_fetched", 0.0)
            phys_r = log_r - d.get("n_blocks_hit", 0.0)
            cells = ['<td>%d</td>' % i,
                     '<td><a href="#sql-%s">%s</a></td>' % (esc(k), esc(k)),
                     '<td>%s</td>' % esc(row.get("user_name") or ""),
                     '<td class="n">%s</td>' % fmt_int(d.get("n_calls", 0.0))]
            if dim_mode in ("total_pe", "total_only"):
                cells.append('<td class="n">%s</td>' % dim_fmt(v))
            if dim_mode == "total_pe":
                cells.append('<td class="n">%s</td>' % dim_fmt(v / calls))
            if dim_header != "CPU Time (s)":
                cells.append('<td class="n">%s</td>' % s_of(d.get("cpu_time", 0.0)))
            if dim_header != "IO Time (s)":
                cells.append('<td class="n">%s</td>' % s_of(d.get("data_io_time", 0.0)))
            cells += ['<td class="n">%s</td>' % fmt_int(log_r / calls),
                      '<td class="n">%s</td>' % fmt_int(phys_r / calls),
                      '<td class="n">%s</td>' % fmt_int(d.get("n_returned_rows", 0.0) / calls),
                      '<td class="n">%.2f%%</td>' % pct(v, pct_base),
                      '<td class="n">%s</td>' % ms_of(d.get("plan_time", 0.0) / calls),
                      '<td class="n">%s</td>' % ms_of(d.get("sort_time", 0.0) / calls),
                      '<td class="n">%s</td>' % ms_of(d.get("hash_time", 0.0) / calls)]
            parts.append('<tr>' + ''.join(cells) + '</tr>')
        parts.append('</table>')

    for _k in ST:
        ST[_k]["physical_reads"] = ST[_k].get("n_blocks_fetched", 0.0) - ST[_k].get("n_blocks_hit", 0.0)
    sum_dbt_sql = sum(d.get("db_time", 0.0) for d in ST.values())
    sum_cpu_sql = sum(d.get("cpu_time", 0.0) for d in ST.values())
    sum_io_sql = sum(d.get("data_io_time", 0.0) for d in ST.values())
    sum_phys_sql = sum(d.get("physical_reads", 0.0) for d in ST.values())
    sql_block("SQL ordered by DB Time", "db_time", "DB Time (s)", s_of, "total_pe", sum_dbt_sql)
    sql_block("SQL ordered by CPU Time", "cpu_time", "CPU Time (s)", s_of, "total_pe", sum_cpu_sql)
    sql_block("SQL ordered by IO Time", "data_io_time", "IO Time (s)", s_of, "total_pe", sum_io_sql)
    sum_plan_sql = sum(d.get("plan_time", 0.0) for d in ST.values())
    sql_block("SQL ordered by Plan Time", "plan_time", "Plan Time (s)", s_of, "total_pe", sum_plan_sql)
    sql_block("SQL ordered by Logical Reads", "n_blocks_fetched", "logical reads", fmt_int, "total_only", sum_gets)
    sql_block("SQL ordered by Physical Reads", "physical_reads", "physical reads", fmt_int, "total_only", sum_phys_sql)
    sql_block("SQL ordered by Executions", "n_calls", "Executions", fmt_int, "none", sum_calls)

    # ================= Object Statistics (all databases; gauges=begin+end, counters=end-begin) =================
    sec("Object Statistics")
    def object_table(label, begin_rows, end_rows, key_cols, col_specs, sort_fn, top=30):
        # col_specs: list of (col, mode); mode "d"=delta(end-begin), "e"=end value, "be"=begin+end
        sub(label)
        def _key(r):
            return tuple(r.get(k, "") for k in key_cols)
        _all_cols = [c for c, _ in col_specs]
        _b = {}
        for _r in begin_rows:
            _b[_key(_r)] = {c: to_num(_r.get(c, 0) or 0) for c in _all_cols}
        _e = {}
        for _r in end_rows:
            _e[_key(_r)] = {c: to_num(_r.get(c, 0) or 0) for c in _all_cols}
        _rows = []
        for _k in set(_b) | set(_e):
            _bv = _b.get(_k, {}); _ev = _e.get(_k, {})
            _rows.append((_k, {c: (_bv.get(c, 0), _ev.get(c, 0)) for c in _all_cols}))
        _rows.sort(key=lambda x: sort_fn(x[1]), reverse=True)
        _rows = _rows[:top]
        if not _rows:
            parts.append('<div class="note">no data</div>')
            return
        _hdr = list(key_cols)
        _num = [False] * len(key_cols)
        for _c, _mode in col_specs:
            if _mode == "be":
                _hdr += [_c + " (Begin)", _c + " (End)"]
                _num += [True]   # be emits TWO headers; extra flag so zip() keeps (End)
            elif _mode == "d":
                _hdr += [_c + " Δ"]
            else:
                _hdr += [_c]
            _num += [True]           # col_spec columns are numeric -> right-align headers too
        parts.append('<table class="t"><tr>' + ''.join(
            '<th%s>%s</th>' % (' class="n"' if nu else '', esc(c))
            for c, nu in zip(_hdr, _num)) + '</tr>')
        for _k, _vals in _rows:
            _cells = ''.join('<td>%s</td>' % esc(x) for x in _k)
            for _c, _mode in col_specs:
                _begin, _end = _vals[_c]
                if _mode == "be":
                    _cells += '<td class="n">%s</td><td class="n">%s</td>' % (fmt_int(_begin), fmt_int(_end))
                elif _mode == "d":
                    _cells += '<td class="n">%s</td>' % fmt_int(_end - _begin)
                else:
                    _cells += '<td class="n">%s</td>' % fmt_int(_end)
            parts.append('<tr>' + _cells + '</tr>')
        parts.append('</table>')
    object_table("Top Objects by Dead Tuples",
        win["db"].get(("begin", "object_dead"), []),
        win["db"].get(("end", "object_dead"), []),
        ("dbname", "schema", "object"),
        [("table_age", "e"), ("relpages", "e"), ("reltuples", "e"), ("n_dml_tup", "e"),
         ("n_live_tup", "e"), ("n_dead_tup", "be")],
        lambda v: v["n_dead_tup"][1])
    object_table("Top Tables by Activity",
        win["db"].get(("begin", "object_tables"), []),
        win["db"].get(("end", "object_tables"), []),
        ("dbname", "schema", "object"),
        [("seq_scan", "d"), ("seq_tup_read", "d"), ("idx_scan", "d"), ("idx_tup_fetch", "d"),
         ("n_tup_ins", "d"), ("n_tup_upd", "d"), ("n_tup_del", "d"), ("n_tup_hot_upd", "d"),
         ("n_live_tup", "e"), ("n_dead_tup", "be")],
        lambda v: (v["seq_tup_read"][1] - v["seq_tup_read"][0]) + (v["idx_tup_fetch"][1] - v["idx_tup_fetch"][0]))
    object_table("Top Indexes by Scans",
        win["db"].get(("begin", "object_indexes"), []),
        win["db"].get(("end", "object_indexes"), []),
        ("dbname", "schema", "object", "index"),
        [("idx_scan", "d"), ("idx_tup_read", "d"), ("idx_tup_fetch", "d")],
        lambda v: v["idx_scan"][1] - v["idx_scan"][0])

    # ================= Active Session History =================
    # gs_asp/local_active_session = persisted 1-second kernel ASP samples;
    # every create flushes [prev snap, now]; the window unions every flush
    # in (begin, end]. Output mirrors the `vb_tool asp` command: 5-minute
    # buckets of per-second counts (max/avg), source tag per bucket, top-5
    # SQL per bucket. Section renders UNCONDITIONALLY (user 2026-09-02):
    # an absent section reads as "feature missing", an empty one reads as
    # "no samples in this window" (idle standby / enable_asp off / PG).
    _ash = (load_ash_flushes(repl_dir, m.get("begin_ts", ""), m.get("end_ts", ""))
            if repl_dir is not None else {"cnt": {}, "event": {}, "sql": {}, "waitchain": {}})
    sec("Active Session History")
    if _ash["cnt"] or _ash["event"] or _ash["sql"] or _ash["waitchain"]:
        def _ash_dt(src, bk):
            from datetime import datetime, timedelta
            tag = "[gs_asp]" if src == "g" else "[local_active_session]"
            try:
                t0 = datetime.strptime(bk, "%Y-%m-%d %H:%M")
                return "%s %s-%s" % (tag, t0.strftime("%Y-%m-%d %H:%M:%S"),
                                     (t0 + timedelta(minutes=5)).strftime("%H:%M:%S"))
            except ValueError:
                return "%s %s" % (tag, bk)
        if _ash["cnt"]:
            sub("Active Session History Count")
            parts.append('<table class="t"><tr><th>date_time</th><th class="n">max_sess</th>'
                         '<th class="n">avg_sess</th><th class="n">max_active_sess</th>'
                         '<th class="n">wait_lock</th><th class="n">wait_lwlock</th>'
                         '<th class="n">wait_io</th><th class="n">wait_wal_sync</th>'
                         '<th class="n">wait_trans_sync</th></tr>')
            for (src, bk) in sorted(_ash["cnt"], key=lambda k: k[1]):
                v = _ash["cnt"][(src, bk)]
                parts.append('<tr><td>%s</td>%s</tr>'
                             % (_ash_dt(src, bk),
                                "".join('<td class="n">%s</td>' % fmt_int(x) for x in v)))
            parts.append('</table>')
        if _ash["event"]:
            _h = ['<table class="t"><tr><th>date_time</th><th>event_type</th>'
                  '<th>event</th><th class="n">max_cnt</th><th class="n">avg_cnt</th></tr>']
            for (src, bk, ev), v in sorted(_ash["event"].items(),
                                           key=lambda kv: (kv[0][1], -kv[1][1])):
                _h.append('<tr><td>%s</td><td>%s</td><td>%s</td>'
                          '<td class="n">%s</td><td class="n">%s</td></tr>'
                          % (_ash_dt(src, bk), esc(v[0]), esc(ev),
                             fmt_int(v[1]), fmt_int(v[2])))
            _h.append('</table>')
            parts.append(_fold("Active Session History Event", "".join(_h)))
        if _ash["sql"]:
            _h = ['<table class="t"><tr><th>date_time</th><th class="n">unique_query_id</th>'
                  '<th>unique_query</th><th class="n">max_cnt</th>'
                  '<th class="n">avg_cnt</th></tr>']
            for (src, bk, qid), v in sorted(_ash["sql"].items(),
                                            key=lambda kv: (kv[0][1], -kv[1][1])):
                _h.append('<tr><td>%s</td><td class="n">%s</td><td>%s</td>'
                          '<td class="n">%s</td><td class="n">%s</td></tr>'
                          % (_ash_dt(src, bk), esc(qid), esc(v[0]),
                             fmt_int(v[1]), fmt_int(v[2])))
            _h.append('</table>')
            parts.append(_fold("Active Session History Top SQL", "".join(_h)))
        # waitchain header is unconditional within the section: an absent
        # table reads as "feature missing", an empty one reads as "no chains
        # in this window" -- the latter is the information the reader wants
        _h = ['<table class="t"><tr><th>date_time</th><th>root_block_sessid</th>'
              '<th class="n">max_b_cnt</th><th>h_sql</th><th>w_sql</th></tr>']
        if _ash["waitchain"]:
            for (dt, rt), v in sorted(_ash["waitchain"].items(),
                                      key=lambda kv: (-kv[1][0], kv[0][0])):
                _h.append('<tr><td>%s</td><td>%s</td><td class="n">%s</td>'
                          '<td>%s</td><td>%s</td></tr>'
                          % (esc(dt), esc(rt), fmt_int(v[0]), esc(v[1]), esc(v[2])))
        else:
            _h.append('<tr><td colspan="5" class="note">no data</td></tr>')
        _h.append('</table>')
        parts.append(_fold("Active Session History Waitchain", "".join(_h)))
    else:
        parts.append('<div class="note">no data</div>')

    # ================= Wait Events =================
    sec("Wait Events", fold=True)
    parts.append('<table class="t"><tr><th>Event</th><th>Class</th><th class="n">Waits</th>'
                 '<th class="n">Total Wait Time (s)</th><th class="n">Avg wait (ms)</th>'
                 '<th class="n">% DB time</th></tr>')
    if not we_sorted:
        parts.append('<tr><td colspan="6" class="note">no data</td></tr>')
    for k in we_sorted:
        d = WE[k]; w = d.get("wait", 0.0); t = d.get("total_wait_time", 0.0)
        cls_ = (d.get("__row") or {}).get("type", "")
        avg = (t / w) if w else 0.0
        parts.append('<tr><td>%s</td><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%.2f%%</td></tr>' % (
                         esc(k), esc(cls_), fmt_int(w), s_of(t), ms_of(avg), pct(t, dbt)))
    parts.append('</table>')

    # ================= SQL Text (full normalized queries, AWR-style) =================
    sec("SQL Text", fold=True)
    if not shown_sql:
        parts.append('<div class="note">no data</div>')
    else:
        parts.append('<table class="t"><tr><th>SQL Id</th><th>SQL Text</th></tr>')
        for uid in sorted(shown_sql.keys()):
            row = shown_sql[uid] or {}
            parts.append('<tr id="sql-%(u)s"><td class="sqlid">%(u)s</td>'
                         '<td><pre class="sqlfull">%(q)s</pre></td></tr>'
                         % {"u": esc(uid), "q": esc(normalize_sql(
                             sql_text_of(win, row, uid)
                             or "(text not collected: absent from sql_text store)"))})
        parts.append('</table>')

    # ================= Database Parameters (pg_settings, live query) =================
    sec("Database Parameters", fold=True)
    pgset = fetch_pg_settings()
    parts.append('<table class="t params"><colgroup>'
                 '<col style="width:24%"><col style="width:14%"><col style="width:12%"><col style="width:50%">'
                 '</colgroup><tr><th>Name</th><th>Setting</th>'
                 '<th>Context</th><th>Description</th></tr>')
    if not pgset:
        parts.append('<tr><td colspan="4" class="note">no data</td></tr>')
    else:
        def decode_setting(setting, unit):
            if unit == "8kB":
                try:
                    return "%dkB" % (int(float(setting)) * 8)
                except Exception:
                    return "%s kB" % setting
            return "%s%s" % (setting, unit if unit else "")
        for r in sorted(pgset, key=lambda x: x.get("name", "")):
            _n = r.get("name", "")
            _s = decode_setting(r.get("setting", ""), r.get("unit", ""))
            _c = r.get("context", "")
            _d = r.get("short_desc", "")
            parts.append('<tr><td title="%s">%s</td><td title="%s">%s</td><td>%s</td><td class="wrap">%s</td></tr>'
                         % (esc(_n), esc(_n), esc(_s), esc(_s), esc(_c), esc(_d)))
    parts.append('</table>')

    _toc_html = '<div class="toc" id="toc"><b>Contents</b><ul>' + "".join(
        '<li><a href="#%s">%s</a></li>' % (_id, esc(t)) for t, _id in _toc) + '</ul></div>'
    parts.insert(_toc_pos, _toc_html)

    # ================= Footer =================
    _close_foldsec()
    parts.append('<div class="foot">Generated by vb_tool awr report &middot; '
                 'single-window report &middot; all values = window(end-begin) &middot; '
                 '% DB time = metric / DB_TIME.</div>')
    parts.append('</body></html>')

    htmls = "".join(parts)
    if out_html:
        os.makedirs(os.path.dirname(os.path.abspath(out_html)), exist_ok=True)
        with open(out_html, "w") as f:
            f.write(htmls)
        print("report written: %s" % out_html)
    else:
        sys.stdout.write(htmls)


