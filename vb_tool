    user = g[user_idx - 1] if user_idx <= len(g) else 'unknown'
    pid  = g[pid_idx  - 1].strip('[]') if (pid_idx and pid_idx <= len(g)) else None
    return db, user, pid

def normalize_user(user):
    # strip/lower (2nd historical def) AND the vastbase->public schema mapping
    # (1st def): the default user's unqualified tables live in schema public
    user = user.strip().lower()
    return 'public' if user == 'vastbase' else user

def _split_ident(raw):
    """★引号感知的点号切分 (2026-09-28 修): 返回 [(文本, 是否带过引号), ...]。
    双引号内的点号**不是**分隔符, 引号本身不进入结果。
    老写法 raw.strip('"') 只去掉首尾引号, 于是:
      「"Sales".t1」 -> ['sales"', 't1']   schema 名里带一个残留双引号, 永远查不到
      「"sales".t1」 -> ['sales"', 't1']   同上(小写名写法也坏)
      「"a.b".t1」   -> ['a', 'b"', 't1']  schema 名本身带点时被切碎成三段
    大小写**一律折叠小写**(见 _q_ident); 注意下游 tabstat SQL 是按
    n.nspname / c.relname 原样大小写比较的, 库里若真有大小写敏感的 schema/表名会匹配不上
    —— 这是用户拍板的口径。"""
    out, cur, inq, qf = [], '', False, False
    for ch in raw:
        if ch == '"':
            inq = not inq
            qf = True
            continue
        if ch == '.' and not inq:
            out.append((cur, qf)); cur, qf = '', False
        else:
            cur += ch
    out.append((cur, qf))
    return out

def _q_ident(text, quoted):
    """标识符**一律折叠小写** (用户 2026-09-28 拍板: 「一律小写」)。
    ★严格按 PG 规则本该区分: 带引号的标识符大小写敏感(「"Sales".t1」指名为 Sales 的
    schema), 不带引号的才折叠小写; 这里按用户口径统一成全小写, 与本工具其它地方
    (库名/用户名一律 lower)一致。`quoted` 参数保留, 只为不改 _split_ident 的返回形状与
    两处调用点。"""
    return text.strip().lower()

KW_NEWLINE = re.compile(
    r'\b('
    r'SELECT|FROM'
    r'|LEFT\s+OUTER\s+JOIN|RIGHT\s+OUTER\s+JOIN|FULL\s+OUTER\s+JOIN'
    r'|LEFT\s+JOIN|RIGHT\s+JOIN|INNER\s+JOIN|CROSS\s+JOIN|JOIN'
    r'|WHERE|GROUP\s+BY|ORDER\s+BY|HAVING|LIMIT|OFFSET'
    r'|ON\b|SET|VALUES|INSERT\s+INTO|UPDATE|DELETE\s+FROM'
    r'|WITH|UNION\s+ALL|UNION|INTERSECT|EXCEPT'
    r')\b',
    re.IGNORECASE
)

def format_sql(sql):
    sql = ' '.join(sql.split())
    def repl(m):
        return '\n' + re.sub(r'\s+', ' ', m.group(0).upper())
    sql = KW_NEWLINE.sub(repl, sql)
    lines = [ln.strip() for ln in sql.split('\n')]
    return '\n'.join(ln for ln in lines if ln).strip()

def parse_params(text):
    # VastBase new log format appends " type = <typename>" after each parameter
    # value, e.g. "$1 = '100' type = bigint, $2 = 'x' type = varchar". Strip the
    # annotations first so old and new formats parse identically. The strip is
    # anchored on the quoted value ('' escapes included) and stops at the next
    # ", $N = " or end of line, so type names like numeric(10,2) survive intact
    # and values merely containing "type = " are never touched.
    text = re.sub(
        r"('(?:[^']|'')*'|NULL)\s*,?\s*type\s*=\s*.*?(?=\s*,\s*\$\d+\s*=|\s*$)",
        r"\1",
        text)
    result = {}
    token_re = re.compile(r'\$(\d+)\s*=\s*')
    matches = list(token_re.finditer(text))
    for k, m in enumerate(matches):
        idx = int(m.group(1))
        val_start = m.end()
        val_end   = matches[k + 1].start() if k + 1 < len(matches) else len(text)
        val = text[val_start:val_end].strip().rstrip(',').strip()
        result[idx] = val
    return result

def replace_params(sql, params):
    for idx in sorted(params.keys(), reverse=True):
        sql = sql.replace('$' + str(idx), params[idx])
    return sql

_SQL_KW = {
    'select', 'from', 'where', 'join', 'inner', 'left', 'right', 'full',
    'outer', 'cross', 'natural', 'on', 'and', 'or', 'not', 'in', 'exists',
    'between', 'like', 'is', 'null', 'as', 'by', 'group', 'order', 'having',
    'union', 'all', 'distinct', 'case', 'when', 'then', 'else', 'end',
    'insert', 'into', 'update', 'set', 'delete', 'merge', 'using', 'matched',
    'create', 'alter', 'drop', 'table', 'view', 'index', 'with', 'recursive',
    'limit', 'offset', 'fetch', 'next', 'rows', 'only', 'row', 'partition',
    'over', 'window', 'filter', 'within', 'lateral', 'values', 'returning',
    'truncate', 'begin', 'commit', 'rollback', 'savepoint', 'grant', 'revoke',
    'pivot', 'unpivot', 'connect', 'start', 'nocycle', 'prior', 'level',
    'rownum', 'rowid', 'dual', 'if', 'else', 'do', 'loop', 'while', 'for',
    'exception', 'raise', 'declare', 'procedure', 'function', 'trigger',
    'top', 'percent', 'ties', 'nulls', 'first', 'last', 'asc', 'desc',
    'primary', 'foreign', 'key', 'references', 'unique', 'check', 'default',
    'constraint', 'index', 'replace', 'ignore', 'explain', 'analyze',
    'intersect', 'except', 'minus', 'tablesample', 'sample',
}



def extract_tables(sql_text, default_user):
    seen = {}

    def strip_literals(s):
        out = []
        i = 0
        while i < len(s):
            if s[i] == "'":
                out.append("''")
                i += 1
                while i < len(s):
                    if s[i] == "'" and i + 1 < len(s) and s[i + 1] == "'":
                        i += 2
                    elif s[i] == "'":
                        i += 1
                        break
                    else:
                        i += 1
            elif s[i] == '"':
                out.append(s[i])
                i += 1
                while i < len(s) and s[i] != '"':
                    out.append(s[i])
                    i += 1
                if i < len(s):
                    out.append(s[i])
                    i += 1
            elif s[i] == '-' and i + 1 < len(s) and s[i + 1] == '-':
                while i < len(s) and s[i] != '\n':
                    i += 1
                out.append(' ')
            elif s[i] == '/' and i + 1 < len(s) and s[i + 1] == '*':
                i += 2
                while i < len(s) - 1 and not (s[i] == '*' and s[i + 1] == '/'):
                    i += 1
                i += 2
                out.append(' ')
            else:
                out.append(s[i])
                i += 1
        return ''.join(out)

    clean = strip_literals(sql_text)
    tokens = re.findall(
        # ★点号连接的限定名整体成一个 token, 且每一段都可以带双引号 (2026-09-28 修):
        #   老写法把「带引号」与「不带引号」写成两个**互斥分支** ⇒ `"Sales".t1` 被切成
        #   `"Sales"` + `t1` 两个 token, 中间那个点号直接被正则丢弃; add_table 于是只拿到
        #   半截名字(记成 (public, Sales) 这种永远查不到的项), 后面的 `t1` 还会被当成别名
        #   跳掉。`"a.b".t1`(schema 名本身带点)、`"My Schema".t1`(名字里有空格) 同理。
        #   改成「一段 + 零或多段 .一段」后: 带引号/不带引号可任意混搭, 点号只在段间当分隔符。
        r'(?:"[^"]*"|[a-zA-Z_]\w*)(?:\.(?:"[^"]*"|[a-zA-Z_]\w*))*'
        r'|[(),;]',
        clean
    )
    n = len(tokens)

    def is_kw(tok):
        return tok.lstrip('"').rstrip('"').lower() in _SQL_KW

    def add_table(raw):
        if raw.strip().lower() in _SQL_KW:
            return
        # ★引号感知切分 + 按 PG 规则定大小写 (2026-09-28 修, 见 _split_ident 的说明):
        #   带引号原样保留、不带引号转小写; 引号内的点号不再当分隔符。
        parts = [_q_ident(t, q) for t, q in _split_ident(raw)]
        if len(parts) == 1:
            owner = normalize_user(default_user)
            tname = parts[0]
        elif len(parts) == 2:
            owner, tname = parts
        else:
            owner, tname = parts[-2], parts[-1]
        if tname and tname not in _SQL_KW:
            seen[(owner, tname)] = True

    def skip_subquery(pos):
        depth = 1
        pos += 1
        while pos < n and depth > 0:
            if tokens[pos] == '(':
                depth += 1
            elif tokens[pos] == ')':
                depth -= 1
            pos += 1
        return pos

    def skip_alias(pos):
        if pos >= n:
            return pos
        if tokens[pos].upper() == 'AS':
            pos += 1
        if pos < n and tokens[pos] not in (',', '(', ')', ';') and not is_kw(tokens[pos]):
            pos += 1
        return pos

    # CTE 收集：WITH name AS ( 严格三段匹配，且前一token不能是 START
    cte_names = set()

    def collect_ctes():
        i = 0
        while i < n:
            if tokens[i].upper() == 'WITH':
                prev = tokens[i - 1].upper() if i > 0 else ''
                if prev == 'START':   # Oracle START WITH，不是CTE
                    i += 1
                    continue
                i += 1
                while i < n:
                    if tokens[i].upper() == 'RECURSIVE':
                        i += 1
                        continue
                    if is_kw(tokens[i]) or tokens[i] in ('(', ')', ',', ';'):
                        break
                    cte_name = tokens[i].lower().strip('"')
                    i += 1
                    if i >= n or tokens[i].upper() != 'AS':
                        break
                    i += 1
                    if i >= n or tokens[i] != '(':
                        break
                    cte_names.add(cte_name)
                    i = skip_subquery(i)
                    if i < n and tokens[i] == ',':
                        i += 1
                        continue
                    break
            i += 1

    collect_ctes()

    def add_table_checked(raw):
        name = raw.strip('"').lower().split('.')[-1]
        if name not in cte_names:
            add_table(raw)

    FROM_TRIGGERS = {
        'FROM', 'JOIN', 'INNER', 'LEFT', 'RIGHT', 'FULL',
        'CROSS', 'NATURAL', 'STRAIGHT_JOIN',
    }
    JOIN_NOISE = {'JOIN', 'OUTER', 'SEMI', 'ANTI', 'INTO', 'BY'}

    i = 0
    while i < n:
        tok_up = tokens[i].upper()

        if tok_up == 'UPDATE':
            j = i + 1
            if j < n and not is_kw(tokens[j]) and tokens[j] not in ('(', ')'):
                add_table_checked(tokens[j])
                j = skip_alias(j + 1)
            i = j if j > i else i + 1
            continue

        if tok_up in ('INSERT', 'MERGE'):
            j = i + 1
            if j < n and tokens[j].upper() == 'INTO':
                j += 1
            if j < n and not is_kw(tokens[j]) and tokens[j] not in ('(', ')'):
                add_table_checked(tokens[j])
                j = skip_alias(j + 1)
            i = j if j > i else i + 1
            continue

        if tok_up == 'DELETE':
            j = i + 1
            if j < n and tokens[j].upper() == 'FROM':
                j += 1
            if j < n and not is_kw(tokens[j]) and tokens[j] not in ('(', ')'):
                add_table_checked(tokens[j])
                j = skip_alias(j + 1)
            i = j if j > i else i + 1
            continue

        if tok_up in FROM_TRIGGERS:
            j = i + 1
            while j < n and tokens[j].upper() in JOIN_NOISE:
                j += 1
            while j < n:
                t = tokens[j]
                t_up = t.upper()
                if t == '(':
                    # 子查询：不跳过，让主循环自然扫描括号内部
                    i = j
                    break
                if t in (')', ';'):
                    i = j
                    break
                if t_up in _SQL_KW and t_up not in ('AS',):
                    i = j
                    break
                add_table_checked(t)
                j = skip_alias(j + 1)
                if j < n and tokens[j] == ',':
                    j += 1
                    continue
                i = j
                break
            else:
                i = j
            continue

        if tok_up == 'USING':
            j = i + 1
            if j < n and tokens[j] == '(':
                j = skip_subquery(j)
                j = skip_alias(j)
            elif j < n and not is_kw(tokens[j]):
                add_table_checked(tokens[j])
                j = skip_alias(j + 1)
            i = j if j > i else i + 1
            continue

        i += 1

    return [(o, t) for (o, t) in seen.keys() if t not in cte_names]

def display_width(s):
    w = 0
    for c in s:
        ea = unicodedata.east_asian_width(c)
        w += 2 if ea in ('W', 'F', 'A') else 1
    return w

_SCHEMA_CACHE = {}

def _psql_query(db_name, sql, timeout=5):
    """跑一条 -tA 查询, 返回非空行列表; 任何失败(连不上/无权限/视图不存在/超时)一律
    返回空列表 -- 反查 schema 是**尽力而为**的增强, 绝不允许它把 sqlhc 弄挂。"""
    try:
        p = subprocess.Popen(['psql', '-d', db_name, '-X', '-t', '-A', '-c', sql],
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                             universal_newlines=True)
        try:
            out, _ = p.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            p.kill(); p.communicate()
            return []
        if p.returncode != 0:
            return []
        return [ln.strip() for ln in out.splitlines() if ln.strip()]
    except Exception:
        return []

def lookup_schema(db_name, raw_user, uid):
    """★按 unique_query_id (= 日志里的 「unique id」) 从 dbe_perf.statement_history 反查这条语句真正的 schema
    (用户 2026-09-28 定: 日志里只有 database 和 user, 老逻辑一律拿 user 当 schema,
    但 user != schema 的场景不少)。

    ★关键: 该字段不是单个 schema 名, 而是**执行时的 search_path 原串** —— 内核
    instr_statement.cpp:2171 里就是 「schema_name = namespace_search_path」
    (204 实测值形如 「"$user",public」)。所以必须按 PG 的解析规则自己挑:
      按 search_path 顺序, 逐项去引号/去空格, 「$user」 展开成语句的 user_name,
      取**第一个在 pg_namespace 里真实存在**的项 (PG 对不存在的项是静默跳过的,
      「"$user",public」 在 204 上因此落到 public -- 那里没有 vastbase schema)。
    取不到(视图不存在/无行/无权限/超时)返回 None, 由调用方回落原来的 user 口径。
    同一个 (库, id) 只查一次 (sqlhc 会对同一 id 多次调用 print_result)。"""
    # 只认纯数字: uid 来自日志的 unique id, 非数字说明调用方传错了东西 -> 直接回落。
    # 同时转义单引号 (SQL 字面量), 虽然纯数字下不可能出现。
    uid = (uid or '').strip()
    if not uid.isdigit():
        return None
    key = (db_name, uid)
    if key in _SCHEMA_CACHE:
        return _SCHEMA_CACHE[key]
    resolved = None
    try:
        lit = uid.replace("'", "''")
        q = ("select schema_name from dbe_perf.statement_history "
             "where unique_query_id = '%s' and schema_name is not null "
             "order by start_time desc limit 1" % lit)
        # ★连接库要挨个试 (2026-09-28 实测 204 发现的可见性怪癖): 同一个
        #   dbe_perf.statement_history, 从语句自己的库连过去**一行都看不到**, 从 postgres
        #   连过去能看到全部行 —— 实测 postgres=4 行, te/testdb/vastbase/vec 全 0, 连 te
        #   自己那条(db_name='te')从 te 也看不见。所以先试语句自己的库(有些环境是按库隔离
        #   的), 拿不到再试 postgres(204 就靠这一步命中)。每步都是 -tA 单行, 失败/超时
        #   由 _psql_query 吞掉返回空, 不会挂住 sqlhc。
        rows = []
        for cand_db in ([db_name] if db_name == 'postgres' else [db_name, 'postgres']):
            rows = _psql_query(cand_db, q)
            if rows:
                break
        if rows:
            # ★但 schema 是否存在, 必须回到**语句自己的库**里问 (pg_namespace 是按库的,
            #   拿 postgres 的 schema 列表去判另一个库的 schema 存在性是错的)。
            existing = set(_psql_query(db_name, "select nspname from pg_namespace"))
            for raw in rows[0].split(','):
                cand = raw.strip().strip('"').strip()
                if not cand:
                    continue
                if cand == '$user':
                    cand = raw_user
                if cand in existing:
                    resolved = cand
                    break
    except Exception:
        resolved = None
    _SCHEMA_CACHE[key] = resolved
    return resolved

def print_result(db_name, user_name, sql_raw, params, duration_ms, queryid=''):
    raw_user   = user_name.strip()             # 真正的执行用户: search_path 里 $user 的展开源
    user_name  = normalize_user(user_name)     # 老口径: 既当显示值, 也当反查不到时的回落值
    sql_final  = replace_params(sql_raw, params) if params else sql_raw
    formatted  = format_sql(sql_final)
    # ★schema 优先来自 statement_history 反查 (用户 2026-09-28 定), 查不到才回落
    #   (取值顺序与回落值见下面 schema 那几行 —— 2026-09-28 起回落值是 public, 不再是 user)。
    # ★键必须用 unique_id (日志里的 `unique id`, 也是用户传给 sqlhc 的那个参数), 不能用
    #   queryid —— 后者是日志里的 `queryid` 字段(64 位), 对应的是 statement_history 的
    #   **debug_query_id**。两个号的量级一眼可分: unique id 是 32 位(4041411893, 且
    #   history 里 4245863319 这种值 < 2^32), queryid 是 64 位(3659174700391258, 与
    #   history 的 debug_query_id 3659174700350359 同量级)。用错列 ⇒ 反查永远 0 行、
    #   功能静默失效。
    # ★schema 取值顺序 (用户 2026-09-28 最终口径):
    #     ① SQL 里的表带 schema -> 用带的 (extract_tables 内部处理, 见 _split_ident/_q_ident)
    #     ② 没带 -> 用按 unique_query_id 反查到的 schema (lookup_schema)
    #     ③ 反查不到 -> 用 **public** (★不再回落成 user 名: 老口径 normalize_user 会把
    #        非 vastbase 用户的名字当 schema, 用户明确否掉了; public 一定存在, 更安全)
    #   反查到的/回落的 schema 同时作为 extract_tables 里「未限定 schema 的表归属谁」的默认值。
    schema     = lookup_schema(db_name, raw_user, unique_id) or 'public'
    tables     = extract_tables(sql_final, schema)
    tables_str = '(' + ','.join(f"('{o}','{t}')" for o, t in tables) + ')'

    title = f'sqltext(database: {db_name}  user: {user_name}  schema: {schema})'
    sep   = '=' * display_width(title)
    print(sep)
    print(title)
    print(sep)
    print(formatted)

    meta = {
        'db':          db_name,
        'user':        user_name,
        'schema':      schema,
        'duration_ms': duration_ms,
        'tables':      [list(t) for t in tables],
        'sql':         sql_final,
        'queryid':     queryid,
    }
    print(f"__META__:{json.dumps(meta, ensure_ascii=False)}")
    sys.exit(0)

uid_esc          = re.escape(unique_id)
duration_val_re  = re.compile(r'duration:\s+([\d.]+)\s+ms',  re.IGNORECASE)
queryid_re       = re.compile(r'\bqueryid\s+(\d+)',           re.IGNORECASE)

format1_re = re.compile(
    r'\bunique\s+id\s+' + uid_esc +
    r'\s+(?:bind|execute)\s+\S+:\s*(.+)$',
    re.IGNORECASE
)
format2_re = re.compile(
    r'(?:LOG|INFO):\s+(?:execute|bind)\s+\S+\s+unique\s+id\s+' + uid_esc +
    r'\s*:\s*(.+)$',
    re.IGNORECASE
)
format3_re = re.compile(
    r'(?:LOG|INFO):\s+duration:\s+([\d.]+)\s+ms'
    r'(?:\s+queryid\s+(\d+))?'
    r'.*?\bunique\s+id\s+' + uid_esc +
    r'\s+execute\s+\S+:\s*(.+)$',
    re.IGNORECASE
)
inline_statement_re = re.compile(
    r'(?:LOG|INFO):\s+duration:\s+([\d.]+)\s+ms'
    r'(?:\s+queryid\s+(\d+))?'
    r'.*?\bunique\s+id\s+' + uid_esc +
    r'\s+statement:\s+(.+)$',
    re.IGNORECASE
)
duration_only_re = re.compile(
    r'(?:LOG|INFO):\s+duration:.*?\bunique\s+id\s+' + uid_esc + r'\s*$',
    re.IGNORECASE
)
statement_re = re.compile(r'(?:LOG|INFO):\s+statement:\s+(.+)$', re.IGNORECASE)
detail_re    = re.compile(r'DETAIL:\s+parameters:\s+(.+)$',       re.IGNORECASE)

_READ_LOG_MAX_BYTES = 2 * 1024 * 1024 * 1024  # 2GB guard, same as analyze v2
_READ_LOG_BACK  = 10001                       # lines kept before the hit (the look-back scans <=10000)
_READ_LOG_AHEAD = 20000                       # lines kept after the hit
def read_log_lines(path, needle):
    """Return ONLY a bounded slice around the FIRST line of `path` that contains
    `needle`: the `_READ_LOG_BACK` lines before it, that line, and the
    `_READ_LOG_AHEAD` lines after it. Both callers stop at the first match
    (their print_sql_text/print_result ends in sys.exit(0)) and the look-back
    scan reaches at most 10000 lines, so the slice is all they ever touch.

    Peak memory is O(back+ahead) lines, NOT O(file): the old fh.read(2GB)
    allocated a 2GB buffer up front (MemoryError on a host with <2GB free, which
    the caller swallowed as "unique_id not found"), and any whole-file read
    would hold a multi-GB log in RAM. An over-size file is rejected by SIZE
    (O(1) for plain files; a .gz is counted while streaming)."""
    import gzip
    import os
    from collections import deque
    is_gz = path.endswith('.gz')
    if not is_gz:
        try:
            if os.path.getsize(path) >= _READ_LOG_MAX_BYTES:
                print("Error: %s is too large (>= %d bytes); truncate or split it first"
                      % (path, _READ_LOG_MAX_BYTES), file=sys.stderr)
                sys.exit(1)
        except OSError:
            pass
    opener = gzip.open if is_gz else open

    # Log files may be UTF-8 (default), GB18030/GBK (Chinese sites) or anything
    # else; decode per line (a 0x0A newline never falls inside a multi-byte
    # sequence), latin-1 is the never-fail fallback.
    def _decode(bl):
        for enc in ('utf-8', 'gb18030'):
            try:
                return bl.decode(enc)
            except (UnicodeDecodeError, ValueError):
                continue
        return bl.decode('latin-1')

    win = deque(maxlen=_READ_LOG_BACK)
    total = 0
    hit_line = None
    tail = []
    with opener(path, 'rb') as fh:
        for bl in fh:
            total += len(bl)
            if total >= _READ_LOG_MAX_BYTES:
                print("Error: %s is too large (>= %d bytes); truncate or split it first"
                      % (path, _READ_LOG_MAX_BYTES), file=sys.stderr)
                sys.exit(1)
            line = _decode(bl).rstrip('\r\n')
            if hit_line is None:
                if needle in line:
                    hit_line = line
                else:
                    win.append(line)
                continue
            tail.append(line)
            if len(tail) >= _READ_LOG_AHEAD:
                break
    if hit_line is None:
        return []
    return list(win) + [hit_line] + tail

for logfile in logfiles:
    try:
        lines = read_log_lines(logfile, unique_id)
    except Exception:
        continue

    n = len(lines)

    for i, line in enumerate(lines):

        if unique_id not in line:
            continue

        def collect_sql_and_params(start_idx, sql_body):
            cont = []
            detail_text = None
            j = start_idx
            while j < n:
                ln = lines[j]
                dp = detail_re.search(ln)
                if dp:
                    detail_text = dp.group(1)
                    j += 1
                    while j < n and not header_re.match(lines[j]):
                        if not detail_re.search(lines[j]):
                            detail_text += lines[j]
                        j += 1
                    break
                if header_re.match(ln):
                    break
                cont.append(ln.strip())
                j += 1
            full_sql = ' '.join([sql_body] + [c for c in cont if c])
            params = parse_params(detail_text) if detail_text else None
            return full_sql, params

        m3 = format3_re.search(line)
        if m3:
            db_name, user_name, _ = extract_meta(line)
            duration_ms = float(m3.group(1))
            queryid     = m3.group(2) or ''
            sql_body    = m3.group(3).strip()
            full_sql, params = collect_sql_and_params(i + 1, sql_body)
            print_result(db_name, user_name, full_sql, params, duration_ms, queryid)

        m_inline = inline_statement_re.search(line) if not m3 else None
        if m_inline:
            db_name, user_name, _ = extract_meta(line)
            duration_ms = float(m_inline.group(1))
            queryid     = m_inline.group(2) or ''
            sql_body    = m_inline.group(3).strip()
            full_sql, _ = collect_sql_and_params(i + 1, sql_body)
            print_result(db_name, user_name, full_sql, None, duration_ms, queryid)

        m1 = format1_re.search(line) if not (m3 or m_inline) else None
        m2 = format2_re.search(line) if (not m1 and not m3 and not m_inline) else None
        m_exec = m1 or m2

        if m_exec:
            db_name, user_name, _ = extract_meta(line)
            sql_body = m_exec.group(1).strip()

            dm = duration_val_re.search(line)
            duration_ms = float(dm.group(1)) if dm else None

            qm = queryid_re.search(line)
            queryid = qm.group(1) if qm else ''

            full_sql, params = collect_sql_and_params(i + 1, sql_body)
            print_result(db_name, user_name, full_sql, params, duration_ms, queryid)

        elif duration_only_re.search(line) and not (m3 or m_inline):
            db_name, user_name, pid = extract_meta(line)

            dm = duration_val_re.search(line)
            duration_ms = float(dm.group(1)) if dm else None

            qm = queryid_re.search(line)
            queryid = qm.group(1) if qm else ''

            full_sql = None
            for j in range(i - 1, max(i - 10000, -1), -1):
                prev = lines[j]
                if pid:
                    _, _, prev_pid = extract_meta(prev)
                    if prev_pid and prev_pid != pid:
                        continue
                sm = statement_re.search(prev)
                if sm:
                    sql_head = sm.group(1).strip()
                    cont = []
                    for k in range(j + 1, i):
                        if header_re.match(lines[k]):
                            break
                        cont.append(lines[k].strip())
                    full_sql = ' '.join([sql_head] + cont)
                    break

            if full_sql:
                print_result(db_name, user_name, full_sql, None, duration_ms, queryid)

print(f"not found unique_id: {unique_id}", file=sys.stderr)
sys.exit(1)
