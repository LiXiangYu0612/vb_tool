FLAMEGRAPH_PL_EOF

    chmod +x "$FLAMEGRAPH_DIR/stackcollapse-perf.pl"
    chmod +x "$FLAMEGRAPH_DIR/flamegraph.pl"

    # ---------- perf record ----------
    local RECORD_CMD
    if [ -z "$PID" ]; then
        RECORD_CMD="perf record -F 99 -a -g -o $OUTPUT_DIR/perf.data -- sleep $SLEEP"
    else
        RECORD_CMD="perf record -F 99 -a -g -p $PID -o $OUTPUT_DIR/perf.data -- sleep $SLEEP"
    fi

    echo "====================================================================="
    echo "FlameGraph Collection Started"
    echo "====================================================================="
    echo "PID      : ${PID:-all processes}"
    echo "Duration : ${SLEEP}s"
    echo "Output   : $SVG_FILE"
    echo "====================================================================="
    echo "Running: $RECORD_CMD"
    eval $RECORD_CMD
    if [ $? -ne 0 ] || [ ! -s "$OUTPUT_DIR/perf.data" ]; then
        echo "Error: perf record failed (EACCES under perf_event_paranoid? wrong PID?) - no flame graph" >&2
        rm -f "$OUTPUT_DIR/perf.data"
        return 1
    fi

    # ---------- generate flame graph ----------
    echo "Generating folded stack data..."
    perf script -i "$OUTPUT_DIR/perf.data" > "$OUTPUT_DIR/perf.unfolded" || { echo "Error: perf script failed" >&2; return 1; }
    perl "$FLAMEGRAPH_DIR/stackcollapse-perf.pl" --all "$OUTPUT_DIR/perf.unfolded" > "$OUTPUT_DIR/perf.folded" || { echo "Error: stackcollapse-perf.pl failed" >&2; return 1; }

    echo "Generating flame graph..."
    perl "$FLAMEGRAPH_DIR/flamegraph.pl" "$OUTPUT_DIR/perf.folded" > "$SVG_FILE"
    local _vb_fg_rc=$?
    rm -f "$OUTPUT_DIR/perf.data" "$OUTPUT_DIR/perf.unfolded" "$OUTPUT_DIR/perf.folded"
    if [ $_vb_fg_rc -ne 0 ] || [ ! -s "$SVG_FILE" ]; then
        echo "Error: flamegraph.pl failed (empty folded stacks?)" >&2
        return 1
    fi

    echo "====================================================================="
    echo "Flame graph generated at $SVG_FILE"
    echo "====================================================================="
    return 0
}

