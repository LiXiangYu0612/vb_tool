    @staticmethod
    def generate_lock_event_section(lock_event_list):
        """
        生成 Top 10 锁定耗时情况 HTML 片段

        Args:
            lock_event_list: 锁事件记录列表，每项包含以下字段：
                timestamp, session_id, lock_type, target, wait_time_ms,
                event_kind, connection_key, log_text, sql_text

        Returns:
            str: HTML 字符串，如果没有锁事件记录则返回空字符串
        """
        if not lock_event_list:
            return ''

        # 合并同一次等待的 waiting + acquired 为一条记录
        # 按 (session_id, target, lock_type) 分组，waiting 被后续 acquired 吸收
        from collections import OrderedDict
        merged_events = OrderedDict()
        for ev in lock_event_list:
            session_id = ev.get('session_id', '')
            target = ev.get('target', '')
            lock_type = ev.get('lock_type', '')
            event_kind = ev.get('event_kind', '')
            key = (session_id, target, lock_type)

            if event_kind == 'waiting':
                if key not in merged_events:
                    merged_events[key] = {
                        'timestamp': ev.get('timestamp', ''),
                        'session_id': session_id,
                        'lock_type': lock_type,
                        'target': target,
                        'wait_time_ms': ev.get('wait_time_ms', 0),
                        'event_kind': 'waiting',
                        'connection_key': ev.get('connection_key', ''),
                        'log_text': ev.get('log_text', ''),
                        'sql_text': ev.get('sql_text', ''),
                        'unique_id': ev.get('unique_id', ''),
                        'txid': ev.get('txid', '')
                    }
            elif event_kind == 'acquired':
                if key in merged_events and merged_events[key]['event_kind'] == 'waiting':
                    # waiting 被 acquired 吸收：保留 waiting 的时间戳，总耗时 = waiting + acquired
                    waiting_ev = merged_events[key]
                    total_wait_ms = waiting_ev['wait_time_ms'] + ev.get('wait_time_ms', 0)
                    merged_events[key] = {
                        'timestamp': waiting_ev['timestamp'],
                        'session_id': session_id,
                        'lock_type': lock_type,
                        'target': target,
                        'wait_time_ms': total_wait_ms,
                        'event_kind': 'acquired',
                        'connection_key': ev.get('connection_key', ''),
                        'log_text': waiting_ev['log_text'] + '\n' + ev.get('log_text', ''),
                        'sql_text': ev.get('sql_text', '') or waiting_ev['sql_text'],
                        'unique_id': ev.get('unique_id', '') or waiting_ev['unique_id'],
                        'txid': ev.get('txid', '') or waiting_ev['txid']
                    }
                else:
                    # 没有 waiting 的 acquired（如等待时间极短）
                    merged_events[key] = {
                        'timestamp': ev.get('timestamp', ''),
                        'session_id': session_id,
                        'lock_type': lock_type,
                        'target': target,
                        'wait_time_ms': ev.get('wait_time_ms', 0),
                        'event_kind': 'acquired',
                        'connection_key': ev.get('connection_key', ''),
