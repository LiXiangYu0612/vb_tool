    fi
    # second word of ANY command: subcommands parsed from the command's own
    # help -- either a "<a|b|c>" alternation in the usage line (awr style)
    # or the indented list under "Types:" (asp style); cached per command
    if [ "$COMP_CWORD" -eq 2 ]; then
