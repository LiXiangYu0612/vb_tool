                 "memory.limit", "memsw.limit", "pids.max",
                 "cpuset.cpus", "cpuset.effective", "cpuset.mems")
        _CUMQ = ("cpuacct.usage", "memory.usage", "memory.failcnt", "pids.current")
        def _cfg_cell(k, raw):
            # normalize ONE side's raw value; M-1 (round-4): a truncated
            # snapshot (ENOSPC/copy cut) can leave "cpu.max|" EMPTY --
