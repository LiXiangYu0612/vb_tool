        # 要么缺席 (缺席区由每帧开头的变量复位渲染成 '-'), 陈旧数据上屏的老风险
        # 由复位块继续兜底。
        case "$db" in *"===EOD"*) ;; *) db="";; esac
        [ -n "$db" ] && db_ok=1 || db_ok=0
        # ★表头时间整体删除 (用户令 2026-11-16: "不要时间啊 因为 OS Statistics
        #   (xx) 这里有了啊 VASTBASE Statistics (xx)"): 双频采样后两横幅各自带
        #   采样时刻, 表头时钟彻底冗余 (中间曾改过锚采集时刻冻结/去日期, 终态=删)。
        db_dirty=1
        db_next=$((t1 / 1000 + interval))
