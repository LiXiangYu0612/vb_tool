def _ctxs_pretty(ctxs):
    """Top-3 context cell 'name(bytes), name(bytes), name(bytes)' with the byte
    counts rendered through fmt_bytes (user 2026-09-14: auto-unit the sizes).
    Parser-side so already-written sampler rows reformat too; any chunk that
    does not match name(bytes) passes through untouched."""
    out = []
    for chunk in (ctxs or "").split(", "):
        m = re.match(r"^(.*)\((\d+)\)$", chunk)
        if m:
            out.append("%s (%s)" % (m.group(1), fmt_bytes(int(m.group(2)))))
        elif chunk:
            out.append(chunk)
    return ", ".join(out)

