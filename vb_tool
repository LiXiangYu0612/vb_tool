def text_tcp(win, repl_dir=None):
    """awr tcp: DB-port socket states per minute -- LISTEN Recv-Q, TCP Total
    (incl. the listeners), the four common states, FIN-WAIT-1/2 as FW1/FW2,
    plus conntrack Used/Limit (columns only when the window has conntrack
    samples). Same columns as the html DB Process per-minute fold minus the
    fd buckets (user 2026-10-30); '-' = not sampled that minute."""
    lines = _text_banner("awr tcp detail", win)
    m = win["meta"]
    samples = (load_os_samples(repl_dir, m.get("begin_ts", ""), m.get("end_ts", ""))
               if repl_dir else {"files": []})
    if not samples.get("files"):
        lines.append("(no per-minute OS samples in this period -- the sampler runs")
        lines.append(" while 'awr enable' is on; manual snapshots alone carry no series)")
        return 0, "\n".join(lines)
    # window filter + dynamic rare-state columns (audit 2026-10-30): gauges
    # need no pre-begin warmup row, and TCP Total jumps with flat common
    # states must be attributable HERE the same way the html fold does it
    bts = str(m.get("begin_ts", ""))
    lq = {ts: p.split(",") for ts, p in samples.get("lstn", [])
          if not bts or ts >= bts}
    ls = {}
    for ts, p in samples.get("lstnsock", []):
        if bts and ts < bts:
            continue
        f = p.split(",")
        if len(f) == 2 and f[1].strip().isdecimal():
            ls.setdefault(ts, {})[f[0]] = int(f[1])
    ct = {}
    for ts, p in (samples.get("conntrack") or []):
        if bts and ts < bts:
            continue
        f = p.split(",")
        if len(f) == 2 and f[0].strip().isdecimal() and f[1].strip().isdecimal():
            ct[ts] = (int(f[0]), int(f[1]))
    if not (lq or ls or ct):
        lines.append("(no usable per-minute samples in this period)")
        return 0, "\n".join(lines)
    _std = ("ESTAB", "SYN-RECV", "TIME-WAIT", "CLOSE-WAIT")
    extra = sorted(s for d in ls.values() for s in d
                   if s not in _std and s != "LISTEN" and d.get(s)
                   and s not in ("FIN-WAIT-1", "FIN-WAIT-2"))
    headers = ["time", "LISTEN Recv-Q", "LISTEN Send-Q", "TCP Total", "ESTAB",
               "SYN-RECV", "TIME-WAIT", "CLOSE-WAIT", "FW-1/2"] + extra
    if ct:
        headers += ["Conntrack Used", "Conntrack Limit"]
    rows = []
    for ts in sorted(set(lq) | set(ls) | set(ct)):
        row = ls.get(ts, {})
        fw = ("%d/%d" % (row.get("FIN-WAIT-1", 0), row.get("FIN-WAIT-2", 0))
              if row else "-")
        q = lq.get(ts) or []
        r = [ts, q[0] if len(q) > 0 else "-", q[1] if len(q) > 1 else "-",
             str(sum(row.values())) if row else "-",
             row.get("ESTAB", "-"), row.get("SYN-RECV", "-"),
             row.get("TIME-WAIT", "-"), row.get("CLOSE-WAIT", "-"), fw]
        r += [row.get(s, "-") for s in extra]
        if ct:
            c = ct.get(ts)
            r += ([str(c[0]), str(c[1])] if c else ["-", "-"])
        rows.append(r)
    lines.append(_text_table(headers, rows, align="l" + "r" * (len(headers) - 1)))
    return 0, "\n".join(lines)

