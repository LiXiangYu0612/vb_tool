            _subs = _fd_reg_subs(_fdb, _fde)
            _tb = _te = 0
            for _fc in _FD_TOP:
                _isreg = _fc == "reg"
                _b = _fd_top(_fdb, _fc, _subs); _e = _fd_top(_fde, _fc, _subs)
                _tb += _b[0] + _b[1]; _te += _e[0] + _e[1]
                parts.append('<tr><td>%s</td><td class="n">%s</td>'
                             '<td class="n">%s</td><td class="n">%+d</td></tr>'
                             % (esc("fd " + _fc), esc(_fd_cell(_b, _isreg)),
                                esc(_fd_cell(_e, _isreg)),
                                (_e[0] + _e[1]) - (_b[0] + _b[1])))
                if _isreg:
                    # user 2026-09-20: $PGDATA (PGBASE) and $PGHOME are THE two
                    # first-level reg trees; indent is relative to the shallowest
                    # ANCESTOR present among the rows -- a key whose parent is
                    # absent starts its own tree at level 0, so roots of
                    # different absolute depths (/data/vastdata vs /home/
                    # vastbase/vasthome_29407) both sit at the top, and
                    # version.cfg nests under its PGHOME root
                    _sset = set(_subs)
                    _dcache = {}
                    def _treedepth(k):
                        if k in _dcache:
