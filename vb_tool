#     'virtual_transaction_id', # 9: 虚拟事务ID
#     'transaction_id',      # 10: 事务ID
#     'error_severity',      # 11: 错误级别(LOG, ERROR, WARNING等)
#     'sql_state_code',      # 12: SQL状态码
#     'message',             # 13: 日志消息
#     'detail',              # 14: 详细信息
