                        printf "${c_sec}[TOPSQL]${c_off}   ${c_lbl}%-11s %-15s %-10s %-13s %s${c_off}\n" "sqlid" "running_threads" "cpu_usage%" "total_time(s)" "sqltext"
                        section=TOP; continue;;
