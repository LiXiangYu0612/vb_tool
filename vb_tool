            rm -rf "$d" 2>/dev/null && scount=$((scount+1))
        done <<< "$expired"
    elif [ -d "$root" ]; then
        echo "  [WARN] python3 not found -- snap expiry scan skipped" >&2
    fi
    # repl_/slot_/os_/lt_/stack_<YYYYMMDD>.log[.gz]: delete only when the WHOLE day is before until
    local rcount=0 rf rd d_ep
    for rf in "$root"/repl_*.log "$root"/slot_*.log "$root"/walrcv_*.log "$root"/os_*.log "$root"/os_*.log.gz "$root"/lt_*.log "$root"/lt_*.log.gz "$root"/stack_*.log "$root"/stack_*.log.gz "$root"/sessmem_*.log "$root"/sessmem_*.log.gz "$root"/pw_*.log "$root"/pw_*.log.gz; do
        [ -f "$rf" ] || continue
        rd=$(basename "$rf"); rd="${rd%.gz}"; rd="${rd%.log}"
        rd="${rd#repl_}"; rd="${rd#slot_}"; rd="${rd#walrcv_}"; rd="${rd#os_}"; rd="${rd#lt_}"; rd="${rd#stack_}"; rd="${rd#sessmem_}"; rd="${rd#pw_}"
        case "$rd" in
            [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])
                d_ep=$(date -d "${rd:0:4}-${rd:4:2}-${rd:6:2}" +%s 2>/dev/null)
                if [ -n "$d_ep" ] && [ $((d_ep + 86399)) -lt "$until_ep" ]; then
                    rm -f "$rf"; rcount=$((rcount+1))
                fi;;
            *) echo "  [WARN] unrecognized repl log '$rf', skipped" >&2;;
        esac
    done
    local hcount=0 f mep
    # *.tar too (audit 2026-10-30): since v2.5.16 the tar IS the only artifact
    # that stays (html members are deleted on successful pack) -- without this
    # glob retention never touches the reports dir's real contents
    for f in "${VB_TOOL_HOME:-$HOME/.vb_tool}"/awr_reports/awr_*.html \
             "${VB_TOOL_HOME:-$HOME/.vb_tool}"/awr_reports/awr_*.tar \
             "${VB_TOOL_HOME:-$HOME/.vb_tool}"/awr_reports/awrdiff_*.html \
             "${VB_TOOL_HOME:-$HOME/.vb_tool}"/awr_reports/baseline_*.html; do
        [ -f "$f" ] || continue
        mep=$(stat -c %Y "$f" 2>/dev/null)
        if [ -n "$mep" ] && [ "$mep" -lt "$until_ep" ]; then
            rm -f "$f"; hcount=$((hcount+1))
        fi
    done
    echo "$scount $rcount $hcount"
}

# awr delete until <time>  -- manual one-shot purge (thin wrapper over the core).
_awr_delete_until() {
    local until_time="$1"
    if [ -z "$until_time" ]; then
        echo "Error: usage 'awr delete until <time>' (e.g. '2026-08-11' or '2026-08-11 12:00:00')" >&2
        return 2
    fi
    local until_ep
    until_ep=$(date -d "$until_time" +%s 2>/dev/null)
    if [ -z "$until_ep" ]; then echo "Error: invalid time '$until_time'" >&2; return 2; fi
    local counts
    counts=$(_awr_purge_core "$until_ep")
    set -- $counts
    echo "deleted $1 snap(s) (by ts), $2 sampler log(s) (by day), and $3 report file(s) (by mtime) older than $until_time"
    return 0
}

# _awr_retention_read  -> retention days from <root>/retention (default 8 when
# absent/garbage; 0 = keep forever). Echoed on stdout.
_awr_retention_read() {
    local root; root=$(_awr_root)
    local v
    v=$(cat "$root/retention" 2>/dev/null)
    case "$v" in ''|*[!0-9]*) v=8;; esac
    echo "$v"
}

# _awr_purge_expired  -- retention auto-purge (Oracle MMON style): delete snaps
# / repl+slot logs / html reports older than now - <retention> days. Prints ONE
# summary line only when something was actually removed (silent otherwise, so
# periodic 'awr create' output stays clean; WARN noise also suppressed).
# Runs after every successful create, after 'awr enable', and after
# 'awr config retention N' (N > 0).
_awr_purge_expired() {
    local days; days=$(_awr_retention_read)
    [ "$days" -eq 0 ] && return 0
    local cutoff_ep
    cutoff_ep=$(date -d "-$days days" +%s 2>/dev/null)
    [ -z "$cutoff_ep" ] && return 0
    local counts
    counts=$(_awr_purge_core "$cutoff_ep" 2>/dev/null)
    set -- $counts
    [ "$1" -eq 0 ] && [ "$2" -eq 0 ] && [ "$3" -eq 0 ] && return 0
    echo "awr auto-purge (retention ${days}d): removed $1 snap(s), $2 sampler log(s), $3 report file(s) older than $(date -d "@$cutoff_ep" '+%F %T' 2>/dev/null)"
    return 0
}

# _awr_interval_read  -> sampling interval minutes from <root>/interval
# (default 60 when absent/garbage). Echoed on stdout.
_awr_interval_read() {
    local root; root=$(_awr_root)
    local v
    v=$(cat "$root/interval" 2>/dev/null)
    case "$v" in ''|*[!0-9]*) v=60;; esac
    echo "$v"
}

# awr config <retention|interval> <value>  -- modify awr settings:
#   retention <days>  0 = keep forever (max 3650); purges already-expired
#                     snaps/repl+slot logs/html reports immediately
#   interval  <min>   10-1440, any value fires at EXACTLY that cadence (the
#                     snapshot entry wakes every minute and gates on this
#                     value); takes effect at the next boundary, no crontab
#                     rewrite needed
# No args: print current values + usage.
_awr_config() {
    local root; root=$(_awr_root)
    local what="${1:-}"
    if [ -z "$what" ]; then
        local r i
        r=$(_awr_retention_read); i=$(_awr_interval_read)
        echo "awr config:"
        if [ "$r" -eq 0 ]; then echo "  retention : 0 (never purge)"
        else echo "  retention : ${r} days"; fi
        echo "  interval  : ${i} min"
        local dd; dd=$(_awr_datadir_get)
        if [ -n "$dd" ]; then echo "  datadir   : $dd (root: $(_awr_root))"
        else echo "  datadir   : default (\$HOME)"; fi
        echo "usage: vb_tool awr config retention <days>   (0 = never purge, max 3650)"
        echo "       vb_tool awr config interval <min>     (10-1440)"
        echo "       vb_tool awr config datadir <dir>|default  (moves existing data; fails hard on error)"
        return 0
    fi
    local val="${2:-}"
    [ -z "$val" ] && { echo "Error: usage 'awr config $what <value>'" >&2; return 2; }
    shift 2
    [ $# -gt 0 ] && { echo "Error: unexpected argument '$1'" >&2; return 2; }
    case "$what" in
        datadir)
            _awr_datadir_migrate "$val"
            return $?
            ;;
        retention)
            case "$val" in ''|*[!0-9]*) echo "Error: retention expects a non-negative integer number of days (0 = never purge)" >&2; return 2;; esac
            [ "$val" -gt 3650 ] && { echo "Error: retention too large (max 3650 days); use 0 for keep-forever" >&2; return 2; }
            local old; old=$(_awr_retention_read)
            mkdir -p "$root" 2>/dev/null || { echo "Error: cannot create $root" >&2; return 1; }
            echo "$val" > "$root/retention" || { echo "Error: cannot write $root/retention" >&2; return 1; }
            if [ "$val" -eq 0 ]; then
                echo "awr config: retention ${old} -> 0 (never purge)"
                return 0
            fi
            echo "awr config: retention ${old} -> ${val} days"
            _awr_purge_expired
            return 0
            ;;
        interval)
            case "$val" in ''|*[!0-9]*) echo "Error: interval expects a positive integer number of minutes (10-1440)" >&2; return 2;; esac
            if [ "$val" -lt 10 ] || [ "$val" -gt 1440 ]; then
                echo "Error: interval must be 10-1440 minutes (the snapshot entry wakes every minute and gates on this value, so any cadence is exact)" >&2
                return 2
            fi
            local oldi; oldi=$(_awr_interval_read)
            mkdir -p "$root" 2>/dev/null || { echo "Error: cannot create $root" >&2; return 1; }
            echo "$val" > "$root/interval" || { echo "Error: cannot write $root/interval" >&2; return 1; }
            echo "awr config: interval ${oldi} -> ${val} min"
            # take effect immediately when already enabled: rewrite THIS port's
            # entries (same generator as enable; keeps sampler entry and other
            # ports' entries, heals half-open)
            local cport="${PGPORT:-5432}"
            # ★2026-10-11: 门控条目从 interval 文件现读节奏, 本端口正常条目不再
            #   重写; 重写只为迁移旧形(*/N 硬编码)或 legacy 无端口条目(D8)。
            _awr_cron_ensure_gated "$cport"
            case $? in
                0) echo "awr config: crontab entry ensured in gated form -- cadence follows the interval file = ${val}min exactly (legacy/old-form entries migrated)" ;;
                1) echo "Error: crontab rewrite failed -- interval file says ${val}min but the OLD crontab cadence may persist; re-run 'awr config interval <min>' or inspect crontab -l" >&2
                   return 1 ;;
                3) : ;;   # not enabled: nothing to rewrite, stay silent
                *) echo "Error: unexpected crontab helper rc=$?" >&2; return 1;;
            esac
            return 0
            ;;
        *)
            echo "Error: unknown config key '$what' (expect retention | interval)" >&2
            return 2;;
    esac
}

# ---- screen (text) reports: awr topsql/event/summary/tabstat ----
# wdr_* equivalents computed from LOCAL awr snapshots (a begin/end snap pair);
# aligned text table on stdout, no files written. All four share this helper:
# snap-id parsing/validation identical to awrrpt (incl. the restart guard).
# Extra tokens (-n/-m/-E/-d/-s/-t) pass through to the renderer verbatim.
_awr_text_report() {
    local section="$1"; shift
    local begin_id="" end_id="" pass=()
    while [ $# -gt 0 ]; do
        case "$1" in
            begin) [ $# -lt 2 ] && { echo "Error: 'begin' requires a snap_id" >&2; return 2; }
                   begin_id="$2"; shift 2;;
            end)   [ $# -lt 2 ] && { echo "Error: 'end' requires a snap_id" >&2; return 2; }
                   end_id="$2"; shift 2;;
            -h|--help) awr_help; return 0;;
            *)     pass+=("$1"); shift;;
        esac
    done
    if [ -z "$begin_id" ] || [ -z "$end_id" ]; then
        echo "Error: usage 'awr $section begin <snap_id> end <snap_id>' [options]" >&2; return 2
    fi
    # quote-proof -E/--event (user 2026-09-12): pasted commands often carry
    # CJK/curly quotes (“ ” ‘ ’), which the shell does NOT treat as quoting,
    # so `-E “flush data”` arrives as TWO args ('“flush' + 'data”'). Rejoin
    # the pieces up to the closing quote, then strip the pair. ASCII single/
    # double quotes are already consumed by the shell and pass through.
    local _qi _qj _qv _qop _qcl
    local -a _qfixed=()
    _qi=0
    while [ "$_qi" -lt "${#pass[@]}" ]; do
        _qv="${pass[$_qi]}"
        case "$_qv" in
            -E|--event)
                _qfixed+=("$_qv")
                _qop="${pass[$((_qi+1))]-}"; _qop="${_qop:0:1}"
                case "$_qop" in
                    '"') _qcl='"';;
                    "“") _qcl="”";;
                    "‘") _qcl="’";;
                    *)   _qcl="";;
                esac
                if [ -n "$_qcl" ]; then
                    _qj=$((_qi+1)); _qv="${pass[$_qj]}"
                    # walk REAL indices and build a new array: the old loop
                    # unset'd elements, and the holes made ${#pass[@]} smaller
                    # than the max index -- 3+ word values hung it forever
                    while [ "${#_qv}" -lt 2 ] || [ "${_qv: -1}" != "$_qcl" ]; do
                        [ $((_qj+1)) -lt ${#pass[@]} ] || break
                        _qj=$((_qj+1)); _qv="$_qv ${pass[$_qj]}"
                    done
                    if [ "${#_qv}" -ge 2 ] && [ "${_qv: -1}" = "$_qcl" ]; then
                        _qv="${_qv:1:$(( ${#_qv} - 2 ))}"    # strip the quote pair
                    fi
                    _qfixed+=("$_qv")
                    _qi=$_qj
                fi
                ;;
            *) _qfixed+=("$_qv");;
        esac
        _qi=$((_qi+1))
    done
    pass=("${_qfixed[@]}")
    local root; root=$(_awr_snap_root "$begin_id" "$end_id") || return 1
    local bdir="$root/snap_$begin_id" edir="$root/snap_$end_id"
    # OS-only sections (cpu/io/page) render per-minute /proc samples between
    # the window edges -- those counters do NOT reset on a DB restart, so a
    # crash gap between the snaps is still a valid window for them (user
    # 2026-10-30: crash 取证时 OS 侧必须可出). DB-backed sections keep the
    # restart guard (cumulative counters reset => deltas would lie).
    if [ "$begin_id" -ge "$end_id" ] 2>/dev/null; then
        echo "Error: begin snap ($begin_id) must be LOWER than end snap ($end_id) -- 1-snap windows (begin==end) have no delta to render" >&2
        # rc=1 (data error): caller already gave clear guidance; awr_help would be noise
        return 1
    fi
    case "$section" in
        cpu|io|page|mem|net|tcp|tcpstat|fd) ;;   # OS-only: per-minute instantaneous /proc samples, no DB cumulative counters (8 cmds, keep in sync with the usage line)
        *) _awr_check_uptime "$bdir" "$edir" || return 1;;
    esac
    _awr_render --begin "$bdir" --end "$edir" --text "$section" --repl-dir "$root" --sqltext-root "$(_awr_root)" "${pass[@]}"
}

_awr_topsql()  { _awr_text_report topsql  "$@"; }
_awr_event()   { _awr_text_report event   "$@"; }
_awr_summary() { _awr_text_report summary "$@"; }
_awr_tabstat() { _awr_text_report tabstat "$@"; }
