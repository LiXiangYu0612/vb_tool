            RAISE INFO '%', lpad(' ', 37, ' ') || substr(rec.setting, 101, 100);
        ELSE
            RAISE INFO '%: %', lpad(rec.name, 35, ' '), rec.setting;
        END IF;
    END LOOP;
END \$\$;
" 2>&1 | awk '{gsub(/INFO:/, ""); print}'
}

# Resolve a relxlog WAL argument: segment filename or LSN (X/Y).
# For an LSN, locate the containing segment file in wal_dir (echo its name,
# return nonzero if not found or ambiguous across timelines).
wal_arg_resolve() {
    local arg="$1" wal_dir="$2"
    if [[ "$arg" =~ ^[0-9A-Fa-f]{1,8}/[0-9A-Fa-f]{1,8}$ ]]; then
        local hi lo suffix candidates
        hi=$((16#${arg%%/*}))
        lo=$((16#${arg##*/}))
        suffix=$(printf "%08X%08X" "$hi" $(( (lo >> 24) & 0xFF )))
        candidates=$(ls "$wal_dir" 2>/dev/null | grep -E "^[0-9A-Fa-f]{8}${suffix}$" | sort -u)
        if [ -z "$candidates" ]; then
            echo "Error: LSN $arg falls in WAL segment *${suffix}, no matching file in $wal_dir" >&2
            return 1
        fi
        if [ "$(echo "$candidates" | wc -l)" -gt 1 ]; then
            echo "Error: LSN $arg matches WAL files on multiple timelines in $wal_dir:" >&2
            echo "$candidates" | sed 's/^/  /' >&2
            echo "Please specify the segment filename directly." >&2
            return 1
        fi
        echo "$candidates"
    elif [[ "$arg" =~ ^[0-9A-Fa-f]{24}$ ]]; then
        echo "$arg"
    else
        echo "Error: invalid WAL argument '$arg' (expect 24-hex segment name or LSN like 8/42000028)" >&2
        return 1
    fi
}

run_relxlog() {

    start_wal="$1"
    end_wal="$2"
    local wal_dir="${3:-${PGDATA}/pg_xlog}"

    if [ -z "$start_wal" ] || [ -z "$end_wal" ]; then
        echo "Error: Missing required parameters" >&2
        echo "Usage: vb_tool relxlog <start_wal|lsn> <end_wal|lsn> [wal_dir]" >&2
        echo "Example: vb_tool relxlog 000000010000000800000042 00000001000000080000004C" >&2
        echo "         vb_tool relxlog 8/42000028 8/4C000000" >&2
        exit 1
    fi

    local start_file end_file lsn_opts=()
    start_file=$(wal_arg_resolve "$start_wal" "$wal_dir") || exit 1
    end_file=$(wal_arg_resolve "$end_wal" "$wal_dir") || exit 1
    [[ "$start_wal" == */* ]] && lsn_opts+=(-s "$start_wal")
    [[ "$end_wal" == */* ]] && lsn_opts+=(-e "$end_wal")

    # ★管道 rc 修复 (2026-11-26): 原写法 pg_xlogdump | awk, 函数返回码=awk 的 0,
    # 段被 recycle/权限不足时 stderr 有报错但 rc=0 输出空表假成功。改为先落临时
    # 文件并检查 pg_xlogdump 返回码, awk 读文件(大段 dump 不进 shell 变量)。
    if ! command -v pg_xlogdump >/dev/null 2>&1; then
        echo "Error: pg_xlogdump not found in PATH" >&2
        exit 1
    fi
    local dump errout
    dump=$(mktemp /tmp/vb_relxlog_dump.XXXXXX) || exit 1
    errout=$(mktemp /tmp/vb_relxlog_err.XXXXXX) || { rm -f "$dump"; exit 1; }
    if ! pg_xlogdump -p "$wal_dir" ${lsn_opts[@]+"${lsn_opts[@]}"} "$start_file" "$end_file" >"$dump" 2>"$errout"; then
        echo "Error: pg_xlogdump failed:" >&2
        cat "$errout" >&2
        rm -f "$dump" "$errout"
        exit 1
    fi
    rm -f "$errout"

    awk '/REDO/{
        type=$19" - "$21;
        size=$15;
        gsub($15,";","");
        type_cnt[type]++;
        type_size[type]+=size;
        total_size+=size;
        total_entries++;
        if (match($0, / rel [0-9]+\/[0-9]+(\/[0-9]+)?/)) {
            rel = substr($0, RSTART+5, RLENGTH-5);
            rel_cnt[rel]++;
            rel_size[rel]+=size;
            rel_total_size+=size;
        }
    }
    END{
            PROCINFO["sorted_in"]="@val_num_desc"
            printf("%12s %12s %8s %-50s \n","RedoSize(k)","RedoEntries","%Size","Type")
            cnt=0;
            for (type in type_size) {
                if (++cnt > 30) break;
                printf("%12.1f %12d %7.1f%% %-50s\n", 
                       type_size[type]/1024,
                       type_cnt[type],
                       (type_size[type]/total_size)*100,
                       type);
            }
            
            FS="/"
            printf("\n\n%12s %12s %8s %-10s %-10s\n","RedoSize(k)","RedoEntries","%Size","DBID","RelID")
            cnt=0;
            for (rel in rel_size) {
                if (++cnt > 30) break;
                $0=rel;
                printf("%12.1f %12d %7.1f%% %-10s %-10s\n",
                       rel_size[rel]/1024,
                       rel_cnt[rel],
                       (rel_size[rel]/rel_total_size)*100,
                       $2,$3);
            };
    }' "$dump"
    rc=$?
    rm -f "$dump"
    return $rc
}

