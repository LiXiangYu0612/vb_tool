            _any = True
            parts.append('<tr><td>%s</td>%s</tr>'
                         % (esc(nid), "".join('<td class="n">%s</td>' % c for c in _cells)))
        if not _any:
            parts.append('<tr><td colspan="10" class="note">no data</td></tr>')
        parts.append('</table>')
    sub("System Activity")
    _t1, _t2 = osd1.get("tcp") or {}, osd2.get("tcp") or {}
    # one-sided presence shows the column with '-' on the missing side (audit
    # 2026-10-30): the old and/or asymmetry hid TCP when one side was an old
    # snap while rendering forks as fake 0.0
    _has_f = osd1.get("forks_per_sec") is not None or osd2.get("forks_per_sec") is not None
    _has_t = _t1.get("opens_per_sec") is not None or _t2.get("opens_per_sec") is not None
    _hdr = '<th class="n">Context Switches</th><th class="n">Interrupts</th>'
    if _has_f: _hdr += '<th class="n">Forks</th>'
    if _has_t: _hdr += '<th class="n">TCP Opens</th><th class="n">TCP Retrans</th>'
    _c1 = [(osd1.get("ctxt_per_sec", 0) or 0), (osd1.get("intr_per_sec", 0) or 0)]
    _c2 = [(osd2.get("ctxt_per_sec", 0) or 0), (osd2.get("intr_per_sec", 0) or 0)]
    if _has_f:
        _c1.append(osd1.get("forks_per_sec"))
        _c2.append(osd2.get("forks_per_sec"))
    if _has_t:
        _c1 += [_t1.get("opens_per_sec"), _t1.get("retrans_per_sec")]
        _c2 += [_t2.get("opens_per_sec"), _t2.get("retrans_per_sec")]
    def _row(label, vals, plus):
        _f1, _f2 = ("%+.0f", "%.1f") if plus else ("%.0f", "%.1f")
        def _fmt(f, v):
            return "-" if v is None else f % v
        # first two cols integer, extras one/two decimals
        cells = ['<td class="n">%s</td>' % _fmt(_f1, vals[0]), '<td class="n">%s</td>' % _fmt(_f1, vals[1])]
        for i, v in enumerate(vals[2:]):
            cells.append('<td class="n">%s</td>' % _fmt((_f2 if i < 1 else "%.2f" if not plus else "%+.2f"), v))
        return '<tr><td class="k">%s</td>%s</tr>' % (label, "".join(cells))
    parts.append('<table class="t"><tr><th></th>%s</tr>' % _hdr)
    parts.append(_row("P1", _c1, False))
    parts.append(_row("P2", _c2, False))
    parts.append(_row("delta", [(b - a) if (a is not None and b is not None) else None
                                for a, b in zip(_c1, _c2)], True))
    parts.append('</table>')
    sub("OS Memory - period-end snapshot, MB")
    _m1 = parse_meminfo(win1["os"].get(("end", "meminfo"), ""))
    _m2 = parse_meminfo(win2["os"].get(("end", "meminfo"), ""))
    parts.append('<table class="t"><tr><th>Metric</th><th class="n">P1 MB</th>'
                 '<th class="n">P2 MB</th><th class="n">Delta MB</th></tr>')
    for lbl in ("MemTotal", "MemFree", "MemAvailable", "Buffers", "Cached", "Active",
