def _split_param_segments(params):
    """按引号外的逗号拆分 parameters 字符串。

    引号内的逗号（如 '$1 = "a,b"'）不作为分隔符；
    括号内的逗号（如 type = numeric(10,2)）也不作为分隔符。
    """
    segments, buf = [], []
    i, in_quote, depth = 0, False, 0
    while i < len(params):
        c = params[i]
        if in_quote:
            buf.append(c)
            if c == "'":
                if i + 1 < len(params) and params[i + 1] == "'":
                    buf.append(params[i + 1])
                    i += 2
                    continue
                in_quote = False
            i += 1
        else:
            if c == "'":
                in_quote = True
                buf.append(c)
                i += 1
            elif c == '(':
                depth += 1
                buf.append(c)
                i += 1
            elif c == ')':
                depth = max(0, depth - 1)
                buf.append(c)
                i += 1
            elif c == ',' and depth == 0:
                segments.append(''.join(buf))
                buf = []
                i += 1
            else:
                buf.append(c)
                i += 1
    segments.append(''.join(buf))
    return segments


def _parse_bind_params(params):
    """解析 parameters 字符串为 (编号, 值, 类型) 列表。

    支持两种格式:
      - 新格式（带绑定变量类型）: $1 = '100' type = bigint, $2 = 'abc' type = text
      - 旧格式: $1 = 'value1', $2 = 'value2'

    type = xxx 是绑定变量的类型标注而非值的一部分；仅在引号外识别，
    避免把值内部的 " type = " 字样误判为类型标注。

    Returns:
        list: [(param_num_str, value, type_or_None), ...] 按出现顺序
    """
    parsed = []
    for seg in _split_param_segments(params):
        seg = seg.strip()
        if not seg:
            continue
        m = re.match(r'\$(\d+)\s*=\s*(.*)$', seg, re.DOTALL)
        if not m:
            continue
        param_num, rest = m.group(1), m.group(2).strip()
        ptype = None
        if rest.startswith("'"):
            # 带引号值: 提取到闭引号（'' 转义），尾部再识别 type = xxx
            j = 1
            while j < len(rest):
                if rest[j] == "'":
                    if j + 1 < len(rest) and rest[j + 1] == "'":
                        j += 2
                        continue
                    break
                j += 1
            value = rest[:j + 1] if j < len(rest) else rest
            tail = rest[len(value):].strip()
            tm = re.match(r'type\s*=\s*(.+)$', tail, re.DOTALL)
            if tm:
                ptype = tm.group(1).strip()
        else:
            # 无引号值（NULL/数字/标识符）: 按空白分割出 type = xxx 后缀
            tm = re.search(r'\s+type\s*=\s*(\S.*)$', rest, re.DOTALL)
            if tm:
                value = rest[:tm.start()].strip()
                ptype = tm.group(1).strip()
            else:
                value = rest
        parsed.append((param_num, value, ptype))
    return parsed


def _is_numeric_bind_type(ptype):
    """判断绑定变量类型是否为数值类型（如 bigint、numeric(10,2)、double precision）。"""
    if not ptype:
        return False
    base = ptype.strip().lower().split('(')[0].strip()
    return base in _NUMERIC_TYPE_NAMES


def _prepare_param_types(query_template, params_text):
    """生成 prepare 声明用的参数类型序列（按占位符编号升序）。

    类型来自 parameters 日志的 type = xxx 标注；缺失/无标注的参数回退为 text。
    类型间用 '|' 连接（类型名不会含 '|'，且能容纳 numeric(10,2) 这类带逗号类型），
    供前端 data-param-types 属性使用。

    Returns:
        str: 如 'varchar|bigint|text'；无占位符时返回 ''
    """
    params = sorted({int(n) for n in re.findall(r'\$(\d+)', query_template)})
    if not params:
        return ''
    type_map = {}
    for num, _val, ptype in _parse_bind_params(params_text or ''):
        type_map[int(num)] = (ptype or 'text').strip()
    return '|'.join(type_map.get(n, 'text') for n in params)


def _substitute_placeholders(query_text, param_dict):
    """单次扫描替换 SQL 中的 $n 占位符，跳过字面量与注释。

    逐占位符正则替换的复杂度为 O(参数个数 × SQL 长度)，对超长 SQL 耗时不可控；
    这里按字符单次扫描：仅在引号（'' / ""）和注释（-- / /* */）之外替换 $n，
    复杂度降为 O(SQL 长度)，且 $1 天然不会误吃 $10。

    替换值来自字典查找，不存在反斜杠/分组符被 re 解释的问题；
    无对应参数的占位符保留原文，便于排查参数缺失。
    """
    out = []
    i, n = 0, len(query_text)
    while i < n:
        c = query_text[i]
        # -- 行注释
        if c == '-' and i + 1 < n and query_text[i + 1] == '-':
            j = query_text.find('\n', i)
            j = n if j < 0 else j
            out.append(query_text[i:j])
            i = j
        # /* */ 块注释（支持嵌套）
        elif c == '/' and i + 1 < n and query_text[i + 1] == '*':
            depth = 1
            j = i + 2
            while j < n and depth > 0:
                if query_text[j] == '/' and j + 1 < n and query_text[j + 1] == '*':
                    depth += 1
                    j += 2
                elif query_text[j] == '*' and j + 1 < n and query_text[j + 1] == '/':
                    depth -= 1
                    j += 2
                else:
                    j += 1
            out.append(query_text[i:j])
            i = j
        # ' 单引号字面量（'' 转义）
        elif c == "'":
            j = i + 1
            while j < n:
                if query_text[j] == "'":
                    if j + 1 < n and query_text[j + 1] == "'":
                        j += 2
                        continue
                    j += 1
                    break
                j += 1
            out.append(query_text[i:j])
            i = j
        # " 双引号标识符（"" 转义）
        elif c == '"':
            j = i + 1
            while j < n:
                if query_text[j] == '"':
                    if j + 1 < n and query_text[j + 1] == '"':
                        j += 2
                        continue
                    j += 1
                    break
                j += 1
            out.append(query_text[i:j])
            i = j
        # $n 占位符：仅在此处替换
        elif c == '$' and i + 1 < n and query_text[i + 1].isdigit():
            j = i + 1
            while j < n and query_text[j].isdigit():
                j += 1
            placeholder = query_text[i:j]
            out.append(param_dict.get(placeholder, placeholder))
            i = j
        else:
            out.append(c)
            i += 1
    return ''.join(out)


def fill_sql_params(query_text, params):
    """
    填充SQL变量，将参数值替换到SQL语句中

    数值类型的绑定变量（type = bigint 等）替换时去掉引号；
    parameters 原文以 -- 注释追加到 SQL 文本末尾，便于对照。

    Args:
        query_text (str): 原始SQL语句
        params (str): 参数字符串

    Returns:
        tuple: (filled_query, param_values) - 填充变量后的SQL语句和参数值列表
    """
    if not params or params.strip() == '':
        return query_text, []

    # 所有 SQL（含超长）都执行占位符替换；超长带来的体积/卡顿风险由
    # 展示层的 MAX_HTML_INLINE_SQL_LEN 截断与 Base64 压缩下载承担。

    # 解析参数字符串: $1 = 'value1' [type = xxx], $2 = 'value2', ...
    param_dict = {}   # 占位符 -> 替换用值（数值类型已去引号）
    param_list = []   # 按参数编号顺序存储原始参数值（保留引号，用于 execute 语句拼接）
    for param_num, value, ptype in _parse_bind_params(params):
        # 替换值: 数值类型且值是带引号纯数字时去引号（如 '100' -> 100）
        subst = value
        if (_is_numeric_bind_type(ptype) and len(value) >= 2
                and value[0] == "'" and value[-1] == "'"
                and _NUMERIC_LITERAL_RE.match(value[1:-1])):
            subst = value[1:-1]
        param_dict[f'${param_num}'] = subst

        # 确保param_list按参数编号顺序排列
        param_index = int(param_num) - 1
        while len(param_list) <= param_index:
            param_list.append(None)
        param_list[param_index] = value

    # 过滤掉None值（如果没有按顺序提供所有参数）
    filtered_param_list = [param for param in param_list if param is not None]

    # parameters 原文以 -- 注释追加到 SQL 文本，便于值与语句对照
    param_lines = params.strip().splitlines()
    param_comment = '-- parameters: ' + param_lines[0]
    for line in param_lines[1:]:
        param_comment += '\n-- ' + line

    # 单次扫描替换全部 $n 占位符，跳过字符串字面量/标识符与注释
    filled_query = _substitute_placeholders(query_text, param_dict)

    return filled_query.rstrip('\n') + '\n' + param_comment, filtered_param_list


def normalize_sql_for_display(sql_text):
    """
    规范化用于 HTML 展示的 SQL 文本：
    - 统一换行符
    - 删除空行（只含空白字符的行），避免出现大片空白
    - 去除首尾空白
    """
    if not sql_text:
        return sql_text
    text = sql_text.replace('\r\n', '\n').replace('\r', '\n')
    # 删除空行：将连续的空行（只含空白字符）压缩为一个换行
    text = re.sub(r'\n\s*\n+', '\n', text)
    return text.strip()



def process_single_file(file_name, args, total_elapsed_time=0):
    """
    处理单个日志文件
    
    Args:
        file_name (str): 日志文件名
        args: 命令行参数
        
    Returns:
        tuple: (total_list, file_size_mb) - 解析结果和文件大小
    """
    print(f"\n正在处理文件: {file_name}")
    
    # 使用优化的文件读取
    content = read_log_file_stream(file_name)
    
    # 检查文件大小并给出优化建议
    file_size = len(content)
    file_size_mb = file_size / (1024 * 1024)
    print(f"文件大小: {file_size_mb:.2f} MB")
    

    
    # 使用预编译的正则表达式分割日志
    blocks = TIMESTAMP_PATTERN.split(content)[1:]
    if not blocks:
        print("警告: 未在文件中找到符合格式的日志记录")
        return [], [], file_size_mb, [], [], []

    # -d 按行过滤：丢弃超出 now - N天 的日志块（-f 指定文件时同样生效；
    # 显式 -b 指定的开始时间优先于 -d；天数下界不会越过 -e 结束时间）
    if args.days is not None:
        v_days_cutoff = datetime.now() - timedelta(days=args.days)
        v_eff_begin = parse_datetime(args.begin) if args.begin else None
        if v_eff_begin is not None and v_eff_begin > v_days_cutoff:
            # -b 比 -d 更晚（范围更窄），-d 裁剪交由 -b 逻辑处理
            v_days_cutoff = None
        else:
            v_end_time = parse_datetime(args.end) if args.end else None
            if v_end_time is not None and v_days_cutoff > v_end_time:
                # -d 下界越过 -e 会导致范围为空，此时以 -b/-e 范围为准
                v_days_cutoff = None
        if v_days_cutoff is not None:
            _di = 0
            while _di + 1 < len(blocks):
                _dts = parse_datetime(blocks[_di])
                if _dts is not None and _dts >= v_days_cutoff:
                    break
                _di += 2
            if _di >= len(blocks):
                print(f"提示: 文件内所有日志均早于 {v_days_cutoff}（-d {args.days}），跳过该文件")
                return [], [], file_size_mb, [], [], []
            if _di > 0:
                print(f"按 -d {args.days} 过滤: 丢弃前 {_di // 2} 条超出时间范围的日志块（早于 {v_days_cutoff}）")
                blocks = blocks[_di:]

    # Parse start and end times（更健壮的跨文件范围过滤）
    start_n = 0
    earliest_ts = parse_datetime(blocks[0])
    latest_ts = parse_datetime(blocks[-2])
    # 处理 begin
    if args.begin:
        v_begin = parse_datetime(args.begin)
        if v_begin is not None:
            # 开始时间晚于文件最后时间 → 跳过该文件
            if v_begin > latest_ts:
                return [], [], file_size_mb, [], [], []
            # 开始时间早于等于文件最早时间 → 从头开始
            elif v_begin <= earliest_ts:
                start_n = 0
            else:
                # 在文件范围内，定位起始块索引
                for i in range(0, len(blocks)-2, 2):
                    timestamp1 = parse_datetime(blocks[i])
                    timestamp2 = parse_datetime(blocks[i+2])
                    if v_begin <= timestamp2 and v_begin >= timestamp1:
                        start_n = i
                        break
        # 无法解析 begin 则忽略，由后续逻辑处理
    # 处理 end
    if args.end:
        v_end = parse_datetime(args.end)
        if v_end is not None:
            # 结束时间早于文件最早时间 → 跳过该文件
            if v_end < earliest_ts:
                return [], [], file_size_mb, [], [], []
            # 结束时间早于文件最后时间 → 裁剪 blocks
            elif v_end < latest_ts:
                matching_index = -2
                for i in range(len(blocks)-2, -2, -2):
                    time_value = parse_datetime(blocks[i])
                    if time_value <= v_end:
                        matching_index = i
                        break
                if matching_index != -2:
                    blocks = blocks[:matching_index+2]

    # Set the analysis type
    e_type =  'slow'

    # 初始化结果收集列表
    total_list = []
    deadlock_list = []
    lock_event_list = []
    lock_chain_list = []
    error_list = []

    # 仅在 --mode error/all 时提取错误日志，query 模式不提取
    analyze_errors = (args.mode.lower() in ('error', 'all'))

    # Process logs based on the analysis type
    if e_type == 'slow':
        # 单次扫描同时解析慢SQL、死锁和锁事件
        parse_all_events(start_n, blocks, total_list, deadlock_list, lock_event_list, lock_chain_list, total_elapsed_time, log_format_info, error_list if analyze_errors else None)
    else:
        print(f'Error: not support type {e_type}')
        return [], [], file_size_mb, [], [], []
    
    print(f"文件 {file_name} 处理完成，找到 {len(total_list)} 条慢SQL记录，{len(deadlock_list)} 条死锁记录，{len(lock_event_list)} 条锁事件记录，{len(lock_chain_list)} 条锁等待链记录，{len(error_list)} 条错误/警告记录")

    # 显式释放大内存变量
    del blocks
    del content

    # 检查内存使用情况
    check_memory_usage(2048)  # 2GB 阈值

    # 进行垃圾回收，释放内存
    gc.collect()

    return total_list, deadlock_list, file_size_mb, lock_event_list, lock_chain_list, error_list

def process_multiple_files(file_names, args):
    """
    处理多个日志文件
    
    Args:
        file_names (list): 日志文件名列表
        args: 命令行参数
        
    Returns:
        tuple: (all_total_list, all_deadlock_list, total_size, total_elapsed_time, all_lock_event_list, all_lock_chain_list)
    """
    all_total_list = []
    all_deadlock_list = []
    all_lock_event_list = []
    all_lock_chain_list = []
    all_error_list = []
    total_size = 0
    total_elapsed_time = 0  # 总耗时
    
    print(f"开始处理 {len(file_names)} 个日志文件...")
    
    for i, file_name in enumerate(file_names, 1):
        print(f"\n{'='*60}")
        print(f"处理进度: {i}/{len(file_names)}")
        
        try:
            file_start_time = datetime.now()  # 记录单个文件开始时间
            total_list, deadlock_list, file_size_mb, lock_event_list, lock_chain_list, error_list = process_single_file(file_name, args, total_elapsed_time)
            file_end_time = datetime.now()  # 记录单个文件结束时间
            file_elapsed_time = int((file_end_time - file_start_time).total_seconds())
            total_elapsed_time += file_elapsed_time  # 累加总耗时
            
            all_total_list.extend(total_list)
            all_deadlock_list.extend(deadlock_list)
            all_lock_event_list.extend(lock_event_list)
            all_lock_chain_list.extend(lock_chain_list)
            all_error_list.extend(error_list)
            total_size += file_size_mb

            # 显式释放当前文件的列表引用
            del total_list
            del deadlock_list
            del lock_event_list
            del lock_chain_list
            del error_list
            
            # 进行垃圾回收，释放内存
            gc.collect()
            
        except Exception as e:
            print(f"处理文件 {file_name} 时出错: {str(e)}")
            continue
    
    print(f"\n{'='*60}")
    print(f"所有文件处理完成!")
    print(f"总文件大小: {total_size:.2f} MB")
    print(f"总慢SQL记录数: {len(all_total_list)} 条")
    print(f"总死锁记录数: {len(all_deadlock_list)} 条")
    print(f"总锁事件记录数: {len(all_lock_event_list)} 条")
    print(f"总锁等待链记录数: {len(all_lock_chain_list)} 条")
    print(f"总错误/警告记录数: {len(all_error_list)} 条")
    print(f"总耗时: {total_elapsed_time}秒")

    return all_total_list, all_deadlock_list, total_size, total_elapsed_time, all_lock_event_list, all_lock_chain_list, all_error_list


