    try:
        p = subprocess.Popen(
            ['psql', '-t', '-A', '-c', "SHOW config_file", '-d', 'postgres'],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True
        )
        try:
            stdout, _ = p.communicate(timeout=5)
        except subprocess.TimeoutExpired:
