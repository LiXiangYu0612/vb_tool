    @staticmethod
    def _get_interval_minutes(dim_id):
        """根据维度ID获取间隔分钟数"""
        if dim_id == 'minute':
            return 1
        elif dim_id == '10minute':
            return 10
        elif dim_id == 'hour':
            return 60
        elif dim_id == 'day':
            return 1440
        elif dim_id.endswith('minute'):
            return int(dim_id.replace('minute', ''))
        else:
            return 9999
    
    @staticmethod
    def _get_time_key(dt, dim_id):
        """根据维度ID生成时间键"""
        interval = ReportGenerator._get_interval_minutes(dim_id)
        
        if dim_id == 'minute':
            return dt.strftime('%Y-%m-%d %H:%M')
        elif dim_id == 'hour':
            return dt.strftime('%Y-%m-%d %H:00')
        elif dim_id == 'day':
            return dt.strftime('%Y-%m-%d')
        else:
            # 10minute 或其他动态维度：格式 YYYY-MM-DD HH:MM-HH:MM 或 YYYY-MM-DD HH:MM-YYYY-MM-DD HH:MM
            start_min = (dt.minute // interval) * interval
            start_dt = datetime(dt.year, dt.month, dt.day, dt.hour, start_min)
            end_dt = start_dt + timedelta(minutes=interval - 1)
            # 如果跨天了，结束时间显示完整日期
            if end_dt.date() != start_dt.date():
                return f"{start_dt.strftime('%Y-%m-%d %H:%M')}-{end_dt.strftime('%Y-%m-%d %H:%M')}"
            else:
                return f"{start_dt.strftime('%Y-%m-%d %H:%M')}-{end_dt.strftime('%H:%M')}"
    
    @staticmethod
    def _parse_time_label(time_label, dim_id):
        """将时间标签解析为datetime对象"""
        if dim_id == 'minute':
            return datetime.strptime(time_label, '%Y-%m-%d %H:%M')
        elif dim_id == 'hour':
            return datetime.strptime(time_label, '%Y-%m-%d %H:00')
        elif dim_id == 'day':
            return datetime.strptime(time_label, '%Y-%m-%d')
        else:
            # 10minute 或其他动态维度：格式 2025-06-04 07:35-08:09 或 2025-06-04 23:30-2025-06-05 00:09
            # 前16个字符是开始时间：YYYY-MM-DD HH:MM
            start_part = time_label[:16]
            return datetime.strptime(start_part, '%Y-%m-%d %H:%M')
    
    @staticmethod
    def generate_time_analysis(all_total_list, overall_min_time, overall_max_time, diff_interval=None, diff_interval_str=None):
        """生成SQL分时段分析部分的HTML和图表数据。
        
        Args:
            all_total_list: 所有慢查询记录列表
            overall_min_time: 报告整体开始时间
            overall_max_time: 报告整体结束时间
            diff_interval: 对比时间间隔（timedelta对象），None表示不生成对比数据
            diff_interval_str: 对比时间间隔字符串（如 30m, 1h, 1d），用于显示
        
        Returns:
            dict: 包含各维度HTML片段和图表数据的字典
        """
        # 将字符串时间转换为datetime对象（如果传入的是字符串）
        if isinstance(overall_min_time, str):
            overall_min_time = parse_datetime(overall_min_time)
        if isinstance(overall_max_time, str):
            overall_max_time = parse_datetime(overall_max_time)
        
        # 检查时间范围是否有效
        if overall_min_time is None or overall_max_time is None:
            print("警告: 时间范围无效，无法生成时段分析")
            return {'by_minute': {'show': False, 'html': '', 'chart_data': {}},
                   'by_10minute': {'show': False, 'html': '', 'chart_data': {}},
                   'by_hour': {'show': False, 'html': '', 'chart_data': {}},
                   'by_day': {'show': False, 'html': '', 'chart_data': {}}}
        
        # 初始化维度配置（复制基础配置）
        dimensions = [dim.copy() for dim in ReportGenerator.TIME_DIMENSIONS]
        
        # 根据 diff_interval 动态添加额外的维度
        if diff_interval and diff_interval_str:
            diff_minutes = int(diff_interval.total_seconds() / 60)
            # 检查是否需要添加动态维度（不在固定维度列表中）
            existing_intervals = [dim['interval_minutes'] for dim in dimensions]
            if diff_minutes not in existing_intervals and diff_minutes > 1:
                # 添加动态维度
                dynamic_dim = {
                    'id': f"{diff_minutes}minute",
                    'name': f"每{diff_minutes}分钟",
                    'interval_minutes': diff_minutes,
                    'always_show': True,
                    'diff_threshold_minutes': diff_minutes
                }
                dimensions.append(dynamic_dim)
        
        # 初始化结果字典
        analysis_result = {}
        for dim in dimensions:
            analysis_result[f"by_{dim['id']}"] = {'show': False, 'html': '', 'chart_data': {}}

        # 聚合数据（按所有维度和SQL类型）
        all_dim_data_dml = {}  # {dim_id: {time_key: {uid: count}}}
        all_dim_data_ddl = {}  # {dim_id: {time_key: {uid: count}}}
        for dim in dimensions:
            all_dim_data_dml[dim['id']] = defaultdict(lambda: defaultdict(int))
            all_dim_data_ddl[dim['id']] = defaultdict(lambda: defaultdict(int))

        for record in all_total_list:
            dt = record['time']
            uid = record['unique_id']
            sql_type = record.get('sql_type', 'dml')
            for dim in dimensions:
                time_key = ReportGenerator._get_time_key(dt, dim['id'])
                if sql_type == 'ddl':
                    all_dim_data_ddl[dim['id']][time_key][uid] += 1
                else:
                    all_dim_data_dml[dim['id']][time_key][uid] += 1
        
        # 确定需要展示哪些维度
        # 根据--diff参数调整维度的always_show属性
        # 如果--diff参数指定的间隔小于某个维度的间隔时，该维度的always_show设为False
        diff_minutes_val = diff_interval.total_seconds() / 60 if diff_interval else None
        if diff_minutes_val is not None:
            for dim in dimensions:
                if dim['interval_minutes'] > diff_minutes_val:
                    dim['always_show'] = False
        
        # 确定需要展示哪些维度
        for dim in dimensions:
            if dim['always_show']:
                analysis_result[f"by_{dim['id']}"]['show'] = True
        
        # 生成对比数据
        diff_data = None
        if diff_interval:
            diff_minutes = diff_interval.total_seconds() / 60
            
            # 计算对比时间范围
            diff_start = overall_min_time - diff_interval
            diff_end = overall_max_time - diff_interval
            
            # 检查是否有对比时间范围内的数据
            has_diff_data = False
            for record in all_total_list:
                if diff_start <= record['time'] <= diff_end:
                    has_diff_data = True
                    break
            
            if has_diff_data:
                diff_data = {
                    'start': diff_start,
                    'end': diff_end
                }
                
                # 聚合对比数据
                for dim in dimensions:
                    # 根据对比间隔判断是否显示该维度的对比数据
                    if diff_minutes >= dim['diff_threshold_minutes']:
                        diff_dim_data = defaultdict(lambda: defaultdict(int))
                        for record in all_total_list:
                            dt = record['time']
                            if diff_start <= dt <= diff_end:
                                uid = record['unique_id']
                                time_key = ReportGenerator._get_time_key(dt, dim['id'])
                                diff_dim_data[time_key][uid] += 1
                        diff_data[dim['id']] = diff_dim_data
                
                print(f"找到对比数据，时间范围: {diff_start.strftime('%Y-%m-%d %H:%M:%S')} 至 {diff_end.strftime('%Y-%m-%d %H:%M:%S')}，对比间隔: {diff_interval_str}")
            else:
                print(f"未找到对比时间范围 {diff_start.strftime('%Y-%m-%d %H:%M:%S')} 至 {diff_end.strftime('%Y-%m-%d %H:%M:%S')} 内的数据，不生成对比数据，对比间隔: {diff_interval_str}")
        
        # 生成各维度HTML和图表数据
        for dim in dimensions:
            if analysis_result[f"by_{dim['id']}"]['show']:
                # 分别生成 DML 和 DDL 的图表数据
                chart_data_dml = ReportGenerator._generate_chart_data_for_dimension(
                    all_dim_data_dml[dim['id']], dim['id'], overall_min_time, overall_max_time
                )
                chart_data_ddl = ReportGenerator._generate_chart_data_for_dimension(
                    all_dim_data_ddl[dim['id']], dim['id'], overall_min_time, overall_max_time
                )
                
                # 合并为统一结构
                combined_chart_data = {
                    'dml': chart_data_dml,
                    'ddl': chart_data_ddl
                }
                
                # 生成HTML表格（分别生成 DQL 和 DDL 两套）
                html_parts_dml, _ = ReportGenerator._generate_time_dimension_html(
                    all_dim_data_dml[dim['id']], dim['id'], dim['name'], overall_min_time, overall_max_time,
                    diff_data.get(dim['id']) if diff_data else None,
                    diff_interval, diff_interval_str, sql_type='dml'
                )
                html_parts_ddl, _ = ReportGenerator._generate_time_dimension_html(
                    all_dim_data_ddl[dim['id']], dim['id'], dim['name'], overall_min_time, overall_max_time,
                    diff_data.get(dim['id']) if diff_data else None,
                    diff_interval, diff_interval_str, sql_type='ddl'
                )

                # 合并两套表格到一个维度容器中，通过 data-sql-type 控制显隐
                combined_html = f'''
                <div class="time-dimension" id="dim-{dim['id']}">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <h3>{dim['name']}维度统计 (Top 10)</h3>
                        <a href="#top10-ranking" class="back-to-top" title="返回Top 10排名" onclick="collapseAllDetails()">↑ Top 10</a>
                    </div>
                    <div class="time-range-note">
                        <span>统计时间范围: {overall_min_time.strftime('%Y-%m-%d %H:%M:%S')} 至 {overall_max_time.strftime('%Y-%m-%d %H:%M:%S')}</span>
                        <button class="expand-btn expand-btn-all-inline" onclick="expandPeriodDimensionAll('{dim['id']}', this)" style="display:none;">
                            <span class="expand-text">展开全部</span>
                            <span class="collapse-text" style="display:none;">收起全部</span>
                        </button>
                    </div>
                    <div class="period-sql-type-container" data-sql-type="dml">
                        {html_parts_dml}
                    </div>
                    <div class="period-sql-type-container" data-sql-type="ddl" style="display:none;">
                        {html_parts_ddl}
                    </div>
                </div>
                '''

                analysis_result[f"by_{dim['id']}"]['html'] = combined_html
                analysis_result[f"by_{dim['id']}"]['chart_data'] = combined_chart_data
        
        return analysis_result

    @staticmethod
    def _generate_chart_data_for_dimension(time_data, dim_id, start_dt, end_dt):
        """生成指定时间维度的图表数据（不含HTML表格）。

        Args:
            time_data: 当前时间数据 {time_label: {uid: count}}
            dim_id: 维度ID (minute/hour/day/10minute)
            start_dt: 开始时间
            end_dt: 结束时间

        Returns:
            dict: {time_labels: [...], series: [...]}
        """
        chart_data = {'time_labels': [], 'series': []}

        # 根据维度ID确定时间间隔
        interval_minutes = ReportGenerator._get_interval_minutes(dim_id)

        if dim_id == 'minute':
            delta = timedelta(minutes=1)
            current = datetime(start_dt.year, start_dt.month, start_dt.day, start_dt.hour, start_dt.minute)
            end = datetime(end_dt.year, end_dt.month, end_dt.day, end_dt.hour, end_dt.minute)
        elif dim_id == 'hour':
            delta = timedelta(hours=1)
            current = datetime(start_dt.year, start_dt.month, start_dt.day, start_dt.hour)
            end = datetime(end_dt.year, end_dt.month, end_dt.day, end_dt.hour)
        elif dim_id == 'day':
            delta = timedelta(days=1)
            current = datetime(start_dt.year, start_dt.month, start_dt.day)
            end = datetime(end_dt.year, end_dt.month, end_dt.day)
        else:
            # 10minute 或其他动态维度
            delta = timedelta(minutes=interval_minutes)
            start_minute = (start_dt.minute // interval_minutes) * interval_minutes
            current = datetime(start_dt.year, start_dt.month, start_dt.day, start_dt.hour, start_minute)
            end_minute = ((end_dt.minute // interval_minutes) + 1) * interval_minutes
            end = datetime(end_dt.year, end_dt.month, end_dt.day, end_dt.hour) + timedelta(minutes=end_minute)

        # 收集所有时间点
        while current <= end:
            time_label = ReportGenerator._get_time_key(current, dim_id)
            chart_data['time_labels'].append(time_label)
            current += delta

        full_labels = chart_data['time_labels']
        if len(full_labels) < 2:
            return {'time_labels': [], 'series': []}

        label_indices = list(range(len(full_labels)))

        # 取总执行次数Top 10的UID
        total_counts_per_uid = defaultdict(int)
        for time_label, uid_counts in time_data.items():
            for uid, count in uid_counts.items():
                total_counts_per_uid[uid] += count
        top10_uids = [uid for uid, _ in sorted(total_counts_per_uid.items(), key=lambda x: x[1], reverse=True)[:10]]

        # 为Top 10 UID分配颜色
        color_palette = [
            '#FF6B6B', '#4ECDC4', '#FFD166', '#06D6A0', '#118AB2',
            '#EF476F', '#7BDFF2', '#B388EB', '#8093F1', '#FF9A76'
        ]
        uid_colors = {}
        for i, uid in enumerate(top10_uids):
            uid_colors[uid] = color_palette[i % len(color_palette)]

        # 为每个Top UID生成数据序列
        for uid in top10_uids:
            uid_escaped = html.escape(str(uid).strip(), quote=True)
            uid_safe = ReportGenerator._make_id_safe(uid)
            series = {'uid': uid_safe, 'uid_display': uid_escaped, 'color': uid_colors[uid], 'data': []}
            for idx in label_indices:
                time_label = full_labels[idx]
                series['data'].append(time_data.get(time_label, {}).get(uid, 0))
            chart_data['series'].append(series)

        return chart_data
    
    @staticmethod
    def _generate_time_dimension_html(time_data, dim_id, dim_name, start_dt, end_dt, diff_data=None, diff_interval=None, diff_interval_str=None, sql_type=None):
        """生成指定时间维度（分/时/天）的HTML表格和图表数据。

        Args:
            time_data: 当前时间数据 {time_label: {uid: count}}
            dim_id: 维度ID (minute/hour/day/10minute)
            dim_name: 维度名称
            start_dt: 开始时间
            end_dt: 结束时间
            diff_data: 对比数据 {time_label: {uid: count}}，None表示不生成对比数据
            diff_interval: 对比时间间隔（timedelta对象），用于计算对比时间标签
            diff_interval_str: 对比时间间隔字符串（如 30m, 1h, 1d），用于显示
            sql_type: SQL类型 ('dml' 或 'ddl')，用于标记表格归属
        """
        html_parts = []
        chart_data = {
            'time_labels': [],
            'series': []
        }
        
        # 根据维度ID确定时间间隔
        interval_minutes = ReportGenerator._get_interval_minutes(dim_id)
        
        if dim_id == 'minute':
            delta = timedelta(minutes=1)
            current = datetime(start_dt.year, start_dt.month, start_dt.day, start_dt.hour, start_dt.minute)
            end = datetime(end_dt.year, end_dt.month, end_dt.day, end_dt.hour, end_dt.minute)
        elif dim_id == 'hour':
            delta = timedelta(hours=1)
            current = datetime(start_dt.year, start_dt.month, start_dt.day, start_dt.hour)
            end = datetime(end_dt.year, end_dt.month, end_dt.day, end_dt.hour)
        elif dim_id == 'day':
            delta = timedelta(days=1)
            current = datetime(start_dt.year, start_dt.month, start_dt.day)
            end = datetime(end_dt.year, end_dt.month, end_dt.day)
        else:
            # 10minute 或其他动态维度：将起始时间向下对齐、结束时间向上对齐到区间边界
            delta = timedelta(minutes=interval_minutes)
            start_minute = (start_dt.minute // interval_minutes) * interval_minutes
            current = datetime(start_dt.year, start_dt.month, start_dt.day, start_dt.hour, start_minute)
            # 结束时间对齐到下一个区间边界（确保包含 end_dt 所在区间）
            end_minute = ((end_dt.minute // interval_minutes) + 1) * interval_minutes
            end_hour = end_dt.hour
            end_day = end_dt.day
            end_month = end_dt.month
            end_year = end_dt.year
            if end_minute >= 60:
                end_hour += 1
                end_minute = end_minute % 60
                if end_hour >= 24:
                    end_hour = end_hour % 24
                    end_dt_aligned = datetime(end_year, end_month, end_day, end_hour, end_minute)
                    end_dt_aligned += timedelta(days=1)
                    end = end_dt_aligned.replace(hour=end_hour, minute=end_minute)
                else:
                    end = datetime(end_year, end_month, end_day, end_hour, end_minute)
            else:
                end = datetime(end_year, end_month, end_day, end_hour, end_minute)
        
        # 收集所有时间点
        while current <= end:
            time_label = ReportGenerator._get_time_key(current, dim_id)
            chart_data['time_labels'].append(time_label)
            current += delta
        
        full_labels = chart_data['time_labels']
        if len(full_labels) < 2:
            # 时间点不足2个时，不生成折线图数据（只保留汇总表格）
            chart_data = {'time_labels': [], 'series': []}
            label_indices = []
        else:
            label_indices = list(range(len(full_labels)))
        
        # 取总执行次数Top 10的UID
        total_counts_per_uid = defaultdict(int)
        for time_label, uid_counts in time_data.items():
            for uid, count in uid_counts.items():
                total_counts_per_uid[uid] += count
        top10_uids = [uid for uid, _ in sorted(total_counts_per_uid.items(), key=lambda x: x[1], reverse=True)[:10]]
        
        # 为Top 10 UID分配颜色
        color_palette = [
            '#FF6B6B', '#4ECDC4', '#FFD166', '#06D6A0', '#118AB2',
            '#EF476F', '#7BDFF2', '#B388EB', '#8093F1', '#FF9A76'
        ]
        uid_colors = {}
        for i, uid in enumerate(top10_uids):
            uid_colors[uid] = color_palette[i % len(color_palette)]
        
        # 为每个Top UID生成数据序列
        for uid in top10_uids:
            uid_escaped = html.escape(str(uid).strip(), quote=True)
            uid_safe = ReportGenerator._make_id_safe(uid)
            series = {'uid': uid_safe, 'uid_display': uid_escaped, 'color': uid_colors[uid], 'data': []}
            for idx in label_indices:
                time_label = full_labels[idx]
                series['data'].append(time_data.get(time_label, {}).get(uid, 0))
            chart_data['series'].append(series)
        
        # 生成HTML表格（汇总表格）
        show_diff_column = diff_data is not None

        if sql_type:
            # 当指定 sql_type 时，只生成内部表格内容，由外层容器控制显隐
            pass
        else:
            # 兼容旧调用方式：生成完整维度容器
            html_parts.append(f"""
            <div class="time-dimension" id="dim-{dim_id}">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <h3>{dim_name}维度统计 (Top 10)</h3>
                    <a href="#top10-ranking" class="back-to-top" title="返回Top 10排名" onclick="collapseAllDetails()">↑ Top 10</a>
                </div>
                <div class="time-range-note">
                    <span>统计时间范围: {start_dt.strftime('%Y-%m-%d %H:%M:%S')} 至 {end_dt.strftime('%Y-%m-%d %H:%M:%S')}</span>
                    <button class="expand-btn expand-btn-all-inline" onclick="expandPeriodDimensionAll('{dim_id}', this)" style="display:none;">
                        <span class="expand-text">展开全部</span>
                        <span class="collapse-text" style="display:none;">收起全部</span>
                    </button>
                </div>
            """)
        
        if show_diff_column and diff_interval:
            # 有对比数据时，按时间配对显示（当前时间-对比时间）
            # 收集当前时间和对应的对比时间数据
            paired_rows = []
            sorted_times = sorted(time_data.items(), key=lambda x: x[0], reverse=True)
            period_index = 0
            
            for time_label, uid_counts in sorted_times:
                top10_in_period = sorted(uid_counts.items(), key=lambda x: x[1], reverse=True)[:10]
                if not top10_in_period:
                    continue
                
                # 计算对比时间标签
                try:
                    current_dt = ReportGenerator._parse_time_label(time_label, dim_id)
                    diff_dt = current_dt - diff_interval
                    diff_time_label = ReportGenerator._get_time_key(diff_dt, dim_id)
                except (ValueError, IndexError):
                    diff_time_label = None
                
                # 获取对比时间的数据
                diff_uid_counts = diff_data.get(diff_time_label, {}) if diff_time_label else {}
                
                bg_color = 'rgba(220, 220, 220, 0.7)' if period_index % 2 == 0 else 'rgba(245, 245, 245, 0.9)'
                
                for uid, count in top10_in_period:
                    uid_escaped = html.escape(str(uid).strip(), quote=True)
                    uid_safe = ReportGenerator._make_id_safe(uid)
                    
                    # 计算对比值
                    diff_count = diff_uid_counts.get(uid, 0)
                    if uid in diff_uid_counts:
                        diff_value = count - diff_count
                        if diff_value > 0:
                            diff_display = f"+{diff_value}"
                        elif diff_value < 0:
                            diff_display = f"{diff_value}"
                        else:
                            diff_display = "0"
                    else:
                        diff_display = "+"
                        diff_count = 0
                    
                    paired_rows.append({
                        'current_time': time_label,
                        'diff_time': diff_time_label if diff_time_label else '-',
                        'uid': uid_escaped,
                        'uid_safe': uid_safe,
                        'current_count': count,
                        'diff_count': diff_count,
                        'diff_display': diff_display,
                        'bg_color': bg_color
                    })
                period_index += 1
            
            # 将配对数据分配到多个表格中（最多2个表格）
            if not paired_rows:
                html_parts.append('</div>')
                return ''.join(html_parts), chart_data
            num_tables = min(2, len(paired_rows))
            rows_per_table = (len(paired_rows) + num_tables - 1) // num_tables
            
            dim_container_id = f"period-dim-container-{dim_id}"
            html_parts.append(f'<div class="period-dim-container" id="{dim_container_id}">')
            
            for table_idx in range(num_tables):
                start_row = table_idx * rows_per_table
                end_row = min(start_row + rows_per_table, len(paired_rows))
                table_rows = paired_rows[start_row:end_row]
                
                table_id = f"period-table-{dim_id}-{table_idx}"
                html_parts.append(f"""
                <div class="period-table-cell">
                <table class="period-table" id="{table_id}" data-dim-id="{dim_id}">
                    <tr><th>当前时间</th><th>对比时间</th><th>Unique ID</th><th>当前次数</th><th>对比次数</th><th>差异</th></tr>
                """)
                
                row_count = 0
                for row in table_rows:
                    row_count += 1
                    row_class = "period-row-hidden" if row_count > 10 else ""
                    diff_style = ''
                    if row['diff_display']:
                        if row['diff_display'].startswith('+') and row['diff_display'] != '+':
                            diff_style = 'color: #e74c3c; font-weight: bold;'
                        elif row['diff_display'].startswith('-'):
                            diff_style = 'color: #27ae60; font-weight: bold;'
                        elif row['diff_display'] == '+':
                            diff_style = 'color: #e74c3c; font-weight: bold;'
                    
                    html_parts.append(f"""
                        <tr class="{row_class}" style="background-color: {row['bg_color']};">
                            <td>{row['current_time']}</td>
                            <td>{row['diff_time']}</td>
                            <td><a href="#detail-{row['uid_safe']}" class="uid-link" onclick="goToDetail('{row['uid_safe']}', event)">{row['uid']}</a></td>
                            <td>{row['current_count']}</td>
                            <td>{row['diff_count']}</td>
                            <td style="{diff_style}">{row['diff_display']}</td>
                        </tr>
                    """)
                
                html_parts.append("""
                </table>
                """)
                
                if len(table_rows) > 10:
                    html_parts.append(f"""
                    <div class="period-table-arrow" data-table-id="{table_id}" data-dim-id="{dim_id}" onclick="expandPeriodTableStep('{table_id}', '{dim_id}', this)">
                        <svg viewBox="0 0 24 24" width="16" height="16"><path d="M7 10l5 5 5-5z" fill="#3498db"/></svg>
                    </div>
                    """)
                
                html_parts.append('</div>')
            
            html_parts.append('</div>')
        else:
            # 没有对比数据时，保持原来的单表格布局
            all_rows = []
            sorted_times = sorted(time_data.items(), key=lambda x: x[0], reverse=True)
            period_index = 0
            for time_label, uid_counts in sorted_times:
                top10_in_period = sorted(uid_counts.items(), key=lambda x: x[1], reverse=True)[:10]
                if not top10_in_period:
                    continue
                
                bg_color = 'rgba(220, 220, 220, 0.7)' if period_index % 2 == 0 else 'rgba(245, 245, 245, 0.9)'
                
                for uid, count in top10_in_period:
                    uid_escaped = html.escape(str(uid).strip(), quote=True)
                    uid_safe = ReportGenerator._make_id_safe(uid)
                    all_rows.append((time_label, uid_escaped, uid_safe, count, bg_color))
                period_index += 1
            
            # 将数据分配到多个表格中（最多2个表格）
            if not all_rows:
                html_parts.append('</div>')
                return ''.join(html_parts), chart_data
            num_tables = min(2, len(all_rows))
            rows_per_table = (len(all_rows) + num_tables - 1) // num_tables
            
            dim_container_id = f"period-dim-container-{dim_id}"
            html_parts.append(f'<div class="period-dim-container" id="{dim_container_id}">')
            
            for table_idx in range(num_tables):
                start_row = table_idx * rows_per_table
                end_row = min(start_row + rows_per_table, len(all_rows))
                table_rows = all_rows[start_row:end_row]
                
                table_id = f"period-table-{dim_id}-{table_idx}"
                html_parts.append(f"""
                <div class="period-table-cell">
                <table class="period-table" id="{table_id}" data-dim-id="{dim_id}">
                    <tr><th>时间段</th><th>Unique ID</th><th>执行次数</th></tr>
