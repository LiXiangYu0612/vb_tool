collect_log_help() {
    echo "Usage: vb_tool collect_log [-b <begin_time>] [-e <end_time>] [-n <max_xlog>] [-u <db_user>] [-g] [-z <backup_path>]"
    echo "Description: collect logs for cluster or single node"
    echo ""
    echo "Options:"
    echo "    -b    Begin time (format: 'YYYY-MM-DD HH:MM:SS'). Optional, see -e."
    echo "    -e    End time (format: 'YYYY-MM-DD HH:MM:SS'). Optional."
    echo "          When both -b and -e are omitted, the last 2 hours are collected"
    echo "          (begin = now-2h, end = now). The two options must be given together."
    echo "    -n    Maximum number of xlog files to collect (0-1024)."
    echo "          Set to 0 to skip xlog collection. Default: 50."
    echo "    -u    Database OS user (e.g., vastbase). Required if running as root."
    echo "          When specified, collects system logs (/var/log/messages, cron) "
    echo "          before switching to the database user context."
    echo "    -g    Cluster mode. Collect logs from all nodes in the cluster."
    echo "          If not specified, only the current node's logs are collected."
    echo "    -z    Backup catalog path; equivalent to pg_probackup -B <backup_path>."
    echo "          Default: /backup/backup."
    echo ""
    echo "Examples:"
    echo "    # No time range: defaults to the last 2 hours:"
    echo "    vb_tool collect_log"
    echo ""
    echo "    # Run as database user (Current node only):"
    echo "    vb_tool collect_log -b '2026-03-08 10:00:00' -e '2026-03-08 11:00:00'"
    echo ""
    echo "    # Run as root to include system logs (Cluster-wide):"
    echo "    vb_tool collect_log -b '2026-03-08 10:00:00' -e '2026-03-08 11:00:00' -u vastbase -g"
    echo ""
}

stack_help() {
    echo "Usage: vb_tool stack [-P <port>] [-n <samples>] [-d <interval_sec>] [-o <outfile>]"
    echo ""
    echo "Description:"
    echo "    Capture N stack snapshots of the database instance via 'vb_ctl stack';"
    echo "    each sample is aggregated separately, Percona pt-pmp style: identical"
    echo "    stack chains are counted together and listed by frequency. Chain format:"
    echo "    leaf <- caller <- caller's caller ('<-' reads as 'called by'),"
    echo "    so the innermost frame leads each chain. A quick 'what are the"
    echo "    threads doing' profile without gdb/pstack."
    echo ""
    echo "Options:"
    echo "    -P <port>   database port to trace (default: \$PGPORT, then 5432)"
    echo "    -n <count>  number of samples (default: 3, max: 50)"
    echo "    -d <sec>    seconds between samples (default: 3)"
    echo "    -o <file>   output file: summary + raw samples (default: ./stack_\$(date +%Y%m%d_%H%M%S).txt)"
    echo ""
    echo "Examples:"
    echo "    vb_tool stack"
    echo "    vb_tool stack -P 5432 -n 5 -d 2"
    echo "    vb_tool stack -n 10 -d 1 -o /tmp/vdb1_stack.txt"
    echo ""
}

