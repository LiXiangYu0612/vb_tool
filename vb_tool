    @staticmethod
    def generate_full_html_report(sorted_data, summary_info, time_analysis_info, overall_min_time, overall_max_time, total_size_mb_all, total_elapsed_seconds_all, all_total_list, deadlock_list=None, lock_event_list=None, lock_chain_list=None, error_list=None, statement_filter='query', sqlhc_data=None, opt_params_info=None, debug=False, connection_stats=None):
