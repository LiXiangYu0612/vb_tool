def proc_cpu_full(txt):
    """Aggregate 'cpu ' jiffies: user/nice/system/idle/iowait/irq/softirq/steal/busy/total."""
    z = {"user":0.0,"nice":0.0,"system":0.0,"idle":0.0,"iowait":0.0,
         "irq":0.0,"softirq":0.0,"steal":0.0,"busy":0.0,"total":0.0}
    for line in (txt or "").splitlines():
        if line.startswith("cpu ") or line.rstrip() == "cpu":
            vals = [to_num(x) for x in line.split()[1:]]
            # user nice system idle iowait irq softirq steal guest guest_nice
            z["user"]    = vals[0] if len(vals) > 0 else 0.0
            z["nice"]    = vals[1] if len(vals) > 1 else 0.0
            z["system"]  = vals[2] if len(vals) > 2 else 0.0
            z["idle"]    = vals[3] if len(vals) > 3 else 0.0
            z["iowait"]  = vals[4] if len(vals) > 4 else 0.0
            z["irq"]     = vals[5] if len(vals) > 5 else 0.0
            z["softirq"] = vals[6] if len(vals) > 6 else 0.0
            z["steal"]   = vals[7] if len(vals) > 7 else 0.0
            z["busy"]    = z["user"]+z["nice"]+z["system"]+z["irq"]+z["softirq"]+z["steal"]
            z["total"]   = z["busy"] + z["idle"] + z["iowait"]
            return z
    return z

def parse_cpuinfo(txt):
    """CPU hardware info from /proc/cpuinfo (mirrors vb_tool workload _print_sysinfo):
    model / sockets / cores per socket / threads per core / logical CPUs + MHz summary.
    Sockets: distinct 'physical id' (VMs without it -> 1). Freq: per-cpu 'cpu MHz'
    min/max/avg. Returns {} when cpuinfo absent (older snaps) so callers degrade gracefully."""
    info = {"model": "", "sockets": 0, "cores_per_socket": 0, "total_cores": 0,
            "threads_per_core": 0, "logical_cpus": 0,
            "freq_min_mhz": 0.0, "freq_max_mhz": 0.0, "freq_avg_mhz": 0.0}
    phys_ids = set()
    freqs = []
    logical = 0
    for line in (txt or "").splitlines():
        f = line.split(":", 1)
        if len(f) != 2:
            continue
        k = f[0].strip(); v = f[1].strip()
        if k == "processor":
            logical += 1
        elif k == "model name" and not info["model"]:
            info["model"] = v
        elif k == "physical id":
            phys_ids.add(v)
        elif k == "cpu cores" and not info["cores_per_socket"]:
            try: info["cores_per_socket"] = int(v)
            except Exception: pass
        elif k == "cpu MHz":
            try: freqs.append(float(v))
            except Exception: pass
    if not logical:
        return {}
    info["logical_cpus"] = logical
    info["sockets"] = len(phys_ids) if phys_ids else 1
    if not info["cores_per_socket"]:
        info["cores_per_socket"] = logical // info["sockets"]
    info["total_cores"] = info["sockets"] * info["cores_per_socket"]
    info["threads_per_core"] = (logical // info["total_cores"]) if info["total_cores"] else 1
    if freqs:
        info["freq_min_mhz"] = min(freqs); info["freq_max_mhz"] = max(freqs)
        info["freq_avg_mhz"] = sum(freqs) / len(freqs)
    return info

def parse_numa(txt):
    """Parse the `os/numa` snapshot file (format documented in _awr_collect).
    Returns {"nodes": {id: {"cpus","mem_total_kb","mem_free_kb","distance",
    "stats": {name: value}}}}; {} when file empty/absent (older snaps degrade)."""
    out = {"nodes": {}}
    cur = None
    for line in (txt or "").splitlines():
        f = line.split()
        if not f:
            continue
        if f[0] == "node" and len(f) >= 2:
            cur = f[1]
            out["nodes"][cur] = {"cpus": "", "mem_total_kb": 0, "mem_free_kb": 0,
                                 "distance": "", "stats": {}}
        elif cur is None:
            continue
        elif f[0] == "cpulist" and len(f) >= 2:
            out["nodes"][cur]["cpus"] = f[1]
        elif f[0] == "MemTotal:" and len(f) >= 2:
            try: out["nodes"][cur]["mem_total_kb"] = int(f[1])
            except Exception: pass
        elif f[0] == "MemFree:" and len(f) >= 2:
            try: out["nodes"][cur]["mem_free_kb"] = int(f[1])
            except Exception: pass
        elif f[0] == "distance":
            out["nodes"][cur]["distance"] = " ".join(f[1:])
        elif f[0] == "stat" and len(f) >= 3:
            try: out["nodes"][cur]["stats"][f[1]] = float(f[2])
            except Exception: pass
    if not out["nodes"]:
        return {}
    return out

def _numa_stat_delta(numa_a, numa_b, nid, key):
    """Window delta of one numastat counter (end - begin); missing on EITHER
    side -> None (2026-11-01: a begin side lacking the counter must render
    "?" -- unknown -- not a fabricated 0 delta)."""
    if not numa_a or not numa_b:
        return None
    sa = numa_a.get("nodes", {}).get(nid, {}).get("stats", {})
    sb = numa_b.get("nodes", {}).get(nid, {}).get("stats", {})
    if key not in sa or key not in sb:
        return None
    return sb[key] - sa[key]

def numa_html_table(topology, stats_delta_factory, placement=None):
    """Emit the awrrpt NUMA table -- ONE table, one row per
    node (user 2026-10-31: topology + numastat delta + DB placement are all
    per-node, so they merge): static columns first, window-delta columns
    after. placement: optional parse_db_numa_maps() result for the DB Pages /
    DB Share columns."""
    parts = []
    nodes = topology.get("nodes", {})
    _pl = {}
    _plk = {}
    _pltot = 0.0
    if placement:
        # two denominators (2026-11-01): the DB Pages COLUMN prints the raw
        # page counts; the DB SHARE column is kernelpagesize_kB-weighted
        # (pages x kernelpagesize_kB) so a 2M hugepage mapping weighs what it
        # weighs -- raw-page shares lie on mixed-page-size boxes (the call
        # site adds a note when the instance mixes page sizes)
        for _k, _v in placement.get("nodes", {}).items():
            _pl[_k[1:] if _k.startswith("N") else _k] = _v
        for _k, _v in placement.get("kb", {}).items():
            _plk[_k[1:] if _k.startswith("N") else _k] = _v
        _pltot = placement.get("kb_total", 0.0)
    parts.append('<table class="t"><tr><th>NUMA Nodes</th><th class="n">%d</th></tr></table>'
                 % len(nodes))
    parts.append('<table class="t"><tr><th>Node</th><th>CPU List</th><th class="n">MemTotal</th>'
                 '<th class="n">MemFree</th><th class="n">Distance</th>'
                 '<th class="n">Numa Hit</th><th class="n">Numa Miss</th>'
                 '<th class="n">Interleave Hit</th><th class="n">Local Node</th>'
                 '<th class="n">Other Node</th><th class="n">Local Ratio</th>'
                 + ('<th class="n">DB Pages</th><th class="n">DB Share</th>' if placement else '')
                 + '</tr>')
    for nid in sorted(nodes, key=lambda x: int(x) if x.isdigit() else 0):
        nd = nodes[nid]
        hit = stats_delta_factory(nid, "numa_hit")
        miss = stats_delta_factory(nid, "numa_miss")
        ih = stats_delta_factory(nid, "interleave_hit")
        loc = stats_delta_factory(nid, "local_node")
        oth = stats_delta_factory(nid, "other_node")
        _loc_den = (loc or 0) + (oth or 0)
        # (2026-11-01: either delta unknown -> ratio is unknown; computing
        # with 0 asserted zero locality the adjacent "?" cells disavow)
        if loc is None or oth is None:
            ratio = "n/a"
        else:
            ratio = "%.2f%%" % (loc / _loc_den * 100.0) if _loc_den > 0 else "n/a"
        parts.append('<tr><td>%s</td><td>%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td>%s</tr>' % (
                         esc(nid), esc(nd["cpus"]),
                         fmt_kb(nd["mem_total_kb"]), fmt_kb(nd["mem_free_kb"]),
                         esc(nd["distance"]),
                         fmt_int(hit) if hit is not None else "?",
                         fmt_int(miss) if miss is not None else "?",
                         fmt_int(ih) if ih is not None else "?",
                         fmt_int(loc) if loc is not None else "?",
                         fmt_int(oth) if oth is not None else "?",
                         ratio,
                         (('<td class="n">%s</td><td class="n">%s</td>'
                            % (fmt_int(_pl[nid]) if nid in _pl else "-",
                               '%.1f%%' % (100.0 * _plk[nid] / _pltot) if nid in _plk and _pltot > 0 else "-"))
                          if placement else '')))
    parts.append('</table>')
    return "".join(parts)

def parse_db_cgroup(txt):
    """Parse the db_cgroup snapshot (format in _awr_collect): "raw|..." lines,
    "mode|v1|v2", "<ctrl>|<path>" section headers and "<key>|<value>" pairs.
    Returns {"mode","raw","paths":{ctrl:path},"kv":{key:value}}; {} when the
    file is absent (pre-2026-10-31 snaps degrade silently)."""
    out = {"mode": "", "raw": [], "paths": {}, "kv": {}}
    seen = False
    for line in (txt or "").splitlines():
        f = line.split("|", 1)
        if len(f) < 2:
            continue
        k, v = f[0], f[1]
        if k == "raw":
            out["raw"].append(v)
            seen = True
        elif k == "mode":
            out["mode"] = v
            seen = True
        elif k in ("cpu", "cpuacct", "memory", "blkio", "pids", "cpuset",
                   "hugetlb", "io"):
            out["paths"][k] = v
            seen = True
        else:
            out["kv"][k] = v
            seen = True
    return out if seen else {}

def _vmstat_keys(txt, keys):
    """Pull raw /proc/vmstat counters by name -- the kernel auto-NUMA
    balancing family (numa_hint_faults etc.) is not in proc_vmstat's
    curated key set, so grab named counters straight from the snapshot."""
    out = {}
    want = set(keys)
    for line in (txt or "").splitlines():
        f = line.split()
        if len(f) >= 2 and f[0] in want:
            try:
                out[f[0]] = to_num(f[1])
            except Exception:
                pass
    return out

def parse_db_numa_maps(txt):
    """Parse the db_numa_maps snapshot (format in _awr_collect): a
    "pages|<total>|N0=<n>|...|unfaulted=<n>" aggregate line plus
    "map|<pages>|N0=..|..|<desc>" rows. Returns {"total","nodes","unfaulted",
    "maps","kb","kb_total","kbs"} or {} when the file is absent
    (pre-2026-10-31 snaps degrade silently). "kb"/"kb_total" are the
    kernelpagesize_kB-WEIGHTED per-node / total page-KB sums -- the share
    denominators; "kbs" = distinct page sizes among faulted mappings (mixed
    4K/hugepage boxes make raw-page shares lie: a 2M hugepage is ONE page)."""
    out = {"total": 0.0, "nodes": {}, "unfaulted": 0, "maps": [],
           "kb": {}, "kb_total": 0.0, "kbs": set()}
    seen = False
    for line in (txt or "").splitlines():
        f = line.split("|")
        if f[0] == "pages" and len(f) >= 2:
            seen = True
            try:
                out["total"] = to_num(f[1])
            except Exception:
                pass
            for part in f[2:]:
                if "=" not in part:
                    continue
                k, v = part.split("=", 1)
                try:
                    if k == "unfaulted":
                        out["unfaulted"] = int(to_num(v))
                    else:
                        out["nodes"][k] = to_num(v)
                except Exception:
                    pass
        elif f[0] == "map" and len(f) >= 3:
            seen = True
            try:
                _pv = to_num(f[1])
                _nd = {}
                _j = 2
                # optional per-node counters (new format): map|pages|N0=..|..|desc
                while _j < len(f) and re.match(r"^N\d+=", f[_j]):
                    _k, _v = f[_j].split("=", 1)
                    _nd[_k] = to_num(_v)
                    _j += 1
                desc = "|".join(f[_j:])
                # the collector fronts kernelpagesize_kB in the desc (the
                # 90-char truncation used to eat it behind long paths).
                # Trust ONLY the leading token: an old-snapshot desc that was
                # cut mid-digit ("...kernelpagesize_kB=204") must not be
                # parsed as a real 204 kB page size; old snaps without the
                # fronted token degrade to the 4 kB default
                _kb = 4
                _m = re.match(r"kernelpagesize_kB=(\d+)", desc)
                if _m:
                    try:
                        _kb = int(_m.group(1)) or 4
                    except Exception:
                        pass
                for _nk, _nv in _nd.items():
                    out["kb"][_nk] = out["kb"].get(_nk, 0.0) + _nv * _kb
                out["kb_total"] += _pv * _kb
                if _pv > 0:
                    out["kbs"].add(_kb)
                out["maps"].append((_pv, _nd, desc, _kb))
            except Exception:
                pass
    return out if seen else {}

def proc_stat_extras(txt):
    """context switches (ctxt), total interrupts (intr first col), procs_running,
    cumulative forks (processes)."""
    ctxt = 0.0; intr = 0.0; runq = 0; forks = 0.0
    for line in (txt or "").splitlines():
        f = line.split()
        if len(f) < 2:
            continue
        if f[0] == "ctxt":
            try: ctxt = float(f[1])
            except Exception: pass
        elif f[0] == "intr":
            try: intr = float(f[1])
            except Exception: pass
        elif f[0] == "procs_running":
            try: runq = int(float(f[1]))
            except Exception: pass
        elif f[0] == "processes":
            try: forks = float(f[1])
            except Exception: pass
    return {"ctxt": ctxt, "intr": intr, "runq": runq, "processes": forks}

def proc_net_ifaces(txt):
    """Per-interface counters from /proc/net/dev: rx/tx bytes/packets/errs/drop/fifo/frame/compressed/multicast/colls/carrier."""
    out = []
    for line in (txt or "").splitlines():
        if ":" not in line:
            continue
        name, rest = line.split(":", 1)
        name = name.strip()
        if not name or name in ("Inter-|", "face"):
            continue
        if name == "lo" or name.startswith("vir"):
            continue
        f = rest.split()
        if len(f) < 12:
            continue
        out.append({
            "name": name,
            "rx_bytes": to_num(f[0]), "rx_packets": to_num(f[1]),
            "rx_errs":  to_num(f[2]), "rx_drop":   to_num(f[3]),
            "tx_bytes": to_num(f[8]), "tx_packets": to_num(f[9]),
            "tx_errs":  to_num(f[10]),"tx_drop":   to_num(f[11]),
        })
    return out

def proc_disk_devs(txt):
    """Per-device diskstats: rd_ios/rd_sectors/rd_ticks/wr_ios/wr_sectors/wr_ticks/io_ticks/
    weighted_ticks (ms) + discard/flush counters (kernel 4.18+; None on older kernels)."""
    out = []
    for line in (txt or "").splitlines():
        f = line.split()
        if len(f) < 14:
            continue
        try:
            out.append({
                "name": f[2],
                "rd_ios": to_num(f[3]), "rd_sectors": to_num(f[5]), "rd_ticks": to_num(f[6]),
                "wr_ios": to_num(f[7]), "wr_sectors": to_num(f[9]), "wr_ticks": to_num(f[10]),
                "io_ticks": to_num(f[12]),
                "weighted_ticks": to_num(f[13]),
                # kernel 4.18+ extra fields; None when the kernel does not report them
                "dc_ios": to_num(f[14]) if len(f) > 14 else None,
                "dc_sectors": to_num(f[16]) if len(f) > 16 else None,
                "dc_ticks": to_num(f[17]) if len(f) > 17 else None,
                "fl_ios": to_num(f[18]) if len(f) > 18 else None,
                "fl_ticks": to_num(f[19]) if len(f) > 19 else None,
            })
        except Exception:
            pass
    # drop partition entries (sda1, nvme0n1p1, ...) — keep whole disks only, to avoid double counting
    _names = [d["name"] for d in out]
    def _is_part(name):
        for parent in _names:
            if parent != name and name.startswith(parent):
                suf = name[len(parent):]
                if (suf.startswith("p") and suf[1:].isdigit()) or suf.isdigit():
                    return True
        return False
    out = [d for d in out if not _is_part(d["name"])]
    return out

def parse_blockdev_meta(txt):
    """os/blockdev_meta (run_lsds --raw): '# name|size|...' header + one line per device.
    Returns {name: {size,type,sched,rot,qdepth,nr_rq,wcache,model,vendor}}; {} when absent."""
    out = {}
    for line in (txt or "").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        f = line.split("|")
        if len(f) < 10:
            continue
        out[f[0]] = {"size": f[1], "type": f[2], "sched": f[3], "rot": f[4],
                     "qdepth": f[5], "nr_rq": f[6], "wcache": f[7],
                     "model": f[8], "vendor": f[9]}
    return out

def parse_netdev_meta(txt):
    """os/netdev_meta: iface|speed|duplex|nrxq|ntxq|rx_max|rx_cur|tx_max|tx_cur.
    Returns {iface: {...}}; {} when absent."""
    out = {}
    for line in (txt or "").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        f = line.split("|")
        if len(f) < 9:
            continue
        out[f[0]] = {"speed": f[1], "duplex": f[2], "nrxq": f[3], "ntxq": f[4],
                     "rx_max": f[5], "rx_cur": f[6], "tx_max": f[7], "tx_cur": f[8]}
    return out

VM_KEYWORDS = ("kvm", "qemu", "vmware", "openstack", "bochs", "xen", "hyper-v", "hyperv",
               "virtualbox", "ovirt", "powerkvm", "powervm", "ldom", "parallels", "zvm",
               "virtuozzo")

def platform_label(dmi_txt, cpuinfo_txt):
    """'<arch> / Virtual (<dmi vendor+product>)' / '<arch> / Physical' / None.
    arch from the dmi file's 'arch' line (uname -m); dmi keyword match wins over
    the cpuinfo 'hypervisor' flag; dmi present w/o match -> Physical."""
    dmi = {}
    for line in (dmi_txt or "").splitlines():
        f = line.split(None, 1)
        if len(f) == 2 and f[0] in ("vendor", "product", "arch"):
            dmi[f[0]] = f[1].strip()
    _arch = dmi.get("arch", "")

    def _tag(lbl):
        return "%s / %s" % (_arch, lbl) if _arch else lbl
    # .strip() matters: joining two empty strings yields " " (truthy), which
    # would fall into the Physical branch and never reach the cpuinfo fallback
    hay = " ".join(dmi.get(k, "") for k in ("vendor", "product")).strip().lower()
    if hay:
        for kw in VM_KEYWORDS:
            if re.search(r'\b' + re.escape(kw) + r'\b', hay):
                return _tag("Virtual (%s)" % " ".join(
                    dmi.get(k, "") for k in ("vendor", "product") if dmi.get(k)).strip())
        return _tag("Physical")
    if "hypervisor" in (cpuinfo_txt or "").lower():
        return _tag("Virtual (hypervisor)")
    return None

def _dd(e, b, k):
    """Delta of an optional counter (None on either side -> None; clamped at 0)."""
    ev, bv = e.get(k), b.get(k)
    return None if (ev is None or bv is None) else max(0, ev - bv)

def _read_os_text(p):
    """Read a snapshot os/ file tolerantly: unreadable (perms, partial copy,
    non-UTF-8) -> '' so the missing-file degrade path stays usable."""
    try:
        with open(p, "r", errors="replace") as fh:
            return fh.read()
    except OSError:
        return ""


def _cell(m, k):
    """Trimmed meta value; '-' for empty or literal '-'."""
    v = (m.get(k) or "").strip()
    return v if v and v != "-" else "-"

def disk_meta_cells(name, meta):
    """7 identity cells (Size/Type/Rot/Sched/QDepth/NR_RQ/WC); '-' when unavailable."""
    m = meta.get(name)
    if not m:
        return ["-"] * 7
    return [_cell(m, "size"), _cell(m, "type"), _cell(m, "rot"), _cell(m, "sched"),
            _cell(m, "qdepth"), _cell(m, "nr_rq"), _cell(m, "wcache")]

def net_meta_cells(name, meta):
    """Speed/Duplex/Queues/RX ring/TX ring cells; ring as 'cur/max'; '-' when unavailable."""
    m = meta.get(name)
    if not m:
        return ["-"] * 5
    nrx, ntx = _cell(m, "nrxq"), _cell(m, "ntxq")
    queues = nrx if nrx == ntx else "rx%s/tx%s" % (nrx, ntx)
    rxr = "-" if (_cell(m, "rx_cur") == "-" and _cell(m, "rx_max") == "-") else "%s/%s" % (_cell(m, "rx_cur"), _cell(m, "rx_max"))
    txr = "-" if (_cell(m, "tx_cur") == "-" and _cell(m, "tx_max") == "-") else "%s/%s" % (_cell(m, "tx_cur"), _cell(m, "tx_max"))
    return [_cell(m, "speed"), _cell(m, "duplex"), queues, rxr, txr]

def speed_mbps(cell):
    """Speed cell '1000Mb/s'/'10Gb/s' -> Mbps float; None when '-'/'Unknown!'."""
    c = (cell or "").strip().lower()
    if not c or c.startswith("-") or c.startswith("unknown"):
        return None
    m = re.match(r"([0-9.]+)\s*([kmgt]?)b", c)
    if not m:
        return None
    try:
        return float(m.group(1)) * {"": 1.0, "k": 1e-3, "m": 1.0, "g": 1e3, "t": 1e6}[m.group(2)]
    except ValueError:
        return None

