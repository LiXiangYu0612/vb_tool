# awr enable -d N  -- install crontab entry: snapshot every N minutes (default 60).
# awr enable  -- install the periodic crontab entries. Takes NO options: the
# snapshot interval comes from 'awr config interval <min>' (<root>/interval,
# default 60); the replication sampler always runs every 1 minute.
_awr_enable() {
    # all optional with defaults (user 2026-10-31): -d retention days
    # (default 8), -i snapshot interval minutes (default 60), -D data root
    # dir (default $HOME; layout under it identical to the default).
    # -P is stripped by the global parser before dispatch, default $PGPORT.
    local dflag="" iflag="" Dflag=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) awr_help; return 0;;
            -d) [ $# -lt 2 ] || [ -z "$2" ] && { echo "Error: -d expects retention days (0 = never purge, default 8)" >&2; return 2; }
                dflag="$2"; shift 2;;
            -i) [ $# -lt 2 ] || [ -z "$2" ] && { echo "Error: -i expects the snapshot interval in minutes (10-1440, default 60)" >&2; return 2; }
                iflag="$2"; shift 2;;
            -D) [ $# -lt 2 ] || [ -z "$2" ] && { echo "Error: -D expects the data root directory (absolute path)" >&2; return 2; }
                Dflag="$2"; shift 2;;
            *)  echo "Error: unexpected argument '$1' (usage: enable [-d retention_days] [-i interval_min] [-D datadir])" >&2; return 2;;
        esac
    done
    # double-enable fails FIRST, before any -D/-d/-i side effect (user
    # 2026-10-31: repeated enable must error regardless of flags; changes on
    # an already-enabled instance belong to 'awr config', not 'enable')
    if crontab -l 2>/dev/null | grep -qE "# vb_tool_awr(_repl)?_p${PGPORT:-5432} *\$" 2>/dev/null \
       || crontab -l 2>/dev/null | grep -qE '# vb_tool_awr(_repl)? *$' 2>/dev/null; then
        echo "Error: awr periodic capture is already ENABLED for port ${PGPORT:-5432} -- run 'awr disable' first; to change settings use 'awr config interval|retention|datadir'" >&2
        crontab -l 2>/dev/null | grep -F '# vb_tool_awr' >&2
        return 1
    fi
    # F3-A (independent review 2026-10-31): validate -d/-i BEFORE any -D
    # migration -- a typo like "-i 99999" must fail with NOTHING moved
    case "$dflag" in ''|*[!0-9]*) [ -n "$dflag" ] && { echo "Error: -d expects a non-negative integer number of days" >&2; return 2; };; esac
    [ -n "$dflag" ] && [ "$dflag" -gt 3650 ] && { echo "Error: retention too large (max 3650 days); use 0 for keep-forever" >&2; return 2; }
    if [ -n "$iflag" ]; then
        case "$iflag" in ''|*[!0-9]*) echo "Error: -i expects a positive integer number of minutes (10-1440)" >&2; return 2;; esac
        { [ "$iflag" -lt 10 ] || [ "$iflag" -gt 1440 ]; } && { echo "Error: interval must be 10-1440 minutes" >&2; return 2; }
    fi
    # application order (user 2026-10-31): datadir FIRST -- a failed
    # migration must abort before anything else changes; then retention and
    # interval via the same validators as 'awr config'; then the crontab.
    [ -n "$Dflag" ] && { _awr_datadir_migrate "$Dflag" || return 1; }   # N3: state/data errors rc=1, not the help-dumping rc=2
    [ -n "$dflag" ] && { _awr_config retention "$dflag" || return 2; }
    [ -n "$iflag" ] && { _awr_config interval "$iflag" || return 2; }
    command -v crontab >/dev/null 2>&1 || { echo "Error: crontab not found on PATH" >&2; return 1; }
    local port="${PGPORT:-5432}"
    local marker="# vb_tool_awr_p$port"
    local rmarker="# vb_tool_awr_repl_p$port"
    # cross-port crontab lock (audit 2026-10-30): enable/disable do a
    # read-check-write on the WHOLE crontab (crontab - is a full replace) --
    # two concurrent enables for different ports both read the pre-write
    # snapshot and the later write silently drops the other port's entries.
    # One shared lock file (NOT under the per-port awr root) serializes the
    # whole check+install section; -w 30 so a stuck holder cannot hang us.
    local _ctlock="${VB_TOOL_HOME:-$HOME/.vb_tool}/awr_crontab.lock"
    mkdir -p "${VB_TOOL_HOME:-$HOME/.vb_tool}" 2>/dev/null
    (
    flock -w 30 9 || { echo "Error: cannot acquire $_ctlock (another vb_tool crontab edit in progress?)" >&2; exit 1; }
    # Refuse to double-enable THIS port (other ports may run awr in parallel);
    # also refuse while legacy port-less entries from an older vb_tool are
    # still installed -- they follow the login profile's PGPORT and cannot be
    # attributed to any port.
    if crontab -l 2>/dev/null | grep -qE "${rmarker}\$" || crontab -l 2>/dev/null | grep -qE "${marker}\$"; then
        echo "Error: awr periodic capture is already ENABLED for port $port -- run 'awr disable' first" >&2
        echo "Current entries:" >&2
        crontab -l 2>/dev/null | grep -F '# vb_tool_awr' >&2
        # state conflict, NOT a usage error (user 2026-10-20: rc=2 makes the
        # dispatcher dump the full awr help -- the 3 lines above already say
        # everything); rc=1 keeps it to the error block only
        exit 1
    fi
    if crontab -l 2>/dev/null | grep -Eq '# vb_tool_awr(_repl)? *$'; then
        echo "Error: legacy awr crontab entries (older vb_tool, no port pinning) found --" >&2
        echo "       run 'awr disable' once to remove them, then re-enable" >&2
        exit 1
    fi
    local mins; mins=$(_awr_interval_read)
    local self; self=$(readlink -f "$0" 2>/dev/null || echo "$0")
    # Wrap in `bash -lc` so cron's minimal env sources the user's login profile
    # (psql + PG* vars); PGPORT=<port> pins THIS instance so the entry keeps
    # capturing the same database even if the profile's PGPORT later changes.
    # ★门控快照条目 (2026-10-11, user: 90 分钟就要真的 90 分钟): cron 分钟域表达
    #   不了 >60/不整除 60 的间隔; 改每分钟唤醒 + epoch 分钟模 interval 文件值 ——
    #   任意 N(10-1440) 精确; interval 改动只写文件下一边界即生效, 与 crontab 解耦。
    local entry="* * * * * /bin/bash -lc 'PGPORT=$port $self awr _gated-create >/dev/null 2>&1'  $marker"
    local rentry="* * * * * /bin/bash -lc 'PGPORT=$port $self awr _repl-sample >/dev/null 2>&1'  $rmarker"
    if ! ( crontab -l 2>/dev/null | grep -vE "# vb_tool_awr_repl_p${port}\$" | grep -vE "# vb_tool_awr_p${port}\$"; echo "$rentry"; echo "$entry" ) | crontab -; then
        echo "Error: failed to install crontab entries (check cron.allow/cron.deny, permissions or disk) -- periodic capture NOT started" >&2
        exit 1
    fi
    echo "awr enable: port $port, capturing a snapshot every ${mins}min (see 'awr config interval') + replication/slot/OS sample every 1min + long-txn/callstack/pagewriter sample every 5min via crontab"
    echo "  $entry"
    echo "  $rentry"
    echo "  (run 'awr disable' to stop both; other ports keep their own entries)"
    ) 9>"$_ctlock"
    local rc=$?
    [ "$rc" -eq 0 ] || return "$rc"
    _awr_purge_expired
    return 0
}

# awr disable  -- remove BOTH the periodic-snapshot and replication-sampler crontab entries.
# awr disable  -- remove the periodic crontab entries of THIS port (plus any
# legacy port-less ones from an older vb_tool). Other ports' entries stay.
_awr_disable() {
    case "${1:-}" in
        "") ;;
        -h|--help) awr_help; return 0;;
        *)         echo "Error: unexpected argument '$1' (awr disable takes no options)" >&2; return 2;;
    esac
    local port="${PGPORT:-5432}"
    local removed=0
    # same cross-port crontab lock as enable (audit 2026-10-30): the
    # check+strip+rewrite below must not interleave with another port's
    # enable/disable or the later full-replace drops the other's entries
    local _ctlock="${VB_TOOL_HOME:-$HOME/.vb_tool}/awr_crontab.lock"
    mkdir -p "${VB_TOOL_HOME:-$HOME/.vb_tool}" 2>/dev/null
    (
    flock -w 30 9 || { echo "Error: cannot acquire $_ctlock (another vb_tool crontab edit in progress?)" >&2; exit 1; }
    if crontab -l 2>/dev/null | { grep -qE "# vb_tool_awr_p${port}\$" || grep -qE "# vb_tool_awr_repl_p${port}\$" || grep -Eq '# vb_tool_awr(_repl)? *$'; }; then
        crontab -l 2>/dev/null | grep -vE "# vb_tool_awr_repl_p${port}\$" | grep -vE "# vb_tool_awr_p${port}\$" \
            | grep -vE '# vb_tool_awr(_repl)? *$' | crontab -
        removed=1
    fi
    if [ "$removed" -eq 1 ]; then
        echo "awr disable: removed periodic snapshot + replication sampler crontab entries for port $port"
    else
        echo "awr disable: no periodic snapshot / sampler entries found for port $port (nothing to remove)"
    fi
    ) 9>"$_ctlock"
    return $?
}

_awr_list() {
    if [ $# -gt 1 ]; then
        echo "Error: unexpected argument '$2' (usage: awr list [YYYY-MM-DD])" >&2; return 2
    fi
    local date_filter="$1"
    if [ -n "$date_filter" ] && ! printf '%s' "$date_filter" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; then
        echo "Error: invalid date '$date_filter' (expect YYYY-MM-DD)" >&2; return 2
    fi
    if [ -n "$date_filter" ] && [ "$(date -d "$date_filter" '+%Y-%m-%d' 2>/dev/null)" != "$date_filter" ]; then
        echo "Error: invalid date '$date_filter' (not a real calendar date)" >&2; return 2
    fi
    local root; root=$(_awr_root)
    if [ ! -d "$root" ]; then echo "(no snaps at $root)"; return 0; fi
    python3 - "$root" "$date_filter" <<'PY'
import json, os, sys, glob, gzip, datetime
root, date_filter = sys.argv[1], sys.argv[2]

def _dbstart_short(v):
    # '2026-08-17 10:46:18.309219+08' -> '08-17 10:46' (same-year compact)
    v = str(v or "")
    return v[5:16] if len(v) >= 16 else (v or "-")

def _dbtime(d):
    # cumulative DB_TIME (us) from the snap's instance_time csv (gz or plain)
    for fn, opener in (("db/instance_time.csv.gz", gzip.open), ("db/instance_time.csv", open)):
        p = os.path.join(d, fn)
        if os.path.isfile(p):
            try:
                with opener(p, "rt") as f:
                    next(f)
                    for ln in f:
                        parts = ln.strip().split(",")
                        if len(parts) >= 3 and parts[1] == "DB_TIME":
                            return int(float(parts[2]))
            except Exception:
                return None
    return None

def _hum_us(v):
    if v is None: return "-"
    sec = v / 1e6
    if sec >= 86400: return "%.1fd" % (sec / 86400)
    if sec >= 3600:  return "%.1fh" % (sec / 3600)
    if sec >= 60:    return "%.1fm" % (sec / 60)
    return "%.0fs" % sec

rows = []
for d in glob.glob(os.path.join(root, "snap_*")):
    if not os.path.isdir(d): continue
    mp = os.path.join(d, "meta.json")
    try: m = json.load(open(mp)) if os.path.isfile(mp) else {}
    except Exception: m = {}
    sid = m.get("snap_id", os.path.basename(d).replace("snap_", ""))
    try: sid = int(sid)
    except Exception: pass
    rows.append((sid, m.get("ts", "?"), m.get("hostname", "?"), m.get("db_name", "?"),
                 _dbstart_short(m.get("db_start_time", "")), _dbtime(d),
                 m.get("db_role") or "-"))
# per-snap DB_TIME delta vs the PREVIOUS snap (lower id): shown only when
# both snaps share the same db_start_time (same instance uptime); restart
# boundary or missing counter -> '-'. AAS = average active sessions =
# DB_TIME delta / window seconds (Oracle logic, 1 decimal), same guard.
def _ts_ep(ts):
    try:
        return datetime.datetime.strptime(str(ts), "%Y-%m-%d %H:%M:%S").timestamp()
    except Exception:
        return None
delta = {}
aas = {}
_asc = sorted([r for r in rows if not isinstance(r[0], str)], key=lambda r: r[0])
for i, r in enumerate(_asc):
    if i == 0 or r[5] is None:
        delta[r[0]] = "-"; aas[r[0]] = "-"; continue
    pr = _asc[i - 1]
    if pr[5] is None or pr[4] != r[4] or r[5] < pr[5]:
        delta[r[0]] = "-"; aas[r[0]] = "-"; continue
    delta[r[0]] = _hum_us(r[5] - pr[5])
    t0, t1 = _ts_ep(pr[1]), _ts_ep(r[1])
    if t0 and t1 and t1 - t0 > 0:
        aas[r[0]] = "%.1f" % ((r[5] - pr[5]) / 1e6 / (t1 - t0))
    else:
        aas[r[0]] = "-"

if date_filter:
    rows = [r for r in rows if str(r[1])[:10] == date_filter]
# newest first: numeric snap_ids descending, non-numeric fallback ids last
rows = (sorted([r for r in rows if not isinstance(r[0], str)], key=lambda r: r[0], reverse=True)
        + sorted([r for r in rows if isinstance(r[0], str)]))
if not rows:
    print("(no snaps at %s%s)" % (root, (" on " + date_filter) if date_filter else "")); sys.exit()
total = len(rows)
if not date_filter and total > 30:
    rows = rows[:30]
# DB column width adapts to the longest db_name in the shown rows (+2 gap,
# floor 12): a long cluster name (dn_6001_6002_6003 = 16) must not push the
# DB_ROLE column around -- and any future longer name can't either
# HOST is the LAST column (2026-09-29): mid-row it pushed DB/DB_ROLE out of
# alignment whenever a hostname ran past its width; last, it just runs long
dbw = max(max(len(str(r[3])) for r in rows) + 2, 12)
print("%-8s %-20s %-12s %-8s %-5s %-*s %-17s %s" % ("SNAP_ID", "TS", "DB_START", "DB_TIME", "AAS", dbw, "DB", "DB_ROLE", "HOST"))
for r in rows: print("%-8s %-20s %-12s %-8s %-5s %-*s %-17s %s" % (r[0], r[1], r[4], delta.get(r[0], "-"), aas.get(r[0], "-"), dbw, r[3], r[6], r[2]))
if not date_filter and total > 30:
    print("(showing latest 30 of %d; 'vb_tool awr list YYYY-MM-DD' for a specific day)" % total)
PY
}

# awr show -- no arg: awr configuration overview (retention / interval /
# snapshot inventory). With <snap_id>: that snapshot's meta + collected files.
# awr show  -- standalone overview: run status (crontab entries when enabled),
# sampling interval, retention, oldest/newest snapshot, snapshot count.
# Absorbed the old 'awr status' (same markers disable removes).
_awr_show() {
    if [ $# -gt 0 ]; then
        echo "Error: usage 'awr show' (no arguments; per-snap files live under <root>/snap_<id>/)" >&2
        return 2
    fi
    local root; root=$(_awr_root)
    # absolute path for display: root is normally already absolute ($HOME or
    # $VB_TOOL_HOME based), cd+pwd also resolves a relative VB_TOOL_HOME and
    # collapses any symlinked segments when the dir exists
    local rootabs; rootabs=$(cd "$root" 2>/dev/null && pwd); [ -n "$rootabs" ] || rootabs=$root
    local days; days=$(_awr_retention_read)
    local mins; mins=$(_awr_interval_read)
    # run status: read the SAME per-port markers enable/disable use, so what
    # show reports is always consistent with what disable would remove; also
    # surface other ports that have awr enabled (multi-instance overview)
    local port="${PGPORT:-5432}"
    local snapent="" replent="" others=""
    if command -v crontab >/dev/null 2>&1; then
        local out; out=$(crontab -l 2>/dev/null)
        snapent=$(printf '%s\n' "$out" | grep -E "# vb_tool_awr_p${port}\$")
        replent=$(printf '%s\n' "$out" | grep -E "# vb_tool_awr_repl_p${port}\$")
        others=$(printf '%s\n' "$out" | grep -oE '# vb_tool_awr_p[0-9]+' | sed 's/# vb_tool_awr_p//' | sort -un | grep -vx "$port" | tr '\n' ' ')
    fi
    local nextid; nextid=$(cat "$root/sequence" 2>/dev/null)
    case "$nextid" in ''|*[!0-9]*) nextid=1;; esac
    # inventory: count + oldest/newest (ts-sorted, snap_id alongside)
    local inv="0"
    if [ -d "$root" ] && command -v python3 >/dev/null 2>&1; then
        inv=$(python3 - "$root" <<'PY' 2>/dev/null
import json, os, sys, glob
rows = []
for d in glob.glob(os.path.join(sys.argv[1], "snap_*")):
    mp = os.path.join(d, "meta.json")
    try: m = json.load(open(mp)) if os.path.isfile(mp) else {}
    except Exception: m = {}
    t = str(m.get("ts", ""))
    if not t: continue
    sid = m.get("snap_id", os.path.basename(d).replace("snap_", ""))
    rows.append((t, str(sid)))
rows.sort()
if not rows: print("0")
else: print("%d\t%s\t%s\t%s\t%s" % (len(rows), rows[0][1], rows[0][0], rows[-1][1], rows[-1][0]))
PY
)
    fi
    local n osid ots nsid nts
    n=$(printf '%s\n' "$inv" | head -1 | cut -f1)
    case "$n" in ''|*[!0-9]*) n=0;; esac
    osid=$(printf '%s\n' "$inv" | cut -f2); ots=$(printf '%s\n' "$inv" | cut -f3)
    nsid=$(printf '%s\n' "$inv" | cut -f4); nts=$(printf '%s\n' "$inv" | cut -f5)
    local oldest="-" newest="-"
    if [ "$n" -gt 0 ]; then
        # pad ids to the pair's max width so the (ts) parens line up
        local _w=${#nsid}; [ "${#osid}" -gt "$_w" ] && _w=${#osid}
        oldest=$(printf "%-*s  (%s)" "$_w" "$osid" "$ots")
        newest=$(printf "%-*s  (%s)" "$_w" "$nsid" "$nts")
    fi
    local purge="on"
    [ "$days" -eq 0 ] && purge="off (retention = 0, keep forever)"
    local rdesc="${days} days"
    [ "$days" -eq 0 ] && rdesc="0 (never purge)"
    # last-snap freshness (shown only while ENABLED): with interval N min a snap
    # lands every ~N min, so anything older than N + 10 min slack means periodic
    # capture is not landing (script moved/renamed, crontab broken, DB down) --
    # the crontab entries would still SAY enabled, this line is the liveness tell
    local ageline=""
    if [ -n "$snapent" ] || [ -n "$replent" ]; then
        if [ "$n" -gt 0 ] && [ -n "$nts" ]; then
            local now_ep snap_ep age thr human
            now_ep=$(date +%s)
            snap_ep=$(date -d "$nts" +%s 2>/dev/null)
            if [ -n "$snap_ep" ] && [ -n "$now_ep" ]; then
                age=$(( now_ep - snap_ep )); [ "$age" -lt 0 ] && age=0
                thr=$(( mins * 60 + 600 ))
                if   [ "$age" -lt 90 ];    then human="${age} sec"
                elif [ "$age" -lt 7200 ];  then human="$(( age / 60 )) min"
                elif [ "$age" -lt 172800 ]; then human="$(( age / 3600 )) hour(s)"
                else human="$(( age / 86400 )) day(s)"; fi
                if [ "$age" -le "$thr" ]; then
                    ageline="last snap age : ${human} (ok)"
                else
                    ageline="last snap age : ${human} (STALE -- periodic capture not landing; check script path, crontab and DB)"
                fi
            fi
        else
            ageline="last snap age : (no snapshots yet; first cron capture lands within ${mins} min of enable)"
        fi
    fi
    if [ -z "$snapent" ] && [ -z "$replent" ]; then
        echo "status        : DISABLED (no periodic snapshot / sampler crontab entries for port $port)"
    else
        echo "status        : ENABLED"
        if [ -n "$snapent" ]; then echo "  snapshot sampler : $snapent"
        else echo "  snapshot sampler : (entry missing -- run 'awr disable' then 'awr enable' to fix; 'awr enable' alone refuses while any marker exists)"; fi
        if [ -n "$replent" ]; then echo "  replicat sampler : $replent"
        else echo "  replicat sampler : (entry missing -- run 'awr disable' then 'awr enable' to fix; 'awr enable' alone refuses while any marker exists)"; fi
        [ -n "$ageline" ] && echo "$ageline"
    fi
    [ -n "$others" ] && echo "other ports   : awr also enabled on: $others"
    cat <<EOF
port          : $port
data dir      : $rootabs
interval      : ${mins} min
retention     : $rdesc
auto-purge    : $purge
oldest snap   : $oldest
newest snap   : $newest
snapshots     : $n
next snap_id  : $nextid
EOF
    return 0
}

# _awr_purge_core <until_ep>  -- delete everything older than <until_ep> (epoch):
# snaps (by meta ts), repl_/slot_/os_ logs (by whole day), html reports (by mtime).
# Echoes "S R H" (the three counts) on stdout; WARNs on unparseable items go to
# stderr. Shared by 'awr delete until' and the retention auto-purge so both
# paths always delete exactly the same set of things.
_awr_purge_core() {
    local _plock; _plock=$(_awr_port_lockfile)
    mkdir -p "$(dirname "$_plock")" 2>/dev/null
    exec 8>"$_plock"
    flock -n -s 8 || { echo "  [WARN] datadir migration in progress, retry later" >&2; return 1; }
    local until_ep="$1"
    local root; root=$(_awr_root)
    local scount=0
    if [ -d "$root" ] && command -v python3 >/dev/null 2>&1; then
        # one python pass reads every meta.json (a per-dir python spawn, like
        # the old loop, would cost ~30ms x N snaps on EVERY periodic create)
        local expired
        expired=$(python3 - "$root" "$until_ep" <<'PY'
import json, os, sys, glob, time
root, until_ep = sys.argv[1], int(sys.argv[2])
for d in sorted(glob.glob(os.path.join(root, "snap_*"))):
    if not os.path.isdir(d): continue
    ts = ""
    try:
        mp = os.path.join(d, "meta.json")
        if os.path.isfile(mp): ts = str(json.load(open(mp)).get("ts", ""))
