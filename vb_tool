"""
    m = win["meta"]

    # ---- core denominators ----
    IT = delta_rows(win, "instance_time", "stat_name", ["value"])
    def inst(name):
        return IT.get(name, {}).get("value", 0.0)
    dbt = inst("DB_TIME")                 # microseconds, window delta
    duration = to_num(m.get("duration")) or 1.0

    db = delta_rows(win, "database", "datname",
                    ["xact_commit", "xact_rollback", "blks_read", "blks_hit",
                     "deadlocks", "tup_returned", "tup_fetched",
                     "tup_inserted", "tup_updated", "tup_deleted",
                     "conflicts", "temp_bytes", "temp_files"])
    for _tpl in ("template0", "template1"):   # exclude template DBs from ALL db aggregates
        db.pop(_tpl, None)                     # (Load Profile, Instance Activity, etc.)
    def agg(col):
        return sum((v.get(col, 0.0)) for v in db.values())
    commits = agg("xact_commit"); rollbacks = agg("xact_rollback")
    blks_read = agg("blks_read"); blks_hit = agg("blks_hit")
    deadlocks = agg("deadlocks"); tup_ret = agg("tup_returned"); tup_fetch = agg("tup_fetched")
    tup_ins = agg("tup_inserted"); tup_upd = agg("tup_updated"); tup_del = agg("tup_deleted")
    conflicts = agg("conflicts"); temp_bytes = agg("temp_bytes")
    txns = commits + rollbacks
    logical_reads = blks_read + blks_hit

    ST = delta_rows(win, "statement", "unique_sql_id",
                    ["n_calls", "db_time", "cpu_time", "data_io_time", "plan_time",
                     "sort_time", "hash_time",
                     "n_blocks_fetched", "n_blocks_hit", "n_returned_rows"])
    sum_calls = sum(d.get("n_calls", 0.0) for d in ST.values())
    sum_gets = sum(d.get("n_blocks_fetched", 0.0) for d in ST.values())

    WE = delta_rows(win, "wait_events", "event", ["wait", "total_wait_time"])
    for _idle in ("wait cmd", "none"):   # drop idle/non-wait "events" (like Oracle idle events)
        WE.pop(_idle, None)
    we_sorted = sorted(WE.keys(), key=lambda k: WE[k].get("total_wait_time", 0.0), reverse=True)

    osd = os_window_deltas(win)

    def pct(num, den):
        return (num / den * 100.0) if den else 0.0
    def s_of(us):
        return "%.2f" % (to_num(us) / 1_000_000.0)
    def ms_of(us):
        return "%.2f" % (to_num(us) / 1000.0)

    parts = []
    parts.append("<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'>")
    parts.append("<title>Vastbase Performance AWR Report</title><style>%s</style></head><body>" % CSS_AWR)

    _toc = []
    _used_slugs = set()
    def _slug(t):
        s = "".join(c if c.isalnum() else "-" for c in (t or "").lower()).strip("-") or "sec"
        slug = s; i = 2
        while slug in _used_slugs:
            slug = "%s-%d" % (s, i); i += 1
        _used_slugs.add(slug)
        return slug
    _foldsec_open = False
    def _close_foldsec():
        nonlocal _foldsec_open
        if _foldsec_open:
            parts.append('</details>')
            _foldsec_open = False
    def sec(t, fold=False):
        nonlocal _foldsec_open
        _close_foldsec()
        _id = _slug(t)
        _toc.append((t, _id))
        if fold:
            # whole section collapsed by default; the id rides on <details> so
            # the TOC anchor still jumps here
            parts.append('<details class="secfold" id="%s"><summary>%s <a class="totop" href="#toc">↑ Top</a></summary>'
                         % (_id, esc(t)))
            _foldsec_open = True
        else:
            parts.append('<div class="sec" id="%s"><h2>%s <a class="totop" href="#toc">↑ Top</a></h2></div>' % (_id, esc(t)))
    def sub(t):
        parts.append('<div class="sub">%s</div>' % esc(t))
    def note(t):
        for _line in t.split("\n"):
            parts.append('<div class="note">%s</div>' % esc(_line))

    # ================= Report Summary =================
    _compat_raw = psql_show("sql_compatibility")
    _compat = {"A": "A (Oracle)", "B": "B (MySQL)", "C": "C (MySQL)",
               "PG": "PG (PostgreSQL)"}.get(_compat_raw, _compat_raw) or "?"
    parts.append(
        '<div class="rhead"><div class="title">Vastbase Performance AWR Report</div>'
        '<table><tr><th>Instance Name</th><th>DB Role</th><th>DB Compatibility</th></tr>'
        '<tr><td>%s</td><td>%s</td><td>%s</td></tr></table>'
        '<table><tr><th>Release</th><th>vb_tool (snap / report)</th></tr>'
        '<tr><td>%s</td><td>%s / %s</td></tr></table>'
        '<table><tr><th>Host Name</th><th>OS Version</th><th>Startup Time</th><th class="n">Port</th></tr>'
        '<tr><td>%s</td><td>%s</td><td>%s</td><td class="n">%s</td></tr></table>'
        '<table><tr><th class="nobg"></th><th class="n">Snap Id</th><th class="c">Snap Time</th></tr>'
        '<tr><td>Begin Snap:</td><td class="n">%s</td><td class="c">%s</td></tr>'
        '<tr class="alt"><td>End Snap:</td><td class="n">%s</td><td class="c">%s</td></tr>'
        '<tr><td>Elapsed:</td><td></td><td class="c">%s (s)</td></tr>'
        '<tr class="alt"><td>DB Time:</td><td></td><td class="c">%s (s)</td></tr>'
        '</table></div>' % (
            esc(m.get("db_name") or m.get("name") or "?"), esc(m.get("db_role", "?")), esc(_compat),
            esc(m.get("db_version", "?") or "?"), esc(m.get("vb_tool_version", "?")), esc(_GEN_VER),
            esc(m.get("hostname", "?")), esc(_os_version()),
            esc(m.get("db_start_time") or "-"),
            esc(str(m.get("port") or "-")),
            esc(m.get("snap_id_begin", "?")), esc(m.get("begin_ts", "?")),
            esc(m.get("snap_id_end", "?")), esc(m.get("end_ts", "?")),
            esc(m.get("duration", "?")), s_of(dbt),
        ))
    _toc_pos = len(parts)

    # per-minute OS detail samples (awrrpt path only; os_*.log[.gz] from the
    # cron sampler; the window tables stay snap-delta based and untouched)
    os_smp = (load_os_samples(repl_dir, m.get("begin_ts", ""), m.get("end_ts", ""))
              if repl_dir is not None else None)

    # ================= OS Statistics =================
    sec("OS Statistics")
    _ci = parse_cpuinfo(win["os"].get(("end", "cpuinfo"), "")
                        or win["os"].get(("begin", "cpuinfo"), ""))
    if _ci:
        sub("CPU Info")
        parts.append('<table class="t"><tr><th>Item</th><th class="n">Value</th></tr>')
        parts.append('<tr><td>Model</td><td class="n">%s</td></tr>' % esc(_ci["model"]))
        parts.append('<tr><td>Sockets</td><td class="n">%d</td></tr>' % _ci["sockets"])
        parts.append('<tr><td>Cores per Socket</td><td class="n">%d</td></tr>' % _ci["cores_per_socket"])
        parts.append('<tr><td>Total Physical Cores</td><td class="n">%d</td></tr>' % _ci["total_cores"])
        parts.append('<tr><td>Threads per Core</td><td class="n">%d</td></tr>' % _ci["threads_per_core"])
        parts.append('<tr><td>Logical CPUs</td><td class="n">%d</td></tr>' % _ci["logical_cpus"])
        if _ci["freq_avg_mhz"]:
            parts.append('<tr><td>Freq (min / avg / max MHz)</td><td class="n">%.0f / %.0f / %.0f</td></tr>'
                         % (_ci["freq_min_mhz"], _ci["freq_avg_mhz"], _ci["freq_max_mhz"]))
        if osd.get("platform"):
            parts.append('<tr><td>Platform</td><td class="n">%s</td></tr>' % esc(osd["platform"]))
        parts.append('</table>')
    sub("CPU utilization")
    # horizontal layout: components as columns, one value row (busy bold >50%, red+bold >80%)
    _cf = ("busy", "user", "nice", "system", "iowait", "irq", "softirq", "steal", "idle")
    parts.append('<table class="t"><tr>' +
                 ''.join('<th class="n">%s</th>' % f for f in _cf) + '</tr>')
    parts.append('<tr>' + ''.join(
        '<td class="n%s">%.1f</td>' % (busy_cell_cls(osd["cpu"].get(f, 0.0)) if f == "busy" else '',
                                       osd["cpu"].get(f, 0.0)) for f in _cf) + '</tr>')
    parts.append('</table>')
    if os_smp is not None:
        parts.append(osmin_cpu_table(os_smp, m.get("begin_ts", "")))
    _ntop = parse_numa(win["os"].get(("end", "numa"), "")
                       or win["os"].get(("begin", "numa"), ""))
    if _ntop:
        _nbeg = parse_numa(win["os"].get(("begin", "numa"), ""))
        _nend = parse_numa(win["os"].get(("end", "numa"), ""))
        sub("NUMA")
        parts.append(numa_html_table(_ntop,
                     lambda nid, key: _numa_stat_delta(_nbeg, _nend, nid, key)))
    sub("System Activity")
    _th = ['<th class="n">Context Switches per Sec</th>', '<th class="n">Interrupts per Sec</th>']
    _td = ['<td class="n">%.0f</td>' % osd.get("ctxt_per_sec", 0),
           '<td class="n">%.0f</td>' % osd.get("intr_per_sec", 0)]
    if osd.get("forks_per_sec") is not None:
        _th.append('<th class="n">Forks per Sec</th>')
        _td.append('<td class="n">%.1f</td>' % osd["forks_per_sec"])
    _t = osd.get("tcp") or {}
    if _t.get("opens_per_sec") is not None:
        _th.append('<th class="n">TCP Opens per Sec</th>')
        _td.append('<td class="n">%.1f</td>' % _t["opens_per_sec"])
        _th.append('<th class="n">TCP Retrans per Sec</th>')
        _td.append('<td class="n">%.2f</td>' % _t["retrans_per_sec"])
        _th.append('<th class="n">TCP Retrans %</th>')
        _td.append('<td class="n%s">%s</td>' % (
            thr_cell_cls(_t["retrans_pct"], 3.0, 5.0) if _t["retrans_pct"] is not None else "",
            ("%.3f" % _t["retrans_pct"]) if _t["retrans_pct"] is not None else "-"))
        if _t.get("currestab_begin") is not None:
            _th.append('<th class="n">TCP CurrEstab (Begin/End)</th>')
            _td.append('<td class="n">%d / %d</td>' % (_t["currestab_begin"], _t["currestab_end"]))
    if _t.get("opens_per_sec") is not None:
        note("TCP Opens/s = active+passive connections opened (host-aggregate "
             "/proc/net/snmp window delta).\n"
             "TCP Retrans/s = RetransSegs per second; TCP Retrans% = RetransSegs/OutSegs "
             "(bold >3%, red >5%: loss caps single-stream throughput).\n"
             "TCP CurrEstab = established connections at the begin/end snap.")
    parts.append('<table class="t"><tr>%s</tr><tr>%s</tr></table>'
                 % ("".join(_th), "".join(_td)))
    sub("OS Memory Usage")
    _bm = parse_meminfo(win["os"].get(("begin", "meminfo"), ""))
    _em = parse_meminfo(win["os"].get(("end", "meminfo"), ""))
    parts.append('<table class="t"><tr><th>Metric</th><th class="n">Begin MB</th>'
                 '<th class="n">End MB</th><th class="n">Δ MB</th></tr>')
    for _lbl in ("MemTotal","MemFree","MemAvailable","Buffers","Cached",
                 "Active","Active(file)","Active(anon)",
                 "Inactive","Inactive(file)","Inactive(anon)",
                 "Slab","SReclaimable","SUnreclaim","Shmem","Dirty","Writeback",
                 "PageTables","Mapped","SwapTotal","SwapFree"):
        _bv = _bm.get(_lbl, 0) // 1024
        _ev = _em.get(_lbl, 0) // 1024
        parts.append('<tr><td>%s</td><td class="n">%d</td><td class="n">%d</td><td class="n">%+d</td></tr>'
                     % (esc(_lbl), _bv, _ev, _ev - _bv))
    parts.append('</table>')

    sub("Memory / Paging")
    parts.append('<table class="t"><tr><th>Metric</th><th class="n">Total</th>'
                 '<th class="n">Per Second</th></tr>')
    vm = osd.get("vm", {})
    dur_os = osd.get("dur", 1.0) or 1.0
    def vmrow(label, key):
        _v = vm.get(key, 0.0)
        _hi = VM_HI.get(key)
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n%s">%s</td></tr>'
                     % (esc(label), fmt_num(_v * dur_os),
                        thr_cell_cls(_v, *_hi) if _hi else "", fmt_num(_v)))
    vmrow("page in (pgpgin)", "pgpgin")
    vmrow("page out (pgpgout)", "pgpgout")
    vmrow("swap in (pswpin)", "pswpin")
    vmrow("swap out (pswpout)", "pswpout")
    vmrow("minor fault (pgfault)", "pgfault")
    vmrow("major fault (pgmajfault)", "pgmajfault")
    parts.append('</table>')
    if os_smp is not None:
        parts.append(osmin_mem_table(os_smp, m.get("begin_ts", "")))
    sub("Disk I/O per device")
    _dmeta = osd.get("disk_meta") or {}
    _dh = '<th>Device</th>'
    if _dmeta:
        _dh += ('<th class="n">Size</th><th class="n">Type</th><th class="n">Rot</th>'
                '<th class="n">Sched</th><th class="n">QDepth</th><th class="n">NR_RQ</th><th class="n">WC</th>')
    _dh += ('<th class="n">Reads per Sec</th><th class="n">Writes per Sec</th><th class="n">Read B per Sec</th>'
            '<th class="n">Write B per Sec</th>')
    if osd.get("discard_supported"):
        _dh += '<th class="n">Dscrd per Sec</th><th class="n">Dscrd B per Sec</th><th class="n">Flush per Sec</th>'
    _dh += '<th class="n">avg r_await (ms)</th><th class="n">avg w_await (ms)</th></tr>'
    parts.append('<table class="t"><tr>' + _dh)
    disks = osd.get("disks", [])
    ddur = osd.get("dur", 1.0) or 1.0
    if not disks:
        _ncols = 1 + (7 if _dmeta else 0) + 4 + (3 if osd.get("discard_supported") else 0) + 2
        parts.append('<tr><td colspan="%d" class="note">no active disk devices</td></tr>' % _ncols)
    for d in disks:
        _rav = d.get("r_await_ms", 0.0) if d.get("read_iops", 0) > 0 else None
        _wav = d.get("w_await_ms", 0.0) if d.get("write_iops", 0) > 0 else None
        ra = "-" if _rav is None else "%.2f" % _rav
        wa = "-" if _wav is None else "%.2f" % _wav
        row = '<tr><td>%s</td>' % esc(d["name"])
        if _dmeta:
            row += ''.join('<td class="n">%s</td>' % esc(c) for c in disk_meta_cells(d["name"], _dmeta))
        row += ('<td class="n">%.1f</td><td class="n">%.1f</td><td class="n">%s</td><td class="n">%s</td>'
                % (d.get("read_iops", 0), d.get("write_iops", 0),
                   fmt_bytes(d.get("read_bytes", 0) / ddur), fmt_bytes(d.get("write_bytes", 0) / ddur)))
        if osd.get("discard_supported"):
            row += '<td class="n">%.1f</td><td class="n">%s</td><td class="n">%.1f</td>' % (
                   d.get("discard_iops") or 0.0, fmt_bytes((d.get("discard_bytes") or 0) / ddur),
                   d.get("flush_iops") or 0.0)
        row += '<td class="n%s">%s</td><td class="n%s">%s</td></tr>' % (lat_cell_cls(_rav), ra, lat_cell_cls(_wav), wa)
        parts.append(row)
    parts.append('</table>')
    if os_smp is not None:
        parts.append(osmin_disk_table(os_smp, m.get("begin_ts", "")))
    sub("Network per interface")
    dur_os = osd.get("dur", 1.0) or 1.0
    def nrate(it, key):
        return it.get(key, 0.0) / dur_os
    _nmeta = osd.get("net_meta") or {}
    _nh = '<th>Interface</th><th class="n">RX B per Sec</th><th class="n">TX B per Sec</th><th class="n">RX Pkt per Sec</th><th class="n">TX Pkt per Sec</th><th class="n">rx/tx errs (Δ)</th><th class="n">rx/tx drop (Δ)</th>'
    if _nmeta:
        _nh += '<th class="n">RX Util %</th><th class="n">TX Util %</th><th class="n">Speed</th><th class="n">Duplex</th><th class="n">Queues</th><th class="n">RX ring</th><th class="n">TX ring</th>'
    _nh += '</tr>'
    ifaces = osd.get("ifaces", [])
    if ifaces:
        _nl = ["errs/drop (Δ) = whole-window cumulative deltas, not rates; errs usually "
               "mean driver or negotiation faults, drops mean ring-buffer or backlog "
               "exhaustion (consider larger ethtool ring buffers or more queues)."]
        if _nmeta:
            _nl.append("RX/TX Util% = traffic vs the negotiated link speed ('-' when "
                       "unknown, e.g. virtio); Speed/Duplex/Queues/Ring from ethtool "
                       "at the END snap.")
        note("\n".join(_nl))
    parts.append('<table class="t"><tr>' + _nh)
    if not ifaces:
        parts.append('<tr><td colspan="%d" class="note">no network interfaces</td></tr>' % (7 + (7 if _nmeta else 0)))
    for it in ifaces:
        row = '<tr><td>%s</td><td class="n">%.0f</td><td class="n">%.0f</td><td class="n">%.1f</td><td class="n">%.1f</td><td class="n">%.0f / %.0f</td><td class="n">%.0f / %.0f</td>' % (
                         esc(it["name"]), nrate(it, "rx_bytes"), nrate(it, "tx_bytes"),
                         nrate(it, "rx_packets"), nrate(it, "tx_packets"),
                         it.get("rx_errs", 0.0), it.get("tx_errs", 0.0),
                         it.get("rx_drop", 0.0), it.get("tx_drop", 0.0))
        if _nmeta:
            # utilization vs negotiated link speed; '-' when speed unknown (virtio)
            _sp = speed_mbps(_cell(_nmeta.get(it["name"]) or {}, "speed"))
            _ru = "%.1f" % (nrate(it, "rx_bytes") * 8.0 / (_sp * 1e6) * 100.0) if _sp else "-"
            _tu = "%.1f" % (nrate(it, "tx_bytes") * 8.0 / (_sp * 1e6) * 100.0) if _sp else "-"
            row += '<td class="n">%s</td><td class="n">%s</td>' % (_ru, _tu)
            row += ''.join('<td class="n">%s</td>' % esc(c) for c in net_meta_cells(it["name"], _nmeta))
        row += '</tr>'
        parts.append(row)
    parts.append('</table>')
    if os_smp is not None:
        parts.append(osmin_net_table(os_smp, m.get("begin_ts", "")))

    # ---- TCP RTT / Connections: window gauges (per-minute ssrtt) + END-snap
    # per-conn tcp_info. Section hidden when neither source exists (snap(s)
    # predate the ssrtt sampler / no ss on the host). ----
    _rttser = ([(ts, d) for ts, d in os_minute_rtt_series(os_smp)
                if not m.get("begin_ts") or ts >= str(m.get("begin_ts"))]
               if os_smp is not None else [])
    _rttconns = parse_net_rtt(win["os"].get(("end", "net_rtt"), ""))
    if _rttser or _rttconns:   # peaks imply ssrtt rows, hence _rttser, too
        sub("TCP RTT / Connections")
        note("RTT = kernel smoothed round-trip time (ss) per established non-loopback "
             "connection; bold >5 ms, red >20 ms.\n"
             "Top-10 tables show WINDOW PEAKS from per-minute sampling: a connection "
             "that stalled mid-window still appears even if it closed before the END "
             "snap.\n"
             "Send-Q = bytes queued unsent (limited by the receiver window or cwnd); "
             "cwnd = congestion window (in-flight limit the kernel allows).\n"
             "retr = retransmitted segments on that connection; RTTVar = RTT variance.")
        if _rttser:
            note("Per-stream throughput ceiling (Mathis) ~ 1.22*MSS*8 / (RTT * "
                 "sqrt(loss)) from this window's RTT and Retrans% -- how far ONE TCP "
                 "stream could go under that loss, not a measured rate.")
        _peaks = (window_peer_peaks(os_smp, m.get("begin_ts", ""))
                  if os_smp is not None else {})
        if _rttser:
            _conns_avg = sum(d["conns"] for _, d in _rttser) / len(_rttser)
            _conns_max = max(d["conns"] for _, d in _rttser)
            _rtt_avg = sum(d["rtt_avg"] for _, d in _rttser) / len(_rttser)
            _p95_max = max(d["rtt_p95"] for _, d in _rttser)
            _worst = max(_rttser, key=lambda r: r[1]["worst_rtt"])
            _ra_cls = thr_cell_cls(_rtt_avg, 5.0, 20.0)
            _rows = [
                '<tr><td>Conns (non-loopback, avg / max)</td>'
                '<td class="n">%.1f / %.0f</td></tr>' % (_conns_avg, _conns_max),
                '<tr><td>RTT avg (mean of minutes, ms)</td>'
                '<td class="n%s">%.3f</td></tr>' % (_ra_cls, _rtt_avg),
                '<tr><td>RTT p95 (max of minutes, ms)</td>'
                '<td class="n%s">%.3f</td></tr>' % (thr_cell_cls(_p95_max, 5.0, 20.0), _p95_max),
                '<tr><td>Worst peer (window)</td>'
                '<td class="n">%s @ %.3f ms</td></tr>'
                % (esc(_worst[1]["worst_peer"]), _worst[1]["worst_rtt"]),
            ]
            # Mathis per-stream ceiling ~ 1.22*MSS*8 / (RTT * sqrt(loss));
            # RTT from this window, loss from the window Retrans% -- a rough
            # "how far can ONE tcp stream go" signal, not a measured rate.
            _rp = (osd.get("tcp") or {}).get("retrans_pct")
            _msss = (sorted(d["mss"] for d in _peaks.values() if d.get("mss"))
                     or sorted(c["mss"] for c in _rttconns if c.get("mss"))
                     or [1448])
            _mss = _msss[len(_msss) // 2]
            if _rtt_avg > 0 and _rp is not None and _rp > 0:
                _ceil = 1.22 * _mss * 8 / ((_rtt_avg / 1000.0) * (_rp / 100.0) ** 0.5)
                _rows.append('<tr><td>Per-stream throughput ceiling (Mathis; '
                             'MSS %d, RTT %.3f ms, Retrans %.3f%%)</td>'
                             '<td class="n">%s/s</td></tr>'
                             % (_mss, _rtt_avg, _rp, fmt_bytes(_ceil)))
            elif _rtt_avg > 0:
                _rows.append('<tr><td>Per-stream throughput ceiling (Mathis)</td>'
                             '<td class="n">no loss in window</td></tr>')
            parts.append('<table class="t"><tr><th>Metric</th><th class="n">Value</th></tr>'
                         + "".join(_rows) + '</table>')
        if _peaks:
            # window peaks from per-minute sspeer rows: whoever spiked Send-Q
            # or had the worst RTT at ANY minute of the window, with the minute
            # it happened -- a mid-window stall that closed before the end snap
            # still shows up (unlike the END-snap fallback below)
            def _peak_rows(items, mode):
                r = []
                for (peer, lport), d in items:
                    if mode == "sq":
                        _v, _vt, _o1, _o1v = d["max_sq"], d["sq_ts"], "RTT (ms)", d["sq_rtt"]
                        _o2, _o3 = d["sq_cwnd"], d["sq_retr"]
                        _vcell = ('<td class="n%s">%s</td>'
                                  % (thr_cell_cls(_v, 1048576.0, 10485760.0), fmt_num(_v)))
                    else:
                        _v, _vt, _o1, _o1v = d["max_rtt"], d["rtt_ts"], "Send-Q", d["rtt_sq"]
                        _o2, _o3 = d["rtt_cwnd"], d["rtt_retr"]
                        _vcell = ('<td class="n%s">%.3f</td>'
                                  % (thr_cell_cls(_v, 5.0, 20.0), _v))
                    r.append('<tr><td>%s</td><td class="n">%s</td>%s<td>%s</td>'
                             '<td class="n%s">%s</td><td class="n">%s</td><td class="n">%s</td></tr>'
                             % (esc(peer), esc(lport), _vcell, esc(_vt),
                                thr_cell_cls(_o1v, 5.0, 20.0) if (_o1 == "RTT (ms)" and _o1v is not None) else "",
                                ("%.3f" % _o1v) if (_o1 == "RTT (ms)" and _o1v is not None)
                                else (fmt_num(_o1v) if _o1v is not None else "-"),
                                _o2 if _o2 is not None else "-",
                                _o3 if _o3 is not None else "-"))
                return "".join(r)
            _phdr = ('<table class="t"><tr><th>Peer</th><th>Local Port</th><th>Peak Send-Q</th>'
                     '<th>Peak Time</th><th>RTT at peak (ms)</th><th>cwnd</th><th>retr</th></tr>')
            _bysq = [(k, d) for k, d in sorted(_peaks.items(), key=lambda kv: -kv[1]["max_sq"])
                     if d["max_sq"] > 0][:10]
            if _bysq:
                parts.append('<div class="sub">Top 10 by Send-Q</div>')
                parts.append(_phdr + _peak_rows(_bysq, "sq") + '</table>')
            _phdr2 = ('<table class="t"><tr><th>Peer</th><th>Local Port</th><th>Peak RTT (ms)</th>'
                      '<th>Peak Time</th><th>Send-Q at peak</th><th>cwnd</th><th>retr</th></tr>')
            _byrtt = sorted(_peaks.items(), key=lambda kv: -kv[1]["max_rtt"])[:10]
            if _byrtt:
                parts.append('<div class="sub">Top 10 by RTT</div>')
                parts.append(_phdr2 + _peak_rows(_byrtt, "rtt") + '</table>')
        elif _rttconns:
            def _peer_rows(sel):
                r = []
                for c in sel:
                    r.append('<tr><td>%s</td><td class="n">%s</td><td class="n%s">%.3f</td>'
                             '<td class="n">%.3f</td><td class="n">%s</td><td class="n">%s</td>'
                             '<td class="n">%s</td></tr>'
                             % (esc(c["peer"]), esc(c["lport"]),
                                thr_cell_cls(c["rtt_ms"], 5.0, 20.0), c["rtt_ms"],
                                c["rttvar_ms"],
                                c["cwnd"] if c["cwnd"] is not None else "-",
                                c["retrans"] if c["retrans"] is not None else "-",
                                fmt_num(c["sendq"])))
                return "".join(r)
            _phdr = ('<table class="t"><tr><th>Peer</th><th>Local Port</th><th>RTT (ms)</th>'
                     '<th>RTTVar</th><th>cwnd</th><th>retr</th><th>Send-Q</th></tr>')
            parts.append('<div class="sub">Top 10 by Send-Q</div>')
            parts.append(_phdr + _peer_rows(sorted(_rttconns, key=lambda c: -c["sendq"])[:10]) + '</table>')
            parts.append('<div class="sub">Top 10 by RTT</div>')
            parts.append(_phdr + _peer_rows(sorted(_rttconns, key=lambda c: -c["rtt_ms"])[:10]) + '</table>')

    _sn = osd.get("softnet")
    if _sn is not None:
        sub("Softnet")
        note("dropped = RX packets discarded because the backlog was full (raise "
             "net.core.netdev_max_backlog / add queues).\n"
             "time_squeeze = softirq exhausted its budget and deferred the rest "
             "(consider RPS / IRQ affinity).")
        parts.append('<table class="t"><tr><th>Metric</th><th class="n">Total</th>'
                     '<th class="n">Per Second</th></tr>'
                     '<tr><td>packets processed</td><td class="n">%s</td><td class="n">%s</td></tr>'
                     '<tr><td>dropped (backlog full)</td><td class="n%s">%s</td><td class="n">%s</td></tr>'
                     '<tr><td>time_squeeze (softirq starved)</td><td class="n%s">%s</td><td class="n">%s</td></tr>'
                     '</table>'
                     % (fmt_num(_sn["packets"]), fmt_num(_sn["packets"] / dur_os),
                        thr_cell_cls(_sn["dropped"], 0, 100), fmt_num(_sn["dropped"]),
                        fmt_num(_sn["dropped"] / dur_os) if dur_os else "-",
                        thr_cell_cls(_sn["squeezed"], 0, 1000), fmt_num(_sn["squeezed"]),
                        fmt_num(_sn["squeezed"] / dur_os) if dur_os else "-"))

    if osd.get("netstat_ok"):
        sub("Network Protocol Errors")
        note("Rows = window deltas per counter; Per Second = delta / window; "
             "zero-delta rows grayed, core counters first.\n"
             "InErrs = bad segments received; RetransSegs = segments retransmitted "
             "out.\n"
             "ListenOverflows/ListenDrops = accept-queue overflow; Timeouts = RTO "
             "expirations (heavy loss).\n"
             "AbortOnData/Timeout/Close/Memory = who reset the connection and why.\n"
             "OFOQueue/OFODrop = out-of-order segments (path reordering).\n"
             "WantZeroWindowAdv/ToZeroWindowAdv = receiver application too slow to "
             "drain its socket.\n"
             "SACKReneging = receiver dropped data it had already SACKed (serious); "
             "MemoryPressures = TCP memory limits hit.")
        parts.append('<table class="t"><tr><th>Protocol</th><th>Counter</th>'
                     '<th class="n">Total</th><th class="n">Per Second</th></tr>')
        # Core rows
        dur_os = osd.get("dur", 1.0) or 1.0
        for proto, name, label, delta, ps in netstat_core_rows(win["os"], dur_os):
            _m = " class=\"n muted\"" if not delta else " class=\"n\""
            parts.append('<tr><td>%s</td><td>%s</td><td%s>%+.0f</td><td%s>%.3f</td></tr>'
                         % (esc(proto), esc(label), _m, delta or 0, _m, ps or 0.0))
        # Tail rows (non-core counters)
        for r in osd.get("netstat_errs", [])[:20]:
            _m = " class=\"n muted\"" if not r["delta"] else " class=\"n\""
            parts.append('<tr><td>%s</td><td>%s</td><td%s>%+.0f</td><td%s>%.3f</td></tr>'
                         % (esc(r["proto"]), esc(r["name"]), _m, r["delta"], _m, r["per_sec"]))
        parts.append('</table>')

    # ================= Time Model System Stats =================
    sec("Time Model System Stats")
    it_keys = sorted(IT.keys(), key=lambda k: IT[k].get("value", 0.0), reverse=True)
    parts.append('<table class="t"><tr><th>Stat</th><th class="n">Time (s)</th>'
                 '<th class="n">% DB time</th></tr>')
    if not it_keys:
        parts.append('<tr><td colspan="3" class="note">no data</td></tr>')
    for k in it_keys:
        v = IT[k].get("value", 0.0)
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%.2f%%</td></tr>'
                     % (esc(k), s_of(v), pct(v, dbt)))
    parts.append('</table>')

    # ================= Load Profile =================
    def _dbsum(phase, col):
        return sum(to_num(r.get(col, 0) or 0) for r in win["db"].get((phase, "database"), []))
    def _dbval(phase, dn, col):
        for r in win["db"].get((phase, "database"), []):
            if r.get("datname") == dn:
                return to_num(r.get(col, 0) or 0)
        return 0.0
    def _lsn_to_int(lsn):
        try:
            hi, lo = (lsn or "").split("/")
            return (int(hi, 16) << 32) + int(lo, 16)
        except Exception:
            return 0
    def _pwlsn(phase, col):
        return sum(_lsn_to_int(r.get(col, "")) for r in win["db"].get((phase, "pagewriter"), []))
    def _pwlsn_str(phase, col):
        _rows = win["db"].get((phase, "pagewriter"), [])
        if not _rows:
            return ""
        if len(_rows) == 1:
            return _rows[0].get(col, "")
        return "%s (+%d nodes)" % (_rows[0].get(col, ""), len(_rows) - 1)
    sec("Load Profile")
    if dbt < 0 or commits < 0 or blks_read < 0 or tup_ret < 0:
        note("WARNING: negative delta detected (cumulative counter end < begin) — possible counter reset/wraparound; values in this report may be unreliable.")
    parts.append('<table class="t"><tr><th>Metric</th>'
                 '<th class="n">Begin</th><th class="n">End</th>'
                 '<th class="n">Δ Total</th><th class="n">Δ Per Second</th></tr>')
    def lp(label, col):
        _b = _dbsum("begin", col); _e = _dbsum("end", col); _d = _e - _b
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td></tr>'
                     % (esc(label), fmt_int(_b), fmt_int(_e), fmt_int(_d), fmt_num(_d / duration)))
    lp("blocks read (blks_read)", "blks_read")
    lp("blocks hit (blks_hit)", "blks_hit")
    lp("rows returned (tup_returned)", "tup_returned")
    lp("rows fetched (tup_fetched)", "tup_fetched")
    lp("rows inserted (tup_inserted)", "tup_inserted")
    lp("rows updated (tup_updated)", "tup_updated")
    lp("rows deleted (tup_deleted)", "tup_deleted")
    lp("commits (xact_commit)", "xact_commit")
    lp("rollbacks (xact_rollback)", "xact_rollback")
    lp("deadlocks", "deadlocks")
    lp("conflicts", "conflicts")
    lp("temp bytes", "temp_bytes")
    if "standby" in str(m.get("db_role", "")):
        # standby writes no local WAL (its xlog insert lsn sits at a static
        # near-zero) -- show replay progress from the standby's own
        # walreceiver instead; "-" when a side has no walreceiver row (old
        # snaps, or a window that spans a promote)
        _wrr = lambda ph: win["db"].get((ph, "walreceiver"), [])
        _wrb, _wre = _wrr("begin"), _wrr("end")
        if _wrb and _wre:
            _wr_bs = _wrb[0].get("receiver_replay_location", "") or "-"
            _wr_es = _wre[0].get("receiver_replay_location", "") or "-"
            _wr_d = (sum(_lsn_to_int(r.get("receiver_replay_location", "")) for r in _wre)
                     - sum(_lsn_to_int(r.get("receiver_replay_location", "")) for r in _wrb))
            parts.append('<tr><td>WAL replayed (receiver replay lsn)</td><td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td><td class="n">%s</td></tr>'
                         % (esc(_wr_bs), esc(_wr_es), fmt_bytes(_wr_d), fmt_bytes(_wr_d / duration)))
        else:
            parts.append('<tr><td>WAL replayed (receiver replay lsn)</td><td class="n">-</td><td class="n">-</td>'
                         '<td class="n">-</td><td class="n">-</td></tr>')
    else:
        _wal_bs = _pwlsn_str("begin", "current_xlog_insert_lsn"); _wal_es = _pwlsn_str("end", "current_xlog_insert_lsn")
        _wal_d = _pwlsn("end", "current_xlog_insert_lsn") - _pwlsn("begin", "current_xlog_insert_lsn")
        parts.append('<tr><td>WAL written (xlog insert lsn)</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td></tr>'
                     % (esc(_wal_bs), esc(_wal_es), fmt_bytes(_wal_d), fmt_bytes(_wal_d / duration)))
    _pf_bs = _pwlsn_str("begin", "ckpt_redo_point"); _pf_es = _pwlsn_str("end", "ckpt_redo_point")
    _pf_d = _pwlsn("end", "ckpt_redo_point") - _pwlsn("begin", "ckpt_redo_point")
    parts.append('<tr><td>pagewriter written (ckpt_redo_point)</td><td class="n">%s</td><td class="n">%s</td>'
                 '<td class="n">%s</td><td class="n">%s</td></tr>'
                 % (esc(_pf_bs), esc(_pf_es), fmt_bytes(_pf_d), fmt_bytes(_pf_d / duration)))
    parts.append('</table>')

    # ================= Cache Hit Ratio =================
    sec("Cache Hit Ratio")
    parts.append('<table class="t"><tr><th>Database</th>'
                 '<th class="n">Begin Hit%</th><th class="n">End Hit%</th>'
                 '<th class="n">Window Hit%</th></tr>')
    _cr_dns = set()
    for _ph in ("begin", "end"):
        for _r in win["db"].get((_ph, "database"), []):
            if _r.get("datname") and _r.get("datname") not in ("template0", "template1"):
                _cr_dns.add(_r.get("datname"))
    _cr_items = []
    for _dn in _cr_dns:
        _bhb = _dbval("begin", _dn, "blks_hit"); _brb = _dbval("begin", _dn, "blks_read")
        _bhe = _dbval("end", _dn, "blks_hit"); _bre = _dbval("end", _dn, "blks_read")
        _tb = _bhb + _brb; _te = _bhe + _bre
        if _tb <= 0 and _te <= 0:
            continue
        _rb = (_bhb / _tb * 100.0) if _tb else 0.0
        _re = (_bhe / _te * 100.0) if _te else 0.0
        # window ratio from deltas: cumulative ratios dilute months of history
        # and their diff (~0.01%) hides real degradation inside this window
        _dh = _bhe - _bhb; _dr = _bre - _brb; _dt = _dh + _dr
        _rw = (_dh / _dt * 100.0) if _dt > 0 else None
        _cr_items.append((_dn, _rb, _re, _te, _rw))
    _cr_items.sort(key=lambda x: x[3], reverse=True)
    if not _cr_items:
        parts.append('<tr><td colspan="4" class="note">no data</td></tr>')
    for _dn, _rb, _re, _, _rw in _cr_items:
        _rws = ('%.2f%%' % _rw) if _rw is not None else '-'
        parts.append('<tr><td>%s</td><td class="n">%.2f%%</td><td class="n">%.2f%%</td>'
                     '<td class="n">%s</td></tr>' % (esc(_dn), _rb, _re, _rws))
    parts.append('</table>')

    # ================= Database Memory (vb_tool mem style) =================
    sec("Database Memory")
    def qtable(label, sql):
        sub(label)
        _rows = psql_query(sql)
        if not _rows:
            parts.append('<div class="note">no data</div>')
            return
        _cols = list(_rows[0].keys())
        parts.append('<table class="t"><tr>' + ''.join('<th>%s</th>' % esc(c) for c in _cols) + '</tr>')
        for _r in _rows:
            parts.append('<tr>' + ''.join('<td>%s</td>' % esc(_r.get(c, "")) for c in _cols) + '</tr>')
        parts.append('</table>')
    def be_table(label, begin_rows, end_rows, key_col, val_col, fmt_fn, top=None, key_header=None, cnt_col=None):
        sub(label)
        _b = {}; _e = {}; _bc = {}; _ec = {}
        for _r in begin_rows:
            try:
                _k = _r.get(key_col, "")
                _b[_k] = to_num(_r.get(val_col, 0) or 0)
                if cnt_col: _bc[_k] = to_num(_r.get(cnt_col, 0) or 0)
            except Exception: pass
        for _r in end_rows:
            try:
                _k = _r.get(key_col, "")
                _e[_k] = to_num(_r.get(val_col, 0) or 0)
                if cnt_col: _ec[_k] = to_num(_r.get(cnt_col, 0) or 0)
            except Exception: pass
        if top:
            # full outer join: end top-N + begin top-N (end-first, dedup).
            # begin value for an end-only-top context is looked up from full _b.
            _E_top = sorted(_e.keys(), key=lambda _k: _e.get(_k, 0), reverse=True)[:top]
            _B_top = sorted(_b.keys(), key=lambda _k: _b.get(_k, 0), reverse=True)[:top]
            _keys = list(dict.fromkeys(_E_top + _B_top))
        else:
            _keys = sorted(set(_b) | set(_e), key=lambda _k: max(_e.get(_k, 0), _b.get(_k, 0)), reverse=True)
