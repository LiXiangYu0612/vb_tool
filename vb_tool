    @staticmethod
    def generate_lock_chain_section(lock_chain_list):
        """
        生成锁等待链章节 HTML：按等待事务分组，展示等待者 ← 持有者及其语句。
        """
        if not lock_chain_list:
            return ''

        # 只保留有阻塞者信息的 acquired 事件（waiting 已合并到 acquired），按 holder_txid 分组
        # 注意：holder_txid 可能为空字符串，此时仍应显示（标记为未知阻塞者）
        chain_events = [
            ev for ev in lock_chain_list
            if ev.get('event_kind') == 'acquired'
        ]
        if not chain_events:
            return ''

        # 按 holder_txid 分组，按等待耗时降序排序
        from collections import defaultdict
        grouped = defaultdict(list)
        for ev in chain_events:
            grouped[ev['holder_txid']].append(ev)

        # 按组内最大等待耗时降序排列
        sorted_groups = sorted(
            grouped.items(),
            key=lambda x: max(ev.get('wait_time_ms', 0) for ev in x[1]),
            reverse=True
        )

        html_parts = []
        html_parts.append("""
