                        <th>SQL / 锁目标</th>
                        <th>等待锁类型</th>
                        <th>锁定耗时 (s)</th>
                        <th>连接标识</th>
                        <th>相关日志</th>
                    </tr>
        """)

        for idx, item in enumerate(top10, 1):
            session_id = html.escape(str(item.get('session_id', '')), quote=True)
            txid = html.escape(str(item.get('txid', '')), quote=True)
            timestamp = html.escape(str(item.get('timestamp', '')), quote=True)
            lock_type = html.escape(str(item.get('lock_type', '')), quote=True)
            target = html.escape(str(item.get('target', '')), quote=True)
            wait_time_ms = item.get('wait_time_ms', 0)
            connection_key = html.escape(str(item.get('connection_key', '')), quote=True)
            log_text = item.get('log_text', '')
            sql_text = item.get('sql_text', '')
            unique_id = str(item.get('unique_id', '')).strip()

            # 生成跳转锚点 id：与慢SQL 详情中"锁等待详情"的跳转链接保持一致
