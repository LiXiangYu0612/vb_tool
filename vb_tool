def process_single_file(file_name, args, total_elapsed_time=0):
    """
    处理单个日志文件
    
    Args:
        file_name (str): 日志文件名
        args: 命令行参数
        
    Returns:
        tuple: (total_list, file_size_mb) - 解析结果和文件大小
    """
    print(f"\n正在处理文件: {file_name}")
    
    # 使用优化的文件读取
    content = read_log_file_stream(file_name)
    
    # 检查文件大小并给出优化建议
    file_size = len(content)
    file_size_mb = file_size / (1024 * 1024)
    print(f"文件大小: {file_size_mb:.2f} MB")
    

    
    # 使用预编译的正则表达式分割日志
    blocks = TIMESTAMP_PATTERN.split(content)[1:]
    if not blocks:
        print("警告: 未在文件中找到符合格式的日志记录")
        return [], [], file_size_mb, [], [], [], new_connection_stats()

    # 时间范围过滤：-d 已在参数解析时折算为 args.begin（now-N天），
    # 此处统一走 -b/-e 块过滤逻辑，无需单独的 -d 处理。

    # Parse start and end times（更健壮的跨文件范围过滤）
    start_n = 0
    earliest_ts = parse_datetime(blocks[0])
    latest_ts = parse_datetime(blocks[-2])
    # 首尾块时间戳畸形时 earliest_ts/latest_ts 为 None: 此时无法定位边界,
    # 一律按"文件整体在窗内"处理(不跳文件、不裁剪), 绝不能拿 None 做比较炸掉整文件
    # 处理 begin
    v_begin = None
    if args.begin:
        v_begin = parse_datetime(args.begin)
        if v_begin is not None:
            # 开始时间晚于文件最后时间 → 跳过该文件
            if latest_ts is not None and v_begin > latest_ts:
                return [], [], file_size_mb, [], [], [], new_connection_stats()
            # 开始时间早于等于文件最早时间(或文件时间不可解析) → 从头开始
            elif earliest_ts is None or v_begin <= earliest_ts:
                start_n = 0
            else:
                # 在文件范围内，定位起始块索引
                for i in range(0, len(blocks)-2, 2):
                    timestamp1 = parse_datetime(blocks[i])
                    timestamp2 = parse_datetime(blocks[i+2])
                    if timestamp1 is not None and timestamp2 is not None \
                            and v_begin <= timestamp2 and v_begin >= timestamp1:
                        start_n = i
                        break
        # 无法解析 begin 则忽略，由后续逻辑处理
    # 处理 end
    if args.end:
        v_end = parse_datetime(args.end)
        if v_end is not None:
            # 结束时间早于文件最早时间 → 跳过该文件
            if earliest_ts is not None and v_end < earliest_ts:
                return [], [], file_size_mb, [], [], [], new_connection_stats()
            # 结束时间早于文件最后时间 → 裁剪 blocks
            elif latest_ts is not None and v_end < latest_ts:
                matching_index = -2
                for i in range(len(blocks)-2, -2, -2):
                    time_value = parse_datetime(blocks[i])
                    if time_value is not None and time_value <= v_end:
                        matching_index = i
                        break
                if matching_index != -2:
                    blocks = blocks[:matching_index+2]

    # 日志时间是 SQL 结束时间，不能据此裁掉开始早于 -b、但生命周期覆盖报告范围的 SQL。
    # 保留完整日志块，由解析器只放宽慢 SQL 的过滤，其他日志仍按原时间范围统计。
    if v_begin is not None:
        start_n = 0

    # Set the analysis type
    e_type =  'slow'

    # 初始化结果收集列表
    total_list = []
    deadlock_list = []
    lock_event_list = []
    lock_chain_list = []
    error_list = []
    connection_stats = new_connection_stats()

    # Process logs based on the analysis type
    if e_type == 'slow':
        # 单次扫描同时解析慢SQL、死锁和锁事件
        parse_all_events(start_n, blocks, total_list, deadlock_list, lock_event_list, lock_chain_list, total_elapsed_time, log_format_info, error_list, connection_stats)
    else:
        print(f'Error: not support type {e_type}')
        return [], [], file_size_mb, [], [], [], new_connection_stats()
    
    special_event_count = sum(1 for event in error_list if event.get('level') == 'BUG' or event.get('level') == 'SPECIAL')
    normal_error_count = sum(1 for event in error_list if event.get('level') != 'SPECIAL')
    print(f"处理完成:{len(total_list)}条慢SQL,{len(deadlock_list)}条死锁,{len(lock_event_list)}条锁事件,{len(lock_chain_list)}条锁等待链,{normal_error_count}条错误,{special_event_count}条特殊事件")

    # 显式释放大内存变量
    del blocks
    del content

    # 检查内存使用情况
    check_memory_usage(2048)  # 2GB 阈值

    # 进行垃圾回收，释放内存
    gc.collect()

    return total_list, deadlock_list, file_size_mb, lock_event_list, lock_chain_list, error_list, connection_stats

def _filter_non_table_truncates(error_list, timeout=5, debug=False):
    """过滤 TRUNCATE 记录中的非普通表对象。

    内部日志 RelationSetNewRelfilenode 会对索引/TOAST 等对象也产生记录,
    过滤策略按环境自动选择：
    - 本地分析（vsql 可用）：按 database 分组逐库查询 pg_class，精确过滤 relkind<>'r' 的对象
    - 异地分析（vsql 不可用）：回退到按对象名前缀粗略过滤（pg_toast* 等 TOAST 表直接过滤）

    Args:
        error_list: 错误记录列表(就地过滤)
        timeout: 单库 vsql 调用超时(秒)
        debug: 是否打印调试日志

    Returns:
        int: 被过滤掉的 TRUNCATE 记录条数
    """
    trunc_entries = [e for e in error_list if e.get('level') == 'TRUNCATE' and (e.get('message') or '').startswith('truncate table ')]
    if not trunc_entries:
        return 0

    # 尝试本地 vsql 精确过滤
    removed = _filter_truncates_by_vsql(error_list, trunc_entries, timeout=timeout, debug=debug)
    if removed is not None:
        return removed

    # vsql 不可用，回退到粗略名称过滤
    return _filter_truncates_by_name(error_list, debug=debug)


def _filter_truncates_by_vsql(error_list, trunc_entries, timeout=5, debug=False):
    """本地分析：通过 vsql 查询 pg_class 精确过滤非普通表对象。

    Returns:
        int: 被过滤掉的记录条数；vsql 不可用时返回 None（由调用方回退）
    """
    # 检查 vsql 是否可用
    try:
        test_proc = subprocess.Popen(
            ['vsql', '--version'],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            universal_newlines=True
        )
        test_proc.communicate()
    except FileNotFoundError:
        if debug:
            print("[DEBUG] 未找到 vsql 命令，回退到粗略名称过滤", file=sys.stderr)
        return None

    # 按库分组收集对象名: {db: {rel_name_lower: rel_name}}
    # 同一对象多次 TRUNCATE 只收集一次，减少 IN 列表长度
    db_objects = {}
    for e in trunc_entries:
        db = e.get('database') or 'postgres'
        msg = e.get('message') or ''
        rel = msg[len('truncate table '):].strip()
        if not rel:
            continue
        db_objects.setdefault(db, {})[rel.lower()] = rel

    if not db_objects:
        return 0

    # 逐库查询，保留 relkind='r' 的对象
    valid_tables = {}  # {db: set(rel_name_lower)}
    total_dbs = len(db_objects)
    failed_dbs = []
    for db_idx, (db, obj_map) in enumerate(db_objects.items(), 1):
        if debug:
            print(f"[DEBUG] DDL 对象校验: 查询数据库 {db} ({db_idx}/{total_dbs}), 对象数={len(obj_map)}", file=sys.stderr)

        # Linux 单个 exec 参数通常受 MAX_ARG_STRLEN(128KiB)限制；预留余量，
        # 保持 vsql -c 模式，仅将 IN 列表分批，避免整库查询退化为名称过滤。
        query_prefix = "SELECT relname FROM pg_class WHERE relname IN ("
        query_suffix = ") AND relkind = 'r';"
        max_query_bytes = 32768
        query_batches = []
        names_batch = []
        batch_bytes = len((query_prefix + query_suffix).encode('utf-8'))
        for rel in obj_map.values():
            quoted_name = "'" + rel.replace("'", "''") + "'"
            name_bytes = len(quoted_name.encode('utf-8')) + (1 if names_batch else 0)
            if names_batch and batch_bytes + name_bytes > max_query_bytes:
                query_batches.append(query_prefix + ','.join(names_batch) + query_suffix)
                names_batch = []
                batch_bytes = len((query_prefix + query_suffix).encode('utf-8'))
                name_bytes = len(quoted_name.encode('utf-8'))
            names_batch.append(quoted_name)
            batch_bytes += name_bytes
        if names_batch:
            query_batches.append(query_prefix + ','.join(names_batch) + query_suffix)

        ok = set()
        for batch_idx, query in enumerate(query_batches, 1):
            try:
                process = subprocess.Popen(
                    ['vsql', '-d', db, '-X', '-q', '-A', '-t', '-c', query],
                    stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                    universal_newlines=True
                )
                stdout, stderr = process.communicate(timeout=timeout)
            except Exception as e:
                if debug:
                    print(f"[DEBUG] DDL 对象校验查询失败(db={db}): {e}", file=sys.stderr)
                failed_dbs.append(db)
                ok = None
                break
            if process.returncode != 0:
                if debug:
                    print(f"[DEBUG] DDL 对象校验查询失败(db={db}): {stderr.strip()}", file=sys.stderr)
                failed_dbs.append(db)
                ok = None
                break
            for line in stdout.strip().split('\n'):
                line = line.strip()
                if line:
                    ok.add(line.lower())
        if ok is None:
            valid_tables[db] = {k for k in obj_map.keys() if not _is_likely_non_table_object(k)}
            continue
        valid_tables[db] = ok
        print(f" DDL 对象校验: 数据库 {db} 完成，有效表 {len(ok)}/{len(obj_map)}", file=sys.stderr)

    if failed_dbs:
        print(f"WARNING: DDL 对象校验失败，涉及 {len(failed_dbs)} 个数据库，已回退名称过滤", file=sys.stderr)

    # 构建全局无效对象集合: {(db, rel_lower), ...}
    invalid_objects = set()
    for db, obj_map in db_objects.items():
        for rel_lower, rel in obj_map.items():
            if rel_lower not in valid_tables.get(db, set()):
                invalid_objects.add((db, rel_lower))

    # 就地过滤:删除非表 TRUNCATE 记录（DROP/ALTER 记录不走 vsql 校验，直接保留）
    removed = 0
    keep = []
    for e in error_list:
        if e.get('level') != 'TRUNCATE':
            keep.append(e)
            continue
        msg = e.get('message') or ''
        if not msg.startswith('truncate table '):
            keep.append(e)
            continue
        db = e.get('database') or 'postgres'
        rel = msg[len('truncate table '):].strip()
        if not rel:
            keep.append(e)
            continue
        if (db, rel.lower()) in invalid_objects:
            removed += 1
        else:
            keep.append(e)
    error_list[:] = keep
    if removed and debug:
        print(f"DDL: 对象记录过滤(vsql), 移除 {removed} 条非普通表对象记录")
    return removed


def _is_likely_non_table_object(rel_lower):
    """按对象名粗略判定是否很可能不是普通表(TOAST 表、索引等)。

    规则:
      - pg_*          : 系统对象及 TOAST 表(附属存储,relkind='t' 等)
      - pk_* / idx_* : 主键或普通索引(relkind='i')
      - *toast*       : 对象名任意位置含 toast 的 TOAST 相关对象
      - 名字中含 idx  : 很可能是索引(如 idx_xxx / xxx_idx / myidx2,relkind='i')

    Args:
        rel_lower (str): 已转小写的对象名
    Returns:
        bool: True 表示应过滤(很可能不是普通表)
    """
    if not rel_lower:
        return False
    if rel_lower.startswith(('pg_', 'pk_', 'idx_')):
        return True
    if 'toast' in rel_lower:
        return True
    # 名字含 'idx' 视为索引(用户规则: 宁可少放行,不能多放行)
    if 'idx' in rel_lower:
        return True
    return False


def _filter_truncates_by_name(error_list, debug=False):
    """异地分析：按对象名前缀粗略过滤 TOAST 等非表对象。"""
    removed = 0
    keep = []
    for e in error_list:
        if e.get('level') != 'TRUNCATE':
            keep.append(e)
            continue
        msg = e.get('message') or ''
        if not msg.startswith('truncate table '):
            keep.append(e)
            continue
        rel = msg[len('truncate table '):].strip()
        if not rel:
            keep.append(e)
            continue
        rel_lower = rel.lower()
        if _is_likely_non_table_object(rel_lower):
            removed += 1
            if debug:
                print(f"[DEBUG] DDL 对象记录过滤: {rel}", file=sys.stderr)
            continue
        keep.append(e)
    error_list[:] = keep
    if removed:
        print(f"DDL: 对象记录过滤(名称), 移除 {removed} 条非表对象记录")
    return removed


def process_multiple_files(file_names, args):
    """
    处理多个日志文件
    
    Args:
        file_names (list): 日志文件名列表
        args: 命令行参数
        
    Returns:
        tuple: (all_total_list, all_deadlock_list, total_size, total_elapsed_time, all_lock_event_list, all_lock_chain_list)
    """
    all_total_list = []
    all_deadlock_list = []
    all_lock_event_list = []
    all_lock_chain_list = []
    all_error_list = []
    all_connection_stats = new_connection_stats()
    total_size = 0
    total_elapsed_time = 0  # 总耗时
    
    print(f"开始处理 {len(file_names)} 个日志文件...")
    
    for i, file_name in enumerate(file_names, 1):
        print(f"\n{'='*60}")
        print(f"处理进度: {i}/{len(file_names)}")
        
        try:
            file_start_time = datetime.now()  # 记录单个文件开始时间
            total_list, deadlock_list, file_size_mb, lock_event_list, lock_chain_list, error_list, connection_stats = process_single_file(file_name, args, total_elapsed_time)
            file_end_time = datetime.now()  # 记录单个文件结束时间
            file_elapsed_time = (file_end_time - file_start_time).total_seconds()  # 保留小数，避免 int() 把 <1s 的耗时吞掉
            total_elapsed_time += file_elapsed_time  # 累加总耗时
            
            all_total_list.extend(total_list)
            all_deadlock_list.extend(deadlock_list)
            all_lock_event_list.extend(lock_event_list)
            all_lock_chain_list.extend(lock_chain_list)
            all_error_list.extend(error_list)
            merge_connection_stats(all_connection_stats, connection_stats)
            total_size += file_size_mb

            # 显式释放当前文件的列表引用
            del total_list
            del deadlock_list
            del lock_event_list
            del lock_chain_list
            del error_list
            del connection_stats

            # 进行垃圾回收，释放内存
            gc.collect()
            
        except Exception as e:
            print(f"处理文件 {file_name} 时出错: {str(e)}")
            continue
    
    print(f"\n{'='*60}")
    print(f"所有文件处理完成!总耗时: {total_elapsed_time:.0f}秒")
    total_event_count = (len(all_total_list) + len(all_deadlock_list) + len(all_lock_event_list)
                         + len(all_lock_chain_list) + len(all_error_list))
    print(f"总文件大小: {total_size:.2f} MB,总事件数 {total_event_count} 条")
    print(f"\n{'='*60}")

    # TRUNCATE 记录进一步过滤:本地分析用 vsql 精确校验,异地分析回退到名称前缀过滤
    # 仅 --mode error/all 会提取错误日志(含 TRUNCATE),query 模式无 TRUNCATE 无需过滤
    if all_error_list and args.mode.lower() in ('error', 'all'):
        _filter_non_table_truncates(all_error_list, debug=getattr(args, 'debug', False))

    return all_total_list, all_deadlock_list, total_size, total_elapsed_time, all_lock_event_list, all_lock_chain_list, all_error_list, all_connection_stats


def generate_special_event_chart(error_list, overall_min_time, overall_max_time):
    """生成 BUG 与资源不足等特殊事件的每分钟次数折线，与报告共用时间轴。"""
    events = [e for e in error_list if e.get('level') in ('BUG', 'SPECIAL')]
    if not events:
        return ''
    current = overall_min_time.replace(second=0, microsecond=0)
    end = overall_max_time.replace(second=0, microsecond=0)
    counts = defaultdict(int)
    type_counts = defaultdict(lambda: defaultdict(int))
    for event in events:
        if event.get('time'):
            minute = event['time'].strftime('%Y-%m-%d %H:%M')
            counts[minute] += 1
            event_type = '[UniqueSQL] Auto-cleanup over' if event.get('level') == 'BUG' else 'Sort lacks mem'
            type_counts[minute][event_type] += 1
    labels = []
    data = []
    point_types = []
    while current <= end:
        label = current.strftime('%Y-%m-%d %H:%M')
        labels.append(label)
        data.append(counts.get(label, 0))
        point_types.append([
            {'type': event_type, 'count': count}
            for event_type, count in sorted(type_counts[label].items())
        ])
        current += timedelta(minutes=1)
    chart_data = {
        'time_labels': labels,
        'series': [{'uid': '__bug__', 'uid_display': '特殊事件总次数',
                    'color': '#d63031', 'data': data}],
        'point_types': point_types,
        'y_axis_label': '事件次数',
        'allow_single_point': True,
    }
    data_json = json.dumps(chart_data, ensure_ascii=False, separators=(',', ':')).replace('</', '<\\/')
    return f'<script id="special-event-data" type="application/json">{data_json}</script>'


class ReportGenerator:
    """HTML报告生成器，整合汇总、分时段分析和详情展示。"""

    _err_group_table_seq = 0  # 错误聚合表序号(每次调用 generate_error_section 前重置)

    @staticmethod
    def _make_id_safe(unique_id):
        """生成URL/DOM安全ID：将HTML实体和特殊字符统一替换为下划线，避免href与DOM id不匹配。"""
        if unique_id is None:
            return ''
        return re.sub(r'[^a-zA-Z0-9_\-:.]', '_', str(unique_id).strip())

    @staticmethod
    def _resolve_lock_anchor_ts(event, all_events):
        """计算锁事件跳转锚点所用的 timestamp,与 Top10 锁事件表的合并逻辑保持一致。

        Top10 表会把同一次锁等待的 waiting+acquired 合并为一行,且行锚点的
        timestamp 取 waiting 的时间;而慢 SQL 详情侧 waiting/acquired 各展示一条。
        若直接沿用事件自身 timestamp,acquired 的锚点会指向不存在的时间,导致跳转失败。
        因此对 acquired 事件,在同组事件里查找同 lock_type+target 的最早 waiting 时间;
        waiting 或找不到配对时回退为事件自身 timestamp。
        """
        if event.get('type') != 'acquired':
            return str(event.get('timestamp', ''))
        lock_type = event.get('lock_type', '')
        target = event.get('target', '')
        waiting_ts = None
        for ev in all_events:
            if ev.get('type') != 'waiting':
                continue
            if ev.get('lock_type') != lock_type or ev.get('target') != target:
                continue
            ts = ev.get('timestamp', '')
            if waiting_ts is None or ts < waiting_ts:
                waiting_ts = ts
        return str(waiting_ts) if waiting_ts is not None else str(event.get('timestamp', ''))

    @staticmethod
    def _collect_top10_uids(stats_dict, topn=10):
        """收集所有 DML/DDL 按总耗时统一排序的全局 Top N SQL ID。

        Args:
            stats_dict: 原始统计字典，key 为 unique_id
            topn: 全局收集数量，默认 10

        Returns:
            set: Top N 的 unique_query_id 集合
        """
        top_stats = sorted(
            stats_dict.items(), key=lambda x: x[1]['sum_duration'], reverse=True)[:topn]
        return {uid for uid, _ in top_stats}

    # 耗时区间定义与对应颜色
    TIME_RANGES = [
        (60, float('inf'), '#8B0000', '60s以上'),      # 深红
        (30, 60, '#FF6B6B', '30-60s'),                # 浅红
        (10, 30, '#FFD93D', '10-30s'),                # 黄
        (3, 10, '#6BC5D2', '3-10s'),                  # 蓝
        (1, 3, '#CCCCCC', '1-3s'),                    # 灰 (边框区分)
        (0, 1, '#4CAF50', '1s以下'),                  # 绿
    ]

    @staticmethod
    def generate_sql_summary(stats_dict, all_total_list):
        """生成SQL汇总部分的HTML和图表数据。
        
        Args:
            stats_dict: 原始统计字典，key为unique_id
            all_total_list: 所有慢查询记录的列表
            
        Returns:
            dict: 包含HTML片段和各维度Top 10数据的字典
        """
        summary_html_parts = []
        chart_data = {}
        
        # 1. 耗时分布统计
        range_counts = {rname: 0 for _, _, _, rname in ReportGenerator.TIME_RANGES}
        for stat in stats_dict.values():
            avg_duration = stat['avg_duration']
            for min_t, max_t, _, rname in ReportGenerator.TIME_RANGES:
                if min_t <= avg_duration < max_t:
                    range_counts[rname] += 1
                    break
        
        total_slow = len(stats_dict)
        summary_html_parts.append(f"""
        <h2>SQL汇总统计</h2>
        <div class="summary-stats">
            <p><strong>慢SQL去重条目数：</strong>{total_slow} 条（按 Unique ID 去重）</p>
            <div class="stats-grid">
        """)
        
        for _, _, color, rname in ReportGenerator.TIME_RANGES:
            count = range_counts[rname]
            percent = (count / total_slow * 100) if total_slow > 0 else 0
            summary_html_parts.append(f"""
                <div class="stat-item" style="border-left-color: {color};">
                    <span class="range-name">{rname}</span>
                    <span class="range-count">{count} 条</span>
                    <span class="range-percent">({percent:.1f}%)</span>
                </div>
            """)
        summary_html_parts.append("""
            </div>
        </div>
        """)
        
        range_counts_dml = {rname: 0 for _, _, _, rname in ReportGenerator.TIME_RANGES}
        range_counts_ddl = {rname: 0 for _, _, _, rname in ReportGenerator.TIME_RANGES}
        for stat in stats_dict.values():
            sql_type = stat.get('sql_type', 'dml')
            for min_t, max_t, _, rname in ReportGenerator.TIME_RANGES:
                if min_t <= stat['avg_duration'] < max_t:
                    if sql_type == 'ddl':
                        range_counts_ddl[rname] += 1
                    else:
                        range_counts_dml[rname] += 1
                    break

        total_dml = sum(range_counts_dml.values())
        total_ddl = sum(range_counts_ddl.values())

        def build_pie_data(range_counts, total):
            pie = []
            for _, _, color, rname in ReportGenerator.TIME_RANGES:
                if range_counts[rname] > 0:
                    pie.append({
                        'name': rname,
                        'count': range_counts[rname],
                        'color': color,
                        'percent': (range_counts[rname] / total * 100) if total > 0 else 0
                    })
            return pie

        chart_data['pie'] = build_pie_data(range_counts, total_slow)
        chart_data['pie_dml'] = build_pie_data(range_counts_dml, total_dml)
        chart_data['pie_ddl'] = build_pie_data(range_counts_ddl, total_ddl)
        chart_data['total_dml'] = total_dml
        chart_data['total_ddl'] = total_ddl
        
        # 2. 各维度Top 10排名
        # 准备数据列表，并按sql_type分离
        stats_list_dml = [(uid, data) for uid, data in stats_dict.items() if data.get('sql_type') == 'dml']
        stats_list_ddl = [(uid, data) for uid, data in stats_dict.items() if data.get('sql_type') == 'ddl']
        
        # 生成Top 10表格的辅助函数
        def generate_top10_tables(stats_list, sql_type):
            """为指定SQL类型生成4个Top 10表格"""
            if not stats_list:
                return ''
            
            # 按平均耗时 (avg_duration) 排序
            sorted_by_avg = sorted(stats_list, key=lambda x: x[1]['avg_duration'], reverse=True)[:10]
            # 按执行次数 (count) 排序
