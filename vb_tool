    it_keys = sorted(set(IT1) | set(IT2),
                     key=lambda k: max(IT1.get(k, {}).get("value", 0), IT2.get(k, {}).get("value", 0)), reverse=True)
    parts.append('<table class="t"><tr><th>Stat</th><th class="n">P1 (s)</th>'
                 '<th class="n">P2 (s)</th><th class="n">delta (s)</th></tr>')
    if not it_keys:
        parts.append('<tr><td colspan="4" class="note">no data</td></tr>')
    for k in it_keys:
        v1 = IT1.get(k, {}).get("value", 0.0); v2 = IT2.get(k, {}).get("value", 0.0)
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td></tr>' % (esc(k), s_of(v1), s_of(v2), s_of(v2 - v1)))
    parts.append('</table>')

    # ================= Load Profile =================
    def _dbsum(d, col):
        return sum(v.get(col, 0.0) for v in d.values())
    def _lsn(lsn):
        try:
            hi, lo = (lsn or "").split("/")
            return (int(hi, 16) << 32) + int(lo, 16)
        except Exception:
            return 0
    def _pwlsn_delta(win, col):
        # ★双侧存在性守卫 (2026-11-26): 混代窗口一侧无 pagewriter 行时返回 None
        #   (调用方 _fmtw 印 '-'), 不再拿 END 的 LSN 绝对位置冒充差值
        # ★行在但 LSN 全空(2026-11-27)同样按缺侧: 0-0=0 B 是假"WAL 没写"
        _er = win["db"].get(("end", "pagewriter"), [])
        _br = win["db"].get(("begin", "pagewriter"), [])
        if not _br or not _er:
            return None
        if (not any(r.get("current_xlog_insert_lsn") for r in _br)
                or not any(r.get("current_xlog_insert_lsn") for r in _er)):
            return None
        return (sum(_lsn(r.get(col, "")) for r in _er)
                - sum(_lsn(r.get(col, "")) for r in _br))
    sec("Load Profile")
    parts.append('<table class="t"><tr><th>Metric</th><th class="n">P1 total</th>'
                 '<th class="n">P2 total</th><th class="n">Delta</th>'
                 '<th class="n">P1 /s</th><th class="n">P2 /s</th></tr>')
    # logical reads = blks_hit + blks_read (awrrpt parity, user 2026-10-15);
    # SQL calls sits directly under rollbacks
    def _lrow(lbl, v1, v2, fb, fn):
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td></tr>' % (
                         esc(lbl), fb(v1), fb(v2), fb(v2 - v1), fn((v1 / dur1) if dur1 else 0.0), fn((v2 / dur2) if dur2 else 0.0)))
    _lrow("logical reads",
          _dbsum(db1, "blks_hit") + _dbsum(db1, "blks_read"),
          _dbsum(db2, "blks_hit") + _dbsum(db2, "blks_read"), fmt_blocks, fmt_blocks_ps)
    for lbl, col in [("physical reads", "blks_read"),
                     ("rows returned", "tup_returned"), ("rows fetched", "tup_fetched"),
                     ("rows inserted", "tup_inserted"), ("rows updated", "tup_updated"),
                     ("rows deleted", "tup_deleted"), ("commits", "xact_commit"),
                     ("rollbacks", "xact_rollback")]:
        v1 = _dbsum(db1, col); v2 = _dbsum(db2, col)
        if col == "blks_read":
            fb, fn = fmt_blocks, fmt_blocks_ps
        else:
            fb, fn = fmt_int, fmt_rate
        _lrow(lbl, v1, v2, fb, fn)
    # SQL calls (QPS) P1 vs P2: dbe_perf.statement n_calls window deltas
    _scd1 = (sum(to_num(r.get("n_calls", 0) or 0) for r in win1["db"].get(("end", "statement"), []))
             - sum(to_num(r.get("n_calls", 0) or 0) for r in win1["db"].get(("begin", "statement"), [])))
    _scd2 = (sum(to_num(r.get("n_calls", 0) or 0) for r in win2["db"].get(("end", "statement"), []))
             - sum(to_num(r.get("n_calls", 0) or 0) for r in win2["db"].get(("begin", "statement"), [])))
    _scd_neg = " <span class='note'>(counter reset?)</span>" if (_scd1 < 0 or _scd2 < 0) else ""
    parts.append('<tr><td>SQL calls%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>'
                 '<td class="n">%s</td><td class="n">%s</td></tr>'
                 % (_scd_neg, fmt_int(_scd1), fmt_int(_scd2), fmt_int(_scd2 - _scd1),
                    fmt_rate(_scd1 / dur1) if dur1 else "-",
                    fmt_rate(_scd2 / dur2) if dur2 else "-"))
    for lbl, col in [("deadlocks", "deadlocks"),
                     ("conflicts", "conflicts"), ("temp bytes", "temp_bytes")]:
        v1 = _dbsum(db1, col); v2 = _dbsum(db2, col)
        if col == "temp_bytes":
            fb = fn = fmt_bytes
        else:
            fb = fn = fmt_int
        _lrow(lbl, v1, v2, fb, fn)
    # role-aware WAL movement: a standby writes no local WAL (xlog insert lsn
    # sits at a static near-zero there) -- on standby windows use the standby's
    # own walreceiver replay lsn delta; "-" when that window has no
    # walreceiver row on both sides (old snaps / window spans a promote)
    def _walval(win, standby):
        if not standby:
            return _pwlsn_delta(win, "current_xlog_insert_lsn")
        rb = win["db"].get(("begin", "walreceiver"), [])
        re_ = win["db"].get(("end", "walreceiver"), [])
        if not rb or not re_:
            return None
        return (sum(_lsn(r.get("receiver_replay_location", "")) for r in re_)
                - sum(_lsn(r.get("receiver_replay_location", "")) for r in rb))
    _sb1 = "standby" in str(m1.get("db_role", "")); _sb2 = "standby" in str(m2.get("db_role", ""))
    _w1 = _walval(win1, _sb1); _w2 = _walval(win2, _sb2)
    _wl = ("WAL replayed" if _sb1 and _sb2 else
           ("WAL written / WAL replayed (P1 / P2)" if _sb1 or _sb2 else "WAL written"))
    _fmtw = lambda v: "-" if v is None else fmt_bytes(v)
    parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>'
                 '<td class="n">%s</td><td class="n">%s</td></tr>' % (
                     esc(_wl), _fmtw(_w1), _fmtw(_w2),
                     "-" if (_w1 is None or _w2 is None) else fmt_bytes(_w2 - _w1),
                     "-" if _w1 is None else fmt_bytes((_w1 / dur1) if dur1 else 0.0),
                     "-" if _w2 is None else fmt_bytes((_w2 / dur2) if dur2 else 0.0)))
    # ---- WAL writes + pagewriter flushes (v2.4.5; P1/P2 window deltas, per-second per period) ----
    _lpw1 = dict((r[0], r) for r in loadprofile_wal_pw_rows(win1, dur1))
    _lpw2 = dict((r[0], r) for r in loadprofile_wal_pw_rows(win2, dur2))
    _lpw_neg = False
    for _lbl, _b1, _e1, _d1, _ps1, _ok1, _by1, _pg1 in _lpw1.values():
        _lbl, _b2, _e2, _d2, _ps2, _ok2, _by2, _pg2 = _lpw2[_lbl]
        # gs_redo_stat is primary-valid: label standby-side rows (awrrpt parity)
        if not _by1 and not _pg1 and "physical standby" in str(m1.get("db_role", "")):
            _lbl = _lbl + " (P1 primary only)"
        if not _by2 and not _pg2 and "physical standby" in str(m2.get("db_role", "")):
            _lbl = _lbl + " (P2 primary only)"
        _ok = _ok1 and _ok2
        if not _ok:
            _cell = _celln = (lambda v: "-")
        elif _pg1:
            _cell, _celln = fmt_blocks, fmt_blocks_ps
        elif _by1:
            _cell = _celln = fmt_bytes
        else:
            _cell, _celln = fmt_int, fmt_num
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td></tr>' % (
                         esc(_lbl), _cell(_d1), _cell(_d2), _cell(_d2 - _d1),
                         _celln(_ps1), _celln(_ps2)))
        # ★同 awrrpt: 负值告警须 _ok 门控(混代缺侧 _d 为负会误导 counter reset)
        if _ok and (_d1 < 0 or _d2 < 0):
            _lpw_neg = True
    if _lpw_neg:
        note("WARNING: negative delta in WAL/pagewriter counters — possible counter reset (switchover/promote); these rows may be unreliable.")
    _lio2 = {r[0]: r for r in loadprofile_iostat_rows(win2, dur2)}
    for _lbl, _b1, _e1, _d1, _ps1, _md1, _ok1 in loadprofile_iostat_rows(win1, dur1):
        _lbl, _b2, _e2, _d2, _ps2, _md2, _ok2 = _lio2[_lbl]
        _ok = _ok1 and _ok2
        _cf = (fmt_blocks if _md1 == "blocks" else fmt_int) if _ok else (lambda v: "-")
        _cn = (fmt_blocks_ps if _md1 == "blocks" else fmt_num) if _ok else (lambda v: "-")
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td></tr>'
                     % (esc(_lbl), _cf(_d1), _cf(_d2), _cf(_d2 - _d1), _cn(_ps1), _cn(_ps2)))
    parts.append('</table>')

    # ================= Cache Hit Ratio =================
    sec("Cache Hit Ratio")
    def _hit(d, dn):
        h = d.get(dn, {}).get("blks_hit", 0); r = d.get(dn, {}).get("blks_read", 0); t = h + r
        return (h / t * 100.0) if t else 0.0
    _dns = sorted((set(db1) | set(db2)) - {"template0", "template1"})
    _cr = [(_dn, _hit(db1, _dn), _hit(db2, _dn)) for _dn in _dns]
    _cr = [r for r in _cr if r[1] or r[2]]
    _cr.sort(key=lambda x: max(x[1], x[2]), reverse=True)
    parts.append('<table class="t"><tr><th>Database</th><th class="n">P1 Hit%</th>'
                 '<th class="n">P2 Hit%</th><th class="n">Delta</th></tr>')
    if not _cr:
        parts.append('<tr><td colspan="4" class="note">no data</td></tr>')
    for _dn, r1, r2 in _cr:
        parts.append('<tr><td>%s</td><td class="n">%.2f%%</td><td class="n">%.2f%%</td>'
                     '<td class="n">%+.2f%%</td></tr>' % (esc(_dn), r1, r2, r2 - r1))
    parts.append('</table>')

    # ================= Database Memory =================
    sec("Database Memory")
    sub("Memory GUCs - live")
    _rows = psql_query("SELECT name, decode(unit,'8kB',concat(setting*8,'kB'),concat(setting,COALESCE(unit,' '))) AS setting "
                       "FROM pg_settings WHERE name IN ('maintenance_work_mem','work_mem','shared_buffers',"
                       "'max_process_memory','wal_buffers','effective_cache_size','cstore_buffers',"
                       "'segment_buffers','temp_buffers','local_syscache_threshold','max_connections') ORDER BY name")
    if not _rows:
        parts.append('<div class="note">no data</div>')
    else:
        parts.append('<table class="t"><tr><th>Name</th><th>Setting</th></tr>')
        for r in _rows:
            parts.append('<tr><td>%s</td><td>%s</td></tr>' % (esc(r.get("name", "")), esc(r.get("setting", ""))))
        parts.append('</table>')
    def _grp(rows, key, val, key_norm=None):
        out = {}
        for r in rows:
            try:
                k = r.get(key, "")
                if key_norm:
                    k = key_norm(k)
                out[k] = out.get(k, 0) + to_num(r.get(val, 0) or 0)
            except Exception:
                pass
        return out
    def be_diff(label, end_r1, end_r2, key_col, val_col, fmt_fn, top=10, key_norm=None):
        sub(label)
        d1 = _grp(end_r1, key_col, val_col, key_norm); d2 = _grp(end_r2, key_col, val_col, key_norm)
        _keys = sorted(set(d1) | set(d2), key=lambda k: max(d1.get(k, 0), d2.get(k, 0)), reverse=True)[:top]
        parts.append('<table class="t"><tr><th>%s</th><th class="n">P1</th><th class="n">P2</th>'
                     '<th class="n">Delta</th></tr>' % esc(key_col))
        if not _keys:
            parts.append('<tr><td colspan="4" class="note">no data</td></tr>')
        for k in _keys:
            v1 = d1.get(k, 0); v2 = d2.get(k, 0)
            parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td></tr>' % (esc(k), fmt_fn(v1), fmt_fn(v2), fmt_fn(v2 - v1)))
        parts.append('</table>')
    be_diff("Total Memory by Type (MB)",
            win1["db"].get(("end", "memory_node_detail"), []),
            win2["db"].get(("end", "memory_node_detail"), []),
            "memorytype", "mb", lambda v: fmt_bytes(v * 1024 * 1024), top=20)
    be_diff("Top 10 Shared Memory Context",
            win1["db"].get(("end", "shared_memory"), []),
            win2["db"].get(("end", "shared_memory"), []),
            "contextname", "total", fmt_bytes, top=10)
    be_diff("Top 10 Session Memory Context",
            win1["db"].get(("end", "session_memory"), []),
            win2["db"].get(("end", "session_memory"), []),
            "contextname", "total", fmt_bytes, top=10, key_norm=ctx_family)
    parts.append('<div class="note">per-node contexts (Hash_/HashJoin_/Sort_/Stream/SIRW/... with '
                 'a session-id or query-id suffix, one per query/plan object) are aggregated under the family name</div>')

    # ================= Object Statistics =================
    sec("Object Statistics")
    note("Per-object window-delta counters (end-begin) compared P1 vs P2. Top by (P1+P2) of the sort metric.")
    def obj_diff(label, begin_r1, end_r1, begin_r2, end_r2, key_cols, cnt_cols, sort_col, top=30):
        sub(label)
        def _key(r):
            return tuple(r.get(k, "") for k in key_cols)
        def _delta(begin, end):
            b = {}
            for r in begin:
                b[_key(r)] = {c: to_num(r.get(c, 0) or 0) for c in cnt_cols}
            e = {}
            for r in end:
                e[_key(r)] = {c: to_num(r.get(c, 0) or 0) for c in cnt_cols}
            out = {}
            for k in set(b) | set(e):
                out[k] = {c: e.get(k, {}).get(c, 0) - b.get(k, {}).get(c, 0) for c in cnt_cols}
            return out
        d1 = _delta(begin_r1, end_r1); d2 = _delta(begin_r2, end_r2)
        _keys = sorted(set(d1) | set(d2),
                       key=lambda k: d2.get(k, {}).get(sort_col, 0) + d1.get(k, {}).get(sort_col, 0), reverse=True)[:top]
        _hdr = list(key_cols) + [c + " P1" for c in cnt_cols] + [c + " P2" for c in cnt_cols] + [c + " Delta" for c in cnt_cols]
        _num = [False] * len(key_cols) + [True] * (3 * len(cnt_cols))
        parts.append('<table class="t"><tr>' + ''.join(
            '<th%s>%s</th>' % (' class="n"' if nu else '', esc(c))
            for c, nu in zip(_hdr, _num)) + '</tr>')
        if not _keys:
            parts.append('<tr><td colspan="%d" class="note">no data</td></tr>' % len(_hdr))
        for k in _keys:
            cells = ''.join('<td>%s</td>' % esc(x) for x in k)
            for c in cnt_cols:
                cells += '<td class="n">%s</td>' % fmt_int(d1.get(k, {}).get(c, 0))
            for c in cnt_cols:
                cells += '<td class="n">%s</td>' % fmt_int(d2.get(k, {}).get(c, 0))
            for c in cnt_cols:
                cells += '<td class="n">%s</td>' % fmt_int(d2.get(k, {}).get(c, 0) - d1.get(k, {}).get(c, 0))
            parts.append('<tr>' + cells + '</tr>')
        parts.append('</table>')
    obj_diff("Top Tables by Activity",
             win1["db"].get(("begin", "object_tables"), []), win1["db"].get(("end", "object_tables"), []),
             win2["db"].get(("begin", "object_tables"), []), win2["db"].get(("end", "object_tables"), []),
             ("dbname", "schema", "object"),
             ("seq_scan", "seq_tup_read", "idx_scan", "idx_tup_fetch", "n_tup_upd", "n_tup_del"), "seq_tup_read")
    obj_diff("Top Objects by Dead Tuples (window delta)",
             win1["db"].get(("begin", "object_dead"), []), win1["db"].get(("end", "object_dead"), []),
             win2["db"].get(("begin", "object_dead"), []), win2["db"].get(("end", "object_dead"), []),
             ("dbname", "schema", "object"),
             ("n_dead_tup", "n_live_tup"), "n_dead_tup")
    # derived per-phase rows via object_iostat_rows(); obj_diff then computes
    # the window delta of each derived column (delta-of-sums == sum-of-deltas)
    _io1b = object_iostat_rows(win1["db"].get(("begin", "object_iostat"), []))
    _io1e = object_iostat_rows(win1["db"].get(("end", "object_iostat"), []))
    _io2b = object_iostat_rows(win2["db"].get(("begin", "object_iostat"), []))
    _io2e = object_iostat_rows(win2["db"].get(("end", "object_iostat"), []))
    if (bool(_io1b) != bool(_io1e)) or (bool(_io2b) != bool(_io2e)):
        # one-sided empty capture in either window (older snapshot) cannot be
        # delta'd without presenting full-cumulative counters as a window
        parts.append('<div class="note">object I/O: capture missing on one side of a window (older snapshot); tables skipped</div>')
    else:
        obj_diff("Top Tables by Logical Reads (window delta)",
                 _io1b, _io1e, _io2b, _io2e,
                 ("dbname", "schema", "object"),
                 ("logical", "heap", "index", "toast"), "logical")
        obj_diff("Top Tables by Physical Reads (window delta)",
                 _io1b, _io1e, _io2b, _io2e,
                 ("dbname", "schema", "object"),
                 ("physical", "pheap", "pindex", "ptoast"), "physical")

    # ================= Top 10 Wait Events =================
    sec("Top 10 Wait Events by Total Wait Time")
    _we_top = sorted(set(WE1) | set(WE2),
                     key=lambda k: max(WE1.get(k, {}).get("total_wait_time", 0), WE2.get(k, {}).get("total_wait_time", 0)),
                     reverse=True)[:10]
    parts.append('<table class="t"><tr><th>Event</th><th>Class</th>'
                 '<th class="n">P1 Waits</th><th class="n">P2 Waits</th>'
                 '<th class="n">P1 Time (s)</th><th class="n">P2 Time (s)</th><th class="n">delta (s)</th></tr>')
    if not _we_top:
        parts.append('<tr><td colspan="7" class="note">no data</td></tr>')
    for k in _we_top:
        d1 = WE1.get(k, {}); d2 = WE2.get(k, {})
        cls_ = ((d2 or d1).get("__row") or {}).get("type", "")
        t1 = d1.get("total_wait_time", 0.0); t2 = d2.get("total_wait_time", 0.0)
        _badge = " <span class='bad'>[NEW]</span>" if k not in WE1 else (" <span class='note'>[GONE]</span>" if k not in WE2 else "")
        parts.append('<tr><td>%s%s</td><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td><td class="n">%s</td></tr>' % (
                         esc(k), _badge, esc(cls_), fmt_int(d1.get("wait", 0)), fmt_int(d2.get("wait", 0)),
                         s_of(t1), s_of(t2), s_of(t2 - t1)))
    parts.append('</table>')

    # ================= SQL Statistics =================
    sec("SQL Statistics")
    note("Per-SQL Period 1 vs Period 2. %%Diff = (P2-P1)/|P1|. [NEW] = only in P2; [GONE] = only in P1.\n"
         "Top %d by max(P1,P2) of each ordering metric." % top_n)
    shown_sql = {}
    def sql_block_diff(label, order_col, dim_header, dim_fmt):
        sub(label)
        _sum1 = sum(d.get(order_col, 0.0) for d in ST1.values())
        _sum2 = sum(d.get(order_col, 0.0) for d in ST2.values())
        keys = sorted(set(ST1) | set(ST2),
                      key=lambda k: max(ST1.get(k, {}).get(order_col, 0.0), ST2.get(k, {}).get(order_col, 0.0)),
                      reverse=True)[:top_n]
        parts.append('<table class="t"><tr><th>#</th><th>SQL Id</th><th>User</th>'
                     '<th class="n">P1 Exec</th><th class="n">P2 Exec</th>'
                     '<th class="n">P1 %s</th><th class="n">P2 %s</th>'
                     '<th class="n">P1 %%T</th><th class="n">P2 %%T</th>'
                     '<th class="n">%%Diff</th><th>note</th></tr>' % (dim_header, dim_header))
        if not keys:
            parts.append('<tr><td colspan="11" class="note">no data</td></tr>')
        for i, k in enumerate(keys, 1):
            d1 = ST1.get(k); d2 = ST2.get(k)
            row = ((d2 or d1) or {}).get("__row") or {}
            if k not in shown_sql:
                shown_sql[k] = row
            e1 = (d1 or {}).get("n_calls", 0.0); e2 = (d2 or {}).get("n_calls", 0.0)
            v1 = (d1 or {}).get(order_col, 0.0); v2 = (d2 or {}).get(order_col, 0.0)
            badge = ""
            if not d1 and d2:
                badge = "<span class='bad'>[NEW]</span>"
            elif d1 and not d2:
                badge = "<span class='note'>[GONE]</span>"
            _pdiff = "new" if (v1 == 0 and v2 > 0) else ("%+.1f%%" % pctdiff(v1, v2))
            parts.append('<tr><td>%d</td><td><a href="#sql-%s">%s</a></td><td>%s</td>'
                         '<td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%.1f%%</td><td class="n">%.1f%%</td>'
                         '<td class="n">%s</td><td>%s</td></tr>' % (
                             i, esc(k), esc(k), esc(row.get("user_name") or ""),
                             fmt_int(e1), fmt_int(e2), dim_fmt(v1), dim_fmt(v2),
                             pct(v1, _sum1), pct(v2, _sum2), _pdiff, badge))
        parts.append('</table>')

    def sql_mem_block_diff(label, order_col, dim_header):
        # memory/spill dims: per-exec columns replace the %T columns --
        # per-exec change is the signal (exec-count growth vs per-run cost)
        sub(label)
        keys = sorted(set(ST1) | set(ST2),
                      key=lambda k: max(ST1.get(k, {}).get(order_col, 0.0), ST2.get(k, {}).get(order_col, 0.0)),
                      reverse=True)[:top_n]
        parts.append('<table class="t"><tr><th>#</th><th>SQL Id</th><th>User</th>'
                     '<th class="n">P1 Exec</th><th class="n">P2 Exec</th>'
                     '<th class="n">P1 %s</th><th class="n">P2 %s</th>'
                     '<th class="n">P1 %s/exec</th><th class="n">P2 %s/exec</th>'
                     '<th class="n">%%Diff</th><th>note</th></tr>'
                     % (dim_header, dim_header, dim_header, dim_header))
        if not keys:
            parts.append('<tr><td colspan="11" class="note">no data</td></tr>')
        for i, k in enumerate(keys, 1):
            d1 = ST1.get(k); d2 = ST2.get(k)
            row = ((d2 or d1) or {}).get("__row") or {}
            if k not in shown_sql:
                shown_sql[k] = row
            e1 = (d1 or {}).get("n_calls", 0.0); e2 = (d2 or {}).get("n_calls", 0.0)
            v1 = (d1 or {}).get(order_col, 0.0); v2 = (d2 or {}).get(order_col, 0.0)
            badge = ""
            if not d1 and d2:
                badge = "<span class='bad'>[NEW]</span>"
            elif d1 and not d2:
                badge = "<span class='note'>[GONE]</span>"
            _pdiff = "new" if (v1 == 0 and v2 > 0) else ("%+.1f%%" % pctdiff(v1, v2))
            parts.append('<tr><td>%d</td><td><a href="#sql-%s">%s</a></td><td>%s</td>'
                         '<td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td><td>%s</td></tr>' % (
                             i, esc(k), esc(k), esc(row.get("user_name") or ""),
                             fmt_int(e1), fmt_int(e2), fmt_int(v1), fmt_int(v2),
                             fmt_int(v1 / (e1 or 1.0)), fmt_int(v2 / (e2 or 1.0)),
                             _pdiff, badge))
        parts.append('</table>')
    sql_block_diff("SQL ordered by DB Time", "db_time", "DB Time (ms)", ms_of_g)
    sql_block_diff("SQL ordered by CPU Time", "cpu_time", "CPU Time (ms)", ms_of_g)
    sql_block_diff("SQL ordered by IO Time", "data_io_time", "IO Time (ms)", ms_of_g)
    sql_block_diff("SQL ordered by Logical Reads", "n_blocks_fetched", "logical reads", fmt_int)
    sql_block_diff("SQL ordered by Physical Reads", "physical_reads", "physical reads", fmt_int)
    _sm1b = bool(win1["db"].get(("begin", "statement_mem"), []))
    _sm1e = bool(win1["db"].get(("end", "statement_mem"), []))
    _sm2b = bool(win2["db"].get(("begin", "statement_mem"), []))
    _sm2e = bool(win2["db"].get(("end", "statement_mem"), []))
    if (_sm1b != _sm1e) or (_sm2b != _sm2e):
        parts.append('<div class="note">sort/hash memory &amp; spill stats skipped: '
                     'capture missing on one side of a window (older snapshot)</div>')
    elif _sm1b or _sm2b:
        sql_mem_block_diff("SQL ordered by Memory Used", "work_mem_used", "Work Mem (KB)")
        sql_mem_block_diff("SQL ordered by Temp Spill", "temp_spill_size", "Temp Spill (KB)")
    sql_block_diff("SQL ordered by Executions", "n_calls", "Executions", fmt_int)

    # ================= Wait Events (full) =================
    sec("Wait Events", fold=True)
    _we_all = sorted(set(WE1) | set(WE2),
                     key=lambda k: max(WE1.get(k, {}).get("total_wait_time", 0), WE2.get(k, {}).get("total_wait_time", 0)),
                     reverse=True)
    parts.append('<table class="t"><tr><th>Event</th><th>Class</th>'
                 '<th class="n">P1 Waits</th><th class="n">P2 Waits</th>'
                 '<th class="n">P1 Time (s)</th><th class="n">P2 Time (s)</th><th class="n">delta (s)</th></tr>')
    if not _we_all:
        parts.append('<tr><td colspan="7" class="note">no data</td></tr>')
    for k in _we_all:
        d1 = WE1.get(k, {}); d2 = WE2.get(k, {})
        cls_ = ((d2 or d1).get("__row") or {}).get("type", "")
        t1 = d1.get("total_wait_time", 0.0); t2 = d2.get("total_wait_time", 0.0)
        parts.append('<tr><td>%s</td><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td><td class="n">%s</td></tr>' % (
                         esc(k), esc(cls_), fmt_int(d1.get("wait", 0)), fmt_int(d2.get("wait", 0)),
                         s_of(t1), s_of(t2), s_of(t2 - t1)))
    parts.append('</table>')

    # ================= SQL Text (union of both periods) =================
    sec("SQL Text", fold=True)
    if not shown_sql:
        parts.append('<div class="note">no data</div>')
    else:
        parts.append('<table class="t"><tr><th>SQL Id</th><th>SQL Text</th></tr>')
        _any_missing = False
        for uid in sorted(shown_sql):
            row = shown_sql[uid] or {}
            _q = sql_text_of(win2, row, uid) or sql_text_of(win1, row, uid)
            if _q is None:
                _any_missing = True
            parts.append('<tr id="sql-%(u)s"><td class="sqlid">%(u)s</td>'
                         '<td><pre class="sqlfull">%(q)s</pre></td></tr>'
                         % {"u": esc(uid), "q": esc(normalize_sql(
                             _q or "(text not collected: absent from sql_text store)"))})
        if _any_missing and (win1.get("_sqltext_missing") and win2.get("_sqltext_missing")):
            parts.append('</table><div class="note">WARNING: shared sql_text store '
                         '(sql_text.csv.gz) not found next to the snapshots -- texts above are '
                         'unavailable. Restore the store file, or take a new snapshot to '
                         're-collect texts for still-running SQL. Numbers are unaffected.</div>')
        parts.append('</table>')

    # ================= Database Parameters (CHANGED between period1 and period2) =================
    # pg_settings is a STATE snapshot (not a cumulative counter), so each period is
    # represented by its END snap's value. Only params whose decoded setting differs
    # between period1.end and period2.end are shown.
    sec("Database Parameters - changed only", fold=True)
    _pgs1 = win1["db"].get(("end", "pg_settings"), [])
    _pgs2 = win2["db"].get(("end", "pg_settings"), [])
    def _pgmap(rows):
        m = {}
        for r in rows:
            n = r.get("name")
            if n:
                m[n] = r
        return m
    def _decode(setting, unit):
        if unit == "8kB":
            try:
                return "%dkB" % (int(float(setting)) * 8)
            except Exception:
                return "%s kB" % setting
        return "%s%s" % (setting, unit if unit else "")
    parts.append('<table class="t params"><colgroup>'
                 '<col style="width:22%"><col style="width:18%"><col style="width:18%">'
                 '<col style="width:8%"><col style="width:10%"><col style="width:24%">'
                 '</colgroup>'
                 '<tr><th>Name</th><th>Period 1 Setting</th><th>Period 2 Setting</th>'
                 '<th>Unit</th><th>Context</th><th>Description</th></tr>')
    if not _pgs1 or not _pgs2:
        note("pg_settings not captured in one or both periods (snap predates pg_settings "
             "capture); parameter diff unavailable.")
        parts.append('<tr><td colspan="6" class="note">(no parameter diff available)</td></tr>')
    else:
        _m1, _m2 = _pgmap(_pgs1), _pgmap(_pgs2)
        _changed = [n for n in sorted(set(_m1) | set(_m2))
                    if _decode(_m1.get(n, {}).get("setting", ""), _m1.get(n, {}).get("unit", ""))
                       != _decode(_m2.get(n, {}).get("setting", ""), _m2.get(n, {}).get("unit", ""))]
        if not _changed:
            note("No GUC parameter changes between Period 1 (snap end) and Period 2 (snap end).")
            parts.append('<tr><td colspan="6" class="note">No parameter changes between Period 1 and Period 2.</td></tr>')
        else:
            for _n in _changed:
                _r1 = _m1.get(_n, {}); _r2 = _m2.get(_n, {})
                _s1 = _decode(_r1.get("setting", ""), _r1.get("unit", ""))
                _s2 = _decode(_r2.get("setting", ""), _r2.get("unit", ""))
                _u = _r2.get("unit", "") or _r1.get("unit", "")
                _c = _r2.get("context", "") or _r1.get("context", "")
                _d = _r2.get("short_desc", "") or _r1.get("short_desc", "")
                parts.append('<tr><td title="%s">%s</td><td title="%s">%s</td><td title="%s">%s</td>'
                             '<td>%s</td><td>%s</td><td class="wrap">%s</td></tr>'
                             % (esc(_n), esc(_n), esc(_s1), esc(_s1), esc(_s2), esc(_s2),
                                esc(_u), esc(_c), esc(_d)))
            note("%d GUC parameter(s) changed between Period 1 and Period 2." % len(_changed))
    parts.append('</table>')
    # ---- Role / Database-level GUC overrides - changed only ----
    # STATE snapshot per period (END snap's pg_db_role_setting.csv), one row
    # per (role, database, parameter); shows added / changed / removed entries
    # between the two period ends, mirroring the pg_settings table above.
    # win["_role_guc_captured"] separates "csv not captured" (old snap) from
    # "captured, genuinely no overrides" so the empty case stays explicit.
    _prs1 = win1["db"].get(("end", "pg_db_role_setting"), [])
    _prs2 = win2["db"].get(("end", "pg_db_role_setting"), [])
    parts.append('<div class="sub">Role / Database-level GUC - changed only</div>')
    parts.append('<table class="t params"><colgroup>'
                 '<col style="width:14%"><col style="width:14%"><col style="width:24%">'
                 '<col style="width:24%"><col style="width:24%">'
                 '</colgroup><tr><th>Role</th><th>Database</th><th>Parameter</th>'
                 '<th>Period 1 Value</th><th>Period 2 Value</th></tr>')
    def _prmap(rows):
        m = {}
        for r in rows:
            k = (r.get("rolname"), r.get("datname"), r.get("param"))
            m[k] = r.get("value", "")
        return m
    if not win1.get("_role_guc_captured", {}).get("end") or not win2.get("_role_guc_captured", {}).get("end"):
        note("pg_db_role_setting not captured in one or both periods (snap predates "
             "this capture); role-level parameter diff unavailable.")
        parts.append('<tr><td colspan="5" class="note">(role-level parameter diff not available)</td></tr>')
    else:
        _m1, _m2 = _prmap(_prs1), _prmap(_prs2)
        _rchg = [k for k in sorted(set(_m1) | set(_m2)) if _m1.get(k, "") != _m2.get(k, "")]
        if not _rchg:
            note("No role-level GUC override changes between Period 1 (snap end) and Period 2 (snap end).")
            parts.append('<tr><td colspan="5" class="note">No role-level GUC override changes between Period 1 and Period 2.</td></tr>')
        else:
            for k in _rchg:
                parts.append('<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>'
                             % (esc(k[0] or ""), esc(k[1] or ""), esc(k[2] or ""),
                                esc(_m1.get(k, "-")), esc(_m2.get(k, "-"))))
            note("%d role-level GUC override entr%s added, changed or removed between Period 1 and Period 2."
                 % (len(_rchg), "y" if len(_rchg) == 1 else "ies"))
    parts.append('</table>')

    _toc_html = ('<div class="toc" id="toc"><b>Contents</b><ul>' + "".join(
        '<li><a href="#%s">%s</a>%s</li>' % (_id, esc(t),
            ('<ul>%s</ul>' % "".join('<li><a href="#%s">%s</a></li>' % (cid, esc(ct))
                                     for ct, cid in ch)) if ch else "")
        for t, _id, ch in _toc) + '</ul></div>')
    parts.insert(_toc_pos, _toc_html)

    _close_foldsec()
    parts.append('<div class="foot">Generated by vb_tool awr awrdiff &middot; diff report &middot; '
                 'each value = period(end-begin); delta = P2-P1; %%Diff = (P2-P1)/|P1|.</div>')
    parts.append('</body></html>')

    htmls = "".join(parts)
    if out_html:
        os.makedirs(os.path.dirname(os.path.abspath(out_html)), exist_ok=True)
        with open(out_html, "w") as f:
            f.write(htmls)
        print("  report : %s" % out_html)
    else:
        sys.stdout.write(htmls)


# =============================================================================
# text (screen) reports -- awr topsql/event/summary/tabstat
# Screen variants of the wdr_* commands, computed from LOCAL awr snapshots
# (begin/end snap pair) instead of in-DB WDR tables. Each text_* returns
# (rc, text); the --text main() branch prints it. No files are written.
# =============================================================================

def snap_seq_dirs(begin_dir, end_dir):
    """Ordered snap dirs from begin through end (inclusive), for the text
    reports' per-snapshot-interval breakdown: every snap_<id> under the same
    root with begin_id <= id <= end_id. Unparseable ids, missing endpoints or
    a single interval (end <= begin+1) -> [begin_dir, end_dir] (one
    whole-window report, no breakdown). Deleted mid-window snaps just make
    their neighbours a longer interval."""
    def _sid(d):
        m = re.search(r"snap_(\d+)$", os.path.basename(os.path.normpath(d)))
        return int(m.group(1)) if m else None
    b, e = _sid(begin_dir), _sid(end_dir)
    if b is None or e is None or e <= b + 1:
        return [begin_dir, end_dir]
    parent = os.path.dirname(os.path.abspath(begin_dir))
    found = {}
    for d in glob.glob(os.path.join(parent, "snap_*")):
        s = _sid(d)
        if s is not None and b <= s <= e and os.path.isdir(d):
            found[s] = d
    if b not in found or e not in found:
        return [begin_dir, end_dir]
    return [found[i] for i in sorted(found)]

def _text_banner(title, win, extra=""):
    """Report header: title bar + one window line (db / window / snap ids)."""
    m = win["meta"]
    def _short(ts):
        # '2026-09-07 10:00:03' -> '0907 10:00'
        return ts[5:10].replace("-", "") + " " + ts[11:16] if len(ts) >= 16 else ts
    beg_ts, end_ts = str(m.get("begin_ts", "")), str(m.get("end_ts", ""))
    beg = _short(beg_ts)
    # same date -> end shows time only (design: 'window: 0907 10:00-10:10')
    end = end_ts[11:16] if (len(end_ts) >= 16 and len(beg_ts) >= 16
                            and end_ts[5:10] == beg_ts[5:10]) else _short(end_ts)
    bar = "=" * max(20, len(title) + 2)
    dur = to_num(m.get("duration"))
    line = "  db: %s   window: %s-%s (%ds)   snap %s -> %s" % (
        m.get("db_name", "?"), beg, end, int(dur),
        m.get("snap_id_begin", "?"), m.get("snap_id_end", "?"))
    if extra:
        line += "   " + extra
    return [bar, " " + title, bar, line, ""]

def _text_table(headers, rows, align=None):
    """psql-style aligned table; align = per-column 'l'/'r' (default all 'l')."""
    align = align or "l" * len(headers)
    n = len(headers)
    widths = [len(str(h)) for h in headers]
    for r in rows:
        for i in range(n):
            widths[i] = max(widths[i], len(str(r[i])))
    out = [" | ".join(str(h).ljust(widths[i]) for i, h in enumerate(headers))]
    out.append("-+-".join("-" * w for w in widths))
    for r in rows:
        out.append(" | ".join(
            (str(r[i]).rjust(widths[i]) if align[i] == "r" else str(r[i]).ljust(widths[i]))
            for i in range(n)))
    return "\n".join(out)

# topsql ranking dimensions; values are statement.csv delta column names
# (preads is computed: fetched - hit; memory/spill come from statement_mem.csv
# as sort+hash sums in KB -- same semantics as awrrpt section 11: kernel
# instruments Sort executor nodes and HashJoin only, aggregate-internal
# sorts and HashAgg are NOT counted)
DIM_COLUMNS = {
    "dbtime": "db_time",
    "cpu":    "cpu_time",
    "io":     "data_io_time",
    "plan":   "plan_time",
    "lreads": "n_blocks_fetched",
    "preads": None,
    "memory": None,
    "spill":  None,
    "calls":  "n_calls",
    "rows":   "n_returned_rows",
}
MEM_DIM_COLUMNS = ("memory", "spill")   # ranked from statement_mem.csv (KB)

def _dim_value(metric, d, stm=None):
    """Dimension value of one statement delta row; None = off this board
    (negative delta -- wdr semantics NULLs the row). stm = the statement_mem
    delta row of the same unique_sql_id (None = not captured)."""
    if metric == "preads":
        v = to_num(d.get("n_blocks_fetched", 0)) - to_num(d.get("n_blocks_hit", 0))
    elif metric == "memory":
        v = ((to_num(stm.get("sort_mem_used", 0)) + to_num(stm.get("hash_mem_used", 0)))
             if stm else None)
    elif metric == "spill":
        v = ((to_num(stm.get("sort_spill_size", 0)) + to_num(stm.get("hash_spill_size", 0)))
             if stm else None)
    else:
        v = to_num(d.get(DIM_COLUMNS[metric], 0))
    return v if (v is not None and v >= 0) else None

def _win_tr_label(win):
    """wdr-style compact window label for the time_range column ('0911
    23:14-23:19'; cross-midnight appends the end date)."""
    m = win["meta"]
    b, e = str(m.get("begin_ts", "")), str(m.get("end_ts", ""))
    def _st(s):
        try:
            return time.strptime(s[:19], "%Y-%m-%d %H:%M:%S")
        except ValueError:
            return None
    t1, t2 = _st(b), _st(e)
    if not t1 or not t2:
        return "%s ~ %s" % (b[:16] or "?", e[:16] or "?")
    if (t1.tm_year, t1.tm_yday) == (t2.tm_year, t2.tm_yday):
        return "%02d%02d %02d:%02d-%02d:%02d" % (
            t1.tm_mon, t1.tm_mday, t1.tm_hour, t1.tm_min, t2.tm_hour, t2.tm_min)
    return "%02d%02d %02d:%02d-%02d%02d %02d:%02d" % (
        t1.tm_mon, t1.tm_mday, t1.tm_hour, t1.tm_min,
        t2.tm_mon, t2.tm_mday, t2.tm_hour, t2.tm_min)

def _text_snapshot_table(snap_title, headers, align, detail_wins, row_fn):
    """Per-snapshot-interval section (wdr style, user 2026-09-12): one '<title>
    snapshot' banner, then ONE table with a time_range leading column holding
    every consecutive-snapshot interval's rows -- no blank separator rows, the
    time_range value groups them. `row_fn(win)` returns that window's data
    rows (or None = skip). Returns [] when no interval produced rows."""
    rows = []
    for w in detail_wins:
        sub = row_fn(w)
        if sub:
            rows += [[_win_tr_label(w)] + r for r in sub]
    if not rows:
        return []
    bar = "=" * max(20, len(snap_title) + 2)
    return ["", bar, " " + snap_title, bar,
            _text_table(["time_range"] + headers, rows, align=align)]

def _topsql_rows(win, metric, top_n):
    """text_topsql data rows (no banner/header); None = no usable rows."""
    ST = delta_rows(win, "statement", "unique_sql_id",
                    ["n_calls", "db_time", "cpu_time", "data_io_time",
                     "plan_time", "execution_time", "n_blocks_fetched",
                     "n_blocks_hit", "n_returned_rows"])
    STM = (delta_rows(win, "statement_mem", "unique_sql_id",
                      ["sort_mem_used", "hash_mem_used",
                       "sort_spill_size", "hash_spill_size"])
           if metric in MEM_DIM_COLUMNS else {})
    board = []
    for k, d in ST.items():
        if to_num(d.get("n_calls", 0)) <= 0:
            continue
        v = _dim_value(metric, d, STM.get(k))
        if v is None:
            continue
        board.append((v, k, d))
    if not board:
        return None
    board.sort(key=lambda t: t[0], reverse=True)
    total = sum(t[0] for t in board)
    rows = []
    for v, k, d in board[:top_n]:
        row = d.get("__row") or {}
        calls = to_num(d.get("n_calls", 0))
        def per(col):
            x = to_num(d.get(col, 0))
            return "%.1f" % (x / 1000.0 / calls) if (calls > 0 and x >= 0) else "-"
        fetched = to_num(d.get("n_blocks_fetched", 0))
        hit = to_num(d.get("n_blocks_hit", 0))
        pr = fetched - hit
        cr_per = fetched / calls if (calls > 0 and fetched >= 0) else None
        pr_per = pr / calls if (calls > 0 and pr >= 0) else None
        pct = 100.0 * v / total if total > 0 else 0.0
        rows_delta = to_num(d.get("n_returned_rows", 0))
        rows_per = rows_delta / calls if (calls > 0 and rows_delta >= 0) else None
        total_cell = ("%.1f" % (v / 1e3)) if metric in ("dbtime", "cpu", "io", "plan") else ("%d" % v)
        rows.append([row.get("user_name", ""), str(k), "%d" % calls,
                     total_cell,                               # total of the -m dimension
                     "%d" % pr if pr >= 0 else "-",
                     per("db_time"), per("execution_time"), per("cpu_time"),
                     per("data_io_time"),
                     "%.1f" % cr_per if cr_per is not None else "-",
                     "%.1f" % pr_per if pr_per is not None else "-",
                     "%.1f" % rows_per if rows_per is not None else "-",
                     "%.1f" % pct if pct is not None else "-"])
    return rows

def text_topsql(win, metric, top_n, detail_wins=None):
    """wdr_topsql screen equivalent for one awr window. avg_tt uses db_time
    (same source as the awrrpt Top SQL by DB Time section). detail_wins (a
    list of consecutive-snapshot interval windows) appends an 'awr topsql
    snapshot' section: one banner, one table, time_range leading column."""
    lines = _text_banner("awr topsql summary", win, extra="dim: %s" % metric)
    if metric in MEM_DIM_COLUMNS:
        # statement_mem one-sided capture would present full-cumulative
        # counters as a window delta (same guard as awrrpt section 11);
        # both sides absent (legacy snaps) also cannot rank -- precise
        # notes, not the generic no-rows message
        _smb = bool(win["db"].get(("begin", "statement_mem"), []))
        _sme = bool(win["db"].get(("end", "statement_mem"), []))
        if _smb != _sme:
            lines.append("(no rows: statement_mem capture missing on one side of the window (older snapshot))")
            return 0, "\n".join(lines)
        if not _smb:
            lines.append("(no rows: snapshots carry no statement_mem data (dim '%s' needs it))" % metric)
            return 0, "\n".join(lines)
    rows = _topsql_rows(win, metric, top_n)
    if rows is None:
        lines.append("(no rows: window has no statement deltas on dimension '%s')" % metric)
        return 0, "\n".join(lines)
    # the total column FOLLOWS the -m dimension (total_cputime_ms under -m
    # cpu, ...); time dimensions print ms -- same unit as the awrrpt SQL
    # tables and workload's total_dbtime (µs/1e3; was seconds, unlabeled,
    # 2026-11-04) -- count dimensions print integers. avg_* stay
    # dimension-independent and carry their own _ms suffix now.
    dim_total_headers = {"dbtime": "total_dbtime_ms", "cpu": "total_cputime_ms",
                         "io": "total_iotime_ms", "plan": "total_plantime_ms",
                         "calls": "total_calls", "lreads": "total_lreads",
                         "preads": "total_preads", "rows": "total_rows",
                         "memory": "total_mem", "spill": "total_spill"}
    headers = ["uname", "sql_id", "calls", dim_total_headers[metric],
               "total_pr", "avg_dbtime_ms", "avg_et_ms", "avg_cpu_ms",
               "avg_io_ms", "avg_cr", "avg_pr", "avg_rows", "pct%"]
    lines.append(_text_table(headers, rows, align="l" + "r" * 12))
    if detail_wins:
        lines += _text_snapshot_table("awr topsql snapshot", headers, "l" + "r" * 13,
                                      detail_wins,
                                      lambda w: _topsql_rows(w, metric, top_n))
    return 0, "\n".join(lines)

def _event_rows(win, event_filter):
    """text_event data rows (no banner/header); None = nothing to show."""
    IT = delta_rows(win, "instance_time", "stat_name", ["value"])
    def inst(name):
        v = to_num(IT.get(name, {}).get("value", 0))
        return v if v >= 0 else None
    db_time, cpu_time = inst("DB_TIME"), inst("CPU_TIME")
    WE = delta_rows(win, "wait_events", "event", ["wait", "total_wait_time"])
    entries = []
    if event_filter is None and cpu_time is not None:
        entries.append(("CPU time", "", cpu_time, None))
    for k, d in WE.items():
        if k in ("none", "wait cmd"):
            continue
        waits = to_num(d.get("wait", 0))
        t = to_num(d.get("total_wait_time", 0))
        if waits < 0 or t < 0:
            continue
        if event_filter is not None and k.lower() != event_filter.lower():
            continue
        if event_filter is None and waits == 0:
            continue                      # wdr: where waits > 0
        entries.append((k, (d.get("__row") or {}).get("type", ""), t, waits))
    if not entries:
        return None
    entries.sort(key=lambda e: e[2], reverse=True)
    if event_filter is None:
        entries = entries[:5]
    rows = []
    for ev, etype, t, waits in entries:
        avg = t / 1000.0 / waits if (waits is not None and waits > 0) else None
        # None when DB_TIME is unusable (negative delta / missing) so the row
        # renders '-' instead of a misleading 0.0% (audit 2026-10-30)
        pct = 100.0 * t / db_time if (db_time and db_time > 0) else None
        rows.append(["%.1f" % (db_time / 1e6) if db_time is not None else "-",
                     ev, etype,
                     "%.1f" % (t / 1e6),
                     "%d" % waits if waits is not None else "-",
                     "%.1f" % avg if avg is not None else "-",
                     ("%.1f%%" % pct) if pct is not None else "-"])
    return rows

