         ("n_tup_ins", "d"), ("n_tup_upd", "d"), ("n_tup_del", "d"), ("n_tup_hot_upd", "d"),
         ("n_live_tup", "e"), ("n_dead_tup", "be")],
        lambda v: (v["seq_tup_read"][1] - v["seq_tup_read"][0]) + (v["idx_tup_fetch"][1] - v["idx_tup_fetch"][0]))
    object_table("Top Indexes by Scans",
        win["db"].get(("begin", "object_indexes"), []),
        win["db"].get(("end", "object_indexes"), []),
        ("dbname", "schema", "object", "index"),
        [("idx_scan", "d"), ("idx_tup_read", "d"), ("idx_tup_fetch", "d")],
        lambda v: v["idx_scan"][1] - v["idx_scan"][0])

    # ================= Wait Events =================
    sec("Wait Events")
    parts.append('<table class="t"><tr><th>Event</th><th>Class</th><th class="n">Waits</th>'
                 '<th class="n">Total Wait Time (s)</th><th class="n">Avg wait (ms)</th>'
                 '<th class="n">% DB time</th></tr>')
    if not we_sorted:
        parts.append('<tr><td colspan="6" class="note">no data</td></tr>')
    for k in we_sorted:
        d = WE[k]; w = d.get("wait", 0.0); t = d.get("total_wait_time", 0.0)
        cls_ = (d.get("__row") or {}).get("type", "")
        avg = (t / w) if w else 0.0
        parts.append('<tr><td>%s</td><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%.2f%%</td></tr>' % (
                         esc(k), esc(cls_), fmt_int(w), s_of(t), ms_of(avg), pct(t, dbt)))
    parts.append('</table>')

    # ================= SQL Text (full normalized queries, AWR-style) =================
    sec("SQL Text")
    if not shown_sql:
        parts.append('<div class="note">no data</div>')
    else:
        parts.append('<table class="t"><tr><th>SQL Id</th><th>SQL Text</th></tr>')
        for uid in sorted(shown_sql.keys()):
            row = shown_sql[uid] or {}
            parts.append('<tr id="sql-%(u)s"><td class="sqlid">%(u)s</td>'
                         '<td><pre class="sqlfull">%(q)s</pre></td></tr>'
                         % {"u": esc(uid), "q": esc(normalize_sql(row.get("query", uid)))})
        parts.append('</table>')

    # ================= Database Parameters (pg_settings, live query) =================
    sec("Database Parameters")
    pgset = fetch_pg_settings()
    parts.append('<table class="t params"><colgroup>'
                 '<col style="width:24%"><col style="width:14%"><col style="width:12%"><col style="width:50%">'
                 '</colgroup><tr><th>Name</th><th>Setting</th>'
                 '<th>Context</th><th>Description</th></tr>')
    if not pgset:
        parts.append('<tr><td colspan="4" class="note">no data</td></tr>')
    else:
        def decode_setting(setting, unit):
            if unit == "8kB":
                try:
                    return "%dkB" % (int(float(setting)) * 8)
                except Exception:
                    return "%s kB" % setting
            return "%s%s" % (setting, unit if unit else "")
        for r in sorted(pgset, key=lambda x: x.get("name", "")):
            _n = r.get("name", "")
            _s = decode_setting(r.get("setting", ""), r.get("unit", ""))
            _c = r.get("context", "")
            _d = r.get("short_desc", "")
            parts.append('<tr><td title="%s">%s</td><td title="%s">%s</td><td>%s</td><td class="wrap">%s</td></tr>'
                         % (esc(_n), esc(_n), esc(_s), esc(_s), esc(_c), esc(_d)))
    parts.append('</table>')

    _toc_html = '<div class="toc" id="toc"><b>Contents</b><ul>' + "".join(
        '<li><a href="#%s">%s</a></li>' % (_id, esc(t)) for t, _id in _toc) + '</ul></div>'
    parts.insert(_toc_pos, _toc_html)

    # ================= Footer =================
    parts.append('<div class="foot">Generated by vb_tool awr report &middot; '
                 'single-window report &middot; all values = window(end-begin) &middot; '
                 '% DB time = metric / DB_TIME.</div>')
    parts.append('</body></html>')

    htmls = "".join(parts)
    if out_html:
        os.makedirs(os.path.dirname(os.path.abspath(out_html)), exist_ok=True)
        with open(out_html, "w") as f:
            f.write(htmls)
        print("report written: %s" % out_html)
    else:
        sys.stdout.write(htmls)


def render_awrdiff(win1, win2, metric, top_n, out_html):
    """AWR-style DIFF report: Period 1 vs Period 2. Each period is a
    build_window_from_snaps() result (its own end-begin delta). Every metric =
    P1 | P2 | Δ (Δ = P2-P1; %Diff where sensible). Mirrors render_single_awr
    sections. metric unused (all 6 SQL orderings shown)."""
    CSS_AWR = """
body { font-family: Arial, Helvetica, Geneva, sans-serif; font-size: 13px; color: #000; background: #fff; margin: 10px; }
.rhead { border: 1px solid #cccc99; margin-bottom: 8px; }
.rhead .title { background: #fff; color: #336699; font-weight: bold; font-size: 26px; padding: 6px 2px; border-bottom: 1px solid #cccc99; }
.rhead table { border-collapse: collapse; width: 100%; }
.rhead td { border: 1px solid #cccc99; padding: 3px 8px; font-size: 12px; background: #fff; vertical-align: top; }
.rhead td.k { background: #FFFFCC; font-weight: bold; width: 16%; }
.sec { background: #fff; color: #336699; font-weight: bold; font-size: 24px; padding: 0; margin-top: 26px; border: none; }
.sec h2 { display: inline; margin: 0; font-size: 24px; color: #336699; font-weight: bold; }
.sec .totop { float: right; color: #663300; background: #fff; text-decoration: none; border: 1px solid #663300;
              padding: 1px 10px; font-size: 12px; font-weight: bold; margin-top: 8px; }
.sec .totop:hover { background: #FFFFCC; }
.sub { background: #fff; color: #336699; font-weight: bold; font-size: 17px; padding: 0; margin-top: 16px; border: none; }
table.t { border-collapse: collapse; width: auto; max-width: 100%; border: 1px solid #000; margin-top: 4px; }
table.t th { background: #0066CC; color: #fff; font-weight: bold; padding: 3px 6px; border: 1px solid #0066CC; text-align: center; font-size: 11px; }
table.t td { padding: 3px 6px; border: 1px solid #cccccc; vertical-align: top; font-size: 12px; background: #fff; }
td.n, th.n { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
td.b { font-weight: bold; }
tr:nth-child(even) td { background: #FFFFCC; }
.sql { font-family: 'Courier New', Courier, monospace; font-size: 11px; max-width: 620px; word-break: break-all; }
.note { color: #555; font-size: 11px; font-style: italic; margin: 2px 0 6px 0; }
.bad { color: #c0392b; font-weight: bold; }
.foot { color: #555; font-size: 11px; margin-top: 20px; border-top: 1px solid #cccc99; padding-top: 8px; }
.sqlblock { border: 1px solid #cccc99; margin: 6px 0; padding: 6px 8px; background: #fff; }
.sqlid { font-weight: bold; color: #336699; font-size: 12px; margin-bottom: 4px; }
.sqlfull { font-family: 'Courier New', Courier, monospace; font-size: 11px; white-space: pre-wrap;
           word-break: break-all; margin: 0; color: #222; }
table.params { table-layout: fixed; width: 100%; }
table.params td { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
table.params td.wrap { white-space: normal; overflow: visible; text-overflow: clip; word-break: break-word; }
.toc { border: 1px solid #cccc99; background: #fff; padding: 8px 12px; margin-bottom: 12px; font-size: 12px; }
.toc b { display: inline-block; margin-bottom: 4px; }
.toc ul { margin: 0; padding-left: 20px; }
.toc li { line-height: 1.7; }
.toc a { color: #663300; text-decoration: none; }
.toc a:hover { text-decoration: underline; }
"""
    m1, m2 = win1["meta"], win2["meta"]
    dur1 = to_num(m1.get("duration")) or 1.0
    dur2 = to_num(m2.get("duration")) or 1.0

    IT1 = delta_rows(win1, "instance_time", "stat_name", ["value"])
    IT2 = delta_rows(win2, "instance_time", "stat_name", ["value"])
    dbt1 = IT1.get("DB_TIME", {}).get("value", 0.0)
    dbt2 = IT2.get("DB_TIME", {}).get("value", 0.0)

    _dbcols = ["xact_commit", "xact_rollback", "blks_read", "blks_hit", "deadlocks",
               "tup_returned", "tup_fetched", "tup_inserted", "tup_updated", "tup_deleted",
               "conflicts", "temp_bytes", "temp_files"]
    db1 = delta_rows(win1, "database", "datname", _dbcols)
    db2 = delta_rows(win2, "database", "datname", _dbcols)
    for _tpl in ("template0", "template1"):   # exclude template DBs from all db aggregates
        db1.pop(_tpl, None); db2.pop(_tpl, None)

    _stcols = ["n_calls", "db_time", "cpu_time", "data_io_time", "plan_time", "sort_time",
               "hash_time", "n_blocks_fetched", "n_blocks_hit", "n_returned_rows"]
    ST1 = delta_rows(win1, "statement", "unique_sql_id", _stcols)
    ST2 = delta_rows(win2, "statement", "unique_sql_id", _stcols)
    for _k in ST1:
        ST1[_k]["physical_reads"] = ST1[_k].get("n_blocks_fetched", 0.0) - ST1[_k].get("n_blocks_hit", 0.0)
    for _k in ST2:
        ST2[_k]["physical_reads"] = ST2[_k].get("n_blocks_fetched", 0.0) - ST2[_k].get("n_blocks_hit", 0.0)

    WE1 = delta_rows(win1, "wait_events", "event", ["wait", "total_wait_time"])
    WE2 = delta_rows(win2, "wait_events", "event", ["wait", "total_wait_time"])
    for _idle in ("wait cmd", "none"):   # drop idle/non-wait events (like Oracle idle events)
        WE1.pop(_idle, None); WE2.pop(_idle, None)

    osd1 = os_window_deltas(win1)
    osd2 = os_window_deltas(win2)

    def pct(num, den):
        return (num / den * 100.0) if den else 0.0
    def s_of(us):
        return "%.2f" % (to_num(us) / 1_000_000.0)
    def ms_of(us):
        return "%.2f" % (to_num(us) / 1000.0)
    def pctdiff(b, c):
        return ((c - b) / abs(b) * 100.0) if b else 0.0

    parts = []
    parts.append("<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'>")
    parts.append("<title>AWR Diff Report</title><style>%s</style></head><body>" % CSS_AWR)

    _toc = []
    _used = set()
    def _slug(t):
        s = "".join(c if c.isalnum() else "-" for c in (t or "").lower()).strip("-") or "sec"
        slug = s; i = 2
        while slug in _used:
            slug = "%s-%d" % (s, i); i += 1
        _used.add(slug); return slug
    def sec(t):
        _id = _slug(t); _toc.append((t, _id))
        parts.append('<div class="sec" id="%s"><h2>%s <a class="totop" href="#toc">↑ Top</a></h2></div>' % (_id, esc(t)))
    def sub(t):
        parts.append('<div class="sub">%s</div>' % esc(t))
    def note(t):
        for _l in t.split("\n"):
            parts.append('<div class="note">%s</div>' % esc(_l))

    # ================= Report Summary =================
    _compat_raw = psql_show("sql_compatibility")
    _compat = {"A": "A (Oracle)", "B": "B (MySQL)", "C": "C (MySQL)",
               "PG": "PG (PostgreSQL)"}.get(_compat_raw, _compat_raw) or "?"
    parts.append(
        '<div class="rhead"><div class="title">Performance AWR Diff Report</div><table>'
        '<tr><td class="k">Instance Name</td><td>%s</td><td class="k">Host</td><td>%s</td></tr>'
        '<tr><td class="k">Release</td><td>%s</td><td class="k">vb_tool</td><td>%s</td></tr>'
        '<tr><td class="k">DB Compatibility</td><td>%s</td><td class="k"></td><td></td></tr>'
        '<tr><td class="k">Period 1</td><td>%s: %s &rarr; %s (%ss)</td>'
        '<td class="k">Period 2</td><td>%s: %s &rarr; %s (%ss)</td></tr>'
        '<tr><td class="k">DB Time (s)</td><td>%s / %s</td>'
        '<td class="k">&Delta; DB Time (s)</td><td>%s</td></tr>'
        '</table></div>' % (
            esc(m2.get("db_name") or m2.get("name") or "?"), esc(m2.get("hostname", "?")),
            esc(m2.get("db_version", "?") or "?"), esc(m2.get("vb_tool_version", "?")),
            esc(_compat),
            esc(m1.get("name", "?")), esc(m1.get("begin_ts", "?")), esc(m1.get("end_ts", "?")), esc(m1.get("duration", "?")),
            esc(m2.get("name", "?")), esc(m2.get("begin_ts", "?")), esc(m2.get("end_ts", "?")), esc(m2.get("duration", "?")),
            s_of(dbt1), s_of(dbt2), s_of(dbt2 - dbt1),
        ))
    _toc_pos = len(parts)

    # ================= OS Statistics =================
    sec("OS Statistics")
    _ci1 = parse_cpuinfo(win1["os"].get(("end", "cpuinfo"), "")
                         or win1["os"].get(("begin", "cpuinfo"), ""))
    _ci2 = parse_cpuinfo(win2["os"].get(("end", "cpuinfo"), "")
                         or win2["os"].get(("begin", "cpuinfo"), ""))
    if _ci1 or _ci2:
        _ci = _ci2 or _ci1   # hardware info is static; prefer P2 (newer), fall back P1
        sub("CPU Info (period-end snapshot)")
        parts.append('<table class="t"><tr><th>Item</th><th class="n">Value</th></tr>')
        parts.append('<tr><td>Model</td><td>%s</td></tr>' % esc(_ci["model"]))
        parts.append('<tr><td>Sockets</td><td class="n">%d</td></tr>' % _ci["sockets"])
        parts.append('<tr><td>Cores per Socket</td><td class="n">%d</td></tr>' % _ci["cores_per_socket"])
        parts.append('<tr><td>Total Physical Cores</td><td class="n">%d</td></tr>' % _ci["total_cores"])
        parts.append('<tr><td>Threads per Core</td><td class="n">%d</td></tr>' % _ci["threads_per_core"])
        parts.append('<tr><td>Logical CPUs</td><td class="n">%d</td></tr>' % _ci["logical_cpus"])
        if _ci["freq_avg_mhz"]:
            parts.append('<tr><td>Freq (min / avg / max MHz)</td><td class="n">%.0f / %.0f / %.0f</td></tr>'
                         % (_ci["freq_min_mhz"], _ci["freq_avg_mhz"], _ci["freq_max_mhz"]))
        _plat = osd2.get("platform") or osd1.get("platform")
        if _plat:
            parts.append('<tr><td>Platform</td><td>%s</td></tr>' % esc(_plat))
        parts.append('</table>')
    sub("CPU utilization (%)")
    # horizontal layout: components as columns, P1 / P2 / delta as rows
    _cf = ("busy", "user", "nice", "system", "iowait", "irq", "softirq", "steal", "idle")
    parts.append('<table class="t"><tr><th></th>' +
                 ''.join('<th class="n">%s</th>' % f for f in _cf) + '</tr>')
    for _rl, _src in (("P1 %", osd1), ("P2 %", osd2)):
        parts.append('<tr><td class="k">%s</td>' % _rl + ''.join(
            '<td class="n%s">%.1f</td>' % (' b' if f == "busy" else '',
                                           _src["cpu"].get(f, 0.0)) for f in _cf) + '</tr>')
    parts.append('<tr><td class="k">&Delta; (pp)</td>' + ''.join(
        '<td class="n%s">%+.1f</td>' % (
            ' bad' if (f == "iowait" and
                       osd2["cpu"].get(f, 0.0) - osd1["cpu"].get(f, 0.0) > 0.5) else '',
            osd2["cpu"].get(f, 0.0) - osd1["cpu"].get(f, 0.0)) for f in _cf) + '</tr>')
    parts.append('</table>')
    _ntop = (parse_numa(win2["os"].get(("end", "numa"), "")
                        or win2["os"].get(("begin", "numa"), ""))
             or parse_numa(win1["os"].get(("end", "numa"), "")
                          or win1["os"].get(("begin", "numa"), "")))
    if _ntop:
        sub("NUMA")
        _nb1 = parse_numa(win1["os"].get(("begin", "numa"), ""))
        _ne1 = parse_numa(win1["os"].get(("end", "numa"), ""))
        _nb2 = parse_numa(win2["os"].get(("begin", "numa"), ""))
        _ne2 = parse_numa(win2["os"].get(("end", "numa"), ""))
        _nodes = _ntop.get("nodes", {})
        parts.append('<table class="t"><tr><th>NUMA Nodes</th><th class="n">%d</th></tr></table>'
                     % len(_nodes))
        parts.append('<table class="t"><tr><th>Node</th><th>CPU list</th><th>MemTotal</th>'
                     '<th>MemFree</th><th>Distance</th></tr>')
        for nid in sorted(_nodes, key=lambda x: int(x) if x.isdigit() else 0):
            nd = _nodes[nid]
            parts.append('<tr><td>%s</td><td>%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td><td class="n">%s</td></tr>' % (
                             esc(nid), esc(nd["cpus"]),
                             fmt_kb(nd["mem_total_kb"]), fmt_kb(nd["mem_free_kb"]),
                             esc(nd["distance"])))
        parts.append('</table>')
        parts.append('<table class="t"><tr><th>Node</th><th colspan="3">numa_hit</th>'
                     '<th colspan="3">local_node</th><th colspan="3">other_node</th></tr>'
                     '<tr><th></th>' + '<th class="n">P1</th><th class="n">P2</th><th class="n">&Delta;</th>' * 3
                     + '</tr>')
        _any = False
        for nid in sorted(_nodes, key=lambda x: int(x) if x.isdigit() else 0):
            _cells = []
            _has_any = False
            for key in ("numa_hit", "local_node", "other_node"):
                d1 = _numa_stat_delta(_nb1, _ne1, nid, key)
                d2 = _numa_stat_delta(_nb2, _ne2, nid, key)
                if d1 is not None or d2 is not None:
                    _has_any = True
                _cells.append(fmt_int(d1) if d1 is not None else "?")
                _cells.append(fmt_int(d2) if d2 is not None else "?")
                _cells.append(fmt_int(d2 - d1) if (d1 is not None and d2 is not None) else "?")
            if not _has_any:
                continue
            _any = True
            parts.append('<tr><td>%s</td>%s</tr>'
                         % (esc(nid), "".join('<td class="n">%s</td>' % c for c in _cells)))
        if not _any:
            parts.append('<tr><td colspan="10" class="note">no data</td></tr>')
        parts.append('</table>')
    sub("System Activity (per second)")
    parts.append('<table class="t"><tr><th></th><th class="n">Context Switches</th>'
                 '<th class="n">Interrupts</th></tr>')
    parts.append('<tr><td class="k">P1</td><td class="n">%.0f</td><td class="n">%.0f</td></tr>'
                 % (osd1.get("ctxt_per_sec", 0), osd1.get("intr_per_sec", 0)))
    parts.append('<tr><td class="k">P2</td><td class="n">%.0f</td><td class="n">%.0f</td></tr>'
                 % (osd2.get("ctxt_per_sec", 0), osd2.get("intr_per_sec", 0)))
    parts.append('<tr><td class="k">&Delta;</td><td class="n">%+.0f</td><td class="n">%+.0f</td></tr>'
                 % (osd2.get("ctxt_per_sec", 0) - osd1.get("ctxt_per_sec", 0),
                    osd2.get("intr_per_sec", 0) - osd1.get("intr_per_sec", 0)))
    parts.append('</table>')
    sub("OS Memory (period-end snapshot, MB)")
    _m1 = parse_meminfo(win1["os"].get(("end", "meminfo"), ""))
    _m2 = parse_meminfo(win2["os"].get(("end", "meminfo"), ""))
    parts.append('<table class="t"><tr><th>Metric</th><th class="n">P1 MB</th>'
                 '<th class="n">P2 MB</th><th class="n">&Delta; MB</th></tr>')
    for lbl in ("MemTotal", "MemFree", "MemAvailable", "Buffers", "Cached", "Active",
                "Slab", "SReclaimable", "SUnreclaim", "Shmem", "Dirty", "PageTables", "SwapFree"):
        v1 = _m1.get(lbl, 0) // 1024; v2 = _m2.get(lbl, 0) // 1024
        parts.append('<tr><td>%s</td><td class="n">%d</td><td class="n">%d</td>'
                     '<td class="n">%+d</td></tr>' % (esc(lbl), v1, v2, v2 - v1))
    parts.append('</table>')
    sub("Memory / Paging (per second)")
    vm1 = osd1.get("vm", {}); vm2 = osd2.get("vm", {})
    parts.append('<table class="t"><tr><th>Metric</th><th class="n">P1 /s</th>'
                 '<th class="n">P2 /s</th><th class="n">&Delta; /s</th></tr>')
    for lbl, key in [("page in (pgpgin)", "pgpgin"), ("page out (pgpgout)", "pgpgout"),
                     ("swap in (pswpin)", "pswpin"), ("swap out (pswpout)", "pswpout"),
                     ("minor fault (pgfault)", "pgfault"), ("major fault (pgmajfault)", "pgmajfault")]:
        v1 = vm1.get(key, 0.0); v2 = vm2.get(key, 0.0)
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td></tr>' % (esc(lbl), fmt_num(v1), fmt_num(v2), fmt_num(v2 - v1)))
    parts.append('</table>')
    sub("Disk I/O per device (per second)")
    _d1 = {d["name"]: d for d in osd1.get("disks", [])}
    _d2 = {d["name"]: d for d in osd2.get("disks", [])}
    _dmeta = osd2.get("disk_meta") or osd1.get("disk_meta") or {}
    _dsup = bool(osd1.get("discard_supported") or osd2.get("discard_supported"))
    _dh = '<th>Device</th>'
    if _dmeta:
        _dh += ('<th class="n">Size</th><th class="n">Type</th><th class="n">Rot</th>'
                '<th class="n">Sched</th><th class="n">QDepth</th><th class="n">NR_RQ</th><th class="n">WC</th>')
    _dh += ('<th class="n">P1 Reads</th><th class="n">P2 Reads</th>'
            '<th class="n">P1 Writes</th><th class="n">P2 Writes</th>'
            '<th class="n">P1 Read B</th><th class="n">P2 Read B</th>'
            '<th class="n">P1 Write B</th><th class="n">P2 Write B</th>')
    if _dsup:
        _dh += ('<th class="n">P1 Dscrd</th><th class="n">P2 Dscrd</th>'
                '<th class="n">P1 Flush</th><th class="n">P2 Flush</th>')
    _dh += '</tr>'
    parts.append('<table class="t"><tr>' + _dh)
    _dnames = sorted(set(_d1) | set(_d2))
    if not _dnames:
        _ncols = 1 + (7 if _dmeta else 0) + 8 + (4 if _dsup else 0)
        parts.append('<tr><td colspan="%d" class="note">no active disk devices</td></tr>' % _ncols)
    ddur1 = osd1.get("dur", 1.0) or 1.0; ddur2 = osd2.get("dur", 1.0) or 1.0
    for name in _dnames:
        a = _d1.get(name, {}); b = _d2.get(name, {})
        row = '<tr><td>%s</td>' % esc(name)
        if _dmeta:
            row += ''.join('<td class="n">%s</td>' % esc(c) for c in disk_meta_cells(name, _dmeta))
        row += ('<td class="n">%.1f</td><td class="n">%.1f</td><td class="n">%.1f</td><td class="n">%.1f</td>'
                '<td class="n">%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>' % (
                    a.get("read_iops", 0), b.get("read_iops", 0),
                    a.get("write_iops", 0), b.get("write_iops", 0),
                    fmt_bytes(a.get("read_bytes", 0) / ddur1), fmt_bytes(b.get("read_bytes", 0) / ddur2),
                    fmt_bytes(a.get("write_bytes", 0) / ddur1), fmt_bytes(b.get("write_bytes", 0) / ddur2)))
        if _dsup:
            row += ('<td class="n">%.1f</td><td class="n">%.1f</td><td class="n">%.1f</td><td class="n">%.1f</td>'
                    % (a.get("discard_iops") or 0.0, b.get("discard_iops") or 0.0,
                       a.get("flush_iops") or 0.0, b.get("flush_iops") or 0.0))
        row += '</tr>'
        parts.append(row)
    parts.append('</table>')
    sub("Network per interface (per second)")
    _i1 = {it["name"]: it for it in osd1.get("ifaces", [])}
    _i2 = {it["name"]: it for it in osd2.get("ifaces", [])}
    _nmeta = osd2.get("net_meta") or osd1.get("net_meta") or {}
    _nh = '<th>Interface</th><th class="n">P1 RX B</th><th class="n">P2 RX B</th><th class="n">P1 TX B</th><th class="n">P2 TX B</th><th class="n">P1 errs</th><th class="n">P2 errs</th>'
    if _nmeta:
        _nh += '<th class="n">Speed</th><th class="n">Duplex</th><th class="n">Queues</th><th class="n">RX ring</th><th class="n">TX ring</th>'
    _nh += '</tr>'
    parts.append('<table class="t"><tr>' + _nh)
    _inames = sorted(set(_i1) | set(_i2))
    if not _inames:
        parts.append('<tr><td colspan="%d" class="note">no network interfaces</td></tr>' % (7 + (5 if _nmeta else 0)))
    du1 = osd1.get("dur", 1.0) or 1.0; du2 = osd2.get("dur", 1.0) or 1.0
    for name in _inames:
        a = _i1.get(name, {}); b = _i2.get(name, {})
        row = '<tr><td>%s</td><td class="n">%.0f</td><td class="n">%.0f</td><td class="n">%.0f</td><td class="n">%.0f</td><td class="n">%.0f</td><td class="n">%.0f</td>' % (
                         esc(name), a.get("rx_bytes", 0) / du1, b.get("rx_bytes", 0) / du2,
                         a.get("tx_bytes", 0) / du1, b.get("tx_bytes", 0) / du2,
                         a.get("rx_errs", 0) + a.get("tx_errs", 0), b.get("rx_errs", 0) + b.get("tx_errs", 0))
        if _nmeta:
            row += ''.join('<td class="n">%s</td>' % esc(c) for c in net_meta_cells(name, _nmeta))
        row += '</tr>'
        parts.append(row)
    parts.append('</table>')

    if osd1.get("netstat_ok") or osd2.get("netstat_ok"):
        sub("Network Protocol Errors")
        parts.append('<table class="t"><tr><th>Protocol</th><th>Counter</th>'
                     '<th class="n">P1 &Delta;</th><th class="n">P2 &Delta;</th><th class="n">&Delta;</th></tr>')
        # Core rows in fixed order
        dur1 = osd1.get("dur", 1.0) or 1.0
        dur2 = osd2.get("dur", 1.0) or 1.0
        for proto, name, label, d1, d2, d_diff in netstat_core_rows_awrdiff(win1["os"], dur1, win2["os"], dur2):
            _m = " class=\"n muted\"" if (not d1 and not d2) else " class=\"n\""
            parts.append('<tr><td>%s</td><td>%s</td><td%s>%s</td><td%s>%s</td><td%s>%s</td></tr>'
                         % (esc(proto), esc(label),
                            _m, ("%.0f" % d1) if d1 is not None else "-",
                            _m, ("%.0f" % d2) if d2 is not None else "-",
                            _m, ("%.0f" % d_diff) if d_diff is not None else "-"))
        # Tail rows (union of non-core counters with nonzero in either period)
        tail1 = netstat_err_deltas(
            [("snmp", win1["os"].get(("begin", "net_snmp"), "")),
             ("netstat", win1["os"].get(("begin", "net_netstat"), ""))],
            [("snmp", win1["os"].get(("end", "net_snmp"), "")),
             ("netstat", win1["os"].get(("end", "net_netstat"), ""))], osd1.get("dur", 1.0) or 1.0)
        tail2 = netstat_err_deltas(
            [("snmp", win2["os"].get(("begin", "net_snmp"), "")),
             ("netstat", win2["os"].get(("begin", "net_netstat"), ""))],
            [("snmp", win2["os"].get(("end", "net_snmp"), "")),
             ("netstat", win2["os"].get(("end", "net_netstat"), ""))], osd2.get("dur", 1.0) or 1.0)
        if tail1 or tail2:
            _e1 = {(r["proto"], r["name"]): r for r in tail1}
            _e2 = {(r["proto"], r["name"]): r for r in tail2}
            _keys = sorted(set(_e1) | set(_e2),
                           key=lambda k: -max(abs(_e1.get(k, {}).get("delta", 0)),
                                              abs(_e2.get(k, {}).get("delta", 0))))[:20]
            for k in _keys:
                d1 = _e1.get(k, {}).get("delta"); d2 = _e2.get(k, {}).get("delta")
                _m = " class=\"n muted\"" if (not d1 and not d2) else " class=\"n\""
                parts.append('<tr><td>%s</td><td>%s</td><td%s>%s</td><td%s>%s</td><td%s>%s</td></tr>'
                             % (esc(k[0]), esc(k[1]),
                                _m, ("%.0f" % d1) if d1 is not None else "-",
                                _m, ("%.0f" % d2) if d2 is not None else "-",
                                _m, ("%.0f" % (d2 - d1)) if (d1 is not None and d2 is not None) else "-"))
        parts.append('</table>')

    # ================= Time Model System Stats =================
    sec("Time Model System Stats")
    it_keys = sorted(set(IT1) | set(IT2),
                     key=lambda k: max(IT1.get(k, {}).get("value", 0), IT2.get(k, {}).get("value", 0)), reverse=True)
    parts.append('<table class="t"><tr><th>Stat</th><th class="n">P1 (s)</th>'
                 '<th class="n">P2 (s)</th><th class="n">&Delta; (s)</th></tr>')
    if not it_keys:
        parts.append('<tr><td colspan="4" class="note">no data</td></tr>')
    for k in it_keys:
        v1 = IT1.get(k, {}).get("value", 0.0); v2 = IT2.get(k, {}).get("value", 0.0)
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td></tr>' % (esc(k), s_of(v1), s_of(v2), s_of(v2 - v1)))
    parts.append('</table>')

    # ================= Load Profile =================
    def _dbsum(d, col):
        return sum(v.get(col, 0.0) for v in d.values())
    def _lsn(lsn):
        try:
            hi, lo = (lsn or "").split("/")
            return (int(hi, 16) << 32) + int(lo, 16)
        except Exception:
            return 0
    def _pwlsn_delta(win, col):
        _e = sum(_lsn(r.get(col, "")) for r in win["db"].get(("end", "pagewriter"), []))
        _b = sum(_lsn(r.get(col, "")) for r in win["db"].get(("begin", "pagewriter"), []))
        return _e - _b
    sec("Load Profile")
    parts.append('<table class="t"><tr><th>Metric</th><th class="n">P1 total</th>'
                 '<th class="n">P2 total</th><th class="n">&Delta;</th>'
                 '<th class="n">P1 /s</th><th class="n">P2 /s</th></tr>')
    for lbl, col in [("blocks read", "blks_read"), ("blocks hit", "blks_hit"),
                     ("rows returned", "tup_returned"), ("rows fetched", "tup_fetched"),
                     ("rows inserted", "tup_inserted"), ("rows updated", "tup_updated"),
                     ("rows deleted", "tup_deleted"), ("commits", "xact_commit"),
                     ("rollbacks", "xact_rollback"), ("deadlocks", "deadlocks"),
                     ("conflicts", "conflicts"), ("temp bytes", "temp_bytes")]:
        v1 = _dbsum(db1, col); v2 = _dbsum(db2, col)
        fb = fmt_bytes if col == "temp_bytes" else fmt_int
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td></tr>' % (
                         esc(lbl), fb(v1), fb(v2), fb(v2 - v1), fmt_num(v1 / dur1), fmt_num(v2 / dur2)))
    _wal1 = _pwlsn_delta(win1, "current_xlog_insert_lsn"); _wal2 = _pwlsn_delta(win2, "current_xlog_insert_lsn")
    parts.append('<tr><td>WAL written</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>'
                 '<td class="n">%s</td><td class="n">%s</td></tr>' % (
                     fmt_bytes(_wal1), fmt_bytes(_wal2), fmt_bytes(_wal2 - _wal1),
                     fmt_bytes(_wal1 / dur1), fmt_bytes(_wal2 / dur2)))
    _pf1 = _pwlsn_delta(win1, "ckpt_redo_point"); _pf2 = _pwlsn_delta(win2, "ckpt_redo_point")
    parts.append('<tr><td>pagewriter written</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>'
                 '<td class="n">%s</td><td class="n">%s</td></tr>' % (
                     fmt_bytes(_pf1), fmt_bytes(_pf2), fmt_bytes(_pf2 - _pf1),
                     fmt_bytes(_pf1 / dur1), fmt_bytes(_pf2 / dur2)))
    parts.append('</table>')

    # ================= Cache Hit Ratio =================
    sec("Cache Hit Ratio")
    def _hit(d, dn):
        h = d.get(dn, {}).get("blks_hit", 0); r = d.get(dn, {}).get("blks_read", 0); t = h + r
        return (h / t * 100.0) if t else 0.0
    _dns = sorted((set(db1) | set(db2)) - {"template0", "template1"})
    _cr = [(_dn, _hit(db1, _dn), _hit(db2, _dn)) for _dn in _dns]
    _cr = [r for r in _cr if r[1] or r[2]]
    _cr.sort(key=lambda x: max(x[1], x[2]), reverse=True)
    parts.append('<table class="t"><tr><th>Database</th><th class="n">P1 Hit%</th>'
                 '<th class="n">P2 Hit%</th><th class="n">&Delta;</th></tr>')
    if not _cr:
        parts.append('<tr><td colspan="4" class="note">no data</td></tr>')
    for _dn, r1, r2 in _cr:
        parts.append('<tr><td>%s</td><td class="n">%.2f%%</td><td class="n">%.2f%%</td>'
                     '<td class="n">%+.2f%%</td></tr>' % (esc(_dn), r1, r2, r2 - r1))
    parts.append('</table>')

    # ================= Database Memory =================
    sec("Database Memory")
    sub("Memory GUCs (live)")
    _rows = psql_query("SELECT name, decode(unit,'8kB',setting*8||'kB',setting||COALESCE(unit,' ')) AS setting "
                       "FROM pg_settings WHERE name IN ('maintenance_work_mem','work_mem','shared_buffers',"
                       "'max_process_memory','wal_buffers','effective_cache_size','cstore_buffers',"
                       "'segment_buffers','temp_buffers','local_syscache_threshold','max_connections') ORDER BY name")
    if not _rows:
        parts.append('<div class="note">no data</div>')
    else:
        parts.append('<table class="t"><tr><th>Name</th><th>Setting</th></tr>')
        for r in _rows:
            parts.append('<tr><td>%s</td><td>%s</td></tr>' % (esc(r.get("name", "")), esc(r.get("setting", ""))))
        parts.append('</table>')
    def _grp(rows, key, val):
        out = {}
        for r in rows:
            try:
                out[r.get(key, "")] = out.get(r.get(key, ""), 0) + to_num(r.get(val, 0) or 0)
            except Exception:
                pass
        return out
    def be_diff(label, end_r1, end_r2, key_col, val_col, fmt_fn, top=10):
        sub(label)
        d1 = _grp(end_r1, key_col, val_col); d2 = _grp(end_r2, key_col, val_col)
        _keys = sorted(set(d1) | set(d2), key=lambda k: max(d1.get(k, 0), d2.get(k, 0)), reverse=True)[:top]
        parts.append('<table class="t"><tr><th>%s</th><th class="n">P1</th><th class="n">P2</th>'
                     '<th class="n">&Delta;</th></tr>' % esc(key_col))
        if not _keys:
            parts.append('<tr><td colspan="4" class="note">no data</td></tr>')
        for k in _keys:
            v1 = d1.get(k, 0); v2 = d2.get(k, 0)
            parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td></tr>' % (esc(k), fmt_fn(v1), fmt_fn(v2), fmt_fn(v2 - v1)))
        parts.append('</table>')
    be_diff("Total Memory by Type (MB)",
            win1["db"].get(("end", "memory_node_detail"), []),
            win2["db"].get(("end", "memory_node_detail"), []),
            "memorytype", "mb", lambda v: fmt_bytes(v * 1024 * 1024), top=20)
    be_diff("Top 10 Shared Memory Context",
            win1["db"].get(("end", "shared_memory"), []),
            win2["db"].get(("end", "shared_memory"), []),
            "contextname", "total", fmt_bytes, top=10)
    be_diff("Top 10 Session Memory Context",
            win1["db"].get(("end", "session_memory"), []),
            win2["db"].get(("end", "session_memory"), []),
            "contextname", "total", fmt_bytes, top=10)

    # ================= Object Statistics =================
    sec("Object Statistics")
    note("Per-object window-delta counters (end-begin) compared P1 vs P2. Top by (P1+P2) of the sort metric.")
    def obj_diff(label, begin_r1, end_r1, begin_r2, end_r2, key_cols, cnt_cols, sort_col, top=30):
        sub(label)
        def _key(r):
            return tuple(r.get(k, "") for k in key_cols)
        def _delta(begin, end):
            b = {}
            for r in begin:
                b[_key(r)] = {c: to_num(r.get(c, 0) or 0) for c in cnt_cols}
            e = {}
            for r in end:
                e[_key(r)] = {c: to_num(r.get(c, 0) or 0) for c in cnt_cols}
            out = {}
            for k in set(b) | set(e):
                out[k] = {c: e.get(k, {}).get(c, 0) - b.get(k, {}).get(c, 0) for c in cnt_cols}
            return out
        d1 = _delta(begin_r1, end_r1); d2 = _delta(begin_r2, end_r2)
        _keys = sorted(set(d1) | set(d2),
                       key=lambda k: d2.get(k, {}).get(sort_col, 0) + d1.get(k, {}).get(sort_col, 0), reverse=True)[:top]
        _hdr = list(key_cols) + [c + " P1" for c in cnt_cols] + [c + " P2" for c in cnt_cols] + [c + " &Delta;" for c in cnt_cols]
        parts.append('<table class="t"><tr>' + ''.join('<th>%s</th>' % esc(c) for c in _hdr) + '</tr>')
        if not _keys:
            parts.append('<tr><td colspan="%d" class="note">no data</td></tr>' % len(_hdr))
        for k in _keys:
            cells = ''.join('<td>%s</td>' % esc(x) for x in k)
            for c in cnt_cols:
                cells += '<td class="n">%s</td>' % fmt_int(d1.get(k, {}).get(c, 0))
            for c in cnt_cols:
                cells += '<td class="n">%s</td>' % fmt_int(d2.get(k, {}).get(c, 0))
            for c in cnt_cols:
                cells += '<td class="n">%s</td>' % fmt_int(d2.get(k, {}).get(c, 0) - d1.get(k, {}).get(c, 0))
            parts.append('<tr>' + cells + '</tr>')
        parts.append('</table>')
    obj_diff("Top Tables by Activity",
             win1["db"].get(("begin", "object_tables"), []), win1["db"].get(("end", "object_tables"), []),
             win2["db"].get(("begin", "object_tables"), []), win2["db"].get(("end", "object_tables"), []),
             ("dbname", "schema", "object"),
             ("seq_scan", "seq_tup_read", "idx_scan", "idx_tup_fetch", "n_tup_upd", "n_tup_del"), "seq_tup_read")
    obj_diff("Top Indexes by Scans",
             win1["db"].get(("begin", "object_indexes"), []), win1["db"].get(("end", "object_indexes"), []),
             win2["db"].get(("begin", "object_indexes"), []), win2["db"].get(("end", "object_indexes"), []),
             ("dbname", "schema", "object", "index"),
             ("idx_scan", "idx_tup_read", "idx_tup_fetch"), "idx_scan")
    obj_diff("Top Objects by Dead Tuples (window Δ)",
             win1["db"].get(("begin", "object_dead"), []), win1["db"].get(("end", "object_dead"), []),
             win2["db"].get(("begin", "object_dead"), []), win2["db"].get(("end", "object_dead"), []),
             ("dbname", "schema", "object"),
             ("n_dead_tup", "n_live_tup"), "n_dead_tup")

    # ================= Top 10 Wait Events =================
    sec("Top 10 Wait Events by Total Wait Time")
    _we_top = sorted(set(WE1) | set(WE2),
                     key=lambda k: max(WE1.get(k, {}).get("total_wait_time", 0), WE2.get(k, {}).get("total_wait_time", 0)),
                     reverse=True)[:10]
    parts.append('<table class="t"><tr><th>Event</th><th>Class</th>'
                 '<th class="n">P1 Waits</th><th class="n">P2 Waits</th>'
                 '<th class="n">P1 Time (s)</th><th class="n">P2 Time (s)</th><th class="n">&Delta; (s)</th></tr>')
    if not _we_top:
        parts.append('<tr><td colspan="7" class="note">no data</td></tr>')
    for k in _we_top:
        d1 = WE1.get(k, {}); d2 = WE2.get(k, {})
        cls_ = ((d2 or d1).get("__row") or {}).get("type", "")
        t1 = d1.get("total_wait_time", 0.0); t2 = d2.get("total_wait_time", 0.0)
        _badge = " <span class='bad'>[NEW]</span>" if k not in WE1 else (" <span class='note'>[GONE]</span>" if k not in WE2 else "")
        parts.append('<tr><td>%s%s</td><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td><td class="n">%s</td></tr>' % (
                         esc(k), _badge, esc(cls_), fmt_int(d1.get("wait", 0)), fmt_int(d2.get("wait", 0)),
                         s_of(t1), s_of(t2), s_of(t2 - t1)))
    parts.append('</table>')

    # ================= SQL Statistics =================
    sec("SQL Statistics")
    note("Per-SQL Period 1 vs Period 2. %%Diff = (P2-P1)/|P1|. [NEW] = only in P2; [GONE] = only in P1.\n"
         "Top %d by max(P1,P2) of each ordering metric." % top_n)
    shown_sql = {}
    def sql_block_diff(label, order_col, dim_header, dim_fmt):
        sub(label)
        _sum1 = sum(d.get(order_col, 0.0) for d in ST1.values())
        _sum2 = sum(d.get(order_col, 0.0) for d in ST2.values())
        keys = sorted(set(ST1) | set(ST2),
                      key=lambda k: max(ST1.get(k, {}).get(order_col, 0.0), ST2.get(k, {}).get(order_col, 0.0)),
                      reverse=True)[:top_n]
        parts.append('<table class="t"><tr><th>#</th><th>SQL Id</th><th>User</th>'
                     '<th class="n">P1 Exec</th><th class="n">P2 Exec</th>'
                     '<th class="n">P1 %s</th><th class="n">P2 %s</th>'
                     '<th class="n">P1 %%T</th><th class="n">P2 %%T</th>'
                     '<th class="n">%%Diff</th><th>note</th></tr>' % (dim_header, dim_header))
        if not keys:
            parts.append('<tr><td colspan="11" class="note">no data</td></tr>')
        for i, k in enumerate(keys, 1):
            d1 = ST1.get(k); d2 = ST2.get(k)
            row = ((d2 or d1) or {}).get("__row") or {}
            if k not in shown_sql:
                shown_sql[k] = row
            e1 = (d1 or {}).get("n_calls", 0.0); e2 = (d2 or {}).get("n_calls", 0.0)
            v1 = (d1 or {}).get(order_col, 0.0); v2 = (d2 or {}).get(order_col, 0.0)
            badge = ""
            if not d1 and d2:
                badge = "<span class='bad'>[NEW]</span>"
            elif d1 and not d2:
                badge = "<span class='note'>[GONE]</span>"
            _pdiff = "new" if (v1 == 0 and v2 > 0) else ("%+.1f%%" % pctdiff(v1, v2))
            parts.append('<tr><td>%d</td><td><a href="#sql-%s">%s</a></td><td>%s</td>'
                         '<td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%.1f%%</td><td class="n">%.1f%%</td>'
                         '<td class="n">%s</td><td>%s</td></tr>' % (
                             i, esc(k), esc(k), esc(row.get("user_name") or ""),
                             fmt_int(e1), fmt_int(e2), dim_fmt(v1), dim_fmt(v2),
                             pct(v1, _sum1), pct(v2, _sum2), _pdiff, badge))
        parts.append('</table>')
    sql_block_diff("SQL ordered by DB Time", "db_time", "DB Time (s)", s_of)
    sql_block_diff("SQL ordered by CPU Time", "cpu_time", "CPU Time (s)", s_of)
    sql_block_diff("SQL ordered by IO Time", "data_io_time", "IO Time (s)", s_of)
    sql_block_diff("SQL ordered by Logical Reads", "n_blocks_fetched", "logical reads", fmt_int)
    sql_block_diff("SQL ordered by Physical Reads", "physical_reads", "physical reads", fmt_int)
    sql_block_diff("SQL ordered by Executions", "n_calls", "Executions", fmt_int)

    # ================= Wait Events (full) =================
    sec("Wait Events")
    _we_all = sorted(set(WE1) | set(WE2),
                     key=lambda k: max(WE1.get(k, {}).get("total_wait_time", 0), WE2.get(k, {}).get("total_wait_time", 0)),
                     reverse=True)
    parts.append('<table class="t"><tr><th>Event</th><th>Class</th>'
                 '<th class="n">P1 Waits</th><th class="n">P2 Waits</th>'
                 '<th class="n">P1 Time (s)</th><th class="n">P2 Time (s)</th><th class="n">&Delta; (s)</th></tr>')
    if not _we_all:
        parts.append('<tr><td colspan="7" class="note">no data</td></tr>')
    for k in _we_all:
        d1 = WE1.get(k, {}); d2 = WE2.get(k, {})
        cls_ = ((d2 or d1).get("__row") or {}).get("type", "")
        t1 = d1.get("total_wait_time", 0.0); t2 = d2.get("total_wait_time", 0.0)
        parts.append('<tr><td>%s</td><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td><td class="n">%s</td></tr>' % (
                         esc(k), esc(cls_), fmt_int(d1.get("wait", 0)), fmt_int(d2.get("wait", 0)),
                         s_of(t1), s_of(t2), s_of(t2 - t1)))
    parts.append('</table>')

    # ================= SQL Text (union of both periods) =================
    sec("SQL Text")
    if not shown_sql:
        parts.append('<div class="note">no data</div>')
    else:
        parts.append('<table class="t"><tr><th>SQL Id</th><th>SQL Text</th></tr>')
        for uid in sorted(shown_sql):
            row = shown_sql[uid] or {}
            parts.append('<tr id="sql-%(u)s"><td class="sqlid">%(u)s</td>'
                         '<td><pre class="sqlfull">%(q)s</pre></td></tr>'
                         % {"u": esc(uid), "q": esc(normalize_sql(row.get("query", uid)))})
        parts.append('</table>')

    # ================= Database Parameters (CHANGED between period1 and period2) =================
    # pg_settings is a STATE snapshot (not a cumulative counter), so each period is
    # represented by its END snap's value. Only params whose decoded setting differs
    # between period1.end and period2.end are shown.
    sec("Database Parameters (changed only)")
    _pgs1 = win1["db"].get(("end", "pg_settings"), [])
    _pgs2 = win2["db"].get(("end", "pg_settings"), [])
    def _pgmap(rows):
        m = {}
        for r in rows:
            n = r.get("name")
            if n:
                m[n] = r
        return m
    def _decode(setting, unit):
        if unit == "8kB":
            try:
                return "%dkB" % (int(float(setting)) * 8)
            except Exception:
                return "%s kB" % setting
        return "%s%s" % (setting, unit if unit else "")
    parts.append('<table class="t params"><colgroup>'
                 '<col style="width:22%"><col style="width:18%"><col style="width:18%">'
                 '<col style="width:8%"><col style="width:10%"><col style="width:24%">'
                 '</colgroup>'
                 '<tr><th>Name</th><th>Period 1 Setting</th><th>Period 2 Setting</th>'
                 '<th>Unit</th><th>Context</th><th>Description</th></tr>')
    if not _pgs1 or not _pgs2:
        note("pg_settings not captured in one or both periods (snap predates pg_settings "
             "capture); parameter diff unavailable.")
        parts.append('<tr><td colspan="6" class="note">(no parameter diff available)</td></tr>')
    else:
        _m1, _m2 = _pgmap(_pgs1), _pgmap(_pgs2)
        _changed = [n for n in sorted(set(_m1) | set(_m2))
                    if _decode(_m1.get(n, {}).get("setting", ""), _m1.get(n, {}).get("unit", ""))
                       != _decode(_m2.get(n, {}).get("setting", ""), _m2.get(n, {}).get("unit", ""))]
        if not _changed:
            note("No GUC parameter changes between Period 1 (snap end) and Period 2 (snap end).")
            parts.append('<tr><td colspan="6" class="note">No parameter changes between Period 1 and Period 2.</td></tr>')
        else:
            for _n in _changed:
                _r1 = _m1.get(_n, {}); _r2 = _m2.get(_n, {})
                _s1 = _decode(_r1.get("setting", ""), _r1.get("unit", ""))
                _s2 = _decode(_r2.get("setting", ""), _r2.get("unit", ""))
                _u = _r2.get("unit", "") or _r1.get("unit", "")
                _c = _r2.get("context", "") or _r1.get("context", "")
                _d = _r2.get("short_desc", "") or _r1.get("short_desc", "")
                parts.append('<tr><td title="%s">%s</td><td title="%s">%s</td><td title="%s">%s</td>'
                             '<td>%s</td><td>%s</td><td class="wrap">%s</td></tr>'
                             % (esc(_n), esc(_n), esc(_s1), esc(_s1), esc(_s2), esc(_s2),
                                esc(_u), esc(_c), esc(_d)))
            note("%d GUC parameter(s) changed between Period 1 and Period 2." % len(_changed))
    parts.append('</table>')

    _toc_html = '<div class="toc" id="toc"><b>Contents</b><ul>' + "".join(
        '<li><a href="#%s">%s</a></li>' % (_id, esc(t)) for t, _id in _toc) + '</ul></div>'
    parts.insert(_toc_pos, _toc_html)

    parts.append('<div class="foot">Generated by vb_tool awr awrdiff &middot; diff report &middot; '
                 'each value = period(end-begin); &Delta; = P2-P1; %%Diff = (P2-P1)/|P1|.</div>')
    parts.append('</body></html>')

    htmls = "".join(parts)
    if out_html:
        os.makedirs(os.path.dirname(os.path.abspath(out_html)), exist_ok=True)
        with open(out_html, "w") as f:
            f.write(htmls)
        print("report written: %s" % out_html)
    else:
        sys.stdout.write(htmls)


def main():
    argv = sys.argv[1:]
    awr_dir = current_dir = single_dir = begin_dir = end_dir = out_html = ""
    awrdiff_dirs = []
    repl_dir = None
    metric = "dbtime"
    top_n = 30
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--awr" and i + 1 < len(argv):
            awr_dir = argv[i + 1]; i += 2
        elif a == "--current" and i + 1 < len(argv):
            current_dir = argv[i + 1]; i += 2
        elif a == "--single" and i + 1 < len(argv):
            single_dir = argv[i + 1]; i += 2
        elif a == "--begin" and i + 1 < len(argv):
            begin_dir = argv[i + 1]; i += 2
        elif a == "--end" and i + 1 < len(argv):
            end_dir = argv[i + 1]; i += 2
        elif a == "--repl-dir" and i + 1 < len(argv):
            repl_dir = argv[i + 1] or None; i += 2   # empty string == not supplied
        elif a == "--awrdiff" and i + 4 < len(argv):
            awrdiff_dirs = argv[i + 1:i + 5]; i += 5
        elif a == "-o" and i + 1 < len(argv):
            out_html = argv[i + 1]; i += 2
        elif a == "-m" and i + 1 < len(argv):
            metric = argv[i + 1]; i += 2
        elif a == "-n" and i + 1 < len(argv):
            try:
                top_n = int(argv[i + 1])
            except ValueError:
                sys.stderr.write("Error: -n expects an integer, got %r\n" % argv[i + 1]); return 2
            i += 2
        else:
            i += 1

    def _default_html(meta):
        # default name: awr_{DB_NAME}_{BEGINTIME}_{ENDTIME}.html under awr_reports/
        _dn = meta.get("db_name") or meta.get("name") or "unknown"
        _dn = "".join(c for c in str(_dn) if c.isalnum() or c in "_-") or "unknown"
        _b = str(meta.get("begin_ts", "")).replace("-", "").replace(":", "").replace(" ", "")
        _e = str(meta.get("end_ts", "")).replace("-", "").replace(":", "").replace(" ", "")
        _reports_dir = os.path.join(os.path.expanduser(os.environ.get("VB_TOOL_HOME", "~/.vb_tool")),
                                    "awr_reports")
        return os.path.join(_reports_dir, "awr_%s_%s_%s.html" % (_dn, _b, _e))

    def _default_awrdiff_html(meta1, meta2):
        # awrdiff_{DB}_{P1_begin}_{P2_begin}.html (each period identified by begin ts)
        _dn = meta2.get("db_name") or meta1.get("db_name") or "unknown"
        _dn = "".join(c for c in str(_dn) if c.isalnum() or c in "_-") or "unknown"
        _p1 = str(meta1.get("begin_ts", "")).replace("-", "").replace(":", "").replace(" ", "")
        _p2 = str(meta2.get("begin_ts", "")).replace("-", "").replace(":", "").replace(" ", "")
        _reports_dir = os.path.join(os.path.expanduser(os.environ.get("VB_TOOL_HOME", "~/.vb_tool")),
                                    "awr_reports")
        return os.path.join(_reports_dir, "awrdiff_%s_%s_%s.html" % (_dn, _p1, _p2))

    if awrdiff_dirs:
        if len(awrdiff_dirs) != 4:
            sys.stderr.write("Error: --awrdiff needs 4 snap dirs: p1_begin p1_end p2_begin p2_end\n")
            sys.exit(2)
        w1 = build_window_from_snaps(awrdiff_dirs[0], awrdiff_dirs[1])
        w2 = build_window_from_snaps(awrdiff_dirs[2], awrdiff_dirs[3])
        if not out_html:
            out_html = _default_awrdiff_html(w1["meta"], w2["meta"])
        render_awrdiff(w1, w2, metric, top_n, out_html)
        return
    if begin_dir and end_dir:
        win = build_window_from_snaps(begin_dir, end_dir)
        if not out_html:
            out_html = _default_html(win["meta"])
        render_single_awr(win, metric, top_n, out_html, repl_dir=repl_dir)
        return
    if single_dir:
        win = load_window(single_dir)
        if not out_html:
            out_html = _default_html(win["meta"])
        render_single_awr(win, metric, top_n, out_html)
        return
    if not awr_dir or not current_dir:
        sys.stderr.write("usage: compare_render.py --awr DIR --current DIR "
                         "[-m dbtime|cpu|io] [-n N] -o FILE\n"
                         "       compare_render.py --single DIR "
                         "[-m dbtime|cpu|io] [-n N] [-o FILE]\n"
                         "       compare_render.py --begin DIR --end DIR "
                         "[-m dbtime|cpu|io] [-n N] [--repl-dir DIR] [-o FILE]\n"
                         "       compare_render.py --awrdiff D1 D2 D3 D4 "
                         "(p1_begin p1_end p2_begin p2_end) [-m ..] [-n N] [-o FILE]\n")
        sys.exit(2)
    render(awr_dir, current_dir, metric, top_n, out_html)

if __name__ == "__main__":
