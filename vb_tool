            r_dsent="" r_dwr="" r_dfl="" r_drp="" r_net="" r_fs="" r_ap="" r_tot=""
            x_cur="" x_ckr="" x_old="" x_cbm="" x_cnt="" x_sz="" x_rest="" x_arch=""
            # ★同理补 s_*/w_*/m_*/lk_*/h_*/ist_* (2026-10-11 审查: 单段 SQL 失败/超时
