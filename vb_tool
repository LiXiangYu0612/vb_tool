                               % fmt_int(sum(_pg(_b if _ph == "Begin" else _e, o)
                                             for o in _ords)))
        _bh.append('</table>')
        parts.append("".join(_bh))

        def _frag(d):
            _tot = sum(v * (1 << o) for o, v in d.items())   # free pages
            # pages held in blocks of order >= 9 (buddyinfo counts BLOCKS, so
            # a count has to be scaled by the block size 2^o to get pages)
            _big = sum(v * (1 << o) for o, v in d.items() if o >= 9)
            _blk = sum(v * (1 << (o - 9)) for o, v in d.items() if o >= 9)
            _lg = max([o for o, v in d.items() if v > 0], default=None)
            _pct = (100.0 * (1.0 - _big / _tot)) if _tot else None
            return _tot, _big, _blk, _lg, _pct

        def _pc(v):
            return "-" if v is None else ("%.2f%%" % v)
        parts.append('<table class="t"><tr><th>Zone</th><th>Phase</th>'
                     '<th class="n">free pages</th><th class="n">2MB+ pages</th>'
                     '<th class="n">2MB blocks</th><th class="n">largest order</th>'
                     '<th class="n">fragmentation</th></tr>')
        for _z in _zones:
            _fb = _frag(_bz.get(_z, {}))
            _fe = _frag(_ez.get(_z, {}))
            for _ph, _m in (("Begin", _fb), ("End", _fe)):
                parts.append('<tr><td>%s</td><td>%s</td><td class="n">%s</td>'
                             '<td class="n">%s</td><td class="n">%s</td>'
                             '<td class="n">%s</td><td class="n">%s</td></tr>'
                             % (esc(_z), _ph, fmt_int(_m[0]), fmt_int(_m[1]),
                                fmt_int(_m[2]),
                                "-" if _m[3] is None else _m[3], _pc(_m[4])))
            _dp = ("%+.2f%%" % (_fe[4] - _fb[4])
                   if (_fe[4] is not None and _fb[4] is not None) else "-")
            parts.append('<tr><td>%s</td><td>Delta</td><td class="n">%+d</td>'
                         '<td class="n">%+d</td><td class="n">%+d</td>'
                         '<td class="n">-</td><td class="n">%s</td></tr>'
                         % (esc(_z), _fe[0] - _fb[0], _fe[1] - _fb[1],
                            _fe[2] - _fb[2], _dp))
        parts.append('</table>')
        note("Order n = one free block of 2^n contiguous pages (2MB = order 9 "
             "at 4KB base pages); /proc/buddyinfo counts BLOCKS, so every cell "
             "above is blocks * 2^order = PAGES. Everything is per zone: a "
             "block can never span zones, so a node-wide average would hide the "
             "fragmented zone. "
             "External fragmentation = 1 - (free pages available as 2MB+ blocks "
             "/ the zone's free pages): 0% means every free page of that zone is "
             "in a 2MB+ chunk, 100% means no 2MB block can be formed there "
             "without compaction. '2MB blocks' counts order 9 blocks obtainable "
             "by splitting bigger ones (one order 10 block = two order 9).")

    sub("Memory / Paging")
    parts.append('<table class="t"><tr><th>Metric</th><th class="n">Total</th>'
                 '<th class="n">Per Second</th></tr>')
    vm = osd.get("vm", {})
    dur_os = osd.get("dur", 1.0) or 1.0
    def vmrow(label, key):
        _v = vm.get(key, 0.0)
        _hi = VM_HI.get(key)
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n%s">%s</td></tr>'
                     % (esc(label), fmt_num(_v * dur_os),
                        thr_cell_cls(_v, *_hi) if _hi else "", fmt_num(_v)))
    vmrow("Page In (pgpgin)", "pgpgin")
    vmrow("Page Out (pgpgout)", "pgpgout")
    vmrow("Swap In (pswpin)", "pswpin")
    vmrow("Swap Out (pswpout)", "pswpout")
    vmrow("Minor Fault (pgfault)", "pgfault")
    vmrow("Major Fault (pgmajfault)", "pgmajfault")
    parts.append('</table>')
    if os_smp is not None:
        parts.append(osmin_mem_table(os_smp, m.get("begin_ts", "")))
    sub("Disk I/O per device")
    _dmeta = osd.get("disk_meta") or {}
    _dh = '<th>Device</th>'
    if _dmeta:
        _dh += ('<th class="n">Size</th><th class="n">Type</th><th class="n">Rot</th>'
                '<th class="n">Sched</th><th class="n">QDepth</th><th class="n">NR_RQ</th><th class="n">WC</th>')
    _dh += ('<th class="n">Reads per Sec</th><th class="n">Writes per Sec</th><th class="n">Read B per Sec</th>'
            '<th class="n">Write B per Sec</th>')
    if osd.get("discard_supported"):
        _dh += '<th class="n">Dscrd per Sec</th><th class="n">Dscrd B per Sec</th><th class="n">Flush per Sec</th>'
    _dh += ('<th class="n">avg r_await (ms)</th><th class="n">avg w_await (ms)</th>'
            '<th class="n">avgqu-sz</th><th class="n">%util</th></tr>')
    parts.append('<table class="t"><tr>' + _dh)
    disks = osd.get("disks", [])
    ddur = osd.get("dur", 1.0) or 1.0
    if not disks:
        _ncols = 1 + (7 if _dmeta else 0) + 4 + (3 if osd.get("discard_supported") else 0) + 4
        parts.append('<tr><td colspan="%d" class="note">no active disk devices</td></tr>' % _ncols)
    for d in disks:
        _rav = d.get("r_await_ms", 0.0) if d.get("read_iops", 0) > 0 else None
        _wav = d.get("w_await_ms", 0.0) if d.get("write_iops", 0) > 0 else None
        ra = "-" if _rav is None else "%.2f" % _rav
        wa = "-" if _wav is None else "%.2f" % _wav
        row = '<tr><td>%s</td>' % esc(d["name"])
        if _dmeta:
            row += ''.join('<td class="n">%s</td>' % esc(c) for c in disk_meta_cells(d["name"], _dmeta))
        row += ('<td class="n">%.1f</td><td class="n">%.1f</td><td class="n">%s</td><td class="n">%s</td>'
                % (d.get("read_iops", 0), d.get("write_iops", 0),
                   fmt_bytes(d.get("read_bytes", 0) / ddur), fmt_bytes(d.get("write_bytes", 0) / ddur)))
        if osd.get("discard_supported"):
            row += '<td class="n">%.1f</td><td class="n">%s</td><td class="n">%.1f</td>' % (
                   d.get("discard_iops") or 0.0, fmt_bytes((d.get("discard_bytes") or 0) / ddur),
                   d.get("flush_iops") or 0.0)
        row += '<td class="n%s">%s</td><td class="n%s">%s</td>' % (lat_cell_cls(_rav), ra, lat_cell_cls(_wav), wa)
        _u = d.get("util_pct"); _q = d.get("avgqu_sz")
        row += '<td class="n">%s</td><td class="n">%s</td></tr>' % (
            ("%.2f" % _q) if _q is not None else "-",
            ("%.1f%%" % _u) if _u is not None else "-")
        parts.append(row)
    parts.append('</table>')
    if os_smp is not None:
        parts.append(osmin_disk_table(os_smp, m.get("begin_ts", "")))
    _fsu = filesystem_usage_html(win)
    if _fsu:
        sub("Filesystem Usage")
        parts.append(_fsu)
    # Bond devices: collected from /proc/net/bonding at the END snapshot
    # (name|mode|active slave|slave list). Heading always present, table only
    # when a bond exists -- sits right above the per-interface table.
    sub("Bond")
    _brows = []
    for _ln in (win["os"].get(("end", "bonding"), "") or "").strip().splitlines():
        _f = _ln.split("|")
        if len(_f) >= 3:
            _brows.append('<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>'
                          % (esc(_f[0]), esc(_f[1] or "-"), esc(_f[2] or "-"),
                             esc((_f[3] if len(_f) > 3 else "").replace(",", ", ") or "-")))
    if _brows:
        parts.append('<table class="t"><tr><th>Bond</th><th>Mode</th>'
                     '<th>Active Slave</th><th>Slave Interfaces</th></tr>'
                     + "".join(_brows) + '</table>')
    else:
        # explicit, not silent: heading without a body reads as "not sampled"
        # (user 2026-10-30) -- say it: this host has no bond devices
        parts.append('<div class="note">no bond devices on this host</div>')
    sub("Network per interface")
    dur_os = osd.get("dur", 1.0) or 1.0
    def nrate(it, key):
        return it.get(key, 0.0) / dur_os
    _nmeta = osd.get("net_meta") or {}
    # RX Missed as a COLUMN of this table (user 2026-10-30: no standalone
    # section): rx_missed_errors window delta from the per-minute netmiss
    # samples -- the ring-full SUBSET of the merged RX drop. Column present
    # only when the window has netmiss samples (old snaps: no column);
    # '-' = this iface is not netmiss-sampled (sampler skips lo/veth/...) or
    # has a single sample (a lifetime counter is not a window delta).
    _md = {}
    if os_smp is not None:
        _mm = {}
        for _, _p in os_smp.get("netmiss", []):
            _f = _p.split(",")
            if len(_f) == 2 and _f[1].strip().isdecimal():
                _mm.setdefault(_f[0], []).append(int(_f[1]))
        for _if, _vals in _mm.items():
            _md[_if] = (max(0, _vals[-1] - _vals[0]) if len(_vals) >= 2 else None)
    _nh = '<th>Interface</th><th class="n">RX B per Sec</th><th class="n">TX B per Sec</th><th class="n">RX Pkt per Sec</th><th class="n">TX Pkt per Sec</th><th class="n">RX/TX Errs (Delta)</th><th class="n">RX/TX Drop (Delta)</th>'
    if _md:
        _nh += '<th class="n">RX Missed (Delta)</th>'
    if _nmeta:
        _nh += '<th class="n">RX Util %</th><th class="n">TX Util %</th><th class="n">Speed</th><th class="n">Duplex</th><th class="n">Queues</th><th class="n">RX Ring</th><th class="n">TX Ring</th>'
    _nh += '</tr>'
    ifaces = osd.get("ifaces", [])
    if ifaces:
        _nl = ["errs/drop (delta) = whole-window cumulative deltas, not rates; errs usually "
               "mean driver or negotiation faults, drops mean ring-buffer or backlog "
               "exhaustion (consider larger ethtool ring buffers or more queues)."]
        if _md:
            _nl.append("RX Missed (Delta) = the rx_missed_errors subset of RX drop "
                       "(receive ring full); '-' = iface not sampled or single sample.")
        if _nmeta:
            _nl.append("RX/TX Util% = traffic vs the negotiated link speed ('-' when "
                       "unknown, e.g. virtio); Speed/Duplex/Queues/Ring from ethtool "
                       "at the END snap.")
        note("\n".join(_nl))
    parts.append('<table class="t"><tr>' + _nh)
    if not ifaces:
        parts.append('<tr><td colspan="%d" class="note">no network interfaces</td></tr>'
                     % (7 + (1 if _md else 0) + (7 if _nmeta else 0)))
    for it in ifaces:
        row = '<tr><td>%s</td><td class="n">%.0f</td><td class="n">%.0f</td><td class="n">%.1f</td><td class="n">%.1f</td><td class="n">%.0f / %.0f</td><td class="n">%.0f / %.0f</td>' % (
                         esc(it["name"]), nrate(it, "rx_bytes"), nrate(it, "tx_bytes"),
                         nrate(it, "rx_packets"), nrate(it, "tx_packets"),
                         it.get("rx_errs", 0.0), it.get("tx_errs", 0.0),
                         it.get("rx_drop", 0.0), it.get("tx_drop", 0.0))
        if _md:
            _mv = _md.get(it["name"])
            row += '<td class="n">%s</td>' % ("-" if _mv is None else "%d" % _mv)
        if _nmeta:
            # utilization vs negotiated link speed; '-' when speed unknown (virtio)
            _sp = speed_mbps(_cell(_nmeta.get(it["name"]) or {}, "speed"))
            _ru = "%.1f" % (nrate(it, "rx_bytes") * 8.0 / (_sp * 1e6) * 100.0) if _sp else "-"
            _tu = "%.1f" % (nrate(it, "tx_bytes") * 8.0 / (_sp * 1e6) * 100.0) if _sp else "-"
            row += '<td class="n">%s</td><td class="n">%s</td>' % (_ru, _tu)
            row += ''.join('<td class="n">%s</td>' % esc(c) for c in net_meta_cells(it["name"], _nmeta))
        row += '</tr>'
        parts.append(row)
    parts.append('</table>')
    if os_smp is not None:
        parts.append(osmin_net_table(os_smp, m.get("begin_ts", "")))
        # TCP Statistics as a REAL section (was buried in the net fold above)
        _tcptab = osmin_tcp_table(os_smp, m.get("begin_ts", ""))
        if _tcptab:
            sub("TCP Statistics")
            parts.append(_tcptab)

    # ---- TCP RTT / Connections: window gauges (per-minute ssrtt) + END-snap
    # per-conn tcp_info. Section hidden when neither source exists (snap(s)
    # predate the ssrtt sampler / no ss on the host). ----
    _rttser = ([(ts, d) for ts, d in os_minute_rtt_series(os_smp)
                if not m.get("begin_ts") or ts >= str(m.get("begin_ts"))]
               if os_smp is not None else [])
    _rttconns = parse_net_rtt(win["os"].get(("end", "net_rtt"), ""))
    if _rttser or _rttconns:   # peaks imply ssrtt rows, hence _rttser, too
        sub("TCP RTT / Connections")
        note("RTT = kernel smoothed round-trip time (ss) per established non-loopback "
             "connection; bold >5 ms, red >20 ms.\n"
             "Top-10 tables show WINDOW PEAKS from per-minute sampling: a connection "
             "that stalled mid-window still appears even if it closed before the END "
             "snap.\n"
             "Send-Q = bytes queued unsent (limited by the receiver window or cwnd); "
             "cwnd = congestion window (in-flight limit the kernel allows).\n"
             "retr = retransmitted segments on that connection; RTTVar = RTT variance.\n"
             "rcv_rtt = receive-side RTT (recv queue latency): rcv_rtt >> rtt means the "
             "peer is not reading its socket (large result-set pull stalled).\n"
             "min_rtt = window-minimum RTT (path floor, no queueing): rtt >> min_rtt "
             "means the excess is local queueing, not distance.\n"
             "ss reports both only for sockets with sampled receive activity; '-' = "
             "not reported for that connection (not a zero measurement).")
        if _rttser:
            note("Per-stream throughput ceiling (Mathis) ~ 1.22*MSS*8 / (RTT * "
                 "sqrt(loss)) from this window's RTT and Retrans% -- how far ONE TCP "
                 "stream could go under that loss, not a measured rate.")
        _peaks = (window_peer_peaks(os_smp, m.get("begin_ts", ""))
                  if os_smp is not None else {})
        if _rttser:
            _conns_avg = sum(d["conns"] for _, d in _rttser) / len(_rttser)
            _conns_max = max(d["conns"] for _, d in _rttser)
            _rtt_avg = sum(d["rtt_avg"] for _, d in _rttser) / len(_rttser)
            _p95_max = max(d["rtt_p95"] for _, d in _rttser)
            _worst = max(_rttser, key=lambda r: r[1]["worst_rtt"])
            _ra_cls = thr_cell_cls(_rtt_avg, 5.0, 20.0)
            _rows = [
                '<tr><td>Conns (non-loopback, avg / max)</td>'
                '<td class="n">%.1f / %.0f</td></tr>' % (_conns_avg, _conns_max),
                '<tr><td>RTT avg (mean of minutes, ms)</td>'
                '<td class="n%s">%.3f</td></tr>' % (_ra_cls, _rtt_avg),
                '<tr><td>RTT p95 (max of minutes, ms)</td>'
                '<td class="n%s">%.3f</td></tr>' % (thr_cell_cls(_p95_max, 5.0, 20.0), _p95_max),
                '<tr><td>Worst peer (window)</td>'
                '<td class="n">%s @ %.3f ms</td></tr>'
                % (esc(_worst[1]["worst_peer"]), _worst[1]["worst_rtt"]),
            ]
            # Mathis per-stream ceiling ~ 1.22*MSS*8 / (RTT * sqrt(loss));
            # RTT from this window, loss from the window Retrans% -- a rough
            # "how far can ONE tcp stream go" signal, not a measured rate.
            _rp = (osd.get("tcp") or {}).get("retrans_pct")
            _msss = (sorted(d["mss"] for d in _peaks.values() if d.get("mss"))
                     or sorted(c["mss"] for c in _rttconns if c.get("mss"))
                     or [1448])
            _mss = _msss[len(_msss) // 2]
            if _rtt_avg > 0 and _rp is not None and _rp > 0:
                _ceil = 1.22 * _mss * 8 / ((_rtt_avg / 1000.0) * (_rp / 100.0) ** 0.5)
                _rows.append('<tr><td>Per-stream throughput ceiling (Mathis; '
                             'MSS %d, RTT %.3f ms, Retrans %.3f%%)</td>'
                             '<td class="n">%s/s</td></tr>'
                             % (_mss, _rtt_avg, _rp, fmt_bytes(_ceil)))
            elif _rtt_avg > 0:
                _rows.append('<tr><td>Per-stream throughput ceiling (Mathis)</td>'
                             '<td class="n">no loss in window</td></tr>')
            parts.append('<table class="t"><tr><th>Metric</th><th class="n">Value</th></tr>'
                         + "".join(_rows) + '</table>')
        if _peaks:
            # window peaks from per-minute sspeer rows: whoever spiked Send-Q
            # or had the worst RTT at ANY minute of the window, with the minute
            # it happened -- a mid-window stall that closed before the end snap
            # still shows up (unlike the END-snap fallback below)
            # rcv_rtt / min_rtt are conditional in ss -ti: a window may hold no
            # value at all (idle sockets; kernels <4.10 have no min_rtt at all)
            # -> drop that column instead of printing a wall of '-'. Decided per
            # column: rcv_rtt present but min_rtt never reported is common.
            _hasrcv = any((d["sq_rcv_rtt"] is not None or d["rtt_rcv_rtt"] is not None)
                          for _, d in _peaks.items())
            _hasmnr = any(d["min_rtt"] is not None for _, d in _peaks.items())
            def _peak_rows(items, mode):
                r = []
                for (peer, lport), d in items:
                    if mode == "sq":
                        _v, _vt, _o1, _o1v = d["max_sq"], d["sq_ts"], "RTT (ms)", d["sq_rtt"]
                        _o2, _o3 = d["sq_cwnd"], d["sq_retr"]
                        _vcell = ('<td class="n%s">%s</td>'
                                  % (thr_cell_cls(_v, 1048576.0, 10485760.0), fmt_num(_v)))
                    else:
                        _v, _vt, _o1, _o1v = d["max_rtt"], d["rtt_ts"], "Send-Q", d["rtt_sq"]
                        _o2, _o3 = d["rtt_cwnd"], d["rtt_retr"]
                        _vcell = ('<td class="n%s">%.3f</td>'
                                  % (thr_cell_cls(_v, 5.0, 20.0), _v))
                    # rcv_rtt must come from the SAME minute as the row's peak
                    _rcv = d["sq_rcv_rtt"] if mode == "sq" else d["rtt_rcv_rtt"]
                    _mnr = d["min_rtt"]
                    _extra = ""
                    if _hasrcv:
                        _extra += ('<td class="n%s">%s</td>'
                                   % (thr_cell_cls(_rcv, 5.0, 20.0) if _rcv is not None else "",
                                      ("%.3f" % _rcv) if _rcv is not None else "-"))
                    if _hasmnr:
                        _extra += ('<td class="n">%s</td>'
                                   % (("%.3f" % _mnr) if _mnr is not None else "-"))
                    r.append('<tr><td>%s</td><td class="n">%s</td>%s<td>%s</td>'
                             '<td class="n%s">%s</td><td class="n">%s</td><td class="n">%s</td>%s</tr>'
                             % (esc(peer), esc(lport), _vcell, esc(_vt),
                                thr_cell_cls(_o1v, 5.0, 20.0) if (_o1 == "RTT (ms)" and _o1v is not None) else "",
                                ("%.3f" % _o1v) if (_o1 == "RTT (ms)" and _o1v is not None)
                                else (fmt_num(_o1v) if _o1v is not None else "-"),
                                _o2 if _o2 is not None else "-",
                                _o3 if _o3 is not None else "-",
                                _extra))
                return "".join(r)
            _phdr = ('<table class="t"><tr><th>Peer</th><th>Local Port</th><th>Peak Send-Q</th>'
                     '<th>Peak Time</th><th>RTT at peak (ms)</th><th>Cwnd</th><th>Retr</th>'
                     + ('<th>rcv_rtt (ms)</th>' if _hasrcv else '')
                     + ('<th>min_rtt (ms)</th>' if _hasmnr else '') + '</tr>')
            _bysq = [(k, d) for k, d in sorted(_peaks.items(), key=lambda kv: -kv[1]["max_sq"])
                     if d["max_sq"] > 0][:10]
            if _bysq:
                parts.append('<div class="sub">Top 10 by Send-Q</div>')
                parts.append(_phdr + _peak_rows(_bysq, "sq") + '</table>')
            _phdr2 = ('<table class="t"><tr><th>Peer</th><th>Local Port</th><th>Peak RTT (ms)</th>'
                      '<th>Peak Time</th><th>Send-Q at peak</th><th>Cwnd</th><th>Retr</th>'
                      + ('<th>rcv_rtt (ms)</th>' if _hasrcv else '')
                     + ('<th>min_rtt (ms)</th>' if _hasmnr else '') + '</tr>')
            _byrtt = sorted(_peaks.items(), key=lambda kv: -kv[1]["max_rtt"])[:10]
            if _byrtt:
                parts.append('<div class="sub">Top 10 by RTT</div>')
                parts.append(_phdr2 + _peak_rows(_byrtt, "rtt") + '</table>')
        elif _rttconns:
            def _peer_rows(sel):
                r = []
                for c in sel:
                    r.append('<tr><td>%s</td><td class="n">%s</td><td class="n%s">%.3f</td>'
                             '<td class="n">%.3f</td><td class="n">%s</td><td class="n">%s</td>'
                             '<td class="n">%s</td></tr>'
                             % (esc(c["peer"]), esc(c["lport"]),
                                thr_cell_cls(c["rtt_ms"], 5.0, 20.0), c["rtt_ms"],
                                c["rttvar_ms"],
                                c["cwnd"] if c["cwnd"] is not None else "-",
                                c["retrans"] if c["retrans"] is not None else "-",
                                fmt_num(c["sendq"])))
                return "".join(r)
            _phdr = ('<table class="t"><tr><th>Peer</th><th>Local Port</th><th>RTT (ms)</th>'
                     '<th>RTTVar</th><th>Cwnd</th><th>Retr</th><th>Send-Q</th></tr>')
            parts.append('<div class="sub">Top 10 by Send-Q</div>')
            parts.append(_phdr + _peer_rows(sorted(_rttconns, key=lambda c: -c["sendq"])[:10]) + '</table>')
            parts.append('<div class="sub">Top 10 by RTT</div>')
            parts.append(_phdr + _peer_rows(sorted(_rttconns, key=lambda c: -c["rtt_ms"])[:10]) + '</table>')

    _sn = osd.get("softnet")
    if _sn is not None:
        sub("Softnet")
        note("dropped = RX packets discarded because the backlog was full (raise "
             "net.core.netdev_max_backlog / add queues).\n"
             "time_squeeze = softirq exhausted its budget and deferred the rest "
             "(consider RPS / IRQ affinity).")
        parts.append('<table class="t"><tr><th>Metric</th><th class="n">Total</th>'
                     '<th class="n">Per Second</th></tr>'
                     '<tr><td>Packets Processed</td><td class="n">%s</td><td class="n">%s</td></tr>'
                     '<tr><td>Dropped (Backlog Full)</td><td class="n%s">%s</td><td class="n">%s</td></tr>'
                     '<tr><td>Time Squeeze (Softirq Starved)</td><td class="n%s">%s</td><td class="n">%s</td></tr>'
                     '</table>'
                     % (fmt_num(_sn["packets"]), fmt_num(_sn["packets"] / dur_os),
                        thr_cell_cls(_sn["dropped"] / dur_os, 0, 100), fmt_num(_sn["dropped"]),
                        fmt_num(_sn["dropped"] / dur_os) if dur_os else "-",
                        thr_cell_cls(_sn["squeezed"] / dur_os, 0, 1000), fmt_num(_sn["squeezed"]),
                        fmt_num(_sn["squeezed"] / dur_os) if dur_os else "-"))

    if osd.get("netstat_ok"):
        sub("Network Protocol Errors")
        note("Rows = window deltas per counter; Per Second = delta / window; "
             "zero-delta rows grayed, core counters first.\n"
             "InErrs = bad segments received; RetransSegs = segments retransmitted "
             "out.\n"
             "ListenOverflows/ListenDrops = accept-queue overflow; Timeouts = RTO "
             "expirations (heavy loss).\n"
             "AbortOnData/Timeout/Close/Memory = who reset the connection and why.\n"
             "OFOQueue/OFODrop = out-of-order segments (path reordering).\n"
             "WantZeroWindowAdv/ToZeroWindowAdv = receiver application too slow to "
             "drain its socket.\n"
             "SACKReneging = receiver dropped data it had already SACKed (serious); "
             "MemoryPressures = TCP memory limits hit.")
        parts.append('<table class="t"><tr><th>Protocol</th><th>Counter</th>'
                     '<th class="n">Total</th><th class="n">Per Second</th></tr>')
        # Core rows
        dur_os = osd.get("dur", 1.0) or 1.0
        for proto, name, label, delta, ps in netstat_core_rows(win["os"], dur_os):
            _m = " class=\"n muted\"" if not delta else " class=\"n\""
            parts.append('<tr><td>%s</td><td>%s</td><td%s>%+.0f</td><td%s>%.3f</td></tr>'
                         % (esc(proto), esc(label), _m, delta or 0, _m, ps or 0.0))
        # Tail rows (non-core counters)
        for r in osd.get("netstat_errs", [])[:20]:
            _m = " class=\"n muted\"" if not r["delta"] else " class=\"n\""
            parts.append('<tr><td>%s</td><td>%s</td><td%s>%+.0f</td><td%s>%.3f</td></tr>'
                         % (esc(r["proto"]), esc(r["name"]), _m, r["delta"], _m, r["per_sec"]))
        parts.append('</table>')

    # ================= Kernel Messages (dmesg) =================
    # LAST SUB of OS Statistics (user 2026-09-17: not a standalone section).
    # Union of the window's incremental chunks, pattern-categorized (nine
    # layers). Constant rendering: events table / "no kernel errors" note /
    # "unavailable" (dmesg_restrict) note.
    _dml, _dmsts = load_dmesg_chunks(win, repl_dir)
    if _dmsts:
        sub("Kernel Messages (dmesg)")
        if "denied" in _dmsts and not _dml:
            note("unavailable (kernel.dmesg_restrict=1 -- the collector user "
                 "cannot read the ring buffer; ask the OS admin or relax the sysctl)")
        elif "nogawk" in _dmsts and not _dml:
            note("unavailable (this host's awk lacks mktime -- install gawk)")
        else:
            from datetime import datetime as _dt
            # NO per-line epoch window filter: the CHUNK TILING already
            # defines the window exactly (floor keeps chunks disjoint, snap
            # ts in (begin,end] selects members). dmesg -T times derive
            # from boottime+offset and go stale after ANY wall-clock step
            # (observed 204: +2min NTP correction silently dropped every
            # event); the displayed Time column keeps its native skew.
            # index-based two-pass: pass 1 = classification (keyword match /
            # reboot / continuation / separately-timestamped trace context,
            # same rules as before); pass 2 = +/-5 RAW-LINE CONTEXT around
            # each KEYWORD match -- the cause lines (SCSI FAILED Result,
            # sense data, memory state) carry no keywords of their own but
            # are the forensic context (user 2026-09-17). The chunks store
            # ALL lines, so this is render-only. Window-range guarantee
            # (user 2026-09-17): _dml IS the window's line set by chunk
            # tiling -- each incremental block holds only lines newer than
            # the previous snap's last line -- so a +/-5 neighbour can never
            # reach outside the snapshot window; the indices are bounded and
            # no epoch math is involved (dmesg -T skew-proof). Only the
            # first-ever FULL dump can predate its window (one-time edge).
            _mark = {}      # idx -> (category, is_context, display_text)
            _prev_cat = None
            for _i, (_e, _text, _cont) in enumerate(_dml):
                if _DMESG_EXCLUDE.search(_text):
                    _prev_cat = None
                    continue
                if _cont:
                    if _prev_cat is not None:
                        _mark[_i] = (_prev_cat, False, _text)
                    continue
                if _DMESG_REBOOT.match(_text):
                    _cat, _disp = "Kernel crash", "SYSTEM REBOOT: " + _text[:90]
                else:
                    _cat, _disp = None, _text
                    for _c, _pat in _DMESG_PATTERNS:
                        if re.search(_pat, _text, re.I):
                            _cat = _c
                            break
                if _cat is None and _prev_cat is not None \
                        and _DMESG_CONTEXT.search(_text):
                    _mark[_i] = (_prev_cat, False, _text)
                    continue
                _prev_cat = _cat
                if _cat is not None:
                    _mark[_i] = (_cat, False, _disp)
            for _i in [k for k, v in _mark.items() if not v[1]]:
                for _j in range(max(0, _i - 5), min(len(_dml), _i + 6)):
                    if _j in _mark:
                        continue
                    _t = _dml[_j][1]
                    if _DMESG_EXCLUDE.search(_t):
                        continue
                    _mark[_j] = (_mark[_i][0], True, _t)
            _rows = [(_dml[_i][0], _c, _ctx, _t)
                     for _i, (_c, _ctx, _t) in sorted(_mark.items())]
            if _rows:
                parts.append('<table class="t"><tr><th>Time</th><th>Category</th>'
                             '<th>Message</th></tr>')
                for _e, _c, _ctx, _t in _rows[:50]:
                    _cl = ' class="muted"' if _ctx else ''
                    parts.append('<tr><td%s>%s</td><td%s>%s</td><td%s>%s</td></tr>'
                                 % (_cl, _dt.fromtimestamp(_e).strftime("%Y-%m-%d %H:%M:%S"),
                                    _cl, esc(_c), _cl, esc(_t[:200])))
                parts.append('</table>')
                if len(_rows) > 50:
                    note("%d more matching kernel messages suppressed (window total %d)"
                         % (len(_rows) - 50, len(_rows)))
            else:
                note("no kernel errors in this window")
            if _dml and ("denied" in _dmsts or "nogawk" in _dmsts):
                note("partial: some snapshot(s) in this window could not read "
                     "the kernel buffer (dmesg_restrict/awk) -- events from "
                     "those intervals are missing")

    # ================= Time Model System Stats =================
    sec("Time Model System Stats")
    it_keys = sorted(IT.keys(), key=lambda k: IT[k].get("value", 0.0), reverse=True)
    parts.append('<table class="t"><tr><th>Stat</th><th class="n">Time (s)</th>'
                 '<th class="n">% DB time</th></tr>')
    if not it_keys:
        parts.append('<tr><td colspan="3" class="note">no data</td></tr>')
    for k in it_keys:
        v = IT[k].get("value", 0.0)
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%.2f%%</td></tr>'
                     % (esc(k), s_of(v), pct(v, dbt)))
    parts.append('</table>')

    # ================= Load Profile =================
    def _dbsum(phase, col):
        # template0/1 excluded (same convention as the commits aggregation and
        # awrdiff's LP -- system activity in template DBs is noise)
        _rows = [r for r in win["db"].get((phase, "database"), [])
                 if r.get("datname") not in ("template0", "template1")]
        return sum(to_num(r.get(col, 0) or 0) for r in _rows)
    def _dbval(phase, dn, col):
        for r in win["db"].get((phase, "database"), []):
            if r.get("datname") == dn:
                return to_num(r.get(col, 0) or 0)
        return 0.0
    def _lsn_to_int(lsn):
        try:
            hi, lo = (lsn or "").split("/")
            return (int(hi, 16) << 32) + int(lo, 16)
        except Exception:
            return 0
    def _pwlsn(phase, col):
        return sum(_lsn_to_int(r.get(col, "")) for r in win["db"].get((phase, "pagewriter"), []))
    def _pwlsn_str(phase, col):
        _rows = win["db"].get((phase, "pagewriter"), [])
        if not _rows:
            return ""
        if len(_rows) == 1:
            return _rows[0].get(col, "")
        return "%s (+%d nodes)" % (_rows[0].get(col, ""), len(_rows) - 1)
    sec("Load Profile")
    if dbt < 0 or commits < 0 or blks_read < 0 or tup_ret < 0:
        note("WARNING: negative delta detected (cumulative counter end < begin) — possible counter reset/wraparound; values in this report may be unreliable.")
    parts.append('<table class="t"><tr><th>Metric</th>'
                 '<th class="n">Begin</th><th class="n">End</th>'
                 '<th class="n">Delta Total</th><th class="n">Delta Per Second</th></tr>')
    def lp(label, col, blocks=False):
        _b = _dbsum("begin", col); _e = _dbsum("end", col); _d = _e - _b
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td></tr>'
                     % (esc(label), fmt_int(_b), fmt_int(_e),
                        fmt_blocks(_d) if blocks else fmt_int(_d),
                        fmt_blocks_ps((_d / duration) if duration else 0.0) if blocks
                        else fmt_rate((_d / duration) if duration else 0.0)))
    # logical reads = buffer hits + disk reads (the combined convention);
    # physical reads = blocks read off disk. Bare professional labels, no raw
    # counter suffixes; SQL calls sits directly under rollbacks (user 2026-10-15)
    def lp2(label, cols, blocks=False):
        _b = sum(_dbsum("begin", c) for c in cols); _e = sum(_dbsum("end", c) for c in cols)
        _d = _e - _b
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td></tr>'
                     % (esc(label), fmt_int(_b), fmt_int(_e),
                        fmt_blocks(_d) if blocks else fmt_int(_d),
                        fmt_blocks_ps((_d / duration) if duration else 0.0) if blocks
                        else fmt_rate((_d / duration) if duration else 0.0)))
    lp2("logical reads", ("blks_hit", "blks_read"), blocks=True)
    lp2("physical reads", ("blks_read",), blocks=True)
    lp("rows returned", "tup_returned")
    lp("rows fetched", "tup_fetched")
    lp("rows inserted", "tup_inserted")
    lp("rows updated", "tup_updated")
    lp("rows deleted", "tup_deleted")
    lp("commits", "xact_commit")
    lp("rollbacks", "xact_rollback")
    # ---- SQL calls (dbe_perf.statement n_calls sum; Per Second = QPS) ----
    _scb = win["db"].get(("begin", "statement"), [])
    _sce = win["db"].get(("end", "statement"), [])
    _sc_ok = bool(_scb or _sce)
    _sc_b = sum(to_num(r.get("n_calls", 0) or 0) for r in _scb)
    _sc_e = sum(to_num(r.get("n_calls", 0) or 0) for r in _sce)
    _sc_d = _sc_e - _sc_b
    parts.append('<tr><td>SQL calls</td><td class="n">%s</td><td class="n">%s</td>'
                 '<td class="n">%s</td><td class="n">%s</td></tr>'
                 % (fmt_int(_sc_b) if _sc_ok else "-",
                    fmt_int(_sc_e) if _sc_ok else "-",
                    fmt_int(_sc_d) if _sc_ok else "-",
                    # fmt_rate: K/M/B tiers like the lp() rows, sub-1 QPS
                    # keeps its decimals
                    fmt_rate(_sc_d / duration) if (_sc_ok and duration) else "-"))
    if _sc_d < 0:
        note("WARNING: negative SQL calls delta — possible unique-SQL stats reset "
             "(instr_unique_sql_count change / reset).")
    lp("deadlocks", "deadlocks")
    lp("conflicts", "conflicts")
    lp("temp bytes", "temp_bytes")
    if "standby" in str(m.get("db_role", "")):
        # standby writes no local WAL (its xlog insert lsn sits at a static
        # near-zero) -- show replay progress from the standby's own
        # walreceiver instead; "-" when a side has no walreceiver row (old
        # snaps, or a window that spans a promote)
        _wrr = lambda ph: win["db"].get((ph, "walreceiver"), [])
        _wrb, _wre = _wrr("begin"), _wrr("end")
        if _wrb and _wre:
            _wr_bs = _wrb[0].get("receiver_replay_location", "") or "-"
            _wr_es = _wre[0].get("receiver_replay_location", "") or "-"
            _wr_d = (sum(_lsn_to_int(r.get("receiver_replay_location", "")) for r in _wre)
                     - sum(_lsn_to_int(r.get("receiver_replay_location", "")) for r in _wrb))
            parts.append('<tr><td>WAL replayed</td><td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td><td class="n">%s</td></tr>'
                         % (esc(_wr_bs), esc(_wr_es), fmt_bytes(_wr_d), fmt_bytes((_wr_d / duration) if duration else 0.0)))
        else:
            parts.append('<tr><td>WAL replayed</td><td class="n">-</td><td class="n">-</td>'
                         '<td class="n">-</td><td class="n">-</td></tr>')
    else:
        # ★双侧存在性守卫 (2026-11-26, 与本函数 standby 分支/WAL replayed 同形态):
        #   begin 侧无 pagewriter 行(混代窗口: patch_win_pagewriter_from_pw 遇
        #   混代早退不合成)时, 老写法 begin 按 0 ⇒ delta = END 的 LSN 绝对位置
        #   (几十 GB 级假增量)。缺任一侧 → 整行 '-'。
        _wprb = win["db"].get(("begin", "pagewriter"), [])
        _wpre = win["db"].get(("end", "pagewriter"), [])
        # ★双保险: 行在但 LSN 全空(极端: pw 日志行本身缺 LSN)也按缺侧印 '-',
        #   不再产 0-0=0 B 的假"WAL 没写"
        _wlsn_ok = (any(r.get("current_xlog_insert_lsn") for r in _wprb)
                    and any(r.get("current_xlog_insert_lsn") for r in _wpre))
        if _wprb and _wpre and _wlsn_ok:
            _wal_bs = _pwlsn_str("begin", "current_xlog_insert_lsn"); _wal_es = _pwlsn_str("end", "current_xlog_insert_lsn")
            _wal_d = _pwlsn("end", "current_xlog_insert_lsn") - _pwlsn("begin", "current_xlog_insert_lsn")
            parts.append('<tr><td>WAL written</td><td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td><td class="n">%s</td></tr>'
                         % (esc(_wal_bs), esc(_wal_es), fmt_bytes(_wal_d), fmt_bytes((_wal_d / duration) if duration else 0.0)))
        else:
            parts.append('<tr><td>WAL written</td><td class="n">-</td><td class="n">-</td>'
                         '<td class="n">-</td><td class="n">-</td></tr>')
    # ---- WAL writes + pagewriter flushes (v2.4.5; the old 'pagewriter written
    # (ckpt_redo_point)' line measured an LSN POSITION, not pages -- removed) ----
    _lpw_neg = False
    for _lbl, _b, _e, _d, _ps, _ok, _by, _pg in loadprofile_wal_pw_rows(win, duration):
        if not _by and not _pg and "physical standby" in (m.get("db_role") or ""):
            _lbl = _lbl + " (primary only)"
        _cf = fmt_blocks if _pg else (fmt_bytes if _by else fmt_int)
        _pf = fmt_blocks_ps if _pg else (fmt_bytes if _by else fmt_rate)
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td></tr>'
                     % (esc(_lbl),
                        fmt_int(_b) if _ok else '-',
                        fmt_int(_e) if _ok else '-',
                        _cf(_d) if _ok else '-',
                        _pf(_ps) if _ok else '-'))
        # ★负值告警须 _ok 门控 (2026-11-27 复核): 反向混代窗(end 侧缺表)时
        #   _d=-_b<0 但行已印 '-', 不门控会独发"counter reset (switchover/
        #   promote)"误导——无数据不该暗示主备切换
        if _ok and _d < 0:
            _lpw_neg = True
    if _lpw_neg:
        note("WARNING: negative delta in WAL/pagewriter counters — possible counter reset (switchover/promote); these rows may be unreliable.")
    for _lbl, _b, _e, _d, _ps, _md, _ok in loadprofile_iostat_rows(win, duration):
        _cf = (fmt_blocks if _md == "blocks" else fmt_int) if _ok else (lambda v: "-")
        _pf = (fmt_blocks_ps if _md == "blocks" else fmt_rate) if _ok else (lambda v: "-")
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td></tr>'
                     % (esc(_lbl), fmt_int(_b) if _ok else "-", fmt_int(_e) if _ok else "-",
                        _cf(_d), _pf(_ps)))
    parts.append('</table>')

    # ================= Cache Hit Ratio =================
    sec("Cache Hit Ratio")
    parts.append('<table class="t"><tr><th>Database</th>'
                 '<th class="n">Begin Hit%</th><th class="n">End Hit%</th>'
                 '<th class="n">Window Hit%</th></tr>')
    _cr_dns = set()
    for _ph in ("begin", "end"):
        for _r in win["db"].get((_ph, "database"), []):
            if _r.get("datname") and _r.get("datname") not in ("template0", "template1"):
                _cr_dns.add(_r.get("datname"))
    _cr_items = []
    for _dn in _cr_dns:
        _bhb = _dbval("begin", _dn, "blks_hit"); _brb = _dbval("begin", _dn, "blks_read")
        _bhe = _dbval("end", _dn, "blks_hit"); _bre = _dbval("end", _dn, "blks_read")
        _tb = _bhb + _brb; _te = _bhe + _bre
        if _tb <= 0 and _te <= 0:
            continue
        _rb = (_bhb / _tb * 100.0) if _tb else 0.0
        _re = (_bhe / _te * 100.0) if _te else 0.0
        # window ratio from deltas: cumulative ratios dilute months of history
        # and their diff (~0.01%) hides real degradation inside this window
        _dh = _bhe - _bhb; _dr = _bre - _brb; _dt = _dh + _dr
        _rw = (_dh / _dt * 100.0) if (_dt > 0 and _dh >= 0) else None
        _cr_items.append((_dn, _rb, _re, _te, _rw))
    _cr_items.sort(key=lambda x: x[3], reverse=True)
    if not _cr_items:
        parts.append('<tr><td colspan="4" class="note">no data</td></tr>')
    for _dn, _rb, _re, _, _rw in _cr_items:
        _rws = ('%.2f%%' % _rw) if _rw is not None else '-'
        parts.append('<tr><td>%s</td><td class="n">%.2f%%</td><td class="n">%.2f%%</td>'
                     '<td class="n">%s</td></tr>' % (esc(_dn), _rb, _re, _rws))
    parts.append('</table>')

    # ================= Database Memory (vb_tool mem style) =================
    sec("Database Memory")
    def qtable(label, sql):
        sub(label)
        _rows = psql_query(sql)
        if not _rows:
            parts.append('<div class="note">no data</div>')
            return
        _cols = list(_rows[0].keys())
        parts.append('<table class="t"><tr>' + ''.join('<th>%s</th>' % esc(c) for c in _cols) + '</tr>')
        for _r in _rows:
            parts.append('<tr>' + ''.join('<td>%s</td>' % esc(_r.get(c, "")) for c in _cols) + '</tr>')
        parts.append('</table>')
    def be_table(label, begin_rows, end_rows, key_col, val_col, fmt_fn, top=None,
                 key_header=None, cnt_col=None, key_norm=None):
        sub(label)
        _b = {}; _e = {}; _bc = {}; _ec = {}
        for _r in begin_rows:
            try:
                _k = key_norm(_r.get(key_col, "")) if key_norm else _r.get(key_col, "")
                _b[_k] = _b.get(_k, 0) + to_num(_r.get(val_col, 0) or 0)
                if cnt_col: _bc[_k] = _bc.get(_k, 0) + to_num(_r.get(cnt_col, 0) or 0)
            except Exception: pass
        for _r in end_rows:
            try:
                _k = key_norm(_r.get(key_col, "")) if key_norm else _r.get(key_col, "")
                _e[_k] = _e.get(_k, 0) + to_num(_r.get(val_col, 0) or 0)
                if cnt_col: _ec[_k] = _ec.get(_k, 0) + to_num(_r.get(cnt_col, 0) or 0)
            except Exception: pass
        if top:
            # full outer join: end top-N + begin top-N (end-first, dedup).
            # begin value for an end-only-top context is looked up from full _b.
            _E_top = sorted(_e.keys(), key=lambda _k: _e.get(_k, 0), reverse=True)[:top]
            _B_top = sorted(_b.keys(), key=lambda _k: _b.get(_k, 0), reverse=True)[:top]
            _keys = list(dict.fromkeys(_E_top + _B_top))
        else:
            _keys = sorted(set(_b) | set(_e), key=lambda _k: max(_e.get(_k, 0), _b.get(_k, 0)), reverse=True)
        _hdr = '<table class="t"><tr><th>%s</th>' % esc(key_header or key_col)
        if cnt_col:
            _hdr += '<th class="n">Begin cnt</th><th class="n">End cnt</th>'
        _hdr += '<th class="n">Begin Size</th><th class="n">End Size</th><th class="n">Delta Size</th></tr>'
        _cspan = 6 if cnt_col else 4
        parts.append(_hdr)
        if not _keys:
            parts.append('<tr><td colspan="%d" class="note">no data</td></tr>' % _cspan)
        for _k in _keys:
            _bv = _b.get(_k, 0); _ev = _e.get(_k, 0)
            _cells = '<td>%s</td>' % esc(_k)
            if cnt_col:
                _cells += '<td class="n">%s</td><td class="n">%s</td>' % (
                    fmt_int(_bc.get(_k, 0)), fmt_int(_ec.get(_k, 0)))
            _cells += '<td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>' % (
                fmt_fn(_bv), fmt_fn(_ev), fmt_fn(_ev - _bv))
            parts.append('<tr>' + _cells + '</tr>')
        parts.append('</table>')
    qtable("Memory GUCs",
           "SELECT name, decode(unit,'8kB',concat(setting*8,'kB'),concat(setting,COALESCE(unit,' '))) AS setting "
           "FROM pg_settings WHERE name IN ("
           "'maintenance_work_mem','work_mem','shared_buffers','max_process_memory',"
           "'wal_buffers','effective_cache_size','cstore_buffers','segment_buffers',"
           "'temp_buffers','local_syscache_threshold','max_connections') ORDER BY name")
    be_table("Total Memory by Type",
             win["db"].get(("begin", "memory_node_detail"), []),
             win["db"].get(("end", "memory_node_detail"), []),
             "memorytype", "mb", lambda v: fmt_bytes(v * 1024 * 1024),
             key_header="memory type")
    be_table("Top 10 Shared Memory Context",
             win["db"].get(("begin", "shared_memory"), []),
             win["db"].get(("end", "shared_memory"), []),
             "contextname", "total", fmt_bytes, top=10, cnt_col="cnt")
    be_table("Top 10 Session Memory Context",
             win["db"].get(("begin", "session_memory"), []),
             win["db"].get(("end", "session_memory"), []),
