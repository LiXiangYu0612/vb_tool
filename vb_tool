            sub("Replication Slots")
            parts.append(slots_subtable_html(
                load_slot_samples(repl_dir, m.get("begin_ts", ""), m.get("end_ts", ""))))

    # ================= Top 10 Foreground Events =================
    sec("Top 10 Wait Events by Total Wait Time")
    note("% DB time = event wait time / DB_TIME (can exceed 100% with parallel sessions).\n"
         "Idle/non-wait events (wait cmd, none) are excluded.")
    parts.append('<table class="t"><tr><th>Event</th><th>Class</th><th class="n">Waits</th>'
                 '<th class="n">Total Wait Time (s)</th><th class="n">Avg wait (ms)</th>'
                 '<th class="n">% DB time</th></tr>')
    if not we_sorted:
        parts.append('<tr><td colspan="6" class="note">no data</td></tr>')
    for k in we_sorted[:10]:
        d = WE[k]; w = d.get("wait", 0.0); t = d.get("total_wait_time", 0.0)
        cls_ = (d.get("__row") or {}).get("type", "")
        avg = (t / w) if w else 0.0
