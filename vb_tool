                else:
                    _dv6 = _est[_dk] - _bst[_dk]
                    _fd = ("+" + fmt_int(_dv6)) if _dv6 else fmt_int(0)
            else:
                _fd = "-"
            h.append('<tr><td>io %s %s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td></tr>' % (esc(_dk[0]), esc(_dk[1]), _fb, _fe, _fd))
        # io throttle config (v1): static config rows when present
