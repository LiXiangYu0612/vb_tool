            h_node="" h_ver="" h_up=""
            s_tot="" s_act="" s_iit="" s_idle="" s_ltx="" s_avac="" s_smp="" s_jdbc=""
            w_io="" w_lock="" w_lwlock="" w_stat="" w_cpu=""
            m_used="" m_max="" m_shmax="" m_shused="" m_dyu="" m_dym="" m_dyp="" m_shr="" m_shrp="" m_other="" m_sbuf=""
            lk_chains="" lk_blocked="" lk_w_rel="" lk_w_xid="" lk_w_vxid="" lk_w_tuple="" lk_w_part=""
            ist_qps="" ist_cm="" ist_roll="" ist_tps="" ist_lg="" ist_ph="" ist_pw="" ist_rd="" ist_tp="" ist_dl=""
            while IFS= read -r line; do
                case "$line" in
                    ===HDR)  section=HDR; continue;;
                    ===SESS) section=SESS; continue;;
                    ===ISTAT) section=ISTAT; continue;;
                    ===WAIT) section=WAIT; continue;;
                    ===XLOG) section=XLOG; continue;;
                    ===REPL) section=REPL; continue;;
                    ===DBM)  section=DBM; continue;;
                    ===CTX)  section=CTX; continue;;
                    ===LKA)  section=LKA; continue;;
                    ===LWL)  section=LWL; continue;;
                    ===BLK)  section=BLK; continue;;
                    ===LTX)  section=LTX; continue;;
                    ===LTXC) section=LTXC; continue;;
                    # ★哨兵 (见上面 db= 那里的说明): 只用来证明"psql 把整段跑完了"。
