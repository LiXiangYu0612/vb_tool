            h.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td></tr>' % (esc(k), fb, fe, fd))
        # cpu.stat: split into per-counter rows (user 2026-10-31: every row
        # Begin/End/Delta -- nr_throttled / throttled_time deltas > 0 mean
        # the quota actually bit in this window; v2 throttled_usec likewise)
        def _statmap(d, key):
            out = {}
            for part in ((d or {}).get("kv", {}).get(key) or "").split(";"):
                if "=" in part:
