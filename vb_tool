                 % (esc(bm.get("hostname") or cm.get("hostname") or "?"),
                    esc(bm.get("vb_tool_version") or "?"), esc(metric_label)))
    parts.append("<div class='meta'><b>awr:</b> %s &nbsp;(%s → %s, %s)</div>"
                 % (esc(bm.get("name", "?")),
                    esc(bm.get("begin_ts", "?")), esc(bm.get("end_ts", "?")),
                    esc(bm.get("duration", "?"))))
    parts.append("<div class='meta'><b>current :</b> %s &nbsp;(%s → %s, %s)</div>"
                 % (esc(cm.get("name", "current")),
                    esc(cm.get("begin_ts", "?")), esc(cm.get("end_ts", "?")),
                    esc(cm.get("duration", "?"))))

    # ---- summary cards ----
    def inst_delta(win, name):
        rows = delta_rows(win, "instance_time", "stat_name", ["value"])
        return rows.get(name, {}).get("value", 0.0)
    bl_dbt = inst_delta(bl, "DB_TIME"); cur_dbt = inst_delta(cur, "DB_TIME")
    bl_cpu = inst_delta(bl, "CPU_TIME"); cur_cpu = inst_delta(cur, "CPU_TIME")
    bl_io = inst_delta(bl, "DATA_IO_TIME"); cur_io = inst_delta(cur, "DATA_IO_TIME")

    def dbrow(win):
        return delta_rows(win, "database", "datname",
                          ["xact_commit", "xact_rollback", "blks_read", "blks_hit",
                           "deadlocks", "tup_returned", "tup_fetched"])
    bdb = dbrow(bl); cdb = dbrow(cur)
    def agg(d, col):
        return sum((v.get(col, 0.0)) for v in d.values())
    bl_commits = agg(bdb, "xact_commit"); cur_commits = agg(cdb, "xact_commit")
    bl_blks = agg(bdb, "blks_read"); cur_blks = agg(cdb, "blks_read")

    bos = os_window_deltas(bl); cos = os_window_deltas(cur)

    def card(k, v, cls=""):
        parts.append("<div class='sumcard'><div class='k'>%s</div><div class='v %s'>%s</div></div>"
                     % (esc(k), cls, v))
    parts.append("<h2>Key Metrics</h2>")
    card("DB Time  base→cur", "%s → %s" % (fmt_us(bl_dbt), fmt_us(cur_dbt)),
         "worse" if cur_dbt > bl_dbt and bl_dbt > 0 else "")
    card("CPU Time base→cur", "%s → %s" % (fmt_us(bl_cpu), fmt_us(cur_cpu)))
    card("IO Time  base→cur", "%s → %s" % (fmt_us(bl_io), fmt_us(cur_io)))
    card("Commits  base→cur", "%s → %s" % (fmt_int(bl_commits), fmt_int(cur_commits)))
    card("blks_read base→cur", "%s → %s" % (fmt_int(bl_blks), fmt_int(cur_blks)))
    card("CPU busy %% base→cur", "%.1f%% → %.1f%%" % (bos["cpu_busy_pct"], cos["cpu_busy_pct"]))
    card("CPU iowait %% base→cur", "%.1f%% → %.1f%%" % (
         bos["cpu"].get("iowait", 0.0), cos["cpu"].get("iowait", 0.0)),
         "worse" if cos["cpu"].get("iowait", 0.0) - bos["cpu"].get("iowait", 0.0) > 1.0 else "")
    card("Net bytes base→cur", "%s → %s" % (fmt_bytes(bos["net_bytes"]), fmt_bytes(cos["net_bytes"])))

    # ---- Top SQL changes ----
    parts.append("<h2>Top SQL Changes (by current-window %s)</h2>" % esc(metric_label))
    bST = delta_rows(bl, "statement", "unique_sql_id",
                     ["n_calls", "db_time", "cpu_time", "data_io_time",
                      "n_blocks_fetched", "n_returned_rows"])
    cST = delta_rows(cur, "statement", "unique_sql_id",
                     ["n_calls", "db_time", "cpu_time", "data_io_time",
                      "n_blocks_fetched", "n_returned_rows"])
    keys = sorted(set(bST) | set(cST),
                  key=lambda k: cST.get(k, {}).get(metric_col, 0.0), reverse=True)
    parts.append("<table><tr><th>#</th><th>Query</th><th class='num'>calls base→cur</th>"
                 "<th class='num'>%s base→cur</th><th class='num'>per-call %s</th>"
                 "<th class='num'>CPU Time Δ</th><th class='num'>IO Time Δ</th>"
                 "<th class='num'>blocks Δ</th></tr>" % (esc(metric_label), esc(metric_label)))
    if not keys:
        parts.append("<tr><td colspan='8' class='muted'>no data</td></tr>")
    for i, k in enumerate(keys[:top_n], 1):
        b = bST.get(k); c = cST.get(k)
        # treat absent-in-window as zero deltas
        bd = b if b else {x: 0.0 for x in
                          ("n_calls", "db_time", "cpu_time", "data_io_time",
                           "n_blocks_fetched", "n_returned_rows")}
        cd = c if c else {x: 0.0 for x in
                          ("n_calls", "db_time", "cpu_time", "data_io_time",
                           "n_blocks_fetched", "n_returned_rows")}
        row = (c.get("__row") if c else b.get("__row")) or {}
        query = row.get("query", k)
        user = row.get("user_name", "")
        bcalls = bd["n_calls"]; ccalls = cd["n_calls"]
        bmt = bd[metric_col]; cmt = cd[metric_col]
        bpc = (bmt / bcalls) if bcalls > 0 else 0.0
        cpc = (cmt / ccalls) if ccalls > 0 else 0.0
        badge = ""
        if not b and c:
            badge = " <span class='new'>[NEW]</span>"
        elif b and not c:
            badge = " <span class='muted'>[GONE]</span>"
        # build each cell as a complete <td>...</td> string, then join — no giant %-template
        cells = []
        cells.append("<td>%d</td>" % i)
        cells.append("<td class='sql'>%s<br><span class='muted'>%s</span>%s</td>"
                     % (esc(trunc(query)), esc(user), badge))
        # calls base→cur (count, neutral)
        cells.append('<td class="num">%s → %s<br><span class="muted">%+s</span></td>'
                     % (fmt_int(bcalls), fmt_int(ccalls), fmt_int(ccalls - bcalls)))
        # metric base→cur (latency: red if worse) + muted Δ with multiplier
        cells.append('<td class="num %s">%s → %s<br><span class="muted">%s</span></td>' % (
            "worse" if cmt > bmt and bmt > 0 else "",
            fmt_us(bmt), fmt_us(cmt), esc(arrow_delta(bmt, cmt))))
        # per-call metric (latency: red if worse)
        cells.append('<td class="num %s">%s → %s</td>' % (
            "worse" if cpc > bpc and bpc > 0 else "",
            fmt_us(bpc), fmt_us(cpc)))
        # cpu / io deltas
        cells.append(delta_cell(bd["cpu_time"], cd["cpu_time"], "time"))
        cells.append(delta_cell(bd["data_io_time"], cd["data_io_time"], "time"))
        # blocks delta (count)
        cells.append('<td class="num">%+s</td>'
                     % fmt_int(cd["n_blocks_fetched"] - bd["n_blocks_fetched"]))
        parts.append("<tr>" + "".join(cells) + "</tr>")
    parts.append("</table>")

    # ---- Wait Events diff ----
    parts.append("<h2>Wait Events (window Δ)</h2>")
    bWE = delta_rows(bl, "wait_events", "event", ["wait", "total_wait_time"])
    cWE = delta_rows(cur, "wait_events", "event", ["wait", "total_wait_time"])
    we_keys = sorted(set(bWE) | set(cWE),
                     key=lambda k: cWE.get(k, {}).get("total_wait_time", 0.0), reverse=True)
    parts.append("<table><tr><th>Event</th><th>Type</th><th class='num'>waits base→cur</th>"
                 "<th class='num'>total wait time base→cur</th></tr>")
    if not we_keys:
        parts.append("<tr><td colspan='4' class='muted'>no data</td></tr>")
    for k in we_keys:
        b = bWE.get(k, {"wait": 0, "total_wait_time": 0, "__row": {}})
        c = cWE.get(k, {"wait": 0, "total_wait_time": 0, "__row": {}})
        etype = (c.get("__row") or b.get("__row") or {}).get("type", "")
        parts.append("<tr><td>%s</td><td>%s</td>%s%s</tr>" % (
            esc(k), esc(etype),
            '<td class="num">%s → %s</td>' % (fmt_int(b["wait"]), fmt_int(c["wait"])),
            delta_cell(b["total_wait_time"], c["total_wait_time"], "time")))
    parts.append("</table>")

    # ---- OS diff ----
    parts.append("<h2>System / OS (window Δ)</h2>")

    # --- CPU utilization breakdown ---
    parts.append("<h3 class='sub'>CPU utilization (%)</h3>")
    parts.append("<table><tr><th>Component</th><th class='num'>awr</th>"
                 "<th class='num'>current</th><th class='num'>Δ (pp)</th></tr>")
    def cpurow(label, field, warn_up=False):
        bv = bos["cpu"].get(field, 0.0); cv = cos["cpu"].get(field, 0.0)
        cls = " class='num bad'" if warn_up and (cv - bv) > 0.5 else " class='num'"
        parts.append("<tr><td>%s</td><td class='num'>%.1f%%</td><td class='num'>%.1f%%</td>"
                     "<td%s>%+.1f</td></tr>" % (esc(label), bv, cv, cls, cv - bv))
    cpurow("busy (usr+nice+sys+irq+softirq+steal)", "busy")
    cpurow("  user", "user")
    cpurow("  system", "system")
    cpurow("iowait", "iowait", warn_up=True)
    cpurow("irq",    "irq",    warn_up=True)
    cpurow("softirq", "softirq")
    cpurow("idle",   "idle")
    parts.append("</table>")

    # --- System rates ---
    parts.append("<h3 class='sub'>System rates (per second)</h3>")
    parts.append("<table><tr><th>Metric</th><th class='num'>awr</th>"
                 "<th class='num'>current</th><th class='num'>Δ</th></tr>")
    def srow(label, bv, cv, fmt):
        parts.append("<tr><td>%s</td><td class='num'>%s</td><td class='num'>%s</td>"
                     "<td class='num'>%+s</td></tr>" % (esc(label), fmt(bv), fmt(cv), fmt(cv - bv)))
    srow("context switches/s", bos.get("ctxt_per_sec",0), cos.get("ctxt_per_sec",0), lambda x: "%.0f" % x)
    srow("interrupts/s",      bos.get("intr_per_sec",0),  cos.get("intr_per_sec",0),  lambda x: "%.0f" % x)
    srow("procs_running (snapshot end)", bos.get("runq_end",0), cos.get("runq_end",0), lambda x: "%d" % int(x))
    parts.append("</table>")

    # --- Disk per device (current rate; Δ vs awr) ---
    parts.append("<h3 class='sub'>Disk I/O per device (current window rate; (Δ) vs awr)</h3>")
    bdd = {d["name"]: d for d in bos.get("disks", [])}
    cdd = {d["name"]: d for d in cos.get("disks", [])}
    parts.append("<table><tr><th>Device</th><th class='num'>read IOPS</th>"
                 "<th class='num'>write IOPS</th><th class='num'>read</th>"
                 "<th class='num'>written</th><th class='num'>await (ms)</th></tr>")
    def dcell(b, c, key, fmt):
        bv = b.get(key, 0.0); cv = c.get(key, 0.0)
        return "<td class='num'>%s <span class='muted'>(%+s)</span></td>" % (fmt(cv), fmt(cv - bv))
    for nm in sorted(set(bdd) | set(cdd)):
        b = bdd.get(nm, {}); c = cdd.get(nm, {})
        parts.append("<tr><td>%s</td>%s%s%s%s%s</tr>" % (
            esc(nm),
            dcell(b, c, "read_iops",  lambda x: "%.1f" % x),
            dcell(b, c, "write_iops", lambda x: "%.1f" % x),
            dcell(b, c, "read_bytes", fmt_bytes),
            dcell(b, c, "write_bytes",fmt_bytes),
            dcell(b, c, "await_ms",   lambda x: "%.2f" % x),
        ))
    parts.append("</table>")

    # --- Network per interface (current rate; Δ vs awr) ---
    parts.append("<h3 class='sub'>Network per interface (current window rate; (Δ) vs awr)</h3>")
    bni = {i["name"]: i for i in bos.get("ifaces", [])}
    cni = {i["name"]: i for i in cos.get("ifaces", [])}
    parts.append("<table><tr><th>Interface</th><th class='num'>rx B/s</th>"
                 "<th class='num'>tx B/s</th><th class='num'>rx pkt/s</th>"
                 "<th class='num'>tx pkt/s</th><th class='num'>rx/tx errs</th>"
                 "<th class='num'>rx/tx drop</th></tr>")
    bdur = bos.get("dur", 1.0); cdur = cos.get("dur", 1.0)
    def nrate(b, c, key, fmt):
        br = b.get(key, 0.0) / (bdur or 1.0)
        cr = c.get(key, 0.0) / (cdur or 1.0)
        return "%s <span class='muted'>(%+s)</span>" % (fmt(cr), fmt(cr - br))
    def npair(b, c, rxk, txk, fmt):
        return "%s / %s" % (nrate(b, c, rxk, fmt), nrate(b, c, txk, fmt))
    for nm in sorted(set(bni) | set(cni)):
        b = bni.get(nm, {}); c = cni.get(nm, {})
        parts.append("<tr><td>%s</td><td class='num'>%s</td><td class='num'>%s</td>"
                     "<td class='num'>%s</td><td class='num'>%s</td>"
                     "<td class='num'>%s</td><td class='num'>%s</td></tr>" % (
            esc(nm),
            nrate(b, c, "rx_bytes",   lambda x: "%.0f" % x),
            nrate(b, c, "tx_bytes",   lambda x: "%.0f" % x),
            nrate(b, c, "rx_packets", lambda x: "%.1f" % x),
            nrate(b, c, "tx_packets", lambda x: "%.1f" % x),
            npair(b, c, "rx_errs", "tx_errs", lambda x: "%.0f" % x),
            npair(b, c, "rx_drop", "tx_drop", lambda x: "%.0f" % x),
        ))
    parts.append("</table>")

    # --- Softirqs ---
    parts.append("<h3 class='sub'>Softirqs (window Δ, summed across CPUs)</h3>")
    bsf = bos.get("softirqs", {}); csf = cos.get("softirqs", {})
    cats = sorted(set(bsf) | set(csf), key=lambda k: abs(csf.get(k, 0.0)), reverse=True)
    parts.append("<table><tr><th>Category</th><th class='num'>awr</th>"
                 "<th class='num'>current</th><th class='num'>Δ</th></tr>")
    if not cats:
        parts.append("<tr><td colspan='4' class='muted'>no softirqs data</td></tr>")
    for cat in cats:
        bv = bsf.get(cat, 0.0); cv = csf.get(cat, 0.0)
        parts.append("<tr><td>%s</td><td class='num'>%s</td><td class='num'>%s</td>"
                     "<td class='num'>%+s</td></tr>" % (esc(cat), fmt_int(bv), fmt_int(cv), fmt_int(cv - bv)))
    parts.append("</table>")

    # ---- Instance time model diff ----
    parts.append("<h2>Instance Time Model (window Δ)</h2>")
    bIT = delta_rows(bl, "instance_time", "stat_name", ["value"])
    cIT = delta_rows(cur, "instance_time", "stat_name", ["value"])
    it_keys = sorted(set(bIT) | set(cIT),
                     key=lambda k: cIT.get(k, {}).get("value", 0.0), reverse=True)
    parts.append("<table><tr><th>Stat</th><th class='num'>awr</th><th class='num'>current</th>"
                 "<th class='num'>Δ</th></tr>")
    if not it_keys:
        parts.append("<tr><td colspan='4' class='muted'>no data</td></tr>")
    for k in it_keys:
        bv = bIT.get(k, {}).get("value", 0.0)
        cv = cIT.get(k, {}).get("value", 0.0)
        cls = "worse" if cv > bv and bv > 0 else ""
        parts.append("<tr><td>%s</td><td class='num'>%s</td><td class='num %s'>%s</td>"
                     "<td class='num %s'>%+s</td></tr>" % (
                         esc(k), fmt_us(bv), cls, fmt_us(cv), cls, fmt_us(cv - bv)))
    parts.append("</table>")

    # ---- DB-level stats diff ----
    parts.append("<h2>DB-level Stats (window Δ, summed over databases)</h2>")
    cols = [("xact_commit", "commits", "count"), ("xact_rollback", "rollbacks", "count"),
            ("blks_read", "blks_read", "count"), ("blks_hit", "blks_hit", "count"),
            ("deadlocks", "deadlocks", "count"), ("tup_returned", "tup_returned", "count"),
            ("tup_fetched", "tup_fetched", "count")]
    parts.append("<table><tr><th>Metric</th><th class='num'>awr</th><th class='num'>current</th>"
                 "<th class='num'>Δ</th></tr>")
    if not bdb and not cdb:
        parts.append("<tr><td colspan='4' class='muted'>no data</td></tr>")
    for col, label, kind in cols:
        bv = agg(bdb, col); cv = agg(cdb, col)
        # deadlocks are bad when increasing -> red
        cls = ""
        if col == "deadlocks" and cv > bv:
            cls = "worse"
        elif col == "xact_rollback" and cv > bv:
            cls = "worse"
        parts.append("<tr><td>%s</td><td class='num'>%s</td><td class='num %s'>%s</td>"
                     "<td class='num'>%+s</td></tr>" % (
                         esc(label), fmt_int(bv), cls, fmt_int(cv), fmt_int(cv - bv)))
    parts.append("</table>")

    # ---- footer ----
    parts.append("<div class='footer'>Generated by vb_tool awr compare &middot; "
                 "Δ = current_window(end−begin) − awr_window(end−begin) &middot; "
                 "time-class metrics: red = increased (potential regression).</div>")
    parts.append("</div></body></html>")

    htmls = "".join(parts)
    if out_html:
        os.makedirs(os.path.dirname(os.path.abspath(out_html)), exist_ok=True)
        with open(out_html, "w") as f:
            f.write(htmls)
        print("report written: %s" % out_html)
    else:
        sys.stdout.write(htmls)

def render_single(window_dir, metric, top_n, out_html):
    """Single-window report: every value is this window's own end−begin delta.
    Mirrors render()'s sections but single-column (no awr/current/Δ diff)."""
    win = load_window(window_dir)
    m = win["meta"]

    metric_col = {"dbtime": "db_time", "cpu": "cpu_time", "io": "data_io_time"}.get(metric, "db_time")
    metric_label = {"dbtime": "DB Time", "cpu": "CPU Time", "io": "IO Time"}.get(metric, "DB Time")

    parts = []
    parts.append("<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'>")
    parts.append("<title>awr report</title><style>%s</style></head><body><div class='wrap'>" % CSS)

    # ---- header ----
    parts.append("<h1>AWR Report</h1>")
    parts.append("<div class='meta'><span class='kbadge'>host %s</span>"
                 "<span class='kbadge'>vb_tool %s</span>"
                 "<span class='kbadge'>metric: %s</span></div>"
                 % (esc(m.get("hostname") or "?"),
                    esc(m.get("vb_tool_version") or "?"), esc(metric_label)))
    parts.append("<div class='meta'><b>awr:</b> %s &nbsp;(%s → %s, %ss)</div>"
                 % (esc(m.get("name", "?")),
                    esc(m.get("begin_ts", "?")), esc(m.get("end_ts", "?")),
                    esc(m.get("duration", "?"))))

    # ---- summary cards (single window deltas) ----
    def inst_delta(name):
        rows = delta_rows(win, "instance_time", "stat_name", ["value"])
        return rows.get(name, {}).get("value", 0.0)
    dbt = inst_delta("DB_TIME")
    cpu = inst_delta("CPU_TIME")
    io  = inst_delta("DATA_IO_TIME")

    db = delta_rows(win, "database", "datname",
                    ["xact_commit", "xact_rollback", "blks_read", "blks_hit",
                     "deadlocks", "tup_returned", "tup_fetched"])
    def agg(col):
        return sum((v.get(col, 0.0)) for v in db.values())
    commits = agg("xact_commit")
    blks = agg("blks_read")

    osd = os_window_deltas(win)

    def card(k, v, cls=""):
        parts.append("<div class='sumcard'><div class='k'>%s</div><div class='v %s'>%s</div></div>"
                     % (esc(k), cls, v))
    parts.append("<h2>Key Metrics (window total)</h2>")
    card("DB Time", fmt_us(dbt))
    card("CPU Time", fmt_us(cpu))
    card("IO Time", fmt_us(io))
    card("Commits", fmt_int(commits))
    card("blks_read", fmt_int(blks))
    card("CPU busy %", "%.1f%%" % osd["cpu_busy_pct"])
    card("CPU iowait %", "%.1f%%" % osd["cpu"].get("iowait", 0.0),
         "worse" if osd["cpu"].get("iowait", 0.0) > 5.0 else "")
    card("Net bytes", fmt_bytes(osd["net_bytes"]))

    # ---- Top SQL ----
    parts.append("<h2>Top SQL (by %s, window Δ)</h2>" % esc(metric_label))
    ST = delta_rows(win, "statement", "unique_sql_id",
                    ["n_calls", "db_time", "cpu_time", "data_io_time",
                     "n_blocks_fetched", "n_returned_rows"])
    keys = sorted(ST.keys(), key=lambda k: ST[k].get(metric_col, 0.0), reverse=True)
    parts.append("<table><tr><th>#</th><th>Query</th><th class='num'>calls</th>"
                 "<th class='num'>%s</th><th class='num'>per-call %s</th>"
                 "<th class='num'>CPU Time</th><th class='num'>IO Time</th>"
                 "<th class='num'>blocks</th></tr>" % (esc(metric_label), esc(metric_label)))
    if not keys:
        parts.append("<tr><td colspan='8' class='muted'>no data</td></tr>")
    for i, k in enumerate(keys[:top_n], 1):
        d = ST[k]
        row = d.get("__row") or {}
        query = row.get("query", k)
        user = row.get("user_name", "")
        calls = d.get("n_calls", 0.0)
        mt = d.get(metric_col, 0.0)
        pc = (mt / calls) if calls > 0 else 0.0
        parts.append(
            "<tr><td>%d</td>"
            "<td class='sql'>%s<br><span class='muted'>%s</span></td>"
            "<td class='num'>%s</td><td class='num'>%s</td><td class='num'>%s</td>"
            "<td class='num'>%s</td><td class='num'>%s</td><td class='num'>%s</td></tr>" % (
                i, esc(trunc(query)), esc(user),
                fmt_int(calls), fmt_us(mt), fmt_us(pc),
                fmt_us(d.get("cpu_time", 0.0)), fmt_us(d.get("data_io_time", 0.0)),
                fmt_int(d.get("n_blocks_fetched", 0.0))))
    parts.append("</table>")

    # ---- Wait Events ----
    parts.append("<h2>Wait Events (window Δ)</h2>")
    WE = delta_rows(win, "wait_events", "event", ["wait", "total_wait_time"])
    we_keys = sorted(WE.keys(), key=lambda k: WE[k].get("total_wait_time", 0.0), reverse=True)
    parts.append("<table><tr><th>Event</th><th>Type</th><th class='num'>waits</th>"
                 "<th class='num'>total wait time</th></tr>")
    if not we_keys:
        parts.append("<tr><td colspan='4' class='muted'>no data</td></tr>")
    for k in we_keys:
        d = WE[k]
        etype = (d.get("__row") or {}).get("type", "")
        parts.append("<tr><td>%s</td><td>%s</td><td class='num'>%s</td>"
                     "<td class='num'>%s</td></tr>" % (
                         esc(k), esc(etype),
                         fmt_int(d.get("wait", 0.0)),
                         fmt_us(d.get("total_wait_time", 0.0))))
    parts.append("</table>")

    # ---- OS ----
    parts.append("<h2>System / OS (window)</h2>")

    parts.append("<h3 class='sub'>CPU utilization (%)</h3>")
    parts.append("<table><tr><th>Component</th><th class='num'>window avg</th></tr>")
    def cpurow(label, field):
        parts.append("<tr><td>%s</td><td class='num'>%.1f%%</td></tr>"
                     % (esc(label), osd["cpu"].get(field, 0.0)))
    cpurow("busy (usr+nice+sys+irq+softirq+steal)", "busy")
    cpurow("  user", "user")
    cpurow("  system", "system")
    cpurow("iowait", "iowait")
    cpurow("irq", "irq")
    cpurow("softirq", "softirq")
    cpurow("idle", "idle")
    parts.append("</table>")

    parts.append("<h3 class='sub'>System rates (per second)</h3>")
    parts.append("<table><tr><th>Metric</th><th class='num'>value</th></tr>")
    parts.append("<tr><td>context switches/s</td><td class='num'>%.0f</td></tr>" % osd.get("ctxt_per_sec", 0))
    parts.append("<tr><td>interrupts/s</td><td class='num'>%.0f</td></tr>" % osd.get("intr_per_sec", 0))
    parts.append("<tr><td>procs_running (snapshot end)</td><td class='num'>%d</td></tr>"
                 % int(osd.get("runq_end", 0)))
    parts.append("</table>")

    parts.append("<h3 class='sub'>Disk I/O per device (window rate)</h3>")
    parts.append("<table><tr><th>Device</th><th class='num'>read IOPS</th>"
                 "<th class='num'>write IOPS</th><th class='num'>read</th>"
                 "<th class='num'>written</th><th class='num'>await (ms)</th></tr>")
    disks = osd.get("disks", [])
    if not disks:
        parts.append("<tr><td colspan='6' class='muted'>no active disk devices</td></tr>")
    for d in disks:
        parts.append("<tr><td>%s</td><td class='num'>%.1f</td><td class='num'>%.1f</td>"
                     "<td class='num'>%s</td><td class='num'>%s</td><td class='num'>%.2f</td></tr>" % (
                         esc(d["name"]),
                         d.get("read_iops", 0.0), d.get("write_iops", 0.0),
                         fmt_bytes(d.get("read_bytes", 0.0)),
                         fmt_bytes(d.get("write_bytes", 0.0)),
                         d.get("await_ms", 0.0)))
    parts.append("</table>")

    parts.append("<h3 class='sub'>Network per interface (window rate)</h3>")
    dur = osd.get("dur", 1.0) or 1.0
    parts.append("<table><tr><th>Interface</th><th class='num'>rx B/s</th>"
                 "<th class='num'>tx B/s</th><th class='num'>rx pkt/s</th>"
                 "<th class='num'>tx pkt/s</th><th class='num'>rx/tx errs (Δ)</th>"
                 "<th class='num'>rx/tx drop (Δ)</th></tr>")
    ifaces = osd.get("ifaces", [])
    if not ifaces:
        parts.append("<tr><td colspan='7' class='muted'>no network interfaces</td></tr>")
    def nrate(it, key):
        return it.get(key, 0.0) / dur
    for it in ifaces:
        parts.append("<tr><td>%s</td><td class='num'>%.0f</td><td class='num'>%.0f</td>"
                     "<td class='num'>%.1f</td><td class='num'>%.1f</td>"
                     "<td class='num'>%.0f / %.0f</td><td class='num'>%.0f / %.0f</td></tr>" % (
                         esc(it["name"]),
                         nrate(it, "rx_bytes"), nrate(it, "tx_bytes"),
                         nrate(it, "rx_packets"), nrate(it, "tx_packets"),
                         it.get("rx_errs", 0.0), it.get("tx_errs", 0.0),
                         it.get("rx_drop", 0.0), it.get("tx_drop", 0.0)))
    parts.append("</table>")

    parts.append("<h3 class='sub'>Softirqs (window Δ, summed across CPUs)</h3>")
    sf = osd.get("softirqs", {})
    cats = sorted(sf.keys(), key=lambda k: abs(sf[k]), reverse=True)
    parts.append("<table><tr><th>Category</th><th class='num'>count</th></tr>")
    if not cats:
        parts.append("<tr><td colspan='2' class='muted'>no softirqs data</td></tr>")
    for cat in cats:
        parts.append("<tr><td>%s</td><td class='num'>%+s</td></tr>" % (esc(cat), fmt_int(sf[cat])))
    parts.append("</table>")

    # ---- Instance time model ----
    parts.append("<h2>Instance Time Model (window Δ)</h2>")
    IT = delta_rows(win, "instance_time", "stat_name", ["value"])
    it_keys = sorted(IT.keys(), key=lambda k: IT[k].get("value", 0.0), reverse=True)
    parts.append("<table><tr><th>Stat</th><th class='num'>value</th></tr>")
    if not it_keys:
        parts.append("<tr><td colspan='2' class='muted'>no data</td></tr>")
    for k in it_keys:
        parts.append("<tr><td>%s</td><td class='num'>%s</td></tr>"
                     % (esc(k), fmt_us(IT[k].get("value", 0.0))))
    parts.append("</table>")

    # ---- DB-level stats ----
    parts.append("<h2>DB-level Stats (window Δ, summed over databases)</h2>")
    cols = [("xact_commit", "commits"), ("xact_rollback", "rollbacks"),
            ("blks_read", "blks_read"), ("blks_hit", "blks_hit"),
            ("deadlocks", "deadlocks"), ("tup_returned", "tup_returned"),
            ("tup_fetched", "tup_fetched")]
    parts.append("<table><tr><th>Metric</th><th class='num'>value</th></tr>")
    if not db:
        parts.append("<tr><td colspan='2' class='muted'>no data</td></tr>")
    for col, label in cols:
        v = agg(col)
        cls = "worse" if col in ("deadlocks", "xact_rollback") and v > 0 else ""
        parts.append("<tr><td>%s</td><td class='num %s'>%s</td></tr>"
                     % (esc(label), cls, fmt_int(v)))
    parts.append("</table>")

    # ---- footer ----
    parts.append("<div class='footer'>Generated by vb_tool awr report &middot; "
                 "single-window report &middot; all values = window(end−begin) &middot; "
                 "time-class metrics in μs/ms/s.</div>")
    parts.append("</div></body></html>")

    htmls = "".join(parts)
    if out_html:
        os.makedirs(os.path.dirname(os.path.abspath(out_html)), exist_ok=True)
        with open(out_html, "w") as f:
            f.write(htmls)
        print("report written: %s" % out_html)
    else:
        sys.stdout.write(htmls)

def render_single_awr(win, metric, top_n, out_html, repl_dir=None):
    """AWR-style single-window report: faithful AWR subset + classic AWR HTML look.
    Data sources: dbe_perf.{statement,wait_events}, gs_instance_time, pg_stat_database, /proc.
    `win` is a load_window()/build_window_from_snaps() result. Every value is the
    window's end−begin delta. metric is unused in AWR mode (all 5 SQL orderings are
    shown); top_n bounds each SQL sub-table.
    repl_dir set (awrrpt path) => a Replication section is rendered from
    per-minute repl_*.log samples."""
    CSS_AWR = """
body { font-family: Arial, Helvetica, Geneva, sans-serif; font-size: 13px; color: #000; background: #fff; margin: 10px; }
.rhead { border: 1px solid #cccc99; margin-bottom: 8px; }
.rhead .title { background: #fff; color: #336699; font-weight: bold; font-size: 26px; padding: 6px 2px; border-bottom: 1px solid #cccc99; }
.rhead table { border-collapse: collapse; width: 100%; }
.rhead td { border: 1px solid #cccc99; padding: 3px 8px; font-size: 12px; background: #fff; vertical-align: top; }
.rhead td.k { background: #FFFFCC; font-weight: bold; width: 16%; }
.sec { background: #fff; color: #336699; font-weight: bold; font-size: 24px; padding: 0; margin-top: 26px; border: none; }
.sec h2 { display: inline; margin: 0; font-size: 24px; color: #336699; font-weight: bold; }
.sec .totop { float: right; color: #663300; background: #fff; text-decoration: none; border: 1px solid #663300;
              padding: 1px 10px; font-size: 12px; font-weight: bold; margin-top: 8px; }
.sec .totop:hover { background: #FFFFCC; }
.sub { background: #fff; color: #336699; font-weight: bold; font-size: 17px; padding: 0; margin-top: 16px; border: none; }
table.t { border-collapse: collapse; width: auto; max-width: 100%; border: 1px solid #000; margin-top: 4px; }
table.t th { background: #0066CC; color: #fff; font-weight: bold; padding: 3px 6px; border: 1px solid #0066CC; text-align: center; font-size: 11px; }
table.t td { padding: 3px 6px; border: 1px solid #cccccc; vertical-align: top; font-size: 12px; background: #fff; }
td.n, th.n { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
td.b { font-weight: bold; }
tr:nth-child(even) td { background: #FFFFCC; }
.sql { font-family: 'Courier New', Courier, monospace; font-size: 11px; max-width: 620px; word-break: break-all; }
.note { color: #555; font-size: 11px; font-style: italic; margin: 2px 0 6px 0; }
.bad { color: #c0392b; font-weight: bold; }
.foot { color: #555; font-size: 11px; margin-top: 20px; border-top: 1px solid #cccc99; padding-top: 8px; }
.sqlblock { border: 1px solid #cccc99; margin: 6px 0; padding: 6px 8px; background: #fff; }
.sqlid { font-weight: bold; color: #336699; font-size: 12px; margin-bottom: 4px; }
.sqlfull { font-family: 'Courier New', Courier, monospace; font-size: 11px; white-space: pre-wrap;
           word-break: break-all; margin: 0; color: #222; }
table.params { table-layout: fixed; width: 100%; }
table.params td { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
table.params td.wrap { white-space: normal; overflow: visible; text-overflow: clip; word-break: break-word; }
.toc { border: 1px solid #cccc99; background: #fff; padding: 8px 12px; margin-bottom: 12px; font-size: 12px; }
.toc b { display: inline-block; margin-bottom: 4px; }
.toc ul { margin: 0; padding-left: 20px; }
.toc li { line-height: 1.7; }
.toc a { color: #663300; text-decoration: none; }
.toc a:hover { text-decoration: underline; }
"""
    m = win["meta"]

    # ---- core denominators ----
    IT = delta_rows(win, "instance_time", "stat_name", ["value"])
    def inst(name):
        return IT.get(name, {}).get("value", 0.0)
    dbt = inst("DB_TIME")                 # microseconds, window delta
    duration = to_num(m.get("duration")) or 1.0

    db = delta_rows(win, "database", "datname",
                    ["xact_commit", "xact_rollback", "blks_read", "blks_hit",
                     "deadlocks", "tup_returned", "tup_fetched",
                     "tup_inserted", "tup_updated", "tup_deleted",
                     "conflicts", "temp_bytes", "temp_files"])
    for _tpl in ("template0", "template1"):   # exclude template DBs from ALL db aggregates
        db.pop(_tpl, None)                     # (Load Profile, Instance Activity, etc.)
    def agg(col):
        return sum((v.get(col, 0.0)) for v in db.values())
    commits = agg("xact_commit"); rollbacks = agg("xact_rollback")
    blks_read = agg("blks_read"); blks_hit = agg("blks_hit")
    deadlocks = agg("deadlocks"); tup_ret = agg("tup_returned"); tup_fetch = agg("tup_fetched")
    tup_ins = agg("tup_inserted"); tup_upd = agg("tup_updated"); tup_del = agg("tup_deleted")
    conflicts = agg("conflicts"); temp_bytes = agg("temp_bytes")
    txns = commits + rollbacks
    logical_reads = blks_read + blks_hit

    ST = delta_rows(win, "statement", "unique_sql_id",
                    ["n_calls", "db_time", "cpu_time", "data_io_time", "plan_time",
                     "sort_time", "hash_time",
                     "n_blocks_fetched", "n_blocks_hit", "n_returned_rows"])
    sum_calls = sum(d.get("n_calls", 0.0) for d in ST.values())
    sum_gets = sum(d.get("n_blocks_fetched", 0.0) for d in ST.values())

    WE = delta_rows(win, "wait_events", "event", ["wait", "total_wait_time"])
    for _idle in ("wait cmd", "none"):   # drop idle/non-wait "events" (like Oracle idle events)
        WE.pop(_idle, None)
    we_sorted = sorted(WE.keys(), key=lambda k: WE[k].get("total_wait_time", 0.0), reverse=True)

    osd = os_window_deltas(win)

    def pct(num, den):
        return (num / den * 100.0) if den else 0.0
    def s_of(us):
        return "%.2f" % (to_num(us) / 1_000_000.0)
    def ms_of(us):
        return "%.2f" % (to_num(us) / 1000.0)

    parts = []
    parts.append("<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'>")
    parts.append("<title>AWR Report</title><style>%s</style></head><body>" % CSS_AWR)

    _toc = []
    _used_slugs = set()
    def _slug(t):
        s = "".join(c if c.isalnum() else "-" for c in (t or "").lower()).strip("-") or "sec"
        slug = s; i = 2
        while slug in _used_slugs:
            slug = "%s-%d" % (s, i); i += 1
        _used_slugs.add(slug)
        return slug
    def sec(t):
        _id = _slug(t)
        _toc.append((t, _id))
        parts.append('<div class="sec" id="%s"><h2>%s <a class="totop" href="#toc">↑ Top</a></h2></div>' % (_id, esc(t)))
    def sub(t):
        parts.append('<div class="sub">%s</div>' % esc(t))
    def note(t):
        for _line in t.split("\n"):
            parts.append('<div class="note">%s</div>' % esc(_line))

    # ================= Report Summary =================
    _compat_raw = psql_show("sql_compatibility")
    _compat = {"A": "A (Oracle)", "B": "B (MySQL)", "C": "C (MySQL)",
               "PG": "PG (PostgreSQL)"}.get(_compat_raw, _compat_raw) or "?"
    parts.append(
        '<div class="rhead"><div class="title">Performance AWR Report</div>'
        '<table>'
        '<tr><td class="k">Instance Name</td><td>%s</td><td class="k">Host</td><td>%s</td></tr>'
        '<tr><td class="k">Release</td><td>%s</td><td class="k">vb_tool</td><td>%s</td></tr>'
        '<tr><td class="k">AWR</td><td>%s</td><td class="k">DB Compatibility</td><td>%s</td></tr>'
        '<tr><td class="k">Begin Snap</td><td>%s</td><td class="k">End Snap</td><td>%s</td></tr>'
        '<tr><td class="k">Duration (s)</td><td>%s</td><td class="k">DB Time (s)</td><td>%s</td></tr>'
        '</table></div>' % (
            esc(m.get("db_name") or m.get("name") or "?"), esc(m.get("hostname", "?")),
            esc(m.get("db_version", "?") or "?"), esc(m.get("vb_tool_version", "?")),
            esc(m.get("name", "?")), esc(_compat),
            esc(m.get("begin_ts", "?")), esc(m.get("end_ts", "?")),
            esc(m.get("duration", "?")), s_of(dbt),
        ))
    _toc_pos = len(parts)

    # ================= OS Statistics =================
    sec("OS Statistics")
    _ci = parse_cpuinfo(win["os"].get(("end", "cpuinfo"), "")
                        or win["os"].get(("begin", "cpuinfo"), ""))
    if _ci:
        sub("CPU Info")
        parts.append('<table class="t"><tr><th>Item</th><th class="n">Value</th></tr>')
        parts.append('<tr><td>Model</td><td>%s</td></tr>' % esc(_ci["model"]))
        parts.append('<tr><td>Sockets</td><td class="n">%d</td></tr>' % _ci["sockets"])
        parts.append('<tr><td>Cores per Socket</td><td class="n">%d</td></tr>' % _ci["cores_per_socket"])
        parts.append('<tr><td>Total Physical Cores</td><td class="n">%d</td></tr>' % _ci["total_cores"])
        parts.append('<tr><td>Threads per Core</td><td class="n">%d</td></tr>' % _ci["threads_per_core"])
        parts.append('<tr><td>Logical CPUs</td><td class="n">%d</td></tr>' % _ci["logical_cpus"])
        if _ci["freq_avg_mhz"]:
            parts.append('<tr><td>Freq (min / avg / max MHz)</td><td class="n">%.0f / %.0f / %.0f</td></tr>'
                         % (_ci["freq_min_mhz"], _ci["freq_avg_mhz"], _ci["freq_max_mhz"]))
        if osd.get("platform"):
            parts.append('<tr><td>Platform</td><td>%s</td></tr>' % esc(osd["platform"]))
        parts.append('</table>')
    sub("CPU utilization (%)")
    # horizontal layout: components as columns, one value row (busy bolded)
    _cf = ("busy", "user", "nice", "system", "iowait", "irq", "softirq", "steal", "idle")
    parts.append('<table class="t"><tr>' +
                 ''.join('<th class="n">%s</th>' % f for f in _cf) + '</tr>')
    parts.append('<tr>' + ''.join(
        '<td class="n%s">%.1f</td>' % (' b' if f == "busy" else '',
                                       osd["cpu"].get(f, 0.0)) for f in _cf) + '</tr>')
    parts.append('</table>')
    _ntop = parse_numa(win["os"].get(("end", "numa"), "")
                       or win["os"].get(("begin", "numa"), ""))
    if _ntop:
        _nbeg = parse_numa(win["os"].get(("begin", "numa"), ""))
        _nend = parse_numa(win["os"].get(("end", "numa"), ""))
        sub("NUMA")
        parts.append(numa_html_table(_ntop,
                     lambda nid, key: _numa_stat_delta(_nbeg, _nend, nid, key)))
    sub("System Activity")
    parts.append('<table class="t"><tr><th></th><th class="n" colspan="2">Per Second</th></tr>'
                 '<tr><th></th><th class="n">Context Switches</th><th class="n">Interrupts</th></tr>')
    parts.append('<tr><td></td><td class="n">%.0f</td><td class="n">%.0f</td></tr>'
                 % (osd.get("ctxt_per_sec", 0), osd.get("intr_per_sec", 0)))
    parts.append('</table>')
    sub("OS Memory Usage")
    _bm = parse_meminfo(win["os"].get(("begin", "meminfo"), ""))
    _em = parse_meminfo(win["os"].get(("end", "meminfo"), ""))
    parts.append('<table class="t"><tr><th>Metric</th><th class="n">Begin MB</th>'
                 '<th class="n">End MB</th><th class="n">Δ MB</th></tr>')
    for _lbl in ("MemTotal","MemFree","MemAvailable","Buffers","Cached",
                 "Active","Active(file)","Active(anon)",
                 "Inactive","Inactive(file)","Inactive(anon)",
                 "Slab","SReclaimable","SUnreclaim","Shmem","Dirty","Writeback",
                 "PageTables","Mapped","SwapTotal","SwapFree"):
        _bv = _bm.get(_lbl, 0) // 1024
        _ev = _em.get(_lbl, 0) // 1024
        parts.append('<tr><td>%s</td><td class="n">%d</td><td class="n">%d</td><td class="n">%+d</td></tr>'
                     % (esc(_lbl), _bv, _ev, _ev - _bv))
    parts.append('</table>')

    sub("Memory / Paging")
    parts.append('<table class="t"><tr><th>Metric</th><th class="n">Total</th>'
                 '<th class="n">Per Second</th></tr>')
    vm = osd.get("vm", {})
    dur_os = osd.get("dur", 1.0) or 1.0
    def vmrow(label, key):
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td></tr>'
                     % (esc(label), fmt_num(vm.get(key, 0.0) * dur_os), fmt_num(vm.get(key, 0.0))))
    vmrow("page in (pgpgin)", "pgpgin")
    vmrow("page out (pgpgout)", "pgpgout")
    vmrow("swap in (pswpin)", "pswpin")
    vmrow("swap out (pswpout)", "pswpout")
    vmrow("minor fault (pgfault)", "pgfault")
    vmrow("major fault (pgmajfault)", "pgmajfault")
    parts.append('</table>')
    sub("Disk I/O per device")
    _dmeta = osd.get("disk_meta") or {}
    _dh = '<th>Device</th>'
    if _dmeta:
        _dh += ('<th class="n">Size</th><th class="n">Type</th><th class="n">Rot</th>'
                '<th class="n">Sched</th><th class="n">QDepth</th><th class="n">NR_RQ</th><th class="n">WC</th>')
    _dh += ('<th class="n">Reads per Sec</th><th class="n">Writes per Sec</th><th class="n">Read B per Sec</th>'
            '<th class="n">Write B per Sec</th>')
    if osd.get("discard_supported"):
        _dh += '<th class="n">Dscrd per Sec</th><th class="n">Dscrd B per Sec</th><th class="n">Flush per Sec</th>'
    _dh += '<th class="n">avg r_await (ms)</th><th class="n">avg w_await (ms)</th></tr>'
    parts.append('<table class="t"><tr>' + _dh)
    disks = osd.get("disks", [])
    ddur = osd.get("dur", 1.0) or 1.0
    if not disks:
        _ncols = 1 + (7 if _dmeta else 0) + 4 + (3 if osd.get("discard_supported") else 0) + 2
        parts.append('<tr><td colspan="%d" class="note">no active disk devices</td></tr>' % _ncols)
    for d in disks:
        ra = "-" if d.get("read_iops", 0) <= 0 else "%.2f" % d.get("r_await_ms", 0.0)
        wa = "-" if d.get("write_iops", 0) <= 0 else "%.2f" % d.get("w_await_ms", 0.0)
        row = '<tr><td>%s</td>' % esc(d["name"])
        if _dmeta:
            row += ''.join('<td class="n">%s</td>' % esc(c) for c in disk_meta_cells(d["name"], _dmeta))
        row += ('<td class="n">%.1f</td><td class="n">%.1f</td><td class="n">%s</td><td class="n">%s</td>'
                % (d.get("read_iops", 0), d.get("write_iops", 0),
                   fmt_bytes(d.get("read_bytes", 0) / ddur), fmt_bytes(d.get("write_bytes", 0) / ddur)))
        if osd.get("discard_supported"):
            row += '<td class="n">%.1f</td><td class="n">%s</td><td class="n">%.1f</td>' % (
                   d.get("discard_iops") or 0.0, fmt_bytes((d.get("discard_bytes") or 0) / ddur),
                   d.get("flush_iops") or 0.0)
        row += '<td class="n">%s</td><td class="n">%s</td></tr>' % (ra, wa)
        parts.append(row)
    parts.append('</table>')
    sub("Network per interface")
    dur_os = osd.get("dur", 1.0) or 1.0
    def nrate(it, key):
        return it.get(key, 0.0) / dur_os
    _nmeta = osd.get("net_meta") or {}
    _nh = '<th>Interface</th><th class="n">RX B per Sec</th><th class="n">TX B per Sec</th><th class="n">RX Pkt per Sec</th><th class="n">TX Pkt per Sec</th><th class="n">rx/tx errs (Δ)</th><th class="n">rx/tx drop (Δ)</th>'
    if _nmeta:
        _nh += '<th class="n">Speed</th><th class="n">Duplex</th><th class="n">Queues</th><th class="n">RX ring</th><th class="n">TX ring</th>'
    _nh += '</tr>'
    parts.append('<table class="t"><tr>' + _nh)
    ifaces = osd.get("ifaces", [])
    if not ifaces:
        parts.append('<tr><td colspan="%d" class="note">no network interfaces</td></tr>' % (7 + (5 if _nmeta else 0)))
    for it in ifaces:
