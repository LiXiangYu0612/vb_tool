# 系统表/视图基名（不带 schema 引用时会被补成 public.*，需按表名过滤，
# 避免对系统对象跑 tabstat/tabsize：慢且无意义）
_SYSTEM_TABLE_NAMES = {
    'pg_class', 'pg_attribute', 'pg_namespace', 'pg_type', 'pg_attrdef',
    'pg_index', 'pg_inherits', 'pg_constraint', 'pg_proc', 'pg_authid',
    'pg_stats', 'pg_ext_stats', 'pg_stat_all_tables', 'pg_stat_all_indexes',
    'pg_stat_activity', 'pg_locks', 'pg_partition', 'pg_partition_sequences',
    'pg_tables', 'pg_views', 'pg_sequences', 'pg_indexes', 'pg_constraints',
    'pg_statistic', 'pg_statistic_ext', 'pg_depend', 'pg_description',
    'view_table_usage', 'view_column_usage', 'column_privileges', 'table_privileges',
    'dba_part_key_columns', 'dba_subpart_key_columns', 'dba_objects', 'dba_tables',
    'dba_tab_columns', 'dba_part_tables', 'dba_tab_partitions', 'dba_indexes',
    'dbe_perf_statement', 'pg_stat_statement',
