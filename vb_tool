def extract_connection_key_from_prefix(log_block, log_format_info):
    """
    从日志前缀部分提取连接标识（用于锁等待日志关联）
    使用 remote_host（IP+端口）作为连接标识，因为 thread_id 可能被不同连接复用
    
    Args:
        log_block: 日志块内容
        log_format_info: 日志格式信息
        
    Returns:
        str: 连接标识（remote_host）或 None
    """
    if log_format_info is None:
        return None
    
    parse_func = log_format_info['parse_func']
    
    # 找到 LOG: 之前的部分作为前缀
    log_pos = log_block.find('LOG:')
    if log_pos > 0:
        full_prefix_part = log_block[:log_pos].strip()
    else:
        full_prefix_part = log_block.strip()
    
    parsed_line = parse_func(full_prefix_part)
    if parsed_line:
        return parsed_line.get('remote_host', None)
    
    return None

def extract_thread_id_from_prefix(log_block, log_format_info):
    """
    从日志前缀部分提取线程/会话ID（用于锁事件后续日志关联）
    
    Args:
        log_block: 日志块内容
        log_format_info: 日志格式信息
        
    Returns:
        str: thread_id 或 None
    """
    if log_format_info is None:
        return None
    
    parse_func = log_format_info['parse_func']
    
    # 找到 LOG:/ERROR:/DETAIL:/STATEMENT:/HINT: 之前的部分作为前缀
    log_pos = -1
    for marker in ('LOG:', 'ERROR:', 'DETAIL:', 'STATEMENT:', 'HINT:', 'CONTEXT:'):
        log_pos = log_block.find(marker)
        if log_pos > 0:
            break
    
    if log_pos > 0:
        full_prefix_part = log_block[:log_pos].strip()
    else:
        full_prefix_part = log_block.strip()
    
    parsed_line = parse_func(full_prefix_part)
    if parsed_line:
        # 优先使用 thread_id，部分格式用 session_id 也代表线程
        return parsed_line.get('thread_id') or parsed_line.get('session_id')
    
    return None


def parse_all_events(start_n, blocks, total_list, deadlock_list, lock_event_list, lock_chain_list, total_elapsed_time=0, log_format_info=None, error_list=None):
    """
    单次扫描日志块，同时解析慢查询、死锁和锁事件。
    优化：每个 block 只解析一次前缀/时间戳、慢查询 SQL 只提取一次。
    """
    total_blocks = len(blocks) // 2
    processed = 0
    start_time = datetime.now()

    if log_format_info is None:
        log_format_info = parse_log_prefix_format('%m %u %d %r %p %S')
    parse_func = log_format_info['parse_func']

    # ---- 错误日志聚合状态(内存优化) ----
    # 按 (level, 归一化消息) 聚合,只保留首尾 2 条完整记录的 context/full_log,
    # 中间记录在 error_list 里只存轻量字段。处理结束后把首尾数据填回 error_list。
    _error_groups = {}

    # ---- 慢查询相关状态 ----
    pending_lock_events = defaultdict(list)
    last_sql_time = {}

    # ---- 死锁相关状态 ----
    deadlock_seen = set()
    lock_event_buffer = []
    buffer_window_seconds = 5.0
    process_sql_multiline = re.compile(
        r'Process\s+(\d+):\s*(.*?)(?=\s+Process\s+\d+:|$)',
        re.IGNORECASE | re.DOTALL
    )
    process_wait = re.compile(
        r'Process\s+(\d+)\s+waits for\s+.*?(?:transaction\s+(\d+))?\s*;\s*blocked by process\s+(\d+)\.?',
        re.IGNORECASE
    )
    # 预存死锁检测原始块，全部扫描结束后再统一解析（避免同毫秒其他块被提前消耗）
    deadlock_candidates = []

    # ---- 锁事件相关状态 ----
    lock_seen = set()
    recent_sql_by_connection = {}
    unique_id_by_connection = {}
    thread_to_unique_id = {}
    # 事务号 -> 该事务执行过的语句列表，用于锁等待链关联
    tx_activity = defaultdict(list)
    # thread_id -> waiting 事件缓存，用于 waiting → acquired 合并
    pending_waiting_events = {}

    # 缓存前缀解析结果，避免同一块重复解析
    prefix_cache = {}
    prefix_txid_cache = {}

    _PREFIX_MARKERS = ('LOG:', 'ERROR:', 'DETAIL:', 'STATEMENT:', 'HINT:', 'CONTEXT:')

    def _prefix_key(log_block):
        """取日志块前缀作为缓存 key，避免用完整 block 浪费内存。"""
        # 前缀一般不超过 256 个字符；找到第一个标记后截断
        prefix = log_block[:300]
        for marker in _PREFIX_MARKERS:
            pos = prefix.find(marker)
            if pos > 0:
                return prefix[:pos].strip()
        return prefix.strip()

    def _parse_prefix(log_block):
        """解析日志前缀，返回 (connection_key, thread_id, IP, database, user)"""
        prefix = _prefix_key(log_block)
        parsed_line = parse_func(prefix)
        if parsed_line:
            connection_key = parsed_line.get('remote_host')
            thread_id = parsed_line.get('thread_id') or parsed_line.get('session_id')
            IP = parsed_line.get('remote_host', '')
            database = parsed_line.get('database', '')
            user = parsed_line.get('user', '')
            return connection_key, thread_id, IP, database, user
        return None, None, '', '', ''

    def _get_prefix(log_block):
        key = _prefix_key(log_block)
        cached = prefix_cache.get(key)
        if cached is not None:
            return cached
        result = _parse_prefix(log_block)
        prefix_cache[key] = result
        return result

    def _get_prefix_txid(log_block):
        """从日志块前缀中解析事务号 [%x]，供锁等待链关联。"""
        key = _prefix_key(log_block)
        cached = prefix_txid_cache.get(key)
        if cached is not None:
            return cached
        prefix = _prefix_key(log_block)
        parsed_line = parse_func(prefix)
        txid = ''
        if parsed_line:
            txid = parsed_line.get('transaction_id', '') or ''
        prefix_txid_cache[key] = txid
        return txid

    def _match_lock_event(log_text):
        """一次性匹配 waiting/acquired 锁事件，返回 (type, lock_type, wait_ms, target, holder_txid)。"""
        m = LOCK_WAITING_PATTERN.search(log_text)
        if m:
            target, holder_txid = _parse_lock_target(m.group(0))
            return 'waiting', m.group(2), float(m.group(3)), target, holder_txid
        m = LOCK_ACQUIRED_PATTERN.search(log_text)
        if m:
            target, holder_txid = _parse_lock_target(m.group(0))
            return 'acquired', m.group(2), float(m.group(3)), target, holder_txid
        return None, None, None, None, None

    def _parse_lock_target(match_text):
        """从锁事件文本中解析锁目标及阻塞者事务号。"""
        target = ''
        holder_txid = None
        m = LOCK_TARGET_PATTERN.search(match_text)
        if m:
            target = m.group(1).strip()
        m = BLOCKER_TXID_PATTERN.search(match_text)
        if m:
            holder_txid = m.group(1)
        return target, holder_txid

    def _add_lock_event_to_buffer(ts_str, log_text, thread_id):
        ev_type, ev_lock_type, ev_wait_ms, _, _ = _match_lock_event(log_text)
        if ev_type is None:
            return
        lock_event_buffer.append({
            'timestamp': ts_str,
            'thread_id': thread_id,
            'event_type': ev_type,
            'lock_type': ev_lock_type,
            'wait_time_ms': ev_wait_ms,
            'log_text': log_text.strip()
        })

    def _cleanup_lock_event_buffer(current_ts):
        if current_ts is None or not lock_event_buffer:
            return
        cutoff = current_ts - timedelta(seconds=buffer_window_seconds)
        while lock_event_buffer:
            first_ts = parse_datetime(lock_event_buffer[0]['timestamp'])
            if first_ts is None:
                lock_event_buffer.pop(0)
                continue
            if first_ts < cutoff:
                lock_event_buffer.pop(0)
            else:
                break

    def _find_related_lock_events(process_a, process_b, current_ts, future_events=None):
        if current_ts is None:
            return []
        cutoff = current_ts - timedelta(seconds=buffer_window_seconds)
        related = []
        for event in lock_event_buffer:
            event_ts = parse_datetime(event['timestamp'])
            if event_ts is None:
                continue
            if event_ts < cutoff:
                continue
            if event['thread_id'] in (process_a, process_b):
                related.append(event)
        if future_events:
            for event in future_events:
                if event['thread_id'] in (process_a, process_b):
                    related.append(event)
        related.sort(key=lambda x: x['timestamp'])
        return related

    def _extract_sql_text_from_block(block):
        m = re.search(r'(?:(?:execute|bind)\s+(?:<[^>]*>|\S+)\s*:\s*|statement:\s*)(.+)', block, re.IGNORECASE | re.DOTALL)
        if m:
            sql = m.group(1).strip()
            sql = re.split(r'\n\s*parameters:\s*', sql, flags=re.IGNORECASE)[0]
            return sql
        m = DEADLOCK_SQL_PATTERN.search(block)
        if m:
            sql = m.group(2).strip()
            if sql:
                return sql
        return ''

    def _is_related_follow_up_block(block, session_id):
        if not re.search(r'\b(DETAIL|STATEMENT|ERROR|HINT|CONTEXT)\s*:', block, re.IGNORECASE):
            return False
        if session_id in block:
            return True
        return False

    for i in range(start_n, len(blocks), 2):
        processed += 1
        if processed % 500 == 0:
            show_progress(processed, total_blocks, "解析事件", start_time, total_elapsed_time)

        timestamp_str = blocks[i]
        log_block = blocks[i + 1]
        timestamp = parse_datetime(timestamp_str)
        current_ts = timestamp

        # 快速分类：只使用廉价的字符串判断
        is_slow_sql = "duration:" in log_block and ("execute" in log_block or "statement:" in log_block or "bind" in log_block)
        has_lock_event = 'still waiting' in log_block or 'acquired' in log_block
        has_deadlock = 'detected deadlock' in log_block

        if args.debug and 'deadlock' in log_block.lower():
            _log_block_preview = log_block[:200].replace('\n', ' | ')
            print(f"[DEBUG] 块含 deadlock 关键词，ts={timestamp_str}, has_deadlock={has_deadlock}, DEADLOCK_DETECT_PATTERN={bool(DEADLOCK_DETECT_PATTERN.search(log_block))}, preview={_log_block_preview}")

        # 按需解析前缀
        connection_key = thread_id = None
        IP = database = user = ''
        if is_slow_sql or has_lock_event or has_deadlock:
            connection_key, thread_id, IP, database, user = _get_prefix(log_block)

        # ---- 0. 捕获 ERROR / WARNING / FATAL / PANIC 错误日志 ----
        if error_list is not None:
            head = log_block[:400]
            m_err = ERROR_LEVEL_PATTERN.search(head)
            if m_err:
                # 排除级别关键字出现在 duration/statement 正文里的误判
                stmt_pos = head.find('statement:')
                dur_pos = head.find('duration:')
                if (stmt_pos != -1 and stmt_pos < m_err.start()) or \
                        (dur_pos != -1 and dur_pos < m_err.start()):
                    m_err = None
            if m_err:
                if connection_key is None:
                    connection_key, thread_id, IP, database, user = _get_prefix(log_block)
                err_msg = log_block[m_err.end():].strip()

                # 收集前后3行日志上下文,按会话ID(thread_id)过滤
                # 默认窗口:前后各3行(按位置),在窗口内只保留匹配会话ID或无会话ID的行
                # 如果窗口内没有匹配行,context_before/after 为空,详情卡片只显示当前块
                context_lines = []
                context_before = []
                context_after = []
                cur_thread_id = thread_id or ''
                if cur_thread_id:
                    # 前3行窗口内按会话ID过滤
                    for j in range(max(start_n, i - 6), i, 2):
                        if j + 1 < len(blocks):
                            ctx_block = blocks[j + 1].strip()
                            if not ctx_block:
                                continue
                            ctx_thread = _get_prefix(ctx_block)[1]
                            if not ctx_thread or ctx_thread == cur_thread_id:
                                context_before.append(ctx_block)
                    # 后3行窗口内按会话ID过滤
                    for j in range(i + 2, min(len(blocks), i + 8), 2):
                        if j + 1 < len(blocks):
                            ctx_block = blocks[j + 1].strip()
                            if not ctx_block:
                                continue
                            ctx_thread = _get_prefix(ctx_block)[1]
                            if not ctx_thread or ctx_thread == cur_thread_id:
                                context_after.append(ctx_block)
                else:
                    # 无会话ID:退化为按位置取前后3行
                    for j in range(max(start_n, i - 6), i, 2):
                        if j + 1 < len(blocks):
                            ctx_block = blocks[j + 1].strip()
                            if ctx_block:
                                context_before.append(ctx_block)
                    for j in range(i + 2, min(len(blocks), i + 8), 2):
                        if j + 1 < len(blocks):
                            ctx_block = blocks[j + 1].strip()
                            if ctx_block:
                                context_after.append(ctx_block)
                # 当前块
                context_lines.append(log_block.strip())

                # 内存优化:按 (level, 归一化消息) 聚合,每类只保留首尾 2 条完整记录,
                # 中间记录只存轻量字段(time/level/user/database/IP),节省 90%+ 内存。
                # 归一化:去掉数值/引号内容,只保留消息骨架用于聚合
                _err_key = (m_err.group(1), re.sub(r'\d+|\'[^\']*\'|"[^"]*"', '?', err_msg[:200]).strip())
                _cur_idx = len(error_list)  # 当前记录在 error_list 中的 index
                if _err_key not in _error_groups:
                    # 首次出现:记录 first 完整数据 + index
                    _error_groups[_err_key] = {
                        'first_idx': _cur_idx,
                        'last_idx': _cur_idx,
                        'first_ctx': {
                            'context_before': context_before,
                            'context_after': context_after,
                            'full_log': log_block.strip(),
                        },
                        'last_ctx': None,  # 只有 1 条时为 None
                        'count': 1,
                    }
                else:
                    # 后续出现:更新 last 为当前完整数据 + index
                    _g = _error_groups[_err_key]
                    _g['count'] += 1
                    _g['last_idx'] = _cur_idx
                    _g['last_ctx'] = {
                        'context_before': context_before,
                        'context_after': context_after,
                        'full_log': log_block.strip(),
                    }
                # 追加轻量记录到 error_list(不含 context/full_log,处理结束后再填回首尾)
                error_list.append({
                    'time': timestamp,
                    'timestamp': timestamp_str,
                    'level': m_err.group(1),
                    'user': user or '',
                    'database': database or '',
                    'IP': IP or '',
                    'message': err_msg[:2000],
                    'context_before': [],
                    'context_after': [],
                    'full_log': '',
                })

        # ---- 1. 缓存 SQL 文本和 Unique ID（供锁事件关联） ----
        if is_slow_sql:
            sql_text = _extract_sql_text_from_block(log_block)
            if sql_text and connection_key:
                if len(sql_text) > 2000:
                    sql_text = sql_text[:2000] + '...'
                recent_sql_by_connection[connection_key] = sql_text
                # 从慢查询块中提取 unique id
                m = re.search(r'unique\s+id\s+(\S+)', log_block, re.IGNORECASE)
                if m:
                    unique_id = m.group(1).strip()
                    unique_id_by_connection[connection_key] = unique_id
                    if thread_id:
                        thread_to_unique_id[thread_id] = unique_id
                # 记录事务活动：供锁等待链关联阻塞者语句
                txid = _get_prefix_txid(log_block)
                if txid and txid != '0':
                    # 按 (connection_key, sql_text) 去重，避免同一事务同一语句重复记录
                    is_dup = False
                    for act in tx_activity[txid]:
                        if act.get('connection_key') == connection_key and act.get('sql_text') == sql_text:
                            is_dup = True
                            break
                    if not is_dup:
                        tx_activity[txid].append({
                            'timestamp': timestamp_str,
                            'sql_text': sql_text,
                            'unique_id': unique_id if m else '',
                            'connection_key': connection_key,
                            'thread_id': thread_id
                        })
        elif 'statement:' in log_block.lower() or 'detail:' in log_block.lower():
            if connection_key is None:
                connection_key = _get_prefix(log_block)[0]
            sql_text = _extract_sql_text_from_block(log_block)
            if sql_text and connection_key:
                if len(sql_text) > 2000:
                    sql_text = sql_text[:2000] + '...'
                recent_sql_by_connection[connection_key] = sql_text
                # 记录事务活动：statement/detail 也计入事务语句
                txid = _get_prefix_txid(log_block)
                if txid and txid != '0':
                    is_dup = False
                    for act in tx_activity[txid]:
                        if act.get('connection_key') == connection_key and act.get('sql_text') == sql_text:
                            is_dup = True
                            break
                    if not is_dup:
                        tx_activity[txid].append({
                            'timestamp': timestamp_str,
                            'sql_text': sql_text,
                            'unique_id': '',
                            'connection_key': connection_key,
                            'thread_id': thread_id
                        })

        # ---- 2. 处理 still waiting / acquired（慢查询关联 + 死锁上下文 + 锁事件） ----
        if has_lock_event:
            ev_type, lock_type, wait_time, target_from_match, holder_txid = _match_lock_event(log_block)

            if ev_type is not None:
                tid_match = LOCK_WAITING_PATTERN.search(log_block) if ev_type == 'waiting' else LOCK_ACQUIRED_PATTERN.search(log_block)
                tid = tid_match.group(1) if tid_match else thread_id
                # 死锁上下文缓冲区
                _add_lock_event_to_buffer(timestamp_str, log_block, tid)

                # 慢查询 pending_lock_events 关联
                if connection_key:
                    new_event = {
                        'type': ev_type,
                        'lock_type': lock_type,
                        'wait_time_ms': wait_time,
                        'timestamp': timestamp_str,
                        'log_text': log_block.strip(),
                        'target': target_from_match or ''
                    }
                    is_duplicate = False
                    for existing_event in pending_lock_events[connection_key]:
                        if (existing_event['timestamp'] == new_event['timestamp'] and
                                existing_event['log_text'] == new_event['log_text']):
                            is_duplicate = True
                            break
                    if not is_duplicate:
                        pending_lock_events[connection_key].append(new_event)

                # ---- 统一锁事件列表（Top10 用，保持原有逻辑：waiting/acquired 独立入列） ----
                event_match = LOCK_EVENT_PATTERN.search(log_block)
                if event_match:
                    session_id = event_match.group(1)
                    event_kind_raw = event_match.group(2).strip().lower()
                    lock_type_from_pattern = event_match.group(3)
                    target_from_pattern = event_match.group(4)
                    wait_time_ms_from_pattern = float(event_match.group(5))

                    if 'deadlock' in event_kind_raw:
                        event_kind = 'deadlock'
                    elif 'acquired' in event_kind_raw:
                        event_kind = 'acquired'
                    else:
                        event_kind = 'waiting'

                    # 统一 target/lock_type 来源：优先使用 _match_lock_event 的结果,
                    # 与慢 SQL 详情侧 pending_lock_events 的 target 保持一致,
                    # 否则 LOCK_EVENT_PATTERN 会把 "transaction 1234" 提取为 "1234",
                    # 导致两侧 lock-anchor id 不一致、跳转失败
                    if target_from_match:
                        target_from_pattern = target_from_match
                    if lock_type:
                        lock_type_from_pattern = lock_type

                    key = f"{timestamp_str}_{session_id}_{event_kind}_{target_from_pattern}_{wait_time_ms_from_pattern}"
                    if key not in lock_seen:
                        lock_seen.add(key)
                        sql_text = recent_sql_by_connection.get(connection_key, '') if connection_key else ''
                        unique_id = unique_id_by_connection.get(connection_key, '') if connection_key else ''
                        full_log_parts = []
                        if log_block.strip():
                            full_log_parts.append(f"[{timestamp_str}] {log_block.strip()}")
                        try:
                            max_look_ahead = min(50, len(blocks) - i - 2)
                            for j in range(2, max_look_ahead * 2 + 2, 2):
                                next_idx = i + j
                                if next_idx + 1 >= len(blocks):
                                    break
                                next_ts_str = blocks[next_idx]
                                next_block = blocks[next_idx + 1]
                                next_ts = parse_datetime(next_ts_str)
                                if next_ts and current_ts:
                                    if (next_ts - current_ts).total_seconds() > 5.0:
                                        break
                                next_thread = _get_prefix(next_block)[1]
                                # 遇到不同 thread 的锁事件才停止，同 thread 的相关日志继续收集
                                if next_thread != session_id and LOCK_EVENT_PATTERN.search(next_block):
                                    break
                                if next_thread == session_id and _is_related_follow_up_block(next_block, session_id):
                                    full_log_parts.append(f"[{next_ts_str}] {next_block.strip()}")
                                    if not sql_text:
                                        follow_sql = _extract_sql_text_from_block(next_block)
                                        if follow_sql:
                                            sql_text = follow_sql
                                            if len(sql_text) > 2000:
                                                sql_text = sql_text[:2000] + '...'
                                    if not unique_id:
                                        m = re.search(r'unique\s+id\s+(\S+)', next_block, re.IGNORECASE)
                                        if m:
                                            unique_id = m.group(1).strip()
                        except Exception:
                            pass

                        # 提取当前事务号（等待者自己的事务）
                        current_txid = _get_prefix_txid(log_block)
                        # 如果 tx_activity 中已有该事务的语句，回填 unique_id 和 sql_text
                        if current_txid and current_txid != '0':
                            current_acts = tx_activity.get(current_txid, [])
                            if current_acts:
                                # 取最后一条有 unique_id 的语句
                                for act in reversed(current_acts):
                                    if act.get('unique_id'):
                                        if not unique_id:
                                            unique_id = act['unique_id']
                                        if not sql_text:
                                            sql_text = act['sql_text']
                                        break
                                if not sql_text:
                                    sql_text = current_acts[-1]['sql_text']

                        # 收集前后3行日志上下文
                        le_context_before = []
                        le_context_after = []
                        for j in range(max(start_n, i - 6), i, 2):
                            if j + 1 < len(blocks):
                                ctx_block = blocks[j + 1].strip()
                                if ctx_block:
                                    le_context_before.append(ctx_block)
                        for j in range(i + 2, min(len(blocks), i + 8), 2):
                            if j + 1 < len(blocks):
                                ctx_block = blocks[j + 1].strip()
                                if ctx_block:
                                    le_context_after.append(ctx_block)

                        lock_event_list.append({
                            'timestamp': timestamp_str,
                            'session_id': session_id,
                            'lock_type': lock_type_from_pattern,
                            'target': target_from_pattern,
                            'wait_time_ms': wait_time_ms_from_pattern,
                            'event_kind': event_kind,
                            'connection_key': connection_key or '',
                            'log_text': '\n'.join(full_log_parts),
                            'sql_text': sql_text,
                            'unique_id': unique_id,
                            'txid': current_txid or '',
                            'context_before': le_context_before,
                            'context_after': le_context_after
                        })

                # ---- 锁等待链：waiting → acquired 合并（新逻辑，不影响 Top10） ----
                if ev_type == 'waiting':
                    # 缓存 waiting 事件，等待 acquired 合并
                    pending_waiting_events[tid] = {
                        'timestamp': timestamp_str,
                        'log_block': log_block,
                        'connection_key': connection_key,
                        'thread_id': tid,
                        'lock_type': lock_type,
                        'target': target_from_match or '',
                        'holder_txid': holder_txid,
                        'wait_time_ms': wait_time
                    }
                elif ev_type == 'acquired':
                    # 合并 waiting + acquired
                    waiting_ev = pending_waiting_events.pop(tid, None)
                    if waiting_ev:
                        # 总等待时间 = waiting 的 1s + acquired 的 after 时间
                        merged_wait_ms = waiting_ev['wait_time_ms'] + wait_time
                        # 合并日志：waiting + acquired
                        merged_log = f"[{waiting_ev['timestamp']}] {waiting_ev['log_block'].strip()}\n[{timestamp_str}] {log_block.strip()}"
                        # 用 waiting 的 target/holder_txid（更完整），acquired 的 wait_time
                        merged_target = waiting_ev['target'] or (target_from_match or '')
                        merged_holder_txid = waiting_ev['holder_txid'] or holder_txid
                    else:
                        # 没有 waiting，只有 acquired（如等待时间极短，只打印 acquired）
                        merged_wait_ms = wait_time
                        merged_log = f"[{timestamp_str}] {log_block.strip()}"
                        merged_target = target_from_match or ''
                        merged_holder_txid = holder_txid

                    # 向后查找被阻塞语句的 duration 日志，获取 unique_id 和 sql_text
                    blocked_unique_id = ''
                    blocked_sql = ''
                    try:
                        max_look_ahead = min(100, len(blocks) - i - 2)
                        for j in range(2, max_look_ahead * 2 + 2, 2):
                            next_idx = i + j
                            if next_idx + 1 >= len(blocks):
                                break
                            next_ts_str = blocks[next_idx]
                            next_block = blocks[next_idx + 1]
                            next_ts = parse_datetime(next_ts_str)
                            if next_ts and current_ts:
                                if (next_ts - current_ts).total_seconds() > 10.0:
                                    break
                            # 只找同 thread 的 duration 日志
                            next_thread = _get_prefix(next_block)[1]
                            if next_thread != tid:
                                continue
                            if 'duration:' in next_block and ('execute' in next_block or 'statement:' in next_block):
                                # 提取 unique id
                                m = re.search(r'unique\s+id\s+(\S+)', next_block, re.IGNORECASE)
                                if m:
                                    blocked_unique_id = m.group(1).strip()
                                # 提取 SQL
                                blocked_sql = _extract_sql_text_from_block(next_block)
                                if blocked_sql and len(blocked_sql) > 2000:
                                    blocked_sql = blocked_sql[:2000] + '...'
                                # 追加到 merged_log
                                merged_log += f"\n[{next_ts_str}] {next_block.strip()}"
                                break
                    except Exception:
                        pass

                    # ---- 锁等待链：关联阻塞者事务及其语句 ----
                    holder_session = ''
                    holder_unique_id = ''
                    holder_sql = ''
                    holder_all_sql = []
                    holder_txid_val = merged_holder_txid
                    if holder_txid_val and holder_txid_val != '0':
                        # 从 tx_activity 中查找阻塞者事务的语句
                        holder_activity = tx_activity.get(holder_txid_val, [])
                        if holder_activity:
                            holder_all_sql = [act['sql_text'] for act in holder_activity]
                            # 取最后一条有 unique_id 的语句作为代表
                            for act in reversed(holder_activity):
                                if act.get('unique_id'):
                                    holder_unique_id = act['unique_id']
                                    holder_sql = act['sql_text']
                                    break
                            if not holder_sql:
                                holder_sql = holder_all_sql[-1]
                            # 会话ID取第一条记录的 connection_key
                            holder_session = holder_activity[0].get('connection_key', '')

                    # 提取当前事务号（等待者自己的事务）
                    current_txid = _get_prefix_txid(log_block)
                    # 如果 tx_activity 中已有该事务的语句，回填 unique_id 和 sql_text
                    current_unique_id = blocked_unique_id
                    current_sql_text = blocked_sql
                    if current_txid and current_txid != '0':
                        current_acts = tx_activity.get(current_txid, [])
                        if current_acts:
                            for act in reversed(current_acts):
                                if act.get('unique_id'):
                                    if not current_unique_id:
                                        current_unique_id = act['unique_id']
                                    if not current_sql_text:
                                        current_sql_text = act['sql_text']
                                    break
                            if not current_sql_text:
                                current_sql_text = current_acts[-1]['sql_text']

                    # 收集前后3行日志上下文
                    lc_context_before = []
                    lc_context_after = []
                    for j in range(max(start_n, i - 6), i, 2):
                        if j + 1 < len(blocks):
                            ctx_block = blocks[j + 1].strip()
                            if ctx_block:
                                lc_context_before.append(ctx_block)
                    for j in range(i + 2, min(len(blocks), i + 8), 2):
                        if j + 1 < len(blocks):
                            ctx_block = blocks[j + 1].strip()
                            if ctx_block:
                                lc_context_after.append(ctx_block)

                    lock_chain_list.append({
                        'timestamp': timestamp_str,
                        'session_id': tid,
                        'lock_type': lock_type,
                        'target': merged_target,
                        'wait_time_ms': merged_wait_ms,
                        'event_kind': 'acquired',
                        'connection_key': connection_key or '',
                        'log_text': merged_log,
                        'sql_text': current_sql_text or (recent_sql_by_connection.get(connection_key, '') if connection_key else ''),
                        'unique_id': current_unique_id or (unique_id_by_connection.get(connection_key, '') if connection_key else ''),
                        'holder_txid': holder_txid_val or '',
                        'holder_session': holder_session,
                        'holder_unique_id': holder_unique_id,
                        'holder_sql': holder_sql,
                        'holder_all_sql': holder_all_sql,
                        'waiting_timestamp': waiting_ev['timestamp'] if waiting_ev else '',
                        'waiting_log': waiting_ev['log_block'].strip() if waiting_ev else '',
                        'txid': current_txid or '',
                        'context_before': lc_context_before,
                        'context_after': lc_context_after
                    })

        # ---- 3. 处理死锁 ----
        if has_deadlock:
            detect_match = DEADLOCK_DETECT_PATTERN.search(log_block)
            if detect_match:
                if args.debug:
                    print(f"[DEBUG] 检测到死锁行，ts={timestamp_str}, thread={detect_match.group(1)}, txid={detect_match.group(3)}")
                _cleanup_lock_event_buffer(current_ts)

                detail_for_parsing = log_block
                j = i + 2
                while j + 1 < len(blocks):
                    next_ts_str = blocks[j]
                    next_block = blocks[j + 1]
                    next_ts = parse_datetime(next_ts_str)
                    # 允许相邻毫秒（50ms 内）的 Process SQL DETAIL 块，避免死锁 DETAIL 与 LOG 时间戳差 1ms 导致丢失
                    if next_ts is None or (next_ts - current_ts).total_seconds() > 0.050:
                        break
                    # 只合并包含 Process X: SQL 的 DETAIL 块，避免 ERROR/HINT/STATEMENT 等后续日志混入 SQL 提取
                    if re.search(r'Process\s+\d+:\s', next_block, re.IGNORECASE):
                        detail_for_parsing += '\n' + next_block
                    j += 2

                if args.debug:
                    _has_process_sql_flag = bool(re.search(r'Process\s+\d+:\s', detail_for_parsing, re.IGNORECASE))
                    print(f"[DEBUG] 预存死锁候选，ts={timestamp_str}, detail_len={len(detail_for_parsing)}, has_process_sql={_has_process_sql_flag}")

                deadlock_candidates.append({
                    'timestamp_str': timestamp_str,
                    'current_ts': current_ts,
                    'log_block': log_block,
                    'detail_for_parsing': detail_for_parsing,
                    'index': i,
                    'connection_key_a': connection_key,
                    'thread_id_a': thread_id
                })

        # ---- 4. 处理慢查询 ----
        if is_slow_sql:
            try:
                # 前缀已经解析过，直接使用缓存结果
                if connection_key is None and IP == '' and database == '' and user == '':
                    connection_key, thread_id, IP, database, user = _get_prefix(log_block)

                query_content = EXECUTE_PATTERN.split(log_block)
                if len(query_content) < 4:
                    continue

                duration_match = DURATION_EXTRACT_PATTERN.search(log_block)
                if duration_match:
                    duration_value = float(duration_match.group(1))
                    matched_text = duration_match.group(0).lower()
                    if 'ms' in matched_text:
                        duration = duration_value / 1000.0
                    else:
                        duration = duration_value
                else:
                    duration_str_parts = SPLIT_PATTERN.split(query_content[1])
                    if len(duration_str_parts) < 2:
                        continue
                    duration = float(duration_str_parts[1].strip()) / 1000

                lock_wait_time_ms = 0.0
                lock_events = []
                if connection_key and connection_key in pending_lock_events:
                    sql_start_time = None
                    if timestamp:
                        sql_start_time = timestamp - timedelta(seconds=duration)
                    last_time = last_sql_time.get(connection_key)

                    filtered_events = []
                    for event in pending_lock_events[connection_key]:
                        event_time = parse_datetime(event['timestamp'])
                        if not event_time:
                            continue
                        if sql_start_time and event_time < sql_start_time:
                            continue
                        if timestamp and event_time > timestamp:
                            continue
                        if last_time and event_time <= last_time:
                            continue
                        filtered_events.append(event)

                    lock_events = filtered_events
                    for event in lock_events:
                        lock_wait_time_ms += event['wait_time_ms']
                    del pending_lock_events[connection_key]

                if connection_key and timestamp:
                    last_sql_time[connection_key] = timestamp

                query_text, unique_id = query_content[3], query_content[2].strip()
                query_text = query_text.strip()
                # SQL类型打标：只取第一个有效词元判断
                stripped_text = query_text.lstrip()
                first_token = stripped_text.split(None, 1)[0].upper()
                dml_keywords = frozenset((
                    'SELECT', 'INSERT', 'UPDATE', 'DELETE', 'MERGE', 'WITH', 'CALL', 'BEGIN', 'COMMIT', 'ROLLBACK',
                    'EXECUTE', 'PREPARE', 'DEALLOCATE', 'COPY', 'DECLARE'
                ))
                ddl_keywords = frozenset((
                    'CREATE', 'DROP', 'ALTER', 'TRUNCATE', 'GRANT', 'REVOKE', 'INDEX', 'TABLESPACE',
                    'SCHEMA', 'DATABASE', 'SEQUENCE', 'VIEW', 'FUNCTION', 'PROCEDURE', 'TRIGGER',
                    'TYPE', 'COMMENT', 'OWNER', 'RULE', 'VACUUM', 'ANALYZE', 'REINDEX', 'CLUSTER',
                    'LOCK', 'UNLOCK', 'SAVEPOINT', 'RELEASE', 'SET'
                ))

                is_dml = first_token in dml_keywords
                is_ddl = first_token in ddl_keywords
                sql_type = 'ddl' if is_ddl else 'dml'

                # 清理 query_text 的前导非关键词元（保留原行为）
                if not is_dml and not is_ddl:
                    first_space_pos = stripped_text.find(' ')
                    if first_space_pos > 0:
                        query_text = stripped_text[first_space_pos:].strip()
                    else:
                        query_text = stripped_text
                    # 重新判断
                    first_token = query_text.split(None, 1)[0].upper()
                    is_dml = first_token in dml_keywords
                    is_ddl = first_token in ddl_keywords
                    sql_type = 'ddl' if is_ddl else 'dml'

                v_params = ''
                if i + 3 < len(blocks) and "parameters:" in blocks[i + 3]:
                    try:
                        v_params = PARAMETERS_PATTERN.split(blocks[i + 3])[1].strip()
                    except IndexError:
                        v_params = ''

                # --mode error 模式不提取 SQL；query/all 模式保留所有 SQL（DML+DDL）
                if statement_filter == 'error':
                    continue

                total_list.append({
                    'time': timestamp,
                    'qry_text': query_text,
                    'qry_params': v_params,
                    'IP': IP,
                    'database': database,
                    'user': user,
                    'duration': duration,
                    'unique_id': unique_id,
                    'connection_key': connection_key,
                    'lock_wait_time_ms': lock_wait_time_ms,
                    'lock_events': lock_events,
                    'sql_type': sql_type
                })
            except (IndexError, ValueError, Exception):
                continue

    # ---- 3.1 循环结束后统一解析死锁候选 ----
    if args.debug:
        print(f"[DEBUG] 主循环结束，死锁候选总数: {len(deadlock_candidates)}")

    for candidate in deadlock_candidates:
        timestamp_str = candidate['timestamp_str']
        current_ts = candidate['current_ts']
        log_block = candidate['log_block']
        detail_for_parsing = candidate['detail_for_parsing']
        i = candidate['index']
        connection_key_a = candidate.get('connection_key_a')

        has_process_sql = bool(re.search(r'Process\s+\d+:\s', detail_for_parsing, re.IGNORECASE))
        if not has_process_sql:
            if args.debug:
                print(f"[DEBUG] 死锁候选无 Process SQL，跳过，ts={timestamp_str}")
            continue

        detect_match = DEADLOCK_DETECT_PATTERN.search(log_block)
        if not detect_match:
            if args.debug:
                print(f"[DEBUG] 死锁候选未匹配 DEADLOCK_DETECT_PATTERN，跳过，ts={timestamp_str}")
            continue

        process_a = detect_match.group(1)
        lock_type = detect_match.group(2)
        txid_a = detect_match.group(3)
        wait_ms = float(detect_match.group(4))

        if args.debug:
            print(f"[DEBUG] 开始解析死锁候选，ts={timestamp_str}, process_a={process_a}, lock_type={lock_type}")

        process_b = None
        full_context_parts = [log_block.strip()]
        future_lock_events = []
        try:
            max_look_ahead = min(50, len(blocks) - i - 2)
            for j in range(2, max_look_ahead * 2 + 2, 2):
                next_idx = i + j
                if next_idx + 1 >= len(blocks):
                    break
                next_ts_str = blocks[next_idx]
                next_block = blocks[next_idx + 1]
                next_ts = parse_datetime(next_ts_str)
                if next_ts and current_ts:
                    if (next_ts - current_ts).total_seconds() > 2.0:
                        break
                if DEADLOCK_DETECT_PATTERN.search(next_block):
                    break
                if "duration:" in next_block and ("execute" in next_block or "statement:" in next_block):
                    break
                next_thread = _get_prefix(next_block)[1]
                if next_thread in (process_a, process_b):
                    if re.search(r'\b(DETAIL|ERROR|HINT|STATEMENT|CONTEXT)\s*:', next_block, re.IGNORECASE) or \
                       LOCK_WAITING_PATTERN.search(next_block) or LOCK_ACQUIRED_PATTERN.search(next_block) or \
                       ("duration:" in next_block and ("execute" in next_block or "statement:" in next_block)):
                        full_context_parts.append(next_block.strip())
                        waiting_match = LOCK_WAITING_PATTERN.search(next_block)
                        acquired_match = LOCK_ACQUIRED_PATTERN.search(next_block)
                        if waiting_match or acquired_match:
                            if waiting_match:
                                thread_id = waiting_match.group(1)
                                ev_lock_type = waiting_match.group(2)
                                wait_ms_ev = float(waiting_match.group(3))
                                event_type = 'waiting'
                            else:
                                thread_id = acquired_match.group(1)
                                ev_lock_type = acquired_match.group(2)
                                wait_ms_ev = float(acquired_match.group(3))
                                event_type = 'acquired'
                            future_lock_events.append({
                                'timestamp': next_ts_str,
                                'thread_id': thread_id,
                                'event_type': event_type,
                                'lock_type': ev_lock_type,
                                'wait_time_ms': wait_ms_ev,
                                'log_text': next_block.strip()
                            })
        except Exception:
            pass

        full_context = '\n'.join(full_context_parts)
        normalized_detail = re.sub(r'\n\s+', ' ', detail_for_parsing)

        txid_b = None

        for wait_match in process_wait.finditer(normalized_detail):
            p_a = wait_match.group(1)
            t_a = wait_match.group(2)
            p_b = wait_match.group(3)
            if p_a == process_a:
                process_b = p_b
                txid_a = t_a or txid_a
            elif p_b == process_a and process_b is None:
                process_b = p_a
                txid_b = t_a or txid_b
            elif p_b == process_a and process_b:
                txid_b = t_a or txid_b
            elif process_b and p_a == process_b:
                txid_b = t_a or txid_b

        sql_map = {}
        for sql_match in process_sql_multiline.finditer(normalized_detail):
            pid = sql_match.group(1)
            raw_sql = sql_match.group(2)
            # 去掉可能混入的日志前缀（形如 midb01 f1dmpdb 10.42.40.25(57882) 22688469415680 ...）
            cleaned_sql = re.split(
                r'\s+[a-zA-Z_][a-zA-Z0-9_]*(?:\s+[a-zA-Z_][a-zA-Z0-9_]*)*\s+\d+\.\d+\.\d+\.\d+\(\d+\)\s+\d+',
                raw_sql, maxsplit=1
            )[0]
            # 去掉同一行内后续跟进的 LOG/ERROR/DETAIL/HINT/STATEMENT 等日志标记
            cleaned_sql = re.split(
                r'\s+(?:LOG|ERROR|DETAIL|HINT|STATEMENT|CONTEXT)\s*:',
                cleaned_sql, maxsplit=1
            )[0]
            sql_text = ' '.join(cleaned_sql.split())
            if sql_text:
                sql_map[pid] = sql_text

        if not process_b:
            for pid in sql_map:
                if pid != process_a:
                    process_b = pid
                    break

        if args.debug:
            print(f"[DEBUG] 死锁候选解析结果，ts={timestamp_str}, process_a={process_a}, process_b={process_b}, sql_map_keys={list(sql_map.keys())}")

        if process_b:
            current_deadlock_event = {
                'timestamp': timestamp_str,
                'thread_id': process_a,
                'event_type': 'deadlock',
                'lock_type': lock_type,
                'wait_time_ms': wait_ms,
                'log_text': log_block.strip()
            }
            related_lock_events = _find_related_lock_events(process_a, process_b, current_ts, future_lock_events)
            related_lock_events.insert(0, current_deadlock_event)

            key = f"{timestamp_str}_{process_a}_{process_b}"
            if key not in deadlock_seen:
                deadlock_seen.add(key)
                # 尝试从后续上下文中解析 process_b 所在日志块，以找到其 connection_key
                connection_key_b = None
                try:
                    for j in range(2, min(50, len(blocks) - i - 2) * 2 + 2, 2):
                        next_idx = i + j
                        if next_idx + 1 >= len(blocks):
                            break
                        next_block = blocks[next_idx + 1]
                        if DEADLOCK_DETECT_PATTERN.search(next_block):
                            break
                        if "duration:" in next_block and ("execute" in next_block or "statement:" in next_block):
                            break
                        next_thread = _get_prefix(next_block)[1]
                        if next_thread == process_b:
                            connection_key_b = _get_prefix(next_block)[0]
                            break
                except Exception:
                    pass

                # 优先通过 thread_id 查找 unique_id，避免同 IP 多连接导致覆盖
                unique_id_a = thread_to_unique_id.get(process_a, '')
                unique_id_b = thread_to_unique_id.get(process_b, '')
                if not unique_id_a and connection_key_a:
