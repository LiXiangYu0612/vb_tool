# --- stack: capture & aggregate thread stacks (Percona pt-pmp style) ---
# Core: vb_ctl stack -D <datadir> (one dump = all threads, leaf frame first).
# Port -> datadir: the vastbase postmaster cmdline has -D but no -p, so resolve
# the listener pid via ss -lntp and read -D from /proc/<pid>/cmdline.

# Print a full-width rule of the given character (width = VB_STACK_WIDTH, 120)
_stack_rule() { printf '%*s\n' "${VB_STACK_WIDTH:-120}" '' | tr ' ' "$1"; }

# stdin: one chain per line; $1: block label (e.g. "sample 1/3"). Prints a
# decorated block header (label + thread count, '=' padded to full width)
# followed by the aggregated table sorted by frequency.
_stack_print_aggregate() {
    local _vb_label="$1"
    local _vb_f=$(mktemp /tmp/vb_stack_slice.XXXXXX)
    cat > "$_vb_f"
    local _vb_t=$(wc -l < "$_vb_f" | tr -d ' ')
    if [ "$_vb_t" -eq 0 ]; then rm -f "$_vb_f"; return 0; fi
    local _vb_hdr="================== ${_vb_label}  (${_vb_t} threads) "
    local _vb_padlen=$(( ${VB_STACK_WIDTH:-120} - ${#_vb_hdr} ))
    [ "$_vb_padlen" -lt 4 ] && _vb_padlen=4
    local _vb_pad=$(printf '%*s' "$_vb_padlen" '' | tr ' ' '=')
    printf '%s%s\n' "$_vb_hdr" "$_vb_pad"
    sort "$_vb_f" | uniq -c | sort -k1,1nr -k2,2 | \
        awk -v total="$_vb_t" -v width="${VB_STACK_WIDTH:-120}" '
        {
            pct = $1 * 100.0 / total
            chain = substr($0, index($0, $2))
            n = split(chain, fr, " <- ")
            line = sprintf("%6d  %5.1f%%  %s", $1, pct, fr[1])
            indent = sprintf("%*s", 16, "")
            for (i = 2; i <= n; i++) {
                if (length(line) + length(" <- " fr[i]) > width) {
                    print line
                    line = indent "<- " fr[i]
                } else {
                    line = line " <- " fr[i]
                }
            }
            print line
        }'
    rm -f "$_vb_f"
}

run_stack() {
    local port="${PGPORT:-5432}"
    local samples=3
    local delay=3
    local outfile="./stack_$(date +%Y%m%d_%H%M%S).txt"
    local OPTIND=1
    while getopts ":P:n:d:o:" opt; do
        case $opt in
            P) port="$OPTARG" ;;
            n) samples="$OPTARG" ;;
            d) delay="$OPTARG" ;;
            o) outfile="$OPTARG" ;;
           \?) echo "Invalid option: -$OPTARG" >&2; return 1 ;;
            :) echo "Option -$OPTARG requires an argument" >&2; return 1 ;;
        esac
    done
    if ! [[ "$port" =~ ^[0-9]+$ ]] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
        echo "Error: -P must be a valid port number (1-65535)" >&2
        return 1
    fi
    if ! [[ "$samples" =~ ^[0-9]+$ ]] || [ "$samples" -lt 1 ] || [ "$samples" -gt 50 ]; then
        echo "Error: -n (sample count) must be an integer between 1 and 50" >&2
        return 1
    fi
    if ! [[ "$delay" =~ ^[0-9]+$ ]] || [ "$delay" -lt 1 ] || [ "$delay" -gt 3600 ]; then
        echo "Error: -d (interval seconds) must be an integer between 1 and 3600" >&2
        return 1
    fi
    command -v vb_ctl >/dev/null 2>&1 || { echo "Error: vb_ctl not found in PATH" >&2; return 1; }

    # port -> postmaster pid -> datadir
    local postmaster_pid=$(ss -lntp 2>/dev/null | grep -oP ":${port}\b.*pid=\K[0-9]+" | head -1)
    local datadir=""
    if [ -n "$postmaster_pid" ]; then
        # cmdline args are NUL-separated: "-D\0/path\0"
        datadir=$(tr '\0' '\n' < "/proc/${postmaster_pid}/cmdline" 2>/dev/null | grep -A1 '^-D$' | tail -1)
    fi
    if [ -z "$datadir" ] || [ ! -d "$datadir" ]; then
        if [ -n "$PGDATA" ] && [ -d "$PGDATA" ]; then
            datadir="$PGDATA"
            echo "[WARN ] could not resolve port $port to a datadir; falling back to \$PGDATA=$PGDATA" >&2
        else
            echo "Error: no listening instance found on port $port and \$PGDATA is unset" >&2
            return 1
        fi
    fi

    local tmp_raw=$(mktemp /tmp/vb_stack_raw.XXXXXX)
    local i=1 rc=0
    echo "[INFO ] stack profiling port $port (datadir $datadir): $samples samples, ${delay}s interval"
    while [ "$i" -le "$samples" ]; do
        echo "[INFO ]   sample $i/$samples ..."
        {
            echo "===== sample $i  $(date '+%Y-%m-%d %H:%M:%S') ====="
            vb_ctl stack -D "$datadir" 2>&1 || rc=1
            echo ""
        } >> "$tmp_raw"
        [ "$i" -lt "$samples" ] && sleep "$delay"
        i=$((i+1))
    done
    if [ "$rc" -ne 0 ] && [ ! -s "$tmp_raw" ]; then
        echo "Error: vb_ctl stack failed and produced no output" >&2
        rm -f "$tmp_raw"
        return 1
    fi

    # Aggregate pt-pmp style: one chain per thread per sample (prefixed with
    # the sample number so each sample can be aggregated separately).
    # Symbol frames keep their names (offsets stripped), unresolved addresses
    # normalize to 0x???? so they aggregate.
    local chains_file=$(mktemp /tmp/vb_stack_chains.XXXXXX)
    awk '
        function flush_thread() {
            if (in_thread && nframes > 0) {
                chain = frames[1]
                for (k = 2; k <= nframes; k++) chain = chain " <- " frames[k]
                print sample_no "\t" chain
            }
            in_thread = 0; nframes = 0
        }
        /^===== sample / { flush_thread(); sample_no++; next }
        /^Thread [0-9]+ tid</ { flush_thread(); in_thread = 1; next }
        in_thread && (/^[ \t]*$/ || /^\[/) { flush_thread(); next }
        in_thread {
            line = $0
            sub(/[ \t]+$/, "", line)
            sub(/ \+ 0x[0-9a-fA-F]+$/, "", line)
            if (line ~ /^0x[0-9a-fA-F]+$/) line = "0x????"
            # vb_ctl emits "thread <tid> not available" when a thread cannot be
            # sampled; normalize to a constant so these aggregate per sample
            if (line ~ /not available/) { nframes = 1; frames[1] = "thread <not available>"; next }
            if (line != "") { nframes++; frames[nframes] = line }
        }
        END { flush_thread() }
    ' "$tmp_raw" > "$chains_file"

    local total=$(wc -l < "$chains_file" | tr -d ' ')
    if [ "$total" -eq 0 ]; then
        echo "Error: no thread stacks parsed from vb_ctl output" >&2
        rm -f "$tmp_raw" "$chains_file"
        return 1
    fi

    # Per-sample tables (pct = share of that sample's threads). Long chains
    # wrap at width (VB_STACK_WIDTH, default 120); continuation lines align
    # under the chain column.
    local summary="" i
    for i in $(seq 1 "$samples"); do
        summary+=$(awk -F'\t' -v s="$i" '$1 == s {print $2}' "$chains_file" | \
            _stack_print_aggregate "sample $i/$samples")$'\n\n'
    done

    {
        _stack_rule '='
        echo " vb_tool stack"
        echo " host        : $(hostname)"
        echo " time        : $(date '+%Y-%m-%d %H:%M:%S')"
        echo " port        : $port"
        echo " datadir     : $datadir"
        echo " samples     : $samples (interval ${delay}s)"
        echo " stacks      : $total (threads x samples)"
        _stack_rule '='
        echo "$summary"
        echo ""
        _stack_rule '='
        echo " RAW SAMPLES (vb_ctl stack -D $datadir)"
        _stack_rule '='
        cat "$tmp_raw"
    } > "$outfile" 2>/dev/null || { echo "Error: cannot write $outfile" >&2; rm -f "$tmp_raw" "$chains_file"; return 1; }
    rm -f "$tmp_raw" "$chains_file"

    _stack_rule '-'
    printf '%s\n' "$summary"
    _stack_rule '-'
    echo "$total stacks aggregated from $samples samples; summary + raw written to $outfile"
    return 0
}

