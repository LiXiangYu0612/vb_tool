                    # used to be handled the same way; now the main-screen Enter goes
                    # to the command line (see above) and only the timeout -- plus any
                    # sub-screen Enter -- falls through to the render. That
                    # fall-through is load-bearing: an empty key also matches the '*'
                    # branch below, whose continue would starve the frame loop forever
                    # (screen frozen on frame 1).
                    if [ "$rrc" -eq 0 ] && [ "$screen" = "main" ]; then
                        # 同上: 光标激活 = 进所选屏, 否则原命令行 (icrnl 终端的 Enter 走这)
                        if [ "${hint_cur:-0}" -ge 1 ] 2>/dev/null; then
                            screen=${_hint_screens[$((hint_cur-1))]}
                            sub_first=1
                        else
                            _vtop_cmd_exec ""
                            [ "$_vtop_cmd_quit" = "1" ] && break
                        fi
                    fi
                    ;;
                *)
                    # ★Main-screen bare keys are INERT (user's call 2026-09-28:
                    # 「不要双入口 必须弹出enter 之后输入才能进入」): a sub-screen
                    # is entered ONLY through the command line that Enter / ESC
                    # opens (one letter + Enter there, table in _vtop_cmd_exec).
                    # The one-key drill-down that used to live here (bare
                    # s/l/a/e/x/r/m/t/k switching on the key alone) is REMOVED --
                    # do not restore it. Letters stay advertised on the HINT line
                    # because they are what you type at the prompt. q / Ctrl+C
                    # still quit directly.
                    if [ "$screen" != "main" ]; then
                        :                                     # sub: fall through = refresh
                    else
                        continue                              # main: inert, no render
                    fi
                    ;;
