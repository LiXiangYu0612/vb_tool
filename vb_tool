    index_check)
        if [[ "$2" == "-help" || "$2" == "--help" ]]; then
            echo "Usage: vb_tool index_check [options]"
            exit 0
        fi
        if ! run_redundant_index "${@:2}"; then
             exit 1
        fi
        ;;
    tabstat)
        if [[ "$2" == "-help" || "$2" == "--help" ]]; then
