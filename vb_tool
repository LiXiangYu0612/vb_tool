    'substring', 'position', 'overlay', 'trim', 'extract', 'cast',
    'coalesce', 'nullif', 'greatest', 'least', 'nvl', 'decode', 'to_char',
    'to_date', 'to_number', 'to_timestamp', 'string_agg', 'array_agg',
    'generate_series', 'unnest', 'regexp_replace', 'regexp_substr',
    'regexp_count', 'split_part', 'date_trunc', 'date_part', 'now', 'current_date',
