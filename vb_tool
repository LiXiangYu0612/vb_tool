                        # collapse, e.g. pg_location/<tbs> keys have no
                        # pg_location parent row yet must nest under $PGDATA);
                        # the "/"+ guard keeps slash-free keys terminating
                        p = k.rsplit("/", 1)[0]
                        while p and p not in _sset and "/" in p:
                            p = p.rsplit("/", 1)[0]
                        d = _treedepth(p) + 1 if p else 0
                        _dcache[k] = d
                        return d
                    for _s in _subs:
                        _sb = _fdb.get(_s, (0, 0)); _se = _fde.get(_s, (0, 0))
                        _pad = "%dem" % (2 + 2 * _treedepth(_s)) if _s.startswith("/") else "2em"
                        # user 2026-09-20: normal text color (was class=muted
                        # gray); indent kept for hierarchy
                        parts.append('<tr><td style="padding-left:%s">%s</td>'
                                     '<td class="n">%s</td><td class="n">%s</td><td class="n">%+d</td></tr>'
                                     % (_pad, esc("fd " + _FD_DISP.get(_s, _s)),
                                        esc(_fd_cell(_sb, True)), esc(_fd_cell(_se, True)),
                                        (_se[0] + _se[1]) - (_sb[0] + _sb[1])))
            parts.append('<tr><td><b>fd Total</b></td><td class="n"><b>%d</b></td>'
                         '<td class="n"><b>%d</b></td><td class="n"><b>%+d</b></td></tr>'
                         % (_tb, _te, _te - _tb))
