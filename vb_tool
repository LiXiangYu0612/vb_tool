        #   datadir 停在 unknown。每 30s 用同一条 show data_directory 再解析一次, 成功
        #   即补齐 DSK/I-O/FS/TOPSQL 与表空间链 (psql 有 5s 超时, 不会卡帧)。
        # ★--once 跳过 (2026-11-17 三轮复核): --once 只出一帧且立即 break, 重试成功了也
        #   没有下一帧能受益; 实例 down 时白白多等一次 5s 超时, collect_log 3 个采样段
        #   平白多烧 ~15s。
        if [ "$once" != "1" ] && [ "$datadir" = "unknown" ] && [ "$(( $(date +%s%3N) - _dd_try_ms ))" -gt 30000 ]; then
            _dd_try_ms=$(date +%s%3N)
            _vtop_resolve_datadir
        fi
        # ---- sub-screen: its own frame, main-screen collection skipped entirely ----
        # the renderer is picked by name: adding an entry = key map + _vtop_screen_<name>
        # + its legend in _vtop_keys_hint(); this branch never needs touching again
        if [ "$screen" != "main" ]; then
            _ss_t0=$(date +%s%3N)
            { "_vtop_screen_$screen"; [ "$interactive" = "1" ] && _vtop_keys_hint "$screen"; } > "$_vtop_f"
            _vtop_print_frame "$_vtop_f"
            _last_work_ms=$(( $(date +%s%3N) - _ss_t0 ))
            # no --once check here: screen is only ever switched inside the key
            # branch, which is skipped when once=1, so this path is interactive-only
            continue
        fi
        t1=$(date +%s%3N); d1=$(_vtop_dsample); c1=$(_vtop_cpustat); n1=$(_vtop_net)
        v1=$(_vtop_vbcpu "$(_vtop_vbcpu_pid)")
        dt=$(( t1 - t0 )); [ "$dt" -le 0 ] && dt=1
        # ★空样本 = 没有基线, 整块 '-' 不做差分 (2026-11-26, 与磁盘路径同规矩):
        # _vtop_cpustat 同为 `timeout 3 awk` 无 END 收尾, 被杀时输出空串——空串按 0
        # 差分 ⇒ c0 空打一帧"开机至今占比"(看着合理实则窗口错), c1 空打一帧假"全 idle"。
