                <strong>总文件大小：</strong>{total_size_mb_all:.2f} MB ｜
                <strong>总记录数：</strong>{len(all_total_list)} 条 ｜
                <strong>总耗时：</strong>{total_elapsed_seconds_all} 秒
            </div>
        </div>
        """

