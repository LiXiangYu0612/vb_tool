# -e 只给日期时按“当天结束”理解（否则按 00:00 边界会把当天日志整文件排除）
if args.end and re.match(r'^\d{4}-\d{2}-\d{2}$', args.end.strip()):
    args.end = args.end.strip() + ' 23:59:59.999'
# -b 与 -e 对称: 裸日期补 00:00:00, 否则 parse_datetime 四格式全 miss 返 None,
# 逐条过滤点拿 None 做比较直接 TypeError(2026-11-26 复核 P1)
if args.begin and re.match(r'^\d{4}-\d{2}-\d{2}$', args.begin.strip()):
    args.begin = args.begin.strip() + ' 00:00:00'

# 归一化时间参数：-d/-b/-e 统一折算为单一的 args.begin/args.end，下游只用 -b/-e 一套逻辑。
# 规则（-b/-e 优先级高于 -d，同时给出时忽略 -d）：
#   1. begin：显式 -b 优先；无 -b 时按 -d 折算 begin = now - days（days 缺省默认 1 天）
#   2. end  ：显式 -e 优先；无 -e 时补 end = now
#   3. -d 0：手动关闭时间过滤（begin/end 置空，全量分析）
#   4. -f 明确指定具体文件（无通配符批量）且未显式给 -d/-b/-e 时：
#      不加载 -d 的默认时间过滤，强行分析这些文件
#   5. -b/-e 只要显式给出其中一个，缺省的另一侧自动补 now 基准值：
#      只给 -b → end 补 now；只给 -e → begin 按 -d 折算补 now-N 天（缺省 N=1，-d 0 除外）
_now = datetime.now()
# 用户显式给了 -b 时，-d 不再参与 begin 折算（被忽略），给出提示
if args.begin and args.days is not None:
    print(f"提示: 已显式指定 -b '{args.begin}'，忽略 -d {args.days}（-b/-e 优先级高于 -d）")
# 判断 -f 是否为通配符批量模式（含 * ? [ 即视为批量），明确指定的具体文件不算批量
_explicit_files_mode = bool(args.file) and not any(
    ('*' in p or '?' in p or '[' in p) for p in args.file)
if not args.begin:
    if args.days is not None and args.days > 0:
        # 显式 -d N（未显式给 -b）：用户主动指定，正常折算
        args.begin = (_now - timedelta(days=args.days)).strftime('%Y-%m-%d %H:%M:%S')
    elif args.end and args.days != 0:
        # 只显式给出了 -e：begin 自动补 now-N 天（N 取 -d，缺省 1；-d 0 保持关闭）
        _days = args.days if args.days is not None else 1
        args.begin = (_now - timedelta(days=_days)).strftime('%Y-%m-%d %H:%M:%S')
    elif not _explicit_files_mode and args.days != 0:
        # 完全未给时间参数：仅通配符批量/自动扫描目录时加载默认 1 天；
        # -d 0（关闭时间过滤）或 -f 具体文件模式不加载
        args.begin = (_now - timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')
    # 否则保持 None：无 begin 限制
if not args.end:
    if args.begin:
        # 未显式给 -e（begin 已由 -b 或折算确定）：end 自动补 now
        args.end = _now.strftime('%Y-%m-%d %H:%M:%S')
    # begin 为 None（时间过滤关闭）时 end 保持 None
