    export PYTHONIOENCODING=utf-8
local output_to_file=0
    local duration_threshold_sec=300
    local unique_id=""
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -o)
                output_to_file=1
                shift
                ;;
            -s)
                [ $# -lt 2 ] && { echo "Error: -s requires a value (seconds)" >&2; return 2; }
                duration_threshold_sec="$2"
                shift 2
                ;;
            --)
                shift
                break
                ;;
            -*)
                echo "Unknown option: $1" >&2
                return 1
                ;;
            *)
                if [[ -z "$unique_id" ]]; then
                    unique_id="$1"
                    shift
                else
                    echo "Error: extra argument $1" >&2
                    return 1
                fi
                ;;
        esac
    done
    
    if [[ -z "$unique_id" ]]; then
        echo "Error: unique_id required" >&2
        return 1
    fi
    
    local log_file=""
    if [[ $output_to_file -eq 1 ]]; then
        log_file="/tmp/vb_tool_sqlhc_${unique_id}_$(date +%Y%m%d_%H%M%S).txt"
        # save BOTH fds (old code kept only stderr on fd3 and never restored);
        # RETURN trap gives them back on any exit path of this function
        exec 3>&1 4>&2
        exec > "$log_file" 2>&1
        trap 'exec >&3 2>&4 3>&- 4>&-' RETURN
		echo "SQLHC ... Output saved to: $log_file" > /dev/tty
    fi

    local gauss_log
    gauss_log=$(env | grep -iw GAUSSLOG | cut -d'=' -f2)
    if [[ -z "$gauss_log" ]]; then
        echo "Error: not found GAUSSLOG path" >&2
        return 1
    fi
    if [[ ! -d "$gauss_log" ]]; then
        echo "Error: GAUSSLOG path not exits: $gauss_log" >&2
        return 1
    fi

    local logfiles
    logfiles=$(find "$gauss_log" \( -name "*.log" -o -name "*.log.gz" -o -name "*.csv" -o -name "*.csv.gz" \) -type f -printf '%T@ %p\n' 2>/dev/null | \
               sort -rn | \
               head -n 50 | \
               cut -d' ' -f2-)

    if [[ -z "$logfiles" ]]; then
        echo "Warning: $gauss_log not found postgresql log" >&2
        return 1
    fi

    # pre-filter by content: zgrep for .gz, grep for plain (grep treats gz as binary and misses)
    local grep_hits=""
    local _lf _hits_tmp
    _hits_tmp=$(mktemp /tmp/vb_tool_sqlhc_hits.XXXXXX)
    while IFS= read -r _lf; do
        [[ -z "$_lf" ]] && continue
        case "$_lf" in
            *.gz) zgrep -l "$unique_id" "$_lf" 2>/dev/null ;;
            *)    grep  -l "$unique_id" "$_lf" 2>/dev/null ;;
        esac
