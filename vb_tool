    TIME_DIMENSIONS = [
        {
            'id': 'minute',
            'name': '每分钟',
            'interval_minutes': 1,
            'always_show': True,
            'diff_threshold_minutes': 1
        },
        {
            'id': '10minute',
            'name': '每10分钟',
            'interval_minutes': 10,
            'always_show': True,
            'diff_threshold_minutes': 10
        },
        {
            'id': 'hour',
            'name': '每小时',
            'interval_minutes': 60,
            'always_show': True,
            'diff_threshold_minutes': 60
        },
        {
            'id': 'day',
            'name': '每天',
            'interval_minutes': 1440,
