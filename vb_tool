    """
    if not tables:
        if debug:
            print(f"[DEBUG] sqlhc tabsize: 表列表为空, db={db_name}", file=sys.stderr)
        return "No tables found."

    if debug:
        print(f"[DEBUG] sqlhc tabsize: db={db_name}, tables={tables}", file=sys.stderr)

    query = _build_sqlhc_tabsize_query(tables)

    if debug:
