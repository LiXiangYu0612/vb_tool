class ReportGenerator:
    """HTML报告生成器，整合汇总、分时段分析和详情展示。"""
    
    @staticmethod
    def _make_id_safe(unique_id):
        """生成URL/DOM安全ID：将HTML实体和特殊字符统一替换为下划线，避免href与DOM id不匹配。"""
        if unique_id is None:
            return ''
        return re.sub(r'[^a-zA-Z0-9_\-:.]', '_', str(unique_id).strip())

    @staticmethod
    def _resolve_lock_anchor_ts(event, all_events):
        """计算锁事件跳转锚点所用的 timestamp,与 Top10 锁事件表的合并逻辑保持一致。

        Top10 表会把同一次锁等待的 waiting+acquired 合并为一行,且行锚点的
        timestamp 取 waiting 的时间;而慢 SQL 详情侧 waiting/acquired 各展示一条。
        若直接沿用事件自身 timestamp,acquired 的锚点会指向不存在的时间,导致跳转失败。
        因此对 acquired 事件,在同组事件里查找同 lock_type+target 的最早 waiting 时间;
        waiting 或找不到配对时回退为事件自身 timestamp。
        """
        if event.get('type') != 'acquired':
            return str(event.get('timestamp', ''))
        lock_type = event.get('lock_type', '')
        target = event.get('target', '')
        waiting_ts = None
        for ev in all_events:
            if ev.get('type') != 'waiting':
                continue
            if ev.get('lock_type') != lock_type or ev.get('target') != target:
                continue
            ts = ev.get('timestamp', '')
            if waiting_ts is None or ts < waiting_ts:
                waiting_ts = ts
        return str(waiting_ts) if waiting_ts is not None else str(event.get('timestamp', ''))

    @staticmethod
    def _collect_top10_uids(stats_dict, topn=10):
        """收集 Top N 慢SQL 4个维度（总耗时/平均耗时/执行次数/最大耗时）去重后的 SQL ID。

        Args:
            stats_dict: 原始统计字典，key 为 unique_id
            topn: 每个维度取的 Top 数量，默认 10

        Returns:
            set: 去重后的 unique_query_id 集合
        """
        uids = set()
        stats_list_dml = [(uid, data) for uid, data in stats_dict.items() if data.get('sql_type') == 'dml']
        stats_list_ddl = [(uid, data) for uid, data in stats_dict.items() if data.get('sql_type') == 'ddl']
        for stats_list in [stats_list_dml, stats_list_ddl]:
            if not stats_list:
                continue
            sorted_lists = [
                sorted(stats_list, key=lambda x: x[1]['sum_duration'], reverse=True)[:topn],
                sorted(stats_list, key=lambda x: x[1]['avg_duration'], reverse=True)[:topn],
                sorted(stats_list, key=lambda x: x[1]['count'], reverse=True)[:topn],
                sorted(stats_list, key=lambda x: x[1]['max_duration'], reverse=True)[:topn],
            ]
            for sorted_list in sorted_lists:
                for uid, _ in sorted_list:
                    uids.add(uid)
        return uids

