        elif opt_params_info.get('error'):
            rows.append(('数据库版本', '<span class="ov-na">未获取（%s）</span>' % html.escape(str(opt_params_info['error']))))
        # ---- 错误统计 ----
        if statement_filter == 'query':
            # query 模式未提取错误日志，显示 N/A 并给出提示
            rows.append(('ERROR / WARNING / FATAL',
                         '<span class="ov-na">N/A（当前 --mode=query 模式未分析错误日志，如需分析请使用 --mode error 或 --mode all）</span>'))
            rows.append(('错误最多时段', '<span class="ov-na">N/A</span>'))
        else:
            level_counter, hour_counter = ReportGenerator._error_level_stats(error_list)
            n_error = level_counter.get('ERROR', 0)
            n_warning = level_counter.get('WARNING', 0)
            n_fatal = level_counter.get('FATAL', 0) + level_counter.get('PANIC', 0)
            err_cls = 'ov-bad' if (n_error or n_fatal) else ('ov-warn' if n_warning else '')
            rows.append(('ERROR / WARNING / FATAL',
                         '<span class="%s">%d / %d / %d 条</span>' % (err_cls, n_error, n_warning, n_fatal)))
            if hour_counter:
                peak_hour, peak_cnt = max(hour_counter.items(), key=lambda x: x[1])
                desc = ReportGenerator._describe_peak_hour(error_list, peak_hour)
                peak_txt = '%s 时段(%d 条' % (peak_hour, peak_cnt)
                peak_txt += ('，' + desc if desc else '') + ')'
                rows.append(('错误最多时段', '<span class="ov-bad">%s</span>' % html.escape(peak_txt)))
            else:
                rows.append(('错误最多时段', '无错误/警告记录'))

        # ---- 慢 SQL 统计（按 DQL/DDL 拆分） ----
        total_slow = len(all_total_list)
        dml_list = [item for item in all_total_list if item.get('sql_type') != 'ddl']
        ddl_list = [item for item in all_total_list if item.get('sql_type') == 'ddl']

        def _build_slow_sql_stats(items, label):
            """构建单个类型的慢 SQL 统计行(空数据下返回完整 4 行结构,保持报告一致性)"""
            if not items:
                return [
                    (f'{label} 慢 SQL 触发次数', '0 次'),
                    (f'{label} 慢 SQL 总耗时', '<span class="ov-na">无记录</span>'),
                    (f'{label} 慢 SQL 最多时段', '<span class="ov-na">无记录</span>'),
                    (f'{label} 最长慢语句', '<span class="ov-na">无记录</span>'),
                ]
            sub_rows = []
            total = len(items)
            durations = [item['duration'] for item in items]
            avg_dur = sum(durations) / total
            total_dur = sum(durations)
            sub_rows.append((f'{label} 慢 SQL 触发次数', f'{total} 次，平均 {avg_dur:.2f} s'))
            sub_rows.append((f'{label} 慢 SQL 总耗时', f'{total_dur:.2f} s'))
            slow_hours = defaultdict(int)
            for item in items:
                t = item.get('time')
                if t is not None:
                    slow_hours[t.strftime('%H:00')] += 1
            if slow_hours:
                ph, pc = max(slow_hours.items(), key=lambda x: x[1])
                sub_rows.append((f'{label} 慢 SQL 最多时段', f'<span class="ov-bad">{ph} 时段({pc} 条)</span>'))
            else:
                sub_rows.append((f'{label} 慢 SQL 最多时段', '<span class="ov-na">无有效时间</span>'))
            max_item = max(items, key=lambda x: x['duration'])
            sql_brief = re.sub(r'\s+', ' ', (max_item.get('qry_text') or '')).strip()[:80]
            t = max_item.get('time')
            sub_rows.append((f'{label} 最长慢语句',
                             f'<span class="ov-bad">{max_item["duration"]:.2f} s</span>，'
                             f'{t.strftime("%H:%M") if t is not None else "-"} 的 '
                             f'<span class="ov-sql" title="{html.escape(sql_brief, quote=True)}">{html.escape(sql_brief)}</span>'))
            return sub_rows

        # 无论是否有慢SQL记录,都展示完整栏目结构(总次数 + DQL 3 行 + DDL 3 行)
        if total_slow:
            _total_dur = sum(item['duration'] for item in all_total_list)
            _avg_dur = _total_dur / total_slow
            rows.append(('慢 SQL 触发', f'总次数: {total_slow} 次, 总耗时: {_total_dur:.2f} s, 平均耗时: {_avg_dur:.2f} s'))
        else:
            rows.append(('慢 SQL 触发', '总次数: 0 次, 总耗时: <span class="ov-na">无记录</span>, 平均耗时: <span class="ov-na">无记录</span>'))
        rows.extend(_build_slow_sql_stats(dml_list, 'DQL'))
        rows.extend(_build_slow_sql_stats(ddl_list, 'DDL'))

        body = ''.join(
            '<tr><td class="ov-label">%s</td><td class="ov-value">%s</td></tr>' % (k, v)
            for k, v in rows
        )
        return ('<div class="overview-box"><h3 class="overview-title">📋 汇总信息</h3>'
                '<table class="overview-table">%s</table></div>' % body)

    @staticmethod
    def generate_error_section(error_list, statement_filter='query'):
        """生成"错误日志分析"栏目 HTML(级别卡片 + 消息聚合 + 明细表)。"""
        if statement_filter == 'query':
            return """
            <section id="error-section">
                <h2>⚠️ 错误日志分析</h2>
                <p class="error-empty">当前 <code>--mode=query</code> 模式未分析错误日志。如需查看 ERROR / WARNING / FATAL / PANIC 记录，请使用 <code>--mode error</code> 或 <code>--mode all</code> 重新分析。</p>
            </section>
            """
        if not error_list:
            return """
            <section id="error-section">
                <h2>⚠️ 错误日志分析</h2>
                <p class="error-empty">日志中未发现 ERROR / WARNING / FATAL / PANIC 记录。</p>
            </section>
            """

        level_counter, hour_counter = ReportGenerator._error_level_stats(error_list)
        parts = ['<section id="error-section"><h2>⚠️ 错误日志分析</h2>']

        # ---- 1. 级别统计卡片 ----
        level_meta = [('ERROR', '#e74c3c'), ('WARNING', '#f39c12'),
                      ('FATAL', '#c0392b'), ('PANIC', '#8e44ad')]
        parts.append('<div class="summary-stats"><div class="stats-grid">')
        for lv, color in level_meta:
            cnt = level_counter.get(lv, 0)
            parts.append(f"""
                <div class="stat-item" style="border-left-color: {color};">
                    <span class="range-name">{lv}</span>
                    <span class="range-count">{cnt} 条</span>
                </div>
            """)
        # 错误最多时段卡片
        if hour_counter:
            peak_hour, peak_cnt = max(hour_counter.items(), key=lambda x: x[1])
            parts.append(f"""
                <div class="stat-item" style="border-left-color: #e67e22;">
                    <span class="range-name">错误最多时段</span>
                    <span class="range-count">{peak_hour}({peak_cnt} 条)</span>
                </div>
            """)
        parts.append('</div></div>')

        # ---- 2. 按 (level, 归一化消息) 全量聚合 ----
        groups = {}
        for e in error_list:
            key = (e['level'], ReportGenerator._normalize_error_msg(e['message']))
            g = groups.setdefault(key, {'count': 0, 'first': None, 'last': None,
                                        'users': set(), 'dbs': set()})
            g['count'] += 1
            t = e.get('time')
            if t is not None:
                if g['first'] is None or t < g['first']:
                    g['first'] = t
                if g['last'] is None or t > g['last']:
                    g['last'] = t
            if e.get('user'):
                g['users'].add(e['user'])
            if e.get('database'):
                g['dbs'].add(e['database'])
        # 按次数降序,作为基础排序(后续按级别再分流)
        sorted_groups = sorted(groups.items(), key=lambda kv: kv[1]['count'], reverse=True)

        # 按级别拆分:WARNING 单独走聚合表;ERROR/FATAL/PANIC 走聚合+明细
        warning_groups = [(k, v) for k, v in sorted_groups if k[0] == 'WARNING']
        critical_groups = [(k, v) for k, v in sorted_groups if k[0] in ('ERROR', 'FATAL', 'PANIC')]

        def _render_group_table(group_items, title, limit=None, more_note=True):
            """渲染消息聚合表。limit=None 表示全部展示。"""
            parts_html = [f'<h3>{title}(共 {len(group_items)} 类)</h3>']
            parts_html.append("""<table class="error-table error-group-table">
                <thead><tr>
                    <th>级别</th><th>次数</th><th>错误消息(归一化)</th>
                    <th>涉及用户</th><th>涉及数据库</th><th>首次出现</th><th>最近出现</th>
                </tr></thead><tbody>""")
            shown = group_items if limit is None else group_items[:limit]
            fmt = lambda t: t.strftime('%Y-%m-%d %H:%M:%S') if t else '-'
            for (lv, nmsg), g in shown:
                parts_html.append(f"""<tr>
                    <td><span class="err-lv err-lv-{lv}">{lv}</span></td>
                    <td>{g['count']}</td>
                    <td class="error-msg-cell">{html.escape(nmsg)}</td>
                    <td>{html.escape(', '.join(sorted(g['users'])) or '-')}</td>
                    <td>{html.escape(', '.join(sorted(g['dbs'])) or '-')}</td>
                    <td>{fmt(g['first'])}</td>
                    <td>{fmt(g['last'])}</td>
                </tr>""")
            parts_html.append('</tbody></table>')
            if more_note and limit and len(group_items) > limit:
                parts_html.append(f'<p class="error-more-note">仅显示前 {limit} 类,共 {len(group_items)} 类。</p>')
            return ''.join(parts_html)

        # ---- 2a. WARNING 聚合表(仅前 20 类,无明细) ----
        if warning_groups:
            parts.append(_render_group_table(
                warning_groups,
                title='WARNING 消息聚合(仅显示次数最多的前 20 类,无明细)',
                limit=20,
                more_note=True,
            ))

        # ---- 2b. ERROR/FATAL/PANIC 聚合表(全部展示) ----
        if critical_groups:
            parts.append(_render_group_table(
                critical_groups,
                title='ERROR / FATAL / PANIC 消息聚合(全部展示)',
                limit=None,
                more_note=False,
            ))

        # ---- 3. ERROR/FATAL/PANIC 明细表(按聚合组只保留首尾 2 条,标注执行编号) ----
        # WARNING 不进明细表(数量过大,只在聚合卡片查看)。仅 ERROR/FATAL/PANIC 走明细。
        critical_errors = [e for e in error_list if e['level'] in ('ERROR', 'FATAL', 'PANIC')]
        if critical_errors:
            sorted_all_errors = sorted(critical_errors,
                                        key=lambda e: e['time'] or datetime.min,
                                        reverse=True)
            visible_rows = 10

            # 按 (level, 归一化消息) 分组,每组只保留首尾两条
            first_last_rows = []  # [(seq_no, total, e), ...]  seq_no=该组内执行编号(1=最早,N=最近)
            for (lv, nmsg), g in critical_groups:
                group_errors = [e for e in critical_errors
                                if e['level'] == lv
                                and ReportGenerator._normalize_error_msg(e['message']) == nmsg]
                group_errors.sort(key=lambda e: e['time'] or datetime.min)
                total = len(group_errors)
                if total == 0:
                    continue
                pick_idx = [0] if total == 1 else [0, total - 1]
                for i in pick_idx:
                    first_last_rows.append((i + 1, total, group_errors[i]))

            # 明细表行按时间倒序展示
            first_last_rows.sort(key=lambda x: x[2]['time'] or datetime.min, reverse=True)

            parts.append(f"""
                <div class="error-detail-header">
                    <h3>错误明细(共 {len(sorted_all_errors)} 条 ERROR/FATAL/PANIC,按消息聚合后展示首尾 {len(first_last_rows)} 条)</h3>
                    <div class="search-box">
                        <input type="text" id="error-search" placeholder="输入错误消息关键词过滤..." onkeydown="if(event.key==='Enter')applyErrorSearch()" />
                        <button onclick="applyErrorSearch()" class="btn-confirm" title="确认搜索">✓</button>
                        <button onclick="resetErrorSearch()" class="btn-reset" title="重置搜索">✕</button>
                    </div>
                </div>
                <table class="error-table" id="error-detail-table">
                <thead><tr>
                    <th>#</th><th>时间</th><th>级别</th><th>用户</th>
                    <th>数据库</th><th>客户端</th><th>错误消息</th>
                </tr></thead><tbody>""")
            for idx, (seq_no, total, e) in enumerate(first_last_rows, 1):
                t = e.get('time')
                ts_txt = t.strftime('%Y-%m-%d %H:%M:%S') if t else e.get('timestamp', '-')
                row_cls = ' class="error-row-hidden"' if idx > visible_rows else ''
                msg_disp = html.escape(e['message'][:1000])

                # 构建前后3行日志上下文,首行追加执行编号说明(仅在详情展开后可见)
                seq_txt = f"第 {seq_no} 次 / 共 {total} 次执行"
                context_parts = [f"[执行编号] {seq_txt}"]
                for line in e.get('context_before', [])[-3:]:
                    context_parts.append(f"  {line}")
                context_parts.append(f"> {e.get('full_log', e['message'])}")
                for line in e.get('context_after', [])[:3]:
                    context_parts.append(f"  {line}")
                context_text = '\n'.join(context_parts)
                context_escaped = html.escape(context_text, quote=True)
                context_copy = html.escape(json.dumps(context_text, ensure_ascii=False), quote=True)

                parts.append(f"""<tr{row_cls}>
                    <td>{idx}</td>
                    <td>{ts_txt}</td>
                    <td><span class="err-lv err-lv-{e['level']}">{e['level']}</span></td>
                    <td>{html.escape(e.get('user') or '-')}</td>
                    <td>{html.escape(e.get('database') or '-')}</td>
                    <td>{html.escape(e.get('IP') or '-')}</td>
                    <td class="error-msg-cell">
                        <pre>{msg_disp}</pre>
                        <div class="error-action-btns">
                            <button class="error-detail-btn" onclick="toggleErrorDetail(this)" title="查看前后3行日志">详情</button>
                            <button class="copy-btn" data-copy-text="{context_copy}" onclick="copyToClipboard(this)" title="复制上下文日志">复制</button>
                        </div>
                        <div class="error-context-detail" style="display:none;">
                            <pre>{context_escaped}</pre>
                        </div>
                    </td>
                </tr>""")
            parts.append('</tbody></table>')
            total_rows = len(first_last_rows)
            if total_rows > visible_rows:
                parts.append(f"""
                <div class="expand-container" id="error-expand-container">
                    <button class="expand-btn" id="error-expand-btn" onclick="loadMoreErrorRows()">
                        加载更多 (剩余 {total_rows - visible_rows} 行)
                    </button>
                    <button class="expand-btn" id="error-expand-all-btn" onclick="toggleAllErrorRows()">
                        <span class="expand-text">展开全部</span>
                        <span class="collapse-text" style="display:none;">收起全部</span>
                    </button>
                </div>""")
            else:
                parts.append("""
                <div class="expand-container" id="error-expand-container" style="display:none;">
                    <button class="expand-btn" id="error-expand-btn" onclick="loadMoreErrorRows()">
                        加载更多
                    </button>
                    <button class="expand-btn" id="error-expand-all-btn" onclick="toggleAllErrorRows()">
                        <span class="expand-text">展开全部</span>
                        <span class="collapse-text" style="display:none;">收起全部</span>
                    </button>
                </div>""")
        parts.append('</section>')
        return ''.join(parts)

    @staticmethod
    def generate_deadlock_section(deadlock_list):
        """
        生成死锁分析HTML片段（合并为单一“死锁分析”表格）

        Args:
            deadlock_list: 死锁记录列表，每项为包含以下字段的字典：
                timestamp, process_a, txid_a, process_b, txid_b,
                lock_duration_ms, lock_type, sql_a, sql_b,
                unique_id_a, unique_id_b, related_lock_events, full_context

        Returns:
            str: HTML 字符串，如果没有死锁记录则返回空字符串
        """
        if not deadlock_list:
            return ''

        # 按发生时间排序并只显示最近10条死锁
        recent_deadlocks = sorted(deadlock_list, key=lambda x: x.get('timestamp', ''))[-10:]
        total_count = len(deadlock_list)

        html_parts = []
        html_parts.append(f"""
        <h3 id="deadlock-ranking">死锁分析</h3>
        <div class="top10-container deadlock-container">
            <div class="top10-section deadlock-section" data-sql-type="deadlock">
                <h4>死锁会话汇总（死锁：{total_count} 次，显示最近10条）</h4>
                <table class="top10-table deadlock-table">
                    <tr>
                        <th>序号</th>
                        <th>发生时间</th>
                        <th>会话信息(sessionid/txid)</th>
                        <th>Unique ID</th>
                        <th>SQL 摘要</th>
                        <th>锁类型</th>
                        <th>检测耗时 (ms)</th>
                        <th>相关日志</th>
                    </tr>
        """)

        for idx, item in enumerate(recent_deadlocks, 1):
            timestamp = html.escape(str(item.get('timestamp', '')), quote=True)
            process_a = html.escape(str(item.get('process_a', '')), quote=True)
            txid_a = html.escape(str(item.get('txid_a', '')), quote=True)
            process_b = html.escape(str(item.get('process_b', '')), quote=True)
            txid_b = html.escape(str(item.get('txid_b', '')), quote=True)
            unique_id_a = str(item.get('unique_id_a', '')).strip()
            unique_id_b = str(item.get('unique_id_b', '')).strip()
            lock_duration_ms = item.get('lock_duration_ms', 0)
            lock_type = html.escape(str(item.get('lock_type', '')), quote=True)
            sql_a = item.get('sql_a', '')
            sql_b = item.get('sql_b', '')
            related_lock_events = item.get('related_lock_events', [])
            full_context = item.get('full_context', '')

            # Unique ID 链接
            if unique_id_a:
                uid_a_escaped = html.escape(unique_id_a, quote=True)
                uid_a_safe = ReportGenerator._make_id_safe(unique_id_a)
                uid_a_link = f'<a href="#detail-{uid_a_safe}" class="uid-link" onclick="goToDetail(\'{uid_a_safe}\', event)">{uid_a_escaped}</a>'
            else:
                uid_a_link = '-'
            if unique_id_b:
                uid_b_escaped = html.escape(unique_id_b, quote=True)
                uid_b_safe = ReportGenerator._make_id_safe(unique_id_b)
                uid_b_link = f'<a href="#detail-{uid_b_safe}" class="uid-link" onclick="goToDetail(\'{uid_b_safe}\', event)">{uid_b_escaped}</a>'
            else:
                uid_b_link = '-'

            # SQL 摘要（截断显示，hover 通过 title 显示完整，仅显示 SQL 语句）
            sql_a_escaped = html.escape(sql_a, quote=True) if sql_a else '(未获取到 SQL)'
            sql_b_escaped = html.escape(sql_b, quote=True) if sql_b else '(未获取到 SQL)'
            sql_a_full = html.escape(sql_a, quote=True) if sql_a else ''
            sql_b_full = html.escape(sql_b, quote=True) if sql_b else ''
            sql_a_short = html.escape(sql_a[:30], quote=True) if sql_a else ''
            sql_b_short = html.escape(sql_b[:30], quote=True) if sql_b else ''
            sql_a_display = f"{sql_a_short}..." if len(sql_a) > 30 else sql_a_short
            sql_b_display = f"{sql_b_short}..." if len(sql_b) > 30 else sql_b_short
            sql_a_span = f'<span class="deadlock-sql-summary" title="{sql_a_full}"><strong>A:</strong> {sql_a_display}</span>' if sql_a else '<span class="deadlock-sql-summary"><strong>A:</strong> (未获取)</span>'
            sql_b_span = f'<span class="deadlock-sql-summary" title="{sql_b_full}"><strong>B:</strong> {sql_b_display}</span>' if sql_b else '<span class="deadlock-sql-summary"><strong>B:</strong> (未获取)</span>'
            sql_summary = f'{sql_a_span}<br>{sql_b_span}'

            full_context_escaped = html.escape(full_context, quote=True)
            full_context_copy = html.escape(json.dumps(full_context, ensure_ascii=False), quote=True)

            # 构建前3行日志上下文（死锁行之前的日志）
            dl_ctx_parts = []
            for line in item.get('context_before', [])[-3:]:
                dl_ctx_parts.append(f"  {line}")
            dl_context_text = '\n'.join(dl_ctx_parts)
            dl_context_escaped = html.escape(dl_context_text, quote=True)

            # 生成相关锁事件时间线 HTML
            lock_event_lines = []
            if related_lock_events:
                for ev in related_lock_events:
                    ev_ts = html.escape(str(ev.get('timestamp', '')), quote=True)
                    ev_type = ev.get('event_type', '')
                    ev_lock_type = html.escape(str(ev.get('lock_type', '')), quote=True)
                    ev_wait_ms = ev.get('wait_time_ms', 0)
                    ev_log = html.escape(str(ev.get('log_text', '')), quote=True)
                    type_label_map = {
                        'waiting': '锁等待',
                        'acquired': '锁获取',
                        'deadlock': '死锁检测'
                    }
                    type_label = type_label_map.get(ev_type, ev_type)
                    lock_event_lines.append(
                        f"<li><strong>[{ev_ts}] {type_label}</strong> {ev_lock_type} ({ev_wait_ms:.3f} ms)<br><pre>{ev_log}</pre></li>"
                    )
                lock_events_html = '<ul class="deadlock-lock-events">' + ''.join(lock_event_lines) + '</ul>'
            else:
                lock_events_html = '<p class="no-lock-events">未找到相关锁事件</p>'

            html_parts.append(f"""
                        <tr class="lock-summary-row">
                            <td>{idx}</td>
                            <td>{timestamp}</td>
                            <td class="deadlock-pid-col">
                                <strong>A:</strong> {process_a}/{txid_a}<br>
                                <strong>B:</strong> {process_b}/{txid_b}
                            </td>
                            <td>
                                <strong>A:</strong> {uid_a_link}<br>
                                <strong>B:</strong> {uid_b_link}
                            </td>
                            <td class="sql-text-col">
                                {sql_summary}
