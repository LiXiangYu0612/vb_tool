run_flamegraph() {
    local PID=""
    local TID=""
    local SLEEP=10
    # ★每次运行独立子目录 (2026-11-26 复核): 固定 /tmp/perf.data 会被并发会话
    #   互相覆盖; 上次以 root 跑过的残留 perf.data 属主 root, vastbase 的 perf
    #   record 打不开且 rm 不掉, 故障持续。产物路径形态不变(仍在 /tmp 下)。
    local OUTPUT_DIR=/tmp/vb_flame_$(date +'%Y%m%d_%H%M%S').$$
    mkdir -p "$OUTPUT_DIR" || { echo "Error: cannot create $OUTPUT_DIR" >&2; return 1; }
    local TS=$(date +'%Y%m%d_%H%M%S')
    local SVG_FILE="$OUTPUT_DIR/perf_$TS.svg"
    local SCRIPT_FILE="$OUTPUT_DIR/perf_$TS.script.txt"
    local REPORT_FILE="$OUTPUT_DIR/perf_$TS.report.txt"
    local TAR_FILE="$OUTPUT_DIR/perf_$TS.tar.gz"
    local FLAMEGRAPH_DIR
    FLAMEGRAPH_DIR=$(mktemp -d /tmp/flamegraph_tools_XXXXXX)

    # ---------- cleanup on exit ----------
    # trap 清工具目录与可能残留的 perf.data; OUTPUT_DIR(含成功交付物)保留,
    # 失败路径可能留下带部分产物的子目录——按运行命名隔离, 无害
    trap "rm -rf '$FLAMEGRAPH_DIR' '$OUTPUT_DIR/perf.data'" RETURN

    # ---------- parse options ----------
    local OPTIND=1
    while getopts "p:t:s:" opt; do
        case $opt in
            p) PID=$OPTARG ;;
            t) TID=$OPTARG ;;
            s) SLEEP=$OPTARG ;;
            *)
                echo "Error: unknown option -$OPTARG" >&2
                return 1
                ;;
        esac
    done

    if ! [[ "$SLEEP" =~ ^[0-9]+$ ]] || [ "$SLEEP" -lt 1 ]; then
        echo "Error: -s must be a positive integer" >&2
        return 1
    fi

    if [ -n "$PID" ] && ! [[ "$PID" =~ ^[0-9]+$ ]]; then
        echo "Error: -p must be a numeric PID" >&2
        return 1
    fi
    if [ -n "$TID" ] && ! [[ "$TID" =~ ^[0-9]+$ ]]; then
        echo "Error: -t must be a numeric TID" >&2
        return 1
    fi
    if [ -n "$TID" ] && [ -n "$PID" ]; then
        echo "Error: -p and -t are mutually exclusive" >&2
        return 1
    fi
    if [ -n "$TID" ] && [ ! -d "/proc/$TID/task/$TID" ]; then
        echo "Error: /proc/$TID/task/$TID not found (TID must be a thread id, not the process pid)" >&2
        return 1
    fi

    # ---------- check dependencies ----------
    if ! command -v perf >/dev/null 2>&1; then
        echo "Error: 'perf' not found. Please install linux-tools or perf package." >&2
        return 1
    fi
    if ! command -v perl >/dev/null 2>&1; then
        echo "Error: 'perl' not found." >&2
        return 1
    fi
    if ! command -v tar >/dev/null 2>&1; then
        echo "Error: 'tar' not found." >&2
        return 1
    fi

    # ---------- write embedded stackcollapse-perf.pl ----------
    cat > "$FLAMEGRAPH_DIR/stackcollapse-perf.pl" << 'STACKCOLLAPSE_EOF'
#!/usr/bin/perl -w
