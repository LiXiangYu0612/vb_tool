        lambda v: (v["seq_tup_read"][1] - v["seq_tup_read"][0]) + (v["idx_tup_fetch"][1] - v["idx_tup_fetch"][0]))
    def object_iostat_table(label, begin_rows, end_rows, mode, top=30,
                            idx_begin_rows=None, idx_end_rows=None):
        # object_iostat.csv <- dbe_perf.statio_all_tables (cumulative buffer
        # counters per table, system catalogs included; renderer computes end-begin). All buffer
        # traffic rolls up to the table row: heap + index (all its indexes) +
        # toast + toast index. Partitioned parents aggregate heap/index
        # kernel-side; their toast/tidx columns are NULL -> 0 (2026-10-15).
        # mode "logical" ranks by fetched (read+hit), "physical" by read only.
        # object_index_iostat.csv (statio_all_indexes, same key family) feeds
        # the First/Second/Third index columns: per-index window delta of the
        # SAME dimension, top-3 on the table, "index(value)", "-" when fewer
        # (user 2026-10-15).
        sub(label)
        def _key(r):
            return (r.get("dbname", ""), r.get("schema", ""), r.get("object", ""))
        def _phase_agg(rows):
            # (heap_l, index_l, toast_l, heap_p, index_p, toast_p) per key
            return {(r["dbname"], r["schema"], r["object"]):
                    (r["heap"], r["index"], r["toast"], r["pheap"], r["pindex"], r["ptoast"])
                    for r in object_iostat_rows(rows)}
        # a one-sided empty capture (older snapshot on one side) cannot be
        # delta'd -- rendering it would silently present full-cumulative
        # counters as a window delta
        if bool(begin_rows) != bool(end_rows):
            parts.append('<div class="note">no data (object I/O capture missing on one side of the window)</div>')
            return
        b, e = _phase_agg(begin_rows), _phase_agg(end_rows)
        _zero = (0,) * 6
        _d = {}
        for k in set(b) | set(e):
            _d[k] = tuple(y - x for x, y in zip(b.get(k, _zero), e.get(k, _zero)))
        _idx3 = (0, 1, 2) if mode == "logical" else (3, 4, 5)
        def _main(d):
            return d[0] + d[1] + d[2] if mode == "logical" else d[3] + d[4] + d[5]
        _tot_main = sum(_main(v) for v in _d.values())
        _rows = sorted(_d.items(), key=lambda kv: _main(kv[1]), reverse=True)[:top]
        if not _rows:
            parts.append('<div class="note">no data</div>')
            return
        # ---- per-index top-3: {(table_key, index_name): delta of the dim} ----
        _idx_cols = bool(idx_begin_rows) and bool(idx_end_rows)
        _idx_note = (bool(idx_begin_rows) != bool(idx_end_rows))
        _by_tbl = {}
        if _idx_cols:
            def _iagg(rows):
                out = {}
                for r in rows:
                    k = ((r.get("dbname", ""), r.get("schema", ""), r.get("object", "")),
                         r.get("index", ""))
                    br = to_num(r.get("idx_blks_read", 0) or 0); bh = to_num(r.get("idx_blks_hit", 0) or 0)
                    pv, lv = out.get(k, (0, 0))
                    out[k] = (pv + br, lv + bh + br)
                return out
            _ib = _iagg(idx_begin_rows); _ie = _iagg(idx_end_rows)
            for k in set(_ib) | set(_ie):
                v = _ie.get(k, (0, 0))[0 if mode == "physical" else 1] \
                    - _ib.get(k, (0, 0))[0 if mode == "physical" else 1]
                _by_tbl.setdefault(k[0], []).append((v, k[1]))
            for tk in _by_tbl:
                _by_tbl[tk].sort(key=lambda t: (-t[0], t[1]))
        def _idx_cells(k):
            # top-3 index cells: "name(value)"; "-" once the table runs out
            # of indexes (count-based -- an idle index still shows as name(0))
            t = _by_tbl.get(k, [])
            return ''.join('<td>%s(%s)</td>' % (esc(t[j][1]), fmt_int(t[j][0]))
                           if j < len(t) else '<td>-</td>' for j in range(3))
        def _pct(x, y):
            return "%.1f" % (x * 100.0 / y) if y > 0 else "0.0"
        _metric = "Logical Reads" if mode == "logical" else "Physical Reads"
        parts.append('<table class="t"><tr>'
            + ''.join('<th>%s</th>' % esc(c) for c in ("dbname", "schema", "object"))
            + '<th class="n">' + _metric + '</th><th class="n">%Total</th>'
              '<th class="n">Heap</th><th class="n">Index</th><th class="n">Toast</th>'
              '<th class="n">heap%</th><th class="n">index%</th><th class="n">toast%</th>'
            + ('<th>First index</th><th>Second index</th><th>Third index</th>' if _idx_cols else '')
            + '</tr>')
        for k, d in _rows:
            m = _main(d)
            parts.append('<tr>' + ''.join('<td>%s</td>' % esc(x) for x in k)
                + '<td class="n">%s</td>' % fmt_int(m)
                + '<td class="n">%s</td>' % _pct(m, _tot_main)
                + ''.join('<td class="n">%s</td>' % fmt_int(d[i]) for i in _idx3)
                + ''.join('<td class="n">%s</td>' % _pct(d[i], m) for i in _idx3)
                + (_idx_cells(k) if _idx_cols else '')
                + '</tr>')
        parts.append('</table>')
        if _idx_note:
            parts.append('<div class="note">index detail skipped: per-index capture '
                         'missing on one side of the window (older snapshot)</div>')
    object_iostat_table("Top Tables by Logical Reads",
        win["db"].get(("begin", "object_iostat"), []),
        win["db"].get(("end", "object_iostat"), []), "logical",
        idx_begin_rows=win["db"].get(("begin", "object_index_iostat"), []),
        idx_end_rows=win["db"].get(("end", "object_index_iostat"), []))
    object_iostat_table("Top Tables by Physical Reads",
