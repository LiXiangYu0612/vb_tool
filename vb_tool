        if [[ "$input" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})[[:space:]]+([0-9]{1,2}):([0-9]{1,2})$ ]]; then
            local date_part="${BASH_REMATCH[1]}"
            local hour_part="${BASH_REMATCH[2]}"
            local minute_part="${BASH_REMATCH[3]}"
            if [ "$hour_part" -ge 0 ] && [ "$hour_part" -le 23 ] && [ "$minute_part" -ge 0 ] && [ "$minute_part" -le 59 ]; then
                printf -v hour_part "%02d" "$((10#$hour_part))"
                printf -v minute_part "%02d" "$((10#$minute_part))"
                result="$date_part $hour_part:$minute_part:00"
                echo "$result"
                return 0
            else
                echo "Error: Invalid hour or minute value: $hour_part:$minute_part" >&2
                return 1
            fi
        fi
        
        if [[ "$input" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]]+([0-9]{2}):([0-9]{2}):([0-9]{2})$ ]]; then
            local hour_part="${BASH_REMATCH[1]}"
            local minute_part="${BASH_REMATCH[2]}"
            local second_part="${BASH_REMATCH[3]}"
            if [ "$hour_part" -ge 0 ] && [ "$hour_part" -le 23 ] && \
               [ "$minute_part" -ge 0 ] && [ "$minute_part" -le 59 ] && \
               [ "$second_part" -ge 0 ] && [ "$second_part" -le 59 ]; then
                echo "$input"
                return 0
            else
                echo "Error: Invalid time value: $hour_part:$minute_part:$second_part" >&2
                return 1
            fi
        fi
        
        if [[ "$input" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
            result="$input 00:00:00"
            echo "$result"
            return 0
        fi
        
        echo "Error: Invalid time format: $input" >&2
        return 1
    }
    
    if [ -z "$begin_time" ] && [ -z "$end_time" ]; then
        begin_time=$(date +'%Y-%m-%d 00:00:00')
        end_time=$(date -d 'tomorrow 00:00:00' +'%Y-%m-%d %H:%M:%S')
    else
        begin_time=$(format_time "$begin_time")
        if [ $? -ne 0 ]; then
            return 1
        fi
        
        end_time=$(format_time "$end_time")
        if [ $? -ne 0 ]; then
            return 1
        fi
    fi
    
    local query_begin=$(date -d "$begin_time 1 hour ago" +'%Y-%m-%d %H:%M:%S')
    local query_end=$(date -d "$end_time 1 hour" +'%Y-%m-%d %H:%M:%S')
    
    psql -d postgres -P footer=off <<EOF
\echo '===================='
\echo 'wdr workload summary'
\echo '===================='
\echo '                          '
with grt as (
   select r.snapshot_id, max(r.snap_reset_time) gen
   from (select distinct snapshot_id, snap_node_name, snap_reset_time
         from snapshot.snap_global_record_reset_time) r
   group by r.snapshot_id),
time_range as (
   select a.snapshot_id,
           to_char(lag(a.start_ts) over(order by a.snapshot_id),'mmdd hh24:mi')||'-'||to_char(a.start_ts,'hh24:mi') time_range,
           trunc(extract(epoch from (a.start_ts - lag(a.start_ts) over(order by a.snapshot_id)))) el,
           case when lag(gen) over(order by a.snapshot_id) IS NOT DISTINCT FROM gen then 1 end valid_gen
    from snapshot.snapshot a join grt on a.snapshot_id = grt.snapshot_id
  where start_ts >= '$query_begin'::timestamp and start_ts <= '$query_end'::timestamp),
time_model as (
select snapshot_id,
round(sum(decode(snap_stat_name,'DB_TIME',stat_value,0))/1e6,1) db_time,
round(sum(decode(snap_stat_name,'CPU_TIME',stat_value,0))/1e6,1) cpu_time,
round(sum(decode(snap_stat_name,'DATA_IO_TIME',stat_value,0))/1e6,1) data_io_time,
round(sum(decode(snap_stat_name,'EXECUTION_TIME',stat_value,0))/1e6,1) execution_time,
round(sum(decode(snap_stat_name,'PL_EXECUTION_TIME',stat_value,0))/1e6,1) pl_execution_time,
round(sum(decode(snap_stat_name,'PLAN_TIME',stat_value,0))/1e6,1) plan_time,
round(sum(decode(snap_stat_name,'REWRITE_TIME',stat_value,0))/1e6,1) rewrite_time,
round(sum(decode(snap_stat_name,'PARSE_TIME',stat_value,0))/1e6,1) parse_time,
round(sum(decode(snap_stat_name,'PL_COMPILATION_TIME',stat_value,0))/1e6,1) pl_compilation_time,
round(sum(decode(snap_stat_name,'NET_SEND_TIME',stat_value,0))/1e6,1) net_send_time
from (select snapshot_id,snap_stat_name,
        case when lag(snap_value) over pw IS NOT NULL and snap_value >= lag(snap_value) over pw
             then snap_value - lag(snap_value) over pw end stat_value
      from snapshot.snap_global_instance_time
      window pw as (partition by snap_node_name,snap_stat_name order by snapshot_id))
group by snapshot_id),
tps as (
select snapshot_id,
       case when bool_or(prev_reset IS NOT NULL AND prev_reset IS DISTINCT FROM rst) then null
            else sum(case when d_trans >= 0 then d_trans end) end total_trans,
       case when bool_or(prev_reset IS NOT NULL AND prev_reset IS DISTINCT FROM rst) then null
            else sum(case when d_cr >= 0 then d_cr end) end total_cr,
       case when bool_or(prev_reset IS NOT NULL AND prev_reset IS DISTINCT FROM rst) then null
            else sum(case when d_hit >= 0 then d_hit end) end total_hit
from (select snapshot_id,snap_datname,
         lag(snap_stats_reset) over w prev_reset,
         snap_stats_reset rst,
         (snap_xact_commit+snap_xact_rollback) - lag(snap_xact_commit+snap_xact_rollback) over w d_trans,
         snap_blks_read - lag(snap_blks_read) over w d_cr,
         snap_blks_hit - lag(snap_blks_hit) over w d_hit
      from snapshot.snap_summary_stat_database
      window w as (partition by snap_datname order by snapshot_id))
group by snapshot_id),
sql as (
select snapshot_id,
       case when n_calls>=lag(n_calls)over(order by snapshot_id) then n_calls-lag(n_calls)over(order by snapshot_id) end calls,
       case when parse>=lag(parse)over(order by snapshot_id) then parse-lag(parse)over(order by snapshot_id) end parse,
       case when hard>=lag(hard)over(order by snapshot_id) then hard-lag(hard)over(order by snapshot_id) end hard
from (select snapshot_id,sum(snap_n_calls) n_calls,sum(snap_n_soft_parse+snap_n_hard_parse) parse,sum(snap_n_hard_parse) hard from snapshot.snap_summary_statement group by snapshot_id)),
iops as (
select snapshot_id,
       case when snap_phyrds>=lag(snap_phyrds)over(order by snapshot_id) then snap_phyrds-lag(snap_phyrds)over(order by snapshot_id) end snap_phyrds,
       case when snap_phywrts>=lag(snap_phywrts)over(order by snapshot_id) then snap_phywrts-lag(snap_phywrts)over(order by snapshot_id) end snap_phywrts,
       case when snap_phyblkrd>=lag(snap_phyblkrd)over(order by snapshot_id) then snap_phyblkrd-lag(snap_phyblkrd)over(order by snapshot_id) end snap_phyblkrd,
       case when snap_phyblkwrt>=lag(snap_phyblkwrt)over(order by snapshot_id) then snap_phyblkwrt-lag(snap_phyblkwrt)over(order by snapshot_id) end snap_phyblkwrt
                from (select snapshot_id,sum(snap_phyrds) snap_phyrds,sum(snap_phywrts) snap_phywrts,sum(snap_phyblkrd) snap_phyblkrd,sum(snap_phyblkwrt) snap_phyblkwrt from snapshot.snap_summary_file_iostat group by snapshot_id)),
redo as (
select snapshot_id,
       case when redo_phywrts>=lag(redo_phywrts)over(order by snapshot_id) then redo_phywrts-lag(redo_phywrts)over(order by snapshot_id) end redo_phywrts,
       case when redo_phyblkwrt>=lag(redo_phyblkwrt)over(order by snapshot_id) then redo_phyblkwrt-lag(redo_phyblkwrt)over(order by snapshot_id) end redo_phyblkwrt
from (select snapshot_id,sum(snap_phywrts) as redo_phywrts, sum(snap_phyblkwrt) as redo_phyblkwrt from snapshot.snap_summary_file_redo_iostat group by snapshot_id))
select /*+leading(t1 t2 t3 t4 t5 t6) set(rewrite_rule 'magicset,predpushnormal')*/time_range,round(db_time/60,1) dbtime,round(case when el>0 then db_time/el end,1) aas,round(cpu_time/60,1) cputime,round(data_io_time/60,1) iotime,round(case when el>0 then total_trans/el end,1) tps,round(case when el>0 then total_cr/el end,1) "cr/s",round(case when el>0 then (snap_phyrds+snap_phywrts)/el end,1) iops,round(case when el>0 then (snap_phyblkrd+snap_phyblkwrt)*8.0/1024/el end,1) mbps,round(case when el>0 then redo_phyblkwrt*8.0/1024/el end,1) "wal_mb/s",round(case when el>0 then calls/el end,1) "call/s",round(case when el>0 then parse/el end,1) "parse/s",round(case when el>0 then hard/el end,1) "hard/s"
from time_range t1,time_model t2,tps t3,iops t4,redo t5,sql t6
where t1.snapshot_id=t2.snapshot_id
  and t1.snapshot_id=t3.snapshot_id
  and t1.snapshot_id=t4.snapshot_id
  and t1.snapshot_id=t5.snapshot_id
  and t1.snapshot_id=t6.snapshot_id
  and db_time>0 and length(time_range)>15 and valid_gen=1 order by 1 desc;
EOF
}


run_wdr_event() {
    local begin_time=""
    local end_time=""
    local event_name=""
    local found_b=0
    local found_e=0

    while [[ $# -gt 0 ]]; do
        case $1 in
            -b)
                shift
                if [[ $# -eq 0 || "$1" =~ ^- ]]; then
                    echo "Error: -b requires a value" >&2
                    return 1
                fi
                if [[ ! "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2} ]]; then
                    echo "Error: Invalid time format for -b: $1" >&2
                    return 1
                fi
                begin_time="$1"
                found_b=1
                shift
                if [[ $# -gt 0 && "$1" =~ ^[0-9]{1,2}$ ]]; then
                    echo "Error: Time value with space not quoted: -b $begin_time $1" >&2
                    echo "  Please quote time values with spaces: -b \"$begin_time $1\"" >&2
                    return 1
                fi
                if [[ $# -gt 0 && "$1" =~ ^[0-9]{1,2}:[0-9]{1,2}$ ]]; then
                    echo "Error: Time value with space not quoted: -b $begin_time $1" >&2
                    echo "  Please quote time values with spaces: -b \"$begin_time $1\"" >&2
                    return 1
                fi
                ;;
            -E)
                shift
                if [[ $# -eq 0 || "$1" =~ ^- ]]; then
                    echo "Error: -E requires an event name" >&2
                    return 1
                fi
                event_name="$1"
                shift
                if [[ "$event_name" == *"'"* ]]; then
                    echo "Error: event name cannot contain single quotes: $event_name" >&2
                    return 1
                fi
                if [[ $# -gt 0 && ! "$1" =~ ^- ]]; then
                    echo "Error: Event name with space not quoted: -E $event_name $1" >&2
                    echo "  Please quote event names with spaces: -E \"$event_name $1\"" >&2
                    return 1
                fi
                ;;
            -e)
                shift
                if [[ $# -eq 0 || "$1" =~ ^- ]]; then
                    echo "Error: -e requires a value" >&2
                    return 1
                fi
                if [[ ! "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2} ]]; then
                    echo "Error: Invalid time format for -e: $1" >&2
                    return 1
                fi
                end_time="$1"
                found_e=1
                shift
                if [[ $# -gt 0 && "$1" =~ ^[0-9]{1,2}$ ]]; then
                    echo "Error: Time value with space not quoted: -e $end_time $1" >&2
                    echo "  Please quote time values with spaces: -e \"$end_time $1\"" >&2
                    return 1
                fi
                if [[ $# -gt 0 && "$1" =~ ^[0-9]{1,2}:[0-9]{1,2}$ ]]; then
                    echo "Error: Time value with space not quoted: -e $end_time $1" >&2
                    echo "  Please quote time values with spaces: -e \"$end_time $1\"" >&2
                    return 1
                fi
                ;;
            -*)
                echo "Error: Unknown option: $1" >&2
                return 1
                ;;
            *)
                shift
                ;;
        esac
    done
    
    if [ $found_b -ne $found_e ]; then
        echo "Error: Both -b and -e parameters are required when specifying time" >&2
        return 1
    fi
    
    format_time() {
        local input="$1"
        local result=""
        
        if [ -z "$input" ]; then
            echo "Error: Time parameter cannot be empty" >&2
            return 1
        fi
        
        input=$(echo "$input" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
        
        if [[ "$input" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})[[:space:]]+([0-9]{1,2})$ ]]; then
            local date_part="${BASH_REMATCH[1]}"
            local hour_part="${BASH_REMATCH[2]}"
            if [ "$hour_part" -ge 0 ] && [ "$hour_part" -le 23 ]; then
                printf -v hour_part "%02d" "$((10#$hour_part))"
                result="$date_part $hour_part:00:00"
                echo "$result"
                return 0
            else
                echo "Error: Hour must be between 0 and 23: $hour_part" >&2
                return 1
            fi
        fi
        
        if [[ "$input" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})[[:space:]]+([0-9]{1,2}):([0-9]{1,2})$ ]]; then
            local date_part="${BASH_REMATCH[1]}"
            local hour_part="${BASH_REMATCH[2]}"
            local minute_part="${BASH_REMATCH[3]}"
            if [ "$hour_part" -ge 0 ] && [ "$hour_part" -le 23 ] && [ "$minute_part" -ge 0 ] && [ "$minute_part" -le 59 ]; then
                printf -v hour_part "%02d" "$((10#$hour_part))"
                printf -v minute_part "%02d" "$((10#$minute_part))"
                result="$date_part $hour_part:$minute_part:00"
                echo "$result"
                return 0
            else
                echo "Error: Invalid hour or minute value: $hour_part:$minute_part" >&2
                return 1
            fi
        fi
        
        if [[ "$input" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]]+([0-9]{2}):([0-9]{2}):([0-9]{2})$ ]]; then
            local hour_part="${BASH_REMATCH[1]}"
            local minute_part="${BASH_REMATCH[2]}"
            local second_part="${BASH_REMATCH[3]}"
            if [ "$hour_part" -ge 0 ] && [ "$hour_part" -le 23 ] && \
               [ "$minute_part" -ge 0 ] && [ "$minute_part" -le 59 ] && \
               [ "$second_part" -ge 0 ] && [ "$second_part" -le 59 ]; then
                echo "$input"
                return 0
            else
                echo "Error: Invalid time value: $hour_part:$minute_part:$second_part" >&2
                return 1
            fi
        fi
        
        if [[ "$input" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
            result="$input 00:00:00"
            echo "$result"
            return 0
        fi
        
        echo "Error: Invalid time format: $input" >&2
        return 1
    }
    
    if [ -z "$begin_time" ] && [ -z "$end_time" ]; then
        if [ -n "$event_name" ]; then
            begin_time=$(date -d '7 days ago' +'%Y-%m-%d 00:00:00')
        else
            begin_time=$(date +'%Y-%m-%d 00:00:00')
        fi
        end_time=$(date -d 'tomorrow 00:00:00' +'%Y-%m-%d %H:%M:%S')
    else
        begin_time=$(format_time "$begin_time")
        if [ $? -ne 0 ]; then
            return 1
        fi
        
        end_time=$(format_time "$end_time")
        if [ $? -ne 0 ]; then
            return 1
        fi
    fi
    
    if [ -n "$event_name" ]; then
        run_wdr_event_hist "$event_name" "$begin_time" "$end_time"
        return $?
    fi

    local query_begin=$(date -d "$begin_time 1 hour ago" +'%Y-%m-%d %H:%M:%S')
    local query_end=$(date -d "$end_time 1 hour" +'%Y-%m-%d %H:%M:%S')
    
    psql -d postgres -P footer=off <<EOF
\echo '===================='
\echo 'wdr topevent summary'
\echo '===================='
\echo '                          '
with grt as (
    select r.snapshot_id, max(r.snap_reset_time) gen
    from (select distinct snapshot_id, snap_node_name, snap_reset_time
          from snapshot.snap_global_record_reset_time) r
    group by r.snapshot_id),
time_range as (
    select snapshot_id, time_range, el
    from (
        select a.snapshot_id,
               to_char(lag(a.start_ts) over(order by a.snapshot_id),'mmdd hh24:mi')||'-'||to_char(a.start_ts,'hh24:mi') time_range,
               trunc(extract(epoch from (a.start_ts - lag(a.start_ts) over(order by a.snapshot_id)))) el,
               case when lag(gen) over(order by a.snapshot_id) IS NOT DISTINCT FROM gen then 1 end valid_gen
        from snapshot.snapshot a join grt on a.snapshot_id = grt.snapshot_id
        where start_ts >= '$query_begin'::timestamp and start_ts <= '$query_end'::timestamp
    ) t
    where length(time_range)>15 and valid_gen=1
),
time_model as (
    select snapshot_id,
    sum(decode(snap_stat_name,'DB_TIME',stat_value,0)) db_time,
    sum(decode(snap_stat_name,'CPU_TIME',stat_value,0)) cpu_time
    from (select snapshot_id,snap_stat_name,
          snap_value-lag(snap_value)over(partition by snap_node_name,snap_stat_name order by snapshot_id) stat_value
              from snapshot.snap_global_instance_time)
    group by snapshot_id
),
all_events as (
    select snapshot_id, 'CPU time' as event, '' as event_type,cpu_time as wait_time, null as waits, 1 as is_cpu
    from time_model
    
    union all
    
    select snapshot_id, event, event_type,wait_time, waits, 0 as is_cpu
    from (
        select snapshot_id, event, event_type,wait_time, waits,
               row_number() over(partition by snapshot_id order by wait_time desc) rn
        from (
            select e.snapshot_id, e.snap_event as event, e.snap_type as event_type,
                   case when lag(e.snap_total_wait_time) over pw IS NOT NULL
                             and e.snap_total_wait_time - lag(e.snap_total_wait_time) over pw >= 0
                        then e.snap_total_wait_time - lag(e.snap_total_wait_time) over pw end wait_time,
                   case when lag(e.snap_wait) over pw IS NOT NULL
                             and e.snap_wait - lag(e.snap_wait) over pw > 0
                        then e.snap_wait - lag(e.snap_wait) over pw end waits
            from snapshot.snap_global_wait_events e
            where snap_event not in ('none','wait cmd')
            window pw as (partition by e.snap_event order by e.snapshot_id)
        ) where waits > 0
    ) where rn <= 9
),
ranked_events as (
    select snapshot_id, event,event_type, wait_time, waits, is_cpu,
           row_number() over(partition by snapshot_id order by wait_time desc) as rn
    from all_events 
)
select /*+set(enable_mergejoin off) set(enable_nestloop off) set(enable_index_nestloop off)*/time_range, round(db_time/1e6,1) db_time_s, 
       event, 
       event_type,
       round(wait_time/1e6,1) wait_time_s, 
       waits, 
       case when is_cpu = 1 then null else round(wait_time/waits/1e3,1) end as avg_wait_ms,
       round(case when db_time>0 then 100*(wait_time/db_time) end,1)||'%' db_time_pct
from time_range a, time_model b, ranked_events c 
where a.snapshot_id = b.snapshot_id 
  and a.snapshot_id = c.snapshot_id
  and c.rn<=5
order by a.time_range, c.rn;
EOF
}

run_wdr_event_hist() {
    local event_name="$1"
    local begin_time="$2"
    local end_time="$3"
    local query_begin=$(date -d "$begin_time 1 hour ago" +'%Y-%m-%d %H:%M:%S')
    local query_end=$(date -d "$end_time 1 hour" +'%Y-%m-%d %H:%M:%S')
    local snap_cnt ev_cnt delta_cnt

    # ---- level 0: window has any wdr snapshot ----
    if ! snap_cnt=$(psql -d postgres -tAc "select count(*) from snapshot.snapshot where start_ts >= '$query_begin'::timestamp and start_ts <= '$query_end'::timestamp"); then
        echo "Error: wdr snapshot check query failed" >&2
        return 1
    fi
    if [ "$snap_cnt" -eq 0 ]; then
        echo "Error: no wdr snapshots in window $begin_time ~ $end_time" >&2
        return 1
    fi

    # ---- level 1: event row exists in window ----
    if ! ev_cnt=$(psql -d postgres -tAc "select count(*) from snapshot.snap_global_wait_events e join snapshot.snapshot s on e.snapshot_id = s.snapshot_id where s.start_ts >= '$query_begin'::timestamp and s.start_ts <= '$query_end'::timestamp and lower(e.snap_event) = lower('$event_name')"); then
        echo "Error: wdr event check query failed" >&2
        return 1
    fi
    if [ "$ev_cnt" -eq 0 ]; then
        echo "Error: event '$event_name' not found in wdr snapshots (window $begin_time ~ $end_time)" >&2
        echo "Top wait events in this window:" >&2
        psql -d postgres -P footer=off <<EOF
with ev as (
    select snap_event, wait_time, waits
    from (
        select e.snapshot_id, e.snap_event,
               case when lag(e.snap_total_wait_time) over pw IS NOT NULL
                         and e.snap_total_wait_time - lag(e.snap_total_wait_time) over pw >= 0
                    then e.snap_total_wait_time - lag(e.snap_total_wait_time) over pw end wait_time,
               case when lag(e.snap_wait) over pw IS NOT NULL
                         and e.snap_wait - lag(e.snap_wait) over pw > 0
                    then e.snap_wait - lag(e.snap_wait) over pw end waits
        from snapshot.snap_global_wait_events e
        where snap_event not in ('none','wait cmd')
        window pw as (partition by e.snap_event order by e.snapshot_id)
    ) d where waits > 0
)
select snap_event, sum(waits) waits, round(sum(wait_time)/1e6,3) total_wait_s
from ev group by snap_event order by sum(wait_time) desc limit 20;
EOF
        return 1
    fi

    # ---- level 2: any waits delta rows ----
    if ! delta_cnt=$(psql -d postgres -tAc "
with grt as (
    select r.snapshot_id, max(r.snap_reset_time) gen
    from (select distinct snapshot_id, snap_node_name, snap_reset_time
          from snapshot.snap_global_record_reset_time) r
    group by r.snapshot_id),
tr as (
    select snapshot_id from (
        select a.snapshot_id,
               case when lag(gen) over(order by a.snapshot_id) IS NOT DISTINCT FROM gen then 1 end valid_gen
        from snapshot.snapshot a join grt on a.snapshot_id = grt.snapshot_id
        where start_ts >= '$query_begin'::timestamp and start_ts <= '$query_end'::timestamp
    ) t where valid_gen = 1
),
ev as (
    select snapshot_id, waits from (
        select e.snapshot_id,
               case when lag(e.snap_wait) over pw IS NOT NULL
                         and e.snap_wait - lag(e.snap_wait) over pw > 0
                    then e.snap_wait - lag(e.snap_wait) over pw end waits
        from snapshot.snap_global_wait_events e
        where lower(snap_event) = lower('$event_name')
          and snap_event not in ('none','wait cmd')
        window pw as (partition by e.snap_event order by e.snapshot_id)
    ) d where waits > 0
)
select count(*) from tr join ev on tr.snapshot_id = ev.snapshot_id"); then
        echo "Error: wdr delta check query failed" >&2
        return 1
    fi
    if [ "$delta_cnt" -eq 0 ]; then
        echo "Note: event '$event_name' exists in snapshots but has no waits delta in window $begin_time ~ $end_time" >&2
        return 0
    fi

    # ---- main: detail + TOTAL, then max line ----
    psql -d postgres -P footer=off <<EOF
\echo ====================
\echo wdr event history: '$event_name'  (window $begin_time ~ $end_time)
\echo ====================
with grt as (
    select r.snapshot_id, max(r.snap_reset_time) gen
    from (select distinct snapshot_id, snap_node_name, snap_reset_time
          from snapshot.snap_global_record_reset_time) r
    group by r.snapshot_id),
time_range as (
    select snapshot_id, time_range
    from (
        select a.snapshot_id,
               to_char(lag(a.start_ts) over(order by a.snapshot_id),'mmdd hh24:mi')||'-'||to_char(a.start_ts,'hh24:mi') time_range,
               case when lag(gen) over(order by a.snapshot_id) IS NOT DISTINCT FROM gen then 1 end valid_gen
        from snapshot.snapshot a join grt on a.snapshot_id = grt.snapshot_id
        where start_ts >= '$query_begin'::timestamp and start_ts <= '$query_end'::timestamp
    ) t
    where length(time_range)>15 and valid_gen=1
),
time_model as (
    select snapshot_id, sum(decode(snap_stat_name,'DB_TIME',stat_value,0)) db_time
    from (select snapshot_id,snap_stat_name,
                 snap_value-lag(snap_value)over(partition by snap_node_name,snap_stat_name order by snapshot_id) stat_value
          from snapshot.snap_global_instance_time)
    group by snapshot_id
),
ev as (
    select snapshot_id, wait_time, waits
    from (
        select e.snapshot_id,
               case when lag(e.snap_total_wait_time) over pw IS NOT NULL
                         and e.snap_total_wait_time - lag(e.snap_total_wait_time) over pw >= 0
                    then e.snap_total_wait_time - lag(e.snap_total_wait_time) over pw end wait_time,
               case when lag(e.snap_wait) over pw IS NOT NULL
                         and e.snap_wait - lag(e.snap_wait) over pw > 0
                    then e.snap_wait - lag(e.snap_wait) over pw end waits
        from snapshot.snap_global_wait_events e
        where lower(snap_event) = lower('$event_name')
          and snap_event not in ('none','wait cmd')
        window pw as (partition by e.snap_event order by e.snapshot_id)
    ) d where waits > 0
),
j as (
    select a.snapshot_id, a.time_range, b.db_time, c.wait_time, c.waits
    from time_range a join time_model b on a.snapshot_id = b.snapshot_id
    join ev c on a.snapshot_id = c.snapshot_id
)
select /*+set(enable_mergejoin off) set(enable_nestloop off) set(enable_index_nestloop off)*/
       time_range, round(db_time/1e6,1) db_time_s, waits,
       round(wait_time/1e6,1) wait_time_s, round(wait_time/waits/1e3,1) avg_wait_ms
from j
union all
select 'TOTAL (N='||count(*)||')', round(sum(db_time)/1e6,1), sum(waits), round(sum(wait_time)/1e6,1), round(sum(wait_time)/sum(waits)/1e3,1)
from j
order by 1;
\echo
with ev as (
    select snapshot_id, wait_time, waits
    from (
        select e.snapshot_id,
               case when lag(e.snap_total_wait_time) over pw IS NOT NULL
                         and e.snap_total_wait_time - lag(e.snap_total_wait_time) over pw >= 0
                    then e.snap_total_wait_time - lag(e.snap_total_wait_time) over pw end wait_time,
               case when lag(e.snap_wait) over pw IS NOT NULL
                         and e.snap_wait - lag(e.snap_wait) over pw > 0
                    then e.snap_wait - lag(e.snap_wait) over pw end waits
        from snapshot.snap_global_wait_events e
        where lower(snap_event) = lower('$event_name')
        window pw as (partition by e.snap_event order by e.snapshot_id)
    ) d where waits > 0
),
time_range as (
    select snapshot_id, time_range from (
        select a.snapshot_id,
               to_char(lag(a.start_ts) over(order by a.snapshot_id),'mmdd hh24:mi')||'-'||to_char(a.start_ts,'hh24:mi') time_range
        from snapshot.snapshot a
        where start_ts >= '$query_begin'::timestamp and start_ts <= '$query_end'::timestamp
    ) t where length(time_range)>15
)
select 'max avg_wait_ms: '||round((wait_time/waits)/1e3,1)||'  @ '||time_range as "max avg_wait"
from ev join time_range using(snapshot_id)
order by wait_time/waits desc limit 1;
EOF
    return 0
}



