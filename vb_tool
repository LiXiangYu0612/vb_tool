                         '<label class="search-exclude-label"><input type="checkbox" id="detail-search-regex" onchange="applyDetailFilters()">正则</label>'
                         '<input type="text" id="detail-search" placeholder="输入关键词过滤..." onkeydown="if(event.key===\'Enter\')applyDetailFilters()" />'
                         '<label>用户:</label><div class="multi-filter" data-filter-kind="user" data-table="detail-table" id="detail-filter-user"></div>'
                         '<label>数据库:</label><div class="multi-filter" data-filter-kind="db" data-table="detail-table" id="detail-filter-db"></div>'
                         '<a href="#top10-ranking" class="back-to-top" title="返回Top 10排名" onclick="collapseAllDetails()">↑ Top 10</a>'
                         '</div></div>')
        detail_html_parts = [detail_header + '<table class="detail-table" id="detail-table"><thead>']
        detail_html_parts.append("""
        <tr>
            <th>Unique ID<span class="col-divider"></span></th>
