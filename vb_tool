    'limit', 'offset', 'fetch', 'next', 'rows', 'only', 'row', 'partition',
    'over', 'window', 'filter', 'within', 'lateral', 'values', 'returning',
    'truncate', 'begin', 'commit', 'rollback', 'savepoint', 'grant', 'revoke',
    'pivot', 'unpivot', 'connect', 'start', 'nocycle', 'prior', 'level',
