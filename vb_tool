            return out
        _bcs, _ecs = _statmap(_cgb2, "cpu.stat"), _statmap(_cge2, "cpu.stat")
        for k2 in ("nr_periods", "nr_throttled", "throttled_time", "throttled_usec", "usage_usec"):
            if k2 in _bcs or k2 in _ecs:
