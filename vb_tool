FLAMEGRAPH_PL_EOF

    chmod +x "$FLAMEGRAPH_DIR/stackcollapse-perf.pl"
    chmod +x "$FLAMEGRAPH_DIR/flamegraph.pl"

    # ---------- perf record ----------
    # -t: thread-level filter (perf -t <tid>, still -a so DWARF unwinding sees
    # the whole kernel context; only that thread's samples are kept)
    local RECORD_CMD
    if [ -n "$TID" ]; then
        RECORD_CMD="perf record -F 99 -a --call-graph dwarf -t $TID -o $OUTPUT_DIR/perf.data -- sleep $SLEEP"
    elif [ -z "$PID" ]; then
        RECORD_CMD="perf record -F 99 -a --call-graph dwarf -o $OUTPUT_DIR/perf.data -- sleep $SLEEP"
    else
        RECORD_CMD="perf record -F 99 -a --call-graph dwarf -p $PID -o $OUTPUT_DIR/perf.data -- sleep $SLEEP"
    fi

    echo "====================================================================="
    echo "FlameGraph Collection Started"
    echo "====================================================================="
    echo "PID      : ${PID:-all processes}"
    echo "Duration : ${SLEEP}s"
    echo "Output   : $SVG_FILE"
    echo "====================================================================="
    echo "Running: $RECORD_CMD"
    eval $RECORD_CMD
    if [ $? -ne 0 ] || [ ! -s "$OUTPUT_DIR/perf.data" ]; then
        echo "Error: perf record failed (EACCES under perf_event_paranoid? wrong PID?) - no flame graph" >&2
        rm -f "$OUTPUT_DIR/perf.data"
        return 1
    fi

    # ---------- generate flame graph ----------
    echo "Generating detailed call stacks (perf script)..."
    perf script -F comm,pid,tid,cpu,time,period,event,ip,sym,dso,symoff -i "$OUTPUT_DIR/perf.data" > "$SCRIPT_FILE" 2>/dev/null || \
        perf script -i "$OUTPUT_DIR/perf.data" > "$SCRIPT_FILE" || \
        { echo "Error: perf script failed" >&2; rm -f "$OUTPUT_DIR/perf.data"; return 1; }
    echo "Generating overhead report (perf report)..."
    perf report --stdio --header --children -i "$OUTPUT_DIR/perf.data" > "$REPORT_FILE" 2>/dev/null || \
        { echo "Error: perf report failed" >&2; rm -f "$OUTPUT_DIR/perf.data" "$SCRIPT_FILE"; return 1; }
    perl "$FLAMEGRAPH_DIR/stackcollapse-perf.pl" --all "$SCRIPT_FILE" > "$OUTPUT_DIR/perf.folded" || { echo "Error: stackcollapse-perf.pl failed" >&2; rm -f "$OUTPUT_DIR/perf.data" "$SCRIPT_FILE" "$REPORT_FILE"; return 1; }

    echo "Generating flame graph..."
    perl "$FLAMEGRAPH_DIR/flamegraph.pl" "$OUTPUT_DIR/perf.folded" > "$SVG_FILE"
    local _vb_fg_rc=$?
    if [ $_vb_fg_rc -ne 0 ] || [ ! -s "$SVG_FILE" ]; then
        echo "Error: flamegraph.pl failed (empty folded stacks?)" >&2
        rm -f "$OUTPUT_DIR/perf.data" "$OUTPUT_DIR/perf.folded" "$SCRIPT_FILE" "$REPORT_FILE" "$SVG_FILE"
        return 1
    fi

    # ---------- package SVG + detailed stacks, then drop perf.data ----------
    echo "Packaging output..."
    tar -czf "$TAR_FILE" -C "$OUTPUT_DIR" "$(basename "$SVG_FILE")" "$(basename "$SCRIPT_FILE")" "$(basename "$REPORT_FILE")" || { echo "Error: tar failed (SVG/call stacks kept loose in $OUTPUT_DIR)" >&2; rm -f "$OUTPUT_DIR/perf.data" "$OUTPUT_DIR/perf.folded"; return 1; }
    rm -f "$OUTPUT_DIR/perf.data" "$OUTPUT_DIR/perf.unfolded" "$OUTPUT_DIR/perf.folded" "$SCRIPT_FILE" "$REPORT_FILE" "$SVG_FILE"

    echo "====================================================================="
    echo "Flame graph package generated at $TAR_FILE"
    echo "  perf_$TS.svg        : interactive flame graph"
    echo "  perf_$TS.script.txt : detailed call stacks (perf script)"
    echo "  perf_$TS.report.txt : per-symbol overhead + call chains (perf report)"
    echo "====================================================================="
    return 0
}

