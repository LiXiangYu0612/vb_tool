                ''|*[!0-9]*) ;;
                *)
                    if [ "$_wn" -le 151 ]; then _wn=$((_wn - 1)); else _wn=150; fi
                    [ "$_wn" -lt 100 ] && _wn=100
                    # ★绝不能为此置 db_dirty=1 (2026-11-17 三轮复核纠错): dbcache 里存的是
                    #   未加框的原始行, boxify 每次打印都按当前 _vtop_w 重新加框 —— 宽度
                    #   变化天然生效。若置 db_dirty 会强制全采路径把**同一份 db 文本重算**,
                    #   基线上一帧已滚动 ⇒ 全部差分=0, 打出一帧"新时间戳+全 0 速率"假帧,
                    #   还会把零帧写进 dbcache 持续回放 (与 Ctrl+Z 旧病同类)。
                    [ "$_wn" != "${_vtop_w:-150}" ] && _vtop_w=$_wn
                    ;;
            esac
