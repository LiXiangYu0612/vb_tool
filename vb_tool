        enable)         _awr_enable "$@";;
        disable)        _awr_disable "$@";;
        awrrpt)         _awr_awrrpt "$@";;
        awrdiff)        _awr_awrdiff "$@";;
        topsql)         _awr_topsql "$@";;
        event)          _awr_event "$@";;
        summary)        _awr_summary "$@";;
        tabstat)        _awr_tabstat "$@";;
        cpu)            _awr_cpu "$@";;
        io)             _awr_io "$@";;
        page)           _awr_page "$@";;
        mem)            _awr_mem "$@";;
        net)            _awr_net "$@";;
        tcp)            _awr_tcp "$@";;
        tcpstat)        _awr_tcpstat "$@";;
        fd)             _awr_fd "$@";;
        replstat)       _awr_replstat "$@";;
        replslot)       _awr_replslot "$@";;
        replay)         _awr_replay "$@";;
        ltx)            _awr_ltx "$@";;
        pagew)          _awr_pagew "$@";;
        sqlhist)        _awr_sqlhist "$@";;
        list|ls)        _awr_list "$@";;
        show)           _awr_show "$@";;
        delete)         if [ "$1" = "until" ] && [ $# -eq 2 ]; then _awr_delete_until "$2";
                        else echo "Error: usage 'vb_tool awr delete until <time>' (e.g. '2026-08-11')" >&2; return 2; fi;;
        config)         _awr_config "$@";;
        -h|--help|help) awr_help; return 0;;
        *) echo "Error: unknown awr subcommand '$sub'" >&2; awr_help; return 2;;
    esac
}
# bash TAB completion (user 2026-09-20): `source <(vb_tool completion)` to
# enable (or add that line to ~/.bashrc) -- use the tool's PATH or ABSOLUTE
# path, e.g. source <(/home/vastbase/vb_tool completion); a plain
# `vb_tool completion` just prints this script. The tool bakes its OWN
# absolute path into the emitted script (_VB_TOOL_BIN) so the help probe
# works from any cwd and for any invocation style. Command lists are parsed
# from the help output ONCE per shell and cached -- zero maintenance. Plain
# complete/compgen only: no bash-completion package, bash 4.2 compatible.
vb_tool_completion() {
    local self
    self=$(readlink -f "${BASH_SOURCE[0]:-$0}" 2>/dev/null) || self=""
    [ -n "$self" ] || self="$0"
    echo "_VB_TOOL_BIN='$self'"
    cat <<'VBCOMP'
declare -A _VB_TOOL_SUBS
_vb_tool() {
    local cur cmd h
    COMPREPLY=()
