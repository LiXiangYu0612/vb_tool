        # collected (db_dirty=1) must take the full path, or the new data would
        # sit unrendered while the STALE cache keeps replaying (the freeze bug
        # this flag fixed -- 16 identical frames under live load).
        if [ "$db_ok" = "1" ] && [ "$db_dirty" = "0" ] && [ -s "$_vtop_dbcache" ]; then
            # ---- OS-tick frame (between DB refreshes): fresh OS + cached tail ----
            {
            printf "%s[vbtop]%s %s%s%s  %s│%s  %sLinux %s%s  %s│%s  %s%s%s\n" \
                "$c_sec" "$c_off" "$c_grn" "$h_node" "$c_off" \
                "$c_lbl" "$c_off" "$c_blu" "$kver" "$c_off" \
                "$c_lbl" "$c_off" "$c_grn" "$h_ver" "$c_off"
            printf "${c_lbl}port${c_off} ${c_grn}%s${c_off}   ${c_lbl}up${c_off} %s   %s\n" \
                "${PGPORT:-5432}" \
                "$(awk -v s="$h_up" 'BEGIN{printf "%dd%02dh%02dm", int(s/86400), int(s%86400/3600), int(s%3600/60)}')" \
                "$cores"
            _vtop_print_os
            cat "$_vtop_dbcache"
            # notice/hint: appended once per frame by the shared interactive
            # zone AFTER this brace -- not here too (that double-printed HINT)
            } > "$_vtop_f"
        else
        {
        if [ -z "$db" ]; then
            # ★[vbtop] + │ separators are the STRUCTURAL half of the header styling
            # and survive even on a terminal that renders no colour at all (the
            # user's was doing exactly that, 2026-09-26) -- colour is the other half.
            printf "%s[vbtop]%s %s(db unreachable)%s  %s│%s  %sLinux %s%s\n" \
                "$c_sec" "$c_off" "$c_red" "$c_off" "$c_lbl" "$c_off" "$c_blu" "$kver" "$c_off"
            printf "${c_lbl}port${c_off} ${c_grn}%s${c_off}   %s\n" \
                "${PGPORT:-5432}" "$cores"
            _vtop_print_os
        else
            # ★每帧复位 (2026-09-28 补 r_*/x_*): bash 的 `read` 不会把没读到的变量清空,
