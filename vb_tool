            is_max_long = len(max_full) > MAX_HTML_INLINE_SQL_LEN
            is_min_long = len(min_full) > MAX_HTML_INLINE_SQL_LEN

            if is_max_long:
                max_q_disp = normalize_sql_for_display(max_full[:MAX_HTML_INLINE_SQL_LEN]) + "\n... [SQL 过长已截断，点击按钮下载 .gz 压缩包]"
                max_b64 = _gz_b64(max_full)
            else:
                max_q_disp = normalize_sql_for_display(max_full)
