_vtop_cmd=""       # command typed at the main screen's "Enter:" prompt
_vtop_notice=""    # one-frame notice (unknown command ...), shown above the HINT line
_vtop_cmd_line() { # $1 = text that arrived right behind the ESC (may be empty)
    # Main screen: ESC opened the command line. ★Line editing is done BY HAND
    # (read -n1 per char), because a plain canonical read would swallow an ESC
    # pressed mid-command into the line -- there was no way out except Enter
    # or the 60s timeout (user's call 2026-09-26: "按esc 退出enter 不然永远
    # 退出不了啊"). Behaviour:
    #   ESC        -> cancel immediately: notice + back to the main screen
    #                 (an ESC-led sequence = arrow key is eaten, not a cancel)
    #   Enter      -> confirm and run (empty command = plain redraw)
    #   Backspace  -> erase one char (the prefill can be erased too now)
    #   60s idle   -> cancel (timer restarts on every key)
    # Chars are echoed BY US: the tty stays -echo for the whole time (the old
    # temporary `stty echo` around one big read is gone with it).
    local pre="${1:-}" ch rc=0
    local buf="$pre"
    _vtop_cmd=""
    printf 'Enter: %s' "$buf"
    while :; do
        IFS= read -r -t 60 -n 1 ch || { rc=$?; break; }
        case "$ch" in
            $'\x1b')
                _vtop_drain_keys            # lone ESC cancels; arrow keys are eaten
                if [ -z "$_vtop_drain_seq" ]; then
                    # ★ESC 后面紧跟的"真实按键"不能丢 (2026-11-17 复核): drain 的契约
                    #   就是把那个字节交回来 (_vtop_drain_ret), 主屏入口拿它当前缀
                    #   (30215); 命令行这里原来只在 -z seq 时直接 return, 把字节扔掉 ——
                    #   用户 ESC 取消再快速敲字母/回车, 键就凭空消失。这里按普通按键处理。
                    case "${_vtop_drain_ret:-}" in
                        '') printf '\n'; return 0 ;;   # 真·裸 ESC = 取消
                        $'\n'|$'\r') printf '\n'; break ;;   # 紧跟回车 = 确认
                        $'\x7f'|$'\x08') { [ -n "$buf" ] && { buf="${buf%?}"; printf '\b \b'; }; } ;;
                        *) buf="$buf$_vtop_drain_ret"; printf '%s' "$_vtop_drain_ret" ;;
                    esac
                    continue
                fi
                ;;
            $'\n'|$'\r'|"")
                # ★Enter = the newline DELIMITER: with icrnl on (the norm) bash
                # read -n1 takes NL as the line delimiter and returns an EMPTY
                # ch -- so "" here (rc=0, we only reach the case on success)
                # means Enter was pressed, NOT a timeout: a timeout leaves
                # rc>0 and breaks out above. Raw \r covers icrnl-off terminals.
                printf '\n'
                break
                ;;
            $'\x7f'|$'\x08')                # DEL / BS: erase one char of the line
                if [ -n "$buf" ]; then
                    buf="${buf%?}"
                    printf '\b \b'
                fi
                ;;
            *)
                buf="$buf$ch"
                printf '%s' "$ch"
                ;;
        esac
    done
    if [ "$rc" -ne 0 ]; then                 # idle timeout OR stdin EOF: cancel,
        printf '%s\n' '(cancelled)'          # never run a partial command
        _vtop_notice="command line cancelled (no key for 60s / input closed)"
        return 0
    fi
    _vtop_cmd="$buf"
    _vtop_cmd="${_vtop_cmd#"${_vtop_cmd%%[![:space:]]*}"}"      # trim leading
    _vtop_cmd="${_vtop_cmd%"${_vtop_cmd##*[![:space:]]}"}"      # trim trailing
}

_vtop_screen_sess() { # SESS page -- three blocks (user's spec 2026-09-27):
    #   1. state summary: idle / idle_tx / active session counts
    #   2. per client_ip: total_cnt desc, idle / idle_tx / active as COLUMNS, top 10
    #   3. top 10 sessions by QUERY duration (now()-query_start, `as`'s etime --
    #      xact age lives on the LTX page), columns modelled on `as`'s
    #      "active session info" list.
    # ★boxes (user's call 2026-09-27: "要不也整一点方框？？" + "预留top 10的行 不然
    # 看着内容太少 因为是测试库"): each block opens with a _vtop_sec banner --
    # _vtop_print_frame ALREADY runs _vtop_boxify over every frame, sub-screens
    # included; they just never had banner lines to key on. So the banner IS
    # the box: same ┌┈ label ┈┐ look as the main screen, zero new machinery.
    # The two top lists are padded to EXACTLY 10 rows with '-' placeholders --
    # same convention as the main frame's empty sections -- so the page height
    # is fixed and a quiet test database still shows the full grid.
    local se_out se_i se_it se_a
    local se_ip se_tc se_wi se_wt se_wa se_n=0
    local se_ci se_sb se_id se_we se_du se_sq se_cnt=0
    _vtop_pg sess 'Sessions' 'state summary / sessions by client_ip / top sessions by duration'
    # ---- 1. state summary ----
    # idle_tx covers BOTH 'idle in transaction' and '(aborted)' so the three
    # counts stay additive; other states (rare) are simply not in this picture.
    se_out=$(_vtop_q "select sum(case when state='idle' then 1 else 0 end),
       sum(case when state like 'idle in transaction%' then 1 else 0 end),
       sum(case when state='active' then 1 else 0 end)
from pg_stat_activity where pid <> pg_backend_pid()")
    _vtop_q_warn
    IFS='|' read -r se_i se_it se_a <<<"$se_out"
    # ★查询失败时不许印 0 (2026-11-17 复核): 空结果 = 不知道, 印 "0 0 0" 是在说
    #   "实例一个会话都没有" —— 与全工具 '-' 口径冲突 (本页其它块本来就跳过空行)。
    [ -n "${se_out:-}" ] || { se_i="-"; se_it="-"; se_a="-"; }
    _vtop_sec "state summary"
    _vtop_th "$(printf '%-14s %-14s %s' idle idle_tx active)"
    printf '%-14s %-14s %s\n' "${se_i:-0}" "${se_it:-0}" "${se_a:-0}"
    # ---- 2. sessions by client_ip, states as horizontal columns, top 10 by
    # total_cnt. ★client classification is the established VastBase-only
    # split: system thread = addr+port BOTH null ('background'), unix socket =
    # addr null port -1 ('local'), else the IP text.
    # ★VB has no positional GROUP BY -- the CASE key is spelled out twice.
    _vtop_sec "sessions by client_ip (top 10 by total_cnt)"
    _vtop_th "$(printf '%-20s %-9s %-7s %-8s %s' client_ip total_cnt idle idle_tx active)"
    se_out=$(_vtop_q "select case when client_addr is null and client_port is null then 'background'
            when client_addr is null then 'local'
            else client_addr::text end,
       count(*),
       sum(case when state='idle' then 1 else 0 end),
       sum(case when state like 'idle in transaction%' then 1 else 0 end),
       sum(case when state='active' then 1 else 0 end)
from pg_stat_activity
where pid <> pg_backend_pid()
  and coalesce(state,'') in ('idle','idle in transaction','idle in transaction (aborted)','active')
group by case when client_addr is null and client_port is null then 'background'
              when client_addr is null then 'local'
              else client_addr::text end
order by 2 desc limit 10")
    _vtop_q_warn
    # ★client_ip 不截断 (2026-11-17 复核): IPv6 压缩文本可达 29~39 字符, %-20.20s 会把
    #   同一 /64 上两个客户端印成同一个前缀, 逐客户端归因直接失效 (IPv4 ≤15 不受影响)。
    while IFS='|' read -r se_ip se_tc se_wi se_wt se_wa; do
        [ -z "${se_ip:-}" ] && continue
        printf '%-20s %-9s %-7s %-8s %s\n' "$se_ip" "$se_tc" "$se_wi" "$se_wt" "$se_wa"
        se_n=$((se_n + 1))
    done <<< "$se_out"
    while [ "$se_n" -lt 10 ]; do
        printf '%-20s %-9s %-7s %-8s %s\n' "-" "-" "-" "-" "-"
        se_n=$((se_n + 1))
    done
    # ---- 3. top 10 sessions by query duration desc (as: active session info).
    # ACTIVE-only (user's call 2026-09-27: the st column is gone "因为都是
    # active了" -- so the filter says it outright; idle-tx sessions, whose
    # query_start is the last statement's, stay off the ranking entirely); sqlid 0 (untracked statement, e.g.
    # bare BEGIN) shows '-' like the TOPSQL rankings.
    # ★★first two columns copied from the `as` script's "active session info"
    # (user's call 2026-09-27: "没有blocking_session啊 学一下as脚本 sid_bsid
    # 和 client_info怎么写的吧"):  sid_bsid = sessionid:block_sessionid
    # ('not wait' when nothing blocks it) -- the blocking code is the part the
    # page was missing. client_info deviates from `as` on the user's follow-up
    # ("client_info 如果是后台线程 把 appname 打印出来吧 另外 dbname 换成
    # username 吧"):
    #   background thread (addr AND port both null) -> application_name -- for
    #     internal threads datname is a constant 'postgres' and tells you
    #     nothing; the appname is what distinguishes WLM / Asp / JobScheduler.
    #   local socket (addr null, port -1)           -> usename:application_name
    #     (user's call 2026-09-27: "本地 socket 也要 username:application_name
    #     这样" -- there is no client_addr to show, so the appname is the only
    #     thing that says WHICH client it is, e.g. vastbase:psql)
    #   TCP                                         -> usename:client_addr
    # (The three-way addr/port split is the VastBase-only convention: VB reports
    #  a unix socket's client_port as -1, plain PG reports BOTH as NULL -- so a
    #  `client_port is not null` test would silently swallow every local login.)
    # ★join pinned to a.pid = w.tid (thread level; user-confirmed 2026-09-26):
    #   SMP workers share the parent's sessionid, so a sessionid join fans out.
    #   ★`as` joins on sessionid -- we deliberately keep the pid/tid join and only
    #   borrow the COLUMN EXPRESSIONS.
    _vtop_sec "active sessions by duration (top 15)"
    _vtop_th "$(printf '%-26s %-30s %-11s %-16s %-8s %s' client_info sid_bsid sqlid wait_event duration sqltext)"
    se_out=$(_vtop_q "select case when a.client_addr is null and a.client_port is null
                 then coalesce(a.application_name,'-')
            when a.client_addr is null then concat(coalesce(a.usename,'-'),':',coalesce(a.application_name,'-'))
            else concat(coalesce(a.usename,'-'),':',a.client_addr::text) end,
       concat(a.sessionid::text,':',case when w.block_sessionid is null then 'not wait' else w.block_sessionid::text end),
       coalesce(nullif(a.unique_sql_id::text,'0'),'-'),
       coalesce(w.wait_event,'-'),
       coalesce((extract(epoch from (now()-a.query_start)))::bigint::text,'-'),
       coalesce(substr(regexp_replace(regexp_replace(a.query,'(\r|\n)+',' '),' {2,}',' '),1,40),'-')
from pg_stat_activity a
left join dbe_perf.thread_wait_status w on a.pid = w.tid
where a.pid <> pg_backend_pid()
  and a.state = 'active'
  and a.query_start is not null
  -- ★exclude the WLM collector thread (user's call 2026-09-27: 「workload 线程要
  -- 排除掉」). It is permanently state='active' with a query_start days old, so on
  -- an idle instance it would own the top slot of this ranking every single frame.
  -- ★Only this one name is excluded here -- the other internal threads
  -- (Asp / JobScheduler / WdrSnapshot / AutoVacWorker) are kept out by the
  -- 「query_start is not null」 filter above, not by name.
  -- ★NEVER write an ASCII double quote OR a BACKTICK pair inside this string:
  -- the double quote ends the bash string mid-SQL and silently truncates the
  -- query at that point; the backticks are COMMAND SUBSTITUTION -- bash runs
  -- the comment text as a command and substitutes the empty string, printing
  -- 「query_start is not null: command not found」 on stderr once per render
  -- (caught by the 2026-09-28 audit: this very line did exactly that).
  -- Use 「」 for quoting inside SQL comments: the comment text is never escaped,
  -- only the shell sees it.
  and coalesce(a.application_name,'') <> 'workload'
order by (extract(epoch from (now()-a.query_start))) desc nulls last limit 15")
    _vtop_q_warn
    # ★sqlid 是标识符, 不截断 (2026-11-17 复核): 它是 sqlpatch -s 的唯一钥匙, 截成
    #   前 11 位既不能回填也不唯一 —— 与本页 28458 起的既有规矩 (sid/LSN 去精度) 一致。
    #   TOPSQL 页与主屏 [TOPSQL] 行的 sqlid 列同理, 一并去掉精度。
    while IFS='|' read -r se_ci se_sb se_id se_we se_du se_sq; do
        [ -z "${se_ci:-}" ] && continue
        [ "$se_du" != "-" ] && se_du=$(_vtop_age "$se_du")
        printf '%-26.26s %-30s %-11s %-16.16s %-8s %.40s\n' \
            "$se_ci" "$se_sb" "$se_id" "$se_we" "$se_du" "$se_sq"
        se_cnt=$((se_cnt + 1))
    done <<< "$se_out"
    while [ "$se_cnt" -lt 15 ]; do
        printf '%-26.26s %-30s %-11s %-16.16s %-8s %.40s\n' \
            "-" "-" "-" "-" "-" "-"
        se_cnt=$((se_cnt + 1))
    done
    # ---- 4. blockers of the sessions above (user's call 2026-09-27: 「在 active
    # session 下面单独列一个小结」). ★WHY this block needs a `state` column while
    # the ranking above does not: a blocker is NOT necessarily active -- the
    # classic case is a session sitting in 'idle in transaction' holding a row
    # lock, and that is exactly the state you must see to understand the wait
    # (state is shown in the LTX page's short form: act / idle-tx / idle-tx!).
    # ★ALWAYS rendered, empty or not (user's call 2026-09-27: "没有 blocker 的
    # 时候也需要有 blocker session 的章节格式" -- it was conditional at first and
    # he could not tell the feature existed). Empty state = header + ONE '-' row,
    # the same convention the LTX/LOCK blocks use; the two rankings above reserve
    # 10 rows instead, but a summary does not need that much empty space.
    # Each blocking session appears once by construction (pg_stat_activity has one
    # row per session; the IN-subquery dedupes), and the WAITER side uses the very
    # same filter as block 3 so the set matches what is on screen.
    local bk_out bk_ci bk_sb bk_id bk_we bk_du bk_st bk_sq bk_n=0
    bk_out=$(_vtop_q "select case when b.client_addr is null and b.client_port is null
                 then coalesce(b.application_name,'-')
            when b.client_addr is null then concat(coalesce(b.usename,'-'),':',coalesce(b.application_name,'-'))
            else concat(coalesce(b.usename,'-'),':',b.client_addr::text) end,
       concat(b.sessionid::text,':',case when wb.block_sessionid is null then 'not wait' else wb.block_sessionid::text end),
       coalesce(nullif(b.unique_sql_id::text,'0'),'-'),
       coalesce(wb.wait_event,'-'),
       coalesce((extract(epoch from (now()-b.query_start)))::bigint::text,'-'),
       case b.state when 'active' then 'act' when 'idle in transaction' then 'idle-tx'
            when 'idle in transaction (aborted)' then 'idle-tx!' else '?' end,
       coalesce(substr(regexp_replace(regexp_replace(b.query,'(\r|\n)+',' '),' {2,}',' '),1,40),'-')
from pg_stat_activity b
left join dbe_perf.thread_wait_status wb on b.pid = wb.tid
where b.sessionid::text in (
        select w.block_sessionid::text
        from pg_stat_activity a
        join dbe_perf.thread_wait_status w on a.pid = w.tid
        where a.pid <> pg_backend_pid()
          and a.state = 'active'
          and a.query_start is not null
          and coalesce(a.application_name,'') <> 'workload'
          and w.block_sessionid is not null)
order by (extract(epoch from (now()-b.query_start))) desc nulls last")
    _vtop_q_warn
    _vtop_sec "blockers"
    _vtop_th "$(printf '%-26s %-30s %-11s %-16s %-8s %-9s %s' client_info sid_bsid sqlid wait_event duration state sqltext)"
    while IFS='|' read -r bk_ci bk_sb bk_id bk_we bk_du bk_st bk_sq; do
        [ -z "${bk_ci:-}" ] && continue
        [ "$bk_du" != "-" ] && bk_du=$(_vtop_age "$bk_du")
        printf '%-26.26s %-30s %-11s %-16.16s %-8s %-9.9s %.40s\n' \
            "$bk_ci" "$bk_sb" "$bk_id" "$bk_we" "$bk_du" "$bk_st" "$bk_sq"
        bk_n=$((bk_n + 1))
    done <<< "$bk_out"
    [ "$bk_n" -eq 0 ] && printf '%-26.26s %-30s %-11s %-16.16s %-8s %-9.9s %.40s\n' \
        "-" "-" "-" "-" "-" "-" "-"
    printf '\n'
}

_vtop_screen_ltx() { # LTX page -- top 20 long transactions, carrying the main
    # screen's [LTX] row columns verbatim (user's call 2026-09-28: 「现在弄 LTX
    # top 20 预留，跟之前子界面格式一样，输出按 ltx 主界面的来，不要乱加」):
    #   Block 1: active_ltx / idle_tx_ltx, counted on their own (user's call
    #            2026-09-28: 「active_ltx idle_tx_ltx 放在第一部分单独统计」) --
    #            they are GLOBAL numbers, so repeating them on all 20 detail rows
    #            said nothing; this is also the shape the [SESS] page opens with.
    #   Block 2: sid | user | db | state | duration | event | sqltext  -- the main
    #            [LTX] row's detail columns, minus the two counters.
    # ★Same source, same 60s threshold and the SAME blacklist string as the main
    #   [LTX] and as [SESS].longtx_60s (${_vtop_blist}) -- so the two counters are
    #   the very numbers the main row prints and active_ltx + idle_tx_ltx always
    #   equals the number of detail rows (same filter).
    # ★No extra columns and no extra blocks ("不要乱加"): the old page's separate
    #   counter line plus its client / blocked_by / sqlid columns are gone.
    # ★top 30 -> limit 30, and the list is padded with '-' rows to 30 (same
    #   reservation the other sub-pages use; the counters are global, so the
    #   placeholder rows show '-' rather than repeating a number). Raised from 20
    #   on the user's call 2026-09-28: 「top 20 改成 top 30 吧」.
    local lx_out lx_a=0 lx_i=0 lx_sid lx_usr lx_db lx_st lx_age lx_we lx_sql lx_n=0
    _vtop_pg ltx 'Long Transactions' 'top 30 by xact age (>60s, main [LTX] columns)'
    printf '\n'
    _vtop_sec "summary"
    _vtop_th "$(printf '%-12s %s' active_ltx idle_tx_ltx)"
    lx_out=$(_vtop_q "select coalesce(sum(case when a.state='active' then 1 else 0 end),0),
       coalesce(sum(case when a.state like 'idle in transaction%' then 1 else 0 end),0)
from pg_stat_activity a
where a.state in ('active','idle in transaction')
  and now()-a.xact_start > interval '60 seconds'
  and coalesce(a.application_name,'') not in (${_vtop_blist})
  and a.pid <> pg_backend_pid()")
    _vtop_q_warn
    IFS='|' read -r lx_a lx_i <<<"$lx_out"
    # ★同上: 汇总查询失败 => '-' 而不是 0 (2026-11-17 复核)
    [ -n "${lx_out:-}" ] || { lx_a="-"; lx_i="-"; }
    printf '%-12s %s\n' "${lx_a:-0}" "${lx_i:-0}"
    _vtop_sec "long transactions (top 30)"
    _vtop_th "$(printf '%-14s %-9s %-9s %-8s %-8s %-19s %s' sid user db state xact_age event sqltext)"
    lx_out=$(_vtop_q "select a.sessionid::text, coalesce(a.usename,'-'), coalesce(a.datname,'-'),
       case a.state when 'active' then 'act' when 'idle in transaction' then 'idle-tx' else '?' end,
       (extract(epoch from (now()-a.xact_start)))::bigint,
       coalesce(w.wait_event,'-'),
       coalesce(substr(regexp_replace(regexp_replace(a.query,'(\r|\n)+',' '),' {2,}',' '),1,44),'-')
from pg_stat_activity a
left join dbe_perf.thread_wait_status w on a.pid = w.tid
where a.state in ('active','idle in transaction')
  and now()-a.xact_start > interval '60 seconds'
  and coalesce(a.application_name,'') not in (${_vtop_blist})
  and a.pid <> pg_backend_pid()
order by 5 desc limit 30")
    _vtop_q_warn
    while IFS='|' read -r lx_sid lx_usr lx_db lx_st lx_age lx_we lx_sql; do
        [ -z "${lx_sid:-}" ] && continue
        printf '%s%-14.14s %-9.9s %-9.9s %-8.8s %-8s %-19.19s %.40s%s\n' \
            "${c_red:-}" "$lx_sid" "$lx_usr" "$lx_db" "$lx_st" \
            "$(_vtop_age "$lx_age")" "$lx_we" "$lx_sql" "${c_off:-}"
        lx_n=$((lx_n + 1))
    done <<<"$lx_out"
    while [ "$lx_n" -lt 30 ]; do
        printf '%-14.14s %-9.9s %-9.9s %-8.8s %-8s %-19.19s %.40s\n' \
            "-" "-" "-" "-" "-" "-" "-"
        lx_n=$((lx_n + 1))
    done
    printf '\n'
}

_vtop_screen_istat() { # ISTAT page -- awr "Load Profile" + "Cache Hit Ratio" as a
    # live drill-down. The rates are DELTAS over the interval since the PREVIOUS
    # render of this page (user's call 2026-09-28: 「a=istat 取增量的啊 跟子界面采样
    # 间隔一样啊」) -- the same per-frame convention the main screen's [ISTAT] has
    # always used. A sub-screen renders in a subshell so the baseline is parked in
    # a file; the old in-page "read, sleep 1, read again" double sample is gone
    # (and with it the extra second this page used to cost).
    # Sources (cumulative, and all already used by the main screen / awr):
    #   pg_stat_database                  commits, rollbacks, blocks, tuples,
    #                                     deadlocks, conflicts, temp, stats_reset
    #   dbe_perf.statement                n_calls (qps), blocks fetched/hit
    #   dbe_perf.global_pagewriter_status pgwr_actual_flush_total_num -- the counter
    #                                     that ACTUALLY moves here (the
    #                                     pg_stat_bgwriter family is frozen on VB)
    #   pg_xlog_location_diff(...,'0/0')  redo bytes (standby-safe CASE form)
    # ★Boxes + headers are the sess page's convention (user's call 2026-09-28:
    # 「所有子界面格式都要按sess的来啊 要有表头有方框」): every block opens
    # with a _vtop_sec banner, so _vtop_boxify frames it.
    local is_sql is_a is_b is_dt is_t0 is_t1 is_s1 is_s2 is_s3 is_lb is_hit is_lim
    local a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20
    local b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 b16 b17 b18 b19 b20
    _vtop_pg istat 'Instance Statistics' 'load profile -- rate over the interval since the previous render'
    is_sql="select coalesce(sum(xact_commit),0), coalesce(sum(xact_rollback),0),
       coalesce(sum(blks_read),0), coalesce(sum(blks_hit),0),
       coalesce(sum(tup_returned),0), coalesce(sum(tup_fetched),0),
       coalesce(sum(tup_inserted),0), coalesce(sum(tup_updated),0), coalesce(sum(tup_deleted),0),
       coalesce(sum(deadlocks),0), coalesce(sum(conflicts),0),
       coalesce(sum(temp_bytes),0), coalesce(sum(temp_files),0),
       (select coalesce(sum(n_calls),0) from dbe_perf.statement),
       (select coalesce(sum(n_blocks_fetched),0) from dbe_perf.statement),
       (select coalesce(sum(n_blocks_hit),0) from dbe_perf.statement),
       (select coalesce(sum(pgwr_actual_flush_total_num),0) from dbe_perf.global_pagewriter_status),
       case when pg_is_in_recovery()
            then (select pg_xlog_location_diff(receiver_received_location,'0/0')
                  from pg_stat_get_wal_receiver())
            else pg_xlog_location_diff(pg_current_xlog_location(),'0/0') end::bigint,
       coalesce(min(stats_reset)::text,'-'),
       round(extract(epoch from (now()-pg_postmaster_start_time())))::bigint
from pg_stat_database"
    is_t1=$(date +%s%3N)
    is_b=$(_vtop_q "$is_sql"); _vtop_q_warn
    # ★Window = the time since the PREVIOUS render of this page, NOT an in-page
    #   sleep (user's call 2026-09-28: 「a=istat 取增量的啊 跟子界面采样间隔一样啊」;
    #   the main screen's [ISTAT] has always been a per-frame delta -- this page now
    #   matches it instead of measuring a 1s window of its own).
    #   A sub-screen renders in a subshell, so the baseline is parked in a file --
    #   the same mechanism the WAIT page uses.
    local is_f="${TMPDIR:-/tmp}/vbtop_istat.$$.prev"
    is_a=""; is_t0=0
    if [ -f "$is_f" ]; then
        read -r is_t0 < "$is_f" 2>/dev/null
        # 脏值当空(同 wait/repl 页): 基线文件被写坏时不要让 bash 报错打到屏幕上
        case "${is_t0:-}" in ''|*[!0-9]*) is_t0="" ;; esac
        is_a=$(sed -n '2p' "$is_f" 2>/dev/null)
    fi
    is_dt=$(( is_t1 - ${is_t0:-0} ))
    # ★基线太旧 = 没有基线 (2026-10-10 补齐; repl/wait 页 2026-09-28 已有同款,
    #   istat 同属 quick_first 增量页却漏了): 基线文件跨页面存活, 离开本页很久再
    #   回来时 dt 是分钟/小时级 —— 18 行速率全按超长窗口平均, 突发被稀释, 而页头
    #   照印 refresh。与"首次进页无基线 ⇒ 全 '-'"同一惯例: 超阈即当无基线,
    #   下一帧自然拿到正常窗口。阈值公式与 rp_lim/we_lim 同源: 3×本页节律(-i/dbsub),
    #   下限 20s(一帧渲染最坏 ~12s psql 预算 + 余量, 慢机器不误判); 单位毫秒
    #   (is_t1 是 %s%3N 毫秒, 阈值也必须毫秒 —— rp_lim 第一版写成秒的教训在案)。
    # ★min(3×节律,15) 壳已废 (用户 2026-11-16: 四旗标后节律全是显式值, 不再派生);
    #   阈值统一走 _vtop_lim_ms (2026-11-17 复核修 q: 本页每帧串行 2 条查询 = is_b
    #   计数器 + is_s1 命中率; q 少报 1 时慢实例最坏帧 5+2×12=29s > 阈值 25s,
    #   每帧恒判过期整页 '-'。wait 页传 3 是对的, 本页对齐)。
    is_lim=$(_vtop_lim_ms "${dbsub:-5}" 2)
    [ "$is_dt" -gt "$is_lim" ] && is_dt=0
    # no baseline (first render) -> is_a empty and is_dt 0: every rate renders '-'
    # (_vtop_istrow prints dashes when its begin value is empty), exactly like the
    # main screen's first [ISTAT] frame.
    { [ -n "$is_a" ] && [ "$is_dt" -gt 0 ]; } || { is_a=""; is_dt=0; }
    # park this render as the next one's baseline
    [ -n "$is_b" ] && printf '%s\n%s\n' "$is_t1" "$is_b" > "$is_f" 2>/dev/null
    IFS='|' read -r a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 <<<"$is_a"
    IFS='|' read -r b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 b16 b17 b18 b19 b20 <<<"$is_b"
    printf '\n'
    _vtop_sec "load profile"
    _vtop_th "$(printf '%-26s %-16s %s' metric per_sec since_reset)"
    # ---- transactions / statements (counts) ----
    _vtop_istrow 'commits'          "$a1"  "$b1"  "$is_dt" count
    _vtop_istrow 'rollbacks'        "$a2"  "$b2"  "$is_dt" count
    _vtop_istrow 'qps (statement.n_calls)' "$a14" "$b14" "$is_dt" count
    # ---- I/O (bytes; 8192 = BLCKSZ, the same convention awr's fmt_blocks uses) ----
    _vtop_istrow 'logical_read/s'   "$(_vtop_mul8k "$a3" "$a4")" "$(_vtop_mul8k "$b3" "$b4")" "$is_dt" bytes
    _vtop_istrow 'physical_read/s'  "$(_vtop_mul8k "$a3")"      "$(_vtop_mul8k "$b3")"      "$is_dt" bytes
    _vtop_istrow 'pagewrite/s'      "$(_vtop_mul8k "$a17")"     "$(_vtop_mul8k "$b17")"     "$is_dt" bytes
    _vtop_istrow 'redo/s'           "$a18" "$b18" "$is_dt" bytes
    _vtop_istrow 'temp_bytes/s'     "$a12" "$b12" "$is_dt" bytes
    # ---- rows ----
    _vtop_istrow 'rows_returned/s'  "$a5" "$b5" "$is_dt" count
    _vtop_istrow 'rows_fetched/s'   "$a6" "$b6" "$is_dt" count
    _vtop_istrow 'rows_inserted/s'  "$a7" "$b7" "$is_dt" count
    _vtop_istrow 'rows_updated/s'   "$a8" "$b8" "$is_dt" count
    _vtop_istrow 'rows_deleted/s'   "$a9" "$b9" "$is_dt" count
    # ---- health counters ----
    _vtop_istrow 'deadlocks'        "$a10" "$b10" "$is_dt" count
    _vtop_istrow 'conflicts'        "$a11" "$b11" "$is_dt" count
    _vtop_istrow 'temp_files'       "$a13" "$b13" "$is_dt" count
    # ---- ratios: window hit% and lifetime hit% (not rates) ----
    # ★window hit% needs a real baseline: with none, _vtop_delta would read the
    #   empty begin as 0 and "hit%" would be computed off the whole lifetime --
    #   show '-' instead.
    # ★空值不许编造读数 (2026-09-28 修, 与 _vtop_mul8k 的空值规矩同源): ISTAT 查询失败
    #   时 b3/b4 是空串, _vtop_hitpct 把空当 0 ⇒ 打出 "0.00%" —— 比 '-' 更糟, 因为 0 是
    #   「确认没有命中」这种触目惊心的假结论 (同页 stats_reset 行本来就用了 ${b19:--},
    #   这两处漏了, 页面自相矛盾)。b20 空的 `${b20:-0}` 会把 postmaster_uptime 说成 0s
    #   ("刚启动"), 同样是吓人的假读数。
    if [ -n "$b3" ] || [ -n "$b4" ]; then is_lb="$(_vtop_hitpct "$b3" "$b4")%"; else is_lb="-"; fi
    # ★守卫必须看本次样本 b3/b4, 不是基线 a3/a4 (2026-11-17 复核): is_dt>0 时基线
    #   必然非空, 旧守卫恒真 —— 本帧计数器查询失败 (超时/视图缺失) 时 b3/b4 是空,
    #   _vtop_delta 把空当 0 就算出 "0.00%", 编造了一个触目惊心的假结论。
    if [ "$is_dt" -gt 0 ] && { [ -n "$b3" ] || [ -n "$b4" ]; } && { [ -n "$a3" ] || [ -n "$a4" ]; }; then
        is_hit=$(_vtop_hitpct "$(_vtop_delta "$a3" "$b3")" "$(_vtop_delta "$a4" "$b4")")%
    else
        is_hit="-"
    fi
    printf '%-26s %-16s %s\n' 'buffer_hit%' "$is_hit" "$is_lb"
    # ---- identity block ----
    _vtop_sec "instance info"
    _vtop_th "$(printf '%-26s %s' item value)"
    printf '%-26s %s\n' 'stats_reset' "${b19:--}"
    printf '%-26s %s\n' 'postmaster_uptime' "$([ -n "$b20" ] && _vtop_age "$b20" || echo -)"
    printf '%-26s %s\n' 'sample_window' "$([ "$is_dt" -gt 0 ] && awk -v t="$is_dt" 'BEGIN{printf "%.2fs", t/1000}' || echo -)"
    is_s1=$(_vtop_q "select (select count(*) from pg_stat_activity),
       (select count(*) from pg_stat_activity where state='active'),
       (select count(*) from pg_database where datallowconn)")
    _vtop_q_warn
    IFS='|' read -r is_s1 is_s2 is_s3 <<<"$is_s1"
    printf '%-26s %s\n' 'sessions (total/active)' "${is_s1:--}/${is_s2:--}"
    printf '%-26s %s\n' 'databases (allowconn)' "${is_s3:--}"
    printf '\n'
}

_vtop_screen_wait() { # WAIT page -- two blocks, both [SESS]-style (boxed banner +
    # reserved rows) per the user's call 2026-09-28: 「TOP 10 没有就预留，第一部分
    # 显示 active 会话的 event 汇总，limit 15 也是预留，跟 [SESS] 的格式类似」.
    #   1) the wait events of the sessions that are ACTIVE right now, top 15 --
    #      instant, needs no baseline; a session that is waiting for nothing shows
    #      as the '(on cpu)' pseudo event (the same convention the main [WAIT] row
    #      uses for on_cpu). Columns: event / wait_status (the COARSE状态, written
    #      out in full and moved to column 2 on the user's call 2026-09-28) /
    #      wait_class / sessions -- one row per exact (event, wait_status, class)
    #      combination -- under a real lock wait the first two differ
    #      (wait_status 'acquire lock' vs event 'transactionid').
    #   2) awr's "Top 10 Wait Events by Total Wait Time", computed as the DELTA
    #      between two consecutive renders of THIS page (user's call 2026-09-28:
    #      「top event 是子界面间隔之间的增量」).
    # ★A sub-screen renders inside a subshell, so block 2's baseline cannot live in
    #   a shell variable: it is parked in ${TMPDIR:-/tmp}/vbtop_wait.$$.prev --
    #   written at the END of every render, read at the START of the next one (the
    #   same $$-suffix convention as /tmp/vbtop_q.$$.err). Both cleanup paths know
    #   the file (EXIT trap + the start-up stale sweep).
    # ★First render has no baseline -> block 2 is header + '-' rows, exactly like
    #   the main screen's [ISTAT] first frame.
    # Columns and semantics of block 2 stay awr's: event_name / wait_class / waits /
    # total_wait_time / avg_wait / pct_db_time, idle / non-wait events
    # ('none','wait cmd') excluded (awr excludes them too; 'wait cmd' alone is
    # ~80% of all accumulated wait time on 204), and % DB time = 100 * delta(wait)
    # / delta(DB_TIME). Units use vtop's u/ms/s/min/h formatter, NOT awr's (s)/(ms)
    # -- the window is one render interval and seconds would round real events to 0.0.
    local we_out we_ev we_cl we_w we_t we_n we_dbt we_pts we_pdb we_buf="" we_avg we_pct we_ddbt we_dbt_ok
    local we_lim
    local _dw _dt _avg _pct _e _w _t
    local we_f="${TMPDIR:-/tmp}/vbtop_wait.$$.prev"
    local -A we_pt we_pw
    _vtop_pg wait 'Wait Events' 'active-session events (top 15) + awr top 10 delta since the previous render'
    printf '\n'
    # ---- 1. the events the active sessions are in right now ----
    _vtop_sec "active session events (top 15)"
    _vtop_th "$(printf '%-28s %-22s %-14s %s' event wait_status wait_class sessions)"
    # ★group by (event, wait_status, class), NOT (event, class) with a max() over
    #   wait_status: the old form picked an ARBITRARY member of the group
    #   (alphabetically largest) and its count mixed rows whose wait_status
    #   differed. One row per exact combination is the truthful picture.
    # ★count(distinct a.pid) (2026-11-17 复核): dbe_perf.wait_events 对个别事件有两行
    #   ('extension'、'ReplicationOriginLock' 实测各两条, 407 行/405 个事件), left join
    #   会把等待这些事件的会话复制成两行 ⇒ sessions 列虚高、还与本页"活动会话数"打架。
    #   主屏 [WAIT] 行早就为此改成了 count(distinct pid), 这里对齐。
    #   ★pid 必须在子查询里投影出来 (2026-11-17 实测): 外层 count(distinct a.pid)
    #   直接报 missing FROM-clause entry for table "a"。
    we_out=$(_vtop_q "select ev, ws, typ, count(distinct pid) from (
  select a.pid,
         case when w.wait_event is null or w.wait_event='none' then '(on cpu)' else w.wait_event end ev,
         coalesce(e.type,'-') typ,
         coalesce(w.wait_status,'-') ws
  from pg_stat_activity a
  left join dbe_perf.thread_wait_status w on a.pid = w.tid
  left join dbe_perf.wait_events e on e.event = w.wait_event
  where a.state='active' and a.pid <> pg_backend_pid()
) t group by ev, ws, typ order by 4 desc, ev limit 15")
    _vtop_q_warn
    we_n=0
    while IFS='|' read -r we_ev we_ws we_cl we_w; do
        [ -z "${we_ev:-}" ] && continue
        printf '%-28.28s %-22.22s %-14.14s %s\n' "$we_ev" "$we_ws" "$we_cl" "$we_w"
        we_n=$((we_n + 1))
    done <<<"$we_out"
    while [ "$we_n" -lt 15 ]; do
        printf '%-28.28s %-22.22s %-14.14s %s\n' "-" "-" "-" "-"
        we_n=$((we_n + 1))
    done
    # ---- 2. awr's top 10, as a delta since the previous render ----
    _vtop_sec "top 10 wait events by total wait time (delta)"
    _vtop_th "$(printf '%-28s %-14s %-10s %-16s %-12s %s' event_name wait_class waits total_wait_time avg_wait pct_db_time)"
    we_dbt=$(_vtop_q "select value from dbe_perf.global_instance_time where stat_name='DB_TIME'")
    _vtop_q_warn
    # ★一行一事件 (2026-11-17 复核): wait_events 里同事件可能有两行, 直接 select 会
    #   印出两条同名列, 而基线 map 只留最后一条 —— 两行都拿错的基线做差。按 event 聚合。
    we_out=$(_vtop_q "select event, max(coalesce(type,'-')), max(wait), max(total_wait_time) from dbe_perf.wait_events group by event")
    _vtop_q_warn
    we_pts=""; we_pdb=""
    if [ -f "$we_f" ]; then
        read -r we_pts we_pdb < "$we_f" 2>/dev/null
        # ★两个字段都必须纯数字 (2026-09-28): 基线文件万一被写坏/被外部改坏, 非数字的值
        #   会让下面的 $(( we_dbt - we_pdb )) 把 bash 报错直接打到用户屏幕上(实测复现过)。
        #   脏值一律当空 -> 后面 ${we_pdb:-0} 兜成 0, 页面照常出 '-' 行。
        case "${we_pts:-}" in ''|*[!0-9]*) we_pts="" ;; esac
        case "${we_pdb:-}" in ''|*[!0-9]*) we_pdb="" ;; esac
        while IFS=$'\t' read -r _e _w _t; do
            [ -n "${_e:-}" ] && { we_pw["$_e"]="$_w"; we_pt["$_e"]="$_t"; }
        done < <(tail -n +2 "$we_f" 2>/dev/null)
    fi
    # ★基线太旧 = 没有基线 (用户 2026-09-28 拍板, 与 [REPL] 页同一条规则): 基线文件跨页面
    #   存活, 所以"离开本页一小时再回来"时这一帧的 deltawaits / deltatotal_wait_time 是**一小时**
    #   的累计 —— 这两列**不除秒**, 一小时的量看着就像等待事件大爆发, 而页头只写
    #   refresh 5s。超阈值就把基线当作不存在(与"首次进页没有基线文件"走同一条路: 本节
    #   只显示 '-' 占位行), 下一帧自然恢复。we_pts 以前读出来却没人用, 现在正是用它。
    # ★单位必须与 we_pts 一致(毫秒, date +%s%3N); 第一版写成秒 ⇒ 恒定判定过期。见 REPL 页同注。
    # ★阈值 = _vtop_lim_ms(dbsub, 3) (2026-11-16): 本页每帧串行 3 条查询
    #   (we_out/we_dbt/we_out2), 慢库上帧墙钟可达 5+3×12s=41s -- 裸 3×dbsub
    #   下限 20s 会整页判过期, 复核实证的回归; 查询数进 floor 修正。
    we_lim=$(_vtop_lim_ms "${dbsub:-5}" 3)
    if [ -n "$we_pts" ] && [ "$(( $(date +%s%3N) - we_pts ))" -gt "$we_lim" ]; then
        # ★清空关联数组不能用 `we_pt=()` (2026-11-17 复核): bash 4.2/4.3 (CentOS/RHEL 7
        #   自带, 本脚本其它处也按 4.2 兼容写) 会在复合赋值后把 -A 属性丢掉, 数组退回
        #   索引数组 ⇒ 之后 we_pw["$事件名"] 被当算术下标, 全部挤到 0 号槽, 整页发明
        #   数据。逐键 unset 在 4.2+ 全版本都保留属性。
        for _we_k in "${!we_pt[@]}"; do unset "we_pt[$_we_k]" "we_pw[$_we_k]"; done
        unset _we_k
        we_pdb=0
    fi
    # ★DB_TIME 成功标志必须在兜底前抓 (2026-11-17 独立复核): 下一行 ${we_dbt:-0} 把
    #   查询失败的空值变 "0", 写基线的守卫若直接 [ -n "$we_dbt" ] 便恒真 —— 失败帧照
    #   写基线 0, 下一帧 we_ddbt=终身 DB_TIME、pct 全≈0, 正是 2026-10-10 那笔要堵的
    #   路径被 09-28 的兜底行重新打开。
    we_dbt_ok=${we_dbt:+1}
    we_dbt=${we_dbt:-0}; we_pdb=${we_pdb:-0}
    we_ddbt=$(( we_dbt - we_pdb ))
    while IFS='|' read -r we_ev we_cl we_w we_t; do
        [ -z "${we_ev:-}" ] && continue
        case "$we_ev" in 'none'|'wait cmd') continue;; esac
        _dw=0; _dt=0
        if [ -n "${we_pt[$we_ev]:-}" ]; then
            _dw=$(( we_w - ${we_pw[$we_ev]:-0} )); _dt=$(( we_t - ${we_pt[$we_ev]} ))
            [ "$_dw" -lt 0 ] && _dw=0     # counters restart on instance restart
            [ "$_dt" -lt 0 ] && _dt=0
        fi
        # ★两侧增量都必须 >0 才出数 (2026-11-17 三轮复核): 计数器重置窗里 _dw 被钳 0
        #   而 _dt 仍为正 ⇒ 旧 "或" 条件会印 waits=0 | total>0 | avg 0us 的不可能行。
        #   waits 没涨就没本窗数据, 该行当本窗没有这个事件。
        if [ "$_dw" -gt 0 ] && [ "$_dt" -gt 0 ]; then
            _avg=0; [ "$_dw" -gt 0 ] && _avg=$(( _dt / _dw ))     # us per wait
            if [ "$we_ddbt" -gt 0 ]; then
                _pct=$(awk -v d="$_dt" -v b="$we_ddbt" 'BEGIN{printf "%.2f", 100*d/b}')
            else
                _pct="-"                              # no baseline window yet
            fi
            we_buf="${we_buf}${_dt}|${_dw}|${we_ev}|${we_cl}|${_avg}|${_pct}
"
        fi
    done <<< "$we_out"
    we_n=0
    if [ -n "$we_buf" ]; then
        while IFS='|' read -r _dt _dw we_ev we_cl we_avg we_pct; do
            [ -z "${we_ev:-}" ] && continue
            printf '%-28.28s %-14.14s %-10s %-16s %-12s %s\n' \
                "$we_ev" "$we_cl" "$_dw" \
                "$(_vtop_fmt_us "$_dt")" "$(_vtop_fmt_us "$we_avg")" \
                "$([ "$we_pct" = "-" ] && echo "-" || echo "${we_pct}%")"
            we_n=$((we_n + 1))
            [ "$we_n" -ge 10 ] && break
        done <<< "$(printf '%s' "$we_buf" | sort -t'|' -k1,1rn)"
    fi
    while [ "$we_n" -lt 10 ]; do
        printf '%-28.28s %-14.14s %-10s %-16s %-12s %s\n' "-" "-" "-" "-" "-" "-"
        we_n=$((we_n + 1))
    done
    # park this render as the next one's baseline
    # ★we_dbt 必须与 we_out 同帧成功才写 (2026-10-10 修): DB_TIME 查询失败的那帧
    #   we_dbt 落空成 0, 若照写 ⇒ 下一帧 we_pdb=0 ⇒ we_ddbt=终身 DB_TIME, 所有
    #   pct_db_time 严重偏小。istat 页同类场景是整体跳过写基线([ -n "$is_b" ]),
    #   口径对齐: 查询失败的帧不落盘, 保留旧基线(过期判定会兜住太旧的)。
    if [ -n "$we_out" ] && [ "$we_dbt_ok" = "1" ]; then
        {
            printf '%s %s\n' "$(date +%s%3N)" "$we_dbt"
            printf '%s\n' "$we_out" | awk -F'|' 'NF>=4 {print $1 "\t" $3 "\t" $4}'
        } > "$we_f" 2>/dev/null
    fi
    printf '\n'
}
_vtop_segno() { # $1 = a 24-char xlog segment name -> its segment number, '' if unparsable
    case "${1:-}" in
        [0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f])
            printf '%s' $(( 16#${1:8:8} * 256 + 16#${1:22:2} ));;
        *)  printf '%s' '';;
    esac
}
_vtop_lsn_gap() { # $1 - $2 in 16MB WAL segments (xloghc states its lags in segments)
    # Done in bash, not SQL: the LSNs on this page are already strings, and the
    # arithmetic is exact in bash's 64-bit integers (hi * 2^32 + lo).
    local ha=${1%%/*} la=${1#*/} hb=${2%%/*} lb=${2#*/} d
    case "${1:-}" in ''|*[!0-9A-Fa-f/]*) printf '%s' '-'; return 0;; esac
    case "${2:-}" in ''|*[!0-9A-Fa-f/]*) printf '%s' '-'; return 0;; esac
    [ "$la" = "$1" ] && { printf '%s' '-'; return 0; }
    [ "$lb" = "$2" ] && { printf '%s' '-'; return 0; }
    # ★两侧都必须"非空且纯十六进制" (2026-09-28 修的可复现崩溃): 上面两条只查**字符集**,
    # 而 "/00001234" 的字符集完全合法、前半却是空串 ⇒ 算术里 `16#` 后面什么都没有,
    # bash 报 「invalid integer constant (error token is "16#")」。要害是这个 helper 的
    # **stdout 被命令替换捕获、stderr 没有**, 所以那行错误直接打到用户终端上, 每帧一次,
    # 还把 lag_cbm_seg 变成空单元格、让 health 静默丢掉 cbm 这一条判据。
    # 源头 = pg_cbm_tracked_location() 用 %08X/%08X 格式化, 高 32 位为 0 时给出
    # "00000000/XXXXXXXX", 老的 '^0+' 会连斜杠前的 8 个 0 一起吃掉 ⇒ 剩 "/XXXXXXXX"
    # (小实例/新实例, 追踪位点不足 4GB 就会命中)。SQL 侧的归一化已同步修好 (改成
    # '^0+([0-9A-F])' 保留一位), 这里再兜一层: 无论上游给什么, 本函数只输出数字或 '-'。
    if [ -z "$ha" ] || [ -z "$la" ] || [ -z "$hb" ] || [ -z "$lb" ]; then printf '%s' '-'; return 0; fi
    case "$ha$la$hb$lb" in *[!0-9A-Fa-f]*) printf '%s' '-'; return 0;; esac
    d=$(( (16#$ha) * 4294967296 + 16#$la - (16#$hb) * 4294967296 - 16#$lb ))
    [ "$d" -lt 0 ] && d=0
    printf '%s' $(( (d + 8388608) / 16777216 ))
}

_vtop_screen_xlog() { # XLOG page -- `vb_tool xloghc`'s two sections, rendered in the
    # page's compact multi-column style (user's call 2026-09-28: 「x=xlog 子界面参考
    # 不需要写表格形式 这样输出太松散了 可以整理调整 比如一行记录几个指标对齐就行」 +
    # 「就按 xloghc 的输出吧 好先能展示完整的」 + 「Xlog Healthy Summary: --- 这种
    # 按子界面的格式来」).
    # Sections, field set and DERIVATIONS all mirror xloghc's DO block:
    #   Summary: node / role / version (with patch+commit) / current redo (newest WAL
    #            file by MTIME + its mtime) / oldest xlog (oldest name + mtime) /
    #            keep & total count / keep & total size / health
    #   Detail:  the LSN set, each LSN paired with the WAL file name it falls in,
    #            then the three keeper rows straight from gs_xlog_keepers()
    #   GUCs:    xloghc's four labelled groups, three parameters per line
    # ★keep_xlog_count = 1 + segno(newest) - segno(oldest), xloghc's own arithmetic.
    # ★health = any lag (in 16MB segments) >= wal_keep_segments + 2*checkpoint_segments
    #   + 1, the same limit xloghc computes.
    local xl_out xl_k xl_k2 xl_k3 xl_n2 xl_cur
    local x_node x_role x_ver x_tl x_cur_r x_ckr x_ckl x_cbm x_sr x_mr x_na x_la
    # ★xl_keepguc/xl_csegguc 也必须是 local (2026-11-17 复核): 它们不在列表里时,
    #   第二段查询读短了 (或整条失败) 会留着上一帧的值, 页面把旧 GUC 当成本帧数值。
    local xl_cnt xl_size xl_old xl_oldm xl_new xl_newm xl_keepguc xl_csegguc xl_cmax xl_cmin xl_keep xl_lim xl_health=""
    local xl_arch xl_archseg
    local xl_cbmw xl_srw xl_mrw
    _vtop_pg xlog 'XLOG' 'xloghc: healthy summary + detail + GUCs (live)'
    # ---- locals: the page's rendering primitives. Section headers follow xloghc's
    #      "Title:" + dashes shape, in the page's colour language.
    # ★section headers use the SUB-PAGE format: the same _vtop_sec banner the other
    #   pages use (it is what _vtop_boxify turns into ┌┈ title ┈┐). The raw
    #   "Title:" + dashes that xloghc prints is NOT the sub-page format (user's call
    #   2026-09-28: 「输出按子页面的格式啊 没明白吗？？」).
    _vtop_sh() { [ -n "${_vtop_nohdr:-}" ] || _vtop_sec "$1"; }
    # ★ONE grid for the whole page: label 22 + value 26, three cells per line.
    #   Two different cell widths (the earlier p2/p3 pair) made the columns of
    #   neighbouring lines NOT line up (user's call 2026-09-28: 「没有对齐」).
    #   22 fits the longest label (min_standby_replay_lsn), 26 fits a 24-char WAL
    #   name; anything longer goes on a full-width p1 line.
    _vtop_p3() { # 3 cells: label(22) value(26)
        printf '%s%-22.22s%s %-26.26s %s%-22.22s%s %-26.26s %s%-22.22s%s %s\n' \
            "${c_lbl:-}" "$1" "${c_off:-}" "$2" "${c_lbl:-}" "$3" "${c_off:-}" "$4" \
            "${c_lbl:-}" "$5" "${c_off:-}" "$6"
    }
    _vtop_p1() { printf '%s%-22.22s%s %s\n' "${c_lbl:-}" "$1" "${c_off:-}" "$2"; }
    xl_out=$(_vtop_q "select (select get_nodename()),
       case pg_is_in_recovery() when 'f' then 'Primary' else 'Standby' end,
       concat(replace(replace(regexp_substr(vb_version(), '^(.*?)(?= compiled)', 1, 1),'(',''),')',''),
         ' patch ', coalesce(regexp_substr(vb_version(), 'patch:(\d+)', 1, 1, NULL, 1),'?'),
         ' commit ', coalesce(regexp_substr(vb_version(), 'commit (\S+)', 1, 1, NULL, 1),'?')),
       (select timeline_id::text from pg_control_checkpoint()),
       case when pg_is_in_recovery()
            then (select receiver_received_location::text from pg_stat_get_wal_receiver())
            else pg_current_xlog_location()::text end,
       upper(concat(to_hex((select redo_lsn from pg_control_checkpoint())>>32),'/',
             lpad(to_hex((select redo_lsn from pg_control_checkpoint())&4294967295),8,'0'))),
       upper(concat(to_hex((select checkpoint_lsn from pg_control_checkpoint())>>32),'/',
             lpad(to_hex((select checkpoint_lsn from pg_control_checkpoint())&4294967295),8,'0'))),
       regexp_replace(pg_cbm_tracked_location()::text,'^0+([0-9A-F])','\1'),
       (select min(restart_lsn)::text from pg_replication_slots),
       case when pg_is_in_recovery()
            then (select min(receiver_replay_location)::text from pg_stat_get_wal_receiver())
            else (select min(receiver_replay_location)::text from pg_stat_get_wal_senders()) end,
       (select pg_ls_dir from (select pg_ls_dir from pg_ls_dir('pg_xlog/archive_status/')
              where pg_ls_dir like '%.ready' order by 1 limit 1) t),
       (select pg_ls_dir from (select pg_ls_dir from pg_ls_dir('pg_xlog/archive_status/')
              where pg_ls_dir like '%.done' order by 1 desc limit 1) t)")
    _vtop_q_warn
    IFS='|' read -r x_node x_role x_ver x_tl x_cur_r x_ckr x_ckl x_cbm x_sr x_mr x_na x_la <<<"$xl_out"
    # newest WAL file by MTIME (xloghc orders by modification desc) + oldest by name
    xl_out=$(_vtop_q "select count(*), coalesce(pg_size_pretty(sum(size)::numeric),'-'),
       (select coalesce(min(name),'-') from pg_ls_waldir() where name not like '%backup%' and length(name)=24),
       -- ★the mtime of the OLDEST-NAMED file, not min(modification) (that is the
       --   globally earliest mtime and belongs to a different file)
       (select to_char(modification,'YYYY-MM-DD HH24:MI:SS') from pg_ls_waldir() where name not like '%backup%' and length(name)=24 order by name limit 1),
       -- ★newest 侧同样要 length(name)=24 (2026-11-17 复核): pg_xlog 里还躺着
       --   00000002.history / *.partial 这类文件, 它们 mtime 更新时会当上「最新 WAL」
       --   ⇒ _vtop_segno 解析空 ⇒ keep 数与 archive lag 判定整段静默跳过。
       (select name from pg_ls_waldir() where name not like '%backup%' and length(name)=24 order by modification desc limit 1),
       (select to_char(modification,'YYYY-MM-DD HH24:MI:SS') from pg_ls_waldir() where name not like '%backup%' and length(name)=24 order by modification desc limit 1),
       (select setting::int from pg_settings where name='wal_keep_segments'),
       (select setting::int from pg_settings where name='checkpoint_segments')
from pg_ls_waldir() where name not like '%backup%' and length(name)=24")
    _vtop_q_warn
    IFS='|' read -r xl_cnt xl_size xl_old xl_oldm xl_new xl_newm xl_keepguc xl_csegguc <<<"$xl_out"
    xl_cmin=$(_vtop_segno "$xl_old"); xl_cmax=$(_vtop_segno "$xl_new")
    xl_keep="-"
    [ -n "$xl_cmin" ] && [ -n "$xl_cmax" ] && xl_keep=$((1 + xl_cmax - xl_cmin))
    # WAL file name for each LSN (xloghc's formula: timeline8 + hi8 + first 2 of lo, padded)
    xl_walname() { # $1 = LSN text like 13/9074B3D0 -> 000000010000001300000090
        local hi lo tl=${x_tl:-1}
        case "$1" in ''|-) printf '%s' '-'; return 0;; esac   # no LSN -> no WAL name
        case "$1" in */*) ;; *) printf '%s' '-'; return 0;; esac
        hi=${1%%/*}; lo=${1##*/}
        # ★时间线是十六进制 (2026-11-17 复核): 旧 %08d 在 timeline>=10 时印出
        #   "00000016..." 而真实文件是 "00000010..." —— 名字错、页却是"healthy"。
        printf '%s%s%s' "$(printf '%08x' "$tl")" \
            "$(printf '%08s' "$hi" | tr ' ' 0)" \
            "$(printf '%08s' "$(printf '%s' "$lo" | cut -c1-2)" | tr ' ' 0)"
    }
    xl_cbmw=$(xl_walname "${x_cbm:--}"); xl_srw=$(xl_walname "${x_sr:--}"); xl_mrw=$(xl_walname "${x_mr:--}")
    # health: same limit and same 16MB-segment lags xloghc compares
    # ★GUC 缺席不许拿 128 顶 (2026-11-17 三轮复核): checkpoint_segments 在目标构建被移除
    #   时, ${xl_csegguc:-128} 会把滞后阈值凭空翻倍, "unhealthy" 被静默判成 healthy。
    #   两个 GUC 都拿到数字才算阈值; 否则 xl_lim 空, 下面所有判据跳过, health 摆 '-'。
    case "${xl_keepguc:-}${xl_csegguc:-}" in
        ''|*[!0-9]*) xl_lim="";;
        *)           xl_lim=$(( xl_keepguc + 2 * xl_csegguc + 1 ));;
    esac
    for xl_k in "$(_vtop_lsn_gap "$x_cur_r" "$x_ckr"):checkpoint" \
                 "$(_vtop_lsn_gap "$x_cur_r" "$x_cbm"):cbm" \
                 "$(_vtop_lsn_gap "$x_cur_r" "$x_sr"):restart_lsn" \
                 "$(_vtop_lsn_gap "$x_cur_r" "$x_mr"):standby_replay"; do
        [ "${xl_k%%:*}" = "-" ] && continue
        [ "${xl_k%%:*}" -ge "$xl_lim" ] 2>/dev/null && xl_health="$xl_health${xl_health:+, }${xl_k##*:} lag(${xl_k%%:*} seg)"
    done
    # ★第 5 条判据 = archive lag (用户 2026-09-28 拍板补上, 与 xloghc 对齐): 原页面只判 4 条,
    #   而 xloghc 的 healthy_state 有 5 条 —— 缺的正是 archive lag。后果是**开归档的库上
    #   vtop 报 healthy 而 xloghc 报 archive lag**, 同一个库两个结论。公式照抄 xloghc
    #   (run_xloghc 里 diff_arch_count): 最新 xlog 段号 - 尚未归档的最老段号, 后者取自
    #   coalesce(min_need_archive 去掉 .ready, last_archive_done 去掉 .done); 本页的
    #   x_na/x_la 就是那两个文件名, **必须先剥后缀**再交给 _vtop_segno(它只认 24 个十六进制
    #   字符)。判定阈值与上面四条完全一致。顺序上 archive 排在最后 (页面的显示顺序是本页
    #   自己的, xloghc 那边是逐条前插所以看起来是反的)。
    xl_arch="${x_na:-}"
    [ -z "$xl_arch" ] && xl_arch="${x_la:-}"
    xl_arch="${xl_arch%.ready}"; xl_arch="${xl_arch%.done}"
    xl_archseg=$(_vtop_segno "$xl_arch")
    if [ -n "$xl_cmax" ] && [ -n "$xl_archseg" ]; then
        xl_k=$((xl_cmax - xl_archseg)):archive
        [ "${xl_k%%:*}" -ge "$xl_lim" ] 2>/dev/null && xl_health="$xl_health${xl_health:+, }${xl_k##*:} lag(${xl_k%%:*} seg)"
    fi
    # ---- Xlog Healthy Summary ----
    _vtop_sh 'Xlog Healthy Summary'
    _vtop_p3 node "${x_node:--}" role "${x_role:--}" timeline "${x_tl:--}"
    _vtop_p1 version "${x_ver:--}"
    _vtop_p1 current_redo "${xl_new:--}   (${xl_newm:--})"
    _vtop_p1 oldest_xlog "${xl_old:--}   (${xl_oldm:--})"
    _vtop_p3 keep_xlog_count "$xl_keep" total_xlog_count "${xl_cnt:--}" '' ''
    _vtop_p3 keep_xlog_size "$([ "$xl_keep" = "-" ] && echo - || echo "$((xl_keep * 16)) MB")" \
             total_xlog_size "${xl_size:--}" '' ''
    # ★health is the LAST line of the summary (user's call 2026-09-28)
    # ★GUC 缺席时 health 摆 '-' (2026-11-17 三轮复核): 没有阈值就没法判, "healthy"
    #   是编造的结论 (缺=不知道)。
    if [ -z "$xl_lim" ] && [ "$xl_health" = "" ]; then
        xl_health="- (wal_keep_segments/checkpoint_segments unavailable: limit unknown)"
    fi
    _vtop_p1 health "${xl_health:-healthy}"
    # ---- Xlog Healthy Detail ----
    _vtop_sh 'Xlog Healthy Detail'
    _vtop_p3 curr_redo_lsn "${x_cur_r:--}" ckpt_redo_lsn "${x_ckr:--}" ckpt_lsn "${x_ckl:--}"
    _vtop_p3 cbm_tracked_lsn "${x_cbm:--}" cbm_tracked_wal "${xl_cbmw:--}" '' ''
    _vtop_p3 min_restart_lsn "${x_sr:--}" min_restart_wal "${xl_srw:--}" '' ''
    _vtop_p3 min_standby_replay_lsn "${x_mr:--}" min_standby_replay_wal "${xl_mrw:--}" '' ''
    _vtop_p3 min_need_archive "${x_na:--}" last_archive_done "${x_la:--}" '' ''
    _vtop_p3 lag_ckpt_seg "$(_vtop_lsn_gap "$x_cur_r" "$x_ckr")" \
             lag_cbm_seg "$(_vtop_lsn_gap "$x_cur_r" "$x_cbm")" '' ''
    _vtop_p3 lag_restart_seg "$(_vtop_lsn_gap "$x_cur_r" "$x_sr")" \
             lag_replay_seg "$(_vtop_lsn_gap "$x_cur_r" "$x_mr")" '' ''
    # keepers, straight from gs_xlog_keepers() (xloghc loops over it)
    xl_out=$(_vtop_q "select keeptype, keepsegment, describe from gs_xlog_keepers() order by 2")
    _vtop_q_warn
    while IFS='|' read -r xl_k xl_k2 xl_k3; do
        [ -z "${xl_k:-}" ] && continue
        _vtop_p1 "$xl_k" "${xl_k2:--}   (${xl_k3:--})"
    done <<<"$xl_out"
    # ---- GUCs: xloghc's four groups, three parameters per line ----
    xl_out=$(_vtop_q "select name, val, grp from (
  select name,
         case unit when '8kB' then concat(setting*8,'kB') else concat(setting,coalesce(unit,' ')) end val,
         case when name in ('enable_incremental_checkpoint','checkpoint_completion_target','checkpoint_segments',
               'checkpoint_timeout','checkpoint_wait_timeout','pagewriter_thread_num','pagewriter_sleep',
               'bgwrite_sleep','bgwrite_delay','max_io_capacity') then 'checkpoint'
              when name in ('archive_command','archive_mode','archive_interval',
               'max_standby_archive_delay') then 'archive'
              when name in ('advance_xlog_file_num','enable_xlog_prune','max_size_for_xlog_prune',
               'max_wal_senders','wal_keep_segments','recovery_min_apply_delay',
               'wal_flush_delay','wal_flush_timeout') then 'wal'
              else 'cbm/dcf/repl' end grp
  from pg_settings
  where name in ('enable_incremental_checkpoint','checkpoint_completion_target','checkpoint_segments',
         'checkpoint_timeout','checkpoint_wait_timeout','pagewriter_thread_num','pagewriter_sleep',
         'bgwrite_sleep','bgwrite_delay','max_io_capacity',
         'archive_command','archive_mode','archive_interval','max_standby_archive_delay',
         'advance_xlog_file_num','enable_xlog_prune','max_size_for_xlog_prune','max_wal_senders',
         'wal_keep_segments','recovery_min_apply_delay','wal_flush_delay','wal_flush_timeout',
         'enable_cbm_tracking','enable_dcf','recovery_max_workers','recovery_parse_workers',
         'recovery_redo_workers')
     or (name like 'replconninfo%' and length(coalesce(setting,'')) > 0)
) t order by case grp when 'checkpoint' then 1 when 'archive' then 2 when 'wal' then 3 else 4 end, name")
    _vtop_q_warn
    xl_n2=0; xl_cur=""
    while IFS='|' read -r xl_k xl_k2 xl_k3; do
        [ -z "${xl_k:-}" ] && continue
        if [ "${xl_k3:-?}" != "$xl_cur" ]; then
            [ -n "$xl_cur" ] && printf '\n'
            _vtop_sec "Guc Parameter(${xl_k3:-?})"
            xl_cur="${xl_k3:-?}"; xl_n2=0
        fi
        printf '%s%-29.29s%s %-14.14s ' "${c_lbl:-}" "$xl_k" "${c_off:-}" "${xl_k2:--}"
        xl_n2=$((xl_n2 + 1))
        [ $((xl_n2 % 3)) -eq 0 ] && printf '\n'
    done <<<"$xl_out"
    [ -n "$xl_cur" ] && printf '\n'
    [ -z "$xl_cur" ] && printf '%s\n' '(no matching GUCs)'
    printf '\n'
}

_vtop_screen_repl() { # REPL page -- awr "Replication" + `vb_tool repl`'s fields.
    # ★Primary side for the stat block: on a standby pg_stat_replication is empty
    #   and the wal-receiver block below carries the story instead.
    # ★NO separate slots query (user's call 2026-09-28: 「repl既然外连接了slot
    #   就不需要单独弄一个slot的查询出来了啊」): the standby block already
    #   outer-joins pg_replication_slots for slot_status, so the old standalone
    #   "Replication Slots" block is gone.
    # ★Boxes + headers are the sess page's convention (user's call 2026-09-28:
    # 「所有子界面格式都要按sess的来啊 要有表头有方框」); the standby banner is
    #   short -- 「写REPL STAT即可」.
    local rp_out rp_app rp_ad rp_st rp_sy rp_pr rp_slot rp_rls rp_s1 rp_w1 rp_f1 rp_r1
    local rp_qs rp_qw rp_qf rp_qr rp_prev rp_rs rp_rw rp_rf rp_rr
    local rp_n rp_dt rp_t1 rp_t0 rp_f rp_lim
    _vtop_pg repl 'Replication' 'standby table + wal receiver (lags in bytes)'
    # ★The standby table carries the main screen's [REPL] row fields plus
    #   restart_lsn: standby / state / sync_state / slot_status / restart_lsn /
    #   sent/s / write/s / flush/s / replay/s / net_lag / fsync_lag / apply_lag /
    #   total_lag -- one row per standby, NO limit, padded to 30 reserved rows
    #   (user's call 2026-09-28: 「预留30行，但是不limit哦」).
    # ★restart_lsn is INSTANTANEOUS (user's call 2026-09-28: 「增加一列
    #   restart_lsn 这一列取瞬时值」): it comes straight off the outer-joined
    #   slot of THIS render; '-' when the standby has no matching slot.
    # ★slot_status linkage: pg_stat_replication has no slot column, so the only
    #   join is application_name = pg_replication_slots.slot_name; the slot views
    #   expose no status field either, just the active boolean -> active /
    #   inactive, '-' when there is no matching slot.
    # ★sent/s / write/s / flush/s / replay/s are DELTAS over the interval since
    #   the PREVIOUS render of this page (user's call 2026-09-28: 「这里的每秒
    #   也是算子界面间隔增量的哈」) -- the same baseline-file mechanism the
    #   WAIT/ISTAT pages use (a sub-screen renders in a subshell, so the baseline
    #   cannot live in a shell variable). The in-page "sleep 1, sample twice" is
    #   gone with it. First render has no baseline -> the four rate columns show
    #   '-' while the lags (instant byte gaps) still render.
    rp_f="${TMPDIR:-/tmp}/vbtop_repl.$$.prev"
    rp_t1=$(date +%s%3N)
    rp_out=$(_vtop_q "select a.application_name, coalesce(a.state,'-'), coalesce(a.sync_state,'-'),
       case when s.slot_name is null then '-' when s.active then 'active' else 'inactive' end,
       coalesce(s.restart_lsn::text,'-'),
       coalesce(pg_xlog_location_diff(a.sender_sent_location,'0/0')::bigint,0),
       coalesce(pg_xlog_location_diff(a.receiver_write_location,'0/0')::bigint,0),
       coalesce(pg_xlog_location_diff(a.receiver_flush_location,'0/0')::bigint,0),
       coalesce(pg_xlog_location_diff(a.receiver_replay_location,'0/0')::bigint,0)
from pg_stat_replication a
left join pg_replication_slots s on s.slot_name = a.application_name
order by a.application_name")
    _vtop_q_warn
    rp_dt=0
    if [ -f "$rp_f" ]; then
        read -r rp_t0 < "$rp_f" 2>/dev/null
        # 脏值当空(同上): 文件被写坏时不要让 bash 报错打到屏幕上
        case "${rp_t0:-}" in ''|*[!0-9]*) rp_t0="" ;; esac
        rp_dt=$(( rp_t1 - ${rp_t0:-0} ))
    fi
    [ "$rp_dt" -gt 0 ] || rp_dt=0
    # ★基线太旧 = 没有基线 (用户 2026-09-28 拍板): 基线文件在整次 vtop 会话里**跨页面
    #   存活**(只有退出才删), 所以"离开本页一小时再回来"时, 这一帧的 dt 是**一小时** ——
    #   四个 /s 列会变成小时平均(备库最后一分钟的停顿被稀释掉, 看着依然"正常"), 而页头
    #   照旧印 refresh 5s ⇒ 读数会被误解。与"首次进页没有基线文件 ⇒ 显示 -"完全同一
    #   惯例: 超过阈值就当基线不存在, 本帧四个速率列全 '-', 下一帧(进页后 5s 的快首刷)
    #   自然拿到正常窗口。
    #   阈值 = 3×稳态节律, 下限 20s: 慢机器上一帧渲染变慢(psql 最长 12s)时不会把
    #   正常窗口误判成过期。
    # ★单位必须与时间戳一致: rp_t1 是 date +%s%3N 的**毫秒**, 所以阈值也要毫秒
    #   (第一版写成秒了 ⇒ 5.1 秒的窗口 5157 > 45 恒成立 ⇒ 每帧都判过期、速率列永远 '-'。
    #    插桩实测抓到)。公式: 节律(秒) ×3 再 ×1000, 下限 20 秒。
    # ★阈值 = _vtop_lim_ms(dbsub, 2) (2026-11-17 复核修 q): min(3×节律,15) 壳已废
    #   (用户拍板, 四旗标后节律全显式), 统一走 helper; 本页每帧串行 2 条查询
    #   (rp_out 主行 + wal_receiver 侧行), q=1 少报与 istat 页同款。
    rp_lim=$(_vtop_lim_ms "${dbsub:-5}" 2)
    [ "$rp_dt" -gt "$rp_lim" ] && rp_dt=0
    printf '\n'
    _vtop_sec "REPL STAT"
    _vtop_th "$(printf '%-14s %-10s %-10s %-11s %-11s %-10s %-10s %-10s %-10s %-10s %-10s %-10s %s' standby state sync_state slot_status restart_lsn sent/s write/s flush/s replay/s net_lag fsync_lag apply_lag total_lag)"
    rp_n=0
    while IFS='|' read -r rp_app rp_st rp_sy rp_slot rp_rls rp_s1 rp_w1 rp_f1 rp_r1; do
        [ -z "${rp_app:-}" ] && continue
        rp_prev=$(awk -F'\t' -v k="$rp_app" '$1==k{print $2"\t"$3"\t"$4"\t"$5; exit}' "$rp_f" 2>/dev/null)
        IFS=$'\t' read -r rp_qs rp_qw rp_qf rp_qr <<<"$rp_prev"
        if [ -n "${rp_qs:-}" ] && [ "$rp_dt" -gt 0 ]; then
            rp_rs=$(_vtop_fmt_b "$(_vtop_rate "$rp_qs" "$rp_s1" "$rp_dt")")
            rp_rw=$(_vtop_fmt_b "$(_vtop_rate "$rp_qw" "$rp_w1" "$rp_dt")")
            rp_rf=$(_vtop_fmt_b "$(_vtop_rate "$rp_qf" "$rp_f1" "$rp_dt")")
            rp_rr=$(_vtop_fmt_b "$(_vtop_rate "$rp_qr" "$rp_r1" "$rp_dt")")
        else
            rp_rs='-'; rp_rw='-'; rp_rf='-'; rp_rr='-'
        fi
        printf '%-14.14s %-10.10s %-10.10s %-11.11s %-11s %-10s %-10s %-10s %-10s %-10s %-10s %-10s %s\n' \
            "$rp_app" "$rp_st" "$rp_sy" "$rp_slot" "$rp_rls" \
            "$rp_rs" "$rp_rw" "$rp_rf" "$rp_rr" \
            "$(_vtop_fmt_b "$(_vtop_delta "$rp_w1" "$rp_s1")")" \
            "$(_vtop_fmt_b "$(_vtop_delta "$rp_f1" "$rp_w1")")" \
            "$(_vtop_fmt_b "$(_vtop_delta "$rp_r1" "$rp_f1")")" \
            "$(_vtop_fmt_b "$(_vtop_delta "$rp_r1" "$rp_s1")")"
        rp_n=$((rp_n + 1))
    done <<<"$rp_out"
    # reserved rows: pad to 30 (a quiet primary shows the full grid, the sess
    # page's convention); the SQL itself stays unlimited -- more than 30
    # standbys simply make the frame taller.
    while [ "$rp_n" -lt 30 ]; do
        printf '%-14.14s %-10.10s %-10.10s %-11.11s %-11s %-10s %-10s %-10s %-10s %-10s %-10s %-10s %s\n' \
            "-" "-" "-" "-" "-" "-" "-" "-" "-" "-" "-" "-" "-"
        rp_n=$((rp_n + 1))
    done
    # park this render's counters as the next one's baseline (ts + one
    # tab-separated line per standby: app sent write flush replay)
    # ★查询失败帧不写基线 (2026-11-16 复核修, 对齐 istat 的 [ -n "$is_b" ] /
    #   wait 的 [ -n "$we_out" ] 同款守卫): 无条件写会把基线写成"只有时间戳",
    # 下一帧全备库速率列白空一帧; 失败帧沿用旧基线, 恢复后立刻续上。
    if [ -n "${rp_out:-}" ]; then
        { printf '%s\n' "$rp_t1"
          printf '%s\n' "$rp_out" | awk -F'|' '{printf "%s\t%s\t%s\t%s\t%s\n", $1, $6, $7, $8, $9}'
        } > "$rp_f" 2>/dev/null
    fi
    # ---- wal receiver (a standby only) ----
    # ★VB has no pg_stat_wal_receiver RELATION (204: relation does not exist) --
    #   it is the SRF pg_stat_get_wal_receiver() (the form xloghc uses), whose
    #   columns are the openGauss set probed on 204: receiver_pid/local_role/
    #   peer_role/peer_state/state/sender_*_location/receiver_*_location/
    #   sync_percent/channel. On a primary it returns 0 rows, so the block is
    #   skipped there.
    # ★the repl-GUC block that used to follow here is gone (user's call
    #   2026-09-28: 「repl guc 不需要的」).
    rp_out=$(_vtop_q "select concat(coalesce(state,'-'),' ',coalesce(local_role,'-'),'<-',coalesce(peer_role,'-')),
       coalesce(peer_state,'-'), coalesce(sync_percent::text,'-'), coalesce(channel,'-'),
       coalesce(sender_sent_location::text,'-'), coalesce(receiver_received_location::text,'-'),
       coalesce(receiver_write_location::text,'-'), coalesce(receiver_flush_location::text,'-'),
       coalesce(receiver_replay_location::text,'-')
from pg_stat_get_wal_receiver()")
    _vtop_q_warn
    if [ -n "$rp_out" ]; then
        _vtop_sec "wal receiver"
        _vtop_th "$(printf '%-26s %s' wal_receiver value)"
        IFS='|' read -r rp_app rp_ad rp_st rp_sy rp_pr rp_s1 rp_w1 rp_f1 rp_r1 <<<"$rp_out"
        printf '%-26s %s\n' 'state' "$(_vtop_dash2 "$rp_app")"
        printf '%-26s %s\n' 'peer_state' "${rp_ad:--}"
        printf '%-26s %s\n' 'sync_percent' "${rp_st:--}"
        printf '%-26s %s\n' 'channel' "${rp_sy:--}"
        printf '%-26s %s\n' 'sender_sent_location' "${rp_pr:--}"
        printf '%-26s %s\n' 'received_location' "${rp_s1:--}"
        printf '%-26s %s\n' 'written_location' "${rp_w1:--}"
        printf '%-26s %s\n' 'flushed_location' "${rp_f1:--}"
        printf '%-26s %s\n' 'replayed_location' "${rp_r1:--}"
    fi
    printf '\n'
}


_vtop_screen_memctx() { # MEMCTX page -- `vb_tool mem`'s memory-CONTEXT output
    # (user's call 2026-09-27: 「memctx 子界面参考 vb_tool mem 相关的上下文的输出」).
    # Three blocks, in `mem`'s own shape:
    #   1) session memory total   -- mem's "top 10 session memory used" aggregate
    #      (sess_cnt / total / avg / min / max over the per-session totals)
    #   2) top 10 SHARED memory context  -- gs_shared_memory_detail. ★The old
    #      version of this page (and the main screen's [MEMCTX] row) never had
    #      this block: shared contexts are a different population from session
    #      contexts and are what a leak hunt looks at first.
    #   3) top 10 SESSION memory context -- gs_session_memory_detail
    # ★Column set is `mem`'s verbatim: contextname / context_cnt / total_size /
    #   free_size / used_size / max_size / min_size / avg_size, both ordered by
    #   sum(totalsize) desc limit 10 (this page used to carry 6 columns -- no
    #   min_size -- and limit 12).
    # ★Boxes: _vtop_sec banners give these blocks the same ┌┈ label ┈┐ frame the
    #   sess/topsql pages have (the user asked for that look there; one word from
    #   him removes it here).
    # ★VB has no positional GROUP BY (order by N is fine) -- group key spelled out.
    local mx_out mx_k mx_a mx_b mx_c mx_d mx_e mx_f mx_g mx_n
    # ★page header spells out all three main-screen memory sections it answers for
    # (user's call 2026-09-28: 「m 输出就是之前 memctx 的，但是子界面写成
    # dbmem+memctx+topmem」) -- _vtop_pg upper-cases it, giving
    # [DBMEM+MEMCTX+TOPMEM]   refresh Ns. The content is still the memctx body.
    _vtop_pg 'dbmem+memctx+topmem' 'Memory' 'session total + shared / session memory contexts (vb_tool mem)'
    printf '\n'
    _vtop_sec "session memory total"
    _vtop_th "$(printf '%-10s %-22s %-14s %-14s %s' sessions total_size avg_size min_size max_size)"
    mx_out=$(_vtop_q "select count(*),
       pg_size_pretty(sum(totalsize)::numeric(100,0)),
       pg_size_pretty(avg(totalsize)::numeric(100,0)),
       pg_size_pretty(min(totalsize)::numeric(100,0)),
       pg_size_pretty(max(totalsize)::numeric(100,0))
from (select sessid, sum(totalsize) totalsize from gs_session_memory_detail
      group by sessid) t")
    _vtop_q_warn
    IFS='|' read -r mx_a mx_b mx_c mx_d mx_e <<<"$mx_out"
    printf '%-10s %-22s %-14s %-14s %s\n' "${mx_a:--}" "${mx_b:--}" "${mx_c:--}" "${mx_d:--}" "${mx_e:--}"
    # ---- shared memory contexts ----
    _vtop_sec "top 10 shared memory context"
    _vtop_th "$(printf '%-34s %-11s %-11s %-11s %-11s %-11s %-11s %s' contextname context_cnt total_size free_size used_size max_size min_size avg_size)"
    mx_out=$(_vtop_q "select contextname, count(*),
       pg_size_pretty(sum(totalsize)::numeric(100,0)),
       pg_size_pretty(sum(freesize)::numeric(100,0)),
       pg_size_pretty(sum(usedsize)::numeric(100,0)),
       pg_size_pretty(max(totalsize)::numeric(100,0)),
       pg_size_pretty(min(totalsize)::numeric(100,0)),
       pg_size_pretty(avg(totalsize)::numeric(100,0))
from gs_shared_memory_detail group by contextname
order by sum(totalsize) desc limit 10")
    _vtop_q_warn
    mx_n=0
    while IFS='|' read -r mx_k mx_a mx_b mx_c mx_d mx_e mx_f mx_g; do
        [ -z "${mx_k:-}" ] && continue
        printf '%-34.34s %-11.11s %-11.11s %-11.11s %-11.11s %-11.11s %-11.11s %.10s\n' \
            "$mx_k" "$mx_a" "$mx_b" "$mx_c" "$mx_d" "$mx_e" "$mx_f" "$mx_g"
        mx_n=$((mx_n + 1))
    done <<<"$mx_out"
    [ "$mx_n" -eq 0 ] && printf '%-34.34s %-11.11s %-11.11s %-11.11s %-11.11s %-11.11s %-11.11s %.10s\n' \
        "-" "-" "-" "-" "-" "-" "-" "-"
    # ---- session memory contexts ----
    # ★family rule (user 2026-10-16, same as `mem` + awr ctx_family): per-node
    #   operator contexts merge under the operator name -- "<NodeTag>_<sid>"
    #   (execProcnode.cpp:518, sid=pthread_self() >= 10 digits), stream top
    #   "<NodeTag>_<queryId>_<planNodeId>" (:525), SIRW_<sid>_<share>_<smp>
    #   -> SIRW (nodeShareInputScan.cpp:471); planner _<level> and statics raw.
    _vtop_sec "top 10 session memory context"
    _vtop_th "$(printf '%-34s %-11s %-11s %-11s %-11s %-11s %-11s %s' contextname context_cnt total_size free_size used_size max_size min_size avg_size)"
    mx_out=$(_vtop_q "select case when contextname ~ '^SIRW(_[0-9]+)+\$' then 'SIRW'
       else regexp_replace(regexp_replace(contextname, '_[0-9]{10,}_[0-9]+\$', ''),
                           '_[0-9]{10,}\$', '') end, count(*),
       pg_size_pretty(sum(totalsize)::numeric(100,0)),
       pg_size_pretty(sum(freesize)::numeric(100,0)),
       pg_size_pretty(sum(usedsize)::numeric(100,0)),
       pg_size_pretty(max(totalsize)::numeric(100,0)),
       pg_size_pretty(min(totalsize)::numeric(100,0)),
       pg_size_pretty(avg(totalsize)::numeric(100,0))
from gs_session_memory_detail
group by case when contextname ~ '^SIRW(_[0-9]+)+\$' then 'SIRW'
       else regexp_replace(regexp_replace(contextname, '_[0-9]{10,}_[0-9]+\$', ''),
                           '_[0-9]{10,}\$', '') end
order by sum(totalsize) desc limit 10")
    _vtop_q_warn
    mx_n=0
    while IFS='|' read -r mx_k mx_a mx_b mx_c mx_d mx_e mx_f mx_g; do
        [ -z "${mx_k:-}" ] && continue
        printf '%-34.34s %-11.11s %-11.11s %-11.11s %-11.11s %-11.11s %-11.11s %.10s\n' \
            "$mx_k" "$mx_a" "$mx_b" "$mx_c" "$mx_d" "$mx_e" "$mx_f" "$mx_g"
        mx_n=$((mx_n + 1))
    done <<<"$mx_out"
    [ "$mx_n" -eq 0 ] && printf '%-34.34s %-11.11s %-11.11s %-11.11s %-11.11s %-11.11s %-11.11s %.10s\n' \
        "-" "-" "-" "-" "-" "-" "-" "-"
    # ---- session memory used (per session, not per context) -- `mem`'s last
    # block (user's call 2026-09-27: 「top 10 session memory used 没有啊」 +
    # 「记得外连接哦」 + 「参考主界面的 topmem」).
    # ★Modelled on the main screen's [TOPMEM] (===MEMSES), same shape:
    #   inner subquery aggregates gs_session_memory_detail per session (and drops
    #   our own backend), then a LEFT JOIN onto pg_stat_activity -- an OUTER join
    #   is what keeps internal threads (postmaster / JobScheduler / ...), which
    #   have no activity row at all, on the list instead of silently dropping
    #   them; their state simply renders '-'.
    # ★join on a.pid::text = sid, NOT sessionid: the memory detail's sessid
    #   suffix IS the pid (user-confirmed 2026-09-26; the main screen carries the
    #   same note) -- a sessionid join repeats SMP worker rows.
    # Columns/state codes are the main screen's: sid / sesstype / act|idle-tx|
    # idle|- / size / sqltext.
    _vtop_sec "top 10 session memory used"
    _vtop_th "$(printf '%-14s %-16s %-9s %-10s %s' sid sesstype state total_size sql_text)"
    mx_out=$(_vtop_q "select s.sid::text, coalesce(s.sesstype,'-'),
       case a.state when 'active' then 'act' when 'idle in transaction' then 'idle-tx' when 'idle' then 'idle' else '-' end,
       pg_size_pretty(s.sz::numeric),
       coalesce(substr(regexp_replace(regexp_replace(a.query,'(\r|\n)+',' '),' {2,}',' '),1,40),'-')
from (select split_part(t1.sessid,'.',2) sid, t1.sesstype, sum(t1.totalsize) sz
      from gs_session_memory_detail t1
      where split_part(t1.sessid,'.',2) <> pg_backend_pid()::text
      group by split_part(t1.sessid,'.',2), t1.sesstype
      order by sum(t1.totalsize) desc limit 10) s
left join pg_stat_activity a on a.pid::text = s.sid
order by s.sz desc")
    _vtop_q_warn
    mx_n=0
    while IFS='|' read -r mx_k mx_a mx_b mx_c mx_d; do
        [ -z "${mx_k:-}" ] && continue
        printf '%-14.14s %-16.16s %-9.9s %-10.10s %.40s\n' \
            "$mx_k" "$mx_a" "$mx_b" "$mx_c" "$mx_d"
        mx_n=$((mx_n + 1))
    done <<<"$mx_out"
    [ "$mx_n" -eq 0 ] && printf '%-14.14s %-16.16s %-9.9s %-10.10s %.40s\n' \
        "-" "-" "-" "-" "-"
    printf '\n'
}


_vtop_screen_topsql() { # TOPSQL page -- EXACTLY the two rankings the `as` script
    # prints (user's call 2026-09-27: 「TOPSQL 子界面完全弄错了 … 参考 as 的 topcpu
    # 和 top I/O 各 limit 10」). What was here before (running-now by duration +
    # two awr-style cumulative tables off dbe_perf.statement) is gone.
    #   1) top cpu usage info -- OS THREAD sampling: `top -b -H -p <postmaster>`,
    #      lwpid -> pg_os_threads -> pg_stat_activity. Same chain as the main
    #      screen's
    #      [TOPSQL].cpu_usage%, so the two can never disagree on method.
    #   2) top I/O usage info -- `pidstat -hdt -p <postmaster>`: kB_rd/s and
    #      kB_wr/s per THREAD, same join, same grouping.
    # ★Both need a live OS sample. A sub-screen renders in a subshell and cannot
    #   inherit the main loop's, so this page takes its own -- two commands, each
    #   under `timeout`, once per frame.
    # ★SAMPLING NOW EXACTLY `as` (user's call 2026-10-10: 「cpu%感觉也是错的 …
    #   你看看as怎么弄的 参考一下」): `top -b -n1 -H` + as 的 awk(表头行定 %CPU
    #   列位, getline 逐行取 $1,$ci) —— %CPU = 进程生命周期平均, 与 as 打印值同源。
    #   2026-08-21 版曾刻意改 -d0.3 -n2 取第二帧瞬时值(实测 -n1 首帧 1/10 毛刺),
    #   但两套口径的数字对不上, 用户以 as 为准, 2026-10-10 弃瞬时帧回归 as 算法,
    #   主屏 [TOPSQL] 的采样同步改(同一条链路, 两处永不再各说各话)。
    # ★pidstat column note: `-hdt` puts a `#` column in the HEADER only, so in
    #   the DATA rows $4=lwpid(TID), $5=kB_rd/s, $6=kB_wr/s (exactly what `as`
    #   uses). NR>4 skips the header lines (banner/blank/字段表头/进程汇总行) --
    #   awk 亦逐字对齐 as(`NR>4 {print $4","$5","$6}`), 并补上 as 采样前设置的
    #   S_TIME_FORMAT=ISO(此前漏掉)。
    # ★GROUP BY sqlid ONLY (user's call 2026-09-27: 「只按 sqlid 分组」) -- NOT
    #   thread_name + sqlid as `as` does. One row per statement, so the SMP
    #   threads of one statement always collapse into a single row and their
    #   cpu / kB_rd / kB_wr are SUMMED (values may exceed one core -- e.g. 190%
    #   for a 3-thread SMP count). `threads` = how many OS threads fed that row.
    #   ★thread_name is NOT projected: with the group key being sqlid alone, a
    #   per-thread name would have to be aggregated (min()) and would then be
    #   arbitrary -- the user's call 2026-09-27: 「select 的列必须在 group」.
    # ★Both blocks are padded to EXACTLY 10 rows with '-' placeholders -- the
    #   same reservation the sess page's two rankings use (user's call 2026-09-27:
    #   "各 limit 10 并且预留位置"), so the page height is fixed -- the CPU block
    #   was raised to 15 on his follow-up ("cpu limit 15 吧"), the I/O one stays 10.
    # ★`sum(duration)` column (user's call 2026-09-27: 「都增加一列 sum(duration)
    #   … 用 query start 哦」): SUM of `now() - query_start` over the group's
    #   threads -- query start, NOT xact_start (xact age is the LTX page's job).
    #   Rendered with _vtop_age like every other duration in vtop.
    # ★Only REAL statements are ranked (user's call 2026-09-27: 「topsql 要限制
    #   unique_sql_id is not null」): `unique_sql_id is not null AND <> 0`, the
    #   same pair the main screen's [TOPSQL] uses. The `is not null` half alone
    #   would NOT do it -- internal threads report 0, not NULL (measured on 204),
    #   so they would stay on screen as one big '-' bucket. With both filters
    #   every row carries a real sqlid, and lwpids missing from pg_os_threads
    #   (a null row) drop out as well.
    local ts_out ts_pairs ts_a ts_b ts_c ts_d ts_e ts_sql ts_n ts_pm
    _vtop_pg topsql 'Top SQL' 'top cpu usage + top I/O usage, per OS thread (as script)'
    # ★每帧现读 postmaster.pid (2026-11-17 三道复核): 不再沿用启动时的 pm_pid ——
    #   停在本页期间实例重启的话旧 pid 已死, top -p 恒空, 整页静默 '-'。
    ts_pm=""
    [ -n "${datadir:-}" ] && [ -f "$datadir/postmaster.pid" ] && ts_pm=$(head -1 "$datadir/postmaster.pid" 2>/dev/null | tr -d ' ')
    printf '\n'
    # ★box: a _vtop_sec banner is what _vtop_boxify keys on, so these two blocks
    #   get the same ┌┈ label ┈┐ frame the sess page has (user's call 2026-09-27:
    #   "加上边框啊 跟 [SESS] 一样"). No blank line between the two boxes -- the
    #   sess page stacks them tight.
    _vtop_sec "top cpu usage"
    ts_pairs=""
    # ★采样改回 `as` 的算法 (user's call 2026-10-10): `top -b -n1 -H` + as 的 awk,
    # %CPU = 进程生命周期平均, 与 as 同源同值。2026-09-27 版的 -d0.3 -n2 瞬时帧
    # 与 as 的数字对不上, 以 as 为准 (主屏 [TOPSQL] 同步改, 两处同一条链路)。
    if [ -n "$ts_pm" ]; then
        ts_pairs=$(LC_ALL=C timeout 5 top -b -n1 -H -p "$ts_pm" 2>/dev/null \
            | awk '/^ *PID USER/ {ci=0; for(i=1;i<=NF;i++) if($i=="%CPU") ci=i; while (getline) if(ci && $ci!="") print $1 "," $ci}' \
            | paste -sd ';')
    fi
    [ -n "$ts_pairs" ] || ts_pairs="0,0"
    _vtop_th "$(printf '%-11s %-11s %-8s %-13s %s' cpu_usage% sqlid threads sum\(duration\) sqltext)"
    ts_out=$(_vtop_q "with tmp as (
  select split_part(result, ',', 1) as lwpid,
         split_part(result, ',', 2)::numeric as cpu_usage
  from regexp_split_to_table('${ts_pairs}', ';') as result)
select concat(round(sum(tmp.cpu_usage),2)::text,'%'),
       coalesce(nullif(a.unique_sql_id::text,'0'),'-'),
       count(*),
       coalesce(sum(extract(epoch from (now()-a.query_start)))::bigint::text,'-'),
       coalesce(min(substr(regexp_replace(regexp_replace(a.query,'(\r|\n)+',' '),' {2,}',' '),1,40)),'-')
from pg_os_threads s
right join tmp on s.lwpid = tmp.lwpid
left join pg_stat_activity a on s.pid = a.pid
where (a.state = 'active' or a.state is null)
  and a.unique_sql_id is not null and a.unique_sql_id <> 0
group by a.unique_sql_id
having sum(tmp.cpu_usage) > 0
order by round(sum(tmp.cpu_usage),2)::numeric desc limit 15")
    _vtop_q_warn
    ts_n=0
    while IFS='|' read -r ts_a ts_b ts_c ts_d ts_sql; do
        [ -z "${ts_a:-}" ] && continue
        [ "$ts_d" != "-" ] && ts_d=$(_vtop_age "$ts_d")
        printf '%-11s %-11s %-8s %-13s %.40s\n' "$ts_a" "$ts_b" "$ts_c" "$ts_d" "$ts_sql"
        ts_n=$((ts_n + 1))
    done <<<"$ts_out"
    while [ "$ts_n" -lt 15 ]; do
        printf '%-11s %-11s %-8s %-13s %.40s\n' "-" "-" "-" "-" "-"
        ts_n=$((ts_n + 1))
    done
    _vtop_sec "top I/O usage"
    ts_pairs=""
    # ★对齐 `as` (user's call 2026-10-10: 「top I/O 根本展示不出来」): ①补 as 有而
    #   这里漏掉的 S_TIME_FORMAT=ISO(as 采样前 export 的环境, 时间戳格式随它走);
    #   ②awk 去掉自加的 $4 数字过滤, 逐字用 as 的 `NR>4 {print $4","$5","$6}` ——
    #   解析口径与 as 完全一致, as 出数这里就出数; 若 as 在同一台机器也不出数,
    #   则是该机 pidstat/内核 task io accounting 的问题, 不在本工具层。
    if [ -n "$ts_pm" ]; then
        ts_pairs=$(LC_ALL=C S_TIME_FORMAT=ISO timeout 5 pidstat -hdt -p "$ts_pm" 1 1 2>/dev/null \
            | awk 'NR>4 {print $4 "," $5 "," $6}' \
            | paste -sd ';')
    fi
    [ -n "$ts_pairs" ] || ts_pairs="0,0,0"
    _vtop_th "$(printf '%-12s %-12s %-11s %-8s %-13s %s' read_kb/s write_kb/s sqlid threads sum\(duration\) sqltext)"
    ts_out=$(_vtop_q "with tmp as (
  select split_part(result, ',', 1) as lwpid,
         split_part(result, ',', 2)::numeric as kb_rd,
         split_part(result, ',', 3)::numeric as kb_wr
  from regexp_split_to_table('${ts_pairs}', ';') as result)
select round(sum(tmp.kb_rd),1)::text,
       round(sum(tmp.kb_wr),1)::text,
       coalesce(nullif(a.unique_sql_id::text,'0'),'-'),
       count(*),
       coalesce(sum(extract(epoch from (now()-a.query_start)))::bigint::text,'-'),
       coalesce(min(substr(regexp_replace(regexp_replace(a.query,'(\r|\n)+',' '),' {2,}',' '),1,40)),'-')
from pg_os_threads s
right join tmp on s.lwpid = tmp.lwpid
left join pg_stat_activity a on s.pid = a.pid
where (a.state = 'active' or a.state is null)
  and a.unique_sql_id is not null and a.unique_sql_id <> 0
group by a.unique_sql_id
having sum(tmp.kb_rd)::numeric + sum(tmp.kb_wr)::numeric > 0
order by sum(tmp.kb_rd)::numeric + sum(tmp.kb_wr)::numeric desc limit 10")
    _vtop_q_warn
    ts_n=0
    while IFS='|' read -r ts_a ts_b ts_c ts_d ts_e ts_sql; do
        [ -z "${ts_a:-}" ] && continue
        [ "$ts_e" != "-" ] && ts_e=$(_vtop_age "$ts_e")
        printf '%-12.12s %-12.12s %-11s %-8s %-13s %.40s\n' "$ts_a" "$ts_b" "$ts_c" "$ts_d" "$ts_e" "$ts_sql"
        ts_n=$((ts_n + 1))
    done <<<"$ts_out"
    while [ "$ts_n" -lt 10 ]; do
        printf '%-12.12s %-12.12s %-11s %-8s %-13s %.40s\n' "-" "-" "-" "-" "-" "-"
        ts_n=$((ts_n + 1))
    done
    printf '\n'
}

_vtop_screen_lock() { # LOCK page -- what the main [LOCK] row only counts:
    #   1) the sessions holding/requesting a lock that would BLOCK DML
    #      (Share / ShareRowExclusive / Exclusive / AccessExclusive on a relation)
    #   2) the FULL blocker tree (the main screen keeps the top-5 roots only)
    #   3) prepared transactions -- they hold locks with pid IS NULL, so they are
    #      the one kind of blocker a naive pid join misses entirely
    # ★原来的 'lock counters' 块已删 (用户 2026-09-28: 不需要) —— 那些数字在主屏 [LOCK] 行
    #   (lock_chains / blocked / wait_<locktype> top-5)。
    local lk_out lk_a lk_b lk_c lk_d lk_e
    local lk_lvl lk_st lk_sid lk_usr lk_bl lk_age lk_sql lk_ind lk_i lk_n
    _vtop_pg lock 'Lock Chains' 'counters / high level relation lock / lock waitchain / 2PC'
    # ★「会阻塞 DML 的锁」把原来的「pg_locks 类型统计表」换掉 (用户 2026-09-28 定的口径):
    #   只列**会话 + SQL + 等待事件**, 对象 = 持有或请求了"会挡住 DML 的常规锁"的那些人。
    #   PG 关系锁冲突矩阵: 正常 DML 只拿 AccessShareLock(读) / RowShareLock(SELECT FOR UPDATE)
    #   / RowExclusiveLock(写) 三档 ⇒ **能挡 DML 的就是 Share / ShareRowExclusive / Exclusive /
    #   AccessExclusive 这四档**(非并发建索引、外键、显式 LOCK、DDL/TRUNCATE/VACUUM FULL)。
    #   ★ShareUpdateExclusiveLock(VACUUM/ANALYZE/CREATE INDEX CONCURRENTLY)**不阻塞 DML**,
    #     故意不收 —— 否则 autovacuum 会常年霸榜, 把真正该看的挤掉。
    #   ★两个坑: ①locktype='transactionid'(行锁)与 'tuple'(元组锁) 的模式也叫 ExclusiveLock,
    #     但那才是**正常 DML**(被堵的 UPDATE) ⇒ 必须限定 locktype='relation';
    #     ②2PC 持锁者 pid IS NULL, 按本页既有约定显示成 'P:<xid>'(与上面阻塞树的 holder 同款)。
    _vtop_sec "high level relation lock"
    _vtop_th "$(printf '%-14s %-26s %-5s %-18s %s' sid lock state event sqltext)"
    lk_out=$(_vtop_q "select
       case when l.pid is null and l.virtualtransaction like '-1/%'
            then 'P:' || split_part(l.virtualtransaction, '/', 2)
            else coalesce(l.sessionid::text, 'pid:' || l.pid::text) end,
       coalesce(c.relname, l.relation::text) || '@' || replace(l.mode, 'Lock', ''),
       case when l.granted then 'hold' else 'wait' end,
       coalesce(w.wait_event, '-'),
       coalesce(substr(regexp_replace(regexp_replace(a.query, '(\r|\n)+', ' '), ' {2,}', ' '), 1, 60), '-')
from pg_locks l
left join pg_class c on c.oid = l.relation
left join pg_stat_activity a on a.sessionid = l.sessionid
left join dbe_perf.thread_wait_status w on w.tid = a.pid
where l.locktype = 'relation'
  and l.mode in ('ShareLock','ShareRowExclusiveLock','ExclusiveLock','AccessExclusiveLock')
order by case when l.granted then 1 else 0 end,
         case l.mode when 'AccessExclusiveLock' then 1 when 'ExclusiveLock' then 2
                     when 'ShareRowExclusiveLock' then 3 else 4 end,
         l.sessionid
limit 15")
    _vtop_q_warn
    lk_n=0
    while IFS='|' read -r lk_a lk_b lk_c lk_d lk_e; do
        [ -z "${lk_a:-}" ] && continue
        printf '%-14s %-26s %-5s %-18s %.60s\n' "$lk_a" "$lk_b" "$lk_c" "$lk_d" "$lk_e"
        lk_n=$((lk_n + 1))
    done <<<"$lk_out"
    [ "$lk_n" -eq 0 ] && printf '%-14s %-26s %-5s %-18s %.60s\n' "-" "-" "-" "-" "-"
    printf '\n'
    _vtop_sec "lock waitchain"
    # ★列名 holder -> sid (用户 2026-09-28: 「holder 是啥意思 你就写 sid 好了」—— 这列本来就是
    #   会话 id(sessionid; 2PC 显示 P:<xid>), 叫 holder 反而绕。SQL 里的别名仍是 holder, 只改表头。
    _vtop_th "$(printf '%-4s %-8s %-24s %-8s %-7s %-13s %s' lvl state sid user blocked max_xact_age query)"
    lk_out=$(_vtop_q "WITH RECURSIVE l AS (
  SELECT sessionid, pid, locktype, granted, virtualtransaction,
    ROW(locktype,database,relation,page,tuple,virtualxid,transactionid,classid,objid,objsubid) obj,
    CASE WHEN pid IS NULL AND virtualtransaction LIKE '-1/%'
         THEN 'P:' || split_part(virtualtransaction, '/', 2)
         ELSE COALESCE(sessionid::text, 'pid:' || pid::text) END AS holder
  FROM pg_locks
), pairs AS (
  SELECT DISTINCT w.holder waiter, l.holder locker, l.obj::text
  FROM l w
  JOIN l ON l.obj IS NOT DISTINCT FROM w.obj AND l.locktype=w.locktype
        AND l.holder IS NOT NULL AND w.holder IS NOT NULL
        AND l.holder IS DISTINCT FROM w.holder AND l.granted
  WHERE NOT w.granted
), tree AS (
  SELECT l.locker holder, l.locker root, NULL::text obj, 0 lvl,
         l.locker w_chain, array_agg(l.locker) OVER () all_pids
  FROM ( SELECT DISTINCT locker FROM pairs l WHERE NOT EXISTS (SELECT 1 FROM pairs WHERE waiter=l.locker) ) l
  UNION ALL
  SELECT w.waiter, tree.root, w.obj, tree.lvl+1,
         concat(tree.w_chain,'.',w.waiter), array_cat(all_pids, array_agg(w.waiter) OVER ())
  FROM tree JOIN pairs w ON tree.holder=w.locker AND NOT w.waiter = ANY (all_pids)
)
-- ★每个 (链, lvl) **聚合成一行** (用户 2026-09-28): 不再一个会话一行。一行的含义 =
--   这条链在这一层上有几个会话(blocked 列) + 本层**最大的事务年龄**(max_xact_age 列),
--   而 state / sid / user / query 取的是**本层 max_xact_age 那个会话**的(最有代表性的那个;
--   同年龄按 sid 稳定排序)。层级顺序仍按链序, 缩进照旧在 sid 字段内部(列不会漂)。
SELECT lvl, state, sid, usename, nsess, max_age, q
FROM (
  SELECT lvl, state, sid, usename, age_s, q,
         -- ★blocked = **本层被堵的会话数**: lvl=0 是 final blocker(它不被任何人堵) ⇒ 恒 0;
         --   lvl>=1 的每一层都是正在等待的会话 ⇒ 本层会话数 (用户 2026-09-28:「lvl=0 的 blocked
         --   应该是 0 吧」)。这样 lvl>=1 各层相加 = 这条链一共堵了几个。
         CASE WHEN lvl = 0 THEN 0 ELSE count(*) OVER (PARTITION BY root, lvl) END AS nsess,
         max(age_s) OVER (PARTITION BY root, lvl) AS max_age,
         min(w_chain) OVER (PARTITION BY root) AS chain_key,
         row_number() OVER (PARTITION BY root, lvl ORDER BY age_s DESC, sid) AS rn
  FROM (
    SELECT tree.root, tree.lvl, tree.w_chain,
      CASE WHEN tree.holder LIKE 'P:%' THEN '2pc'
           WHEN a.sessionid IS NOT NULL THEN COALESCE(case a.state when 'active' then 'act' when 'idle' then 'idle'
                                      when 'idle in transaction' then 'idle-tx'
                                      when 'idle in transaction (aborted)' then 'idle-tx!'
                                      when 'fastpath function call' then 'fastpath'
                                      when 'disabled' then 'disabled' else '?' end,'unknown')
           ELSE 'gone' END AS state,
      tree.holder AS sid,
      COALESCE(a.usename, px.owner, '-') AS usename,
      extract(epoch from (clock_timestamp() - COALESCE(a.xact_start, px.prepared)))::bigint AS age_s,
      COALESCE(substr(regexp_replace(regexp_replace(a.query,'(\r|\n)+',' '),' {2,}',' '),1,52),
               CASE WHEN tree.holder LIKE 'P:%' THEN concat('[prepared] ',px.gid) END) AS q
    FROM tree
    LEFT JOIN pg_stat_activity a ON a.sessionid::text = tree.holder
    LEFT JOIN pg_prepared_xacts px ON tree.holder = 'P:' || px.transaction::text
  ) x
) y
WHERE rn = 1
ORDER BY chain_key, lvl LIMIT 50")
    _vtop_q_warn
    lk_n=0
    while IFS='|' read -r lk_lvl lk_st lk_sid lk_usr lk_bl lk_age lk_sql; do
        [ -z "${lk_sid:-}" ] && continue
        # ★缩进封顶 5 层(用户 2026-09-28:「有缩进 但是也要对齐啊 一般lvl不会太深」):
        #   缩进写在 sid 字段**内部**, 字段宽 24 = 最大缩进 10 + sessionid 14, 所以缩进**不会把
        #   后面的列往右推**(列始终对齐); 超过 5 层不再加缩进, 真实层级看 lvl 列(不丢信息)。
        lk_ind=""; lk_i=0
        while [ "$lk_i" -lt "${lk_lvl:-0}" ] 2>/dev/null && [ "$lk_i" -lt 5 ]; do lk_ind="$lk_ind  "; lk_i=$((lk_i + 1)); done
        # ★标识符列一律不带精度 (用户 2026-09-28 拍板「不截断, 撑宽」): `%-Ns` 是左对齐+最小宽度,
    #   而 `%-N.Ns` 多一道"超出就砍"的上限 —— 砍掉的若是 sessionid/LSN 这种标识符, 给出的
    #   就是一个看着合理的错值。restart_lsn / sid_bsid / MEMSES sid 三列已去掉精度;
    #   指标与标签列 (state/wait_event/sqltext 等) 保留定宽, 它们超出只是难看。
    # ★holder 去掉 .15 精度 (用户 2026-09-28 拍板修): sessionid 是 14 位, 缩进每层 2 空格
        #   ⇒ 第 1 层就是 16 字符, `%-15.15s` 会**截掉 sessionid 最后一位**, 深链直接显示
        #   一个错的 sid (是标识符, 不是指标, 截断等于给错数据)。去掉精度后超宽只会把
        #   后面的列往右推, 不再丢字符; 0 层(14 字符)仍然对齐。
        printf '%-4s %-8.8s %-24s %-8s %-7s %-13s %.52s\n' \
            "$lk_lvl" "$lk_st" "$lk_ind$lk_sid" "$lk_usr" "$lk_bl" "$(_vtop_age "$lk_age")" "$lk_sql"
        lk_n=$((lk_n + 1))
    done <<<"$lk_out"
    # ★空态不再打 '(no blocking chains right now)' (用户 2026-09-28): 按子页惯例
    #   默认预留**一行 '-' 占位**(表头始终可见, 缺行=不知道 的歧义消失)。
    [ "$lk_n" -eq 0 ] && printf '%-4s %-8.8s %-24s %-8s %-7s %-13s %.52s\n' "-" "-" "-" "-" "-" "-" "-"

    printf '\n'
    _vtop_sec "prepared transactions (2PC)"
    _vtop_th "$(printf '%-16s %-12s %-12s %-14s %s' gid database owner prepared_age transaction)"
    lk_out=$(_vtop_q "select gid, coalesce(database,'-'), coalesce(owner,'-'),
       extract(epoch from (clock_timestamp() - prepared))::bigint, transaction::text
from pg_prepared_xacts order by prepared limit 10")
    _vtop_q_warn
    lk_n=0
    while IFS='|' read -r lk_a lk_b lk_c lk_d lk_e; do
        [ -z "${lk_a:-}" ] && continue
        # ★gid/database/owner 是标识符, 一律不截断 (2026-11-17 复核): gid 是应用给的
        #   任意文本, 也是 `ROLLBACK PREPARED '<gid>'` 的唯一钥匙 —— 16 字符截断后
        #   印出的是一个"看着合理的错值" (同本页 28410-28417 的既有规矩)。
        printf '%-16s %-12s %-12s %-14s %s\n' "$lk_a" "$lk_b" "$lk_c" "$(_vtop_age "$lk_d")" "$lk_e"
        lk_n=$((lk_n + 1))
    done <<<"$lk_out"
    # ★空态同上: 一行 '-' 占位, 不再打 '(no prepared transactions)'
    [ "$lk_n" -eq 0 ] && printf '%-16s %-12s %-12s %-14s %s\n' "-" "-" "-" "-" "-"

    printf '\n'
}

_vtop_screen_stack() { # STACK page -- `vb_tool stack`'s SUMMARY part only
    # (user's spec 2026-09-29: 参考vb_tool stack功能, 只输出汇总部分): ONE
    # instantaneous `vb_ctl stack -D` dump aggregated Percona pt-pmp style --
    # identical chains counted together, leaf frame first, '<-' reads "called
    # by". No raw-sample dump, no multi-sample loop: a dump already is a
    # point-in-time picture of every thread, so the page is an instantaneous
    # reading and opens at the steady sub-screen cadence -- it is NOT in
    # _vtop_quick_first_screens (no 5s first refresh) and not an OS page.
    local st_dd st_raw st_chains st_agg st_t st_d st_rc
    _vtop_pg stack 'Stack' 'one instant dump, aggregated (summary only)'
    # datadir = run_vtop's one-time resolution (dynamic scope): the SAME
    # instance every other page queries -- never a second, own guess
    st_dd="${datadir:-}"
    if [ -z "$st_dd" ] || [ "$st_dd" = "unknown" ] || [ ! -d "$st_dd" ]; then
        printf '%s  !! datadir unresolved -- cannot run vb_ctl stack%s\n' "${c_red:-}" "${c_off:-}"
        return 0
    fi
    if ! command -v vb_ctl >/dev/null 2>&1; then
        printf '%s  !! vb_ctl not found in PATH%s\n' "${c_red:-}" "${c_off:-}"
        return 0
    fi
    st_raw=$(mktemp "${TMPDIR:-/tmp}/vbtop_stack.$$.XXXXXX")
    st_chains=$(mktemp "${TMPDIR:-/tmp}/vbtop_stkch.$$.XXXXXX")
    st_agg=$(mktemp "${TMPDIR:-/tmp}/vbtop_stkagg.$$.XXXXXX")
    timeout 30 vb_ctl stack -D "$st_dd" >"$st_raw" 2>&1
    st_rc=$?
    # thread -> chain (leaf first): the SAME parser as run_stack -- symbols
    # keep their names (offsets stripped), unresolved addresses normalize to
    # 0x???? and unsampleable threads to one constant, so they all aggregate
    awk '
        function flush_thread() {
            if (in_thread && nframes > 0) {
                chain = frames[1]
                for (k = 2; k <= nframes; k++) chain = chain " <- " frames[k]
                print chain
            }
            in_thread = 0; nframes = 0
        }
        /^Thread [0-9]+ tid</ { flush_thread(); in_thread = 1; next }
        in_thread && (/^[ \t]*$/ || /^\[/) { flush_thread(); next }
        in_thread {
            line = $0
            sub(/[ \t]+$/, "", line)
            sub(/ \+ 0x[0-9a-fA-F]+$/, "", line)
            if (line ~ /^0x[0-9a-fA-F]+$/) line = "0x????"
            if (line ~ /not available/) { nframes = 1; frames[1] = "thread <not available>"; next }
            if (line != "") { nframes++; frames[nframes] = line }
        }
        END { flush_thread() }
    ' "$st_raw" > "$st_chains"
    st_t=$(wc -l < "$st_chains" | tr -d ' ')
    sort "$st_chains" | uniq -c | sort -k1,1nr -k2,2 > "$st_agg"
    st_d=$(wc -l < "$st_agg" | tr -d ' ')
    # the banner carries the thread count the same way run_stack's block
    # header does ("sample 1/3 (N threads)")
    _vtop_sec "stack summary (${st_t} threads)"
    _vtop_th "$(printf '%6s  %5s  %s' cnt pct 'chain (leaf <- caller <- ...)')"
    if [ "$st_t" -eq 0 ]; then
        # nothing parsed: say WHY (vb_ctl failure), not just an empty table
        printf '%s  !! vb_ctl stack produced no threads (rc=%s)%s\n' "${c_red:-}" "$st_rc" "${c_off:-}"
        printf '%6s  %5s  %s\n' "-" "-" "-"
    else
        # top 30 chains by thread count; pct = share of THIS dump's threads.
        # Long chains wrap at the page width, continuation aligns under the
        # chain column (the same layout as run_stack's summary).
        # ★LINE BUDGET 40 (user's call 2026-09-29: 「stack限制一下行数输出
        #   别超屏幕了 后面就给个提示 省略了就行」→44 太多→「还是少几行吧
        #   我怕有些堆栈比较长」): a chain is printed only if it fits WHOLE
        #   (cutting mid-chain would hide its callers), the first chain always
        #   prints (never an empty page), and whatever fell off -- line-budget
        #   cut + chains beyond the top-30 input cap - is summed into ONE
        #   trailing note.
        head -30 "$st_agg" | awk -v total="$st_t" -v width="$(( ${_vtop_w:-150} - 2 ))" -v maxl=40 \
                               -v more=$(( st_d > 30 ? st_d - 30 : 0 )) '
        {
            pct = $1 * 100.0 / total
            chain = substr($0, index($0, $2))
            n = split(chain, fr, " <- ")
            line = sprintf("%6d  %5.1f%%  %s", $1, pct, fr[1])
            indent = sprintf("%*s", 16, "")
            no = 0
            for (i = 2; i <= n; i++) {
                if (length(line) + length(" <- " fr[i]) > width) {
                    ol[++no] = line
                    line = indent "<- " fr[i]
                } else {
                    line = line " <- " fr[i]
                }
            }
            ol[++no] = line
            if (shown > 0 && shown + no > maxl) { skip++; next }
            for (i = 1; i <= no; i++) print ol[i]
            shown += no
        }
        END {
            if (skip > 0 || more > 0) {
                parts = ""
                if (skip > 0)  parts = skip " chains"
                if (more > 0)  parts = parts (parts ? " + " : "") more " beyond top-30"
                printf "(omitted %s; full dump: vb_tool stack)\n", parts
            }
        }'
    fi
    rm -f "$st_raw" "$st_chains" "$st_agg"
    printf '\n'
}

# ★OS mem page (user 2026-11-16): one place for the OS memory story --
# component breakdown (meminfo), fault/reclaim PRESSURE (vmstat deltas over a
# measured 1s window) and fragmentation (buddyinfo free-page orders + order-0
# share + compaction pressure). /proc only: works unprivileged, no tools.
_vtop_screen_osmem() {
    _vtop_pg osmem
    local vs0 vs1 t0 t1
    # ---- 1. component breakdown (meminfo) + swap devices ----
    _vtop_sec "meminfo (/proc/meminfo)"
    awk '
        BEGIN {
            n = split("MemTotal MemFree MemAvailable Buffers Cached SwapCached Active(anon) Inactive(anon) Active(file) Inactive(file) Unevictable Mlocked SwapTotal SwapFree Dirty Writeback AnonPages Shmem Slab SReclaimable SUnreclaim KernelStack PageTables AnonHugePages HugePages_Total HugePages_Free Hugepagesize VmallocUsed VmallocChunk Committed_AS CommitLimit DirectMap4k DirectMap2M DirectMap1G CmaTotal CmaFree", want, " ")
            for (i = 1; i <= n; i++) w[want[i]] = i
        }
        {
            k = $1; sub(/:$/, "", k)
        }
        k in w {
            v = $2 + 0
            if (k ~ /^HugePages/) h = v " " $3
            else if (v >= 1048576) h = sprintf("%.1fG", v / 1048576)
            else if (v >= 1024)    h = sprintf("%.0fM", v / 1024)
            else                   h = v "K"
            out[k] = h
        }
        END {
            line = 0; row = ""
            for (i = 1; i <= n; i++) {
                k = want[i]
                if (!(k in out)) continue
                row = row sprintf("%-18s %8s  ", k, out[k])
                if (++line % 4 == 0) { print row; row = "" }
            }
            if (row != "") print row
        }' /proc/meminfo 2>/dev/null || printf '%s  !! /proc/meminfo unreadable%s\n' "${c_red:-}" "${c_off:-}"
    # swap devices (per-device usage; totals are already in meminfo)
    # ★freeK = Size-Used (2026-11-17 独立复核): /proc/swaps $3=Size $4=Used,
    #   旧写 $4-$3 = Used-Size, swap 用量>0 的机器 freeK 必现负值。
    [ -r /proc/swaps ] && tail -n +2 /proc/swaps 2>/dev/null | awk '
        { printf "%-30s %-10s %12s %12s %6s\n", $1, $2, $4, $3 - $4, $5 }' | sed '1i device                         type       usedK       freeK  prio'

    # ---- 2. pressure: faults & reclaim (1s measured window) ----
    _vtop_sec "page faults & reclaim (/proc/vmstat, 1s window)"
    t0=$(date +%s%3N)
    # ★回收四键必须带分 zone 兜底 (2026-11-17 三轮复核): pgscan_kswapd/pgscan_direct/
    #   pgsteal_kswapd/pgsteal_direct 汇总项是 5.9+ 内核才有的; 3.10/4.19 (204 就是) 只有
    #   pgscan_kswapd_normal 这类分 zone 键 —— 旧正则带尾随空格, 分 zone 键一个都抓不到,
    #   四行回收速率恒 0.0/s、efficiency 假 100%。正则放宽到 (_| ) 二选一, 兜底在 awk 里做
    #   (口径照抄 _vtop_pgc: 汇总优先、分 zone 求和、排除 _throttle/_khugepaged/_anon/_file)。
    vs0=$(grep -E '^(pgfault|pgmajfault|slabs_scanned|kswapd_inodesteal|pgrotated|compact_stall|compact_fail|compact_success|oom_kill|thp_fault_alloc|thp_collapse_alloc) |^(pgscan_kswapd|pgscan_direct|pgsteal_kswapd|pgsteal_direct)(_| )' /proc/vmstat 2>/dev/null)
    sleep 1
    vs1=$(grep -E '^(pgfault|pgmajfault|slabs_scanned|kswapd_inodesteal|pgrotated|compact_stall|compact_fail|compact_success|oom_kill|thp_fault_alloc|thp_collapse_alloc) |^(pgscan_kswapd|pgscan_direct|pgsteal_kswapd|pgsteal_direct)(_| )' /proc/vmstat 2>/dev/null)
    t1=$(date +%s%3N)
    [ -n "$vs1" ] || { printf '%s  !! /proc/vmstat unreadable%s\n' "${c_red:-}" "${c_off:-}"; printf '\n'; return 0; }
    [ "$t1" -gt "$t0" ] 2>/dev/null || t1=$((t0 + 1000))
    printf '%s\n\n%s\n' "$vs0" "$vs1" | awk -v ms=$((t1 - t0)) '
        NF == 0 { second = 1; next }
        { if (!second) A[$1] = $2 + 0; else B[$1] = $2 + 0 }
        # ★分 zone 兜底 (2026-11-17 三轮复核, 口径照抄 _vtop_pgc): 汇总键缺失时按
        #   同前缀分 zone 键求和补出汇总值; 排除 _throttle (sar pgscand 不含) 与
        #   _khugepaged/_anon/_file (另一条通路/切面)。不能边遍历边插入 ⇒ 先收键名再求和。
        function norm(M, k,    kk, n2, s, i) {
            if (k in M) return
            n2 = 0
            for (kk in M) if (kk ~ ("^" k "_")) MKEYS[++n2] = kk
            if (n2 == 0) return
            s = 0
            for (i = 1; i <= n2; i++) {
                if (MKEYS[i] ~ /_throttle$/ || MKEYS[i] ~ /_khugepaged$/ || MKEYS[i] ~ /_(anon|file)$/) continue
                s += M[MKEYS[i]]
            }
            M[k] = s
        }
        function rate(k) { return (k in A && k in B) ? (B[k] - A[k]) * 1000 / ms : 0 }
        function p(k)   { if (k in A) printf "%-18s %10.1f/s  ", k, rate(k) }
        END {
            norm(A, "pgscan_kswapd");  norm(A, "pgscan_direct");  norm(A, "pgsteal_kswapd");  norm(A, "pgsteal_direct")
            norm(B, "pgscan_kswapd");  norm(B, "pgscan_direct");  norm(B, "pgsteal_kswapd");  norm(B, "pgsteal_direct")
            p("pgfault");        p("pgmajfault");      p("pgscan_kswapd");  p("pgscan_direct"); print ""
            p("pgsteal_kswapd"); p("pgsteal_direct");  p("slabs_scanned");  p("kswapd_inodesteal"); print ""
            p("pgrotated");      p("compact_stall");   p("compact_fail");   p("compact_success"); print ""
            # presence-guarded edge rows: OOM (kernel >= 4.x counter) and THP
            if ("oom_kill" in A || "thp_fault_alloc" in A) {
                p("oom_kill"); p("thp_fault_alloc"); p("thp_collapse_alloc"); print ""
            }
            sc = rate("pgscan_kswapd") + rate("pgscan_direct")
            st = rate("pgsteal_kswapd") + rate("pgsteal_direct")
            # ★sc<=0 印 '-' 不印 100% (2026-11-17 三轮复核): 空窗没有回收活动,
            #   "100%" 是编造的测量值 (0=确认没有, 缺=不知道)。
            if (sc > 0) printf "reclaim efficiency: %.0f%% (steal/scan)", st * 100 / sc
            else        printf "reclaim efficiency: - (no reclaim activity in this window)"
        }'
    printf '\n'

    # ---- 3. zone watermarks: WHERE free sits vs min/low/high ----
    # the causal anchor of box 2: free > high idle; high..low armed;
    # low..min kswapd reclaiming; below min DIRECT reclaim (stalls).
    _vtop_sec "zone watermarks (/proc/zoneinfo)"
    awk -v ps="$(getconf PAGESIZE 2>/dev/null || echo 4096)" '
        function h(v) {
            if (v >= 1073741824) return sprintf("%.1fG", v / 1073741824)
            if (v >= 1048576)    return sprintf("%.0fM", v / 1048576)
            if (v >= 1024)       return sprintf("%.0fK", v / 1024)
            return v "B"
        }
        function bar(free, min, low, high,   span, W, c, i, fl, fp, li, ov, o) {
            # current-level gauge on the min..low..high scale: m/l/h are the
            # marks, F is where free sits NOW (overflow = multiple above high,
            # "!" = below min). Character-only, colour-independent by design.
            W = 20
            span = high - min; if (span <= 0) span = 1
            fl = (free - min) / span
            for (i = 0; i < W; i++) c[i] = "-"
            c[0] = "m"
            li = int((low - min) / span * (W - 1) + 0.5); if (li > 0 && li < W - 1) c[li] = "l"
            c[W - 1] = "h"
            fp = int(fl * (W - 1) + 0.5)
            ov = ""
            if (fp < 0)          { fp = 0; ov = "!" }
            # ★溢出口径 (2026-11-17 复核): 标的是"free 是 high 的几倍", 所以分母
            #   必须是 high。旧写用 fl=(free-min)/(high-min) 的仪表刻度值直接标
            #   "N.Nx-high" —— min 偏移把它放大 high/(high-min) 倍 (204 实测 82.1x
            #   而真实 28.0x), 运维会高估回收余量。
            if (fp > W - 1)      { fp = W - 1; if (free > high) ov = sprintf("%.1fx-high", free / high) }
            c[fp] = "F"
            o = "["
            for (i = 0; i < W; i++) o = o c[i]
            return o ov
        }
        BEGIN { printf "%-12s %9s %9s %9s %9s  %-32s %s\n", "zone", "free", "min", "low", "high", "level (m/l/h=F now)", "state" }
        # header shape: "Node 0, zone    DMA32" -> node in $2 (comma), zone in $4
        /^Node [0-9]+, zone/ { z = $2; sub(/,/, "", z); zone = z " " $4; next }
        $1 == "pages" && $2 == "free" { free = $3 + 0; next }
        $1 == "min"  { min = $2 + 0; next }
        $1 == "low"  { low = $2 + 0; next }
        $1 == "high" {
            high = $2 + 0
            if (zone != "" && min > 0) {
                st = (free > high) ? "above-high" : ((free > low) ? "high..low" : ((free > min) ? "low..min kswapd" : "BELOW-MIN direct"))
                printf "%-12s %9s %9s %9s %9s  %-32s %s\n", zone, h(free * ps), h(min * ps), h(low * ps), h(high * ps), bar(free, min, low, high), st
            }
            zone = ""; min = low = high = 0
        }
        END { if (NR <= 1) exit 1 }
    ' /proc/zoneinfo 2>/dev/null || printf '%s  !! /proc/zoneinfo unreadable%s\n' "${c_red:-}" "${c_off:-}"
    printf '  %smin_free_kbytes%s %s    %slevel%s m=min l=low h=high  F=free now  (!=below min)\n' \
        "${c_lbl:-}" "${c_off:-}" "$(cat /proc/sys/vm/min_free_kbytes 2>/dev/null || echo '?')" \
        "${c_lbl:-}" "${c_off:-}"

    # ---- 4. fragmentation: buddyinfo + order-0 share ----
    _vtop_sec "buddyinfo free pages by order (/proc/buddyinfo)"
    # shape: "Node 0, zone    DMA32   9 233 100 ..." -- node in $2, zone name
    # in $4, per-order counts from $5. free is shown humanized (pages x PAGESIZE);
    # o0 = order-0 pages (碎片粗估: 小页占比越高越碎), o1+ = mergeable bulk.
    # per-order BLOCK COUNTS (not pages): order N = one 2^N-page contiguous
    # block. o0..o3 individually (fragmentation lives in the low orders),
    # o4+ aggregated (bulk stock, orders 4..10). No separate o9 column: it is
    # already inside o4+ -- listing both reads as a double count. An
    # o1+/everything lump would hide exactly the case that matters: plenty of
    # low-order blocks, ZERO high-order (no huge pages no matter how "free").
    awk -v ps="$(getconf PAGESIZE 2>/dev/null || echo 4096)" '
        function h(v) {
            if (v >= 1073741824) return sprintf("%.1fG", v / 1073741824)
            if (v >= 1048576)    return sprintf("%.0fM", v / 1048576)
            if (v >= 1024)       return sprintf("%.0fK", v / 1024)
            return v "B"
        }
        BEGIN {
            printf "%-12s %9s %7s %7s %7s %7s %8s %7s %7s %7s %7s %7s\n",
                   "zone", "free", "o0", "o1", "o2", "o3", "o4+", "o0%", "o1%", "o2%", "o3%", "o4+%"
        }
        {
            z = $2; sub(/,/, "", z); zone = z " " $4
            # ★buddyinfo 的数按 order 是"块的个数", 不是页数 (2026-11-17 复核):
            #   order N 的一块 = 2^N 页。旧代码把块数当页数求和, "free" 低估 1~1024 倍
            #   (实测 DMA32: 旧 32M / 真 1.8G), o0%..o4+% 也变成块数占比 (实测
            #   o4+ 5.3% vs 真实页占比 95.3%, 碎片结论完全反过来)。
            #   计数列仍按"块个数"显示 (o0..o4+ 语义不变), 页数只用于 free 与百分比。
            total = 0; hi = 0; hib = 0
            for (i = 5; i <= NF; i++) { w = 2 ^ (i - 5); total += $i * w; if (i >= 9) { hi += $i * w; hib += $i } }
            printf "%-12s %9s %7d %7d %7d %7d %8d %6.1f%% %6.1f%% %6.1f%% %6.1f%% %6.1f%%\n", zone, h(total * ps),
                   $5, $6, $7, $8, hib,
                   (total > 0 ? $5 * 100 / total : 0),     (total > 0 ? $6 * 2 * 100 / total : 0),
                   (total > 0 ? $7 * 4 * 100 / total : 0), (total > 0 ? $8 * 8 * 100 / total : 0),
                   (total > 0 ? hi * 100 / total : 0)
        }
        END { if (NR == 0) exit 1 }
    ' /proc/buddyinfo 2>/dev/null || printf '%s  !! /proc/buddyinfo unreadable%s\n' "${c_red:-}" "${c_off:-}"
    printf '\n'
}

# ★OS sub-page (user 2026-11-14): iostat -xm restricted to the data_dir
# filesystem's OWN devices -- on an LVM/RAID fs the main screen's DSK line
# names the dm device and its I/O row follows the WORST physical member, so
# this page puts the dm layer and its members side by side in iostat's own
# columns instead. Never the whole box's device list: iostat is given the
# device names as arguments (kernel dm-X names, /proc/diskstats spelling).
# Entry: command line 'd'. Cadence: flat 3s (registered in _vtop_os_screens).
# Two 1s samples are taken -- iostat's FIRST block is since-boot, useless as a
# live reading -- and only the LAST "Device:" block is kept (each interval
# block repeats the header on sysstat 10/11/12, verified on 204's 10.1.5).
_vtop_screen_iostat() {
    # full stack: fs device + every intermediate layer (mpath dm) + leaves
    # (paths). _vtop_disk_expand's leaf-only view skips the mpath layer of an
    # LVM-on-multipath sandwich; a plain single-disk fs still shows one disk.
    local dset
    dset=$(_vtop_disk_stack "$dev" | tr '\n' ' ')
    dset="${dset% }"; dset="${dset# }"
    [ -n "$dset" ] || dset="$dev"
    # extra devices from custom tablespaces / relocated WAL were resolved ONCE
    # at startup into $tsdevs (user 2026-11-16: 不必每帧重查 pg_tblspc)
    case " $dset " in
        *" $tsdevs "*) ;;
        *) for _d in ${tsdevs:-}; do
               case " $dset " in *" $_d "*) ;; *) dset="$dset $_d";; esac
           done ;;
    esac
    _vtop_pg iostat
    _vtop_sec "iostat -xm"   # banner = boxify trigger: page content gets the frame
    if ! command -v iostat >/dev/null 2>&1; then
        printf '%s  !! iostat not found (sysstat)%s\n' "${c_red:-}" "${c_off:-}"
        return 0
    fi
    if [ -z "$dset" ] || [ "$dset" = "-" ]; then
        printf '%s  !! cannot map data_dir to a block device%s\n' "${c_red:-}" "${c_off:-}"
        return 0
    fi
    # timeout: a wedged device must never freeze the page (same rule as every
    # sampler); 2x1s samples + slop. Parse: buffer resets at every "Device:"
    # header, so END holds exactly the last block; no header at all (bad device
    # name, empty sysstat) falls through to the visible error line.
    LC_ALL=C timeout 8 iostat -xmd 1 2 $dset 2>/dev/null | awk '
        /^Device:/     { buf = $0 "\n"; next }
        buf != "" && NF > 1 { buf = buf $0 "\n" }
        END { if (buf == "") exit 1; printf "%s", buf }
    ' || printf '%s  !! iostat produced no rows for: %s%s\n' "${c_red:-}" "$dset" "${c_off:-}"
    _vtop_sec "vb thread IO top"
    _vtop_procio || printf '%s  !! /proc 不可读%s\n' "${c_red:-}" "${c_off:-}"
    printf '\n'
}

# ★proc IO top (user 2026-11-16: iostat 页要 iotop 的效果, 但 iotop 不是所有环境都有).
# iotop itself (data.py): default output is THREAD granularity (-P aggregates)
# and its /proc fallback reads the same io files -- this box matches that
# semantics without netlink/root. /proc/<pid>/io IS iotop's fallback source --
# per-process cumulative
# read_bytes/write_bytes; two snapshots over a measured window give the
# per-process IO rate with zero external dependencies. Permissions: the file
# is 0400-owner, so as the DB user the instance's OWN processes (the ones
# worth watching) are readable; other users' processes are skipped, root sees
# all. Threads are included in their process's counters (thread group).
_vtop_procio_snap() { # -> "tid read_bytes write_bytes comm" lines (THREAD level)
    # VastBase runs a thread pool inside the postmaster process -- per-PROCESS
    # io would merge every session into one row. /proc/<pid>/task/<tid>/io
    # gives one counter set per thread (each thread exactly once; the group
    # leader's /proc/<pid>/io line is the thread SUM and is not walked), and
    # a thread's tid is the same id family VB sessionids are built from, so
    # rows cross-reference with the sess page.
    awk 'BEGIN {
        while (("ls -d /proc/[0-9]*/task/[0-9]*" | getline d) > 0) {
            tid = substr(d, match(d, /task\//) + 5)
            f = d "/io"
            rb = wb = sc = sw = -1
            while ((getline l < f) > 0) {
                # strip the "label:" prefix BEFORE the numeric cast -- awk
                # coercion of "read_bytes: 123" is 0, not 123
                ci = index(l, ":")
                if      (l ~ /^read_bytes:/)  rb = substr(l, ci + 1) + 0
                else if (l ~ /^write_bytes:/) wb = substr(l, ci + 1) + 0
                else if (l ~ /^syscr:/)       sc = substr(l, ci + 1) + 0
                else if (l ~ /^syscw:/)       sw = substr(l, ci + 1) + 0
            }
            close(f)
            if (rb < 0 || wb < 0) continue   # unreadable (other uid) or vanished
            comm = ""
            if ((getline c < (d "/comm")) > 0) { gsub(/[[:space:]]/, "_", c); comm = c }
            close(d "/comm")
            printf "%s %s %s %s %s %s\n", tid, rb, wb, sc, sw, comm
        }
        close("ls -d /proc/[0-9]*/task/[0-9]*")
    }' 2>/dev/null
}

# rank processes by read+write delta in the window; human rates, top rows only
_vtop_procio() { # -> "pid comm read/s write/s" ranked rows, or a no-IO note
    local a b t0 t1
    t0=$(date +%s%3N)
    a=$(_vtop_procio_snap)
    sleep 1
    b=$(_vtop_procio_snap)
    t1=$(date +%s%3N)
    [ -n "$b" ] || return 1
    [ "$t1" -gt "$t0" ] 2>/dev/null || t1=$((t0 + 1000))
    printf '%s\n\n%s\n' "$a" "$b" | awk -v top=20 -v ms=$((t1 - t0)) '
        NF == 0 { second = 1; next }
        {
            p = $1
            if (!second) { Ar[p] = $2; Aw[p] = $3; As[p] = $4; Ax[p] = $5 }
            else         { Br[p] = $2; Bw[p] = $3; Bs[p] = $4; Bx[p] = $5; Cm[p] = $6 }
        }
        function h(v) {
            if (v >= 1073741824) return sprintf("%.1fG", v / 1073741824)
            if (v >= 1048576)    return sprintf("%.1fM", v / 1048576)
            if (v >= 1024)       return sprintf("%.1fK", v / 1024)
            return sprintf("%d", v)
        }
        END {
            s = ms / 1000; if (s <= 0) s = 1
            n = 0
            for (p in Br) {
                if (!(p in Ar)) continue
                dr = Br[p] - Ar[p]; dw = Bw[p] - Aw[p]
                ds = Bs[p] - As[p]; dx = Bx[p] - Ax[p]
                # ★TID 复用 (2026-11-17 复核): 线程在 1s 采样窗内退出、tid 又被新线程
                #   复用 ⇒ 新线程的小计数减旧线程的大计数 = 大负数, 会印出 "-1.4G/s"。
                #   与本帧其它所有差分块同规矩: 负增量钳 0。
                if (dr < 0) dr = 0; if (dw < 0) dw = 0
                if (ds < 0) ds = 0; if (dx < 0) dx = 0
                if (dr + dw > 0 || ds + dx > 0) { n++; P[n] = p; D[n] = dr + dw; R[n] = dr; W[n] = dw; SR[n] = ds; SW[n] = dx }
            }
            if (n == 0) { print "(窗口内无线程块设备 IO, 或仅其他用户的线程不可读)"; exit }
            m = (n < top ? n : top)
            for (i = 1; i <= m; i++) {
                best = 0
                for (j = 1; j <= n; j++)
                    if (!U[j] && (best == 0 || D[j] > D[best])) best = j
                U[best] = 1; QP[i] = P[best]; QR[i] = R[best]; QW[i] = W[best]; QC[i] = Cm[P[best]]; QS[i] = SR[best]; QT[i] = SW[best]
            }
            printf "%-8s %-16s %10s %10s %8s %8s\n", "tid", "thread", "read/s", "write/s", "syscr/s", "syscw/s"
            for (i = 1; i <= m; i++)
                printf "%-8s %-16s %10s %10s %8d %8d\n", QP[i], substr(QC[i], 1, 16), h(QR[i] / s), h(QW[i] / s), QS[i] / s, QT[i] / s
            tr = tw = ts = tx = 0
            for (j = 1; j <= n; j++) { tr += R[j]; tw += W[j]; ts += SR[j]; tx += SW[j] }
            printf "%-8s %-16s %10s %10s %8d %8d\n", "total", "(" n " threads)", h(tr / s), h(tw / s), ts / s, tx / s
        }'
}

# ★OS sub-pages (user 2026-11-14, same session as iostat: cpu / mem / net).
# One skeleton for all four: _vtop_pg header, flat 3s (registered in
# _vtop_os_screens), the tool's own columns passed through, and the LAST live
# sample kept -- sysstat's first block is since-boot and the trailing
# "Average:" block averages the whole run; neither is a live reading.
# sysstat block shape (verified on 204, sysstat 10.1.5): each interval block
# is a run of lines whose first field is a timestamp, so "last run of
# timestamped lines" is exactly the last 1s window; vmstat instead prints a
# 2-line header once and one row per interval -> keep header + last row.
_vtop_sar_lastblock() { # stdin sysstat output -> last live sample block
    # Structure, NOT timestamps: sysstat separates sample blocks with BLANK
    # lines and ends with an "Average:" summary block. The header line's
    # second and the rows' second can differ by 1 (en_US 12h shape on 204)
    # or coincide (C locale) -- a timestamp-diff parser dropped the column
    # header in one and kept it in the other. Walk blocks from the end:
    # skip trailing blanks, skip ONE Average block, print that block.
    awk '
        { L[++n] = $0 }
        END {
            i = n
            while (i >= 1 && L[i] == "") i--
            if (i < 1) exit 1
            e = i
            while (i >= 1 && L[i] != "") i--
            s = i + 1
            if (L[s] ~ /^Average:/) {
                while (i >= 1 && L[i] == "") i--
                if (i < 1) exit 1
                e = i
                while (i >= 1 && L[i] != "") i--
                s = i + 1
            }
            if (e < s) exit 1
            # ★strip the tool timestamp prefix (user 2026-11-14: 不需要显示时间) --
            # the page header already carries the frame clock, per-line sample
            # seconds are noise. Fixed-width prefix removed only; the remaining
            # spaces on each line keep the block column alignment intact (the
            # right-aligned CPU/IFACE ids stay under their headers). Meridiem
            # optional (en_US prints AM/PM, C locale does not).
            for (j = s; j <= e; j++) {
                line = L[j]
                sub(/^[0-9][0-9]:[0-9][0-9]:[0-9][0-9]( +(AM|PM))?/, "", line)
                print line
            }
        }
    '
}

_vtop_screen_cpu() { # mpstat -P ALL: per-core split the main screen lacks
    _vtop_pg cpu
    _vtop_sec "mpstat -P ALL"   # banner = boxify trigger: page content gets the frame
    if ! command -v mpstat >/dev/null 2>&1; then
        printf '%s  !! mpstat not found (sysstat)%s\n' "${c_red:-}" "${c_off:-}"
        return 0
    fi
    # ★row order & line budget (user 2026-11-18: "按负载倒序 高的排前面 都是100%
    # 取cpu号小的；列top 30"): rows are ALWAYS busiest-first (busy = 100 - %idle,
    # %idle is the last column in every mpstat version), tie -> smaller CPU id
    # first; cap at the Top 30 busiest cores whatever the core count (300-core
    # boxes exist) with the trailing omission note the stack page uses. Selection
    # sort (30 passes over n rows) keeps it plain awk -- no asort/gawk dependency.
    # ★单拍即真 1s 窗 (用户令 2026-11-16: "为什么要2 执行一次不就好了"): 204 实测
    #   mpstat -P ALL 1 1 单拍值≠开机均值(2.05/93.85 vs 7.79/88.56), 无 iostat 式
    #   首拍 since-boot 毛病, 2 拍白等 1s; vmstat 页例外(首行真是开机均值, 保留 2)。
    LC_ALL=C timeout 8 mpstat -P ALL 1 1 2>/dev/null | _vtop_sar_lastblock | awk '
        NR == 1 { hdr = $0; next }
        NR == 2 { allr = $0; next }
        { rows[++n] = $0; busy[n] = 100 - $NF; cpu[n] = $1 + 0 }
        END {
            if (hdr == "") exit 1
            print hdr
            if (allr != "") print allr
            m = (n < 30) ? n : 30
            for (k = 1; k <= m; k++) {
                best = 0
                for (i = 1; i <= n; i++) {
                    if (used[i]) continue
                    if (best == 0 || busy[i] > busy[best] || \
                       (busy[i] == busy[best] && cpu[i] < cpu[best])) best = i
                }
                used[best] = 1; print rows[best]
            }
            if (n > 30) printf "(omitted %d cores; full: mpstat -P ALL)\n", n - 30
            # ★busy distribution (user 2026-11-14: 万一都忙怎么办; buckets are
            # 10-point bins 0-10 .. 90-100 per user call). Printed after the
            # rows for EVERY core count (user 2026-11-15: tied to the cut-only
            # branch it was invisible on small boxes, so the feature could not
            # be eyeballed at all); the omitted line above stays cut-only.
            # Fixed enum, zeros included (always-write rule). busy = 100 -
            # %idle clamped to [0,100]; bin = int(busy/10), busy 100 lands in
            # the 90-100 bin.
            for (i = 1; i <= n; i++) {
                b = busy[i]; if (b > 100) b = 100; if (b < 0) b = 0
                k = int(b / 10); if (k > 9) k = 9
                cnt[k]++
            }
            line = "(busy: "
            for (k = 0; k < 10; k++)
                line = line sprintf("%s%d-%d %d", (k ? " | " : ""), k * 10, (k == 9 ? 100 : (k + 1) * 10), cnt[k] + 0)
            printf "%s)\n", line
        }' \
        || printf '%s  !! mpstat produced no rows%s\n' "${c_red:-}" "${c_off:-}"
    printf '\n'
}

_vtop_screen_vmstat() { # vmstat: mem/swap/paging + cpu overview, procps (no sysstat needed)
    _vtop_pg vmstat
    _vtop_sec "vmstat"   # banner = boxify trigger: page content gets the frame
    if ! command -v vmstat >/dev/null 2>&1; then
        printf '%s  !! vmstat not found (procps)%s\n' "${c_red:-}" "${c_off:-}"
        return 0
    fi
    LC_ALL=C timeout 8 vmstat 1 2 2>/dev/null \
        | awk 'NR <= 2 { print; next } { l = $0 } END { if (l != "") print l; else exit 1 }' \
        || printf '%s  !! vmstat produced no rows%s\n' "${c_red:-}" "${c_off:-}"
    printf '\n'
}

# ★nstat top deltas (user 2026-11-15: net 子屏要补充 nstat 的变更最大的指标,
# 除了流量和包) -- the nstat METRIC SET is the kernel extended counters in
# /proc/net/netstat + /proc/net/snmp (TcpExt/IpExt/Tcp/Ip/Icmp/Udp, shown by
# the nstat binary as TcpExtSyncookiesSent etc). The BINARY is deliberately
# not used: it diffs against a persistent per-user history file, so two vtop
# users (or cron) would corrupt each other's windows -- /proc is read twice
# 1s apart instead, the same window semantics as the other OS pages. Pure
# volume counters are EXCLUDED by name (bytes / segments / forwarded /
# delivered / broadcast / multicast / icmp message totals -- the throughput
# family would otherwise always top the ranking and drown the interesting
# retransmit / timeout / drop / connection-churn counters). Zero deltas are
# not rows: nothing changed -> one explicit note (empty is not zero).
_vtop_nstat_snap() { # -> "GroupKey value" lines from the nstat counter set
    timeout 3 cat /proc/net/netstat /proc/net/snmp 2>/dev/null | timeout 3 awk '
        $1 !~ /:$/ { next }
        {
            g = substr($1, 1, length($1) - 1)
            if (!(g in hdr)) {
                hdr[g] = 1
                for (i = 2; i <= NF; i++) K[g, i - 1] = $i
                next
            }
            for (i = 2; i <= NF; i++)
                if (K[g, i - 1] != "") printf "%s%s %s\n", g, K[g, i - 1], $i
        }'
}

_vtop_nstat() { # -> ranked "name delta rate/s" rows (two per line), or a no-change note
    local a b t0 t1
    t0=$(date +%s%3N)
    a=$(_vtop_nstat_snap)
    sleep 1
    b=$(_vtop_nstat_snap)
    t1=$(date +%s%3N)
    [ -n "$a" ] && [ -n "$b" ] || return 1
    [ "$t1" -gt "$t0" ] 2>/dev/null || t1=$((t0 + 1000))
    # ★the BLANK line between the two snapshots is load-bearing: it is how the
    # diff pass knows where a ends and b starts ($a has no trailing newline).
    # rate/s uses the MEASURED window ms (snapshot reads take time on top of
    # the sleep) so delta and rate are two genuinely different numbers
    printf '%s\n\n%s\n' "$a" "$b" | awk -v top=20 -v ms=$((t1 - t0)) '
        BEGIN { ex = "Octets$|InSegs$|OutSegs$|InReceives$|OutRequests$|InDelivers$|OutTransmits$|McastPkts$|BcastPkts$|InMsgs$|OutMsgs$|Datagrams$|InNoECTPkts$|TCPOrigDataSent$|TCPDelivered$|TCPPureAcks$|TCPRcvCoalesce$|TCPAutoCorking$|TCPHPHits$|TCPHPAcks$" }
        NF == 0 { second = 1; next }
        {
            split($0, p, " ")
            if (!second) A[p[1]] = p[2] + 0
            else         B[p[1]] = p[2] + 0
        }
        END {
            s_ = ms / 1000; if (s_ <= 0) s_ = 1
            n = 0
            for (k in B) {
                if (!(k in A)) continue
                d = B[k] - A[k]
                if (d > 0 && k !~ ex) { nm[++n] = k; dv[n] = d }
            }
            if (n == 0) { print "(no counter changes in window)"; exit }
            # ★rank then lay out TWO METRICS PER LINE (user 2026-11-15: 一行放
            # 两个指标, 能排多少取多少) -- cell = name(26, truncated) + delta +
            # rate/s; two cells fit the 148-col frame with room to spare; cap =
            # 30 metrics = 15 rows
            m = (n < top ? n : top)
            for (s = 1; s <= m; s++) {
                best = 0
                for (i = 1; i <= n; i++)
                    if (!used[i] && (best == 0 || dv[i] > dv[best])) best = i
                used[best] = 1; rn[s] = nm[best]; rv[s] = dv[best]
            }
            # ★faint divider ┆ between the two cells (user 2026-11-15: 暗线隔开;
            # same 3 cols as the old blank gap so frame width does not move)
            printf "%-26.26s %6s %7s ┆ %-26.26s %6s %7s\n", "metric", "delta", "rate/s", "metric", "delta", "rate/s"
            for (s = 1; s <= m; s += 2) {
                if (s + 1 <= m)
                    printf "%-26.26s %6d %7.1f ┆ %-26.26s %6d %7.1f\n", rn[s], rv[s], rv[s] / s_, rn[s+1], rv[s+1], rv[s+1] / s_
                else
                    printf "%-26.26s %6d %7.1f\n", rn[s], rv[s], rv[s] / s_
            }
            if (n > m) printf "(and %d more changed counters)\n", n - m
        }'
}

_vtop_screen_net() { # sar -n DEV: per-interface rates (main NET row sums physical only)
    _vtop_pg net
    _vtop_sec "sar -n DEV"   # banner = boxify trigger: page content gets the frame
    if ! command -v sar >/dev/null 2>&1; then
        printf '%s  !! sar not found (sysstat)%s\n' "${c_red:-}" "${c_off:-}"
        return 0
    fi
    # ★单拍即真 1s 窗 (同 cpu 页 2026-11-16 实测, 2 拍白等 1s)
    LC_ALL=C timeout 8 sar -n DEV 1 1 2>/dev/null | _vtop_sar_lastblock \
        || printf '%s  !! sar produced no rows%s\n' "${c_red:-}" "${c_off:-}"
    _vtop_sec "nstat top deltas"
    _vtop_nstat || printf '%s  !! /proc/net/netstat or /proc/net/snmp unreadable%s\n' "${c_red:-}" "${c_off:-}"
    printf '\n'
}

