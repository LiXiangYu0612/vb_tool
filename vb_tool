# Helper function to parse date strings
def parse_datetime(date_str):
    formats = [
        '%Y-%m-%d %H:%M:%S.%f', 
        '%Y-%m-%d %H:%M:%S', 
        '%Y-%m-%d %H:%M', 
        '%Y-%m-%d %H',
