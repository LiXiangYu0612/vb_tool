        command -v netdiag; return 0
    elif [ -n "${VB_TOOL_NETDIAG_BIN:-}" ] && [ -x "$VB_TOOL_NETDIAG_BIN" ]; then
        echo "$VB_TOOL_NETDIAG_BIN"; return 0
    elif [ -n "$arch" ] && [ -x "/root/netdiag_$arch" ]; then
        echo "/root/netdiag_$arch"; return 0
    elif [ -n "$arch" ] && [ -x "$HOME/netdiag_$arch" ]; then
        echo "$HOME/netdiag_$arch"; return 0
    elif [ -n "$arch" ] && [ -x "/opt/netdiag_$arch" ]; then
        echo "/opt/netdiag_$arch"; return 0
    fi
    echo "Error: netdiag binary not found" >&2
    echo "  searched: PATH, \$VB_TOOL_NETDIAG_BIN, /root/netdiag_$arch, \$HOME/netdiag_$arch, /opt/netdiag_$arch" >&2
