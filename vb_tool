        #   宽窄变化都不会留残影。
        if [ "$interactive" = "1" ] && [ -t 1 ]; then
            local _ws _wn
            exec 9>&1
            _ws=$(stty size 2>/dev/null <&9)
            exec 9>&-
            [ -n "$_ws" ] || _ws=$(stty size 2>/dev/null)
            _wn=${_ws##* }
