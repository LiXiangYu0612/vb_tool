                function toggleLockDetail(btn) {{
                    const summaryRow = btn.closest('.lock-summary-row');
                    if (!summaryRow) return;
                    const cardRow = summaryRow.nextElementSibling;
                    if (!cardRow || !cardRow.classList.contains('lock-detail-card-row')) return;
                    
                    if (cardRow.style.display === 'none') {{
                        cardRow.style.display = 'table-row';
                        btn.textContent = '收起';
                        summaryRow.classList.add('lock-row-expanded');
                        summaryRow.classList.add('deadlock-row-expanded');
                        cardRow.classList.add('lock-row-expanded');
                        cardRow.classList.add('deadlock-row-expanded');
                        // 滚动到卡片区域
                        setTimeout(() => {{
                            const rect = cardRow.getBoundingClientRect();
                            const headerHeight = document.querySelector('.deadlock-table thead, .lock-event-table thead')?.offsetHeight || 0;
                            const viewportHeight = window.innerHeight;
                            const currentScroll = window.scrollY || window.pageYOffset;
                            const targetScrollTop = rect.top + currentScroll - (viewportHeight / 2) + (rect.height / 2) - headerHeight;
                            window.scrollTo({{
                                top: Math.max(0, targetScrollTop),
                                behavior: 'smooth'
                            }});
                        }}, 50);
                    }} else {{
                        cardRow.style.display = 'none';
                        btn.textContent = '详情';
                        summaryRow.classList.remove('lock-row-expanded');
                        summaryRow.classList.remove('deadlock-row-expanded');
                        cardRow.classList.remove('lock-row-expanded');
                        cardRow.classList.remove('deadlock-row-expanded');
                    }}
                }}

                // ============================================================
                // 锁事件跳转：从慢SQL 详情中的"锁等待详情"跳转到 Top10 锁事件栏目的对应行
                // 跳转流程：阻止默认行为 -> 查找目标元素 -> 自动展开详情卡片 ->
                //          移除旧高亮 -> 添加新高亮 -> 更新 URL hash -> 平滑滚动居中
                // 失败排查：浏览器 F12 控制台查看 [jumpToLockDetail] 开头的日志
                // ============================================================
                function jumpToLockDetail(anchorId, event) {{
                    console.log('%c[jumpToLockDetail] === 跳转开始 ===', 'color:#0066cc;font-weight:bold;', 'anchorId=', anchorId, 'event=', event);
                    if (event) {{
                        try {{
                            event.preventDefault();
                            event.stopPropagation();
                            console.log('[jumpToLockDetail] 已阻止默认行为和事件冒泡');
                        }} catch (e) {{
                            console.error('[jumpToLockDetail] 阻止默认行为失败:', e);
                        }}
                    }} else {{
                        console.warn('[jumpToLockDetail] 未传入 event 对象,无法阻止默认行为');
                    }}

                    console.log('[jumpToLockDetail] 查找目标元素: #' + anchorId);
                    const targetElement = document.getElementById(anchorId);
                    if (!targetElement) {{
                        console.error('[jumpToLockDetail] ✗ 未找到锚点元素: #' + anchorId);
                        console.warn('[jumpToLockDetail] 可能原因:')
                        console.warn('[jumpToLockDetail]   1) Top10 锁事件栏目未渲染该事件(可能被 Top50 限制截断)');
                        console.warn('[jumpToLockDetail]   2) 锚点 id 不匹配(慢SQL 详情与 Top10 表生成的 id 不一致)');
                        console.warn('[jumpToLockDetail]   3) 锁事件栏目在隐藏的 tab/折叠面板中');
                        // 输出现有所有 lock-anchor 元素列表,便于诊断
                        const allLockAnchors = document.querySelectorAll('[id^="lock-anchor-"]');
                        console.log('[jumpToLockDetail] 当前页面共找到 ' + allLockAnchors.length + ' 个 lock-anchor 元素:');
                        allLockAnchors.forEach((el, i) => {{
                            console.log('[jumpToLockDetail]   [' + i + '] id=' + el.id + ' tagName=' + el.tagName + ' class=' + el.className);
                        }});
                        alert('未找到锁详情锚点: ' + anchorId + '\\n请查看浏览器控制台(F12)获取详细诊断信息');
                        return;
                    }}
                    console.log('[jumpToLockDetail] ✓ 找到目标元素: tagName=' + targetElement.tagName + ' id=' + targetElement.id + ' class=' + targetElement.className);

                    // 检查目标元素是否在隐藏的容器中(如被 tab 隐藏、display:none 等)
                    let hiddenAncestor = null;
                    let parent = targetElement.parentElement;
                    while (parent && parent !== document.body) {{
                        const cs = window.getComputedStyle(parent);
                        if (cs.display === 'none' || cs.visibility === 'hidden' || cs.height === '0px') {{
                            hiddenAncestor = parent;
                            console.warn('[jumpToLockDetail] ⚠ 发现隐藏的祖先元素: tagName=' + parent.tagName + ' class=' + parent.className + ' display=' + cs.display + ' visibility=' + cs.visibility);
                            break;
                        }}
                        parent = parent.parentElement;
                    }}
                    if (!hiddenAncestor) {{
                        console.log('[jumpToLockDetail] ✓ 目标元素所有祖先均可见');
                    }}

                    // 如果目标行处于折叠状态,自动展开详情卡片(便于查看上下文)
                    if (targetElement.classList.contains('lock-summary-row')) {{
                        const detailBtn = targetElement.querySelector('.lock-detail-btn');
                        if (detailBtn) {{
                            console.log('[jumpToLockDetail] 详情按钮当前文本: "' + detailBtn.textContent.trim() + '"');
                            if (detailBtn.textContent.trim() === '详情') {{
                                console.log('[jumpToLockDetail] 目标行处于折叠状态,自动展开...');
                                try {{
                                    toggleLockDetail(detailBtn);
                                    console.log('[jumpToLockDetail] ✓ 已调用 toggleLockDetail 展开详情');
                                }} catch (e) {{
                                    console.error('[jumpToLockDetail] 调用 toggleLockDetail 失败:', e);
                                }}
                            }} else {{
                                console.log('[jumpToLockDetail] 目标行已展开,无需展开操作');
                            }}
                        }} else {{
                            console.warn('[jumpToLockDetail] 目标行内未找到 .lock-detail-btn 按钮');
                        }}
                    }} else {{
                        console.log('[jumpToLockDetail] 目标元素不是 .lock-summary-row,跳过展开逻辑(class=' + targetElement.className + ')');
                    }}

                    // 移除所有现有的高亮(避免残留)
                    const oldHighlights = document.querySelectorAll('.lock-highlight-flash');
                    console.log('[jumpToLockDetail] 清理旧高亮: 共 ' + oldHighlights.length + ' 个元素');
                    oldHighlights.forEach((el, i) => {{
                        console.log('[jumpToLockDetail]   移除高亮 [' + i + ']: id=' + el.id + ' class=' + el.className);
                        el.classList.remove('lock-highlight-flash');
                    }});

                    // 添加新高亮类
                    targetElement.classList.add('lock-highlight-flash');
                    console.log('[jumpToLockDetail] ✓ 已添加高亮类 lock-highlight-flash');

                    // 更新 URL hash(便于刷新后重试或分享链接)
                    try {{
                        history.pushState(null, '', '#' + anchorId);
                        console.log('[jumpToLockDetail] ✓ 已更新 URL hash: #' + anchorId);
                    }} catch (e) {{
                        console.warn('[jumpToLockDetail] 更新 URL hash 失败(不影响跳转):', e);
                    }}

                    // 平滑滚动到目标行(居中显示,留出表头空间)
                    setTimeout(() => {{
                        try {{
                            const headerHeight = document.querySelector('.deadlock-table thead, .lock-event-table thead')?.offsetHeight || 0;
                            const viewportHeight = window.innerHeight;
                            const rowHeight = targetElement.offsetHeight || 100;
                            const rect = targetElement.getBoundingClientRect();
                            const currentScroll = window.scrollY || window.pageYOffset;
                            const rowTopAbsolute = rect.top + currentScroll;
                            const targetScrollTop = rowTopAbsolute - (viewportHeight / 2) + (rowHeight / 2) - headerHeight;
                            console.log('[jumpToLockDetail] 滚动参数: rowTopAbsolute=' + rowTopAbsolute + ' viewportHeight=' + viewportHeight + ' rowHeight=' + rowHeight + ' headerHeight=' + headerHeight + ' targetScrollTop=' + targetScrollTop);
                            window.scrollTo({{
                                top: Math.max(0, targetScrollTop),
                                behavior: 'smooth'
                            }});
                            console.log('%c[jumpToLockDetail] === 跳转完成 ===', 'color:#0066cc;font-weight:bold;');
                        }} catch (e) {{
                            console.error('[jumpToLockDetail] 滚动失败:', e);
                        }}
                    }}, 150);
                }}

