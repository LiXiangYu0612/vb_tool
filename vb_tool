        # judge by the DIRECTORY mtime so orphans cannot accumulate forever
        # (a live in-flight create's dir is minutes old, never past until_ep)
        try:
            m_ep = int(os.path.getmtime(d))
        except OSError:
            m_ep = None
        if m_ep is not None and m_ep < until_ep:
            print("WARN orphan snap %s (no parseable meta) deleted by dir mtime" % os.path.basename(d), file=sys.stderr)
            print(d)
        else:
