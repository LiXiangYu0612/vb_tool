run_sp() {
    local param="$1"
    if [ -z "$param" ]; then
        echo "Error: sp param" >&2
        sp_help
        exit 1
    fi
    
    psql -d postgres -P footer=off <<EOF
\set name '$param'
\echo '=========================='
\echo 'show parameter from sp'
\echo '=========================='
SELECT name,decode(unit,'8kB',concat(setting*8,'kB'),concat(setting,COALESCE(unit,' '))) setting,context,short_desc FROM pg_settings WHERE name LIKE concat('%', :'name', '%');
