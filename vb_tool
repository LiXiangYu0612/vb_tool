                        printf "${c_lbl}port${c_off} ${c_grn}%s${c_off}   ${c_lbl}up${c_off} %s   %s\n" \
                            "${PGPORT:-5432}" \
                            "$(awk -v s="$h_up" 'BEGIN{printf "%dd%02dh%02dm", int(s/86400), int(s%86400/3600), int(s%3600/60)}')" \
                            "$cores"
                        _vtop_print_os
                        _vtop_sec "VASTBASE Statistics ($(date '+%T'))"
                        if [ -n "$s_tot" ]; then
                            # Two layers (labels above values) like the OS block, and
                            # FULL names instead of tot/act/idl/idtx/ltx60 (user's
                            # call 2026-09-26: "SESS 后面的指标弄全称 也是分两行吧
                            # total_sess active_sess 这样 LTX60 写 longtx_60s").
                            # The "^" marker keeps the old "long transaction present"
                            # alarm on the VALUE only. _vtop_lv owns the colour so the
