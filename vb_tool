                               ("avg size", _bs[2], _es[2], fmt_bytes),
                               ("max size", _bs[3], _es[3], fmt_bytes)):
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td></tr>'
                     % (esc(_lbl), _fmt(_b), _fmt(_e), _fmt(_e - _b)))
    parts.append('</table>')

    # ================= Replication (awrrpt: per-minute sampler logs) =================
    if repl_dir is not None:
        sec("Replication")
        sub("Replication Stat")
        parts.append(replication_section_html(
