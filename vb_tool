        _bio, _eio = _iomap(_cgb2), _iomap(_cge2)
        for _dk in sorted(set(_bio) | set(_eio)):
            _fb = fmt_int(_bio[_dk]) if _dk in _bio else "-"
            _fe = fmt_int(_eio[_dk]) if _dk in _eio else "-"
            if _dk in _bio and _dk in _eio:
                # blkio service bytes are monotonic -- backwards = cgroup
                # recreated (same rule as cpuacct.usage, 2026-11-01)
                if _eio[_dk] < _bio[_dk]:
