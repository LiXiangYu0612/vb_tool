    # ================= Memory Fragmentation (buddyinfo) =================
    # /proc/buddyinfo lists, PER ZONE, how many free blocks exist at each buddy
    # order; a block of order n is 2^n contiguous pages. Fragmentation is a
    # per-zone property (a block can never span zones), so nothing here is
    # summed across zones. Begin/End come from the snapshots.
    #   frag% = 1 - (free pages usable as 2MB blocks) / (free pages of the zone)
    # usable = sum over order >= 9 of blocks_o * 2^o (bigger blocks split down)
    def _bud_zones(phase):
        _z = {}
        for _ln in (win["os"].get((phase, "buddyinfo"), "") or "").splitlines():
            _f = _ln.split()
            if len(_f) < 5 or _f[0] != "Node":
                continue
            _key = "node %s zone %s" % (_f[1].rstrip(","),
                                        _f[3] if _f[2] == "zone" else "?")
            _d = _z.setdefault(_key, {})
            for _i, _v in enumerate(_f[4:]):
                if _v.isdigit():
                    _d[_i] = _d.get(_i, 0) + int(_v)
        return _z
    _bz, _ez = _bud_zones("begin"), _bud_zones("end")
    sub("Memory Fragmentation")
    if _bz or _ez:
        _zones = sorted(set(_bz) | set(_ez))
        _ords = sorted({o for d in list(_bz.values()) + list(_ez.values()) for o in d})
        # buddyinfo counts BLOCKS; every number below is converted to PAGES
        # (blocks * 2^order) so columns and totals are the same unit
        def _pg(d, o):
            return d.get(o, 0) * (1 << o)
        _bh = ['<table class="t"><tr><th>Zone</th><th>Phase</th>']
        _bh += ['<th class="n">%d</th>' % _o for _o in _ords]
        _bh.append('<th class="n">Total</th></tr>')
        for _z in _zones:
            _b, _e = _bz.get(_z, {}), _ez.get(_z, {})
            for _ph in ("Begin", "End", "Delta"):
                _bh.append('<tr><td>%s</td><td>%s</td>' % (esc(_z), _ph))
                for _o in _ords:
                    if _ph == "Delta":
                        _bh.append('<td class="n">%+d</td>' % (_pg(_e, _o) - _pg(_b, _o)))
                    else:
                        _bh.append('<td class="n">%s</td>'
                                   % fmt_int(_pg(_b if _ph == "Begin" else _e, _o)))
                if _ph == "Delta":
                    _bh.append('<td class="n">%+d</td></tr>'
                               % (sum(_pg(_e, o) for o in _ords)
                                  - sum(_pg(_b, o) for o in _ords)))
                else:
