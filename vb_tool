## @function 解析日志行前缀格式
## @description 根据日志前缀格式创建解析函数
## @param {string} log_prefix 日志行前缀格式
## @return {dict} 包含解析函数和字段顺序的字典
def parse_log_prefix_format(log_prefix):
    """
    解析日志行前缀格式，返回相应的解析函数和字段顺序
    
    日志格式映射:
    - %m: 时间戳 (timestamp)
    - %u: 用户名 (user)
    - %d: 数据库名 (database)
    - %r: 远端主机名或IP地址 (remote_host)
    - %p: 线程ID (thread_id)
    - %S: 会话ID (session_id)
    - %x: 事务ID (transaction_id)
    """
    if not log_prefix:
        # 默认格式: '%m %u %d %r %p %S [%x]'
        log_prefix = '%m %u %d %r %p %S [%x]'

    # 日志格式映射表
    format_mapping = {
        '%m': 'timestamp',
        '%u': 'user',
        '%d': 'database',
        '%r': 'remote_host',
        '%p': 'thread_id',
        '%S': 'session_id',
        '%x': 'transaction_id',
        '%t': 'timestamp',  # 时间戳的另一种格式
        '%i': 'application_name',  # 应用程序名
        '%l': 'log_line_number',  # 日志行号
        '%v': 'virtual_transaction_id',  # 虚拟事务ID
        '%q': 'backend_type',  # 后端类型
        '%s': 'timestamp',  # 时间戳的另一种格式
        '%n': 'timestamp',  # 时间戳的另一种格式
        '%c': 'session_id',  # 会话ID的另一种格式
        '%%': 'literal_percent'  # 转义的百分号
    }
    
    # 从日志前缀中提取字段顺序
    extracted_fields = []
    i = 0
    while i < len(log_prefix):
        if log_prefix[i:i+2] in format_mapping:
            field_code = log_prefix[i:i+2]
            field_name = format_mapping[field_code]
            if field_name not in ['literal_percent']:  # 排除不需要的字段
                extracted_fields.append(field_name)
            i += 2
        else:
            i += 1
    
    # 去重但保持顺序
    unique_fields = []
    seen = set()
    for field in extracted_fields:
        if field not in seen:
            unique_fields.append(field)
            seen.add(field)
    
    # 在解析时，由于时间戳已经作为块分割符被单独提取，所以应该跳过第一个字段（如果它是timestamp）
    # 这是因为在主解析循环中，blocks数组包含的是时间戳之后的内容
    if unique_fields and unique_fields[0] == 'timestamp':
        unique_fields = unique_fields[1:]
    
    print(f"解析日志前缀 '{log_prefix}'....")
    
    return {
        'parse_func': lambda log_line: _parse_log_line_by_format(log_line, unique_fields),
        'fields': unique_fields,
        'format_name': 'dynamic',
        'format_template': log_prefix
    }

## @function 根据格式模板解析日志行
## @description 根据日志格式模板动态解析日志行
def _parse_log_line_by_format(log_line, unique_fields):
    """
    根据日志格式模板动态解析日志行
    
    Args:
        log_line (str): 要解析的日志行
        unique_fields (list): 实际需要解析的字段列表（已排除timestamp）
    
    Returns:
        dict: 解析结果字典
    """
    # 注意：log_prefix 和 format_mapping 参数由外部传入，但在此函数中未直接使用，
    # 因为 unique_fields 已经是经过处理的字段列表
    # 解析日志行
    tokens = log_line.strip().split()
    
    # 创建结果字典
    result = {}
    
    # 按字段顺序逐个匹配
    token_idx = 0
    for field_name in unique_fields:
        if token_idx >= len(tokens):
            break
            
        current_token = tokens[token_idx]
        
        # 特殊处理某些字段
        if field_name == 'remote_host':
            # 检查是否是IP地址格式
            if IP_PATTERN.match(current_token):
                result[field_name] = current_token
                token_idx += 1
            else:
                # 尝试从后续部分找到IP地址
                found_ip = False
                search_start = token_idx
                for j in range(search_start, len(tokens)):
                    if IP_PATTERN.match(tokens[j]):
                        result[field_name] = tokens[j]
                        # 移动token_idx past this found IP
                        if j == token_idx:
                            token_idx += 1
                        else:
                            # If we found IP further ahead, advance to it
                            token_idx = j + 1
                        found_ip = True
                        break
                if not found_ip:
                    # 如果没找到IP，使用当前token
                    result[field_name] = current_token
                    token_idx += 1
        elif field_name in ['transaction_id', 'thread_id']:
            # 处理带方括号的值 - 严格按顺序处理
            if current_token.startswith('[') and current_token.endswith(']'):
                # 当前token是方括号格式，直接提取值
                value = current_token[1:-1]  # 去掉方括号
                result[field_name] = value
                token_idx += 1
            else:
                # 当前token不是方括号格式，使用当前token（虽然不符合预期）
                # 不要跳过token去寻找方括号值，保持严格的顺序
                result[field_name] = current_token
                token_idx += 1
        else:
            # 一般字段处理
            result[field_name] = current_token
            token_idx += 1
    
    # 如果没有解析到任何有效字段，返回None
    if not result:
        return None
    
    return result


## @function 通用日志解析回退函数
## @description 当格式化解析失败时，使用通用方法解析IP、数据库和用户信息
def _parse_log_fallback(content0, log_format_info):
    """
    通用日志解析回退函数，当格式化解析失败时使用
    
    Args:
        content0 (list): 分割后的日志内容列表
        log_format_info (dict): 日志格式信息
    
    Returns:
        tuple: (IP, database, user) 解析出的三个字段值
    """
    if len(content0) < 3:
        return '', '', ''  # 跳过格式不正确的日志条目

    # 根据日志格式信息确定字段顺序
    fields_order = log_format_info.get('fields', ['user', 'database', 'remote_host', 'thread_id', 'session_id'])

    # 初始化字段值
    IP = database = user = ''

    # 按照日志格式定义的字段顺序找到对应的实际token索引
    remote_host_idx = database_idx = user_idx = -1

    for i, field_name in enumerate(fields_order):
        if i < len(content0):  # 确保不越界
            if field_name == 'remote_host':
                remote_host_idx = i
            elif field_name == 'database':
                database_idx = i
            elif field_name == 'user':
                user_idx = i

    # 根据找到的索引提取值
    if remote_host_idx >= 0 and remote_host_idx < len(content0):
        IP = content0[remote_host_idx]
    if database_idx >= 0 and database_idx < len(content0):
        database = content0[database_idx]
    if user_idx >= 0 and user_idx < len(content0):
        user = content0[user_idx]

    # 如果上面的索引方法失败，使用IP模式匹配作为备选方案
    if not IP:  # 如果没有找到IP，则尝试用模式匹配
        for j, part in enumerate(content0):
            if IP_PATTERN.search(part):
                IP = part
                # IP后面跟着数据库和用户 (假设顺序)
                if j + 1 < len(content0):
                    database = content0[j + 1]
                if j + 2 < len(content0):
                    user = content0[j + 2]
                break
        else:
            # 如果没找到IP，按顺序分配
            if len(content0) >= 3:
                # 尝试找出哪个是IP
                found_ip_idx = -1
                for j, part in enumerate(content0):
                    if IP_PATTERN.search(part):
                        found_ip_idx = j
                        break

                if found_ip_idx != -1:
                    IP = content0[found_ip_idx]
                    # 在IP之前或之后找数据库和用户
                    remaining_parts = [part for idx, part in enumerate(content0) if idx != found_ip_idx]
                    if len(remaining_parts) >= 2:
                        database = remaining_parts[0]
                        user = remaining_parts[1]
                else:
                    # 没找到IP，按默认顺序分配
                    IP = content0[0]
                    database = content0[1]
                    user = content0[2]

    return IP, database, user

