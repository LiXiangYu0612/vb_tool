            new += 1
    data = buf.getvalue().encode()
    if data:
        with open(store_gz, "ab") as out:
            out.write(gzip.compress(data, 6))    # one new gzip member, append-only
    print("  [awr] sql_text store: appended %d, now %d keys" % (new, stored + new))
except Exception as e:
    print("  [WARN] sql_text merge failed: %s" % e)
finally:
    if os.path.isfile(tmp_new):
        os.remove(tmp_new)
PYTEXT
    fi
    # ---- replication single-point: normalize empty states ----
    # \copy ok + 0 rows      -> header-only csv  -> append literal "null" row (no standby)
    # view missing/DB error  -> no csv at all    -> write header + "error" row + WARN
    if [ ! -f "$dbd/replication.csv" ]; then
        echo "  [WARN] db/replication.csv not created (view unavailable or DB error)" >&2
        echo "application_name,client_addr,state,sync_state,sender_sent_location,receiver_write_location,receiver_flush_location,receiver_replay_location" > "$dbd/replication.csv"
        echo "error" >> "$dbd/replication.csv"
    elif [ "$(wc -l < "$dbd/replication.csv")" -le 1 ]; then
        echo "null" >> "$dbd/replication.csv"
    fi
    # ---- replication slots single-point: same normalization, its own file ----
    if [ ! -f "$dbd/replication_slots.csv" ]; then
        echo "  [WARN] db/replication_slots.csv not created (view unavailable or DB error)" >&2
        echo "slot_name,plugin,slot_type,database,active,xmin,catalog_xmin,restart_lsn,dummy_standby,confirmed_flush" > "$dbd/replication_slots.csv"
        echo "error" >> "$dbd/replication_slots.csv"
    elif [ "$(wc -l < "$dbd/replication_slots.csv")" -le 1 ]; then
        echo "null" >> "$dbd/replication_slots.csv"
    fi
    # ---- walreceiver single-point (standby only): pg_stat_get_wal_receiver()
    # is the standby-side counterpart of pg_stat_replication (openGauss has no
    # pg_stat_wal_receiver view; this is the underlying C function, 15 cols).
    # Normalized the same way as replication.csv (0 rows -> null, error -> error).
    if [ "$is_standby" = "1" ]; then
        PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres 2>&1 <<PSQL4 | grep -v '^$' >&2 || true
\copy (SELECT * FROM pg_stat_get_wal_receiver()) TO '$dbd/walreceiver.csv' WITH CSV HEADER
PSQL4
        if [ ! -s "$dbd/walreceiver.csv" ]; then
            echo "  [WARN] db/walreceiver.csv missing/empty (function unavailable or DB error)" >&2
            echo "receiver_pid,local_role,peer_role,peer_state,state,sender_sent_location,sender_write_location,sender_flush_location,sender_replay_location,receiver_received_location,receiver_write_location,receiver_flush_location,receiver_replay_location,sync_percent,channel" > "$dbd/walreceiver.csv"
            echo "error" >> "$dbd/walreceiver.csv"
        elif [ "$(wc -l < "$dbd/walreceiver.csv")" -le 1 ]; then
            echo "null" >> "$dbd/walreceiver.csv"
        fi
    fi
    # ---- object stats across all databases (cumulative counters; renderer computes end-begin).
    # Per-db psql carries the SAME connect/statement timeouts as the rest: a hung
    # database or a huge pg_class must not stretch one create into hours. ----
    local _odbs _odb
    _odbs=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAc "select datname from pg_database where datallowconn and not datistemplate order by 1" 2>/dev/null)
    { echo "dbname,schema,object,seq_scan,seq_tup_read,idx_scan,idx_tup_fetch,n_tup_ins,n_tup_upd,n_tup_del,n_tup_hot_upd,n_live_tup,n_dead_tup"
      for _odb in $_odbs; do
          PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d "$_odb" -tAF',' -c "select '$_odb',schemaname,relname,coalesce(seq_scan,0),coalesce(seq_tup_read,0),coalesce(idx_scan,0),coalesce(idx_tup_fetch,0),coalesce(n_tup_ins,0),coalesce(n_tup_upd,0),coalesce(n_tup_del,0),coalesce(n_tup_hot_upd,0),coalesce(n_live_tup,0),coalesce(n_dead_tup,0) from pg_stat_user_tables" 2>/dev/null
      done; } > "$dbd/object_tables.csv"
    { echo "dbname,schema,object,index,idx_scan,idx_tup_read,idx_tup_fetch"
      for _odb in $_odbs; do
          PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d "$_odb" -tAF',' -c "select '$_odb',schemaname,relname,indexrelname,coalesce(idx_scan,0),coalesce(idx_tup_read,0),coalesce(idx_tup_fetch,0) from pg_stat_user_indexes" 2>/dev/null
      done; } > "$dbd/object_indexes.csv"
    { echo "dbname,schema,object,table_age,relpages,reltuples,n_dml_tup,n_live_tup,n_dead_tup"
      for _odb in $_odbs; do
          PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d "$_odb" -tAF',' -c "select '$_odb',n.nspname,c.relname,age(c.relfrozenxid64),c.relpages,c.reltuples,coalesce(pg_stat_get_tuples_changed(c.oid),0),coalesce(pg_stat_get_live_tuples(c.oid),0),coalesce(pg_stat_get_dead_tuples(c.oid),0) from pg_class c left join pg_namespace n on n.oid=c.relnamespace where c.relkind in ('r','t','m')" 2>/dev/null
      done; } > "$dbd/object_dead.csv"
    # compress all db csv in place; renderer reads .csv.gz with plain-text fallback
    gzip -f "$dbd"/*.csv 2>/dev/null
    return 0
}

# _awr_write_meta <dir> <snap_id> <ts> <ts_epoch>
# Single-point meta: no begin/end/duration (those are synthesized at awrrpt time).
_awr_write_meta() {
    local dir="$1" sid="$2" ts="$3" ts_ep="$4"
    local m_host m_dbver m_dbname m_start
    local _ct=15 _st="-c statement_timeout=60000"
    m_host=$(hostname 2>/dev/null | tr -d '"\r\n')
    m_dbver=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAq -c "select vb_version();" 2>/dev/null | head -1 | tr -d '"\r\n')
    [ -z "$m_dbver" ] && m_dbver=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAq -c "select version();" 2>/dev/null | head -1 | tr -d '"\r\n')
    m_dbname=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAq -c "select node_name from pg_node_env limit 1;" 2>/dev/null | head -1 | tr -d '"\r\n')
    [ -z "$m_dbname" ] && m_dbname=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAq -c "show pgxc_node_name;" 2>/dev/null | head -1 | tr -d '"\r\n')
    # postmaster start time: stable per DB uptime, changes on restart. Used by
    # awrrpt to refuse a diff that spans a restart (cumulative counters reset).
    m_start=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAq -c "select pg_postmaster_start_time();" 2>/dev/null | tr -d '"\r\n')
    # db role: the sampler function detects this earlier for its own gating
    # (local vars do not cross the function boundary), so this is a second,
    # equally cheap query -- keeps _awr_write_meta self-contained.
    m_role=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAq -c "select case when pg_is_in_recovery() then 'physical standby' else 'primary' end;" 2>/dev/null | head -1 | tr -d '"\r\n')
    [ -z "$m_host" ]  && m_host="?"
    [ -z "$m_dbver" ] && m_dbver="unavailable"
    [ -z "$m_dbname" ] && m_dbname="?"
    [ -z "$m_role" ]  && m_role="?"
    python3 -c "
import json, sys, os
def _int(v):
    v = str(v).strip()
    return int(v) if v.isdigit() else v
print(json.dumps({
  'snap_id': _int(sys.argv[1]),
  'ts': sys.argv[2],
  'ts_epoch': _int(sys.argv[3]),
  'hostname': sys.argv[4],
  'db_name': sys.argv[5],
  'db_version': sys.argv[6],
  'db_start_time': sys.argv[7],
  'vb_tool_version': sys.argv[8],
  'db_role': sys.argv[9],
  'port': _int(os.environ.get('PGPORT') or 5432),
}, indent=2, ensure_ascii=False))
" "$sid" "$ts" "$ts_ep" "$m_host" "$m_dbname" "$m_dbver" "$m_start" "${VB_TOOL_VERSION:-unknown}" "$m_role" > "$dir/meta.json"
}

# _awr_render <args...> -- write the python renderer to a temp file and run it.
# python body is the verbatim compare_render.py; quoted heredoc => no shell expansion.
_awr_render() {
    umask 077   # reports carry SQL literals: same 0600 rule as the snapshots
    local tmp; tmp=$(mktemp /tmp/vb_tool_awr_render.XXXXXX.py) 2>/dev/null
    if [ -z "$tmp" ]; then echo "  [ERROR] mktemp failed" >&2; return 1; fi
    cat > "$tmp" <<'VB_BL_COMPARE_PY'
#!/usr/bin/env python3
"""awr compare renderer.

Reads two window directories (awr + current), each with the layout:
  <dir>/{meta.json, os/{begin,end}/{stat,net_dev,diskstats,interrupts,softirqs},
                         db/{begin,end}/{statement,wait_events,instance_time,database,pagewriter}.csv}

Cumulative-counter model:
  window_delta(metric) = end_value - begin_value
  diff(metric)         = current_delta - awr_delta

Emits a self-contained HTML report. Standalone here; embedded as a heredoc in
vb_tool_dev (so keep it dependency-free stdlib only, single file, no argv trickery).
"""
import csv, json, os, sys, html, subprocess, glob, re, gzip, time

# version of the vb_tool binary generating this report (exported by the bash
# wrapper, inherited via env); distinct from the per-snap vb_tool_version in
# meta.json, which records the binary that CAPTURED each snapshot
_GEN_VER = os.environ.get("VB_TOOL_VERSION") or "?"

# -----------------------------------------------------------------------------
# number formatting
# -----------------------------------------------------------------------------
def to_num(v):
    if v is None:
        return 0.0
    if isinstance(v, (int, float)):
        return float(v)
    s = str(v).strip()
    if not s:
        return 0.0
    try:
        return float(s)
    except ValueError:
        # hex LSN etc. -> 0 for arithmetic
        return 0.0

def fmt_us(v):
    """microseconds -> human."""
    v = to_num(v)
    a = abs(v)
    sign = "-" if v < 0 else ""
    if a >= 60_000_000:
        return "%s%.2f min" % (sign, a / 60_000_000)
    if a >= 1_000_000:
        return "%s%.2f s" % (sign, a / 1_000_000)
    if a >= 1_000:
        return "%s%.2f ms" % (sign, a / 1_000)
    return "%s%.0f μs" % (sign, a)

def fmt_num(v):
    v = to_num(v)
    if abs(v) >= 1_000_000_000:
        return "%.2fB" % (v / 1_000_000_000)
    if abs(v) >= 1_000_000:
        return "%.2fM" % (v / 1_000_000)
    if abs(v) >= 1_000:
        return "%.2fK" % (v / 1_000)
    return "%.0f" % v

def fmt_int(v):
    return "{:,.0f}".format(to_num(v))

def fmt_pct(v):
    v = to_num(v)
    return "%.2f%%" % v

def fmt_bytes(v):
    v = to_num(v)
    a = abs(v)
    sign = "-" if v < 0 else ""
    if a >= 1024**3:
        return "%s%.2f GB" % (sign, a / 1024**3)
    if a >= 1024**2:
        return "%s%.2f MB" % (sign, a / 1024**2)
    if a >= 1024:
        return "%s%.2f KB" % (sign, a / 1024)
    return "%s%.0f B" % (sign, a)

def fmt_kb(v):
    """kilobytes (sysfs node meminfo unit) -> human MB/GB"""
    return fmt_bytes(to_num(v) * 1024)

def pct_change(base, cur):
    base = to_num(base); cur = to_num(cur)
    if base == 0:
        return None  # caller decides (NEW / ∞)
    return (cur - base) / base * 100.0

def arrow_delta(base, cur):
    """Δ string like '+18.00 s (10.00x)' for display."""
    base = to_num(base); cur = to_num(cur)
    d = cur - base
    parts = []
    parts.append(("%+s" % fmt_us(d)) if abs(d) >= 1000 else "%+.0f μs" % d)
    if base > 0 and cur > 0:
        parts.append("(%.2fx)" % (cur / base))
    elif base == 0 and cur > 0:
        parts.append("(new)")
    elif cur == 0 and base > 0:
        parts.append("(gone)")
    return " ".join(parts)

# -----------------------------------------------------------------------------
# IO helpers
# -----------------------------------------------------------------------------
def read_csv_rows(path):
    gz = path + ".gz"
    try:
        if os.path.isfile(gz):
            with gzip.open(gz, mode="rt", newline="") as f:
                return list(csv.DictReader(f))
        if os.path.isfile(path):
            with open(path, newline="") as f:
                return list(csv.DictReader(f))
    except (csv.Error, UnicodeDecodeError, OSError):
        pass
    return []

def fetch_pg_settings():
    """Live-query pg_settings via psql (point-in-time config; not persisted to disk).
    Returns list of dicts; empty if psql/DB unavailable (offline render)."""
    try:
        out = subprocess.check_output(
            ["psql", "-d", "postgres", "-AtF", "\t", "-c",
             "SELECT name,setting,unit,context,short_desc FROM pg_settings ORDER BY name"],
            stderr=subprocess.DEVNULL, timeout=30).decode("utf-8", "replace")
    except Exception:
        return []
    rows = []
    for line in out.splitlines():
        f = line.split("\t")
        if len(f) >= 5:
            rows.append({"name": f[0], "setting": f[1], "unit": f[2],
                         "context": f[3], "short_desc": "\t".join(f[4:])})
    return rows

def psql_query(sql, dbname="postgres"):
    """Run SQL via psql (unaligned, tab-separated, header kept, footer off).
    Returns list of dict rows; empty on error/offline. dbname selects the database."""
    try:
        out = subprocess.check_output(
            ["psql", "-d", dbname, "-A", "-F", "\t", "-P", "footer=off", "-c", sql],
            stderr=subprocess.DEVNULL, timeout=60).decode("utf-8", "replace")
    except Exception:
        return []
    try:
        return list(csv.DictReader(out.splitlines(), delimiter="\t"))
    except Exception:
        return []

def list_databases():
    """Connectable, non-template user databases."""
    return [r["datname"] for r in psql_query(
        "SELECT datname FROM pg_database WHERE datallowconn AND NOT datistemplate ORDER BY 1")
        if r.get("datname")]

def psql_show(guc):
    """Run `show <guc>` via psql, return trimmed value. Empty on error."""
    try:
        return subprocess.check_output(
            ["psql", "-d", "postgres", "-AtF", "\t", "-c", "show " + guc],
            stderr=subprocess.DEVNULL, timeout=15).decode("utf-8", "replace").strip()
    except Exception:
        return ""

def fetch_meminfo():
    """Parse /proc/meminfo into {field: kB_int}. Empty if unavailable."""
    fields = {}
    try:
        for line in open("/proc/meminfo"):
            if ":" not in line:
                continue
            k, v = line.split(":", 1)
            v = v.strip().split()[0]
            fields[k.strip()] = int(v) if v.isdigit() else 0
    except Exception:
        pass
    return fields

def parse_meminfo(txt):
    """Parse /proc/meminfo text into {field: kB_int}."""
    fields = {}
    for line in (txt or "").splitlines():
        if ":" not in line:
            continue
        k, v = line.split(":", 1)
        v = v.strip().split()[0] if v.strip() else ""
        fields[k.strip()] = int(v) if v.isdigit() else 0
    return fields

def normalize_sql(q):
    """Collapse redundant whitespace for compact display: drop blank lines,
    collapse runs of spaces/tabs to one space, trim each line. Keeps newlines."""
    if not q:
        return q
    out = []
    for line in q.splitlines():
        line = " ".join(line.split())
        if line:
            out.append(line)
    return "\n".join(out)

def load_window(d):
    w = {"meta": {}, "os": {}, "db": {}}
    mp = os.path.join(d, "meta.json")
    if os.path.isfile(mp):
        try:
            w["meta"] = json.load(open(mp))
        except Exception:
            w["meta"] = {}
    for phase in ("begin", "end"):
        for f in ("stat", "net_dev", "net_snmp", "net_netstat", "diskstats", "interrupts", "softirqs", "vmstat", "loadavg", "meminfo", "cpuinfo", "numa", "blockdev_meta", "netdev_meta", "dmi", "softnet_stat", "net_rtt"):
            p = os.path.join(d, "os", phase, f)
            w["os"][(phase, f)] = _read_os_text(p) if os.path.isfile(p) else ""
        for t in ("statement", "wait_events", "instance_time", "database", "pagewriter",
                  "memory_node_detail", "shared_memory", "session_memory", "session_by_sess",
                  "object_tables", "object_indexes", "object_dead"):
            w["db"][(phase, t)] = read_csv_rows(os.path.join(d, "db", phase, t + ".csv"))
    return w

def load_snap(d):
    """Load a single-point snapshot dir (snap_<id>/) -> {meta, os:{file:txt}, db:{table:rows}}.
    Single-phase layout: files live directly under os/ and db/ (no begin/end subdir).
    Tolerant: missing os files -> "", missing db csv -> []."""
    s = {"meta": {}, "os": {}, "db": {}}
    mp = os.path.join(d, "meta.json")
    if os.path.isfile(mp):
        try:
            s["meta"] = json.load(open(mp))
        except Exception:
            s["meta"] = {}
    for f in ("stat", "net_dev", "net_snmp", "net_netstat", "diskstats", "interrupts", "softirqs", "vmstat", "loadavg", "meminfo", "cpuinfo", "numa", "blockdev_meta", "netdev_meta", "dmi", "softnet_stat", "net_rtt"):
        p = os.path.join(d, "os", f)
        s["os"][f] = _read_os_text(p) if os.path.isfile(p) else ""
    for t in ("statement", "wait_events", "instance_time", "database", "pagewriter",
              "memory_node_detail", "shared_memory", "session_memory", "session_by_sess",
              "pg_settings",
              "object_tables", "object_indexes", "object_dead", "walreceiver",
              "replication", "replication_slots",
              "file_iostat", "file_redo_iostat"):
        s["db"][t] = read_csv_rows(os.path.join(d, "db", t + ".csv"))
    return s

def load_ash_flushes(repl_dir, begin_ts, end_ts):
    """Union the ASH rollups flushed by every snap whose ts falls in
    (begin_ts, end_ts] -- each flush covers [previous snap ts, snap ts], so
    consecutive snaps tile the window. Output mirrors the `vb_tool asp`
    command: per-5-minute buckets of per-SECOND counts (max/avg), both
    sources tagged g = gs_asp / l = local_active_session; the live stream
    hands off between them (observed on 204), so per BUCKET the g rows win
    when present and l only fills g-less buckets -- the same bucket-pick asp
    uses, so the seam never double-counts. Returns:
      cnt:   {(src, bucket): [max_sess, avg_sess, max_active, lock, lwlock,
                              io, wal_sync, trans_sync]}
      event: {(src, bucket, event): [event_type, max_cnt, avg_cnt]}
      sql:   {(src, bucket, qid): [unique_query, max_cnt, avg_cnt]}
      waitchain: {(date_time, root): [max_b_cnt, h_sql, w_sql]}
    Absent ash_*.csv (PG instance / enable_asp off / idle flush) -> empty."""
    rows = {"cnt": [], "event": [], "sql": [], "waitchain": []}
    if repl_dir and os.path.isdir(repl_dir):
        b, e = str(begin_ts or ""), str(end_ts or "")
        for d in sorted(glob.glob(os.path.join(repl_dir, "snap_*"))):
            mp = os.path.join(d, "meta.json")
            if not os.path.isfile(mp):
                continue
            try:
                ts = json.load(open(mp)).get("ts", "")
            except Exception:
                continue
            if not ts or (b and ts <= b) or (e and ts > e):
                continue
            for name in ("cnt", "event", "sql", "waitchain"):
                rows[name].extend(read_csv_rows(os.path.join(d, "db", "ash_%s.csv" % name)))
    def _bk(r):
        return (r.get("bucket") or "")[:16]          # strip any tz suffix
    def _src(r):
        return (r.get("src") or "g")
    gset = set(_bk(r) for nm in rows for r in rows[nm] if _src(r) == "g" and _bk(r))
    def _take(r):
        return _src(r) == "g" or _bk(r) not in gset
    def _mx(cur, val):
        return max(cur, val) if cur is not None else val
    out = {"cnt": {}, "event": {}, "sql": {}, "waitchain": {}}
    for r in rows["waitchain"]:
        dt = r.get("date_time") or ""
        rt = r.get("root_block_sessid") or ""
        if not dt or not rt:
            continue
        k = (dt, rt)
        c = to_num(r.get("max_b_cnt", 0) or 0)
        v = out["waitchain"].get(k)
        if v is None or c > v[0]:
            out["waitchain"][k] = [c, r.get("h_sql") or "", r.get("w_sql") or ""]
    for r in rows["cnt"]:
        if not _bk(r) or not _take(r):
            continue
        k = (_src(r), _bk(r))
        v = out["cnt"].setdefault(k, [None] * 8)
        for i, c in enumerate(("max_sess", "avg_sess", "max_active_sess", "wait_lock",
                               "wait_lwlock", "wait_io", "wait_wal_sync", "wait_trans_sync")):
            v[i] = _mx(v[i], to_num(r.get(c, 0) or 0))
    for r in rows["event"]:
        ev = r.get("event") or ""
        if not ev or not _bk(r) or not _take(r):
            continue
        k = (_src(r), _bk(r), ev)
        v = out["event"].setdefault(k, [r.get("event_type") or "-", None, None])
        v[1] = _mx(v[1], to_num(r.get("max_cnt", 0) or 0))
        v[2] = _mx(v[2], to_num(r.get("avg_cnt", 0) or 0))
    for r in rows["sql"]:
        qid = r.get("unique_query_id") or ""
        if not qid or not _bk(r) or not _take(r):
            continue
        k = (_src(r), _bk(r), qid)
        v = out["sql"].setdefault(k, [r.get("unique_query") or "", None, None])
        v[1] = _mx(v[1], to_num(r.get("max_cnt", 0) or 0))
        v[2] = _mx(v[2], to_num(r.get("avg_cnt", 0) or 0))
    return out

def build_window_from_snaps(begin_dir, end_dir):
    """Compose a load_window-shaped `win` from two single-point snapshots.
    win["os"/"db"] keyed by (phase, name); meta synthesized for the awrrpt header
    (hostname/db_name/db_version from END snap; begin_ts/end_ts/duration from the pair)."""
    b = load_snap(begin_dir)
    e = load_snap(end_dir)
    win = {"meta": {}, "os": {}, "db": {}}
    for f in ("stat", "net_dev", "net_snmp", "net_netstat", "diskstats", "interrupts", "softirqs", "vmstat", "loadavg", "meminfo", "cpuinfo", "numa", "blockdev_meta", "netdev_meta", "dmi", "softnet_stat", "net_rtt"):
        win["os"][("begin", f)] = b["os"].get(f, "")
        win["os"][("end", f)] = e["os"].get(f, "")
    for t in ("statement", "wait_events", "instance_time", "database", "pagewriter",
              "memory_node_detail", "shared_memory", "session_memory", "session_by_sess",
              "pg_settings",
              "object_tables", "object_indexes", "object_dead", "walreceiver",
              "replication", "replication_slots",
              "file_iostat", "file_redo_iostat"):
        win["db"][("begin", t)] = b["db"].get(t, [])
        win["db"][("end", t)] = e["db"].get(t, [])
    bm, em = b["meta"], e["meta"]
    bx = str(bm.get("snap_id", "?"))
    ex = str(em.get("snap_id", "?"))
    begin_ep = to_num(bm.get("ts_epoch"))
    end_ep = to_num(em.get("ts_epoch"))
    duration = int(end_ep - begin_ep) if (begin_ep and end_ep and end_ep >= begin_ep) else 0
    _r1, _r2 = bm.get("db_role") or "", em.get("db_role") or ""
    win["meta"] = {
        "name": "awrrpt_%s_%s" % (bx, ex),
        "hostname": em.get("hostname", "?"),
        "db_name": em.get("db_name", "?"),
        "db_version": em.get("db_version", "?"),
        "vb_tool_version": em.get("vb_tool_version", "?"),
        # primary/physical standby; "a -> b" when the window spans a role
        # change (promote/failover) -- old snaps without the field give "?"
        "db_role": ("%s -> %s" % (_r1, _r2)) if (_r1 and _r2 and _r1 != _r2) else (_r2 or _r1 or "?"),
        "begin_ts": bm.get("ts", ""),
        "end_ts": em.get("ts", ""),
        "duration": duration,
        # extra header facts (Oracle-style report header): snap ids per side,
        # postmaster start time and port from the END snap's meta
        "snap_id_begin": bx,
        "snap_id_end": ex,
        "db_start_time": em.get("db_start_time", ""),
        "port": em.get("port", ""),
    }
    # shared sql_text store (statement slim): sibling file of the snap dirs;
    # end snap's root preferred, begin's as fallback (--root relocation).
    # Store format: multi-member gzip -- each collection appends one compressed
    # member, existing bytes are never rewritten. Plain csv accepted too
    # (legacy pre-gz stores).
    win["_sqltext"] = {}
    for _d in (end_dir, begin_dir):
        _root = os.path.dirname(os.path.abspath(_d))
        _spgz = os.path.join(_root, "sql_text.csv.gz")
        _sp = os.path.join(_root, "sql_text.csv")
        try:
            if os.path.isfile(_spgz):
                with gzip.open(_spgz, "rt", newline="") as f:
                    win["_sqltext"] = {(r.get("user_name", ""), r.get("unique_sql_id", "")):
                                       r.get("query", "") for r in csv.DictReader(f)}
                break
            if os.path.isfile(_sp):
                with open(_sp, newline="") as f:
                    win["_sqltext"] = {(r.get("user_name", ""), r.get("unique_sql_id", "")):
                                       r.get("query", "") for r in csv.DictReader(f)}
                break
        except (csv.Error, OSError, EOFError):
            win["_sqltext"] = {}
            break
    return win

def _os_version():
    """Host OS string for the report header, read at RENDER time -- the OS is
    a host-level fact and snaps live on this host in the normal awrrpt flow,
    so render-time == collection host; reading it here also covers snaps taken
    before the header had an OS row (no meta backfill needed). Source =
    /etc/os-release PRETTY_NAME (present everywhere incl. Kylin; redhat-release
    is NOT relied on -- some Kylin builds lack it), uname -sr fallback; kernel
    release appended."""
    import platform
    v = ""
    try:
        for _ln in open("/etc/os-release"):
            if _ln.startswith("PRETTY_NAME="):
                v = _ln.split("=", 1)[1].strip().strip('"'); break
    except Exception:
        pass
    if not v:
        v = " ".join(x for x in (platform.system(), platform.release()) if x)
    kr = ""
    try: kr = platform.release()
    except Exception: pass
    if v and kr and kr not in v: return "%s %s" % (v, kr)
    return v or "-"

# ================= Replication sampler (awrrpt only) =================
# repl_<YYYYMMDD>.log row grammar (written by _awr_repl_sample in bash):
#   data : ts,application_name,client_addr,state,sync_state,sent,write,flush,replay LSN
#   null : ts,null          (pg_stat_replication returned 0 rows = no standby)
#   error: ts,error         (psql failed; sampler stays alive)

def _lsn64(s):
    """'X/YYYYYYYY' hex LSN -> full 64-bit int, or None if unparseable."""
    try:
        hi, lo = str(s).strip().split("/")
        return (int(hi, 16) << 32) | int(lo, 16)
    except Exception:
        return None

def load_repl_samples(repl_dir, begin_ts, end_ts):
    """Read repl_<YYYYMMDD>.log samples with ts in [begin_ts, end_ts] (inclusive).
    ts format '%F %T' is zero-padded => lexicographic compare == chronological.
    Files are pre-filtered by their YYYYMMDD name; rows re-filtered by ts.
    Returns {"rows":[(ts, kind, fields)], "n_data":N, "n_null":N, "n_error":N, "files":[names]}."""
    out = {"rows": [], "n_data": 0, "n_null": 0, "n_error": 0, "files": []}
    if not repl_dir or not os.path.isdir(repl_dir):
        return out
    bd = str(begin_ts or "")[:10].replace("-", "")
    ed = str(end_ts or "")[:10].replace("-", "")
    for f in sorted(glob.glob(os.path.join(repl_dir, "repl_*.log"))):
        m = re.search(r"repl_(\d{8})\.log$", f)
        if m:
            fd = m.group(1)
            if bd and fd < bd: continue
            if ed and fd > ed: continue
        try:
            lines = open(f).read().splitlines()
        except Exception:
            continue
        out["files"].append(os.path.basename(f))
        for ln in lines:
            ln = ln.strip()
            if not ln: continue
            ts, rest = (ln.split(",", 1) + [""])[:2]
            if begin_ts and ts < str(begin_ts): continue
            if end_ts and ts > str(end_ts): continue
            if rest == "null":
                out["rows"].append((ts, "null", [])); out["n_null"] += 1
            elif rest == "error":
                out["rows"].append((ts, "error", [])); out["n_error"] += 1
            elif ln.count(",") == 8:
                # strict 9-field data row; a row with any other comma count
                # (e.g. application_name containing a comma) is silently dropped.
                out["rows"].append((ts, "data", ln.split(",")[1:])); out["n_data"] += 1
    return out

def replication_section_html(repl):
    """Replication section body html (self-contained; caller emits the sec() title).
    `repl` = load_repl_samples() result. One row per per-minute sample in ts order
    (the sampler's whole timeline for the window); null/error minutes render as
    muted gap rows. A window with no data row at all keeps a compact note instead
    of a table full of identical "no standby" rows."""
    parts = []
    if not repl["files"]:
        return '<div class="note">no replication samples in this period</div>'
    rows = sorted(repl["rows"], key=lambda r: r[0])   # stable: same-minute standbys keep order
    if repl["n_data"] == 0:
        return ('<div class="note">no standby connected at any sample in this period '
                '(%d samples: %d null, %d error)</div>'
                % (len(rows), repl["n_null"], repl["n_error"]))
    parts.append('<table class="t"><tr><th>Sample Time</th><th>Standby</th><th>Client Addr</th>'
                 '<th>State</th><th>Sync</th><th>Sent LSN</th><th>Write LSN</th><th>Flush LSN</th>'
                 '<th>Replay LSN</th><th>Net lag</th><th>Fsync lag</th><th>Apply lag</th>'
                 '<th>Total lag</th></tr>')
    zhidden = 0
    for ts, kind, f in rows:
        if kind != "data":
            msg = "no standby connected" if kind == "null" else "sample error (query failed)"
            parts.append('<tr><td>%s</td><td colspan="12" class="muted">%s</td></tr>'
                         % (esc(ts), msg))
            continue
        sent, write, flush, replay = f[4], f[5], f[6], f[7]
        L = [_lsn64(x) for x in (sent, write, flush, replay)]
        def _seg(i, j):   # bytes between pipeline stages; n/a if either LSN unparseable
            a, b = L[i], L[j]
            return fmt_bytes(a - b) if (a is not None and b is not None and a >= b) else "n/a"
        # healthy minute: sent==write==flush==replay => all four lags 0 => noise row, hidden
        if all(L[i] is not None and L[i] == L[j] for (i, j) in ((0, 1), (1, 2), (2, 3))):
            zhidden += 1
            continue
        parts.append('<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td>'
                     '<td>%s</td><td>%s</td><td>%s</td><td>%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td></tr>'
                     % (esc(ts), esc(f[0]), esc(f[1]), esc(f[2]), esc(f[3]),
                        esc(sent), esc(write), esc(flush), esc(replay),
                        _seg(0, 1), _seg(1, 2), _seg(2, 3), _seg(0, 3)))
    if zhidden == repl["n_data"] and repl["n_null"] == 0 and repl["n_error"] == 0:
        return ('<div class="note">replication healthy the whole window: all %d samples had '
                'zero lag (net / fsync / apply / total) -- healthy minutes not shown.</div>' % zhidden)
    parts.append('</table>')
    if zhidden:
        parts.append('<div class="note">%d minute(s) with all lags 0 hidden (healthy minutes).</div>'
                     % zhidden)
    parts.append('<div class="note">lag = LSN byte distance: '
                 'Net = sent&minus;write, Fsync = write&minus;flush, '
                 'Apply = flush&minus;replay, Total = sent&minus;replay.</div>')
    return _fold("Per-minute detail", "".join(parts))

