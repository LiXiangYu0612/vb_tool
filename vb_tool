            # (一条慢 SQL 期间可能产生成千上万条锁事件),必须限制展示数量,否则 HTML 会爆炸
            MAX_LOCK_LOG_TEXT_LEN = 500
            MAX_LOCK_EVENTS_DISPLAY = 50  # 每条慢 SQL 的详情卡片最多展示 50 条锁事件
            max_lock_events_html = ""
            if max_lock_events:
                # 按等待耗时降序取 Top N,保留最有排查价值的锁事件
                _sorted_lock_events = sorted(
