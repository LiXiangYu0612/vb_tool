# ---- OS per-minute sampler (awrrpt only; written by _awr_repl_sample in bash) ----
# os_<YYYYMMDD>.log[.gz] row grammar (the sampler gzips every PAST day's file):
#   cpu,<ts>,user,nice,system,idle,iowait,irq,softirq,steal,procs_running,procs_blocked
#   pg,<ts>,pgpgin,pgpgout,pswpin,pswpout,pgfault,pgmajfault            (/proc/vmstat)
#   mem,<ts>,MemTotal,MemFree,MemAvailable,Buffers,Cached,Slab,SwapFree  (kB gauges)
#   dsk,<ts>,<raw /proc/diskstats line>     (re-parsed via proc_disk_devs so the
#                                            partition filter matches the window table)
#   net,<ts>,<raw /proc/net/dev iface line> (re-parsed via proc_net_ifaces likewise)

def _ts_epoch(ts):
    try:
        return time.mktime(time.strptime(str(ts), "%Y-%m-%d %H:%M:%S"))
    except Exception:
        return None

def _ts_shift(ts, secs):
    e = _ts_epoch(ts)
    if e is None:
        return str(ts or "")
    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(e + secs))

def load_os_samples(sdir, begin_ts, end_ts):
    """Read os_*.log[.gz] sample rows with ts in [begin-65s, end] (inclusive);
    the one pre-begin sample gives the first in-window minute its rate.
    Same pre-filter-by-day / re-filter-by-row discipline as load_repl_samples().
    Returns {"cpu":[(ts,[10 floats])], "pg":[(ts,[6 floats])],
             "mem":[(ts,[7 or 11 floats])], "dsk":[(ts,raw)], "net":[(ts,raw)],
             "tcp":[(ts,[6 floats])], "tcpext":[(ts,[4 floats])],
             "ssrtt":[(ts,payload)] (raw: conns,min,avg,max,p95,worst_peer,worst_rtt),
             "files":[names]}. Malformed rows (wrong comma count, non-numeric
    payload) are silently dropped, like the repl/slot loaders. mem rows carry
    11 values when the sampler could read /proc/zoneinfo: 7 meminfo kB gauges
    + zone watermarks (free/min/low/high kB, summed over all zones); older
    7-value logs without them stay valid."""
    out = {"cpu": [], "pg": [], "mem": [], "dsk": [], "net": [], "tcp": [], "tcpext": [],
           "ssrtt": [], "sspeer": [], "files": []}
    if not sdir or not os.path.isdir(sdir):
        return out
    lo = _ts_shift(begin_ts, -65)
    ld = lo[:10].replace("-", "")
    ed = str(end_ts or "")[:10].replace("-", "")
    for f in sorted(glob.glob(os.path.join(sdir, "os_*.log")) +
                    glob.glob(os.path.join(sdir, "os_*.log.gz"))):
        m = re.search(r"os_(\d{8})\.log(\.gz)?$", f)
        if m:
            fd = m.group(1)
            if ld and fd < ld: continue
            if ed and fd > ed: continue
        try:
            fh = gzip.open(f, "rt", errors="replace") if f.endswith(".gz") else open(f, errors="replace")
            with fh:
                lines = fh.read().splitlines()
        except Exception:
            continue
        out["files"].append(os.path.basename(f))
        for ln in lines:
            ln = ln.strip()
            if not ln: continue
            g = ln.split(",", 2)
            if len(g) < 3: continue
            typ, ts, payload = g
            if ts < lo: continue
            if end_ts and ts > str(end_ts): continue
            if typ in ("dsk", "net"):
                if payload:
                    out[typ].append((ts, payload))
                continue
            if typ == "ssrtt":
                # gauge row, payload kept raw (worst_peer is non-numeric);
                # parsed by os_minute_rtt_series, not by the float() path
                if payload.count(",") == 6:
                    out[typ].append((ts, payload))
                continue
            if typ == "sspeer":
                # per-conn top-offender row (peer,lport non-numeric): raw;
                # parsed by window_peer_peaks
                if payload.count(",") == 7:
                    out[typ].append((ts, payload))
                continue
            want = {"cpu": 12, "pg": 8, "tcp": 7, "tcpext": 6}.get(typ)   # tcp: 7 fields/6 commas; tcpext: ts+4 counters
            if typ == "mem":
                # 7-value row: 9 fields/8 commas; 11-value (+ zone wm): 13/12
                if ln.count(",") not in (8, 12): continue
            elif not want or ln.count(",") != want - 1: continue
            try:
                out[typ].append((ts, [float(x) for x in payload.split(",")]))
            except Exception:
                continue
    for k in ("cpu", "pg", "mem", "dsk", "net", "tcp", "tcpext", "ssrtt", "sspeer"):
        out[k].sort(key=lambda r: r[0])
    return out

_CPUF = ("busy", "user", "nice", "system", "iowait", "irq", "softirq", "steal", "idle")
_PGK = ("pgpgin", "pgpgout", "pswpin", "pswpout", "pgfault", "pgmajfault")
_NETK = ("rx_bytes", "rx_packets", "rx_errs", "rx_drop",
         "tx_bytes", "tx_packets", "tx_errs", "tx_drop")

def os_minute_cpu_series(samples):
    """[(ts, {component: %}, r, b)] -- per-minute CPU % from consecutive cpu
    samples; the rate belongs to the LATER sample's minute. A non-positive
    total jiffy delta (reboot/counter reset) skips that minute; per-component
    negatives clamp to 0 (same convention as os_window_deltas)."""
    rows = samples.get("cpu", [])
    out = []
    for (ta, a), (tb, b) in zip(rows, rows[1:]):
        ea, eb = _ts_epoch(ta), _ts_epoch(tb)
        if not ea or not eb or eb <= ea: continue
        dtot = sum(b[:8]) - sum(a[:8])
        if dtot <= 0: continue
        # jiffy order: user nice system idle iowait irq softirq steal
        p = [max(0.0, (b[i] - a[i]) / dtot * 100.0) for i in range(8)]
        d = {"user": p[0], "nice": p[1], "system": p[2], "idle": p[3],
             "iowait": p[4], "irq": p[5], "softirq": p[6], "steal": p[7]}
        d["busy"] = d["user"] + d["nice"] + d["system"] + d["irq"] + d["softirq"] + d["steal"]
        out.append((tb, d, b[8], b[9]))
    return out

def os_minute_pg_series(samples):
    """[(ts, {key: per-second rate})] from consecutive pg samples."""
    rows = samples.get("pg", [])
    out = []
    for (ta, a), (tb, b) in zip(rows, rows[1:]):
        ea, eb = _ts_epoch(ta), _ts_epoch(tb)
        if not ea or not eb or eb <= ea: continue
        dt = eb - ea
        out.append((tb, {k: max(0.0, (b[i] - a[i]) / dt) for i, k in enumerate(_PGK)}))
    return out

def os_minute_mem_gauges(samples):
    """{ts: (used_mb, avail_mb, wm)} -- MemUsed = MemTotal - MemAvailable;
    wm = (free_mb, min_mb, low_mb, high_mb) summed-zone watermarks when the
    11-value mem row is present, else None (old logs / zoneinfo unreadable)."""
    out = {}
    for ts, v in samples.get("mem", []):
        if len(v) < 3: continue
        wm = (v[7] / 1024.0, v[8] / 1024.0, v[9] / 1024.0, v[10] / 1024.0) \
            if len(v) >= 11 else None
        out[ts] = ((v[0] - v[2]) / 1024.0, v[2] / 1024.0, wm)
    return out

def os_minute_disk_series(samples):
    """({dev: [(ts, rates, r_await_ms, w_await_ms)]}, discard_supported).
    Consecutive same-device samples give the per-minute delta (idle
    device-minutes skipped, like the whole-window table skips idle devs)."""
    per_dev = {}
    # all dsk rows of one minute form ONE blob: proc_disk_devs drops
    # partitions (vda1 under vda) only when it can see the parent line,
    # so parsing per-row would leak partitions into the detail table
    by_ts = {}
    for ts, raw in samples.get("dsk", []):
        by_ts.setdefault(ts, []).append(raw)
    for ts in sorted(by_ts):
        for d in proc_disk_devs("\n".join(by_ts[ts])):
            per_dev.setdefault(d["name"], []).append((ts, d))
    discard_supported = any(d.get("dc_ios") is not None
                            for rows in per_dev.values() for _, d in rows)
    out = {}
    for dev, rows in per_dev.items():
        for (ta, a), (tb, b) in zip(rows, rows[1:]):
            ea, eb = _ts_epoch(ta), _ts_epoch(tb)
            if not ea or not eb or eb <= ea: continue
            dt = eb - ea
            rd_ios = max(0, b.get("rd_ios", 0) - a.get("rd_ios", 0))
            wr_ios = max(0, b.get("wr_ios", 0) - a.get("wr_ios", 0))
            rd_sec = max(0, b.get("rd_sectors", 0) - a.get("rd_sectors", 0))
            wr_sec = max(0, b.get("wr_sectors", 0) - a.get("wr_sectors", 0))
            rd_tick = max(0, b.get("rd_ticks", 0) - a.get("rd_ticks", 0))
            wr_tick = max(0, b.get("wr_ticks", 0) - a.get("wr_ticks", 0))
            wtick = max(0, b.get("weighted_ticks", 0) - a.get("weighted_ticks", 0))
            dc_ios = _dd(b, a, "dc_ios")
            fl_ios = _dd(b, a, "fl_ios")
            if rd_sec == 0 and wr_sec == 0 and rd_ios + wr_ios == 0:
                continue  # idle device-minute
            out.setdefault(dev, []).append((tb, {
                "read_iops": rd_ios / dt, "write_iops": wr_ios / dt,
                "read_bytes_s": rd_sec * 512.0 / dt, "write_bytes_s": wr_sec * 512.0 / dt,
                "discard_iops": (dc_ios / dt) if dc_ios is not None else None,
                "flush_iops": (fl_ios / dt) if fl_ios is not None else None,
            }, (rd_tick / rd_ios) if rd_ios > 0 else None,
               (wr_tick / wr_ios) if wr_ios > 0 else None))
    return out, discard_supported

def os_minute_net_series(samples):
    """{iface: [(ts, deltas, dt)]} -- bytes/packets deltas carried raw; the
    table divides by dt for rates and shows errs/drop as per-minute counts
    (same Δ semantics as the whole-window table)."""
    per_if = {}
    for ts, raw in samples.get("net", []):
        for it in proc_net_ifaces(raw):
            per_if.setdefault(it["name"], []).append((ts, it))
    out = {}
    for ifc, rows in per_if.items():
        for (ta, a), (tb, b) in zip(rows, rows[1:]):
            ea, eb = _ts_epoch(ta), _ts_epoch(tb)
            if not ea or not eb or eb <= ea: continue
            d = {k: max(0.0, b.get(k, 0) - a.get(k, 0)) for k in _NETK}
            if (d["rx_bytes"] + d["tx_bytes"] + d["rx_packets"] + d["tx_packets"] +
                    d["rx_errs"] + d["tx_errs"] + d["rx_drop"] + d["tx_drop"]) == 0:
                continue  # idle iface-minute
            out.setdefault(ifc, []).append((tb, d, eb - ea))
    return out

def _fold(title, body):
    """Native <details> fold (no JS; no `open` attribute => collapsed by default)."""
    return '<details class="fold"><summary>%s</summary>%s</details>' % (esc(title), body)

def _osmin_note(samples):
    if not samples.get("files"):
        return '<div class="note">no per-minute OS samples in this period (sampler runs while awr is enabled)</div>'
    return '<div class="note">no usable per-minute samples in this period</div>'

def os_minute_tcp_series(samples):
    """[(ts, {opens_s, retrans_s, retrans_pct}, currestab)] from consecutive
    tcp samples. Rates are per-second minute averages; Retrans% =
    dRetransSegs/dOutSegs*100 (None when no outbound segments in the minute);
    CurrEstab is an instantaneous gauge from the LATER sample."""
    rows = samples.get("tcp", [])
    out = []
    for (ta, a), (tb, b) in zip(rows, rows[1:]):
        ea, eb = _ts_epoch(ta), _ts_epoch(tb)
        if not ea or not eb or eb <= ea: continue
        dt = eb - ea
        dop = max(0, (b[0] + b[1]) - (a[0] + a[1]))
        drs = max(0, b[4] - a[4])    # RetransSegs
        dosg = max(0, b[3] - a[3])   # OutSegs
        out.append((tb, {"opens_s": dop / dt, "retrans_s": drs / dt,
                         "retrans_pct": (drs * 100.0 / dosg) if dosg > 0 else None}, b[2]))
    return out

def os_minute_tcpext_series(samples):
    """[(ts, {listen_drops_s, listen_overflows_s, timeouts_s, syn_retrans_s})]
    from consecutive tcpext rows (netstat TcpExt listen/congestion counters)."""
    rows = samples.get("tcpext", [])
    out = []
    for (ta, a), (tb, b) in zip(rows, rows[1:]):
        ea, eb = _ts_epoch(ta), _ts_epoch(tb)
        if not ea or not eb or eb <= ea: continue
        dt = eb - ea
        out.append((tb, {"listen_drops_s": max(0, b[0] - a[0]) / dt,
                         "listen_overflows_s": max(0, b[1] - a[1]) / dt,
                         "timeouts_s": max(0, b[2] - a[2]) / dt,
                         "syn_retrans_s": max(0, b[3] - a[3]) / dt}))
    return out

def os_minute_rtt_series(samples):
    """[(ts, gauge)] -- instantaneous per-minute RTT gauges from ssrtt rows
    (sampler: ss -ti over ESTABLISHED, loopback excluded, kernel smoothed
    estimate in ms). No consecutive-pair math: each row IS that minute's
    snapshot, so gaps (0 qualifying conns / ss absent) are simply missing
    minutes, like idle iface-minutes in the net series."""
    out = []
    for ts, payload in samples.get("ssrtt", []):
        p = (payload or "").split(",")
        if len(p) != 7:
            continue
        try:
            out.append((ts, {"conns": int(float(p[0])),
                             "rtt_min": float(p[1]), "rtt_avg": float(p[2]),
                             "rtt_max": float(p[3]), "rtt_p95": float(p[4]),
                             "worst_peer": p[5], "worst_rtt": float(p[6])}))
        except ValueError:
            continue
    return out

def window_peer_peaks(samples, begin_ts):
    """{(peer, lport): peak dict} from per-minute sspeer rows (the sampler's
    top-3-by-sendq + top-3-by-rtt offenders each minute). For each conn the
    window MAX sendq and MAX rtt are kept with the minute they occurred and
    the rtt/cwnd/retr state observed at that peak minute -- so the per-peer
    tables show window peaks, not one END-snap instant. A conn that stalled
    mid-window and closed before the end snap still shows up here."""
    peaks = {}
    for ts, payload in samples.get("sspeer", []):
        if begin_ts and ts < str(begin_ts):
            continue
        p = (payload or "").split(",")
        if len(p) != 8:
            continue
        try:
            rtt, rttvar = float(p[2]), float(p[3])
            cwnd, retrans, mss, sq = int(p[4]), int(p[5]), int(p[6]), int(p[7])
        except ValueError:
            continue
        k = (p[0], p[1])
        d = peaks.get(k)
        if d is None:
            peaks[k] = d = {"max_sq": 0, "sq_ts": "", "sq_rtt": None, "sq_cwnd": None,
                            "sq_retr": None, "max_rtt": 0.0, "rtt_ts": "", "rtt_sq": None,
                            "rtt_cwnd": None, "rtt_retr": None, "mss": None}
        if sq > d["max_sq"]:
            d.update(max_sq=sq, sq_ts=ts, sq_rtt=rtt, sq_cwnd=cwnd, sq_retr=retrans)
        if rtt > d["max_rtt"]:
            d.update(max_rtt=rtt, rtt_ts=ts, rtt_sq=sq, rtt_cwnd=cwnd, rtt_retr=retrans)
        if mss:
            d["mss"] = mss
    return peaks

def busy_cell_cls(v):
    # busy cell highlighting: bold >50%, red+bold >80%
    if v > 80.0:
        return " b bad"
    if v > 50.0:
        return " b"
    return ""

def lat_cell_cls(v):
    # disk await cell highlighting: bold >10ms, red+bold >20ms; None (no I/O) plain
    if v is None:
        return ""
    if v > 20.0:
        return " b bad"
    if v > 10.0:
        return " b"
    return ""

# memory/paging rate highlighting (per second): only "abnormal when sustained
# non-zero" metrics - pgpgin/pgpgout/pgfault are normal workload proxies
# (like logical reads) and stay plain
VM_HI = {"pswpin": (10.0, 100.0), "pswpout": (10.0, 100.0), "pgmajfault": (5.0, 50.0)}

def thr_cell_cls(v, bold_above, red_above):
    # generic threshold highlight: bold >bold_above, red+bold >red_above
    if v is None:
        return ""
    if v > red_above:
        return " b bad"
    if v > bold_above:
        return " b"
    return ""

def osmin_cpu_table(samples, begin_ts):
    series = [r for r in os_minute_cpu_series(samples)
              if not begin_ts or r[0] >= str(begin_ts)]
    if not series:
        return _osmin_note(samples)
    h = ['<table class="t"><tr><th>Time</th>' +
         ''.join('<th>%s</th>' % f for f in _CPUF) + '<th>r</th><th>b</th></tr>']
    for ts, d, r, b in series:
        h.append('<tr><td>%s</td>%s<td class="n">%d</td><td class="n">%d</td></tr>'
                 % (esc(ts), ''.join('<td class="n%s">%.1f</td>' % (busy_cell_cls(d[f]) if f == "busy" else "", d[f])
                                     for f in _CPUF), r, b))
    h.append('</table>')
    return _fold("Per-minute detail", "".join(h))

def osmin_disk_table(samples, begin_ts):
    per, dsup = os_minute_disk_series(samples)
    rows = sorted((ts, dev, rt, ra, wa)
                  for dev, lst in per.items() for ts, rt, ra, wa in lst
                  if not begin_ts or ts >= str(begin_ts))
    if not rows:
        return _osmin_note(samples)
    head = ('<table class="t"><tr><th>Time</th><th>Device</th><th>r/s</th><th>w/s</th>'
            '<th>Read B/s</th><th>Write B/s</th>')
    if dsup:
        head += '<th>Dscrd/s</th><th>Flush/s</th>'
    head += '<th>r_await (ms)</th><th>w_await (ms)</th></tr>'
    h = [head]
    for ts, dev, rt, ra, wa in rows:
        cells = ('<td>%s</td><td>%s</td><td class="n">%.1f</td><td class="n">%.1f</td>'
                 '<td class="n">%s</td><td class="n">%s</td>' % (
                     esc(ts), esc(dev), rt["read_iops"], rt["write_iops"],
                     fmt_bytes(rt["read_bytes_s"]), fmt_bytes(rt["write_bytes_s"])))
        if dsup:
            cells += ('<td class="n">%s</td><td class="n">%s</td>' % (
                ("%.1f" % rt["discard_iops"]) if rt["discard_iops"] is not None else "-",
                ("%.1f" % rt["flush_iops"]) if rt["flush_iops"] is not None else "-"))
        cells += '<td class="n%s">%s</td><td class="n%s">%s</td>' % (
            lat_cell_cls(ra), ("%.1f" % ra) if ra is not None else "-",
            lat_cell_cls(wa), ("%.1f" % wa) if wa is not None else "-")
        h.append('<tr>' + cells + '</tr>')
    h.append('</table>')
    return _fold("Per-minute detail", "".join(h))

def osmin_net_table(samples, begin_ts):
    per = os_minute_net_series(samples)
    rows = sorted((ts, ifc, d, dt)
                  for ifc, lst in per.items() for ts, d, dt in lst
                  if not begin_ts or ts >= str(begin_ts))
    tser = [r for r in os_minute_tcp_series(samples)
            if not begin_ts or r[0] >= str(begin_ts)]
    if not rows and not tser:
        return _osmin_note(samples)
    h = []
    if rows:
        h.append('<table class="t"><tr><th>Time</th><th>Interface</th><th>RX B/s</th><th>TX B/s</th>'
                 '<th>RX pkt/s</th><th>TX pkt/s</th><th>rx/tx errs (&Delta;)</th><th>rx/tx drop (&Delta;)</th></tr>')
        for ts, ifc, d, dt in rows:
            h.append('<tr><td>%s</td><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%.1f</td><td class="n">%.1f</td>'
                     '<td class="n">%.0f / %.0f</td><td class="n">%.0f / %.0f</td></tr>'
                     % (esc(ts), esc(ifc), fmt_bytes(d["rx_bytes"] / dt), fmt_bytes(d["tx_bytes"] / dt),
                        d["rx_packets"] / dt, d["tx_packets"] / dt,
                        d["rx_errs"], d["tx_errs"], d["rx_drop"], d["tx_drop"]))
        h.append('</table>')
    if tser:
        # host-aggregate TCP counters (L4 snmp deltas, not attributable per
        # interface) merged with the per-connection RTT gauges (ssrtt) on the
        # same minute axis, so Retrans% and RTT read side by side per minute;
        # tcpext / RTT columns appear only when the sampler logged them
        # (new snaps); minutes with an ssrtt gap (0 qualifying conns) show "-"
        xser = {ts: d for ts, d in os_minute_tcpext_series(samples)
                if not begin_ts or ts >= str(begin_ts)}
        rser = {ts: d for ts, d in os_minute_rtt_series(samples)
                if not begin_ts or ts >= str(begin_ts)}
        _xh = ('<th>ListenDrops/s</th><th>ListenOverflows/s</th>'
               '<th>Timeouts/s</th><th>SynRetrans/s</th>') if xser else ''
        _rh = ('<th>RTT Conns</th><th>RTT avg (ms)</th><th>RTT p95 (ms)</th>'
               '<th>Worst Peer</th>') if rser else ''
        h.append('<div class="sub">TCP Statistics</div>')
        _tn = ["Opens/s = active+passive opens; Retrans% = RetransSegs/OutSegs "
               "(bold >3%, red >5%); CurrEstab = established connections at that minute.",
               "Host-aggregate across all connections, not per-interface."]
        if rser:
            _tn.append("RTT Conns/avg/p95 = kernel smoothed RTT (ss) over established "
                       "non-loopback connections sampled that minute; avg/p95 bold "
                       ">5 ms, red >20 ms; '-' = no qualifying connections that minute.")
            _tn.append("Worst Peer = slowest remote endpoint that minute.")
        if xser:
            _tn.append("ListenDrops/ListenOverflows = accept-queue overflow (application "
                       "accepting too slowly or backlog too small).")
            _tn.append("Timeouts = RTO expirations (heavy loss on a connection); "
                       "SynRetrans = retried SYNs (connection setup degraded).")
        h.append(''.join('<div class="note">%s</div>' % esc(x) for x in _tn))
        h.append('<table class="t"><tr><th>Time</th><th>Opens/s</th><th>Retrans/s</th>'
                 '<th>Retrans %</th><th>CurrEstab</th>' + _rh + _xh + '</tr>')
        for ts, d, ce in tser:
            _rp = d["retrans_pct"]
            _rc = ''
            if rser:
                r = rser.get(ts)
                _rc = ('<td class="n">%.0f</td><td class="n%s">%.3f</td>'
                       '<td class="n%s">%.3f</td><td>%s</td>'
                       % (r["conns"],
                          thr_cell_cls(r["rtt_avg"], 5.0, 20.0), r["rtt_avg"],
                          thr_cell_cls(r["rtt_p95"], 5.0, 20.0), r["rtt_p95"],
                          esc(r["worst_peer"]))) if r else \
                      '<td class="n">-</td>' * 3 + '<td>-</td>'
            _xc = ''
            if xser:
                x = xser.get(ts)
                _xc = ('<td class="n">%.2f</td><td class="n">%.2f</td>'
                       '<td class="n">%.2f</td><td class="n">%.2f</td>'
                       % (x["listen_drops_s"], x["listen_overflows_s"],
                          x["timeouts_s"], x["syn_retrans_s"])) if x else \
                      '<td class="n">-</td>' * 4
            h.append('<tr><td>%s</td><td class="n">%.1f</td><td class="n">%.2f</td>'
                     '<td class="n%s">%s</td><td class="n">%.0f</td>%s%s</tr>'
                     % (esc(ts), d["opens_s"], d["retrans_s"],
                        thr_cell_cls(_rp, 3.0, 5.0) if _rp is not None else "",
                        ("%.3f" % _rp) if _rp is not None else "-", ce, _rc, _xc))
        h.append('</table>')
    return _fold("Per-minute detail", "".join(h))

def osmin_mem_table(samples, begin_ts):
    series = {ts: d for ts, d in os_minute_pg_series(samples)
              if not begin_ts or ts >= str(begin_ts)}
    gauges = {ts: g for ts, g in os_minute_mem_gauges(samples).items()
              if not begin_ts or ts >= str(begin_ts)}
    if not series and not gauges:
        return _osmin_note(samples)
    # zone watermarks: columns appear when any row carries them; per-row gaps
    # (old 7-value logs mixed with new ones) render as "-"
    has_wm = any(g[2] is not None for g in gauges.values())
    h = ['<table class="t"><tr><th>Time</th><th>pgpgin/s</th><th>pgpgout/s</th>'
         '<th>pswpin/s</th><th>pswpout/s</th><th>pgfault/s</th><th>pgmajfault/s</th>'
         '<th>MemUsed (MB)</th><th>MemAvail (MB)</th>']
    if has_wm:
        h.append('<th>WM Free (MB)</th><th>WM Min (MB)</th><th>WM Low (MB)</th><th>WM High (MB)</th>')
    h.append('</tr>')
    for ts in sorted(set(series) | set(gauges)):
        d = series.get(ts)
        g = gauges.get(ts)
        wm_tds = ""
        if has_wm:
            wm_tds = ''.join('<td class="n">%s</td>' % (("%.0f" % x) if (g and g[2]) else "-")
                             for x in (g[2] if (g and g[2]) else (0, 0, 0, 0)))
        h.append(('<tr><td>%s</td>%s<td class="n">%s</td><td class="n">%s</td>%s</tr>'
                  % (esc(ts),
                     ''.join('<td class="n%s">%s</td>' % (
                         (thr_cell_cls(d[k], *VM_HI[k]) if (d and k in VM_HI) else ""),
                         fmt_num(d[k]) if d else "-") for k in _PGK),
                     ("%.0f" % g[0]) if g else "-", ("%.0f" % g[1]) if g else "-",
                     wm_tds)))
    h.append('</table>')
    return _fold("Per-minute detail", "".join(h))

def delta_rows(win, table, key, num_cols):
    """For one table in one window: dict keyed by `key` -> {col: end-begin delta for num_cols, '__row': label row}.
    Rows sharing the same key (e.g. same unique_sql_id across multiple users) are summed per phase
    before differencing, so multi-user counters are not silently lost."""
    def _agg(rows):
        buckets = {}
        for r in rows:
            k = r.get(key, "")
            if k == "":
                continue
            if k not in buckets:
                buckets[k] = {"__row": r}
                for c in num_cols:
                    buckets[k][c] = 0.0
            for c in num_cols:
                buckets[k][c] += to_num(r.get(c, 0))
        return buckets
    begin = _agg(win["db"][("begin", table)])
    end = _agg(win["db"][("end", table)])
    out = {}
    for k in set(begin) | set(end):
        b = begin.get(k, {})
        e = end.get(k, {})
        d = {}
        for c in num_cols:
            d[c] = e.get(c, 0.0) - b.get(c, 0.0)
        d["__row"] = (e.get("__row") if e else b.get("__row")) or {}
        d["__present_begin"] = k in begin
        d["__present_end"] = k in end
        out[k] = d
    return out


def sql_text_of(win, row, uid):
    """SQL text for one statement row: inline 'query' column first (legacy full
    snapshots), then the shared per-root sql_text store; None = not collected."""
    q = (row or {}).get("query")
    if q:
        return q
    return (win.get("_sqltext") or {}).get(((row or {}).get("user_name", ""), str(uid)))

