# pseudo / kernel filesystem types filtered from the Filesystem Usage table
# Pseudo-filesystem filter REMOVED (user 2026-11-24): show everything df -T
# itself lists -- tmpfs (/dev/shm etc.) carries real DBA signal (shared mem,
# tmp tables, pgsql_tmp spills). df's own default hiding of zero-size kernel
# mounts (proc/sysfs) stays, so no python-side filter is needed anymore.

def parse_df_fs(txt):
    """os/df_fs = two raw dumps in one file, '@ino@'-separated: `df -TPk`
    (space, 1K blocks, Available) then `df -TPi` (inodes). Merged here by
    (device, mount) -> {(dev, mount): {type, kb_total, kb_avail, ino_total,
    ino_free}}; NOTHING is filtered (tmpfs included; df already hides
    zero-size kernel mounts). '-' inode fields (fs without inode
    stats, e.g. some NFS) leave the ino_* keys absent."""
    if not txt:
        return {}
    out = {}
    def _half(rows, ino):
        for ln in rows.splitlines():
            f = ln.split()
            if len(f) < 7 or f[0] == "Filesystem":
                continue
            dev, typ, mount = f[0], f[1], " ".join(f[6:])
            ent = out.setdefault((dev, mount), {})
            ent["type"] = typ
            try:
                if ino:
                    ent["ino_total"] = int(f[2]); ent["ino_free"] = int(f[4])
                else:
                    ent["kb_total"] = int(f[2]); ent["kb_avail"] = int(f[4])
            except ValueError:
                pass   # '-' (NFS without inode stats etc.) -> key stays absent
    halves = txt.split("@ino@")
    _half(halves[0], False)
    if len(halves) > 1:
        _half(halves[1], True)
    return out

def filesystem_usage_html(win):
    """OS Statistics sub-section 'Filesystem Usage' (awrrpt only -- same policy
    as the other instantaneous OS detail tables). Instantaneous BEGIN/END
    values per filesystem plus the window's USED-delta for inodes and space.
    Requires df_fs in BOTH snaps (old snaps -> whole sub-section hidden)."""
    raw_b = win["os"].get(("begin", "df_fs"), "")
    raw_e = win["os"].get(("end", "df_fs"), "")
    b = parse_df_fs(raw_b)
    e = parse_df_fs(raw_e)
    if not b or not e:
        return None
    keys = [k for k in e if k in b]
    vanished = len(e) - len(keys)
    def _cell(v, fmt):
        return "-" if v is None else fmt(v)
    rows = []
    for k in keys:
        rb, re_ = b[k], e[k]
        it_b, if_b = rb.get("ino_total"), rb.get("ino_free")
        it_e, if_e = re_.get("ino_total"), re_.get("ino_free")
        # used-delta = (total-free)_end - (total-free)_begin; None when either
        # side lacks inode stats
        if None not in (it_b, if_b, it_e, if_e):
            dino = (it_e - if_e) - (it_b - if_b)
        else:
            dino = None
        kt_b, ka_b, kt_e, ka_e = (rb.get("kb_total"), rb.get("kb_avail"),
                                  re_.get("kb_total"), re_.get("kb_avail"))
        dkb = (kt_e - ka_e) - (kt_b - ka_b) if None not in (kt_b, ka_b, kt_e, ka_e) else None
        rows.append((k, rb, re_, it_b, it_e, if_b, if_e,
                     kt_b, kt_e, ka_b, ka_e, dino, dkb))
    # Begin/End as the FIRST column, two rows per filesystem (user 2026-11-24:
    # the old 13-column Begin/End-pairs layout was too wide); the two Delta
    # cells ride a rowspan over the pair.
    h = ['<table class="t"><tr><th></th><th>Device</th><th>Mount</th><th>Type</th>'
         '<th class="n">Inode Total</th><th class="n">Inode Free</th>'
         '<th class="n">Space Total</th><th class="n">Space Free</th>'
         '<th class="n">Delta Inodes Used</th><th class="n">Delta Space Used</th></tr>']
    for (dev, mnt), rb, re_, it_b, it_e, if_b, if_e, kt_b, kt_e, ka_b, ka_e, dino, dkb in rows:
        _idc = '<td>%s</td><td>%s</td><td>%s</td>' % (esc(dev), esc(mnt), esc(re_.get("type", "")))
        h.append('<tr><td>Begin</td>%s'
                 '<td class="n">%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>'
                 '<td class="n" rowspan="2" style="text-align:center;vertical-align:middle">%s</td>'
                 '<td class="n" rowspan="2" style="text-align:center;vertical-align:middle">%s</td></tr>'
                 % (_idc,
                    _cell(it_b, fmt_int), _cell(if_b, fmt_int),
                    _cell(kt_b, lambda v: fmt_bytes(v * 1024)),
                    _cell(ka_b, lambda v: fmt_bytes(v * 1024)),
                    _cell(dino, fmt_int), _cell(dkb, lambda v: fmt_bytes(v * 1024))))
        h.append('<tr><td>End</td>%s'
                 '<td class="n">%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td></tr>'
                 % (_idc,
                    _cell(it_e, fmt_int), _cell(if_e, fmt_int),
                    _cell(kt_e, lambda v: fmt_bytes(v * 1024)),
                    _cell(ka_e, lambda v: fmt_bytes(v * 1024))))
    h.append('</table>')
    if "# df-timeout" in raw_b or "# df-timeout" in raw_e:
        h.append('<div class="note">filesystem inventory incomplete: df hit the '
                 '10 s timeout on at least one snapshot (hung network mount?) '
                 '-- filesystems after the hang point are missing.</div>')
    if vanished:
        h.append('<div class="note">%d filesystem(s) present at only one end of '
                 'the window are not listed.</div>' % vanished)
    # ---- directory sizes (du): data_dir / WAL dir / custom tablespaces ----
    # os/dirsz lines <label>|<path>|<KB or ->; KB '-' = the du hit its 120 s
    # timeout (multi-TB tree). A tablespace target under data_dir (pg_location
    # style) is marked -- its bytes are already inside the data_dir row, do
    # not sum. Old snaps have no dirsz -> table hidden.
    def _dirsz(txt):
        out = {}
        for ln in (txt or "").splitlines():
            f = ln.split("|")
            if len(f) == 3:
                out[f[0]] = (f[1], f[2].strip())
        return out
    dz_b = _dirsz(win["os"].get(("begin", "dirsz"), ""))
    dz_e = _dirsz(win["os"].get(("end", "dirsz"), ""))
    if dz_b or dz_e:
        dd_path = (dz_e.get("data_dir") or dz_b.get("data_dir") or ("", ""))[0].rstrip("/")
        def _dufmt(v):
            try:
                return fmt_bytes(int(v) * 1024)
            except (TypeError, ValueError):
                return "-"
        # data_dir / pg_xlog / tablespaces: few columns -> Begin/End stay
        # COLUMNS (user 2026-11-24); only the wide df table above transposes.
        h.append('<table class="t"><tr><th>Directory</th><th>Path</th>'
                 '<th class="n">Size (Begin)</th><th class="n">Size (End)</th>'
                 '<th class="n">Delta</th></tr>')
        for k in (list(dz_e) + [x for x in dz_b if x not in dz_e]):
            pb, pe = dz_b.get(k), dz_e.get(k)
            path = (pe or pb or ("", ""))[0]
            _in_dd = (dd_path and k.startswith("tblspc")
                      and path.startswith(dd_path + "/"))
            try:
                dlt = (fmt_bytes((int(pe[1]) - int(pb[1])) * 1024)
                       if pb and pe and pb[1] != "-" and pe[1] != "-" else "-")
            except (TypeError, ValueError):
                dlt = "-"
            h.append('<tr><td>%s%s</td><td>%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td></tr>'
                     % (esc(k), ' <span class="note">(inside data_dir)</span>' if _in_dd else "",
                        esc(path),
                        _dufmt(pb[1]) if pb else "-",
                        _dufmt(pe[1]) if pe else "-", dlt))
        h.append('</table>')
    return "".join(h)

def parse_net_rtt(txt):
    """os/net_rtt = raw `ss -tin state established` snapshot (loopback NOT
    filtered at capture time; filtered here). -> [conn] for non-loopback peers
    whose info line yielded an rtt: {peer, lport, sendq, rtt_ms, rttvar_ms,
    cwnd, retrans, mss}. The 512 KB capture cap can cut mid-block: the tail
    conn without a parsed rtt is dropped here. A header without a following
    info line (truncation) is likewise dropped."""
    out, cur = [], None
    for ln in (txt or "").splitlines():
        f = ln.split()
        # header line, two layouts: with State column (f[0]=ESTAB, peer=f[4],
        # sendq=f[2]) on older iproute2; State-column-less when filtering by
        # state on newer iproute2 (f[0]=Recv-Q numeric, peer=f[3], sendq=f[1]).
        if len(f) >= 5 and f[0] == "ESTAB":
            peer_f, sendq_f, local_f = 4, 2, 3
        elif len(f) >= 4 and f[0].isdigit():
            peer_f, sendq_f, local_f = 3, 1, 2
        else:
            peer_f = -1
        if peer_f >= 0:
            if cur and cur["rtt_ms"] is not None:
                out.append(cur)
            cur = None
            peer = f[peer_f]
            if not peer.startswith(("127.", "[::1]", "::1:")):
                try:
                    lport = f[local_f].rsplit(":", 1)[1]
                    sendq = int(f[sendq_f])
                except (IndexError, ValueError):
                    lport = None
                if lport is not None:
                    cur = {"peer": peer, "lport": lport, "sendq": sendq,
                           "rtt_ms": None, "rttvar_ms": None,
                           "cwnd": None, "retrans": None, "mss": None}
            continue
        if cur is None:
            continue
        if cur["rtt_ms"] is None:
            m = re.search(r"rtt:([0-9.]+)(?:ms)?/([0-9.]+)", ln)
            if m:
                try:
                    cur["rtt_ms"], cur["rttvar_ms"] = float(m.group(1)), float(m.group(2))
                except ValueError:
                    pass
        if cur["cwnd"] is None:
            m = re.search(r"\bcwnd:(\d+)", ln)
            if m:
                cur["cwnd"] = int(m.group(1))
        if cur["retrans"] is None:
            m = re.search(r"\bretrans:(\d+)/", ln)
            if m:
                cur["retrans"] = int(m.group(1))
        if cur["mss"] is None:
            m = re.search(r"\bmss:(\d+)", ln)
            if m:
                cur["mss"] = int(m.group(1))
    if cur and cur["rtt_ms"] is not None:
        out.append(cur)
    return out

def parse_netstat_pairs(txt):
    """/proc/net/{snmp,netstat}: paired lines 'X: n1 n2...' + 'X: v1 v2...' ->
    {proto: {name: float}}; unpaired/trailing lines skipped; {} when empty."""
    lines = [l for l in (txt or "").splitlines() if l.strip()]
    out = {}
    i = 0
    while i + 1 < len(lines):
        a, b = lines[i].split(None, 1), lines[i + 1].split(None, 1)
        if len(a) == 2 and len(b) == 2 and a[0] == b[0] and a[0].endswith(":"):
            keys = a[1].split(); vals = b[1].split()
            if len(keys) == len(vals):
                proto = a[0][:-1]
                out.setdefault(proto, {}).update(
                    {k: to_num(v) for k, v in zip(keys, vals)})
                i += 2
                continue
        i += 1
    return out

# assumes disjoint proto names between snmp/netstat ("Ip"/"Tcp" vs "IpExt"/"TcpExt"); an overlap would silently update-merge
def _netstat_merged(pairs):
    """Merge (filekey, text) pairs into single {proto: {name: float}} dict."""
    m = {}
    for _k, txt in pairs:
        for proto, kv in parse_netstat_pairs(txt).items():
            m.setdefault(proto, {}).update(kv)
    return m

def netstat_core_cols(bm, em, dur):
    """Core counter columns for horizontal rendering. Returns (cols, data) where:
    cols = [{"proto","name","label"}] for counters present in at least one side
    data = {proto: {name: {"delta": float|None, "per_sec": float|None}}}
    A column appears if the counter exists in EITHER side; delta=None if missing from one side."""
    cols = []
    data = {}
    for proto, raw_name, label in NET_ERR_CORE:
        bv = bm.get(proto, {}).get(raw_name)
        ev = em.get(proto, {}).get(raw_name)
        if bv is None and ev is None:
            continue  # omit if absent from BOTH sides
        cols.append({"proto": proto, "name": raw_name, "label": label})
        delta = max(0, ev - bv) if (bv is not None and ev is not None) else None
        per_sec = (delta / dur) if (dur and delta is not None) else None
        if proto not in data:
            data[proto] = {}
        data[proto][raw_name] = {"delta": delta, "per_sec": per_sec}
    return cols, data

def netstat_core_rows(os_data, dur):
    """Core counter rows for vertical rendering. Returns list of (proto, name, label, delta, per_sec)
    tuples in NET_ERR_CORE fixed order for counters present in at least one side.
    os_data: win["os"] dict with (phase, filename) keys."""
    bm = _netstat_merged([("snmp", os_data.get(("begin", "net_snmp"), "")),
                         ("netstat", os_data.get(("begin", "net_netstat"), ""))])
    em = _netstat_merged([("snmp", os_data.get(("end", "net_snmp"), "")),
                         ("netstat", os_data.get(("end", "net_netstat"), ""))])
    rows = []
    for proto, raw_name, label in NET_ERR_CORE:
        bv = bm.get(proto, {}).get(raw_name)
        ev = em.get(proto, {}).get(raw_name)
        if bv is None and ev is None:
            continue  # omit if absent from BOTH sides
        delta = max(0, ev - bv) if (bv is not None and ev is not None) else None
        per_sec = (delta / dur) if (dur and delta is not None) else None
        rows.append((proto, raw_name, label, delta, per_sec))
    return rows

def netstat_core_rows_awrdiff(os_data1, dur1, os_data2, dur2):
    """Core counter rows for awrdiff vertical rendering. Returns list of (proto, name, label, delta1, delta2, delta_diff)
    tuples in NET_ERR_CORE fixed order for counters present in at least one side of either period."""
    bm1 = _netstat_merged([("snmp", os_data1.get(("begin", "net_snmp"), "")),
                          ("netstat", os_data1.get(("begin", "net_netstat"), ""))])
    em1 = _netstat_merged([("snmp", os_data1.get(("end", "net_snmp"), "")),
                          ("netstat", os_data1.get(("end", "net_netstat"), ""))])
    bm2 = _netstat_merged([("snmp", os_data2.get(("begin", "net_snmp"), "")),
                          ("netstat", os_data2.get(("begin", "net_netstat"), ""))])
    em2 = _netstat_merged([("snmp", os_data2.get(("end", "net_snmp"), "")),
                          ("netstat", os_data2.get(("end", "net_netstat"), ""))])
    rows = []
    for proto, raw_name, label in NET_ERR_CORE:
        bv1 = bm1.get(proto, {}).get(raw_name)
        ev1 = em1.get(proto, {}).get(raw_name)
        bv2 = bm2.get(proto, {}).get(raw_name)
        ev2 = em2.get(proto, {}).get(raw_name)
        if (bv1 is None and ev1 is None) and (bv2 is None and ev2 is None):
            continue  # omit if absent from BOTH sides of BOTH periods
        delta1 = max(0, ev1 - bv1) if (bv1 is not None and ev1 is not None) else None
        delta2 = max(0, ev2 - bv2) if (bv2 is not None and ev2 is not None) else None
        delta_diff = None
        if delta1 is not None and delta2 is not None:
            delta_diff = delta2 - delta1
        rows.append((proto, raw_name, label, delta1, delta2, delta_diff))
    return rows

def netstat_err_deltas(begins, ends, dur):
    """Error-class netstat counter deltas across the window.
    begins/ends: [(filekey, text)] for ('snmp','netstat'); a counter needs BOTH sides
    present. Returns [{'proto','name','delta','per_sec'}] filtered to delta != 0,
    sorted by abs(delta) desc; empty list when nothing changed / files absent."""
    bm, em = _netstat_merged(begins), _netstat_merged(ends)
    core_names = {(proto, name) for proto, name, _ in NET_ERR_CORE}
    rows = []
    for proto, ekv in em.items():
        for name, ev in ekv.items():
            bv = bm.get(proto, {}).get(name)
            if bv is None:
                continue
            if (proto, name) in core_names:
                continue  # skip core counters (handled by horizontal table)
            low = name.lower()
            if not any(kw in low for kw in NET_ERR_KEYWORDS):
                continue
            d = ev - bv
            if d != 0:
                rows.append({"proto": proto, "name": name, "delta": d,
                             "per_sec": d / dur if dur else 0.0})
    rows.sort(key=lambda r: -abs(r["delta"]))
    return rows

def proc_vmstat(txt):
    """Key /proc/vmstat counters: pgpgin/pgpgout/pswpin/pswpout/pgfault/pgmajfault."""
    keys = ("pgpgin", "pgpgout", "pswpin", "pswpout", "pgfault", "pgmajfault")
    out = {k: 0.0 for k in keys}
    for line in (txt or "").splitlines():
        f = line.split()
        if len(f) >= 2 and f[0] in out:
            try:
                out[f[0]] = to_num(f[1])
            except Exception:
                pass
    return out

def proc_interrupts(txt):
    """/proc/interrupts -> {irq_label: (per_cpu_counts, desc)} (user
    2026-10-30: the per-CPU DISTRIBUTION is the signal -- which core serves
    the NIC/disk IRQ decides the affinity story a summed total hides).
    per_cpu_counts is {cpu_id: count} keyed by the header's OWN cpu ids
    (2026-11-01: the header lists ONLINE cpus only and drops/reshuffles
    columns on hotplug -- positional matching misattributed cores across a
    begin/end window when the online set changed mid-window). Rows:
    '<label>: <cnt per cpu>... <type...> <device...>'. Counts are cumulative
    since boot; consumers take end-begin deltas.
    Second return value: machine-wide single-counter rows (x86 ERR:/MIS: --
    spurious/unhandled IRQ, the failing-IRQ-line signature), which carry no
    per-cpu vector and must never become matrix columns."""
    out = {}
    mw = {}
    lines = (txt or "").splitlines()
    if not lines:
        return out, mw
    ids = [int(h[3:]) for h in lines[0].split()
           if h.startswith("CPU") and h[3:].isdigit()]
    ncpu = len(ids)
    if ncpu <= 0:
        return out, mw
    for ln in lines[1:]:
        f = ln.split(None, 1)
        if not f or not f[0].endswith(":"):
            continue
        label = f[0][:-1]
        # (2026-11-01: a snapshot truncated onto a bare "LOC:" line has no
        # second field -- f[1] would IndexError the whole render)
        if len(f) < 2:
            continue
        rest = (f[1] or "").split()
        if label in ("ERR", "MIS"):
            if rest and rest[0].isdigit():
                mw[label] = int(rest[0])
            continue
        if len(rest) < ncpu:
            continue
        try:
            cnts = {}
            for k in range(ncpu):
                if not rest[k].isdigit():
                    raise ValueError(rest[k])
                cnts[ids[k]] = int(rest[k])
        except Exception:
            continue
        out[label] = (cnts, " ".join(rest[ncpu:]))
    return out, mw

def proc_softirqs(txt):
    """Per-category softirq PER-CPU counts (user 2026-10-30: which CPU runs
    the softirq is the signal -- a single hot NET_RX core is the RPS/multi-
    queue argument a summed total hides). /proc/softirqs lines: '<CAT>: c0 c1..'.
    Returns {cat: {cpu_id: count}} keyed by the header's OWN cpu ids (2026-
    11-01: same hotplug-proofing as proc_interrupts; header-less/odd input
    degrades to positional 0..n-1 ids). Callers that want totals sum the
    dict values."""
    out = {}
    lines = (txt or "").splitlines()
    ids = []
    if lines:
        ids = [int(h[3:]) for h in lines[0].split()
               if h.startswith("CPU") and h[3:].isdigit()]
    for line in lines[1:]:
        f = line.split()
        if not f or not f[0].endswith(":"):
            continue
        cat = f[0][:-1]
        vals = [to_num(x) for x in f[1:]]
        if not vals:
            continue
        _ids = ids if len(ids) == len(vals) else list(range(len(vals)))
        out[cat] = dict(zip(_ids, vals))
    return out

def _tcp_window_stats(bsnmp, esnmp, dur):
    """Whole-window TCP rates from the two snaps' /proc/net/snmp copies.
    None values when either side lacks the Tcp counters (old snaps)."""
    def _g(txt):
        try:
            return _netstat_merged([("snmp", txt)])["Tcp"]
        except Exception:
            return {}
    b, e = _g(bsnmp), _g(esnmp)
    if not b or not e:
        return {"opens_per_sec": None, "retrans_per_sec": None,
                "retrans_pct": None, "currestab_begin": None, "currestab_end": None}
    dop = max(0, (e.get("ActiveOpens", 0) + e.get("PassiveOpens", 0))
              - (b.get("ActiveOpens", 0) + b.get("PassiveOpens", 0)))
    drs = max(0, e.get("RetransSegs", 0) - b.get("RetransSegs", 0))
    dosg = max(0, e.get("OutSegs", 0) - b.get("OutSegs", 0))
    return {"opens_per_sec": dop / dur if dur else 0.0,
            "retrans_per_sec": drs / dur if dur else 0.0,
            "retrans_pct": (drs * 100.0 / dosg) if dosg > 0 else (0.0 if drs == 0 else None),
            "currestab_begin": b.get("CurrEstab"),
            "currestab_end": e.get("CurrEstab")}


def os_window_deltas(win):
    dur = to_num(win.get("meta", {}).get("duration"))
    if not dur or dur <= 0:
        dur = 1.0

    # ---- CPU breakdown ----
    bcpu = proc_cpu_full(win["os"].get(("begin", "stat"), ""))
    ecpu = proc_cpu_full(win["os"].get(("end", "stat"), ""))
    dt = ecpu["total"] - bcpu["total"]
    def cpupct(field):
        return ((ecpu[field] - bcpu[field]) / dt * 100.0) if dt > 0 else 0.0

    # ---- ctxt / intr / vmstat ----
    bx = proc_stat_extras(win["os"].get(("begin", "stat"), ""))
    ex = proc_stat_extras(win["os"].get(("end", "stat"), ""))
    bvm = proc_vmstat(win["os"].get(("begin", "vmstat"), ""))
    evm = proc_vmstat(win["os"].get(("end", "vmstat"), ""))

    # ---- network per-iface ----
    bn = {i["name"]: i for i in proc_net_ifaces(win["os"].get(("begin", "net_dev"), ""))}
    en = {i["name"]: i for i in proc_net_ifaces(win["os"].get(("end", "net_dev"), ""))}
    ifaces = []
    net_bytes = 0.0
    for nm in sorted(set(bn) | set(en)):
        e = en.get(nm, {}); b = bn.get(nm, {})
        d = {"name": nm}
        for k in ("rx_bytes","rx_packets","rx_errs","rx_drop",
                  "tx_bytes","tx_packets","tx_errs","tx_drop"):
            # iface reset/renamed away mid-window -> negative; clamp to 0
            d[k] = max(0.0, e.get(k,0) - b.get(k,0))
        ifaces.append(d)
        net_bytes += d["rx_bytes"] + d["tx_bytes"]

    # ---- disk per-device ----
    bd = {d["name"]: d for d in proc_disk_devs(win["os"].get(("begin", "diskstats"), ""))}
    ed = {d["name"]: d for d in proc_disk_devs(win["os"].get(("end", "diskstats"), ""))}
    disks = []
    discard_seen = False
    rd_bytes = wr_bytes = 0.0
    for nm in sorted(set(bd) | set(ed)):
        e = ed.get(nm, {}); b = bd.get(nm, {})
        # dev vanished / dm rename / counter reset mid-window -> clamp at 0
        rd_ios_d = max(0, e.get("rd_ios",0)   - b.get("rd_ios",0))
        wr_ios_d = max(0, e.get("wr_ios",0)   - b.get("wr_ios",0))
        rd_sec_d = max(0, e.get("rd_sectors",0) - b.get("rd_sectors",0))
        wr_sec_d = max(0, e.get("wr_sectors",0) - b.get("wr_sectors",0))
        rd_tick_d = max(0, e.get("rd_ticks",0) - b.get("rd_ticks",0))
        wr_tick_d = max(0, e.get("wr_ticks",0) - b.get("wr_ticks",0))
        wtick_d  = max(0, e.get("weighted_ticks",0) - b.get("weighted_ticks",0))
        iotick_d = max(0, e.get("io_ticks",0) - b.get("io_ticks",0))
        # %util = busy-ms / wall-ms (dm stacks may exceed 100 -- honest as-is);
        # avgqu-sz = weighted-ms / wall-ms (avg queue length, iostat formulas)
        util_pct = (iotick_d / (dur * 1000.0) * 100.0) if dur else None
        avgqu_sz = (wtick_d / (dur * 1000.0)) if dur else None
        dc_ios_d  = _dd(e, b, "dc_ios")
        dc_sec_d  = _dd(e, b, "dc_sectors")
        fl_ios_d  = _dd(e, b, "fl_ios")
        if dc_ios_d is not None:
            discard_seen = True
        ios_d = rd_ios_d + wr_ios_d
        if rd_sec_d == 0 and wr_sec_d == 0 and ios_d == 0:
            continue  # skip idle devices
        await_ms = (wtick_d / ios_d) if ios_d > 0 else 0.0
        disks.append({
            "name": nm,
            "read_iops":  rd_ios_d / dur,
            "write_iops": wr_ios_d / dur,
            "read_bytes":  rd_sec_d * 512,
            "write_bytes": wr_sec_d * 512,
            "await_ms":  await_ms,
            "r_await_ms": (rd_tick_d / rd_ios_d) if rd_ios_d > 0 else 0.0,
            "w_await_ms": (wr_tick_d / wr_ios_d) if wr_ios_d > 0 else 0.0,
            "discard_iops":  (dc_ios_d / dur) if dc_ios_d is not None else None,
            "discard_bytes": (dc_sec_d * 512) if dc_sec_d is not None else None,
            "flush_iops":    (fl_ios_d / dur) if fl_ios_d is not None else None,
            "util_pct": util_pct,
            "avgqu_sz": avgqu_sz,
        })
        rd_bytes += rd_sec_d * 512
        wr_bytes += wr_sec_d * 512

    # ---- softirqs delta ----
    bs = proc_softirqs(win["os"].get(("begin", "softirqs"), ""))
    es = proc_softirqs(win["os"].get(("end", "softirqs"), ""))
    softirqs = {}
    for cat in set(bs) | set(es):
        # per-CPU dicts -> per-CPU delta (id-joined, same hotplug-proofing
        # as the interrupt chapter); keep the full map for the renderer
        # (which-CPU distribution), sum is derived where needed
        vb, ve = bs.get(cat, {}), es.get(cat, {})
        ids = set(vb) | set(ve)
        if ids:
            d = {i: max(0, ve.get(i, 0) - vb.get(i, 0)) for i in ids}
            if any(d.values()):
                softirqs[cat] = d

    return {
        # legacy fields (kept for summary cards)
        "cpu_busy_pct": cpupct("busy"),
        "net_bytes": net_bytes,
        "disk_read_bytes": rd_bytes,
        "disk_write_bytes": wr_bytes,
        # new
        "dur": dur,
        "cpu": {"busy": cpupct("busy"), "user": cpupct("user"), "nice": cpupct("nice"),
                "system": cpupct("system"),
                "iowait": cpupct("iowait"), "irq": cpupct("irq"),
                "softirq": cpupct("softirq"), "steal": cpupct("steal"),
                "idle": cpupct("idle")},
        "ctxt_per_sec": max(0, ex["ctxt"] - bx["ctxt"]) / dur,
        "intr_per_sec": max(0, ex["intr"] - bx["intr"]) / dur,
        "forks_per_sec": max(0, ex["processes"] - bx["processes"]) / dur
            if (bx.get("processes") or ex.get("processes")) else None,
        "tcp": _tcp_window_stats(
            win["os"].get(("begin", "net_snmp"), ""),
            win["os"].get(("end", "net_snmp"), ""), dur),
        "runq_begin": bx["runq"],
        "runq_end": ex["runq"],
        # no loadavg here (user 2026-10-30): r/b IS the load signal --
        # loadavg is only its EWMA smoothing, zero incremental information;
        # the loadavg snapshot file stays collected for on-site use only
        "vm": {k: (max(0.0, evm[k] - bvm[k]) / dur) for k in bvm},
        "softnet": (lambda bs, es: None if (bs == (0, 0, 0) and es == (0, 0, 0)) else {
            "packets": max(0, es[0] - bs[0]),
            "dropped": max(0, es[1] - bs[1]),
            "squeezed": max(0, es[2] - bs[2])})(
            parse_softnet(win["os"].get(("begin", "softnet_stat"), "")),
            parse_softnet(win["os"].get(("end", "softnet_stat"), ""))),
        "disks": disks,
        "ifaces": ifaces,
        "softirqs": softirqs,
        "discard_supported": discard_seen,
        "disk_meta": parse_blockdev_meta(win["os"].get(("end", "blockdev_meta"), "")),
        "net_meta": parse_netdev_meta(win["os"].get(("end", "netdev_meta"), "")),
        "platform": platform_label(win["os"].get(("end", "dmi"), ""),
                                   win["os"].get(("end", "cpuinfo"), "")
                                   or win["os"].get(("begin", "cpuinfo"), "")),
        "netstat_errs": netstat_err_deltas(
            [("snmp", win["os"].get(("begin", "net_snmp"), "")),
             ("netstat", win["os"].get(("begin", "net_netstat"), ""))],
            [("snmp", win["os"].get(("end", "net_snmp"), "")),
             ("netstat", win["os"].get(("end", "net_netstat"), ""))], dur),
        "netstat_ok": bool(win["os"].get(("begin", "net_snmp"), "") or
                           win["os"].get(("begin", "net_netstat"), "")) and
                      bool(win["os"].get(("end", "net_snmp"), "") or
                           win["os"].get(("end", "net_netstat"), "")),
    }

