def esc(s):
    return html.escape(str(s) if s is not None else "")

def trunc(s, n=80):
    s = str(s or "")
    return s if len(s) <= n else s[:n] + "…"

def delta_cell(base, cur, kind="time"):
    """Render a awr->current delta cell. kind in {time, count, bytes, pct}."""
    base = to_num(base); cur = to_num(cur)
    d = cur - base
    fmt = {"time": fmt_us, "count": fmt_int, "bytes": fmt_bytes}[kind]
    cls = ""
    if kind in ("time", "bytes"):
        # latency/pressure: increase = worse (red), decrease = better (green)
        if d > 0:
            cls = "worse"
        elif d < 0:
            cls = "better"
    arrow = arrow_delta(base, cur) if kind == "time" else \
        ((("-" if d < 0 else "+") + fmt(abs(d))) if d != 0 else "0")
    inner = "%s → %s" % (fmt(base), fmt(cur))
    return '<td class="num %s">%s<br><span class="muted">%s</span></td>' % (cls, inner, esc(arrow))

def render(awr_dir, current_dir, metric, top_n, out_html):
    bl = load_window(awr_dir)
    cur = load_window(current_dir)
    bm = bl["meta"]; cm = cur["meta"]

    metric_col = {"dbtime": "db_time", "cpu": "cpu_time", "io": "data_io_time"}.get(metric, "db_time")
    metric_label = {"dbtime": "DB Time", "cpu": "CPU Time", "io": "IO Time"}.get(metric, "DB Time")

    parts = []
    parts.append("<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'>")
    parts.append("<title>awr compare report</title><style>%s</style></head><body><div class='wrap'>"
                 % CSS)

    # ---- header ----
    parts.append("<h1>AWR Compare Report</h1>")
    parts.append("<div class='meta'><span class='kbadge'>host %s</span>"
                 "<span class='kbadge'>vb_tool %s</span>"
                 "<span class='kbadge'>metric: %s</span></div>"
                 % (esc(bm.get("hostname") or cm.get("hostname") or "?"),
                    esc(bm.get("vb_tool_version") or "?"), esc(metric_label)))
    parts.append("<div class='meta'><b>awr:</b> %s &nbsp;(%s → %s, %s)</div>"
                 % (esc(bm.get("name", "?")),
                    esc(bm.get("begin_ts", "?")), esc(bm.get("end_ts", "?")),
                    esc(bm.get("duration", "?"))))
    parts.append("<div class='meta'><b>current :</b> %s &nbsp;(%s → %s, %s)</div>"
                 % (esc(cm.get("name", "current")),
                    esc(cm.get("begin_ts", "?")), esc(cm.get("end_ts", "?")),
                    esc(cm.get("duration", "?"))))

    # ---- summary cards ----
    def inst_delta(win, name):
        rows = delta_rows(win, "instance_time", "stat_name", ["value"])
        return rows.get(name, {}).get("value", 0.0)
    bl_dbt = inst_delta(bl, "DB_TIME"); cur_dbt = inst_delta(cur, "DB_TIME")
    bl_cpu = inst_delta(bl, "CPU_TIME"); cur_cpu = inst_delta(cur, "CPU_TIME")
    bl_io = inst_delta(bl, "DATA_IO_TIME"); cur_io = inst_delta(cur, "DATA_IO_TIME")

    def dbrow(win):
        return delta_rows(win, "database", "datname",
                          ["xact_commit", "xact_rollback", "blks_read", "blks_hit",
                           "deadlocks", "tup_returned", "tup_fetched"])
    bdb = dbrow(bl); cdb = dbrow(cur)
    def agg(d, col):
        return sum((v.get(col, 0.0)) for v in d.values())
    bl_commits = agg(bdb, "xact_commit"); cur_commits = agg(cdb, "xact_commit")
    bl_blks = agg(bdb, "blks_read"); cur_blks = agg(cdb, "blks_read")

    bos = os_window_deltas(bl); cos = os_window_deltas(cur)

    def card(k, v, cls=""):
        parts.append("<div class='sumcard'><div class='k'>%s</div><div class='v %s'>%s</div></div>"
                     % (esc(k), cls, v))
    parts.append("<h2>Key Metrics</h2>")
    card("DB Time  base→cur", "%s → %s" % (fmt_us(bl_dbt), fmt_us(cur_dbt)),
         "worse" if cur_dbt > bl_dbt and bl_dbt > 0 else "")
    card("CPU Time base→cur", "%s → %s" % (fmt_us(bl_cpu), fmt_us(cur_cpu)))
    card("IO Time  base→cur", "%s → %s" % (fmt_us(bl_io), fmt_us(cur_io)))
    card("Commits  base→cur", "%s → %s" % (fmt_int(bl_commits), fmt_int(cur_commits)))
    card("blks_read base→cur", "%s → %s" % (fmt_int(bl_blks), fmt_int(cur_blks)))
    card("CPU busy %% base→cur", "%.1f%% → %.1f%%" % (bos["cpu_busy_pct"], cos["cpu_busy_pct"]))
    card("CPU iowait %% base→cur", "%.1f%% → %.1f%%" % (
         bos["cpu"].get("iowait", 0.0), cos["cpu"].get("iowait", 0.0)),
         "worse" if cos["cpu"].get("iowait", 0.0) - bos["cpu"].get("iowait", 0.0) > 1.0 else "")
    card("Net bytes base→cur", "%s → %s" % (fmt_bytes(bos["net_bytes"]), fmt_bytes(cos["net_bytes"])))

    # ---- Top SQL changes ----
    parts.append("<h2>Top SQL Changes (by current-window %s)</h2>" % esc(metric_label))
    bST = delta_rows(bl, "statement", "unique_sql_id",
                     ["n_calls", "db_time", "cpu_time", "data_io_time",
                      "n_blocks_fetched", "n_returned_rows"])
    cST = delta_rows(cur, "statement", "unique_sql_id",
                     ["n_calls", "db_time", "cpu_time", "data_io_time",
                      "n_blocks_fetched", "n_returned_rows"])
    keys = sorted(set(bST) | set(cST),
                  key=lambda k: cST.get(k, {}).get(metric_col, 0.0), reverse=True)
    parts.append("<table><tr><th>#</th><th>Query</th><th class='num'>calls base→cur</th>"
                 "<th class='num'>%s base→cur</th><th class='num'>per-call %s</th>"
                 "<th class='num'>CPU Time Delta</th><th class='num'>IO Time Delta</th>"
                 "<th class='num'>blocks Delta</th></tr>" % (esc(metric_label), esc(metric_label)))
    if not keys:
        parts.append("<tr><td colspan='8' class='muted'>no data</td></tr>")
    for i, k in enumerate(keys[:top_n], 1):
        b = bST.get(k); c = cST.get(k)
        # treat absent-in-window as zero deltas
        bd = b if b else {x: 0.0 for x in
                          ("n_calls", "db_time", "cpu_time", "data_io_time",
                           "n_blocks_fetched", "n_returned_rows")}
        cd = c if c else {x: 0.0 for x in
                          ("n_calls", "db_time", "cpu_time", "data_io_time",
                           "n_blocks_fetched", "n_returned_rows")}
        row = (c.get("__row") if c else b.get("__row")) or {}
        query = row.get("query", k)
        user = row.get("user_name", "")
        bcalls = bd["n_calls"]; ccalls = cd["n_calls"]
        bmt = bd[metric_col]; cmt = cd[metric_col]
        bpc = (bmt / bcalls) if bcalls > 0 else 0.0
        cpc = (cmt / ccalls) if ccalls > 0 else 0.0
        badge = ""
        if not b and c:
            badge = " <span class='new'>[NEW]</span>"
        elif b and not c:
            badge = " <span class='muted'>[GONE]</span>"
        # build each cell as a complete <td>...</td> string, then join — no giant %-template
        cells = []
        cells.append("<td>%d</td>" % i)
        cells.append("<td class='sql'>%s<br><span class='muted'>%s</span>%s</td>"
                     % (esc(trunc(query)), esc(user), badge))
        # calls base→cur (count, neutral)
        cells.append('<td class="num">%s → %s<br><span class="muted">%s</span></td>'
                     % (fmt_int(bcalls), fmt_int(ccalls), _sgn(fmt_int(ccalls - bcalls))))
        # metric base→cur (latency: red if worse) + muted delta with multiplier
        cells.append('<td class="num %s">%s → %s<br><span class="muted">%s</span></td>' % (
            "worse" if cmt > bmt and bmt > 0 else "",
            fmt_us(bmt), fmt_us(cmt), esc(arrow_delta(bmt, cmt))))
        # per-call metric (latency: red if worse)
        cells.append('<td class="num %s">%s → %s</td>' % (
            "worse" if cpc > bpc and bpc > 0 else "",
            fmt_us(bpc), fmt_us(cpc)))
        # cpu / io deltas
        cells.append(delta_cell(bd["cpu_time"], cd["cpu_time"], "time"))
        cells.append(delta_cell(bd["data_io_time"], cd["data_io_time"], "time"))
        # blocks delta (count)
        cells.append('<td class="num">%s</td>'
                     % _sgn(fmt_int(cd["n_blocks_fetched"] - bd["n_blocks_fetched"])))
        parts.append("<tr>" + "".join(cells) + "</tr>")
    parts.append("</table>")

    # ---- Wait Events diff ----
    parts.append("<h2>Wait Events (window delta)</h2>")
    bWE = delta_rows(bl, "wait_events", "event", ["wait", "total_wait_time"])
    cWE = delta_rows(cur, "wait_events", "event", ["wait", "total_wait_time"])
    we_keys = sorted(set(bWE) | set(cWE),
                     key=lambda k: cWE.get(k, {}).get("total_wait_time", 0.0), reverse=True)
    parts.append("<table><tr><th>Event</th><th>Type</th><th class='num'>waits base→cur</th>"
                 "<th class='num'>total wait time base→cur</th></tr>")
    if not we_keys:
        parts.append("<tr><td colspan='4' class='muted'>no data</td></tr>")
    for k in we_keys:
        b = bWE.get(k, {"wait": 0, "total_wait_time": 0, "__row": {}})
        c = cWE.get(k, {"wait": 0, "total_wait_time": 0, "__row": {}})
        etype = (c.get("__row") or b.get("__row") or {}).get("type", "")
        parts.append("<tr><td>%s</td><td>%s</td>%s%s</tr>" % (
            esc(k), esc(etype),
            '<td class="num">%s → %s</td>' % (fmt_int(b["wait"]), fmt_int(c["wait"])),
            delta_cell(b["total_wait_time"], c["total_wait_time"], "time")))
    parts.append("</table>")

    # ---- OS diff ----
    parts.append("<h2>System / OS (window delta)</h2>")

    # --- CPU utilization breakdown ---
    parts.append("<h3 class='sub'>CPU utilization</h3>")
    parts.append("<table><tr><th>Component</th><th class='num'>awr</th>"
                 "<th class='num'>current</th><th class='num'>Delta (pp)</th></tr>")
    def cpurow(label, field, warn_up=False):
        bv = bos["cpu"].get(field, 0.0); cv = cos["cpu"].get(field, 0.0)
        cls = " class='num bad'" if warn_up and (cv - bv) > 0.5 else " class='num'"
        parts.append("<tr><td>%s</td><td class='num'>%.1f%%</td><td class='num'>%.1f%%</td>"
                     "<td%s>%+.1f</td></tr>" % (esc(label), bv, cv, cls, cv - bv))
    cpurow("busy (usr+nice+sys+irq+softirq+steal)", "busy")
    cpurow("  user", "user")
    cpurow("  system", "system")
    cpurow("iowait", "iowait", warn_up=True)
    cpurow("irq",    "irq",    warn_up=True)
    cpurow("softirq", "softirq")
    cpurow("idle",   "idle")
    parts.append("</table>")

    # --- System rates ---
    parts.append("<h3 class='sub'>System rates (per second)</h3>")
    parts.append("<table><tr><th>Metric</th><th class='num'>awr</th>"
                 "<th class='num'>current</th><th class='num'>Delta</th></tr>")
    def srow(label, bv, cv, fmt):
        parts.append("<tr><td>%s</td><td class='num'>%s</td><td class='num'>%s</td>"
                     "<td class='num'>%s</td></tr>" % (esc(label), fmt(bv), fmt(cv), _sgn(fmt(cv - bv))))
    srow("context switches/s", bos.get("ctxt_per_sec",0), cos.get("ctxt_per_sec",0), lambda x: "%.0f" % x)
    srow("interrupts/s",      bos.get("intr_per_sec",0),  cos.get("intr_per_sec",0),  lambda x: "%.0f" % x)
    srow("procs_running (snapshot end)", bos.get("runq_end",0), cos.get("runq_end",0), lambda x: "%d" % int(x))
    parts.append("</table>")

    # --- Disk per device (current rate; delta vs awr) ---
    parts.append("<h3 class='sub'>Disk I/O per device (current window rate; (delta) vs awr)</h3>")
    bdd = {d["name"]: d for d in bos.get("disks", [])}
    cdd = {d["name"]: d for d in cos.get("disks", [])}
    parts.append("<table><tr><th>Device</th><th class='num'>read IOPS</th>"
                 "<th class='num'>write IOPS</th><th class='num'>read</th>"
                 "<th class='num'>written</th><th class='num'>await (ms)</th></tr>")
    def dcell(b, c, key, fmt):
        bv = b.get(key, 0.0); cv = c.get(key, 0.0)
        return "<td class='num'>%s <span class='muted'>(%s)</span></td>" % (fmt(cv), _sgn(fmt(cv - bv)))
    for nm in sorted(set(bdd) | set(cdd)):
        b = bdd.get(nm, {}); c = cdd.get(nm, {})
        parts.append("<tr><td>%s</td>%s%s%s%s%s</tr>" % (
            esc(nm),
            dcell(b, c, "read_iops",  lambda x: "%.1f" % x),
            dcell(b, c, "write_iops", lambda x: "%.1f" % x),
            dcell(b, c, "read_bytes", fmt_bytes),
            dcell(b, c, "write_bytes",fmt_bytes),
            dcell(b, c, "await_ms",   lambda x: "%.2f" % x),
        ))
    parts.append("</table>")

    # --- Network per interface (current rate; delta vs awr) ---
    parts.append("<h3 class='sub'>Network per interface (current window rate; (delta) vs awr)</h3>")
    bni = {i["name"]: i for i in bos.get("ifaces", [])}
    cni = {i["name"]: i for i in cos.get("ifaces", [])}
    parts.append("<table><tr><th>Interface</th><th class='num'>rx B/s</th>"
                 "<th class='num'>tx B/s</th><th class='num'>rx pkt/s</th>"
                 "<th class='num'>tx pkt/s</th><th class='num'>rx/tx errs</th>"
                 "<th class='num'>rx/tx drop</th></tr>")
    bdur = bos.get("dur", 1.0); cdur = cos.get("dur", 1.0)
    def nrate(b, c, key, fmt):
        br = b.get(key, 0.0) / (bdur or 1.0)
        cr = c.get(key, 0.0) / (cdur or 1.0)
        return "%s <span class='muted'>(%s)</span>" % (fmt(cr), _sgn(fmt(cr - br)))
    def npair(b, c, rxk, txk, fmt):
        return "%s / %s" % (nrate(b, c, rxk, fmt), nrate(b, c, txk, fmt))
    for nm in sorted(set(bni) | set(cni)):
        b = bni.get(nm, {}); c = cni.get(nm, {})
        parts.append("<tr><td>%s</td><td class='num'>%s</td><td class='num'>%s</td>"
                     "<td class='num'>%s</td><td class='num'>%s</td>"
                     "<td class='num'>%s</td><td class='num'>%s</td></tr>" % (
            esc(nm),
            nrate(b, c, "rx_bytes",   lambda x: "%.0f" % x),
            nrate(b, c, "tx_bytes",   lambda x: "%.0f" % x),
            nrate(b, c, "rx_packets", lambda x: "%.1f" % x),
            nrate(b, c, "tx_packets", lambda x: "%.1f" % x),
            npair(b, c, "rx_errs", "tx_errs", lambda x: "%.0f" % x),
            npair(b, c, "rx_drop", "tx_drop", lambda x: "%.0f" % x),
        ))
    parts.append("</table>")

    # --- Softirqs ---
    parts.append("<h3 class='sub'>Softirqs (window delta, summed across CPUs)</h3>")
    # values became per-CPU lists on 2026-10-30; this table stays summed --
    # sum() takes the old ints too, so both snap generations render
    bsf = {k: sum(v.values()) for k, v in bos.get("softirqs", {}).items()}
    csf = {k: sum(v.values()) for k, v in cos.get("softirqs", {}).items()}
    cats = sorted(set(bsf) | set(csf), key=lambda k: abs(csf.get(k, 0.0)), reverse=True)
    parts.append("<table><tr><th>Category</th><th class='num'>awr</th>"
                 "<th class='num'>current</th><th class='num'>Delta</th></tr>")
    if not cats:
        parts.append("<tr><td colspan='4' class='muted'>no softirqs data</td></tr>")
    for cat in cats:
        bv = bsf.get(cat, 0.0); cv = csf.get(cat, 0.0)
        parts.append("<tr><td>%s</td><td class='num'>%s</td><td class='num'>%s</td>"
                     "<td class='num'>%s</td></tr>" % (esc(cat), fmt_int(bv), fmt_int(cv), _sgn(fmt_int(cv - bv))))
    parts.append("</table>")

    # ---- Instance time model diff ----
    parts.append("<h2>Instance Time Model (window delta)</h2>")
    bIT = delta_rows(bl, "instance_time", "stat_name", ["value"])
    cIT = delta_rows(cur, "instance_time", "stat_name", ["value"])
    it_keys = sorted(set(bIT) | set(cIT),
                     key=lambda k: cIT.get(k, {}).get("value", 0.0), reverse=True)
    parts.append("<table><tr><th>Stat</th><th class='num'>awr</th><th class='num'>current</th>"
                 "<th class='num'>Delta</th></tr>")
    if not it_keys:
        parts.append("<tr><td colspan='4' class='muted'>no data</td></tr>")
    for k in it_keys:
        bv = bIT.get(k, {}).get("value", 0.0)
        cv = cIT.get(k, {}).get("value", 0.0)
        cls = "worse" if cv > bv and bv > 0 else ""
        parts.append("<tr><td>%s</td><td class='num'>%s</td><td class='num %s'>%s</td>"
                     "<td class='num %s'>%s</td></tr>" % (
                         esc(k), fmt_us(bv), cls, fmt_us(cv), cls, _sgn(fmt_us(cv - bv))))
    parts.append("</table>")

    # ---- DB-level stats diff ----
    parts.append("<h2>DB-level Stats (window delta, summed over databases)</h2>")
    cols = [("xact_commit", "commits", "count"), ("xact_rollback", "rollbacks", "count"),
            ("blks_read", "blks_read", "count"), ("blks_hit", "blks_hit", "count"),
            ("deadlocks", "deadlocks", "count"), ("tup_returned", "tup_returned", "count"),
            ("tup_fetched", "tup_fetched", "count")]
    parts.append("<table><tr><th>Metric</th><th class='num'>awr</th><th class='num'>current</th>"
                 "<th class='num'>Delta</th></tr>")
    if not bdb and not cdb:
        parts.append("<tr><td colspan='4' class='muted'>no data</td></tr>")
    for col, label, kind in cols:
        bv = agg(bdb, col); cv = agg(cdb, col)
        # deadlocks are bad when increasing -> red
        cls = ""
        if col == "deadlocks" and cv > bv:
            cls = "worse"
        elif col == "xact_rollback" and cv > bv:
            cls = "worse"
        parts.append("<tr><td>%s</td><td class='num'>%s</td><td class='num %s'>%s</td>"
                     "<td class='num'>%s</td></tr>" % (
                         esc(label), fmt_int(bv), cls, fmt_int(cv), _sgn(fmt_int(cv - bv))))
    parts.append("</table>")

    # ---- footer ----
    parts.append("<div class='footer'>Generated by vb_tool awr compare &middot; "
                 "delta = current_window(end−begin) − awr_window(end−begin) &middot; "
                 "time-class metrics: red = increased (potential regression).</div>")
    parts.append("</div></body></html>")

    htmls = "".join(parts)
    if out_html:
        os.makedirs(os.path.dirname(os.path.abspath(out_html)), exist_ok=True)
        with open(out_html, "w") as f:
            f.write(htmls)
        print("  report : %s" % out_html)
    else:
        sys.stdout.write(htmls)

def render_single(window_dir, metric, top_n, out_html):
    """Single-window report: every value is this window's own end−begin delta.
    Mirrors render()'s sections but single-column (no awr/current/delta diff)."""
    win = load_window(window_dir)
    m = win["meta"]

    metric_col = {"dbtime": "db_time", "cpu": "cpu_time", "io": "data_io_time"}.get(metric, "db_time")
    metric_label = {"dbtime": "DB Time", "cpu": "CPU Time", "io": "IO Time"}.get(metric, "DB Time")

    parts = []
    parts.append("<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'>")
    parts.append("<title>awr report</title><style>%s</style></head><body><div class='wrap'>" % CSS)

    # ---- header ----
    parts.append("<h1>AWR Report</h1>")
    parts.append("<div class='meta'><span class='kbadge'>host %s</span>"
                 "<span class='kbadge'>vb_tool %s</span>"
                 "<span class='kbadge'>metric: %s</span></div>"
                 % (esc(m.get("hostname") or "?"),
                    esc(m.get("vb_tool_version") or "?"), esc(metric_label)))
    parts.append("<div class='meta'><b>awr:</b> %s &nbsp;(%s → %s, %ss)</div>"
                 % (esc(m.get("name", "?")),
                    esc(m.get("begin_ts", "?")), esc(m.get("end_ts", "?")),
                    esc(m.get("duration", "?"))))

    # ---- summary cards (single window deltas) ----
    def inst_delta(name):
        rows = delta_rows(win, "instance_time", "stat_name", ["value"])
        return rows.get(name, {}).get("value", 0.0)
    dbt = inst_delta("DB_TIME")
    cpu = inst_delta("CPU_TIME")
    io  = inst_delta("DATA_IO_TIME")

    db = delta_rows(win, "database", "datname",
                    ["xact_commit", "xact_rollback", "blks_read", "blks_hit",
                     "deadlocks", "tup_returned", "tup_fetched"])
    def agg(col):
        return sum((v.get(col, 0.0)) for v in db.values())
    commits = agg("xact_commit")
    blks = agg("blks_read")

    osd = os_window_deltas(win)

    def card(k, v, cls=""):
        parts.append("<div class='sumcard'><div class='k'>%s</div><div class='v %s'>%s</div></div>"
                     % (esc(k), cls, v))
    parts.append("<h2>Key Metrics (window total)</h2>")
    card("DB Time", fmt_us(dbt))
    card("CPU Time", fmt_us(cpu))
    card("IO Time", fmt_us(io))
    card("Commits", fmt_int(commits))
    card("blks_read", fmt_int(blks))
    card("CPU busy %", "%.1f%%" % osd["cpu_busy_pct"])
    card("CPU iowait %", "%.1f%%" % osd["cpu"].get("iowait", 0.0),
         "worse" if osd["cpu"].get("iowait", 0.0) > 5.0 else "")
    card("Net bytes", fmt_bytes(osd["net_bytes"]))

    # ---- Top SQL ----
    parts.append("<h2>Top SQL (by %s, window delta)</h2>" % esc(metric_label))
    ST = delta_rows(win, "statement", "unique_sql_id",
                    ["n_calls", "db_time", "cpu_time", "data_io_time",
                     "n_blocks_fetched", "n_returned_rows"])
    keys = sorted(ST.keys(), key=lambda k: ST[k].get(metric_col, 0.0), reverse=True)
    parts.append("<table><tr><th>#</th><th>Query</th><th class='num'>calls</th>"
                 "<th class='num'>%s</th><th class='num'>per-call %s</th>"
                 "<th class='num'>CPU Time</th><th class='num'>IO Time</th>"
                 "<th class='num'>blocks</th></tr>" % (esc(metric_label), esc(metric_label)))
    if not keys:
        parts.append("<tr><td colspan='8' class='muted'>no data</td></tr>")
    for i, k in enumerate(keys[:top_n], 1):
        d = ST[k]
        row = d.get("__row") or {}
        query = row.get("query", k)
        user = row.get("user_name", "")
        calls = d.get("n_calls", 0.0)
        mt = d.get(metric_col, 0.0)
        pc = (mt / calls) if calls > 0 else 0.0
        parts.append(
            "<tr><td>%d</td>"
            "<td class='sql'>%s<br><span class='muted'>%s</span></td>"
            "<td class='num'>%s</td><td class='num'>%s</td><td class='num'>%s</td>"
            "<td class='num'>%s</td><td class='num'>%s</td><td class='num'>%s</td></tr>" % (
                i, esc(trunc(query)), esc(user),
                fmt_int(calls), fmt_us(mt), fmt_us(pc),
                fmt_us(d.get("cpu_time", 0.0)), fmt_us(d.get("data_io_time", 0.0)),
                fmt_int(d.get("n_blocks_fetched", 0.0))))
    parts.append("</table>")

    # ---- Wait Events ----
    parts.append("<h2>Wait Events (window delta)</h2>")
    WE = delta_rows(win, "wait_events", "event", ["wait", "total_wait_time"])
    we_keys = sorted(WE.keys(), key=lambda k: WE[k].get("total_wait_time", 0.0), reverse=True)
    parts.append("<table><tr><th>Event</th><th>Type</th><th class='num'>waits</th>"
                 "<th class='num'>total wait time</th></tr>")
    if not we_keys:
        parts.append("<tr><td colspan='4' class='muted'>no data</td></tr>")
    for k in we_keys:
        d = WE[k]
        etype = (d.get("__row") or {}).get("type", "")
        parts.append("<tr><td>%s</td><td>%s</td><td class='num'>%s</td>"
                     "<td class='num'>%s</td></tr>" % (
                         esc(k), esc(etype),
                         fmt_int(d.get("wait", 0.0)),
                         fmt_us(d.get("total_wait_time", 0.0))))
    parts.append("</table>")

    # ---- OS ----
    parts.append("<h2>System / OS (window)</h2>")

    parts.append("<h3 class='sub'>CPU utilization</h3>")
    parts.append("<table><tr><th>Component</th><th class='num'>window avg</th></tr>")
    def cpurow(label, field):
        parts.append("<tr><td>%s</td><td class='num'>%.1f%%</td></tr>"
                     % (esc(label), osd["cpu"].get(field, 0.0)))
    cpurow("busy (usr+nice+sys+irq+softirq+steal)", "busy")
    cpurow("  user", "user")
    cpurow("  system", "system")
    cpurow("iowait", "iowait")
    cpurow("irq", "irq")
    cpurow("softirq", "softirq")
    cpurow("idle", "idle")
    parts.append("</table>")

    parts.append("<h3 class='sub'>System rates (per second)</h3>")
    parts.append("<table><tr><th>Metric</th><th class='num'>value</th></tr>")
    parts.append("<tr><td>context switches/s</td><td class='num'>%.0f</td></tr>" % osd.get("ctxt_per_sec", 0))
    parts.append("<tr><td>interrupts/s</td><td class='num'>%.0f</td></tr>" % osd.get("intr_per_sec", 0))
    parts.append("<tr><td>procs_running (snapshot end)</td><td class='num'>%d</td></tr>"
                 % int(osd.get("runq_end", 0)))
    parts.append("</table>")

    parts.append("<h3 class='sub'>Disk I/O per device (window rate)</h3>")
    parts.append("<table><tr><th>Device</th><th class='num'>read IOPS</th>"
                 "<th class='num'>write IOPS</th><th class='num'>read</th>"
                 "<th class='num'>written</th><th class='num'>await (ms)</th></tr>")
    disks = osd.get("disks", [])
    if not disks:
        parts.append("<tr><td colspan='6' class='muted'>no active disk devices</td></tr>")
    for d in disks:
        parts.append("<tr><td>%s</td><td class='num'>%.1f</td><td class='num'>%.1f</td>"
                     "<td class='num'>%s</td><td class='num'>%s</td><td class='num'>%.2f</td></tr>" % (
                         esc(d["name"]),
                         d.get("read_iops", 0.0), d.get("write_iops", 0.0),
                         fmt_bytes(d.get("read_bytes", 0.0)),
                         fmt_bytes(d.get("write_bytes", 0.0)),
                         d.get("await_ms", 0.0)))
    parts.append("</table>")

    parts.append("<h3 class='sub'>Network per interface (window rate)</h3>")
    dur = osd.get("dur", 1.0) or 1.0
    parts.append("<table><tr><th>Interface</th><th class='num'>rx B/s</th>"
                 "<th class='num'>tx B/s</th><th class='num'>rx pkt/s</th>"
                 "<th class='num'>tx pkt/s</th><th class='num'>rx/tx errs (Delta)</th>"
                 "<th class='num'>rx/tx drop (Delta)</th></tr>")
    ifaces = osd.get("ifaces", [])
    if not ifaces:
        parts.append("<tr><td colspan='7' class='muted'>no network interfaces</td></tr>")
    def nrate(it, key):
        return it.get(key, 0.0) / dur
    for it in ifaces:
        parts.append("<tr><td>%s</td><td class='num'>%.0f</td><td class='num'>%.0f</td>"
                     "<td class='num'>%.1f</td><td class='num'>%.1f</td>"
                     "<td class='num'>%.0f / %.0f</td><td class='num'>%.0f / %.0f</td></tr>" % (
                         esc(it["name"]),
                         nrate(it, "rx_bytes"), nrate(it, "tx_bytes"),
                         nrate(it, "rx_packets"), nrate(it, "tx_packets"),
                         it.get("rx_errs", 0.0), it.get("tx_errs", 0.0),
                         it.get("rx_drop", 0.0), it.get("tx_drop", 0.0)))
    parts.append("</table>")

    parts.append("<h3 class='sub'>Softirqs (window delta, summed across CPUs)</h3>")
    # per-CPU lists since 2026-10-30 -- sum() back to this table's semantics
    sf = {k: sum(v.values()) for k, v in osd.get("softirqs", {}).items()}
    cats = sorted(sf.keys(), key=lambda k: abs(sf[k]), reverse=True)
    parts.append("<table><tr><th>Category</th><th class='num'>count</th></tr>")
    if not cats:
        parts.append("<tr><td colspan='2' class='muted'>no softirqs data</td></tr>")
    for cat in cats:
        parts.append("<tr><td>%s</td><td class='num'>%s</td></tr>" % (esc(cat), _sgn(fmt_int(sf[cat]))))
    parts.append("</table>")

    # ---- Instance time model ----
    parts.append("<h2>Instance Time Model (window delta)</h2>")
    IT = delta_rows(win, "instance_time", "stat_name", ["value"])
    it_keys = sorted(IT.keys(), key=lambda k: IT[k].get("value", 0.0), reverse=True)
    parts.append("<table><tr><th>Stat</th><th class='num'>value</th></tr>")
    if not it_keys:
        parts.append("<tr><td colspan='2' class='muted'>no data</td></tr>")
    for k in it_keys:
        parts.append("<tr><td>%s</td><td class='num'>%s</td></tr>"
                     % (esc(k), fmt_us(IT[k].get("value", 0.0))))
    parts.append("</table>")

    # ---- DB-level stats ----
    parts.append("<h2>DB-level Stats (window delta, summed over databases)</h2>")
    cols = [("xact_commit", "commits"), ("xact_rollback", "rollbacks"),
            ("blks_read", "blks_read"), ("blks_hit", "blks_hit"),
            ("deadlocks", "deadlocks"), ("tup_returned", "tup_returned"),
            ("tup_fetched", "tup_fetched")]
    parts.append("<table><tr><th>Metric</th><th class='num'>value</th></tr>")
    if not db:
        parts.append("<tr><td colspan='2' class='muted'>no data</td></tr>")
    for col, label in cols:
        v = agg(col)
        cls = "worse" if col in ("deadlocks", "xact_rollback") and v > 0 else ""
        parts.append("<tr><td>%s</td><td class='num %s'>%s</td></tr>"
                     % (esc(label), cls, fmt_int(v)))
    parts.append("</table>")

    # ---- footer ----
    parts.append("<div class='footer'>Generated by vb_tool awr report &middot; "
                 "single-window report &middot; all values = window(end−begin) &middot; "
                 "time-class metrics in μs/ms/s.</div>")
    parts.append("</div></body></html>")

    htmls = "".join(parts)
    if out_html:
        os.makedirs(os.path.dirname(os.path.abspath(out_html)), exist_ok=True)
        with open(out_html, "w") as f:
            f.write(htmls)
        print("  report : %s" % out_html)
    else:
        sys.stdout.write(htmls)

def render_single_awr(win, metric, top_n, out_html, repl_dir=None):
    """AWR-style single-window report: faithful AWR subset + classic AWR HTML look.
    Data sources: dbe_perf.{statement,wait_events}, gs_instance_time, pg_stat_database, /proc.
    `win` is a load_window()/build_window_from_snaps() result. Every value is the
    window's end−begin delta. metric is unused in AWR mode (all 5 SQL orderings are
    shown); top_n bounds each SQL sub-table.
    repl_dir set (awrrpt path) => a Replication section is rendered from
    per-minute repl_*.log samples."""
    # pagewriter endpoints from the shared pw_<day>.log when the snaps carry
    # no pagewriter.csv (user 2026-10-21: series moved out of the snapshots)
    patch_win_pagewriter_from_pw(win, repl_dir)
    CSS_AWR = """
body { font-family: Arial, Helvetica, Geneva, sans-serif; font-size: 13px; color: #000; background: #fff; margin: 10px; }
.rhead { margin-bottom: 8px; }
.rhead .title { background: #fff; color: #336699; font-weight: bold; font-size: 26px; padding: 6px 2px; border-bottom: 1px solid #cccc99; }
.rhead table { border-collapse: collapse; width: 800px; margin: 8px 0 4px 0; }
.rhead th { background: #0066CC; color: #fff; font-weight: bold; padding: 3px 8px; font-size: 11px; text-align: left; }
.rhead th.nobg { background: #fff; }
.rhead table tr td { padding: 3px 8px; font-size: 12px; background: #fff; vertical-align: top; }
.rhead tr.alt td { background: #FFFFCC; }
.rhead td.c { text-align: center; }
.rhead th.c { text-align: center; }
.rhead th.n { text-align: right; }
.sec { background: #fff; color: #336699; font-weight: bold; font-size: 24px; padding: 0; margin-top: 26px; border: none; }
.sec h2 { display: inline; margin: 0; font-size: 24px; color: #336699; font-weight: bold; }
.sec .totop { float: right; color: #663300; background: #fff; text-decoration: none; border: 1px solid #663300;
              padding: 1px 10px; font-size: 12px; font-weight: bold; margin-top: 8px; }
.sec .totop:hover { background: #FFFFCC; }
.sub { background: #fff; color: #000000; font-weight: bold; font-size: 13px; padding: 0; margin-top: 14px; border: none; }
table.t { border-collapse: collapse; width: auto; max-width: 100%; border: 1px solid #000; margin-top: 4px; }
table.t th { background: #0066CC; color: #fff; font-weight: bold; padding: 3px 6px; border: 1px solid #0066CC; text-align: center; font-size: 11px; }
table.t td { padding: 3px 6px; border: 1px solid #cccccc; vertical-align: top; font-size: 12px; background: #fff; }
td.n, th.n { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
td.b { font-weight: bold; }
tr:nth-child(even) td { background: #FFFFCC; }
.sql { font-family: 'Courier New', Courier, monospace; font-size: 11px; max-width: 620px; word-break: break-all; }
.note { color: #555; font-size: 11px; font-style: italic; margin: 2px 0 6px 0; }
.muted { color: #9aa5b1; }
.bad { color: #c0392b; font-weight: bold; }
.foot { color: #555; font-size: 11px; margin-top: 20px; border-top: 1px solid #cccc99; padding-top: 8px; }
details.secfold { background: #fff; padding: 0; margin-top: 26px; border: none; }
details.secfold > summary { display: list-item; cursor: pointer; list-style: none; color: #336699;
                            font-weight: bold; font-size: 24px; margin: 0; }
details.secfold > summary .totop { float: right; color: #663300; background: #fff; text-decoration: none;
                            border: 1px solid #663300; padding: 1px 10px; font-size: 12px; font-weight: bold; margin-top: 8px; }
details.secfold > summary .totop:hover { background: #FFFFCC; }
details.secfold > summary::-webkit-details-marker { display: none; }
details.secfold > summary::before { content: "\\25B8 "; color: #663300; }
details.secfold[open] > summary::before { content: "\\25BE "; }
details.fold { margin: 2px 0 8px 0; }
details.fold > summary { display: list-item; cursor: pointer; list-style: none; color: #336699;
                         font-weight: bold; font-size: 13px; margin-top: 8px; }
details.fold > summary::-webkit-details-marker { display: none; }
details.fold > summary::before { content: "\\25B8 "; color: #663300; }
details.fold[open] > summary::before { content: "\\25BE "; }
.sqlblock { border: 1px solid #cccc99; margin: 6px 0; padding: 6px 8px; background: #fff; }
.sqlid { font-weight: bold; color: #336699; font-size: 12px; margin-bottom: 4px; }
.sqlfull { font-family: 'Courier New', Courier, monospace; font-size: 11px; white-space: pre-wrap;
           word-break: break-all; margin: 0; color: #222; }
table.params { table-layout: fixed; width: 100%; }
table.params td { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
table.params td.wrap { white-space: normal; overflow: visible; text-overflow: clip; word-break: break-word; }
.toc { border: 1px solid #cccc99; background: #fff; padding: 8px 12px; margin-bottom: 12px; font-size: 12px; }
.toc b { display: inline-block; margin-bottom: 4px; }
.toc ul { margin: 0; padding-left: 20px; }
.toc li { line-height: 1.7; }
.toc a { color: #663300; text-decoration: none; }
.toc a:hover { text-decoration: underline; }
"""
    m = win["meta"]

    # ---- core denominators ----
    IT = delta_rows(win, "instance_time", "stat_name", ["value"])
    def inst(name):
        return IT.get(name, {}).get("value", 0.0)
    dbt = inst("DB_TIME")                 # microseconds, window delta
    duration = to_num(m.get("duration")) or 1.0

    db = delta_rows(win, "database", "datname",
                    ["xact_commit", "xact_rollback", "blks_read", "blks_hit",
                     "deadlocks", "tup_returned", "tup_fetched",
                     "tup_inserted", "tup_updated", "tup_deleted",
                     "conflicts", "temp_bytes", "temp_files"])
    for _tpl in ("template0", "template1"):   # exclude template DBs from ALL db aggregates
        db.pop(_tpl, None)                     # (Load Profile, Instance Activity, etc.)
    def agg(col):
        return sum((v.get(col, 0.0)) for v in db.values())
    commits = agg("xact_commit"); rollbacks = agg("xact_rollback")
    blks_read = agg("blks_read"); blks_hit = agg("blks_hit")
    deadlocks = agg("deadlocks"); tup_ret = agg("tup_returned"); tup_fetch = agg("tup_fetched")
    tup_ins = agg("tup_inserted"); tup_upd = agg("tup_updated"); tup_del = agg("tup_deleted")
    conflicts = agg("conflicts"); temp_bytes = agg("temp_bytes")
    txns = commits + rollbacks
    logical_reads = blks_read + blks_hit

    ST = delta_rows(win, "statement", "unique_sql_id",
                    ["n_calls", "db_time", "cpu_time", "data_io_time", "plan_time",
                     "sort_time", "hash_time",
                     "n_blocks_fetched", "n_blocks_hit", "n_returned_rows"])
    # sort/hash work-mem + temp-spill per unique sql (statement_mem.csv, KB).
    # Kernel instruments Sort executor nodes and HashJoin only: aggregate-
    # internal sorts (string_agg ... ORDER BY) and HashAgg are NOT counted.
    STM = delta_rows(win, "statement_mem", "unique_sql_id",
                     ["sort_mem_used", "hash_mem_used", "sort_spill_size", "hash_spill_size"])
    sum_calls = sum(d.get("n_calls", 0.0) for d in ST.values())
    sum_gets = sum(d.get("n_blocks_fetched", 0.0) for d in ST.values())

    WE = delta_rows(win, "wait_events", "event", ["wait", "total_wait_time"])
    for _idle in ("wait cmd", "none"):   # drop idle/non-wait "events" (like Oracle idle events)
        WE.pop(_idle, None)
    we_sorted = sorted(WE.keys(), key=lambda k: WE[k].get("total_wait_time", 0.0), reverse=True)

    osd = os_window_deltas(win)

    def pct(num, den):
        return (num / den * 100.0) if den > 0 else 0.0
    def s_of(us):
        return "%.2f" % (to_num(us) / 1_000_000.0)
    def ms_of(us):
        return "%.2f" % (to_num(us) / 1000.0)
    def ms_of_g(us):
        # ms with thousands separators -- SQL Statistics time dimensions render
        # window totals in ms now and the totals run into the millions
        return format(to_num(us) / 1000.0, ",.2f")

    parts = []
    parts.append("<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'>")
    parts.append("<title>Vastbase Performance AWR Report</title><style>%s</style></head><body>" % CSS_AWR)

    _toc = []
    _used_slugs = set()
    def _slug(t):
        s = "".join(c if c.isalnum() else "-" for c in (t or "").lower()).strip("-") or "sec"
        slug = s; i = 2
        while slug in _used_slugs:
            slug = "%s-%d" % (s, i); i += 1
        _used_slugs.add(slug)
        return slug
    _foldsec_open = False
    def _close_foldsec():
        nonlocal _foldsec_open
        if _foldsec_open:
            parts.append('</details>')
            _foldsec_open = False
    def sec(t, fold=False):
        nonlocal _foldsec_open
        _close_foldsec()
        _id = _slug(t)
        _toc.append([t, _id, []])   # [title, anchor, [(sub title, anchor), ...]]
        if fold:
            # whole section collapsed by default; the id rides on <details> so
            # the TOC anchor still jumps here
            parts.append('<details class="secfold" id="%s"><summary>%s <a class="totop" href="#toc">↑ Top</a></summary>'
                         % (_id, esc(t)))
            _foldsec_open = True
        else:
            parts.append('<div class="sec" id="%s"><h2>%s <a class="totop" href="#toc">↑ Top</a></h2></div>' % (_id, esc(t)))
    def sub(t):
        # sub-topics get their own anchor + a hierarchical TOC entry under the
        # last sec (subs only follow a plain, non-folded sec in both renderers,
        # so the anchor jump always lands on visible content)
        _id = _slug(t)
        if _toc:
            _toc[-1][2].append((t, _id))
        parts.append('<div class="sub" id="%s">%s</div>' % (_id, esc(t)))
    def note(t):
        for _line in t.split("\n"):
            parts.append('<div class="note">%s</div>' % esc(_line))

    # ================= Report Summary =================
    _compat_raw = psql_show("sql_compatibility")
    _compat = {"A": "A (Oracle)", "B": "B (MySQL)", "C": "C (MySQL)",
               "PG": "PG (PostgreSQL)"}.get(_compat_raw, _compat_raw) or "?"
    parts.append(
        '<div class="rhead"><div class="title">Vastbase Performance AWR Report</div>'
        '<table><tr><th>Instance Name</th><th>DB Role</th><th>DB Compatibility</th></tr>'
        '<tr><td>%s</td><td>%s</td><td>%s</td></tr></table>'
        '<table><tr><th>Release</th><th>vb_tool (snap / report)</th></tr>'
        '<tr><td>%s</td><td>%s / %s</td></tr></table>'
        '<table><tr><th>Host Name</th><th>OS Version</th><th>Startup Time</th><th class="n">Port</th></tr>'
        '<tr><td>%s</td><td>%s</td><td>%s</td><td class="n">%s</td></tr></table>'
        '<table><tr><th class="nobg"></th><th class="n">Snap Id</th><th class="c">Snap Time</th></tr>'
        '<tr><td>Begin Snap:</td><td class="n">%s</td><td class="c">%s</td></tr>'
        '<tr class="alt"><td>End Snap:</td><td class="n">%s</td><td class="c">%s</td></tr>'
        '<tr><td>Elapsed:</td><td></td><td class="c">%s (s)</td></tr>'
        '<tr class="alt"><td>DB Time:</td><td></td><td class="c">%s (s)</td></tr>'
        '<tr><td>AAS:</td><td></td><td class="c">%.1f</td></tr>'
        '</table></div>' % (
            esc(m.get("db_name") or m.get("name") or "?"), esc(m.get("db_role", "?")), esc(_compat),
            esc(m.get("db_version", "?") or "?"), esc(m.get("vb_tool_version", "?")), esc(_GEN_VER),
            esc(m.get("hostname", "?")), esc(_os_version()),
            esc(m.get("db_start_time") or "-"),
            esc(str(m.get("port") or "-")),
            esc(m.get("snap_id_begin", "?")), esc(m.get("begin_ts", "?")),
            esc(m.get("snap_id_end", "?")), esc(m.get("end_ts", "?")),
            esc(m.get("duration", "?")), s_of(dbt),
            # AAS = average active sessions = DB time / elapsed (Oracle style,
            # 1 decimal); duration defaults to 1.0 so this never divides by 0
            (to_num(dbt) / 1e6) / duration,
        ))
    _toc_pos = len(parts)

    # per-minute OS detail samples (awrrpt path only; os_*.log[.gz] from the
    # cron sampler; the window tables stay snap-delta based and untouched)
    os_smp = (load_os_samples(repl_dir, m.get("begin_ts", ""), m.get("end_ts", ""))
              if repl_dir is not None else None)

    # ================= OS Statistics =================
    sec("OS Statistics")
    _ci = parse_cpuinfo(win["os"].get(("end", "cpuinfo"), "")
                        or win["os"].get(("begin", "cpuinfo"), ""))
    if _ci:
        sub("CPU Info")
        parts.append('<table class="t"><tr><th>Item</th><th class="n">Value</th></tr>')
        parts.append('<tr><td>Model</td><td class="n">%s</td></tr>' % esc(_ci["model"]))
        parts.append('<tr><td>Sockets</td><td class="n">%d</td></tr>' % _ci["sockets"])
        parts.append('<tr><td>Cores per Socket</td><td class="n">%d</td></tr>' % _ci["cores_per_socket"])
        parts.append('<tr><td>Total Physical Cores</td><td class="n">%d</td></tr>' % _ci["total_cores"])
        parts.append('<tr><td>Threads per Core</td><td class="n">%d</td></tr>' % _ci["threads_per_core"])
        parts.append('<tr><td>Logical CPUs</td><td class="n">%d</td></tr>' % _ci["logical_cpus"])
        if _ci["freq_avg_mhz"]:
            parts.append('<tr><td>Freq (min / avg / max MHz)</td><td class="n">%.0f / %.0f / %.0f</td></tr>'
                         % (_ci["freq_min_mhz"], _ci["freq_avg_mhz"], _ci["freq_max_mhz"]))
        if osd.get("platform"):
            parts.append('<tr><td>Platform</td><td class="n">%s</td></tr>' % esc(osd["platform"]))
        parts.append('</table>')
    sub("CPU utilization")
    # horizontal layout: components as columns, one value row (busy bold >50%, red+bold >80%)
    _cf = ("busy", "user", "nice", "system", "iowait", "irq", "softirq", "steal", "idle")
    parts.append('<table class="t"><tr>' +
                 ''.join('<th class="n">%s</th>' % _CPU_DISP[f] for f in _cf) + '</tr>')
    parts.append('<tr>' + ''.join(
        '<td class="n%s">%.1f</td>' % (busy_cell_cls(osd["cpu"].get(f, 0.0)) if f == "busy" else '',
                                       osd["cpu"].get(f, 0.0)) for f in _cf) + '</tr>')
    parts.append('</table>')
    if os_smp is not None:
        parts.append(osmin_cpu_table(os_smp, m.get("begin_ts", "")))
    _ntop = parse_numa(win["os"].get(("end", "numa"), "")
                       or win["os"].get(("begin", "numa"), ""))
    if _ntop:
        _nbeg = parse_numa(win["os"].get(("begin", "numa"), ""))
        _nend = parse_numa(win["os"].get(("end", "numa"), ""))
        # postmaster faulted pages per node (2026-10-31): merged INTO the
        # numastat table as DB Pages/DB Share columns; only the per-VMA top
        # mappings render as their own table below
        _dnm = parse_db_numa_maps(win["os"].get(("end", "db_numa_maps"), ""))
        sub("NUMA")
        parts.append(numa_html_table(_ntop,
                     lambda nid, key: _numa_stat_delta(_nbeg, _nend, nid, key),
                     placement=(_dnm if _dnm and _dnm["total"] > 0 else None)))
        if _dnm and _dnm.get("total", 0) > 0 and len(_dnm.get("kbs", set())) > 1:
            note("DB Share is kernelpagesize_kB-weighted (this instance mixes "
                 "page sizes: %s kB); the DB Pages column counts raw pages"
                 % "/".join(str(x) for x in sorted(_dnm["kbs"])))
        # kernel auto-NUMA balancing activity (2026-10-31): the numa_* family
        # from the ALREADY-collected /proc/vmstat, window delta -- fault-scan
        # and migration churn; counters absent (feature off / kernel without
        # balancing) or SINGLE-NODE box (nothing to balance -- 204 is one,
        # counters sit at 0 forever) -> no table at all
        _nk = ("numa_pte_updates", "numa_huge_pte_updates",
               "numa_hint_faults", "numa_hint_faults_local", "numa_pages_migrated")
        _vb2 = _vmstat_keys(win["os"].get(("begin", "vmstat"), ""), _nk)
        _ve2 = _vmstat_keys(win["os"].get(("end", "vmstat"), ""), _nk)
        if len(_ntop.get("nodes", {})) > 1 and any(k in _ve2 for k in _nk):
            h = ['<h3 class="sub">Auto NUMA Balancing</h3>',
                 '<table class="t"><tr><th>Metric</th><th class="n">Delta</th></tr>']
            for k in _nk:
                if k in _ve2 and k in _vb2:
                    _val = fmt_int(max(0.0, _ve2[k] - _vb2[k]))
                elif k in _ve2 or k in _vb2:
                    # one side lacks the counter -> unknown, never a zero
                    _val = "?"
                else:
                    continue
                h.append('<tr><td>%s</td><td class="n">%s</td></tr>'
                         % (esc(k), _val))
            h.append('</table>')
            parts.append(''.join(h))
        # DB memory placement, per-VMA part (2026-10-31): top 10 mappings by
        # faulted pages with their PER-NODE split -- WHERE each block landed
        # (user 2026-10-31), not just what it is; desc keeps file path +
        # flags + kernelpagesize_kB (the per-node AGGREGATE lives in the
        # numastat table's DB Pages/DB Share columns)
        if _dnm and _dnm["total"] > 0:
            _mn = sorted(_dnm["nodes"].keys(), key=lambda x: int(x[1:]) if x[1:].isdigit() else 0)
            h2 = ['<h3 class="sub">DB Memory Placement (top mappings, faulted pages)</h3>',
                  '<table class="t"><tr><th class="n">Pages</th>'
                  + ''.join('<th class="n">%s</th>' % esc(x) for x in _mn)
                  + '<th>Mapping</th></tr>']
            for pv, mnd, desc, _kbm in _dnm["maps"][:10]:
                if pv <= 0:
                    continue
                h2.append('<tr><td class="n">%s</td>%s<td>%s</td></tr>'
                          % (fmt_int(pv),
                             ''.join('<td class="n">%s</td>' % (fmt_int(mnd[x]) if x in mnd else "-")
                                     for x in _mn),
                             esc(trunc(desc, 72))))
            if _dnm["unfaulted"]:
                h2.append('<tr><td class="n">-</td>%s<td>unfaulted VMAs: %d '
                          '(mapped, never touched)</td></tr>'
                          % (''.join('<td class="n">-</td>' for _ in _mn), _dnm["unfaulted"]))
            h2.append('</table>')
            parts.append(''.join(h2))
    sub("System Activity")
    _th = ['<th class="n">Context Switches per Sec</th>', '<th class="n">Interrupts per Sec</th>']
    _td = ['<td class="n">%.0f</td>' % osd.get("ctxt_per_sec", 0),
           '<td class="n">%.0f</td>' % osd.get("intr_per_sec", 0)]
    if osd.get("forks_per_sec") is not None:
        _th.append('<th class="n">Forks per Sec</th>')
        _td.append('<td class="n">%.1f</td>' % osd["forks_per_sec"])
    _t = osd.get("tcp") or {}
    if _t.get("opens_per_sec") is not None:
        _th.append('<th class="n">TCP Opens per Sec</th>')
        _td.append('<td class="n">%.1f</td>' % _t["opens_per_sec"])
        _th.append('<th class="n">TCP Retrans per Sec</th>')
        _td.append('<td class="n">%.2f</td>' % _t["retrans_per_sec"])
        _th.append('<th class="n">TCP Retrans %</th>')
        _td.append('<td class="n%s">%s</td>' % (
            thr_cell_cls(_t["retrans_pct"], 3.0, 5.0) if _t["retrans_pct"] is not None else "",
            ("%.3f" % _t["retrans_pct"]) if _t["retrans_pct"] is not None else "-"))
        if _t.get("currestab_begin") is not None:
            _th.append('<th class="n">TCP CurrEstab (Begin/End)</th>')
            _td.append('<td class="n">%d / %d</td>' % (_t["currestab_begin"], _t["currestab_end"]))
    # File Handles: PROCESS-scoped (user 2026-10-30): used = the postmaster's
    # open fd count (sum of db_fd_types buckets, live+deleted -- deleted fds
    # are still open); max = the postmaster's EFFECTIVE rlimit from
    # /proc/<pid>/limits "Max open files" (soft/hard; soft is the ceiling
    # alloc_fd enforces). The old pair was system-wide /proc/sys/fs/file-nr
    # (OS allocated vs fs.file-max) -- an OS-level max that says nothing
    # about this process's ceiling, and not what `ulimit -n` in a shell
    # shows either (user: "我只要 prlimit 限制的作为 max").
    def _nofile(phase):
        for ln in win["os"].get((phase, "limits"), "").splitlines():
            if ln.startswith("Max open files"):
                f = ln.split()
                if len(f) >= 4:
                    return f[3], (f[4] if len(f) >= 5 else "-")
        return None
    def _fdcnt(phase):
        tot, seen = 0, False
        for ln in win["os"].get((phase, "db_fd_types"), "").splitlines():
            f = ln.split("|")
            if len(f) == 3:
                try:
                    tot += int(f[1]) + int(f[2]); seen = True
                except ValueError:
                    pass
        return tot if seen else None
    def _nnum(v):
        return fmt_int(int(v)) if str(v).isdigit() else esc(str(v))
    _nb, _ne = _nofile("begin"), _nofile("end")
    if _nb and _ne:
        _cb, _ce = _fdcnt("begin"), _fdcnt("end")
        _th.append('<th class="n">File Handles (used, Max open files soft/hard) Begin/End</th>')
        _td.append('<td class="n">(%s, %s/%s) / (%s, %s/%s)</td>'
                   % (fmt_int(_cb) if _cb is not None else "-",
                      _nnum(_nb[0]), _nnum(_nb[1]),
                      fmt_int(_ce) if _ce is not None else "-",
                      _nnum(_ne[0]), _nnum(_ne[1])))
    if _t.get("opens_per_sec") is not None:
        note("TCP Opens/s = active+passive connections opened (host-aggregate "
             "/proc/net/snmp window delta).\n"
             "TCP Retrans/s = RetransSegs per second; TCP Retrans% = RetransSegs/OutSegs "
             "(bold >3%, red >5%: loss caps single-stream throughput).\n"
             "TCP CurrEstab = established connections at the begin/end snap.")
    # Softirq breakdown (audit 2026-10-30): window delta was parsed into osd
    # but only the dead legacy renderer ever showed it -- TIMER/NET_RX direction
    # is a standard IRQ/softirq triage need
    parts.append('<table class="t"><tr>%s</tr><tr>%s</tr></table>'
                 % ("".join(_th), "".join(_td)))
    # Softirq + IRQ per-CPU distribution, TRANSPOSED (user 2026-10-31: cpus
    # run down the ROWS -- core count only makes the table longer, never
    # wider; irq/softirq categories run across the columns). The count
    # matrices say WHERE interrupts land; the per-core interrupt TIME
    # (%irq/%sirq from the already-collected /proc/stat per-cpu lines, second
    # round 2026-10-31: NOT inside the softirq count matrix anymore -- hard
    # irq time does not belong in a softirq table) says how much of that
    # core they eat, and renders as its own small hot-cores-only table (1 hot
    # core in 64 averages to 1.4% machine-wide and stays invisible in every
    # aggregate table).
    def _km(v):
        # compact counts (user 2026-10-31: 7-digit raw numbers were the
        # width problem; window-Delta 口径 unchanged, only rendering shrinks)
        v = to_num(v)
        # L-1 (round-4): promote at the rounding boundary -- 999,999 must
        # read 1.0M, not "1000K"; same for M -> G on billion-scale counters
        if v >= 999500000:
            return '%.1fG' % (v / 1000000000.0)
        if v >= 999500:
            return '%.1fM' % (v / 1000000.0)
        if v >= 9995:
            return '%.0fK' % (v / 1000.0)
        if v >= 1000:
            return '%.1fK' % (v / 1000.0)
        return '%d' % v
    def _stat_percpu(phase):
        # per-cpu jiffies from the stat snapshot: {name: [usr nice sys idle
        # iowait irq softirq steal]}; name "cpu" = machine aggregate
        out = {}
        for ln in win["os"].get((phase, "stat"), "").splitlines():
            f = ln.split()
            if len(f) >= 9 and f[0].startswith("cpu") and (f[0] == "cpu" or f[0][3:].isdigit()):
                try:
                    out[f[0]] = [to_num(x) for x in f[1:9]]
                except Exception:
                    pass
        return out
    _pb, _pe = _stat_percpu("begin"), _stat_percpu("end")
    def _pct(name, idx):
        # /proc/stat fields: usr nice sys idle iowait IRQ SOFTIRQ steal --
        # irq is index 5, softirq 6 (steal is 7); None when no data.
        # 2026-11-01: a side missing that cpu's line must NOT fabricate a
        # zero baseline -- since-boot counters would then render as window
        # values (same rule as the L-6 half-file discipline: degrade, don't lie)
        if name not in _pb or name not in _pe:
            return None
        b, e = _pb[name], _pe[name]
        d = [max(0.0, e[i] - b[i]) for i in range(8)]
        t = sum(d)
        return (100.0 * d[idx] / t) if t else None
    _cores = [n for n in set(_pb) | set(_pe) if n != "cpu" and n[3:].isdigit()]
    _pirq = {n: _pct(n, 5) for n in _cores}
    _psirq = {n: _pct(n, 6) for n in _cores}
    # parse BOTH ends here (user 2026-10-30: list ALL categories including
    # zero-delta ones -- the osd path drops them); category order = kernel
    # file order (HI TIMER NET_TX NET_RX BLOCK ...), stable across reports
    _sb = proc_softirqs(win["os"].get(("begin", "softirqs"), ""))
    _se = proc_softirqs(win["os"].get(("end", "softirqs"), ""))
    # (2026-11-01, degrade-don't-lie) a begin side whose file is absent/
    # empty must not have its END counters re-baselined to zero -- the
    # deltas would be since-boot totals masquerading as window values.
    # Suppress the affected section and say why.
    if not _sb and _se:
        note("begin snapshot lacks /proc/softirqs -- softirq matrix suppressed "
             "(a since-boot total would masquerade as a window delta)")
    _sq = {}
    if _sb or not _se:
        for _c in set(_se) | set(_sb):
            _vb, _ve = _sb.get(_c, {}), _se.get(_c, {})
            _ids = set(_vb) | set(_ve)
            if _ids:
                _sq[_c] = {i: max(0, _ve.get(i, 0) - _vb.get(i, 0)) for i in _ids}
    # IRQ deltas: ALL irqs incl zero-delta (a silent IRQ is information --
    # dead queue / affinity pinned to an offline core); complete listing
    # lives on, zero-delta ones just don't get a COLUMN in the transposed
    # table (a column costs width, the note below costs a line)
    _ib, _ibm = proc_interrupts(win["os"].get(("begin", "interrupts"), ""))
    _ie, _iem = proc_interrupts(win["os"].get(("end", "interrupts"), ""))
    if not _ib and _ie:
        note("begin snapshot lacks /proc/interrupts -- IRQ table suppressed "
             "(a since-boot total would masquerade as a window delta)")
    _idelta = []
    if _ib or not _ie:
        for _k in set(_ib) | set(_ie):
            _vb = (_ib.get(_k) or ({}, ""))[0]
            _ve = (_ie.get(_k) or ({}, ""))[0]
            _ids = set(_vb) | set(_ve)
            _dv = {i: max(0, _ve.get(i, 0) - _vb.get(i, 0)) for i in _ids}
            _desc = (_ie.get(_k) or _ib.get(_k) or ({}, ""))[1]
            _idelta.append((_k, _desc, _dv))
    # machine-wide irq error counters (ERR:/MIS:) -- legend only, never a
    # matrix column (they carry no per-cpu vector)
    _mwdelta = {}
    if _ib or not _ie:
        for _k in set(_ibm) | set(_iem):
            _mwdelta[_k] = max(0, _iem.get(_k, 0) - _ibm.get(_k, 0))
    # rows are driven by the UNION of cpu ids seen anywhere (stat keys,
    # softirq vectors, irq vectors) -- ids, not positions: a cpu that went
    # offline mid-window keeps its own row instead of stealing its
    # neighbour's counts
    _idset = {int(n[3:]) for n in _cores}
    for _v in _sq.values():
        _idset |= set(_v)
    for _t in _idelta:
        _idset |= set(_t[2])
    _allids = sorted(_idset)
    _ncpu = len(_allids)
    if _ncpu and _sq:
        # ---- Softirq: legend first, then cpu rows x NUMBERED category
        # columns (user 2026-10-31: names live in the legend, the matrix
        # headers carry only the column number -- columns stay narrow no
        # matter how long the kernel names get) ----
        _cats = list(_sq)
        # meanings follow the kernel's softirq enum (include/linux/interrupt.h)
        # -- the NAME-to-semantics map is stable everywhere; rows are driven
        # by whatever categories THIS system reports, unknowns render blank
        _smean = {
            "HI":            "high-prio tasklets (legacy)",
            "TIMER":         "timer ticks (background)",
            "NET_TX":        "NIC transmit",
            "NET_RX":        "NIC receive -- the single-core saturation suspect",
            "BLOCK":         "block I/O completion",
            "BLOCK_IOPOLL":  "block I/O polling (older kernels)",
            "IRQ_POLL":      "block I/O polling (newer name)",
            "TASKLET":       "tasklets (legacy)",
            "SCHED":         "scheduler load balancing (background)",
            "HRTIMER":       "high-res timers (background)",
            "RCU":           "call_rcu deferred reclaim -- churn thermometer",
        }
        h = ['<h3 class="sub">Softirq</h3>',
             '<table class="t"><tr><th class="n">No.</th><th>Category</th>'
             '<th>Meaning</th><th class="n">Delta</th></tr>']
        for _j, _c in enumerate(_cats, 1):
            h.append('<tr><td class="n">%d</td><td>%s</td><td>%s</td>'
                     '<td class="n">%s</td></tr>'
                     % (_j, esc(_c), esc(_smean.get(_c, "")), _km(sum(_sq[_c].values()))))
        h.append('</table>')
        parts.append(''.join(h))
        # matrix columns = only categories with activity (user 2026-10-31):
        # an all-zero category stays in the legend above (Delta 0) but gets
        # no column -- same rule as the IRQ matrix; each column keeps its
        # legend number so the mapping stays stable (numbers may skip)
        _mcols = [(_j, _c) for _j, _c in enumerate(_cats, 1) if sum(_sq[_c].values()) > 0]
        if _mcols:
            _hdr = (['<th>CPU</th>', '<th class="n">%sirq</th>']
                    + ['<th class="n">%d</th>' % _j for _j, _c in _mcols]
                    + ['<th class="n">Total</th>', '<th class="n">Top Softirq</th>'])
            h = ['<table class="t"><tr>' + ''.join(_hdr) + '</tr>']
            for i in _allids:
                ps = _psirq.get("cpu%d" % i)
                row = ['<td>cpu%d</td>' % i,
                       '<td class="n%s">%s</td>' % (thr_cell_cls(ps, 20.0, 50.0),
                                                    '-' if ps is None else '%.1f' % ps)]
                vec = [_sq[c].get(i, 0) for _j, c in _mcols]
                row += ['<td class="n">%s</td>' % _km(v) for v in vec]
                tot = sum(vec)
                row.append('<td class="n">%s</td>' % _km(tot))
                if tot:
                    hi = max(range(len(_mcols)), key=lambda j: vec[j])
                    row.append('<td class="n">%s %.0f%%</td>'
                               % (esc(_mcols[hi][1]), 100.0 * vec[hi] / tot))
                else:
                    row.append('<td class="n">-</td>')
                h.append('<tr>' + ''.join(row) + '</tr>')
            # footer: machine-wide aggregate %sirq + per-category totals
            _ag = _pct("cpu", 6)
            ftr = ['<tr><td>Total</td>',
                   '<td class="n">%s</td>' % ('-' if _ag is None else '%.1f' % _ag)]
            ftr += ['<td class="n">%s</td>' % _km(sum(_sq[c].values())) for _j, c in _mcols]
            ftr.append('<td class="n">%s</td>' % _km(sum(sum(_sq[c].values()) for _j, c in _mcols)))
            ftr.append('<td class="n">-</td>')
            h.append(''.join(ftr) + '</tr>')
            h.append('</table>')
            # collapsed by default (user 2026-10-31) -- same _fold handling as
            # the per-minute detail tables; the legend above carries the keys
            parts.append(_fold('Softirq per CPU', ''.join(h)))
    # ---- IRQ: cpu rows x active-IRQ columns (user 2026-10-31) ----
    _idelta.sort(key=lambda t: (-sum(t[2].values()), 0 if t[0].isdigit() else 1, int(t[0]) if t[0].isdigit() else t[0]))
    _actirq = [t for t in _idelta if sum(t[2].values()) > 0]
    _CAP = 48
    _otherirq = _actirq[_CAP:]
    _actirq = _actirq[:_CAP]
    # legend = FULL inventory, renders whenever any irq data exists (same
    # rule as the Softirq legend -- activity must not gate the inventory);
    # only the matrix below requires active irqs
    if _idelta and _ncpu:
        # irqbalance/header-explainer notes dropped (user 2026-10-31); the
        # collector still records the irqbalance line in the snap file.
        # IRQ legend (user 2026-10-31): full inventory -- every IRQ incl
        # zero-delta, kernel's own device text verbatim (system-adaptive, no
        # hardcoded name classification), total. Matrix headers below carry
        # ONLY the IRQ number. No affinity column (root-only unreadable under
        # the DB user); the distribution matrix itself shows where the kernel
        # actually delivers. Node column (2026-10-31, NUMA cross-check):
        # /proc/irq/N/node is world-readable and says which node the IRQ is
        # steered to (-1 = no binding) -- mismatch vs the DB Memory Placement
        # node is the cross-node story.
        _inode = {}
        for _ln in win["os"].get(("end", "irq_node"), "").splitlines():
            _f = _ln.split("|")
            if len(_f) == 2:
                _inode[_f[0]] = _f[1]
        h = ['<h3 class="sub">IRQ</h3>',
             '<table class="t"><tr><th class="n">IRQ</th><th>Device</th>'
             '<th class="n">Delta</th>'
             + ('<th class="n">Node</th>' if _inode else '') + '</tr>']
        for k, dv, vec in _idelta:
            h.append('<tr><td class="n">%s</td><td>%s</td><td class="n">%s</td>%s</tr>'
                     % (esc(k), esc(trunc(dv, 44)), _km(sum(vec.values())),
                        ('<td class="n">%s</td>' % esc(_inode.get(k, "-"))) if _inode else ''))
        # ERR:/MIS: machine-wide rows -- spurious/unhandled IRQ counters,
        # legend-only (no per-cpu vector, so no matrix column); zero stays
        # written (confirmed-clean), nonzero is the failing-line signature
        for k in sorted(_mwdelta):
            h.append('<tr><td class="n">%s</td><td>%s</td><td class="n">%s</td>%s</tr>'
                     % (esc(k), "spurious/unhandled IRQ (machine-wide)",
                        _km(_mwdelta[k]),
                        ('<td class="n">-</td>') if _inode else ''))
        h.append('</table>')
        parts.append(''.join(h))
        if _actirq:
            _hdr = ['<th>CPU</th>', '<th class="n">%irq</th>']
            for k, dv, vec in _actirq:
                _hdr.append('<th class="n">%s</th>' % esc(k))
            if _otherirq:
                _hdr.append('<th class="n">other (%d irq)</th>' % len(_otherirq))
            _hdr += ['<th class="n">Total</th>', '<th class="n">Top IRQ</th>']
            h = ['<table class="t"><tr>' + ''.join(_hdr) + '</tr>']
            for i in _allids:
                pi = _pirq.get("cpu%d" % i)
                row = ['<td>cpu%d</td>' % i,
                       '<td class="n%s">%s</td>' % (thr_cell_cls(pi, 20.0, 50.0),
                                                    '-' if pi is None else '%.1f' % pi)]
                vec = [v.get(i, 0) for (_, _, v) in _actirq]
                row += ['<td class="n">%s</td>' % _km(x) for x in vec]
                oth = sum(v.get(i, 0) for (_, _, v) in _otherirq)
                if _otherirq:
                    row.append('<td class="n">%s</td>' % _km(oth))
                tot = sum(vec) + oth
                row.append('<td class="n">%s</td>' % _km(tot))
                if tot:
                    hi = max(range(len(vec)), key=lambda j: vec[j])
                    row.append('<td class="n">%s %.0f%%</td>' % (esc(_actirq[hi][0]), 100.0 * vec[hi] / tot))
                else:
                    row.append('<td class="n">-</td>')
                h.append('<tr>' + ''.join(row) + '</tr>')
            _ag = _pct("cpu", 5)
            ftr = ['<tr><td>Total</td>',
                   '<td class="n">%s</td>' % ('-' if _ag is None else '%.1f' % _ag)]
            ftr += ['<td class="n">%s</td>' % _km(sum(v.values())) for (_, _, v) in _actirq]
            if _otherirq:
                ftr.append('<td class="n">%s</td>' % _km(sum(sum(v.values()) for (_, _, v) in _otherirq)))
            ftr.append('<td class="n">%s</td>' % _km(sum(sum(t[2].values()) for t in _idelta)))
            ftr.append('<td class="n">-</td>')
            h.append(''.join(ftr) + '</tr>')
            h.append('</table>')
            # collapsed by default (user 2026-10-31), same _fold handling as above
            parts.append(_fold('IRQ per CPU', ''.join(h)))
            if _otherirq:
                note("low-activity IRQs collapsed into 'other' (all %d listed): %s" % (
                    len(_otherirq), ", ".join(k for k, _d, _v in _otherirq)))
    # DB Process: the postmaster listening on THIS awr's port (multi-instance
    # safe), its cpuset pinning and its EFFECTIVE rlimits (/proc/<pid>/limits,
    # world-readable) -- the running process's limits are the authoritative
    # ones (limits.conf/systemd/inherited already resolved at start; the DB
    # user's name is irrelevant). Hidden on old snaps.
    def _dbproc(phase):
        for ln in win["os"].get((phase, "db_proc"), "").splitlines():
            f = ln.strip().split("|")
            if len(f) == 4:
                try:
                    return int(f[0]), int(f[1]), int(f[2]), int(f[3])
                except ValueError:
                    return None
        return None
    def _dbpcs(phase):
        for ln in win["os"].get((phase, "db_proc"), "").splitlines():
            if ln.startswith("cpuset "):
                return ln[7:].strip() or None
        return None
    def _dbnvc(phase):
        for ln in win["os"].get((phase, "db_proc"), "").splitlines():
            if ln.startswith("nvcswch "):
                f = ln[8:].strip().split("|")
                if len(f) == 2:
                    try:
                        return int(f[0]), int(f[1])
                    except ValueError:
                        return None
        return None
    def _dbkv(phase, key):
        # db_proc 行式键值（vmpte/vmswap 等新键，旧快照缺省返回 None）
        for ln in win["os"].get((phase, "db_proc"), "").splitlines():
            if ln.startswith(key + " "):
                try: return int(ln[len(key)+1:].strip())
                except ValueError: return None
        return None
    _dbp, _dbe = _dbproc("begin"), _dbproc("end")
    if _dbp and _dbe:
        sub("DB Process")
        parts.append('<table class="t"><tr><th></th><th class="n">Begin</th>'
                     '<th class="n">End</th><th class="n">Delta</th></tr>')
        parts.append('<tr><td>Postmaster PID (port %s)</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">-</td></tr>'
                     % (esc(str(m.get("port", "") or "-")), fmt_int(_dbp[0]), fmt_int(_dbe[0])))
        parts.append('<tr><td>RSS</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td></tr>'
                     % (fmt_bytes(_dbp[2] * 1024), fmt_bytes(_dbe[2] * 1024),
                        fmt_bytes((_dbe[2] - _dbp[2]) * 1024)))
        parts.append('<tr><td>VSZ</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td></tr>'
                     % (fmt_bytes(_dbp[1] * 1024), fmt_bytes(_dbe[1] * 1024),
                        fmt_bytes((_dbe[1] - _dbp[1]) * 1024)))
        parts.append('<tr><td>Threads</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%+d</td></tr>'
                     % (fmt_int(_dbp[3]), fmt_int(_dbe[3]), _dbe[3] - _dbp[3]))
        _csb_, _cse_ = _dbpcs("begin"), _dbpcs("end")
        if _csb_ is not None or _cse_ is not None:
            parts.append('<tr><td>Cpuset</td><td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">-</td></tr>'
                         % (esc(_csb_ or "-"), esc(_cse_ or "-")))
        _nvb, _nve = _dbnvc("begin"), _dbnvc("end")
        if _nvb is not None or _nve is not None:
            _bv = fmt_int(_nvb[0]) if _nvb is not None else "-"
            _ev = fmt_int(_nve[0]) if _nve is not None else "-"
            _dv = ("%+d" % (_nve[0] - _nvb[0])) if (_nvb is not None and _nve is not None) else "-"
            parts.append('<tr><td>ctx switch involuntary</td><td class="n">%s</td>'
                         '<td class="n">%s</td><td class="n">%s</td></tr>'
                         % (_bv, _ev, _dv))
        _ptb, _pte2 = _dbkv("begin", "vmpte"), _dbkv("end", "vmpte")
        if _ptb is not None or _pte2 is not None:
            parts.append('<tr><td>Page Tables (VmPTE)</td><td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td></tr>'
                         % (fmt_bytes(_ptb*1024) if _ptb is not None else "-",
                            fmt_bytes(_pte2*1024) if _pte2 is not None else "-",
                            fmt_bytes((_pte2-_ptb)*1024) if (_ptb is not None and _pte2 is not None) else "-"))
        _swb, _swe = _dbkv("begin", "vmswap"), _dbkv("end", "vmswap")
        if _swb is not None or _swe is not None:
            parts.append('<tr><td>Swapped (VmSwap)</td><td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td></tr>'
                         % (fmt_bytes(_swb*1024) if _swb is not None else "-",
                            fmt_bytes(_swe*1024) if _swe is not None else "-",
                            fmt_bytes((_swe-_swb)*1024) if (_swb is not None and _swe is not None) else "-"))
        # effective rlimits as ROWS in the same table (name tagged
        # "(soft)"/"(hard)", reusing the Begin/End columns); static per
        # process lifetime -> delta '-'. Unit-less rows ("Max nice priority 0
        # 0") and space-bearing names ("Max open files") handled via the
        # known-unit wordlist.
        def _limits_map(txt):
            out = {}
            for ln in (txt or "").splitlines():
                f = ln.split()
                if not f or f[0] in ("user", "Limit"):
                    continue
                _UNITS = ("seconds", "bytes", "files", "processes", "locks", "signals", "us")
                if f[-1] in _UNITS:
                    unit, vals = f[-1], f[:-1]
                else:
                    unit, vals = "", f
                if len(vals) >= 3:
                    out[" ".join(vals[:-2])] = (vals[-2], vals[-1], unit)
            return out
        _lmb = _limits_map(win["os"].get(("begin", "limits"), ""))
        _lme = _limits_map(win["os"].get(("end", "limits"), ""))
        for _lk in list(_lme) + [x for x in _lmb if x not in _lme]:
            _lb = _lmb.get(_lk); _le = _lme.get(_lk)
            for _tag, _ix in (("soft", 0), ("hard", 1)):
                parts.append('<tr><td>%s (%s)</td><td class="n">%s</td><td class="n">%s</td>'
                             '<td class="n">-</td></tr>'
                             % (esc(_LIM_DISP.get(_lk, _lk)), _tag.capitalize(),
                                esc(_lb[_ix]) if _lb else "-",
                                esc(_le[_ix]) if _le else "-"))
        # fd classification rows (user 2026-09-17: no separate sub-header --
        # each row simply reads "fd <class>", plus "fd total"); fixed class
        # order, EVERY class carries a deleted sub-row even at zero (user:
        # always display, 0 included). Deleted = symlink target suffixed
        # " (deleted)": temp spills are routinely deleted-while-held, db
        # files deleted-but-held point at DROP/TRUNCATE. Whole block hidden
        # on old snaps / unreadable fd dir.
        def _fdmap(txt):
            out = {}
            for ln in (txt or "").splitlines():
                f = ln.split("|")
                if len(f) == 3:
                    try:
                        # snaps taken before the renames wrote these classes
                        # under older names -- fold into the current ones
                        if f[0] == "server logs":
                            f[0] = "pg logs"
                        if f[0] == "device":
                            f[0] = "dev"
                        out[f[0]] = (int(f[1]), int(f[2]))
                    except ValueError:
                        pass
            return out
        _fdb = _fdmap(win["os"].get(("begin", "db_fd_types"), ""))
        _fde = _fdmap(win["os"].get(("end", "db_fd_types"), ""))
        # snaps taken before 2026-09-20 carry the spill row only when
        # non-zero; inject 0s so it ALWAYS displays (user 2026-09-20: 有没有
        # temp file 都要写). Guard on the new-format "reg" top row -- v2.5.4
        # flat-class snaps always carried their own "temp files" row already.
        # "temp tables" (base tN relations) got its own bucket for half a
        # day and is FOLDED back into the base dir row (user: looks the same
        # as pgsql_tmp) -- drop the key so those snaps do not show the row.
        if "reg" in _fdb or "reg" in _fde:
            _bk = next((k for k in _fdb if k.endswith("/base")), None) or \
                  next((k for k in _fde if k.endswith("/base")), None)
            if _bk:
                _fdb.setdefault(_bk + "/pgsql_tmp", (0, 0))
                _fde.setdefault(_bk + "/pgsql_tmp", (0, 0))
        _fdb.pop("temp tables", None)
        _fde.pop("temp tables", None)
        # TCP socket states on this port, rows ABOVE the fd rows (user
        # 2026-09-17): kernel view via ss "sport = :port" -- time-wait /
        # close-wait never show among the fd socket count, this is their
        # only visibility. Fixed state order, zeros displayed, NO
        # highlighting (user). Hidden on old snaps.
        def _tcpmap(txt):
            out = {}
            for ln in (txt or "").splitlines():
                f = ln.split("|")
                if len(f) == 2:
                    try:
                        out[f[0]] = int(f[1])
                    except ValueError:
                        pass
            return out
        _tsb = _tcpmap(win["os"].get(("begin", "db_tcp_states"), ""))
        _tse = _tcpmap(win["os"].get(("end", "db_tcp_states"), ""))
        if _tsb or _tse:
            for _ts in ("listen", "established", "syn-recv", "syn-sent",
                        "fin-wait-1", "fin-wait-2", "time-wait",
                        "close-wait", "last-ack", "closing", "other"):
