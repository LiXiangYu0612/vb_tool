def get_log_line_prefix():
    try:
        p = subprocess.Popen(
            ['psql', '-t', '-A', '-c', "SHOW log_line_prefix", '-d', 'postgres'],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True
