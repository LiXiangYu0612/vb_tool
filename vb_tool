set -o pipefail

# Resolve the directory where this script is located
VB_TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source library files
source "${VB_TOOL_DIR}/lib/common.sh"
source "${VB_TOOL_DIR}/lib/help.sh"

# Source all command modules
for _cmd_file in "${VB_TOOL_DIR}/commands/"*.sh; do
    [[ -f "$_cmd_file" ]] && source "$_cmd_file"
done
unset _cmd_file

case "$1" in
    as)
        if [[ "$2" == "-help" || "$2" == "--help" ]]; then
            as_help
            exit 0
        fi
        if [ -z "$2" ]; then
            echo "Error: as requires a vb pid parameter" >&2
            as_help
            exit 1
        fi
        if ! run_as "$2"; then
            as_help
            exit 1
        fi
        ;;
    sp)
        if [[ "$2" == "-help" || "$2" == "--help" ]]; then
            sp_help
            exit 0
        fi
        if [ -z "$2" ]; then
            echo "Error: sp requires a parameter" >&2
            sp_help
            exit 1
        fi
        if ! run_sp "$2"; then
            sp_help
            exit 1
        fi
        ;;
    st)
        if [[ "$2" == "-help" || "$2" == "--help" ]]; then
            st_help
            exit 0
        fi
