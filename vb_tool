# _awr_repl_sample  -- ONE pg_stat_replication sample appended to
# <root>/repl_<YYYYMMDD>.log, plus ONE pg_replication_slots sample appended
# to <root>/slot_<YYYYMMDD>.log. Row grammar (both logs):
#   data : ts,<view columns as selected below>
#   null : ts,null     (view = 0 rows: no standby / no slot)
#   error: ts,error    (psql failed; sampler keeps running, cron stays quiet)
# The slot query is independent: its failure never disturbs the stat rows
# (and vice versa -- each log gets its own data/error/null row per minute).
# Always returns 0 (cron-friendly; failures are data, not exit codes).
_awr_repl_sample() {
    local root; root=$(_awr_root)
    mkdir -p "$root" 2>/dev/null || return 0
    local f ts out sf
    f="$root/repl_$(date +%Y%m%d).log"
    sf="$root/slot_$(date +%Y%m%d).log"
    # Non-blocking mutual exclusion: if the previous run is still alive (DB
    # unreachable and hanging inside connect), skip this minute entirely --
    # no zombie pile-up, and no two instances interleaving rows (row order
    # must stay ts-monotonic for the renderer's last-seen logic). The fd is
    # inherited by psql, so the lock is held for the whole attempt.
    exec 9>"$root/repl.lock"
    flock -n 9 || return 0
    ts=$(date '+%F %T')
    # Bound the attempt: connect fails fast (15s) and the query itself is
    # statement-timeout guarded, so one bad minute cannot stretch into a
    # multi-minute hang that blocks every later sample behind the lock.
    out=$(PGCONNECT_TIMEOUT=15 PGOPTIONS='-c statement_timeout=15000' \
          psql -d postgres -tAF',' -c "select application_name,client_addr,state,sync_state,sender_sent_location,receiver_write_location,receiver_flush_location,receiver_replay_location from pg_stat_replication order by application_name" 2>/dev/null)
    if [ "$?" -ne 0 ]; then
        printf '%s,error\n' "$ts" >> "$f"
    elif [ -z "$out" ]; then
        printf '%s,null\n' "$ts" >> "$f"
    else
        printf '%s\n' "$out" | sed "s|^|$ts,|" >> "$f"
    fi
    # ---- slot sample: same minute, same lock, own log; failure is contained ----
    out=$(PGCONNECT_TIMEOUT=15 PGOPTIONS='-c statement_timeout=15000' \
          psql -d postgres -tAF',' -c "select slot_name,plugin,slot_type,database,active,xmin,catalog_xmin,restart_lsn,dummy_standby,confirmed_flush from pg_replication_slots order by slot_name" 2>/dev/null)
    if [ "$?" -ne 0 ]; then
        printf '%s,error\n' "$ts" >> "$sf"
    elif [ -z "$out" ]; then
        printf '%s,null\n' "$ts" >> "$sf"
    else
        printf '%s\n' "$out" | sed "s|^|$ts,|" >> "$sf"
    fi
    return 0
}

# _awr_snap [--root <dir>]  -- allocate snap_id, collect, write meta. The core
# primitive used by both manual `create` and the cron-fired `create`.
_awr_snap() {
    local root_override=""
    if [ "${1:-}" = "--root" ]; then root_override="${2:-}"; shift 2; fi
    local root; root="${root_override:-$(_awr_root)}"
    mkdir -p "$root" 2>/dev/null || { echo "Error: cannot create $root" >&2; return 1; }
    # Non-blocking mutual exclusion (kernel flock on a lockfile, shared across
    # the manual foreground run and the cron-fired runs): a previous create
    # still in flight (e.g. DB unreachable, hanging inside the probe) means
    # this run exits immediately -- no overlapping collectors, no duplicated
    # snap work. fd 9 is inherited by every psql below, so the lock covers the
    # whole collection.
    exec 9>"$root/create.lock"
    if ! flock -n 9; then
        echo "Error: another awr create is still running (lock $root/create.lock) -- try again later" >&2
        return 1
    fi
    local sid ts ts_ep dir
    sid=$(_awr_next_id) || return 1
    dir="$root/snap_$sid"
    rm -rf "$dir" 2>/dev/null
    mkdir -p "$dir" 2>/dev/null || { echo "Error: cannot create $dir" >&2; return 1; }
    ts=$(date '+%F %T'); ts_ep=$(date +%s)
    echo "==> capturing snap $sid  ->  $dir"
    _awr_collect "$dir" || echo "  [WARN] collection reported errors (snap $sid kept)" >&2
    _awr_write_meta "$dir" "$sid" "$ts" "$ts_ep"
    echo "==> snap $sid captured at $ts"
    _awr_purge_expired
    return 0
}

# awr create -- manual single-point snapshot (foreground, no -d, no html).
_awr_create() {
    local root_override=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --root)    root_override="$2"; shift 2;;
            -h|--help) awr_help; return 0;;
            -d)        echo "Error: 'awr create' is a single-point snapshot (no -d). Use 'awr config interval <min>' + 'awr enable' for periodic capture." >&2; return 2;;
            --force)   echo "Error: --force not applicable to single-point snapshots" >&2; return 2;;
            *)         echo "Error: unexpected argument '$1' (awr create takes no name / no -d)" >&2; return 2;;
        esac
    done
    _awr_snap ${root_override:+--root "$root_override"}
}

# _awr_check_uptime <id1> <id2>  -- error+return 1 if the two snaps span a DB
# restart (cumulative counters reset; end-begin meaningless). db_start_time =
# pg_postmaster_start_time(). Lenient: skipped if either snap lacks the field.
_awr_check_uptime() {
    local id1="$1" id2="$2"
    local d1 d2 s1 s2
    command -v python3 >/dev/null 2>&1 || { echo "Error: python3 required for restart guard (cannot read meta.json)" >&2; return 1; }
    d1="$(_awr_root)/snap_$id1"; d2="$(_awr_root)/snap_$id2"
    s1=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('db_start_time',''))" "$d1/meta.json" 2>/dev/null)
    s2=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('db_start_time',''))" "$d2/meta.json" 2>/dev/null)
    if [ -n "$s1" ] && [ -n "$s2" ] && [ "$s1" != "$s2" ]; then
        echo "Error: DB restarted between snap $id1 and snap $id2 -- cumulative counters reset, no valid diff." >&2
        echo "       snap $id1 db_start_time: $s1" >&2
        echo "       snap $id2 db_start_time: $s2" >&2
        echo "       (pick snaps within the same DB uptime, or recreate after the restart)" >&2
        return 1
    fi
    return 0
}

# awr awrrpt begin <id> end <id>  -- render diff html between two snaps.
_awr_awrrpt() {
    local begin_id="" end_id=""
    while [ $# -gt 0 ]; do
        case "$1" in
            begin)     begin_id="$2"; shift 2;;
            end)       end_id="$2"; shift 2;;
            -h|--help) awr_help; return 0;;
            *)         echo "Error: unknown token '$1' (usage: awrrpt begin <id> end <id>)" >&2; return 2;;
        esac
    done
    if [ -z "$begin_id" ] || [ -z "$end_id" ]; then
        echo "Error: usage 'awr awrrpt begin <snap_id> end <snap_id>'" >&2; return 2
    fi
    local root; root=$(_awr_root)
    local bdir edir
    bdir="$root/snap_$begin_id"; edir="$root/snap_$end_id"
    if [ ! -d "$bdir" ]; then echo "Error: snap $begin_id not found ($bdir)" >&2; return 1; fi
    if [ ! -d "$edir" ]; then echo "Error: snap $end_id not found ($edir)" >&2; return 1; fi
    if [ "$begin_id" -gt "$end_id" ] 2>/dev/null; then
        echo "  [WARN] begin snap ($begin_id) is newer than end snap ($end_id); counters may go negative" >&2
    fi
    # restart guard (shared helper)
    _awr_check_uptime "$begin_id" "$end_id" || return 1
    echo "==> rendering awrrpt: snap $begin_id -> snap $end_id"
    _awr_render --begin "$bdir" --end "$edir" --repl-dir "$root" -m dbtime -n 30
}

# awr awrdiff begin <a> end <b> begin <c> end <d>
#   period1 = snap a->b, period2 = snap c->d. AWR-style 3-col diff report.
_awr_awrdiff() {
    local ids=()
    while [ $# -gt 0 ]; do
        case "$1" in
            begin|end) shift;;                      # delimiters; ids collected positionally
            -h|--help) awr_help; return 0;;
            -*)        echo "Error: unknown option '$1'" >&2; return 2;;
            *)         ids+=("$1"); shift;;
        esac
    done
    if [ "${#ids[@]}" -ne 4 ]; then
        echo "Error: usage 'awr awrdiff begin <a> end <b> begin <c> end <d>' (got ${#ids[@]} snap ids, need 4)" >&2
        return 2
    fi
    local p1b="${ids[0]}" p1e="${ids[1]}" p2b="${ids[2]}" p2e="${ids[3]}"
    local root; root=$(_awr_root)
    local d1b d1e d2b d2e
    d1b="$root/snap_$p1b"; d1e="$root/snap_$p1e"; d2b="$root/snap_$p2b"; d2e="$root/snap_$p2e"
    local d
    for d in "$d1b" "$d1e" "$d2b" "$d2e"; do
        [ -d "$d" ] || { echo "Error: snap dir not found: $d" >&2; return 1; }
    done
    # ordering warnings (non-fatal): begin>end or overlapping periods
    [ "$p1b" -gt "$p1e" ] 2>/dev/null && echo "  [WARN] period1 begin ($p1b) > end ($p1e); counters may go negative" >&2
    [ "$p2b" -gt "$p2e" ] 2>/dev/null && echo "  [WARN] period2 begin ($p2b) > end ($p2e); counters may go negative" >&2
    [ "$p1e" -gt "$p2b" ] 2>/dev/null && echo "  [WARN] period1 end ($p1e) > period2 begin ($p2b); periods overlap" >&2
    # restart guard PER PERIOD (each period's begin/end must be same uptime;
    # cross-period restart is allowed -- each period's delta is self-contained).
    _awr_check_uptime "$p1b" "$p1e" || return 1
    _awr_check_uptime "$p2b" "$p2e" || return 1
    echo "==> rendering awrdiff: period1 snap $p1b->$p1e  vs  period2 snap $p2b->$p2e"
    # no --repl-dir by design: one repl table can't cover two disjoint periods
    _awr_render --awrdiff "$d1b" "$d1e" "$d2b" "$d2e"
}

# awr enable -d N  -- install crontab entry: snapshot every N minutes (default 60).
# awr enable  -- install the periodic crontab entries. Takes NO options: the
# snapshot interval comes from 'awr config interval <min>' (<root>/interval,
# default 60); the replication sampler always runs every 1 minute.
_awr_enable() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) awr_help; return 0;;
            -d)        echo "Error: 'enable' takes no -d anymore -- set the interval via 'awr config interval <min>' (default 60)" >&2; return 2;;
            *)         echo "Error: unexpected argument '$1' (usage: enable)" >&2; return 2;;
        esac
    done
    command -v crontab >/dev/null 2>&1 || { echo "Error: crontab not found on PATH" >&2; return 1; }
    local port="${PGPORT:-5432}"
    local marker="# vb_tool_awr_p$port"
    local rmarker="# vb_tool_awr_repl_p$port"
    # Refuse to double-enable THIS port (other ports may run awr in parallel);
    # also refuse while legacy port-less entries from an older vb_tool are
    # still installed -- they follow the login profile's PGPORT and cannot be
    # attributed to any port.
    if crontab -l 2>/dev/null | grep -qF "$rmarker" || crontab -l 2>/dev/null | grep -qF "$marker"; then
        echo "Error: awr periodic capture is already ENABLED for port $port -- run 'awr disable' first" >&2
        echo "Current entries:" >&2
        crontab -l 2>/dev/null | grep -F '# vb_tool_awr' >&2
        return 2
    fi
    if crontab -l 2>/dev/null | grep -Eq '# vb_tool_awr(_repl)? *$'; then
        echo "Error: legacy awr crontab entries (older vb_tool, no port pinning) found --" >&2
        echo "       run 'awr disable' once to remove them, then re-enable" >&2
        return 2
    fi
    local mins; mins=$(_awr_interval_read)
    local self; self=$(readlink -f "$0" 2>/dev/null || echo "$0")
    # Wrap in `bash -lc` so cron's minimal env sources the user's login profile
    # (psql + PG* vars); PGPORT=<port> pins THIS instance so the entry keeps
    # capturing the same database even if the profile's PGPORT later changes.
    # '*/60' in the minute field draws a cron install warning (step > 59);
    # express 60 min as plain '0' (hourly at :00) instead
    local minspec="*/$mins"
    [ "$mins" -eq 60 ] && minspec="0"
    local entry="$minspec * * * * /bin/bash -lc 'PGPORT=$port $self awr create >/dev/null 2>&1'  $marker"
    local rentry="* * * * * /bin/bash -lc 'PGPORT=$port $self awr _repl-sample >/dev/null 2>&1'  $rmarker"
    ( crontab -l 2>/dev/null | grep -vF "$rmarker" | grep -vF "$marker"; echo "$rentry"; echo "$entry" ) | crontab -
    echo "awr enable: port $port, capturing a snapshot every ${mins}min (see 'awr config interval') + replication sample every 1min via crontab"
    echo "  $entry"
    echo "  $rentry"
    echo "  (run 'awr disable' to stop both; other ports keep their own entries)"
    _awr_purge_expired
    return 0
}

# awr disable  -- remove BOTH the periodic-snapshot and replication-sampler crontab entries.
# awr disable  -- remove the periodic crontab entries of THIS port (plus any
# legacy port-less ones from an older vb_tool). Other ports' entries stay.
_awr_disable() {
    local port="${PGPORT:-5432}"
    local removed=0
    if crontab -l 2>/dev/null | { grep -qF "# vb_tool_awr_p$port" || grep -qF "# vb_tool_awr_repl_p$port" || grep -Eq '# vb_tool_awr(_repl)? *$'; }; then
        crontab -l 2>/dev/null | grep -vF "# vb_tool_awr_repl_p$port" | grep -vF "# vb_tool_awr_p$port" \
            | grep -vE '# vb_tool_awr(_repl)? *$' | crontab -
        removed=1
    fi
    if [ "$removed" -eq 1 ]; then
        echo "awr disable: removed periodic snapshot + replication sampler crontab entries for port $port"
    else
        echo "awr disable: no periodic snapshot / sampler entries found for port $port (nothing to remove)"
    fi
    return 0
}

_awr_list() {
    local date_filter="$1"
    if [ -n "$date_filter" ] && ! printf '%s' "$date_filter" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; then
        echo "Error: invalid date '$date_filter' (expect YYYY-MM-DD)" >&2; return 2
    fi
    local root; root=$(_awr_root)
    if [ ! -d "$root" ]; then echo "(no snaps at $root)"; return 0; fi
    python3 - "$root" "$date_filter" <<'PY'
import json, os, sys, glob
root, date_filter = sys.argv[1], sys.argv[2]
rows = []
for d in glob.glob(os.path.join(root, "snap_*")):
    if not os.path.isdir(d): continue
    mp = os.path.join(d, "meta.json")
    try: m = json.load(open(mp)) if os.path.isfile(mp) else {}
    except Exception: m = {}
    sid = m.get("snap_id", os.path.basename(d).replace("snap_", ""))
    try: sid = int(sid)
    except Exception: pass
    rows.append((sid, m.get("ts", "?"), m.get("hostname", "?"), m.get("db_name", "?")))
if date_filter:
    rows = [r for r in rows if str(r[1])[:10] == date_filter]
# newest first: numeric snap_ids descending, non-numeric fallback ids last
rows = (sorted([r for r in rows if not isinstance(r[0], str)], key=lambda r: r[0], reverse=True)
        + sorted([r for r in rows if isinstance(r[0], str)]))
if not rows:
    print("(no snaps at %s%s)" % (root, (" on " + date_filter) if date_filter else "")); sys.exit()
total = len(rows)
if not date_filter and total > 30:
    rows = rows[:30]
print("%-8s %-20s %-14s %s" % ("SNAP_ID", "TS", "HOST", "DB"))
for r in rows: print("%-8s %-20s %-14s %s" % r)
if not date_filter and total > 30:
    print("(showing latest 30 of %d; 'vb_tool awr list YYYY-MM-DD' for a specific day)" % total)
PY
}

# awr show -- no arg: awr configuration overview (retention / interval /
# snapshot inventory). With <snap_id>: that snapshot's meta + collected files.
# awr show  -- standalone overview: run status (crontab entries when enabled),
# sampling interval, retention, oldest/newest snapshot, snapshot count.
# Absorbed the old 'awr status' (same markers disable removes).
_awr_show() {
    if [ $# -gt 0 ]; then
        echo "Error: usage 'awr show' (no arguments; per-snap files live under <root>/snap_<id>/)" >&2
        return 2
    fi
    local root; root=$(_awr_root)
    local days; days=$(_awr_retention_read)
    local mins; mins=$(_awr_interval_read)
    # run status: read the SAME per-port markers enable/disable use, so what
    # show reports is always consistent with what disable would remove; also
    # surface other ports that have awr enabled (multi-instance overview)
    local port="${PGPORT:-5432}"
    local snapent="" replent="" others=""
    if command -v crontab >/dev/null 2>&1; then
        local out; out=$(crontab -l 2>/dev/null)
        snapent=$(printf '%s\n' "$out" | grep -F "# vb_tool_awr_p$port")
        replent=$(printf '%s\n' "$out" | grep -F "# vb_tool_awr_repl_p$port")
        others=$(printf '%s\n' "$out" | grep -oE '# vb_tool_awr_p[0-9]+' | sed 's/# vb_tool_awr_p//' | sort -un | grep -vx "$port" | tr '\n' ' ')
    fi
    local nextid; nextid=$(cat "$root/sequence" 2>/dev/null)
    case "$nextid" in ''|*[!0-9]*) nextid=1;; esac
    # inventory: count + oldest/newest (ts-sorted, snap_id alongside)
    local inv="0"
    if [ -d "$root" ] && command -v python3 >/dev/null 2>&1; then
        inv=$(python3 - "$root" <<'PY' 2>/dev/null
import json, os, sys, glob
rows = []
for d in glob.glob(os.path.join(sys.argv[1], "snap_*")):
    mp = os.path.join(d, "meta.json")
    try: m = json.load(open(mp)) if os.path.isfile(mp) else {}
    except Exception: m = {}
    t = str(m.get("ts", ""))
    if not t: continue
    sid = m.get("snap_id", os.path.basename(d).replace("snap_", ""))
    rows.append((t, str(sid)))
rows.sort()
if not rows: print("0")
else: print("%d\t%s\t%s\t%s\t%s" % (len(rows), rows[0][1], rows[0][0], rows[-1][1], rows[-1][0]))
PY
)
    fi
    local n osid ots nsid nts
    n=$(printf '%s\n' "$inv" | head -1 | cut -f1)
    case "$n" in ''|*[!0-9]*) n=0;; esac
    osid=$(printf '%s\n' "$inv" | cut -f2); ots=$(printf '%s\n' "$inv" | cut -f3)
    nsid=$(printf '%s\n' "$inv" | cut -f4); nts=$(printf '%s\n' "$inv" | cut -f5)
    local oldest="-" newest="-"
    [ "$n" -gt 0 ] && oldest="$osid  ($ots)" && newest="$nsid  ($nts)"
    local purge="on (after every create / enable)"
    [ "$days" -eq 0 ] && purge="off (retention = 0, keep forever)"
    local rdesc="${days} day(s)"
    [ "$days" -eq 0 ] && rdesc="0 (never purge)"
    # last-snap freshness (shown only while ENABLED): with interval N min a snap
    # lands every ~N min, so anything older than N + 10 min slack means periodic
    # capture is not landing (script moved/renamed, crontab broken, DB down) --
    # the crontab entries would still SAY enabled, this line is the liveness tell
    local ageline=""
    if [ -n "$snapent" ] || [ -n "$replent" ]; then
        if [ "$n" -gt 0 ] && [ -n "$nts" ]; then
            local now_ep snap_ep age thr human
            now_ep=$(date +%s)
            snap_ep=$(date -d "$nts" +%s 2>/dev/null)
            if [ -n "$snap_ep" ] && [ -n "$now_ep" ]; then
                age=$(( now_ep - snap_ep )); [ "$age" -lt 0 ] && age=0
                thr=$(( mins * 60 + 600 ))
                if   [ "$age" -lt 90 ];    then human="${age} sec"
                elif [ "$age" -lt 7200 ];  then human="$(( age / 60 )) min"
                elif [ "$age" -lt 172800 ]; then human="$(( age / 3600 )) hour(s)"
                else human="$(( age / 86400 )) day(s)"; fi
                if [ "$age" -le "$thr" ]; then
                    ageline="last snap age : ${human} (ok)"
                else
                    ageline="last snap age : ${human} (STALE -- periodic capture not landing; check script path, crontab and DB)"
                fi
            fi
        else
            ageline="last snap age : (no snapshots yet; first cron capture lands within ${mins} min of enable)"
        fi
    fi
    echo "==> awr show"
    if [ -z "$snapent" ] && [ -z "$replent" ]; then
        echo "status        : DISABLED (no periodic snapshot / sampler crontab entries for port $port)"
    else
        echo "status        : ENABLED"
        if [ -n "$snapent" ]; then echo "  snapshot:          $snapent"
        else echo "  snapshot:          (entry missing -- re-run 'awr enable' to fix)"; fi
        if [ -n "$replent" ]; then echo "  replication sampler: $replent"
        else echo "  replication sampler: (entry missing -- re-run 'awr enable' to fix)"; fi
        [ -n "$ageline" ] && echo "$ageline"
    fi
    [ -n "$others" ] && echo "other ports   : awr also enabled on: $others"
    cat <<EOF
port           : $port
interval      : ${mins} min
retention     : $rdesc
auto-purge    : $purge
oldest snap   : $oldest
newest snap   : $newest
snapshots     : $n
next snap_id  : $nextid
EOF
    return 0
}

# _awr_purge_core <until_ep>  -- delete everything older than <until_ep> (epoch):
# snaps (by meta ts), repl_/slot_ logs (by whole day), html reports (by mtime).
# Echoes "S R H" (the three counts) on stdout; WARNs on unparseable items go to
# stderr. Shared by 'awr delete until' and the retention auto-purge so both
# paths always delete exactly the same set of things.
_awr_purge_core() {
    local until_ep="$1"
    local root; root=$(_awr_root)
    local scount=0
    if [ -d "$root" ] && command -v python3 >/dev/null 2>&1; then
        # one python pass reads every meta.json (a per-dir python spawn, like
        # the old loop, would cost ~30ms x N snaps on EVERY periodic create)
        local expired
        expired=$(python3 - "$root" "$until_ep" <<'PY'
import json, os, sys, glob, time
root, until_ep = sys.argv[1], int(sys.argv[2])
for d in sorted(glob.glob(os.path.join(root, "snap_*"))):
    if not os.path.isdir(d): continue
    ts = ""
    try:
        mp = os.path.join(d, "meta.json")
        if os.path.isfile(mp): ts = str(json.load(open(mp)).get("ts", ""))
    except Exception:
        ts = ""
    try:
        tep = int(time.mktime(time.strptime(ts, "%Y-%m-%d %H:%M:%S")))
    except ValueError:
        print("WARN snap %s has unparseable ts %r, skipped" % (os.path.basename(d), ts), file=sys.stderr)
        continue
    if tep < until_ep:
        print(d)
PY
)
        local d
        while IFS= read -r d; do
            [ -n "$d" ] || continue
            rm -rf "$d" 2>/dev/null && scount=$((scount+1))
        done <<< "$expired"
    elif [ -d "$root" ]; then
        echo "  [WARN] python3 not found -- snap expiry scan skipped" >&2
    fi
    # repl_/slot_<YYYYMMDD>.log: delete only when the WHOLE day is before until
    local rcount=0 rf rd d_ep
    for rf in "$root"/repl_*.log "$root"/slot_*.log; do
        [ -f "$rf" ] || continue
        rd=$(basename "$rf" .log); rd="${rd#repl_}"; rd="${rd#slot_}"
        case "$rd" in
            [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])
                d_ep=$(date -d "${rd:0:4}-${rd:4:2}-${rd:6:2}" +%s 2>/dev/null)
                if [ -n "$d_ep" ] && [ $((d_ep + 86399)) -lt "$until_ep" ]; then
                    rm -f "$rf"; rcount=$((rcount+1))
                fi;;
            *) echo "  [WARN] unrecognized repl log '$rf', skipped" >&2;;
        esac
    done
    local hcount=0 f mep
    for f in "${VB_TOOL_HOME:-$HOME/.vb_tool}"/awr_reports/awr_*.html \
             "${VB_TOOL_HOME:-$HOME/.vb_tool}"/awr_reports/awrdiff_*.html; do
        [ -f "$f" ] || continue
        mep=$(stat -c %Y "$f" 2>/dev/null)
        if [ -n "$mep" ] && [ "$mep" -lt "$until_ep" ]; then
            rm -f "$f"; hcount=$((hcount+1))
        fi
    done
    echo "$scount $rcount $hcount"
}

# awr delete until <time>  -- manual one-shot purge (thin wrapper over the core).
_awr_delete_until() {
    local until_time="$1"
    if [ -z "$until_time" ]; then
        echo "Error: usage 'awr delete until <time>' (e.g. '2026-08-11' or '2026-08-11 12:00:00')" >&2
        return 2
    fi
    local until_ep
    until_ep=$(date -d "$until_time" +%s 2>/dev/null)
    if [ -z "$until_ep" ]; then echo "Error: invalid time '$until_time'" >&2; return 2; fi
    local counts
    counts=$(_awr_purge_core "$until_ep")
    set -- $counts
    echo "deleted $1 snap(s) (by ts), $2 repl/slot log(s) (by day), and $3 html report(s) (by mtime) older than $until_time"
    return 0
}

# _awr_retention_read  -> retention days from <root>/retention (default 30 when
# absent/garbage; 0 = keep forever). Echoed on stdout.
_awr_retention_read() {
    local root; root=$(_awr_root)
    local v
    v=$(cat "$root/retention" 2>/dev/null)
    case "$v" in ''|*[!0-9]*) v=30;; esac
    echo "$v"
}

# _awr_purge_expired  -- retention auto-purge (Oracle MMON style): delete snaps
# / repl+slot logs / html reports older than now - <retention> days. Prints ONE
# summary line only when something was actually removed (silent otherwise, so
# periodic 'awr create' output stays clean; WARN noise also suppressed).
# Runs after every successful create, after 'awr enable', and after
# 'awr config retention N' (N > 0).
_awr_purge_expired() {
    local days; days=$(_awr_retention_read)
    [ "$days" -eq 0 ] && return 0
    local cutoff_ep
    cutoff_ep=$(date -d "-$days days" +%s 2>/dev/null)
    [ -z "$cutoff_ep" ] && return 0
    local counts
    counts=$(_awr_purge_core "$cutoff_ep" 2>/dev/null)
    set -- $counts
    [ "$1" -eq 0 ] && [ "$2" -eq 0 ] && [ "$3" -eq 0 ] && return 0
    echo "awr auto-purge (retention ${days}d): removed $1 snap(s), $2 repl/slot log(s), $3 html report(s) older than $(date -d "@$cutoff_ep" '+%F %T' 2>/dev/null)"
    return 0
}

# _awr_interval_read  -> sampling interval minutes from <root>/interval
# (default 60 when absent/garbage). Echoed on stdout.
_awr_interval_read() {
    local root; root=$(_awr_root)
    local v
    v=$(cat "$root/interval" 2>/dev/null)
    case "$v" in ''|*[!0-9]*) v=60;; esac
    echo "$v"
}

# awr config <retention|interval> <value>  -- modify awr settings:
#   retention <days>  0 = keep forever (max 3650); purges already-expired
#                     snaps/repl+slot logs/html reports immediately
#   interval  <min>   1-60 (cron minute-field limit); when periodic capture is
#                     enabled the crontab entry is rewritten on the spot, so
#                     the new interval takes effect without disable/enable
# No args: print current values + usage.
_awr_config() {
    local root; root=$(_awr_root)
    local what="${1:-}"
    if [ -z "$what" ]; then
        local r i
        r=$(_awr_retention_read); i=$(_awr_interval_read)
        echo "awr config:"
        if [ "$r" -eq 0 ]; then echo "  retention : 0 (never purge)"
        else echo "  retention : ${r} day(s)"; fi
        echo "  interval  : ${i} min"
        echo "usage: vb_tool awr config retention <days>   (0 = never purge, max 3650)"
        echo "       vb_tool awr config interval <min>     (1-60)"
        return 0
    fi
    local val="${2:-}"
    [ -z "$val" ] && { echo "Error: usage 'awr config $what <value>'" >&2; return 2; }
    shift 2
    [ $# -gt 0 ] && { echo "Error: unexpected argument '$1'" >&2; return 2; }
    case "$what" in
        retention)
            case "$val" in ''|*[!0-9]*) echo "Error: retention expects a non-negative integer number of days (0 = never purge)" >&2; return 2;; esac
            [ "$val" -gt 3650 ] && { echo "Error: retention too large (max 3650 days); use 0 for keep-forever" >&2; return 2; }
            local old; old=$(_awr_retention_read)
            mkdir -p "$root" 2>/dev/null || { echo "Error: cannot create $root" >&2; return 1; }
            echo "$val" > "$root/retention" || { echo "Error: cannot write $root/retention" >&2; return 1; }
            if [ "$val" -eq 0 ]; then
                echo "awr config: retention ${old} -> 0 (never purge)"
                return 0
            fi
            echo "awr config: retention ${old} -> ${val} day(s)"
            _awr_purge_expired
            return 0
            ;;
        interval)
            case "$val" in ''|*[!0-9]*) echo "Error: interval expects a positive integer number of minutes (1-60)" >&2; return 2;; esac
            if [ "$val" -lt 1 ] || [ "$val" -gt 60 ]; then
                echo "Error: interval must be 1-60 minutes (cron minute-field limit; longer intervals: edit crontab manually)" >&2
                return 2
            fi
            local oldi; oldi=$(_awr_interval_read)
            mkdir -p "$root" 2>/dev/null || { echo "Error: cannot create $root" >&2; return 1; }
            echo "$val" > "$root/interval" || { echo "Error: cannot write $root/interval" >&2; return 1; }
            echo "awr config: interval ${oldi} -> ${val} min"
            # take effect immediately when already enabled: rewrite THIS port's
            # entries (same generator as enable; keeps sampler entry and other
            # ports' entries, heals half-open)
            local cport="${PGPORT:-5432}"
            if crontab -l 2>/dev/null | grep -qF "# vb_tool_awr_repl_p$cport" || \
               crontab -l 2>/dev/null | grep -qF "# vb_tool_awr_p$cport"; then
                local self; self=$(readlink -f "$0" 2>/dev/null || echo "$0")
                local minspec="*/$val"
                [ "$val" -eq 60 ] && minspec="0"
                local entry="$minspec * * * * /bin/bash -lc 'PGPORT=$cport $self awr create >/dev/null 2>&1'  # vb_tool_awr_p$cport"
                local rentry="* * * * * /bin/bash -lc 'PGPORT=$cport $self awr _repl-sample >/dev/null 2>&1'  # vb_tool_awr_repl_p$cport"
                ( crontab -l 2>/dev/null | grep -vF "# vb_tool_awr_repl_p$cport" | grep -vF "# vb_tool_awr_p$cport"; echo "$rentry"; echo "$entry" ) | crontab -
                echo "awr config: periodic capture is ENABLED on port $cport -- crontab entry rewritten to every ${val}min"
                echo "  $entry"
            fi
            return 0
            ;;
        *)
            echo "Error: unknown config key '$what' (expect retention | interval)" >&2
            return 2;;
    esac
}

run_awr() {
    local sub="$1"
    if [ -z "$sub" ]; then awr_help; return 0; fi
    shift
    case "$sub" in
        _repl-sample)   _awr_repl_sample;;   # internal: cron per-minute sampler (not in help)
        create)         _awr_create "$@";;
        enable)         _awr_enable "$@";;
        disable)        _awr_disable;;
        awrrpt)         _awr_awrrpt "$@";;
        awrdiff)        _awr_awrdiff "$@";;
        list|ls)        _awr_list "$1";;
        show)           _awr_show "$@";;
        delete)         if [ "$1" = "until" ]; then _awr_delete_until "$2";
                        else echo "Error: usage 'vb_tool awr delete until <time>' (e.g. '2026-08-11')" >&2; return 2; fi;;
        config)         _awr_config "$@";;
        -h|--help|help) awr_help; return 0;;
        *) echo "Error: unknown awr subcommand '$sub'" >&2; awr_help; return 1;;
    esac
}
