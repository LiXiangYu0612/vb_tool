                        printf "%s[vbtop]%s %s%s%s  %s│%s  %sLinux %s%s  %s│%s  %s%s%s\n" \
                            "$c_sec" "$c_off" "$c_grn" "$h_node" "$c_off" \
                            "$c_lbl" "$c_off" "$c_blu" "$kver" "$c_off" \
                            "$c_lbl" "$c_off" "$c_grn" "$h_ver" "$c_off"
                        # line 2 is deliberately quieter: dim-cyan names + plain values,
