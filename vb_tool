analyze_log_v2_help() {
    echo "Options for analyze_log_v2:"
    echo "  Usage: vb_tool analyze_log_v2 -f <file> [-b <begin>] [-e <end>] [--diff <interval>]"
    echo "         [-p <prefix>] [-d <days>] [-v] [-m <mode>] [-o <output>]"
    echo "  Description: analyze database logs (slow queries) output html report (enhanced version)"
    echo "  -P <port>: database port (default: current \$PGPORT)"
    echo "  Options:"
    echo "    -f: log file name (supports multiple files and wildcards; if omitted, auto-detect from database, analyze last 2 days)"
    echo "    -b: start time (optional, format: 'YYYY-MM-DD HH:MM:SS' or 'YYYY-MM-DD')"
    echo "    -e: end time (optional, format: 'YYYY-MM-DD HH:MM:SS' or 'YYYY-MM-DD')"
    echo "    --diff: compare interval (30m, 1h, 1d, default: 1d)"
    echo "    -p: log line prefix format (optional, auto-detect from database)"
    echo "    -d: analyze last N days of logs (default: 2)"
    echo "    -v: show version"
    echo "    -m/--mode: analysis scope (query|error|all, default: query)"
    echo "         query: analyze SQL statements (DML+DDL), no error logs"
    echo "         error: analyze error logs only (ERROR/WARNING/FATAL/PANIC), no SQL"
    echo "         all:   analyze everything (SQL + error logs)"
    echo "    -o: output HTML report file path (optional, default: hostname + timestamp + mode)"
    echo "    --debug: enable debug output"
    echo ""
    echo "  Examples:"
    echo "    vb_tool analyze_log_v2 -f /path/to/postgresql-2025-01-01.log"
    echo "    vb_tool analyze_log_v2 -f /path/to/log1.log /path/to/log2.log"
    echo "    vb_tool analyze_log_v2 -f /path/to/*.log"
    echo "    vb_tool analyze_log_v2 -f /path/to/log.log -o /path/to/my_report.html"
    echo "    vb_tool analyze_log_v2 -f /path/to/log.log -b \"2025-01-01 00:00:00\" -e \"2025-01-02 23:59:59\""
    echo "    vb_tool analyze_log_v2 -f /path/to/log.log -p \"%m %u %d %r %p %S [%x]\""
    echo "    vb_tool analyze_log_v2 -f /path/to/log.log --diff 1d"
    echo "    vb_tool analyze_log_v2 -f /path/to/log.log --diff 1h"
    echo "    vb_tool analyze_log_v2 -f /path/to/log.log --diff 30m"
    echo "    vb_tool analyze_log_v2"
    echo "    vb_tool analyze_log_v2 -d 3"
    echo "    vb_tool analyze_log_v2 --days 30"
    echo "    vb_tool analyze_log_v2 -v"
    echo "    vb_tool analyze_log_v2 -f /path/to/log.log -m query"
    echo "    vb_tool analyze_log_v2 -f /path/to/log.log -m error"
    echo "    vb_tool analyze_log_v2 -f /path/to/log.log -m all"
    echo "    vb_tool analyze_log_v2 -f /path/to/log.log -o /path/to/report.html"
    echo ""
}

