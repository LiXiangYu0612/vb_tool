                    # 一行 "===EOD" 的假 TOPSQL。
                    ===EOD)  section=EOD; continue;;
                    ===MEMSES)
                        # header line 1: three identities separated by │, coloured by
                        # MEANING rather than decoration -- the whole point is that
                        # the header stops reading as one flat hue (user's call
                        # 2026-09-26: "感觉都一样颜色不好看", then "从UI角度去选颜色").
                        #   cyan  = the TOOL / structure  -> [vbtop]  (matches [CPU])
                        #   green = the DATABASE           -> node name + version
                        #   blue  = the HOST / OS layer    -> "Linux <kernel>"
                        # Cyan/green/blue are also far from the alarm pair (red /
                        # yellow), so no header token can be mistaken for a warning.
                        printf "%s[vbtop]%s %s%s%s  %s│%s  %sLinux %s%s  %s│%s  %s%s%s\n" \
                            "$c_sec" "$c_off" "$c_grn" "$h_node" "$c_off" \
                            "$c_lbl" "$c_off" "$c_blu" "$kver" "$c_off" \
                            "$c_lbl" "$c_off" "$c_grn" "$h_ver" "$c_off"
                        # line 2 is deliberately quieter: dim-cyan names + plain values,
                        # so it does not compete with the identity line above. The one
                        # exception is the DB PORT -- it is a database fact (green),
                        # the number you actually check when several instances are up.
                        printf "${c_lbl}port${c_off} ${c_grn}%s${c_off}   ${c_lbl}up${c_off} %s   %s\n" \
                            "${PGPORT:-5432}" \
                            "$(awk -v s="$h_up" 'BEGIN{printf "%dd%02dh%02dm", int(s/86400), int(s%86400/3600), int(s%3600/60)}')" \
                            "$cores"
                        _vtop_print_os
                        _vtop_sec "VASTBASE Statistics ($(date '+%T'))"
                        if [ -n "$s_tot" ]; then
                            # Two layers (labels above values) like the OS block, and
                            # FULL names instead of tot/act/idl/idtx/ltx60 (user's
                            # call 2026-09-26: "SESS 后面的指标弄全称 也是分两行吧
                            # total_sess active_sess 这样 LTX60 写 longtx_60s").
                            # The "^" marker keeps the old "long transaction present"
                            # alarm on the VALUE only. _vtop_lv owns the colour so the
                            # column widths stay honest (see the marker comment there).
                            _vtop_lv SESS "" \
                                "total_sess|$s_tot" "active|$s_act" \
                                "idle|$s_idle" "idle_tx|$s_iit" \
                                "longtx_60s^|$s_ltx" \
                                "autovac_workers|$s_avac" \
                                "smp_workers|$s_smp" \
                                "jdbc_workers|$s_jdbc"
                        fi
                        if [ -n "$ltx_raw" ]; then
                            printf "${c_sec}[LTX]${c_off}      ${c_lbl}%-10s %-11s %-14s %-9s %-9s %-8s %-8s %-19s %s${c_off}\n" "active_ltx" "idle_tx_ltx" "sid" "user" "db" "state" "xact_age" "event" "sqltext"
                            local l_sid l_usr l_db l_st l_age l_we l_sql l_ah
                            while IFS='|' read -r l_sid l_usr l_db l_st l_age l_we l_sql; do
                                [ -z "$l_sid" ] && continue
                                l_ah=$(awk -v x="$l_age" 'BEGIN{s=x;d=int(s/86400);h=int(s%86400/3600);m=int(s%3600/60);ss=s%60; if(d>0)printf "%dd%02dh",d,h; else if(h>0)printf "%dh%02dm",h,m; else printf "%dm%02ds",m,ss}')
                                printf '%s' "$c_red"
                                printf '           %-10s %-11s %-14.14s %-9.9s %-9.9s %-8.8s %-8s %-19.19s %.40s\n' "${ltxc_a:-0}" "${ltxc_i:-0}" "$l_sid" "$l_usr" "$l_db" "$l_st" "$l_ah" "$l_we" "$l_sql"
                                printf '%s' "$c_off"
                            done <<< "$ltx_raw"
                        else
                            # empty: keep the header visible and put a "-" under every
                            # column (user's call 2026-09-26 -- no bare "none"; the column
                            # structure should always be readable)
                            printf "${c_sec}[LTX]${c_off}      ${c_lbl}%-10s %-11s %-14s %-9s %-9s %-8s %-8s %-19s %s${c_off}\n" "active_ltx" "idle_tx_ltx" "sid" "user" "db" "state" "xact_age" "event" "sqltext"
                            printf '           %-10s %-11s %-14.14s %-9.9s %-9.9s %-8.8s %-8s %-19.19s %.40s\n' "${ltxc_a:-0}" "${ltxc_i:-0}" "-" "-" "-" "-" "-" "-" "-"
                        fi
                        _vtop_lv ISTAT "" \
                            "tps|${ist_tps:--}" "qps|${ist_qps:--}" "commit/s|${ist_cm:--}" "rollback/s|${ist_roll:--}" \
                            "deadlocks/s|${ist_dl:--}" \
                            "logical_read/s|${ist_lg:--}" "physical_read/s|${ist_ph:--}" \
                            "pagewrite/s|${ist_pw:--}" \
                            "redo/s|${ist_rd:--}" "temp_byte/s|${ist_tp:--}"
                        # ★[WAIT] sits right under [ISTAT] (user's call 2026-09-26, moved
                        # here from the first idea of under-[REPL]): active-session
                        # wait-event classes. on_cpu = active AND (event IS NULL OR
                        # 'none'); wait_status = STATUS class minus 'none' (gtm /
                        # wait cmd / Sort、HashAgg 算子态). ★the five sum EXACTLY to
                        # active_sess: every event falls in exactly one of the four
                        # classes (204-verified), none/null -> on_cpu.
                        _vtop_lv WAIT "" \
                            "wait_io|${w_io:--}" "wait_lock|${w_lock:--}" \
                            "wait_lwlock|${w_lwlock:--}" "wait_status|${w_stat:--}" \
                            "on_cpu|${w_cpu:--}"
            # ★[XLOG] 取代原 [TOPEVENT](user's call 2026-09-26)，字段参照 vb_tool xloghc；
            # 数值已在 204 上与 xloghc 逐字段对账一致（ckpt_redo/ckpt_lsn/total_count/total_size 全等）。
            _vtop_lv XLOG "" \
                "curr_redo_lsn|${x_cur:--}" "oldest_xlog_lsn|${x_old:--}" \
                "ckpt_redo_lsn|${x_ckr:--}" \
                "cbm_tracked_lsn|${x_cbm:--}" "min_restart_lsn|${x_rest:--}" \
                "min_need_archive|${x_arch:--}" \
                "total_count|${x_cnt:--}" "total_size|${x_sz:--}"
            # ★[REPL] 与 awr 的 Replication Stat 同源同字段(pg_stat_replication);
            # sync_state 即是不是 sync 的那个；四个 lag 即 awr 的 net/fsync/apply/total(字节)。
            _vtop_lv REPL "" \
                "standby|${r_app:--}" "state|${r_state:--}" "sync_state|${r_sync:--}" "slot_status|${r_slot:--}" \
                "sent/s|$( [ -n "$r_dsent" ] && _vtop_fmt_b "$r_dsent" || echo - )" \
                "write/s|$( [ -n "$r_dwr" ] && _vtop_fmt_b "$r_dwr" || echo - )" \
                "flush/s|$( [ -n "$r_dfl" ] && _vtop_fmt_b "$r_dfl" || echo - )" \
                "replay/s|$( [ -n "$r_drp" ] && _vtop_fmt_b "$r_drp" || echo - )" \
                "net_lag|$( [ -n "$r_net" ] && _vtop_fmt_b "$r_net" || echo - )" \
                "fsync_lag|$( [ -n "$r_fs" ] && _vtop_fmt_b "$r_fs" || echo - )" \
                "apply_lag|$( [ -n "$r_ap" ] && _vtop_fmt_b "$r_ap" || echo - )" \
                "total_lag|$( [ -n "$r_tot" ] && _vtop_fmt_b "$r_tot" || echo - )"
                        local mem_col=""
                        if awk -v p="$m_used" -v m="$m_max" -v y="$m_dyu" -v n="$m_dym" 'BEGIN{exit !((m>0 && p/m*100>=90) || (n>0 && y/n*100>=90))}'; then mem_col=$c_red
                        elif awk -v p="$m_used" -v m="$m_max" 'BEGIN{exit !(m>0 && p/m*100>=75)}'; then mem_col=$c_ylw; fi
                        if [ -n "$m_used" ]; then
                            printf '%s' "$mem_col"
                            # one column per MONITOR ITEM (user's call 2026-09-26), named after
                            # the dbe_perf.memory_node_detail memorytype it comes from:
                            #   max_process_memory / process_used_memory / dynamic_used_memory /
                            #   dynamic_peak_memory / dynamic_used_shrctx
                            # one column per monitor item; label <- memorytype of
                            # gs_total_memory_detail / dbe_perf.memory_node_detail:
                            #   proc_max    <- max_process_memory       proc_used  <- process_used_memory
                            #   shared_max  <- max_shared_memory        shared_used <- shared_used_memory
                            #   dyn_used    <- dynamic_used_memory      dyn_max    <- max_dynamic_memory
                            #   dyn_peak    <- dynamic_peak_memory      shrctx_used  <- dynamic_used_shrctx
                            #   shrctx_peak <- dynamic_peak_shrctx      other_used   <- other_used_memory
                            # ★abbreviated on purpose (user's call 2026-09-26): the full names would
                            # blow past the 147-column box; this form is 121.
                            _vtop_lv DBMEM "" \
                                "proc_max|${m_max}G" \
                                "proc_used|${m_used}G" \
                                "shared_max|${m_shmax}G" \
                                "shared_used|${m_shused}G" \
                                "dyn_used|${m_dyu}G" \
                                "dyn_max|${m_dym}G" \
                                "dyn_peak|${m_dyp}G" \
                                "shrctx_used|${m_shr}G" \
                                "shrctx_peak|${m_shrp}G" \
                                "other_used|${m_other}G" \
                                "shared_buffers|${m_sbuf:--}"
                            printf '%s' "$c_off"
                        fi
                        if [ -n "$ctx_txt" ]; then
                            local _ctx
                            IFS=';' read -r -a _ctx <<< "$ctx_txt"
                            _vtop_lv MEMCTX "" "${_ctx[@]}"
                        fi
                        printf "${c_sec}[TOPMEM]${c_off}   ${c_lbl}%-14s %-22s %-8s %-9s %s${c_off}\n" "sid" "sesstype" "state" "mem" "sqltext"
                        section=MEMSES; continue;;
                    ===TOP)
                        # TOPMEM had no rows this frame -> give it its "-" row now, because
                        # the TOPSQL header is about to be printed (rows must stay in order).
                        [ "${n_mem:-0}" -eq 0 ] && # ★sesstype 20->22 (+2) 与 sqltext 64->62 (-2) 是一对 (用户 2026-09-28 拍板):
#   这一行本来就**正好占满框内 148 列**, 所以加宽必须同步缩 sqltext, 否则顶破框。
#   加宽的原因: 204 上真实存在 21/22 字符的 sesstype (Vector Buffer Manager /
#   Statement flush thread), 老写法 %-20.20s 会把它们截成 Vector Buffer Manag /
#   Statement flush thr —— 一旦进 top-N 就会被看见。现在 %-22s 不带精度, 再长就撑宽。
printf '           %-14s %-22s %-8.8s %-9s %.62s\n' "-" "-" "-" "-" "-"
                        # ★column set + order (user's call 2026-09-26): sqlid | running_threads
                        # | cpu_usage% | total_time(s) | sqltext -- run/tot was split apart:
                        # only the running-thread count survives (labeled in full) and it
                        # moved in front of the cpu column; "tot" is gone entirely and
                        # et(s) is now spelled total_time(s).
                        # ★widths: the row must stay inside the 147-column frame (TOPSQL was
                        # already the widest line at 146 with sqltext 100) -- the two longer
                        # labels cost +8 columns, so sqltext gives 18 back (100 -> 82).
                        printf "${c_sec}[TOPSQL]${c_off}   ${c_lbl}%-11s %-15s %-10s %-13s %s${c_off}\n" "sqlid" "running_threads" "cpu_usage%" "total_time(s)" "sqltext"
                        section=TOP; continue;;
                esac
                case "$section" in
                    HDR)  IFS='|' read -r h_node h_ver h_up <<< "$line";;
                    SESS) IFS='|' read -r s_tot s_act s_iit s_idle s_ltx s_avac s_smp s_jdbc <<< "$line";;
                    ISTAT) IFS='|' read -r i_xc i_xr i_br i_bh i_tb i_lsn i_nc i_pw i_dl <<< "$line"
                          # ★本段窗口 = prev_ist_ms(本段基线盖章)→本帧, 与子屏 ist_dt 同构;
                          # 过期规则统一走 _vtop_lim_ms (2026-11-16): 窗口超阈 ⇒ 当无基线
                          # (断库/断网恢复帧不许拿断档均值冒充 /s, 也不许旧 dbdt 那样
                          # N 倍虚高); q=2 = 帧级 12s 截止 + 截止前起跑的段再吃满自身
                          # 12s 的最坏帧墙钟, 慢库正常帧不许误判过期。
                          ist_w=0
                          [ "$prev_ist_ms" -gt 0 ] && [ "$t1" -gt "$prev_ist_ms" ] && ist_w=$(( t1 - prev_ist_ms ))
