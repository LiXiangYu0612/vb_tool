            <!-- 内联JavaScript -->
            <script>
                // 图表数据
                const chartData = {chart_js_data_json};

                const connectionChartData = document.getElementById('connection-line-data')
                    ? JSON.parse(document.getElementById('connection-line-data').textContent) : null;
                const connectionDrillData = document.getElementById('connection-data')
                    ? JSON.parse(document.getElementById('connection-data').textContent) : null;

                let connectionVisibleCount = 10;
                let connectionCurrentSources = [];

                function refreshConnectionRows() {{
                    const tbody = document.querySelector('#connection-drill-table tbody');
                    tbody.replaceChildren();
                    connectionCurrentSources.forEach((source, index) => {{
                        const row = document.createElement('tr');
                        if (index >= connectionVisibleCount) row.hidden = true;
                        [source.ip, source.success, source.failed, source.total].forEach(value => {{
                            const cell = document.createElement('td');
                            cell.textContent = value;
                            row.appendChild(cell);
                        }});
                        tbody.appendChild(row);
                    }});
                    const remaining = Math.max(0, connectionCurrentSources.length - connectionVisibleCount);
                    const container = document.getElementById('connection-expand-container');
                    container.hidden = connectionCurrentSources.length <= 10;
                    const loadButton = document.getElementById('connection-expand-btn');
                    loadButton.hidden = remaining === 0;
                    loadButton.textContent = `加载更多 (剩余 ${{remaining}} 行)`;
                    const allButton = document.getElementById('connection-expand-all-btn');
                    allButton.querySelector('.expand-text').style.display = remaining > 0 ? '' : 'none';
                    allButton.querySelector('.collapse-text').style.display = remaining > 0 ? 'none' : '';
                }}

                function loadMoreConnectionRows() {{
                    connectionVisibleCount = Math.min(connectionCurrentSources.length, connectionVisibleCount + 10);
                    refreshConnectionRows();
                }}

                function toggleAllConnectionRows() {{
                    connectionVisibleCount = connectionVisibleCount < connectionCurrentSources.length ? connectionCurrentSources.length : 10;
                    refreshConnectionRows();
                }}

                function renderConnectionUserChart(users) {{
                    const container = document.getElementById('connection-user-chart');
                    container.replaceChildren();
                    if (!users.length) return;
                    const groupWidth = 90;
                    const width = Math.max(400, users.length * groupWidth + 70);
                    const height = 380;
                    const margin = {{top: 20, right: 15, bottom: 58, left: 45}};
                    const chartHeight = height - margin.top - margin.bottom;
                    const maxValue = Math.max(1, ...users.map(user => Math.max(user.success, user.failed)));
                    const y = value => margin.top + chartHeight - value * chartHeight / maxValue;
                    const svgNS = 'http://www.w3.org/2000/svg';
                    const svg = document.createElementNS(svgNS, 'svg');
                    svg.setAttribute('viewBox', `0 0 ${{width}} ${{height}}`);
                    svg.setAttribute('width', width);
                    svg.setAttribute('height', height);
                    function add(tag, attrs, text) {{
                        const element = document.createElementNS(svgNS, tag);
                        Object.entries(attrs).forEach(([key, value]) => element.setAttribute(key, value));
                        if (text !== undefined) element.textContent = text;
                        svg.appendChild(element);
                        return element;
                    }}
                    for (let tick = 0; tick <= 5; tick++) {{
                        const value = Math.ceil(maxValue * tick / 5);
                        const tickY = y(value);
                        add('line', {{x1: margin.left, y1: tickY, x2: width - margin.right, y2: tickY, stroke: '#e5e8e8'}});
                        add('text', {{x: margin.left - 7, y: tickY + 4, 'text-anchor': 'end', 'font-size': 11, fill: '#666'}}, value);
                    }}
                    users.forEach((user, index) => {{
                        const groupX = margin.left + index * groupWidth + 10;
                        [
                            {{key: 'success', color: '#27ae60', x: groupX}},
                            {{key: 'failed', color: '#e74c3c', x: groupX + 32}}
                        ].forEach(bar => {{
                            const barHeight = user[bar.key] * chartHeight / maxValue;
                            const rect = add('rect', {{x: bar.x, y: y(user[bar.key]), width: 26, height: barHeight, fill: bar.color}});
                            const title = document.createElementNS(svgNS, 'title');
                            title.textContent = `${{user.user}} ${{bar.key === 'success' ? '成功' : '失败'}}：${{user[bar.key]}}`;
                            if (bar.key === 'failed') {{
                                Object.entries(user.failure_types || {{}}).forEach(([type, count]) => {{
                                    title.textContent += `\n${{type}}：${{count}}`;
                                }});
                            }}
                            rect.appendChild(title);
                        }});
                        add('text', {{x: groupX + 29, y: height - 35, 'text-anchor': 'middle', 'font-size': 11, fill: '#333'}}, user.user);
                    }});
                    container.appendChild(svg);
                }}

                function aggregateConnectionRange(startIndex, endIndex) {{
                    const sources = new Map();
                    const users = new Map();
                    let total = 0;
                    function accumulate(target, keyField, item) {{
                        if (!target.has(item[keyField])) {{
                            target.set(item[keyField], {{[keyField]: item[keyField], success: 0, failed: 0, total: 0}});
                        }}
                        const counts = target.get(item[keyField]);
                        counts.success += item.success;
                        counts.failed += item.failed;
                        counts.total += item.total;
                        if (keyField === 'user') {{
                            counts.failure_types = counts.failure_types || {{}};
                            Object.entries(item.failure_types || {{}}).forEach(([type, count]) => {{
                                counts.failure_types[type] = (counts.failure_types[type] || 0) + count;
                            }});
                        }}
                    }}
                    connectionDrillData.minutes.slice(startIndex, endIndex + 1).forEach(minute => {{
                        total += minute.total;
                        minute.sources.forEach(source => accumulate(sources, 'ip', source));
                        (minute.users || []).forEach(user => accumulate(users, 'user', user));
                    }});
                    const byTotalDesc = key => (a, b) => b.total - a.total || a[key].localeCompare(b[key]);
                    return {{
                        total,
                        sources: [...sources.values()].sort(byTotalDesc('ip')),
                        users: [...users.values()].sort(byTotalDesc('user'))
                    }};
                }}

                function refreshConnectionSummary(startIndex, endIndex, singleMinute) {{
                    if (!connectionDrillData || !connectionDrillData.minutes.length) return;
                    const summary = aggregateConnectionRange(startIndex, endIndex);
                    const title = singleMinute
                        ? `${{connectionDrillData.minutes[startIndex].minute}} 分钟连接汇总（共 ${{summary.total}} 个连接）`
                        : `时间范围: ${{connectionDrillData.minutes[startIndex].minute}} - ${{connectionDrillData.minutes[endIndex].minute}}（共 ${{summary.total}} 个连接）`;
                    document.getElementById('connection-drill-title').textContent = title;
                    connectionCurrentSources = summary.sources;
                    connectionVisibleCount = 10;
                    refreshConnectionRows();
                    renderConnectionUserChart(summary.users);
                }}

                function selectConnectionMinute(globalIndex) {{
                    refreshConnectionSummary(globalIndex, globalIndex, true);
                }}

                function clickLine(uid, containerId, globalIndex) {{
                    if (containerId === 'connection-chart') {{
                        selectConnectionMinute(globalIndex);
                        return;
                    }}
                    goToDetail(uid);
                }}

                function initConnectionChart() {{
                    if (!connectionChartData) return;
                    renderLineChart('connection-chart', connectionChartData, '每分钟连接趋势');
                    refreshConnectionSummary(0, connectionDrillData.minutes.length - 1, false);
                }}
                document.addEventListener('DOMContentLoaded', initConnectionChart);

                
                // 复制到剪贴板函数
                function copyToClipboard(button) {{
                    // 优先读取 data-copy-text 属性；锁等待链行不再内嵌该属性
                    // （避免上下文双份存储导致 HTML 膨胀），改为运行时从相邻
                    // 详情卡行的 <pre> 中取文本
                    const copyAttr = button.getAttribute('data-copy-text');
                    let text;
                    if (copyAttr) {{
                        text = JSON.parse(copyAttr);
                    }} else {{
                        const summaryRow = button.closest('tr');
                        const cardRow = summaryRow ? summaryRow.nextElementSibling : null;
                        const preEl = (cardRow && cardRow.classList.contains('lock-detail-card-row')) ? cardRow.querySelector('pre') : null;
                        if (!preEl) {{
                            console.error('copyToClipboard: 未找到可复制的文本内容(data-copy-text 属性缺失且无相邻详情卡)');
                            return;
                        }}
                        text = preEl.textContent;
                    }}
                    const originalText = button.textContent;
                    const copiedClass = 'copied';
                    const reset = () => {{
                        button.textContent = originalText;
                        button.classList.remove(copiedClass);
                    }};
                    const markCopied = () => {{
                        button.textContent = '已复制';
                        button.classList.add(copiedClass);
                        setTimeout(reset, 600);
                    }};
                    if (navigator.clipboard && window.isSecureContext) {{
                        navigator.clipboard.writeText(text).then(() => {{
                            markCopied();
                        }}, (err) => {{
                            console.error('无法复制文本: ', err);
                            reset();
                        }});
                    }} else {{
                        const textArea = document.createElement("textarea");
                        textArea.value = text;
                        textArea.style.position = "fixed";
                        textArea.style.left = "-999999px";
                        textArea.style.top = "-999999px";
                        document.body.appendChild(textArea);
                        textArea.focus();
                        textArea.select();
                        try {{
                            document.execCommand('copy');
                            markCopied();
                        }} catch (err) {{
                            console.error('无法复制文本: ', err);
                            reset();
                        }}
                        document.body.removeChild(textArea);
                    }}
                }}

                // 下载内嵌文本：data-sql-b64 为 gzip+Base64 编码内容,点击时解码为 .gz 二进制文件下载
                // 用于超长 SQL / Prepared 语句,避免完整文本直接塞进 DOM 影响渲染性能
                // 用户下载 .gz 文件后,用桌面工具(7-Zip/WinRAR/macOS 双击)解压得到 .txt
                // 浏览器侧不解压,直接以 application/gzip 二进制下载
                function downloadEmbeddedText(button) {{
                    const b64 = button.getAttribute('data-sql-b64') || '';
                    const filename = button.getAttribute('data-filename') || 'download.txt.gz';
                    if (!b64) {{ alert('无可下载内容'); return; }}
                    // 保存原始文案,下载成功后短暂显示完成文案并加完成类(视觉反馈)
                    // data-done-text / data-done-class 可覆盖默认"已下载"文案与 .copied 类
                    const originalText = button.textContent;
                    const copiedClass = button.getAttribute('data-done-class') || 'copied';
                    const doneText = button.getAttribute('data-done-text') || '已下载';
                    const reset = () => {{
                        button.textContent = originalText;
                        button.classList.remove(copiedClass);
                    }};
                    const markDownloaded = () => {{
                        button.textContent = doneText;
                        button.classList.add(copiedClass);
                        setTimeout(reset, 1500);
                    }};
                    try {{
                        console.log('[downloadEmbeddedText] 开始下载: filename=' + filename + ' b64长度=' + b64.length);
                        // Base64 -> Uint8Array(按字节处理,得到 gzip 二进制流)
                        const binStr = atob(b64);
                        const len = binStr.length;
                        const bytes = new Uint8Array(len);
                        for (let i = 0; i < len; i++) {{ bytes[i] = binStr.charCodeAt(i); }}
                        console.log('[downloadEmbeddedText] gzip 二进制大小: ' + bytes.length + ' 字节');
                        // 关键:Blob 类型为 application/gzip,浏览器会作为 .gz 文件下载,不会尝试解析内容
                        const blob = new Blob([bytes], {{ type: 'application/gzip' }});
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = filename;
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        URL.revokeObjectURL(url);
                        console.log('[downloadEmbeddedText] ✓ 下载完成: ' + filename);
                        console.log('[downloadEmbeddedText] 提示: 该文件为 gzip 压缩包,请用 7-Zip/WinRAR/macOS 双击解压得到 .txt');
                        markDownloaded();
                    }} catch (err) {{
                        console.error('[downloadEmbeddedText] 下载失败:', err);
                        alert('下载失败: ' + err);
                        reset();
                    }}
                }}

                // 复制 Base64 编码的文本（用于执行计划等含换行的内容）
                function copyBase64Text(button) {{
                    const b64 = button.getAttribute('data-b64-text') || '';
                    if (!b64) {{ alert('无可复制内容'); return; }}
                    const originalText = button.textContent;
                    const markCopied = () => {{
                        button.textContent = '已复制';
                        setTimeout(() => {{ button.textContent = originalText; }}, 600);
                    }};
                    try {{
                        const binStr = atob(b64);
                        const len = binStr.length;
                        const bytes = new Uint8Array(len);
                        for (let i = 0; i < len; i++) {{ bytes[i] = binStr.charCodeAt(i); }}
                        const text = new TextDecoder('utf-8').decode(bytes);
                        if (navigator.clipboard && window.isSecureContext) {{
                            navigator.clipboard.writeText(text).then(markCopied, (err) => {{
                                console.error('无法复制文本: ', err);
                            }});
                        }} else {{
                            const textArea = document.createElement("textarea");
                            textArea.value = text;
                            textArea.style.position = "fixed";
                            textArea.style.left = "-999999px";
                            textArea.style.top = "-999999px";
                            document.body.appendChild(textArea);
                            textArea.focus();
                            textArea.select();
                            try {{ document.execCommand('copy'); markCopied(); }}
                        catch (err) {{ console.error('无法复制文本: ', err); }}
                        document.body.removeChild(textArea);
                        }}
                    }} catch (err) {{
                        console.error('复制失败: ', err);
                        alert('复制失败: ' + err);
                    }}
                }}

                // 生成Prepared语句
                function generatePreparedStatement(button) {{
                    const queryTemplate = button.getAttribute('data-query-template');
                    const executeStmt = button.getAttribute('data-execute-stmt');
                    // 参数类型序列(按占位符编号升序, '|'分隔), 来自日志 type 标注; 旧格式无此属性
                    const paramTypesAttr = button.getAttribute('data-param-types') || '';
                    const paramTypeList = paramTypesAttr ? paramTypesAttr.split('|') : [];

                    // 提取参数占位符
                    const paramPattern = /\\$([0-9]+)/g;
                    const matches = [];
                    let match;
                    while ((match = paramPattern.exec(queryTemplate)) !== null) {{
                        matches.push(parseInt(match[1]));
                    }}

                    // 生成prepare语句: 无占位符时不带括号(prepare bind_sql as ...);
                    // 有占位符时按编号升序声明类型, 类型取日志 type 标注, 缺失回退 text
                    const preparedName = executeStmt.trim().split(/\\s+/)[1]?.split('(')[0] || 'bind_sql';
                    let prepareStmt;
                    if (matches.length === 0) {{
                        prepareStmt = `prepare ${{preparedName}} as ${{queryTemplate.trim()}};`;
                    }} else {{
                        const uniqNums = Array.from(new Set(matches)).sort((a, b) => a - b);
                        const typeOf = n => (paramTypeList[n - 1] || 'text');
                        const paramTypesStr = uniqNums.map(typeOf).join(', ');
                        prepareStmt = `prepare ${{preparedName}}(${{paramTypesStr}}) as ${{queryTemplate.trim()}};`;
                    }}
                    
                    // 组合完整语句
                    const fullStmt = prepareStmt + '\\n\\n' + executeStmt;
                    
                    // 复制到剪贴板
                    if (navigator.clipboard && window.isSecureContext) {{
                        navigator.clipboard.writeText(fullStmt).then(() => {{
                                alert('Prepared语句已复制到剪贴板!\\n 参数类型取自日志 type 标注，缺失时回退为text');
                        }}, (err) => {{
                            console.error('无法复制文本: ', err);
                        }});
                    }} else {{
                        const textArea = document.createElement("textarea");
                        textArea.value = fullStmt;
                        textArea.style.position = "fixed";
                        textArea.style.left = "-999999px";
                        textArea.style.top = "-999999px";
                        document.body.appendChild(textArea);
                        textArea.focus();
                        textArea.select();
                        try {{
                            document.execCommand('copy');
                            alert('Prepared语句已复制到剪贴板!\\n 参数类型取自日志 type 标注，缺失时回退为text');
                        }} catch (err) {{
                            console.error('无法复制文本: ', err);
                        }}
                        document.body.removeChild(textArea);
                    }}
                }}
                
                // 绘制饼图
                function renderPieChart(containerId, data) {{
                    const container = document.getElementById(containerId);
                    if (!container) {{
                        console.error('Pie chart container not found:', containerId);
                        return;
                    }}
                    
                    if (!data || data.length === 0) {{
                        container.innerHTML = '<div style="padding: 40px; text-align: center; color: #999;">暂无数据</div>';
                        return;
                    }}
                    
                    const width = 400, height = 400;
                    const radius = Math.min(width, height) / 2 - 20;
                    const centerX = width / 2, centerY = height / 2;
                    
                    let svg = `<svg width="${{width}}" height="${{height}}" viewBox="0 0 ${{width}} ${{height}}">`;
                    
                    // 计算总和和起始角度
                    const total = data.reduce((sum, item) => sum + item.count, 0);
                    let startAngle = 0;
                    
                    // 绘制扇形
                    data.forEach(item => {{
                        const percent = item.count / total;
                        const endAngle = startAngle + percent * 2 * Math.PI;
                        
                        // 计算扇形路径
                        const x1 = centerX + radius * Math.cos(startAngle);
                        const y1 = centerY + radius * Math.sin(startAngle);
                        const x2 = centerX + radius * Math.cos(endAngle);
                        const y2 = centerY + radius * Math.sin(endAngle);
                        
                        let pathData;
                        // 特殊处理：当只有一个数据项（100%）时，直接绘制完整圆形
                        if (data.length === 1) {{
                            pathData = `M ${{centerX}} ${{centerY - radius}} A ${{radius}} ${{radius}} 0 1 1 ${{centerX - 0.01}} ${{centerY - radius}} Z`;
                        }} else {{
                            const largeArcFlag = percent > 0.5 ? 1 : 0;
                            pathData = [
                                `M ${{centerX}} ${{centerY}}`,
                                `L ${{x1}} ${{y1}}`,
                                `A ${{radius}} ${{radius}} 0 ${{largeArcFlag}} 1 ${{x2}} ${{y2}}`,
                                'Z'
                            ].join(' ');
                        }}
                        
                        svg += `<path d="${{pathData}}" fill="${{item.color}}" stroke="white" stroke-width="2" 
                                  data-name="${{item.name}}" data-count="${{item.count}}" data-percent="${{(percent*100).toFixed(1)}}%"
                                  onmouseover="showTooltip(event, '${{item.name}}: ${{item.count}}条 (${{(percent*100).toFixed(1)}}%)')"
                                  onmouseout="hideTooltip()">`;
                        svg += `<title>${{item.name}}: ${{item.count}}条 (${{(percent*100).toFixed(1)}}%)</title>`;
                        svg += `</path>`;
                        
                        startAngle = endAngle;
                    }});
                    
                    // 添加中心文字
                    svg += `<circle cx="${{centerX}}" cy="${{centerY}}" r="${{radius*0.3}}" fill="white" stroke="#ddd" stroke-width="1"/>`;
                    svg += `<text x="${{centerX}}" y="${{centerY-10}}" text-anchor="middle" font-weight="bold" font-size="16">总计</text>`;
                    svg += `<text x="${{centerX}}" y="${{centerY+15}}" text-anchor="middle" font-size="14">${{total}} 条</text>`;
                    
                    svg += `</svg>`;
                    
                    container.innerHTML = svg;
                }}
                
                // 存储每个折线图的完整数据和视图状态
                const chartViews = {{}};

                // 绘制折线图
                function renderLineChart(containerId, fullChartData, title, viewRange = null) {{
                    const container = document.getElementById(containerId);
                    if (!container) return;
                    if (!fullChartData.series || fullChartData.series.length === 0) {{
                        if (fullChartData.overall) {{
                            renderLineChart(containerId, fullChartData.overall, title, viewRange);
                        }} else {{
                            container.innerHTML = '<div style="padding: 20px; text-align: center; color: #999;">暂无数据</div>';
                        }}
                        return;
                    }}

                    const fullTimeLabels = fullChartData.time_labels;
                    if (!fullTimeLabels || fullTimeLabels.length < (fullChartData.allow_single_point ? 1 : 2)) {{
                        container.innerHTML = '<div style="padding: 20px; text-align: center; color: #999;">数据点不足，无法生成折线图（至少需要2个时间点）</div>';
                        return;
                    }}

                    const hasValidData = fullChartData.series.some(s => {{
                        const validPoints = s.data.filter(v => v > 0).length;
                        return validPoints >= (fullChartData.allow_single_point ? 1 : 2);
                    }});

                    if (!hasValidData) {{
                        container.innerHTML = '<div style="padding: 20px; text-align: center; color: #999;">有效数据点不足，无法生成折线图</div>';
                        return;
                    }}

                    // 确定当前视图范围
                    let startIndex = 0;
                    let endIndex = fullTimeLabels.length - 1;
                    if (viewRange) {{
                        startIndex = Math.max(0, Math.min(viewRange.startIndex, fullTimeLabels.length - 1));
                        endIndex = Math.max(startIndex, Math.min(viewRange.endIndex, fullTimeLabels.length - 1));
                    }}
                    // 视图范围至少包含2个点
                    if (endIndex - startIndex + 1 < 2) {{
                        startIndex = 0;
                        endIndex = fullTimeLabels.length - 1;
                    }}

                    // 存储/更新视图状态
                    if (!chartViews[containerId] || chartViews[containerId].fullData !== fullChartData) {{
                        chartViews[containerId] = {{ fullData: fullChartData, title: title }};
                    }}
                    chartViews[containerId].startIndex = startIndex;
                    chartViews[containerId].endIndex = endIndex;

                    // 截取当前视图的数据
                    const timeLabels = fullTimeLabels.slice(startIndex, endIndex + 1);
                    const seriesList = fullChartData.series.map(s => ({{
                        uid: s.uid,
                        uid_display: s.uid_display,
                        color: s.color,
                        data: s.data.slice(startIndex, endIndex + 1)
                    }}));

                    // 宽度自适应：按容器实际可用宽度计算，保证框选/平移坐标换算与显示一致
                    // (容器 .chart-box width:100%，减去父级 padding 后即绘图区可用宽度)
                    const _avail = container.clientWidth || 0;
                    const width = Math.max(400, _avail > 0 ? _avail : 800);
                    const height = 400;
                    const margin = {{top: 30, right: 150, bottom: 40, left: 60}};
                    const chartWidth = width - margin.left - margin.right;
                    const chartHeight = height - margin.top - margin.bottom;

                    const allValues = seriesList.flatMap(s => s.data);
                    const maxValue = allValues.reduce((a, b) => Math.max(a, b), 0);
                    // 纵轴上限取整，确保网格/数据线都以整数坐标展示
                    const yMaxValue = Math.max(1, Math.ceil(maxValue));

                    let lastValidIndex = timeLabels.length - 1;
                    const allLastZero = seriesList.every(s => s.data[s.data.length - 1] === 0);
                    if (allLastZero && lastValidIndex > 0) {{
                        lastValidIndex--;
                    }}

                    // 创建SVG
                    let svg = `<svg width="${{width}}" height="${{height}}" viewBox="0 0 ${{width}} ${{height}}" class="line-chart-svg">`;

                    const xScale = chartWidth / (lastValidIndex || 1);
                    const yScale = chartHeight / yMaxValue;

                    // 绘制网格线（纵轴为时段内执行数，使用整数刻度；选 nice 步长避免出现小数）
                    var yMax = yMaxValue;
                    var yStepCandidates = [1, 2, 5, 10, 20, 25, 50, 100, 200, 250, 500, 1000, 2000, 5000, 10000];
                    var yStep = yMax / 5;
                    for (var ys = 0; ys < yStepCandidates.length; ys++) {{
                        if (yStepCandidates[ys] >= yStep) {{ yStep = yStepCandidates[ys]; break; }}
                    }}
                    if (yStep < 1) yStep = 1;
                    var yTickCount = Math.ceil(yMax / yStep);
                    for (let i = 0; i <= yTickCount; i++) {{
                        const value = i * yStep;
                        const y = margin.top + chartHeight - (value / yMax) * chartHeight;
                        svg += `<line x1="${{margin.left}}" y1="${{y}}" x2="${{margin.left + chartWidth}}" y2="${{y}}" stroke="#eee" stroke-width="1"/>`;
                        svg += `<text x="${{margin.left - 10}}" y="${{y + 4}}" text-anchor="end" font-size="12" fill="#666">${{value}}</text>`;
                    }}

                    // 解析时间标签，用于智能格式化横坐标
                    function parseTimeLabel(s) {{
                        if (typeof s !== 'string') return null;
                        var m = s.match(/^(\\d{{4}})-(\\d{{2}})-(\\d{{2}})(?: (\\d{{2}}):(\\d{{2}}))?/);
                        if (!m) return null;
                        return {{
                            year: parseInt(m[1], 10),
                            month: parseInt(m[2], 10),
                            day: parseInt(m[3], 10),
                            hour: m[4] !== undefined ? parseInt(m[4], 10) : null,
                            minute: m[5] !== undefined ? parseInt(m[5], 10) : null
                        }};
                    }}
                    function pad2(n) {{ return (n < 10 ? '0' : '') + n; }}

                    // 绘制时间标签
                    // 同一天内主刻度只显示 HH:MM；跨天的第一个刻度显示 MM-DD（日）
                    // 完整年月显示在图表最左侧
                    // 刻度间隔根据当前视图可见点数动态选择，缩放后自动细化，最细到数据本身的粒度（分钟）
                    var parsedLabels = timeLabels.map(parseTimeLabel);
                    var firstInfo = parsedLabels[0];
                    var labelInterval = 1;

                    // 估算数据本身的粒度（分钟）
                    var dataIntervalMin = null;
                    if (parsedLabels.length >= 2) {{
                        var p0 = parsedLabels[0], p1 = parsedLabels[1];
                        if (p0 && p1) {{
                            if (p0.hour === null || p1.hour === null) {{
                                // day 维度：相邻标签间隔 1 天
                                dataIntervalMin = 1440;
                            }} else {{
                                var diff = (p1.hour * 60 + p1.minute) - (p0.hour * 60 + p0.minute);
                                // 跨天的情况
                                if (diff <= 0) diff += 1440;
                                if (diff > 0) dataIntervalMin = diff;
                            }}
                        }}
                    }}

                    var visibleCount = lastValidIndex + 1;
                    var targetLabelCount = 15;
                    if (dataIntervalMin !== null) {{
                        // 当前视图的总时间跨度（分钟）
                        var totalSpanMin = visibleCount * dataIntervalMin;
                        var targetTickMin = totalSpanMin / targetLabelCount;
                        // nice 刻度间隔（分钟）：从 1 分钟到 1 天
                        var niceIntervals = [1, 2, 5, 10, 15, 20, 30, 60, 120, 180, 240, 360, 480, 720, 1440];
                        var chosen = null;
                        for (var ni = 0; ni < niceIntervals.length; ni++) {{
                            if (niceIntervals[ni] >= dataIntervalMin && niceIntervals[ni] >= targetTickMin) {{
                                chosen = niceIntervals[ni];
                                break;
                            }}
                        }}
                        if (chosen === null) {{
                            // 跨度超过 1 天，按天整数倍
                            chosen = Math.ceil(targetTickMin / 1440) * 1440;
                        }}
                        labelInterval = Math.max(1, Math.round(chosen / dataIntervalMin));
                    }} else {{
                        // 无法解析粒度时退化为按点数均分
                        labelInterval = Math.max(1, Math.ceil(visibleCount / targetLabelCount));
                    }}

                    // 对齐起点：把第一个刻度对齐到 labelInterval 的整数倍（基于完整数据的时间），
                    // 这样缩放/平移后刻度仍落在整点/整刻上
                    // 注：timeLabels 已是切片后的视图，因此这里只对齐到小时/天的边界
                    var drawnTickIndices = {{}};
                    if (firstInfo && firstInfo.hour !== null && labelInterval > 1 && dataIntervalMin && dataIntervalMin < 1440) {{
                        // 找到视图内第一个满足"刻度时间 % chosen == 0"的点作为起始
                        var chosenMin = labelInterval * dataIntervalMin;
                        var alignedStart = 0;
                        for (var ai = 0; ai <= lastValidIndex; ai++) {{
                            var pi = parsedLabels[ai];
                            if (!pi) continue;
                            var minuteOfDay = pi.hour * 60 + pi.minute;
                            if (minuteOfDay % chosenMin === 0) {{
                                alignedStart = ai;
                                break;
                            }}
                        }}
                        // 使用对齐后的起点
                        var lastDay = null;
                        for (let i = alignedStart; i <= lastValidIndex; i += labelInterval) {{
                            drawnTickIndices[i] = true;
                            const x = margin.left + i * xScale;
                            var info = parsedLabels[i];
                            var labelText = timeLabels[i];
                            var isFirstTick = (i === alignedStart);
                            if (info) {{
                                if (info.hour === null) {{
                                    labelText = pad2(info.month) + '-' + pad2(info.day);
                                }} else if (isFirstTick) {{
                                    // 最左端第一个刻度显示 MM-DD HH:MM（月份在左上角常驻，这里仍带月以保证完整可读）
                                    labelText = pad2(info.month) + '-' + pad2(info.day) + ' ' + pad2(info.hour) + ':' + pad2(info.minute);
                                }} else if (info.hour === 0 && info.minute === 0) {{
                                    // 每天 00:00 刻度直接显示日期 MM-DD
                                    labelText = pad2(info.month) + '-' + pad2(info.day);
                                }} else if (lastDay !== null && info.day !== lastDay) {{
                                    labelText = pad2(info.month) + '-' + pad2(info.day);
                                }} else {{
                                    labelText = pad2(info.hour) + ':' + pad2(info.minute);
                                }}
                                lastDay = info.day;
                            }}
                            svg += `<text x="${{x}}" y="${{margin.top + chartHeight + 20}}" text-anchor="middle" font-size="11" fill="#666">${{labelText}}</text>`;
                            svg += `<line x1="${{x}}" y1="${{margin.top + chartHeight}}" x2="${{x}}" y2="${{margin.top + chartHeight + 5}}" stroke="#666" stroke-width="1"/>`;
                        }}
                    }} else {{
                        var lastDay = null;
                        for (let i = 0; i <= lastValidIndex; i += labelInterval) {{
                            drawnTickIndices[i] = true;
                            const x = margin.left + i * xScale;
                            var info = parsedLabels[i];
                            var labelText = timeLabels[i];
                            if (info) {{
                                var isFirstTick = (i === 0);
                                if (info.hour === null) {{
                                    // day 维度
                                    labelText = pad2(info.month) + '-' + pad2(info.day);
                                }} else if (isFirstTick) {{
                                    // 最左端第一个刻度显示 MM-DD HH:MM
                                    labelText = pad2(info.month) + '-' + pad2(info.day) + ' ' + pad2(info.hour) + ':' + pad2(info.minute);
                                }} else if (info.hour === 0 && info.minute === 0) {{
                                    // 每天 00:00 刻度直接显示日期 MM-DD
                                    labelText = pad2(info.month) + '-' + pad2(info.day);
                                }} else if (lastDay !== null && info.day !== lastDay) {{
                                    // 跨天的第一个刻度显示 MM-DD
                                    labelText = pad2(info.month) + '-' + pad2(info.day);
                                }} else {{
                                    // 同一天内只显示 HH:MM
                                    labelText = pad2(info.hour) + ':' + pad2(info.minute);
                                }}
                                lastDay = info.day;
                            }}
                            svg += `<text x="${{x}}" y="${{margin.top + chartHeight + 20}}" text-anchor="middle" font-size="11" fill="#666">${{labelText}}</text>`;
                            svg += `<line x1="${{x}}" y1="${{margin.top + chartHeight}}" x2="${{x}}" y2="${{margin.top + chartHeight + 5}}" stroke="#666" stroke-width="1"/>`;
                        }}
                    }}

                    // 跨天时，在每天的 00:00 刻度位置（如果不在主刻度上）补充显示 MM-DD
                    if (firstInfo && firstInfo.hour !== null) {{
                        var prevDay2 = firstInfo.day;
                        for (let i = 1; i <= lastValidIndex; i++) {{
                            var info = parsedLabels[i];
                            if (!info) continue;
                            if (info.day !== prevDay2) {{
                                // 找到跨天点：若该位置未被主刻度覆盖，则补一个 MM-DD 标签
                                var covered = !!drawnTickIndices[i];
                                if (!covered) {{
                                    const x = margin.left + i * xScale;
                                    svg += `<text x="${{x}}" y="${{margin.top + chartHeight + 20}}" text-anchor="middle" font-size="11" font-weight="bold" fill="#444">${{pad2(info.month)}}-${{pad2(info.day)}}</text>`;
                                }}
                                prevDay2 = info.day;
                            }}
                        }}
                    }}

                    // 最左侧：完整时间标识（图表左上方），随当前视图动态变化
                    // 视图在同一天内 -> 显示 YYYY年M月D日；跨天 -> 显示 YYYY年M月
                    if (firstInfo) {{
                        var lastInfo = parsedLabels[lastValidIndex] || firstInfo;
                        var ymText;
                        if (firstInfo.year === lastInfo.year &&
                            firstInfo.month === lastInfo.month &&
                            firstInfo.day === lastInfo.day) {{
                            ymText = firstInfo.year + '年' + firstInfo.month + '月' + firstInfo.day + '日';
                        }} else {{
                            ymText = firstInfo.year + '年' + firstInfo.month + '月';
                        }}
                        svg += `<text x="${{margin.left}}" y="${{margin.top - 12}}" text-anchor="start" font-size="13" font-weight="bold" fill="#222">${{ymText}}</text>`;
                    }}

                    // 绘制每条线
                    seriesList.forEach((series) => {{
                        if (series.data.length === 0 || series.data[0] === undefined) return;
                        let endIndexLocal = lastValidIndex;
                        if (endIndexLocal < 0) return;

                        // 统计非零数据点数量：<=1 时只画点不画线，避免单点形成尖刺
                        var nonZeroCount = 0;
                        for (var nzi = 0; nzi <= endIndexLocal; nzi++) {{
                            if (series.data[nzi] > 0) nonZeroCount++;
                        }}
                        var drawLine = nonZeroCount >= 2;

                        if (drawLine) {{
                            // 使用单调三次插值(Monotone Cubic)转贝塞尔，保证曲线在数据点间单调
                            // 不会下弯到横轴下方，也不会在峰值处 overshoot
                            const n = endIndexLocal + 1;
                            const xs = [];
                            const ys = [];
                            for (let i = 0; i < n; i++) {{
                                xs.push(margin.left + i * xScale);
                                ys.push(margin.top + chartHeight - series.data[i] * yScale);
                            }}
                            // Fritsch-Carlson 单调三次插值
                            const tangents = new Array(n);
                            const deltas = new Array(n - 1);
                            for (let i = 0; i < n - 1; i++) {{
                                deltas[i] = (ys[i + 1] - ys[i]) / (xs[i + 1] - xs[i]);
                            }}
                            tangents[0] = deltas[0];
                            tangents[n - 1] = deltas[n - 2];
                            for (let i = 1; i < n - 1; i++) {{
                                if (deltas[i - 1] * deltas[i] <= 0) {{
                                    tangents[i] = 0;
                                }} else {{
                                    tangents[i] = (deltas[i - 1] + deltas[i]) / 2;
                                }}
                            }}
                            // 单调性约束
                            for (let i = 0; i < n - 1; i++) {{
                                if (deltas[i] === 0) {{
                                    tangents[i] = 0;
                                    tangents[i + 1] = 0;
                                }} else {{
                                    const a = tangents[i] / deltas[i];
                                    const b = tangents[i + 1] / deltas[i];
                                    const s = a * a + b * b;
                                    if (s > 9) {{
                                        const t = 3 / Math.sqrt(s);
                                        tangents[i] = t * a * deltas[i];
                                        tangents[i + 1] = t * b * deltas[i];
                                    }}
                                }}
                            }}
                            let pathData = `M ${{xs[0]}} ${{ys[0]}}`;
                            for (let i = 0; i < n - 1; i++) {{
                                const dx = (xs[i + 1] - xs[i]) / 3;
                                const cp1x = xs[i] + dx;
                                const cp1y = ys[i] + tangents[i] * dx;
                                const cp2x = xs[i + 1] - dx;
                                const cp2y = ys[i + 1] - tangents[i + 1] * dx;
                                pathData += ` C ${{cp1x}} ${{cp1y}}, ${{cp2x}} ${{cp2y}}, ${{xs[i + 1]}} ${{ys[i + 1]}}`;
                            }}

                            svg += `<path d="${{pathData}}" fill="none" stroke="${{series.color}}" stroke-width="3"
                                      data-uid="${{series.uid}}"
                                      onmouseover="highlightLine('${{series.uid}}', '${{containerId}}')"
                                      onmouseout="unhighlightLine('${{series.uid}}')"
                                      onclick="clickLine('${{series.uid}}', '${{containerId}}', ${{startIndex}})"
                                      style="cursor: pointer;"/>`;
                        }}

                        // 数据点超过2个时隐藏可见圆点，只保留透明热区用于悬停交互
                        const showPoints = nonZeroCount <= 2;
                        for (let i = 0; i <= lastValidIndex; i++) {{
                            if (series.data[i] > 0) {{
                                const x = margin.left + i * xScale;
                                const y = margin.top + chartHeight - series.data[i] * yScale;
                                if (showPoints) {{
                                    // 可见数据点（点数少时显示）
                                    svg += `<circle cx="${{x}}" cy="${{y}}" r="4" fill="${{series.color}}"
                                              data-uid="${{series.uid}}" data-index="${{i}}" data-value="${{series.data[i]}}"
                                              onmouseover="showPointTooltip(event, '${{series.uid}}', '${{timeLabels[i]}}', ${{series.data[i]}}, '${{containerId}}')"
                                              onmouseout="hidePointTooltip(); unhighlightLine('${{series.uid}}')"
                                              onclick="clickLine('${{series.uid}}', '${{containerId}}', ${{startIndex + i}})"
                                              style="cursor: pointer; pointer-events: all;"/>`;
                                }}
                                // 透明命中热区，覆盖更大区域以便鼠标容易命中（始终保留）
                                svg += `<circle cx="${{x}}" cy="${{y}}" r="10" fill="transparent"
                                          data-uid="${{series.uid}}" data-index="${{i}}" data-value="${{series.data[i]}}"
                                          onmouseover="showPointTooltip(event, '${{series.uid}}', '${{timeLabels[i]}}', ${{series.data[i]}}, '${{containerId}}')"
                                          onmouseout="hidePointTooltip(); unhighlightLine('${{series.uid}}')"
                                          onclick="clickLine('${{series.uid}}', '${{containerId}}', ${{startIndex + i}})"
                                          style="cursor: pointer; pointer-events: all;"/>`;
                            }}
                        }}
                    }});

                    // 添加图例
                    let legendY = margin.top;
                    seriesList.forEach(series => {{
                        const legendUid = series.uid_display || series.uid;
                        svg += `<g class="chart-legend-item" data-uid="${{series.uid}}">`;
                        svg += `<rect x="${{margin.left + chartWidth + 20}}" y="${{legendY}}" width="15" height="15" fill="${{series.color}}"/>`;
                        svg += `<text x="${{margin.left + chartWidth + 40}}" y="${{legendY + 12}}" font-size="12">${{legendUid}}</text>`;
                        svg += `</g>`;
                        legendY += 20;
                    }});

                    svg += `<text x="10" y="${{height/2}}" text-anchor="middle" font-size="14" transform="rotate(-90, 10, ${{height/2}}) translate(0, -20)">${{fullChartData.y_axis_label || '执行次数'}}</text>`;
                    svg += `</svg>`;

                    // 渲染控件层
                    container.innerHTML = `
                        <div class="line-chart-controls" style="margin-bottom: 5px; text-align: right;">
                            <button onclick="resetChartView('${{containerId}}')" title="恢复全量视图">重置</button>
                            <button onclick="zoomInChart('${{containerId}}')" title="放大当前视图">放大</button>
                            <button onclick="zoomOutChart('${{containerId}}')" title="缩小当前视图">缩小</button>
                        </div>
                        <div class="line-chart-svg-wrapper" style="position: relative; width: ${{width}}px; height: ${{height}}px;">
                            ${{svg}}
                            <div class="line-chart-overlay" style="position: absolute; top: 0; left: 0; width: ${{width}}px; height: ${{height}}px; pointer-events: none;"
                                 data-container-id="${{containerId}}">
                            </div>
                            <div class="line-chart-selection" style="position: absolute; top: 0; height: ${{height}}px; background: rgba(52, 152, 219, 0.2); border: 1px solid #3498db; display: none; pointer-events: none;"></div>
                        </div>
                    `;

                    setupChartInteractions(containerId, width, height, margin, chartWidth, fullTimeLabels.length, startIndex, endIndex);
                    if (containerId === 'minute-chart') {{
                        renderSqlHeatmap('minute', window.currentTop10SqlType || 'dml', {{ startIndex, endIndex }});
                    }}
                    if (containerId === 'connection-chart') {{
                        refreshConnectionSummary(startIndex, endIndex, false);
                    }}
                }}

                function setupChartInteractions(containerId, width, height, margin, chartWidth, fullLen, startIndex, endIndex) {{
                    const container = document.getElementById(containerId);
                    const wrapper = container.querySelector('.line-chart-svg-wrapper');
                    const overlay = container.querySelector('.line-chart-overlay');
                    const selection = container.querySelector('.line-chart-selection');
                    if (!wrapper || !overlay || !selection) return;

                    let isDragging = false;
                    let startX = 0;
                    let isPanning = false;
                    let panStartX = 0;
                    let dragMoved = false;
                    let dragStartTimer = null;

                    function getRelativeX(e) {{
                        const rect = wrapper.getBoundingClientRect();
                        return e.clientX - rect.left;
                    }}

                    function onMouseDown(e) {{
                        dragMoved = false;
                        const x = getRelativeX(e);
                        if (e.shiftKey) {{
                            isPanning = true;
                            panStartX = x;
                            wrapper.style.cursor = 'grabbing';
                        }} else {{
                            // 延迟200ms显示竖线，避免点击线条时误出现
                            dragStartTimer = setTimeout(() => {{
                                isDragging = true;
                                startX = x;
                                selection.style.left = x + 'px';
                                selection.style.width = '0px';
                                selection.style.display = 'block';
                                wrapper.style.cursor = 'crosshair';
                            }}, 200);
                        }}
                    }}

                    function onMouseMove(e) {{
                        const x = getRelativeX(e);
                        if (isDragging) {{
                            dragMoved = true;
                            const left = Math.min(x, startX);
                            const w = Math.abs(x - startX);
                            selection.style.left = left + 'px';
                            selection.style.width = w + 'px';
                        }} else if (isPanning) {{
                            dragMoved = true;
                            const dx = x - panStartX;
                            if (Math.abs(dx) > 5) {{
                                panChart(containerId, dx, chartWidth);
                                panStartX = x;
                            }}
                        }}
                    }}

                    function onMouseUp(e) {{
                        const x = getRelativeX(e);
                        if (dragStartTimer) {{
                            clearTimeout(dragStartTimer);
                            dragStartTimer = null;
                        }}
                        if (isDragging) {{
                            const left = Math.min(x, startX);
                            const right = Math.max(x, startX);
                            const minSelectWidth = 10;
                            if (dragMoved && right - left > minSelectWidth) {{
                                const pixelsPerIndex = chartWidth / (endIndex - startIndex);
                                const newStartIndex = Math.floor((left - margin.left) / pixelsPerIndex) + startIndex;
                                const newEndIndex = Math.ceil((right - margin.left) / pixelsPerIndex) + startIndex;
                                zoomChartToRange(containerId, Math.max(0, Math.min(newStartIndex, fullLen - 1)), Math.max(0, Math.min(newEndIndex, fullLen - 1)));
                            }}
                            selection.style.display = 'none';
                            isDragging = false;
                            dragMoved = false;
                            wrapper.style.cursor = '';
                        }} else if (isPanning) {{
                            isPanning = false;
                            dragMoved = false;
                            wrapper.style.cursor = '';
                        }}
                    }}

                    function onMouseLeave() {{
                        if (dragStartTimer) {{
                            clearTimeout(dragStartTimer);
                            dragStartTimer = null;
                        }}
                        if (isDragging) {{
                            selection.style.display = 'none';
                            isDragging = false;
                            dragMoved = false;
                        }}
                        isPanning = false;
                        wrapper.style.cursor = '';
                    }}

                    function onContextMenu(e) {{
                        e.preventDefault();
                        resetChartView(containerId);
                    }}

                    wrapper.addEventListener('mousedown', onMouseDown);
                    wrapper.addEventListener('mousemove', onMouseMove);
                    wrapper.addEventListener('mouseup', onMouseUp);
                    wrapper.addEventListener('mouseleave', onMouseLeave);
                    wrapper.addEventListener('contextmenu', onContextMenu);
                }}

                function zoomChartToRange(containerId, startIndex, endIndex) {{
                    const view = chartViews[containerId];
                    if (!view) return;
                    const fullLen = view.fullData.time_labels.length;
                    if (endIndex - startIndex + 1 < 2) {{
                        startIndex = Math.max(0, endIndex - 1);
                    }}
                    startIndex = Math.max(0, Math.min(startIndex, fullLen - 1));
                    endIndex = Math.max(startIndex + 1, Math.min(endIndex, fullLen - 1));
                    renderLineChart(containerId, view.fullData, view.title, {{ startIndex, endIndex }});
                }}

                function resetChartView(containerId) {{
                    const view = chartViews[containerId];
                    if (!view) return;
                    renderLineChart(containerId, view.fullData, view.title);
                }}

                function zoomInChart(containerId) {{
                    const view = chartViews[containerId];
                    if (!view) return;
                    const range = view.endIndex - view.startIndex + 1;
                    const newRange = Math.max(2, Math.floor(range * 0.7));
                    const center = Math.floor((view.startIndex + view.endIndex) / 2);
                    const half = Math.floor(newRange / 2);
                    let startIndex = center - half;
                    let endIndex = startIndex + newRange - 1;
                    zoomChartToRange(containerId, startIndex, endIndex);
                }}

                function zoomOutChart(containerId) {{
                    const view = chartViews[containerId];
                    if (!view) return;
                    const fullLen = view.fullData.time_labels.length;
                    const range = view.endIndex - view.startIndex + 1;
                    const newRange = Math.min(fullLen, Math.ceil(range / 0.7));
                    const center = Math.floor((view.startIndex + view.endIndex) / 2);
                    const half = Math.floor(newRange / 2);
                    let startIndex = center - half;
                    let endIndex = startIndex + newRange - 1;
                    if (startIndex < 0) {{
                        endIndex -= startIndex;
                        startIndex = 0;
                    }}
                    if (endIndex >= fullLen) {{
                        startIndex -= (endIndex - fullLen + 1);
                        endIndex = fullLen - 1;
                    }}
                    startIndex = Math.max(0, startIndex);
                    endIndex = Math.min(fullLen - 1, endIndex);
                    if (endIndex - startIndex + 1 < 2) {{
                        endIndex = fullLen - 1;
                        startIndex = 0;
                    }}
                    zoomChartToRange(containerId, startIndex, endIndex);
                }}

                function panChart(containerId, dx, chartWidth) {{
                    const view = chartViews[containerId];
                    if (!view) return;
                    const range = view.endIndex - view.startIndex + 1;
                    const pixelsPerIndex = chartWidth / (range - 1);
                    const shift = Math.round(dx / pixelsPerIndex);
                    if (shift === 0) return;
                    let startIndex = view.startIndex - shift;
                    let endIndex = startIndex + range - 1;
                    const fullLen = view.fullData.time_labels.length;
                    if (startIndex < 0) {{
                        endIndex -= startIndex;
                        startIndex = 0;
                    }}
                    if (endIndex >= fullLen) {{
                        startIndex -= (endIndex - fullLen + 1);
                        endIndex = fullLen - 1;
                    }}
                    startIndex = Math.max(0, startIndex);
                    endIndex = Math.min(fullLen - 1, endIndex);
                    if (startIndex !== view.startIndex || endIndex !== view.endIndex) {{
                        zoomChartToRange(containerId, startIndex, endIndex);
                    }}
                }}
                
                // 高亮线条（只显示unique_id，不跳转）
                function highlightLine(uid, containerId) {{
                    document.querySelectorAll(`[data-uid='${{uid}}']`).forEach(el => {{
                        if (el.tagName === 'path') {{
                            el.style.strokeWidth = '5';
                            el.style.filter = 'drop-shadow(0 0 3px rgba(0,0,0,0.3))';
                        }}
                    }});
                    if (containerId !== 'connection-chart') {{
                        // 显示unique_id提示（使用原始显示值，若无可回退）
                        const chartView = chartViews[containerId];
                        const series = chartView && chartView.fullData && chartView.fullData.series
                            ? chartView.fullData.series.find(s => s.uid === uid)
                            : null;
                        const displayUid = series ? (series.uid_display || series.uid) : uid;
                        if (window.event) {{
                            showTooltip(window.event, uid === '__overall__' ? '总慢SQL个数' : uid === '__bug__' ? '特殊事件总次数' : `Unique ID: ${{displayUid}}`);
                        }}
                    }}
                }}

                function unhighlightLine(uid) {{
                    document.querySelectorAll(`[data-uid='${{uid}}']`).forEach(el => {{
                        if (el.tagName === 'path') {{
