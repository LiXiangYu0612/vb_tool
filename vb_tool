def check_memory_usage(threshold_mb=2048, raise_exception=True):
    """
    Args:
        threshold_mb (float): 内存阈值（MB），默认为2048MB（2GB）
        raise_exception (bool): 是否在超过阈值时抛出异常，默认为True
    """
    memory_mb = 0
    
    try:
        if resource is not None:
            # 获取当前进程的内存使用（单位：KB）
            memory_kb = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
            # 在Linux上单位是KB，在其他系统上可能是字节
            memory_mb = memory_kb / 1024
            # 检查是否成功获取内存使用
            if memory_mb > 0:
                # 检查内存阈值
                if memory_mb > threshold_mb:
                    error_msg = f"内存使用超过限制: {memory_mb:.2f}MB > MAX_LIMIT:  {threshold_mb}MB "
                    if raise_exception:
                        raise MemoryError(error_msg)
                else:
                    print(f"内存使用正常: {memory_mb:.2f}MB    MAX_LIMIT: {threshold_mb}MB ")
            else:
                print("警告: 内存检查失败，请注意内存使用")
        else:
            print("警告: 当前系统不支持内存检查（resource模块不可用）")
    
    except Exception:
        print("警告: 内存检查失败，请注意内存使用")
 

## @function 获取数据库日志行前缀格式
## @description 通过vsql命令获取log_line_prefix参数
## @return {string} 日志行前缀格式，如果获取失败则返回None
def get_log_line_prefix():
    try:
        # 使用PIPE来捕获输出，兼容旧版本Python
        process = subprocess.Popen(
            ['vsql', '-q', '-A', '-t', '-c', 'show log_line_prefix'],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            universal_newlines=True
        )
        stdout, stderr = process.communicate()
        
        if process.returncode != 0:
            print(f"ERROR: vsql命令执行失败: {stderr.strip()}")
            return None
            
        log_prefix = stdout.strip()
        
        return log_prefix
    except FileNotFoundError:
        print("ERROR: 未找到vsql命令，请确保已正确安装并配置数据库客户端")
        return None
    except Exception as e:
        print(f"ERROR: 获取日志行前缀格式时发生错误: {str(e)}")
