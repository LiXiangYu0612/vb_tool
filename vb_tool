# _awr_repl_sample  -- role-aware per-minute DB replication sample + ONE OS
# counters sample appended to <root>/os_<YYYYMMDD>.log. primary: ONE
# pg_stat_replication sample -> repl_<YYYYMMDD>.log plus ONE pg_replication_slots
# sample -> slot_<YYYYMMDD>.log. standby: the walsender views are always empty
# there, so instead ONE pg_stat_get_wal_receiver() sample ->
# walrcv_<YYYYMMDD>.log (15 cols). OS part is role-independent (the name keeps
# "_repl" because deployed crontabs call `awr _repl-sample` -- do not rename).
# Row grammar (repl/slot logs):
#   data : ts,<view columns as selected below>
#   null : ts,null     (view = 0 rows: no standby / no slot)
#   error: ts,error    (psql failed; sampler keeps running, cron stays quiet)
# walrcv_<YYYYMMDD>.log row grammar (standby role only):
#   data : ts,receiver_pid,local_role,peer_role,peer_state,state,
#          sender_sent_location,sender_write_location,sender_flush_location,
#          sender_replay_location,receiver_received_location,
#          receiver_write_location,receiver_flush_location,
#          receiver_replay_location,sync_percent,channel   (15 fields)
#   null : ts,null     (no walreceiver: standalone primary or post-promote)
#   error: ts,error    (psql failed; sampler keeps running, cron stays quiet)
# The slot query is independent: its failure never disturbs the stat rows
# (and vice versa -- each log gets its own data/error/null row per minute).
# The OS sample is independent too: /proc reads only, no psql, its own log.
# os_<YYYYMMDD>.log row grammar (renderer = load_os_samples in the python):
#   cpu,<ts>,user,nice,system,idle,iowait,irq,softirq,steal,procs_running,procs_blocked
#   pg,<ts>,pgpgin,pgpgout,pswpin,pswpout,pgfault,pgmajfault          (vmstat)
#   mem,<ts>,MemTotal,MemFree,MemAvailable,Buffers,Cached,Slab,SwapFree (kB)
#          [,ZoneFree,ZoneMin,ZoneLow,ZoneHigh] (kB; zone watermarks summed
#          over all zones, appended when /proc/zoneinfo was readable)
#   dsk,<ts>,<raw /proc/diskstats line>   (spaces, no commas; renderer
#          re-parses with proc_disk_devs so partition filtering matches)
#   net,<ts>,<raw /proc/net/dev iface line>  (same; proc_net_ifaces filters)
#   tcp,<ts>,ActiveOpens,PassiveOpens,CurrEstab,OutSegs,RetransSegs  (snmp)
#   tcpext,<ts>,ListenDrops,ListenOverflows,Timeouts,SynRetrans      (netstat TcpExt)
#   ssrtt,<ts>,conns,rtt_min,rtt_avg,rtt_max,rtt_p95,worst_peer,worst_rtt
#          (ss -ti over ESTABLISHED, loopback peers excluded; rtt = kernel
#           smoothed estimate in ms; worst_rtt is worst_peer's rtt. Row is
#           omitted when 0 qualifying conns / no ss -> renderer hides RTT)
#   sspeer,<ts>,peer,lport,rtt,rttvar,cwnd,retrans,mss,sendq
#          (per-CONNECTION rows, only the minute's top offenders: top 3 by
#           sendq (non-zero) + top 3 by rtt, deduped. Gives the renderer
#           window-PEAK per-peer tables instead of a single END-snap instant;
#           bounded ~6 rows/min worst case)
# Always returns 0 (cron-friendly; failures are data, not exit codes).
_awr_repl_sample() {
    local root; root=$(_awr_root)
    umask 077   # per-minute logs carry standby addrs/LSNs: 0600 like snapshots
    mkdir -p "$root" 2>/dev/null || return 0
    local f ts out sf of og od8 today wrf
    f="$root/repl_$(date +%Y%m%d).log"
    sf="$root/slot_$(date +%Y%m%d).log"
    # Non-blocking mutual exclusion: if the previous run is still alive (DB
    # unreachable and hanging inside connect), skip this minute entirely --
    # no zombie pile-up, and no two instances interleaving rows (row order
    # must stay ts-monotonic for the renderer's last-seen logic). The fd is
    # inherited by psql, so the lock is held for the whole attempt.
    exec 9>"$root/repl.lock"
    flock -n 9 || return 0
    ts=$(date '+%F %T')
    # ---- role-aware source, re-checked EVERY minute so a switchover flips the
    # source mid-day without operator action. primary: walsender side
    # (pg_stat_replication + pg_replication_slots, unchanged). standby: the
    # walsender views are always empty there -- sample the walreceiver side
    # instead (pg_stat_get_wal_receiver(), the openGauss counterpart of PG's
    # pg_stat_wal_receiver view) into its own walrcv_<YYYYMMDD>.log. A failed
    # role probe falls through to the primary branch (which writes its own
    # error rows). The OS sample below runs for BOTH roles either way.
    wrf="$root/walrcv_$(date +%Y%m%d).log"
    if PGCONNECT_TIMEOUT=15 psql -d postgres -tAc "select pg_is_in_recovery()" 2>/dev/null | grep -qx 't'; then
        out=$(PGCONNECT_TIMEOUT=15 PGOPTIONS='-c statement_timeout=15000' \
              psql -d postgres -tAF',' -c "select receiver_pid,local_role,peer_role,peer_state,state,sender_sent_location,sender_write_location,sender_flush_location,sender_replay_location,receiver_received_location,receiver_write_location,receiver_flush_location,receiver_replay_location,sync_percent,channel from pg_stat_get_wal_receiver()" 2>/dev/null)
        if [ "$?" -ne 0 ]; then
            printf '%s,error\n' "$ts" >> "$wrf"
        elif [ -z "$out" ]; then
            printf '%s,null\n' "$ts" >> "$wrf"
        else
            printf '%s\n' "$out" | sed "s|^|$ts,|" >> "$wrf"
        fi
    else
    # Bound the attempt: connect fails fast (15s) and the query itself is
    # statement-timeout guarded, so one bad minute cannot stretch into a
    # multi-minute hang that blocks every later sample behind the lock.
    out=$(PGCONNECT_TIMEOUT=15 PGOPTIONS='-c statement_timeout=15000' \
          psql -d postgres -tAF',' -c "select application_name,client_addr,state,sync_state,sender_sent_location,receiver_write_location,receiver_flush_location,receiver_replay_location from pg_stat_replication order by application_name" 2>/dev/null)
    if [ "$?" -ne 0 ]; then
        printf '%s,error\n' "$ts" >> "$f"
    elif [ -z "$out" ]; then
        printf '%s,null\n' "$ts" >> "$f"
    else
        printf '%s\n' "$out" | sed "s|^|$ts,|" >> "$f"
    fi
    # ---- slot sample: same minute, same lock, own log; failure is contained ----
    out=$(PGCONNECT_TIMEOUT=15 PGOPTIONS='-c statement_timeout=15000' \
          psql -d postgres -tAF',' -c "select slot_name,plugin,slot_type,database,active,xmin,catalog_xmin,restart_lsn,dummy_standby,confirmed_flush from pg_replication_slots order by slot_name" 2>/dev/null)
    if [ "$?" -ne 0 ]; then
        printf '%s,error\n' "$ts" >> "$sf"
    elif [ -z "$out" ]; then
        printf '%s,null\n' "$ts" >> "$sf"
    else
        printf '%s\n' "$out" | sed "s|^|$ts,|" >> "$sf"
    fi
    fi   # end role-aware DB sample
    # ---- OS counters sample: same minute, same lock, own log; /proc reads
    # only (no psql) so it cannot hang; a failed read just writes fewer rows.
    # One awk over seven /proc files; dsk/net rows carry the raw line (fields
    # are space-separated, never contain commas), cpu/pg/mem carry numbers.
    of="$root/os_$(date +%Y%m%d).log"
    awk -v ts="$ts" -v pgkb="$(( $(getconf PAGE_SIZE 2>/dev/null || echo 4096) / 1024 ))" '
        /^cpu /           { if (!cudone) { cu=$2","$3","$4","$5","$6","$7","$8","$9; cudone=1 } }
        /^procs_running / { pr=$2 }
        /^procs_blocked / { pb=$2 }
        /^pgpgin /        { pgi=$2 }
        /^pgpgout /       { pgo=$2 }
        /^pswpin /        { psi=$2 }
        /^pswpout /       { pso=$2 }
        /^pgfault /       { pf=$2 }
        /^pgmajfault /    { pmf=$2 }
        /^MemTotal:/      { mt=$2 }
        /^MemFree:/       { mfr=$2 }
        /^MemAvailable:/  { mav=$2 }
        /^Buffers:/       { buf=$2 }
        /^Cached:/        { cach=$2 }
        /^Slab:/          { slab=$2 }
        /^SwapFree:/      { swf=$2 }
        # zoneinfo watermarks, summed over all zones (pages -> kB via pgkb);
        # EOL-anchored so the per-cpu pageset "high:" lines cannot match
        /^ +pages free +[0-9]+$/ { zf += $3 }
        /^ +min +[0-9]+$/        { zn++; zmin += $2 }
        /^ +low +[0-9]+$/        { zlow += $2 }
        /^ +high +[0-9]+$/       { zhigh += $2 }
        # snmp proto lines (header AND values) are consumed here with `next`
        # so the net/dev rule below can never mistake "Ip:"/"Tcp:" lines
        # (colon-terminated $1, NF>=17) for iface rows; the Tcp VALUES line
        # ($2 numeric) yields the tcp row counters
        /^(Ip|Icmp|IcmpMsg|Tcp|Udp|UdpLite): / {
            if ($1 == "Tcp:" && $2 ~ /^[0-9]+$/) { taop=$6; tpop=$7; tces=$10; tosg=$12; trsg=$13; tcpok=1 }
            next
        }
        # netstat TcpExt/IpExt: header line lays down column names, values line
        # (numeric $2) picks listen/congestion counters; `next` keeps these
        # colon-terminated NF>=17 lines out of the net/dev iface rule below
        $1 == "TcpExt:" || $1 == "IpExt:" {
            if ($1 == "TcpExt:") {
                if ($2 ~ /^[0-9]+$/) {
                    for (i = 2; i <= NF; i++) {
                        if (extn[i] == "ListenDrops") tld = $i
                        else if (extn[i] == "ListenOverflows") tlo = $i
                        else if (extn[i] == "TCPTimeouts") tto = $i
                        else if (extn[i] == "TCPSynRetrans") tsr = $i
                    }
                    extok = 1
                } else { for (i = 2; i <= NF; i++) extn[i] = $i }
            }
            next
        }
        # diskstats line shape: <major> <minor> <name> <14+ counters>, all-numeric
        # fields; skip ramN/loopN (always idle, never rendered, ~24 junk rows/min)
        NF>=14 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 !~ /^(ram|loop)[0-9]+$/ { print "dsk," ts "," $0 }
        # net/dev iface line shape: <iface>: <16 counters> (header lines have no colon-terminated $1)
        $1 ~ /:$/ && NF>=17 { print "net," ts "," $0 }
        END {
            if (cu) print "cpu," ts "," cu "," pr+0 "," pb+0
            if (pgi != "") print "pg," ts "," pgi+0 "," pgo+0 "," psi+0 "," pso+0 "," pf+0 "," pmf+0
            if (mt != "") {
                s = "mem," ts "," mt+0 "," mfr+0 "," mav+0 "," buf+0 "," cach+0 "," slab+0 "," swf+0
                if (zn) s = s "," zf*pgkb "," zmin*pgkb "," zlow*pgkb "," zhigh*pgkb
                print s
            }
            if (tcpok) print "tcp," ts "," taop+0 "," tpop+0 "," tces+0 "," tosg+0 "," trsg+0
            if (extok) print "tcpext," ts "," tld+0 "," tlo+0 "," tto+0 "," tsr+0
        }
    ' /proc/stat /proc/vmstat /proc/meminfo /proc/zoneinfo /proc/diskstats /proc/net/dev /proc/net/snmp /proc/net/netstat >> "$of" 2>/dev/null
    # ---- TCP RTT sample: ss -ti over ESTABLISHED sockets; loopback peers are
    # excluded (their sub-0.1ms rtt would pin rtt_min to ~0 and drown the real
    # network signal). Emits per minute: ONE aggregate ssrtt row (iff >=1
    # qualifying conn) + sspeer rows for the minute's worst connections (top 3
    # by sendq non-zero + top 3 by rtt, deduped) so reports show window PEAKS
    # per peer instead of a single END-snap instant. A missing/unreadable ss
    # writes no rows (renderer hides the RTT tables). Header layout differs by
    # iproute2 age: with State column ($1=ESTAB) vs State-column-less under
    # state filters ($1=Recv-Q numeric); info line carries rtt:a/b (kernel
    # smoothed estimate, ms), cwnd:, retrans:, mss:. p95 via insertion sort
    # (portable awk -- no asort); top-k via repeated max-extraction.
    sscmd=$(command -v ss 2>/dev/null || echo /usr/sbin/ss)
    if [ -x "$sscmd" ]; then
        "$sscmd" -tin state established 2>/dev/null | awk -v ts="$ts" '
            function flushconn() {
                if (peer != "" && keep && gotrtt) {
                    n++; sum += rttv; v[n] = rttv
                    if (minv == "" || rttv < minv) minv = rttv
                    if (rttv > maxv) { maxv = rttv; wp = peer }
                    ci++; cpeer[ci] = peer; clport[ci] = lport; crt[ci] = rttv
                    crtv[ci] = rttvv; ccw[ci] = cwndv + 0; cre[ci] = retrv + 0
                    cmss[ci] = mssv + 0; csq[ci] = sqv + 0
                }
                peer = ""; keep = 0; gotrtt = 0; rttv = rttvv = 0
                cwndv = retrv = mssv = 0
            }
            $1 == "ESTAB" || ($1 ~ /^[0-9]+$/ && NF >= 4) {
                flushconn()
                if ($1 == "ESTAB") { sqv = $3; lport = $4; peer = $5 }
                else              { sqv = $2; lport = $3; peer = $4 }
                sub(/^.*:/, "", lport)
                keep = (peer !~ /^127\./ && peer !~ /^\[::1\]/ && peer !~ /^::1:/)
                next
            }
            {
                if (peer != "" && keep) {
                    if (!gotrtt && match($0, /rtt:[0-9]+\.?[0-9]*\/[0-9]+\.?[0-9]*/)) {
                        split(substr($0, RSTART + 4, RLENGTH - 4), ab, "/")
                        rttv = ab[1] + 0; rttvv = ab[2] + 0; gotrtt = 1
                    }
                    if (!cwndv && match($0, /cwnd:[0-9]+/)) cwndv = substr($0, RSTART + 5, RLENGTH - 5) + 0
                    if (!retrv && match($0, /retrans:[0-9]+\//)) retrv = substr($0, RSTART + 8, RLENGTH - 8) + 0
                    if (!mssv && match($0, /mss:[0-9]+/)) mssv = substr($0, RSTART + 4, RLENGTH - 4) + 0
                }
            }
            END {
                flushconn()
                if (n > 0) {
                    for (i = 2; i <= n; i++) {
                        x = v[i]
                        for (j = i - 1; j >= 1 && v[j] + 0 > x + 0; j--) v[j+1] = v[j]
                        v[j+1] = x
                    }
                    pi = int(n * 0.95); if (pi < 1) pi = 1; if (pi > n) pi = n
                    printf "ssrtt,%s,%d,%.3f,%.3f,%.3f,%.3f,%s,%.3f\n", \
                           ts, n, minv, sum / n, maxv, v[pi], wp, maxv
                }
                # sspeer: top 3 by sendq (non-zero) then top 3 by rtt, deduped
                if (ci > 0) {
                    for (r = 1; r <= 3; r++) {
                        bi = 0; best = 0
                        for (i = 1; i <= ci; i++)
                            if (!used[i] && csq[i] > best) { best = csq[i]; bi = i }
                        if (bi) used[bi] = emit[bi] = 1
                    }
                    for (r = 1; r <= 3; r++) {
                        bi = 0; best = -1
                        for (i = 1; i <= ci; i++)
                            if (!used[i] && crt[i] > best) { best = crt[i]; bi = i }
                        if (bi) used[bi] = emit[bi] = 1
                    }
                    for (i = 1; i <= ci; i++) if (emit[i])
                        printf "sspeer,%s,%s,%s,%.3f,%.3f,%d,%d,%d,%d\n", \
                               ts, cpeer[i], clport[i], crt[i], crtv[i], \
                               ccw[i], cre[i], cmss[i], csq[i]
                }
            }
        ' >> "$of" 2>/dev/null
    fi
    # ---- gzip past days' os logs (~10x smaller on these repetitive lines;
    # the renderer reads both os_*.log and os_*.log.gz). Today's file stays
    # plain so the per-minute append keeps working. ----
    today=$(date +%Y%m%d)
    for og in "$root"/os_*.log; do
        [ -f "$og" ] || continue
        od8=$(basename "$og" .log); od8="${od8#os_}"
        case "$od8" in
            [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
            *) continue;;
        esac
        [ "$od8" -lt "$today" ] && gzip -f "$og" 2>/dev/null
    done
    return 0
}

# _awr_snap [--root <dir>]  -- allocate snap_id, collect, write meta. The core
# primitive used by both manual `create` and the cron-fired `create`.
# _awr_db_up  -- cheap DB reachability probe: one psql connect + select 1,
# bounded by PGCONNECT_TIMEOUT so a blackholed network fails in 15s, not the
# kernel's ~127s SYN retries. Used by _awr_snap to gate BEFORE any snap work.
_awr_db_up() {
    PGCONNECT_TIMEOUT=15 PGOPTIONS="-c statement_timeout=60000" \
        psql -d postgres -tAc "select 1" >/dev/null 2>&1
}

_awr_snap() {
    umask 077   # snapshots carry SQL literals: force 0700/0600 regardless of caller umask
    local root_override=""
    if [ "${1:-}" = "--root" ]; then root_override="${2:-}"; shift 2; fi
    local root; root="${root_override:-$(_awr_root)}"
    mkdir -p "$root" 2>/dev/null || { echo "Error: cannot create $root" >&2; return 1; }
    # Non-blocking mutual exclusion (kernel flock on a lockfile, shared across
    # the manual foreground run and the cron-fired runs): a previous create
    # still in flight (e.g. DB unreachable, hanging inside the probe) means
    # this run exits immediately -- no overlapping collectors, no duplicated
    # snap work. fd 9 is inherited by every psql below, so the lock covers the
    # whole collection.
    exec 9>"$root/create.lock"
    if ! flock -n 9; then
        echo "Error: another awr create is still running (lock $root/create.lock) -- try again later" >&2
        return 1
    fi
    # DB must be UP before ANY snap work (user decision 2026-09-03): no
    # snap_id consumed, no dir created, no OS collection, nothing to clean up.
    # _awr_collect keeps its own probe as a second guard (DB can die during
    # the ~5-10s collection window) -- that path removes the in-flight dir.
    if ! _awr_db_up; then
        echo "Error: cannot reach the database (port ${PGPORT:-5432}) -- snapshot NOT taken" >&2
        return 1
    fi
    local sid ts ts_ep dir
    sid=$(_awr_next_id) || return 1
    dir="$root/snap_$sid"
    rm -rf "$dir" 2>/dev/null
    mkdir -p "$dir" 2>/dev/null || { echo "Error: cannot create $dir" >&2; return 1; }
    ts=$(date '+%F %T'); ts_ep=$(date +%s)
    echo "==> capturing snap $sid  ->  $dir"
    # collection failed midway (e.g. DB died during collection): discard the
    # in-flight dir -- a snap without db/ data would poison awr list/reports.
    if ! _awr_collect "$dir"; then
        rm -rf "$dir" 2>/dev/null
        echo "  [WARN] snap $sid skipped, nothing kept (collection failed)" >&2
        return 1
    fi
    _awr_write_meta "$dir" "$sid" "$ts" "$ts_ep"
    echo "==> snap $sid captured at $ts"
    _awr_purge_expired
    return 0
}

# awr create -- manual single-point snapshot (foreground, no -d, no html).
_awr_create() {
    local root_override=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --root)    [ $# -lt 2 ] && { echo "Error: --root requires a path" >&2; return 2; }
                       root_override="$2"; shift 2;;
            -h|--help) awr_help; return 0;;
            -d)        echo "Error: 'awr create' is a single-point snapshot (no -d). Use 'awr config interval <min>' + 'awr enable' for periodic capture." >&2; return 2;;
            --force)   echo "Error: --force not applicable to single-point snapshots" >&2; return 2;;
            *)         echo "Error: unexpected argument '$1' (awr create takes no name / no -d)" >&2; return 2;;
        esac
    done
    _awr_snap ${root_override:+--root "$root_override"}
}

# _awr_check_uptime <id1> <id2>  -- error+return 1 if the two snaps span a DB
# restart (cumulative counters reset; end-begin meaningless). db_start_time =
# pg_postmaster_start_time(). Lenient: skipped if either snap lacks the field.
_awr_check_uptime() {
    local id1="$1" id2="$2"
    local d1 d2 s1 s2
    command -v python3 >/dev/null 2>&1 || { echo "Error: python3 required for restart guard (cannot read meta.json)" >&2; return 1; }
    d1="$(_awr_root)/snap_$id1"; d2="$(_awr_root)/snap_$id2"
    s1=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('db_start_time',''))" "$d1/meta.json" 2>/dev/null)
    s2=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('db_start_time',''))" "$d2/meta.json" 2>/dev/null)
    if [ -n "$s1" ] && [ -n "$s2" ] && [ "$s1" != "$s2" ]; then
        echo "Error: DB restarted between snap $id1 and snap $id2 -- cumulative counters reset, no valid diff." >&2
        echo "       snap $id1 db_start_time: $s1" >&2
        echo "       snap $id2 db_start_time: $s2" >&2
        echo "       (pick snaps within the same DB uptime, or recreate after the restart)" >&2
        return 1
    fi
    return 0
}

# awr summary|event|topsql|tabstat -- wdr-style SCREEN analytics from existing
# snap CSVs (no html, no DB connection). One row per consecutive snapshot pair
# inside the window; defaults to the latest two snaps.
_awr_text() {
    local mode="$1"; shift
    local begin_id="" end_id="" top_n=10 order="elapsed" db="" schema="" table=""
    local OPTIND=1
    while getopts ":b:e:n:t:d:s:" opt; do
        case $opt in
            b) begin_id="$OPTARG" ;;
            e) end_id="$OPTARG" ;;
            n) top_n="$OPTARG" ;;
            t) if [ "$mode" = "tabstat" ]; then table="$OPTARG"; else order="$OPTARG"; fi ;;
            d) db="$OPTARG" ;;
            s) schema="$OPTARG" ;;
            \?) echo "Error: invalid option -$OPTARG for 'awr $mode'" >&2; return 2 ;;
            :)  echo "Error: option -$OPTARG requires an argument" >&2; return 2 ;;
        esac
    done
    if [ "$mode" = "tabstat" ]; then
        if [ -z "$db" ] || [ -z "$schema" ] || [ -z "$table" ]; then
            echo "Error: 'awr tabstat' requires -d <db> -s <schema> -t <table>" >&2
            return 2
        fi
    else
        table=""
    fi
    if ! [[ "$top_n" =~ ^[0-9]+$ ]] || [ "$top_n" -lt 1 ] || [ "$top_n" -gt 100 ]; then
        echo "Error: -n must be an integer between 1 and 100" >&2; return 2
    fi
    if [ "$mode" = "topsql" ]; then
        case "$order" in elapsed|cpu|io) ;; *) echo "Error: -t must be elapsed|cpu|io" >&2; return 2;; esac
    fi
    local root; root=$(_awr_root)
    local tmp; tmp=$(mktemp /tmp/vb_tool_awr_text.XXXXXX.py) 2>/dev/null
    if [ -z "$tmp" ]; then echo "  [ERROR] mktemp failed" >&2; return 1; fi
    cat > "$tmp" <<'VB_AWR_TEXT_PY'
#!/usr/bin/env python3
"""awr screen analytics: summary / event / topsql / tabstat.

Reads snap dirs under <root>/snap_<id>/ (meta.json + db/*.csv[.gz]), computes
per-consecutive-pair counter deltas and prints wdr-style text tables.
Dependency-free stdlib only; embedded as heredoc in vb_tool."""
import csv, gzip, json, os, sys, glob, time, datetime

def read_csv_rows(path):
    for fn, opener in ((path + ".gz", gzip.open), (path, open)):
        if os.path.isfile(fn):
            try:
                with opener(fn, "rt", errors="replace", newline="") as f:
                    return list(csv.DictReader(f))
            except Exception:
                return []
    return []

def to_num(v):
    if v is None or v == "":
        return None
    try:
        return float(str(v).strip())
    except Exception:
        return None

def load_snap(d):
    meta = {}
    mp = os.path.join(d, "meta.json")
    if os.path.isfile(mp):
        try: meta = json.load(open(mp))
        except Exception: meta = {}
    return meta

def snap_list(root, begin_id, end_id):
    out = []
    for d in sorted(glob.glob(os.path.join(root, "snap_*")), key=lambda p: _sid(p)):
        m = load_snap(d)
        sid = m.get("snap_id")
        if sid is None:
            continue
        out.append((int(sid), m, d))
    if not out:
        return []
    lo = int(begin_id) if begin_id else None
    hi = int(end_id) if end_id else None
    sel = [t for t in out if (lo is None or t[0] >= lo) and (hi is None or t[0] <= hi)]
    if not sel:
        return []
    if len(sel) == 1 and (lo is None or hi is None):
        # only one snap in window: fall back to the pair around it if possible
        i = out.index(sel[0])
        if i + 1 < len(out):
            sel = out[i:i + 2]
        elif i > 0:
            sel = out[i - 1:i + 1]
    return sel

def _sid(p):
    try: return int(p.rsplit("_", 1)[1])
    except Exception: return 0

def db_rows(d, name):
    return read_csv_rows(os.path.join(d, "db", name + ".csv"))

def _sum(rows, col):
    t = 0.0
    any_v = False
    for r in rows:
        v = to_num(r.get(col))
        if v is not None:
            t += v; any_v = True
    return t if any_v else None

def _row_by(rows, keycol, key):
    for r in rows:
        if str(r.get(keycol, "")) == key:
            return r
    return None

def _delta(a, b):
    if a is None or b is None:
        return None
    d = b - a
    return d if d >= 0 else None   # negative = counter reset/rewind -> blank

def _ts(meta):
    ep = to_num(meta.get("ts_epoch"))
    if ep:
        return datetime.datetime.fromtimestamp(ep)
    try:
        return datetime.datetime.strptime(str(meta.get("ts", ""))[:19], "%Y-%m-%d %H:%M:%S")
    except Exception:
        return None

def time_range(m1, m2):
    t1, t2 = _ts(m1), _ts(m2)
    if not t1 or not t2:
        return "?"
    if t1.date() == t2.date():
        return "%s %s-%s" % (t1.strftime("%m%d"), t1.strftime("%H:%M"), t2.strftime("%H:%M"))
    return "%s %s-%s %s" % (t1.strftime("%m%d"), t1.strftime("%H:%M"), t2.strftime("%m%d"), t2.strftime("%H:%M"))

def _it(d, stat):
    r = _row_by(db_rows(d, "instance_time"), "stat_name", stat)
    return to_num(r.get("value")) if r else None

def _pairs(snaps):
    return [(snaps[i], snaps[i + 1]) for i in range(len(snaps) - 1)]

# ---- wdr-style table renderer (psql aligned look) ----
def psql_table(headers, rows, num_cols):
    cells = []
    for r in rows:
        cells.append(["" if v is None else str(v) for v in r])
    widths = [len(h) for h in headers]
    for c in cells:
        for i, v in enumerate(c):
            widths[i] = max(widths[i], len(v))
    sep = "-+-".join("-" * w for w in widths)
    out = [" | ".join((h.rjust(widths[i]) if i in num_cols else h.ljust(widths[i])) for i, h in enumerate(headers)),
           sep]
    for c in cells:
        out.append(" | ".join((v.rjust(widths[i]) if i in num_cols else v.ljust(widths[i])) for i, v in enumerate(c)))
    return "\n".join(out)

def _fmt(v, nd=1):
    if v is None:
        return ""
    if nd == 0:
        return "%d" % round(v)
    return "%.1f" % v

# ---- modes ----
def do_summary(snaps):
    rows = []
    for (i1, m1, d1), (i2, m2, d2) in _pairs(snaps):
        t1, t2 = to_num(m1.get("ts_epoch")), to_num(m2.get("ts_epoch"))
        el = (t2 - t1) if (t1 and t2 and t2 > t1) else None
        dbt = _delta(_it(d1, "DB_TIME"), _it(d2, "DB_TIME"))
        cpu = _delta(_it(d1, "CPU_TIME"), _it(d2, "CPU_TIME"))
        iot = _delta(_it(d1, "DATA_IO_TIME"), _it(d2, "DATA_IO_TIME"))
        da, db_ = db_rows(d1, "database"), db_rows(d2, "database")
        xact = _delta(_sum(da, "xact_commit") + _sum(da, "xact_rollback"),
                      _sum(db_, "xact_commit") + _sum(db_, "xact_rollback"))
        cr = _delta(_sum(da, "blks_read") + _sum(da, "blks_hit"),
                    _sum(db_, "blks_read") + _sum(db_, "blks_hit"))
        sa, sb = db_rows(d1, "statement"), db_rows(d2, "statement")
        calls = _delta(_sum(sa, "n_calls"), _sum(sb, "n_calls"))
        parse = _delta(_sum(sa, "n_soft_parse"), _sum(sb, "n_soft_parse"))
        hard = _delta(_sum(sa, "n_hard_parse"), _sum(sb, "n_hard_parse"))
        def rate(v):
            return (v / el) if (v is not None and el) else None
        rows.append([time_range(m1, m2),
                     _fmt(dbt / 60e6 if dbt is not None else None),
                     _fmt(dbt / 1e6 / el if (dbt is not None and el) else None),
                     _fmt(cpu / 60e6 if cpu is not None else None),
                     _fmt(iot / 60e6 if iot is not None else None),
                     _fmt(rate(xact)), _fmt(rate(cr)),
                     _fmt(rate(calls)), _fmt(rate(parse)), _fmt(rate(hard))])
    rows.reverse()
    print("====================")
    print("awr workload summary")
    print("====================")
    print(psql_table(["time_range", "dbtime", "aas", "cputime", "iotime", "tps",
                     "cr/s", "call/s", "parse/s", "hard/s"], rows,
                    set(range(1, 10))))

def do_event(snaps, top_n):
    rows = []
    for (i1, m1, d1), (i2, m2, d2) in _pairs(snaps):
        dbt = _delta(_it(d1, "DB_TIME"), _it(d2, "DB_TIME"))
        cpu = _delta(_it(d1, "CPU_TIME"), _it(d2, "CPU_TIME"))
        we1 = {(r.get("event") or ""): r for r in db_rows(d1, "wait_events")}
        we2 = {(r.get("event") or ""): r for r in db_rows(d2, "wait_events")}
        evs = []
        for ev, r2 in we2.items():
            if not ev or ev in ("none", "wait cmd"):
                continue
            r1 = we1.get(ev)
            w1 = to_num(r1.get("total_wait_time")) if r1 else None
            w2 = to_num(r2.get("total_wait_time"))
            c1 = to_num(r1.get("wait")) if r1 else None
            c2 = to_num(r2.get("wait"))
            wt = _delta(w1, w2)
            wc = _delta(c1, c2)
            if wt is None or wt <= 0:
                continue
            evs.append([ev, r2.get("type") or "", wc, wt])
        if cpu is not None and cpu > 0:
            evs.append(["CPU time", "", None, cpu])
        evs.sort(key=lambda e: -e[3])
        for ev, ty, wc, wt in evs[:top_n]:
            avg = (wt / wc / 1e3) if (wc is not None and wc > 0) else None
            pct = (100.0 * wt / dbt) if (dbt is not None and dbt > 0) else None
            rows.append([time_range(m1, m2),
                         _fmt(dbt / 1e6 if dbt is not None else None),
                         ev, ty,
                         _fmt(wc, 0) if wc is not None else "",
                         _fmt(wt / 1e6), _fmt(avg),
                         ("%s%%" % _fmt(pct)) if pct is not None else ""])
        rows.append(["", "", "", "", "", "", "", ""])
    rows.reverse()
    print("====================")
    print("awr topevent summary")
    print("====================")
    print(psql_table(["time_range", "db_time_s", "event", "type", "waits",
                     "wait_s", "avg_wait_ms", "db_time_pct"], rows,
                    {1, 4, 5, 6, 7}))

def _sql_key(r):
    return (r.get("user_name") or "", str(r.get("unique_sql_id") or ""))

def do_topsql(snaps, top_n, order):
    rows = []
    texts = {}
    shown = {}
    oi = {"elapsed": 3, "cpu": 4, "io": 5}[order]
    for (i1, m1, d1), (i2, m2, d2) in _pairs(snaps):
        s1 = {}
        for r in db_rows(d1, "statement"):
            s1[_sql_key(r)] = r
        agg = []
        denom = 0.0
        for r2 in db_rows(d2, "statement"):
            k = _sql_key(r2)
            r1 = s1.get(k)
            g = lambda c: _delta((to_num(r1.get(c)) if r1 else None), to_num(r2.get(c)))
            calls = g("n_calls")
            tt = g("total_elapse_time")
            if calls is None or calls <= 0 or tt is None:
                continue
            q = r2.get("query") or ""
            texts.setdefault(k[1], " ".join(q.split())[:80])
            et, cp, io = g("execution_time"), g("cpu_time"), g("data_io_time")
            cr, pr = g("n_blocks_hit"), g("n_blocks_fetched")
            vals = [tt / 1e3, et / 1e3 / calls if et is not None else None,
                    cp / 1e3 / calls if cp is not None else None,
                    io / 1e3 / calls if io is not None else None,
                    cr / calls if cr is not None else None,
                    pr / calls if pr is not None else None]
            agg.append([k[0], k[1], calls, tt, cp, io, pr] + vals)
            denom += tt
        agg.sort(key=lambda a: -(a[oi] if a[oi] is not None else -1))
        tr = time_range(m1, m2)
        for a in agg[:top_n]:
            pct = (100.0 * a[3] / denom) if denom > 0 else None
            rows.append([tr, a[0], a[1], _fmt(a[2], 0), _fmt(a[6], 0),
                         _fmt(a[7]), _fmt(a[8]), _fmt(a[9]), _fmt(a[10]),
                         _fmt(a[11]), _fmt(a[12]),
                         ("%s%%" % _fmt(pct)) if pct is not None else ""])
            shown[a[1]] = texts.get(a[1], "")
        rows.append([""] * 12)
    rows.reverse()
    print("====================")
    print("   awr topsql    ")
    print("====================")
    print(psql_table(["time_range", "uname", "sql_id", "calls", "total_pr",
                     "avg_tt_ms", "avg_et_ms", "avg_cpu_ms", "avg_io_ms",
                     "avg_cr", "avg_pr", "pct%"], rows, set(range(3, 12))))
    if shown:
        print("")
        print("top sql text (first 80 chars):")
        for sid, q in shown.items():
            print("  %s  %s" % (sid, q))

def do_tabstat(snaps, db, schema, table):
    rows = []
    for (i1, m1, d1), (i2, m2, d2) in _pairs(snaps):
        r1 = _row_by([r for r in db_rows(d1, "object_tables") if r.get("dbname") == db
                      and r.get("schema") == schema and r.get("object") == table], "object", table) \
             if False else None
        o1 = [r for r in db_rows(d1, "object_tables") if r.get("dbname") == db
              and r.get("schema") == schema and r.get("object") == table]
        o2 = [r for r in db_rows(d2, "object_tables") if r.get("dbname") == db
              and r.get("schema") == schema and r.get("object") == table]
        if not o1 or not o2:
            continue
        a, b = o1[0], o2[0]
        d = lambda c: _delta(to_num(a.get(c)), to_num(b.get(c)))
        t2s = _ts(m2)
        rows.append([(t2s.strftime("%Y-%m-%d %H:%M:%S") if t2s else "?"),
                     _fmt(d("seq_scan"), 0), _fmt(d("idx_scan"), 0),
                     _fmt(d("n_tup_ins"), 0), _fmt(d("n_tup_upd"), 0),
                     _fmt(d("n_tup_del"), 0), _fmt(d("n_tup_hot_upd"), 0),
                     _fmt(to_num(b.get("n_live_tup")), 0), _fmt(to_num(b.get("n_dead_tup")), 0)])
    rows.reverse()
    print("=========================")
    print("   awr tabstat summary   ")
    print("=========================")
    print("  db: %s  schema: %s  table: %s" % (db, schema, table))
    print("                         ")
    if not rows:
        print("(no snapshot saw this table -- check -d/-s/-t and 'awr list')")
        return
    print(psql_table(["start_ts", "seqscan", "idxscan", "ins", "upd", "del",
                     "hotupd", "alive", "dead"], rows, set(range(1, 9))))

def main():
    if len(sys.argv) < 3:
        print("internal error: awr_text argv", file=sys.stderr); sys.exit(2)
    mode, root = sys.argv[1], sys.argv[2]
    begin_id = sys.argv[3] or None
    end_id = sys.argv[4] or None
    top_n = int(sys.argv[5] or "10")
    order = sys.argv[6] or "elapsed"
    db, schema, table = sys.argv[7], sys.argv[8], sys.argv[9]
    snaps = snap_list(root, begin_id, end_id)
    if len(snaps) < 2:
        print("Error: need at least 2 snapshots under %s (got %d); try 'awr create' first"
              % (root, len(snaps)), file=sys.stderr)
        sys.exit(1)
    if mode == "summary":
        do_summary(snaps)
    elif mode == "event":
        do_event(snaps, top_n)
    elif mode == "topsql":
        do_topsql(snaps, top_n, order)
    elif mode == "tabstat":
        do_tabstat(snaps, db, schema, table)
    else:
        print("internal error: mode %s" % mode, file=sys.stderr); sys.exit(2)

if __name__ == "__main__":
    main()
