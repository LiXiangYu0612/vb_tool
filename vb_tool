    local previous_timestamp="" previous_rx_errors="" previous_rx_bytes="" previous_rx_dropped="" previous_rx_overrun=""
    local previous_tx_bytes="" previous_tx_errors="" previous_tx_dropped=""
    local current_timestamp="" current_rx_errors="" current_rx_bytes="" current_rx_dropped="" current_rx_overrun=""
    local current_tx_bytes="" current_tx_errors="" current_tx_dropped=""
    local prev_tcp_retrans_value=0 prev_syn_retrans_value=0 prev_lost_retrans_value=0 prev_ip_reasm_fails_value=0
    local tcp_retrans_value=0 syn_retrans_value=0 lost_retrans_value=0 ip_reasm_fails_value=0
    local in_interface_block=false
    local blocks_seen=0 rows_emitted=0
    local line new_timestamp data_line

    _osw_netstat_convert_ts() {
        # input: "Thu Aug 17 03:00:14 CST 2026" (inside zzz ***...***)
        local parsed_ts
        parsed_ts=$(echo "$1" | awk '{print $2" "$3" "$6" "$4}')
        date -d "$parsed_ts" +"%Y-%m-%d %H:%M:%S" 2>/dev/null
    }

    _osw_netstat_emit() {
        local rx_error_increment=$((current_rx_errors - previous_rx_errors))
        local rx_byte_increment=$((current_rx_bytes - previous_rx_bytes))
        local rx_dropped_increment=$((current_rx_dropped - previous_rx_dropped))
        local rx_overrun_increment=$((current_rx_overrun - previous_rx_overrun))
        local tx_byte_increment=$((current_tx_bytes - previous_tx_bytes))
        local tx_error_increment=$((current_tx_errors - previous_tx_errors))
        local tx_dropped_increment=$((current_tx_dropped - previous_tx_dropped))
        local tcp_retrans_increment=$((tcp_retrans_value - prev_tcp_retrans_value))
        local syn_retrans_increment=$((syn_retrans_value - prev_syn_retrans_value))
        local lost_retrans_increment=$((lost_retrans_value - prev_lost_retrans_value))
        local ip_reasm_increment=$((ip_reasm_fails_value - prev_ip_reasm_fails_value))
        # counter reset/restart (negative delta) -> show 0, not a bogus negative
        (( rx_byte_increment    < 0 )) && rx_byte_increment=0
        (( rx_error_increment   < 0 )) && rx_error_increment=0
        (( rx_dropped_increment < 0 )) && rx_dropped_increment=0
        (( rx_overrun_increment < 0 )) && rx_overrun_increment=0
        (( tx_byte_increment    < 0 )) && tx_byte_increment=0
        (( tx_error_increment   < 0 )) && tx_error_increment=0
        (( tx_dropped_increment < 0 )) && tx_dropped_increment=0
        (( tcp_retrans_increment  < 0 )) && tcp_retrans_increment=0
        (( syn_retrans_increment   < 0 )) && syn_retrans_increment=0
        (( lost_retrans_increment  < 0 )) && lost_retrans_increment=0
        (( ip_reasm_increment      < 0 )) && ip_reasm_increment=0
