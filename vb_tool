                parts.append('<tr><td>TCP %s</td><td class="n">%d</td>'
                             '<td class="n">%d</td><td class="n">%+d</td></tr>'
                             % (esc(_ts.title()), _b, _e, _e - _b))
        if _fdb or _fde:
            # v2.5.6 (user): top rows = professional fd TYPE, lowercase --
