# one-shot installer (user 2026-09-20: deployer runs ONCE, every later user
# does NOTHING -- TAB just works). bash requires the completion to be
# registered in each shell; a child process cannot inject into a running
# shell, so we plant the registration where shells pick it up themselves:
#   root:   /etc/profile.d/vb_tool_completion.sh (embedded body, all users,
#           all login shells, covers ./vb_tool too) + /usr/local/bin symlink
#   pkg:    ~/.local/share/bash-completion/completions/vb_tool (lazy load,
#           no bashrc edit, needs the bash-completion package)
#   always: ~/.bashrc one source line (guaranteed fallback)
vb_tool_completion_install() {
    local self dir rc_file did=""
    self=$(readlink -f "${BASH_SOURCE[0]:-$0}" 2>/dev/null) || self=""
    [ -n "$self" ] || self="$0"
    if [ "$(id -u)" = "0" ]; then
        if mkdir -p /etc/profile.d 2>/dev/null \
           && vb_tool_completion > /etc/profile.d/vb_tool_completion.sh 2>/dev/null; then
            chmod 644 /etc/profile.d/vb_tool_completion.sh
            did="${did}  [system] /etc/profile.d/vb_tool_completion.sh (ALL users, incl ./vb_tool)
"
        fi
        if [ -d /usr/local/bin ] && ln -sf "$self" /usr/local/bin/vb_tool 2>/dev/null; then
            did="${did}  [system] /usr/local/bin/vb_tool -> $self (PATH: vb_tool fl<TAB>)
"
        fi
    fi
    dir="$HOME/.local/share/bash-completion/completions"
    if mkdir -p "$dir" 2>/dev/null && vb_tool_completion > "$dir/vb_tool" 2>/dev/null; then
        did="${did}  [user]   $dir/vb_tool (lazy load, no bashrc edit)
"
    fi
    rc_file="$HOME/.bashrc"
    touch "$rc_file" 2>/dev/null
    if ! grep -qF "source <($self completion)" "$rc_file" 2>/dev/null; then
        printf '\n# vb_tool TAB completion (vb_tool completion --install)\nsource <(%s completion)\n' "$self" >> "$rc_file"
        did="${did}  [user]   $rc_file (guaranteed fallback)
"
    fi
    if [ -z "$did" ]; then
        echo "Error: nothing could be installed (no writable location)" >&2
        return 1
    fi
    echo "TAB completion installed:"
    echo "$did" | sed '/^$/d'
    echo "activate now: source ~/.bashrc (or new login shell); future shells need nothing."
    return 0
}
