# event_text 另外单独处理，不在这个一行输出的列表里
_SH_COLS = [
    'db_name', 'schema_name', 'application_name', 'client_addr',
    'start_time', 'finish_time', 'session_id',
    'n_soft_parse', 'n_hard_parse', 'n_returned_rows',
    'n_tuples_fetched', 'n_tuples_returned', 'n_blocks_hit',
    'cpu_time', 'execution_time', 'parse_time', 'data_io_time',
    'net_send_info', 'net_recv_info', 'lock_time',
]


def _gz_b64_text(text):
    """将文本 UTF-8 编码后 gzip 压缩,再 Base64 编码,用于内嵌进 HTML data 属性。

    与报告生成函数内部的 _gz_b64 逻辑一致，提到模块级供汇总信息等非报告上下文复用。
    """
    if not text:
        return ''
    return base64.b64encode(gzip.compress(text.encode('utf-8'), compresslevel=6)).decode('ascii')


def _build_wait_events_query(ids_csv, start_str=None, end_str=None):
    """构造等待事件查询 SQL。

    每个 unique_query_id 取最大/最小执行时间点各一条记录（执行时间并列时
    按 start_time 决胜，保证是两条不同记录）; 输出业务列 + query_plan +
    statement_detail_decode 解码的等待事件。to_jsonb 单行 JSON 避免换行破坏解析；
    pick 标签以 chr(1) 前缀拼在 JSON 前（jsonb_build_object 在部分库不可用）。

    Args:
        ids_csv: 逗号分隔的 unique_query_id 列表
        start_str/end_str: 时间过滤边界；为 None 时不加时间过滤（兜底查询）
    """
    cols = ',\n         '.join('h.' + c for c in _SH_COLS)
    time_filter = ''
    if start_str and end_str:
        time_filter = (f"\n    AND h.start_time >= '{start_str}'"
                       f"\n    AND h.start_time <= '{end_str}'")
    return (
        "WITH ranked AS (\n"
        "  SELECT h.unique_query_id,\n"
        f"         {cols},\n"
        "         h.query_plan,\n"
        "         pg_catalog.statement_detail_decode(h.details, 'plaintext', true) AS event_text,\n"
        "         ROW_NUMBER() OVER (PARTITION BY h.unique_query_id\n"
        "                          ORDER BY h.execution_time DESC, h.start_time DESC) AS rn_max,\n"
        "         ROW_NUMBER() OVER (PARTITION BY h.unique_query_id\n"
        "                          ORDER BY h.execution_time ASC,  h.start_time ASC)  AS rn_min\n"
        "  FROM dbe_perf.statement_history h\n"
        f"  WHERE h.unique_query_id IN ({ids_csv}){time_filter}\n"
        ")\n"
        "SELECT (CASE WHEN rn_max = 1 THEN 'max' ELSE 'min' END) ||\n"
        "       chr(1) || (to_jsonb(ranked) - 'rn_max' - 'rn_min')::text\n"
        "FROM ranked\n"
        "WHERE rn_max = 1 OR rn_min = 1\n"
        "ORDER BY unique_query_id, CASE WHEN rn_max = 1 THEN 'max' ELSE 'min' END DESC;"
    )


def query_wait_events_for_sql_ids(sql_ids, start_time, end_time, batch_size=500, timeout=120, debug=False):
    """通过 vsql -d postgres 查询慢SQL的等待事件信息（最大/最小执行时间点各一条）。

    每条记录包含: 指定的 statement_history 业务列(见 _SH_COLS) + query_plan +
    event_text(statement_detail_decode 解码的等待事件) + pick(max/min 标签)。
    若按日志时间范围查不到数据，自动去掉时间过滤兜底重查一次（statement_history
    保留周期/时钟偏差都可能导致时间窗口内查不到）。

    Args:
        sql_ids: 可迭代的 unique_query_id 集合
        start_time: 分析开始时间 (datetime)
        end_time: 分析结束时间 (datetime)
        batch_size: 每批查询的 ID 数量，避免 IN (...) 过长
        timeout: 单次 vsql 调用超时时间（秒）
        debug: 是否打印实际执行的 SQL 命令

    Returns:
        tuple: (wait_events_dict, warning_message)
            - wait_events_dict: {sql_id: [records]}
            - warning_message: 连接失败或无数据时返回警告字符串，否则为 None
    """
    # 仅保留数值型 ID，避免非数值 ID 进入 SQL 造成语法错误或注入
    valid_ids = []
    for sid in sql_ids:
        s = str(sid).strip()
        try:
            int(s)
            valid_ids.append(s)
        except (ValueError, TypeError):
            continue

    if not valid_ids:
        if debug:
            print("[DEBUG] wait events: 无有效 SQL ID", file=sys.stderr)
        return {}, "没有有效的数值型 SQL ID 可查询等待事件"

    # 检查 vsql 是否可用
    try:
        test_proc = subprocess.Popen(
            ['vsql', '--version'],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            universal_newlines=True
        )
        test_proc.communicate()
    except FileNotFoundError:
        return {}, "无法连接数据库（未找到 vsql 命令），未查询等待事件信息"

    start_str = start_time.strftime('%Y-%m-%d %H:%M:%S') if hasattr(start_time, 'strftime') else str(start_time)
    end_str = end_time.strftime('%Y-%m-%d %H:%M:%S') if hasattr(end_time, 'strftime') else str(end_time)

    # A3: 分批查询，避免单条 SQL IN (...) 过长
    total_ids = len(valid_ids)
    batches = [valid_ids[i:i + batch_size] for i in range(0, total_ids, batch_size)]
    wait_events = {}
    stderr_warnings = []

    for batch_idx, batch_ids in enumerate(batches, 1):
        ids_csv = ','.join(batch_ids)
        if len(batches) > 1:
            print(f"[进度] 等待事件分批查询: 第 {batch_idx}/{len(batches)} 批, 本批 {len(batch_ids)} 个 ID", file=sys.stderr)
        if debug:
            print(f"[DEBUG] wait events: 批次 {batch_idx}/{len(batches)}, 时间范围=({start_str} ~ {end_str}), IDs={batch_ids[:5]}{'...' if len(batch_ids) > 5 else ''}", file=sys.stderr)

        # 两轮尝试: 先按日志时间范围过滤; 查不到则去掉时间过滤兜底重查
        batch_hit = 0
        for attempt, (q_start, q_end, tag) in enumerate([
                (start_str, end_str, '按日志时间范围'),
                (None, None, '不限时间(兜底)')], 1):
            query = _build_wait_events_query(ids_csv, q_start, q_end)
            if debug:
                print(f"[DEBUG] wait events 执行命令({tag}): vsql -d postgres -q -A -t -c <query>", file=sys.stderr)
                print(f"[DEBUG] wait events 完整 SQL({tag}):\n{query}", file=sys.stderr)
            try:
                process = subprocess.Popen(
                    ['vsql', '-d', 'postgres', '-q', '-A', '-t', '-c', query],
                    stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                    universal_newlines=True
                )
                # A2: 超时保护，避免极端情况下脚本长时间阻塞
                stdout, stderr = process.communicate(timeout=timeout)
            except FileNotFoundError:
                return {}, "无法连接数据库（未找到 vsql 命令），未查询等待事件信息"
            except subprocess.TimeoutExpired:
                process.kill()
                process.communicate()
                warning = f"查询等待事件超时（>{timeout}s），已终止该批次查询"
                print(f"WARNING: {warning}")
                stderr_warnings.append(warning)
                break
            except Exception as e:
                warning = f"查询等待事件时发生错误: {str(e)}"
                print(f"WARNING: {warning}")
                stderr_warnings.append(warning)
                break

            if process.returncode != 0:
                warning = f"查询等待事件失败: {stderr.strip()}"
                print(f"WARNING: {warning}")
                stderr_warnings.append(warning)
                break

            # A4: returncode=0 但 stderr 非空时打印 WARNING（NOTICE 等信息不阻断）
            stderr_text = (stderr or '').strip()
            if stderr_text:
                print(f"WARNING: vsql stderr 输出: {stderr_text}", file=sys.stderr)
                stderr_warnings.append(f"vsql stderr: {stderr_text}")

            for line in stdout.strip().split('\n'):
                line = line.strip()
                if not line:
                    continue
                try:
                    # 行格式: "max|min" + chr(1) + JSON 记录（jsonb_build_object 不可用的替代方案）
                    pick, _, payload = line.partition('\x01')
                    record = json.loads(payload if payload else line)
                    if pick in ('max', 'min'):
                        record['pick'] = pick
                    uid = str(record.get('unique_query_id', '')).strip()
                    if uid:
                        wait_events.setdefault(uid, []).append(record)
                        batch_hit += 1
                except json.JSONDecodeError:
                    continue

            if debug:
                print(f"[DEBUG] wait events: 批次 {batch_idx} ({tag}) 命中 {batch_hit} 条记录", file=sys.stderr)
            if batch_hit > 0:
                break  # 有数据就不再兜底重查
            if attempt == 1 and debug:
                print(f"[DEBUG] wait events: 批次 {batch_idx} 时间范围内无数据, 去掉时间过滤重查", file=sys.stderr)

    if not wait_events:
        base_msg = (f"已查询 {total_ids} 个 SQL ID 的等待事件信息，但未找到任何数据"
                    f"（已尝试: 日志时间范围 {start_str} 至 {end_str} + 不限时间兜底）")
        if stderr_warnings:
            base_msg += f"；期间发生 {len(stderr_warnings)} 个警告"
        return {}, base_msg

    print(f"等待事件查询完成: {len(wait_events)}/{total_ids} 个 SQL ID 找到数据")
    if stderr_warnings:
        # 有数据但也有警告，把警告透传给报告（不阻断）
        return wait_events, f"部分批次查询出现警告（共 {len(stderr_warnings)} 条），已尽力获取数据"
    return wait_events, None


