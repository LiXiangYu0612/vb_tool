    _cgb2 = parse_db_cgroup(win["os"].get(("begin", "db_cgroup"), ""))
    _cge2 = parse_db_cgroup(win["os"].get(("end", "db_cgroup"), ""))
    if _cge2 or _cgb2:
        sub("Cgroup")
        _grp = (_cge2 or _cgb2).get("paths", {}).get("cpu") or ""
        h = ['<table class="t"><tr><th>Metric%s</th><th class="n">Begin</th>'
