                _cb = "unlimited" if (vb_ is not None and to_num(vb_) >= 9e18) else (str(vb_) if vb_ is not None else None)
                _ce = "unlimited" if (ve_ is not None and to_num(ve_) >= 9e18) else (str(ve_) if ve_ is not None else None)
                h.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
