def text_replay(win, repl_dir=None):
    """awrrpt 'Wal Receiver' table as a screen report (standby role):
    per-minute pg_stat_get_wal_receiver samples -- same source, fields and
    order as the html Replication sub-table. Every minute is shown (the html
    walrcv table has no healthy-minute hiding, unlike repl stat); null/error
    sampler minutes render as gap rows. lag = LSN byte distance: Net =
    sender_sent-received, Fsync = received-flush, Apply = flush-replay,
    Total = sender_sent-replay."""
    lines = _text_banner("awr replay detail", win)
    m = win["meta"]
    wr = load_walrcv_samples(repl_dir, m.get("begin_ts", ""), m.get("end_ts", ""))
    if not wr["files"]:
        lines.append("(no walreceiver samples in this period -- the sampler runs")
        lines.append(" while 'awr enable' is on)")
        return 0, "\n".join(lines)
    rows = sorted(wr["rows"], key=lambda r: r[0])   # stable: same-minute rows keep order
    if wr["n_data"] == 0:
        lines.append("(no walreceiver at any sample in this period")
        lines.append(" (%d samples: %d null, %d error))"
                     % (len(rows), wr["n_null"], wr["n_error"]))
        return 0, "\n".join(lines)
    headers = ["time", "state", "peer", "sent_lsn", "received_lsn", "flush_lsn",
               "replay_lsn", "net_lag", "fsync_lag", "apply_lag", "total_lag",
               "sync%", "channel"]
    out = []
    for ts, kind, f in rows:
        if kind != "data":
            msg = ("(no walreceiver -- primary role or disconnected)" if kind == "null"
                   else "(sample error)")
            out.append([ts, msg] + [""] * 11)
            continue
        # f: 0 pid, 1 local_role, 2 peer_role, 3 peer_state, 4 state, 5 sent,
        #    6 sender_write, 7 sender_flush, 8 sender_replay, 9 received,
        #    10 receiver_write, 11 receiver_flush, 12 receiver_replay,
        #    13 sync_percent, 14 channel
        sent, received, flush, replay = f[5], f[9], f[11], f[12]
        L = [_lsn64(x) for x in (sent, received, flush, replay)]
        def _seg(i, j):
            a, b = L[i], L[j]
            return fmt_bytes(a - b) if (a is not None and b is not None and a >= b) else "n/a"
        out.append([ts, f[4], "%s/%s" % (f[2], f[3]), sent, received, flush, replay,
                    _seg(0, 1), _seg(1, 2), _seg(2, 3), _seg(0, 3), f[13], f[14]])
    lines.append(_text_table(headers, out,
                             align="l" * 7 + "r" * 4 + "r" + "l"))
    return 0, "\n".join(lines)

def _tabstat_row(win, dbname, schema, table):
    """text_tabstat data row for one window; None = table not captured."""
    def _index(rows):
        idx = {}
        for r in rows:
            idx.setdefault((r.get("dbname", ""), r.get("schema", ""),
                            r.get("object", "")), []).append(r)
        return idx
    b = _index(win["db"][("begin", "object_tables")])
    e = _index(win["db"][("end", "object_tables")])
    key = (dbname, schema, table)
    if key not in b and key not in e:
        return None
    def d(col):
        bv = sum(to_num(r.get(col, 0)) for r in b.get(key, []))
        ev = sum(to_num(r.get(col, 0)) for r in e.get(key, []))
        dv = ev - bv
        return dv if dv >= 0 else None
    def endv(col):
        rows = e.get(key, [])
        return sum(to_num(r.get(col, 0)) for r in rows) if rows else None
    def i(x):
        return "-" if x is None else "%d" % int(x)
    return [i(d("seq_scan")), i(d("idx_scan")), i(d("n_tup_ins")), i(d("n_tup_upd")),
            i(d("n_tup_del")), i(d("n_tup_hot_upd")),
            i(endv("n_live_tup")), i(endv("n_dead_tup"))]

def text_tabstat(win, dbname, schema, table, detail_wins=None):
    """wdr_tabstat screen equivalent for one table (any database; the capture
    loops all datallowconn databases). Counters = window delta (negative ->
    '-'), alive/dead = END snap gauges. detail_wins appends an 'awr tabstat
    snapshot' section: one row per consecutive snapshot interval."""
    lines = _text_banner("awr tabstat summary", win,
                         extra="db: %s  schema: %s  table: %s" % (dbname, schema, table))
    def _begin_has(win_):
        def _index(rows):
            idx = set()
            for r in rows:
                idx.add((r.get("dbname", ""), r.get("schema", ""), r.get("object", "")))
            return idx
        return (dbname, schema, table) in _index(win_["db"][("begin", "object_tables")])
    row = _tabstat_row(win, dbname, schema, table)
    if row is None:
        lines.append("(table '%s.%s.%s' not found in either snapshot's "
                     "object_tables capture)" % (dbname, schema, table))
        return 1, "\n".join(lines)
    headers = ["seqscan", "idxscan", "ins", "upd", "del", "hotupd", "alive", "dead"]
    lines.append(_text_table(headers, [row], align="r" * 8))
    if detail_wins:
        def _rows(w):
            x = _tabstat_row(w, dbname, schema, table)
            return [x] if x is not None else None
        lines += _text_snapshot_table("awr tabstat snapshot", headers, "l" + "r" * 8,
                                      detail_wins, _rows)
    if not _begin_has(win):
        lines.append("")
        lines.append("note: table absent in BEGIN snap -- deltas count from zero")
    return 0, "\n".join(lines)


def _fmt_duration(seconds):
    """Render seconds in the most readable unit: s/m/h/d (1 decimal for >= 60s).
    Mirrors the 'fmt_us' style used elsewhere in the renderer."""
    if seconds is None:
        return "-"
    try:
        s = float(seconds)
    except (TypeError, ValueError):
        return "-"
    if s < 0:
        return "-"
    a = abs(s)
    if a < 60:
        return "%ds" % s
    if a < 3600:
        return "%.1fm" % (s / 60.0)
    if a < 86400:
        return "%.1fh" % (s / 3600.0)
    return "%.1fd" % (s / 86400.0)



def text_sqlhist(win, sql_id="", detail_wins=None, sqltext_root=None):
    """Per-interval execution history for ONE SQL (unique_sql_id). Shows the
    SQL text (flattened) from the shared sql_text store before the table;
    whole-window row + one row per consecutive snapshot pair."""
    # SQL text lookup: scan the shared multi-member gzip store for this
    # unique_sql_id. The store is keyed (user_name, unique_sql_id) -- one uid
    # commonly has rows for SEVERAL users (uid is text-derived, the counters
    # are per-user) -- so collect EVERY match: text from the first non-empty
    # query (all rows of one uid carry the same text), and the user set
    # decides what the banner may claim. A first-match-only user_name (the
    # old code) could name someone who never ran it in this window.
    sql_text = ""
    store_users = []
    if sqltext_root:
        import gzip as _gz
        _store = os.path.join(sqltext_root, "sql_text.csv.gz")
        if os.path.isfile(_store):
            try:
                with _gz.open(_store, "rt", encoding="utf-8", errors="replace") as f:
                    for r in csv.DictReader(f):
                        if r.get("unique_sql_id") == sql_id:
                            u = (r.get("user_name") or "").strip()
                            if u and u not in store_users:
                                store_users.append(u)
                            if not sql_text:
                                sql_text = (r.get("query") or "").strip()
            except Exception:
                pass
    # Group rows by (user_name, sql_id): different users on the same sql_id
    # are common (same SQL text in a shared pool) and must NOT be merged --
    # they represent distinct sessions and distinct accumulated counters.
    # THIS report is for ONE sql_id: bucket only its rows (the unfiltered
    # version keyed every sql in the statement table, and the per-user rows
    # below inherited rows -- and users -- that were never asked for)
    def _by_user(rows):
        buckets = {}
        for r in rows:
            if str(r.get("unique_sql_id", "")) != sql_id:
                continue
            u = r.get("user_name", "") or ""
            k = (u, sql_id)
            if k not in buckets:
                buckets[k] = {"__row": r}
                for c in ("n_calls","db_time","cpu_time","data_io_time",
                          "plan_time","sort_time","hash_time",
                          "n_blocks_fetched","n_blocks_hit","n_returned_rows"):
                    buckets[k][c] = 0.0
            for c in ("n_calls","db_time","cpu_time","data_io_time",
                      "plan_time","sort_time","hash_time",
                      "n_blocks_fetched","n_blocks_hit","n_returned_rows"):
                buckets[k][c] += to_num(r.get(c, 0))
        return buckets
    begin_bu = _by_user(win["db"][("begin", "statement")])
    end_bu = _by_user(win["db"][("end", "statement")])
    # banner user: claim a user ONLY when unambiguous -- exactly one user ran
    # this uid in the window (or, with no executions at all, the store knows
    # just one). Several users -> no user in the banner; the table below has
    # a user column carrying every one of them.
    window_users = sorted({k[0] for k in set(begin_bu) | set(end_bu) if k[0]})
    if len(window_users) == 1:
        banner_user = window_users[0]
    elif not window_users and len(store_users) == 1:
        banner_user = store_users[0]
    else:
        banner_user = ""
    # banner first, then the sql text as a psql-style one-column table --
    # same header/rule look as every other table in the report (user
    # 2026-09-17: the old '===== awr sqltext =====' bar sat ABOVE the banner
    # and matched no other section)
    lines = _text_banner("awr sql history", win,
                         extra="sql_id: %s%s" % (sql_id,
                                 ("  user: " + banner_user) if banner_user else ""))
    flat = re.sub(r"\s+", " ", sql_text).strip() if sql_text else ""
    lines += ["", "sql_text", "-" * 90]
    if flat:
        for i in range(0, len(flat), 90):
            lines.append(flat[i:i+90])
        if len(flat) > 90:
            lines.append("  (%d chars total)" % len(flat))
    else:
        lines.append("(sql text not found in the shared sql_text store)")
    # ★_hist_rows(带负值守卫的旧实现)从未被调用 -- 渲染走 _hist_rows_ui;
    # 2026-10-10 审计删除, 防止误导(其守卫逻辑已随当日修复并入 _hist_rows_ui)。
    headers = ["time_range", "calls", "dbtime", "avg_dbtime", "avg_cpu", "avg_io",
               "avg_sort", "avg_hash", "avg_plan", "avg_cr", "avg_pr", "avg_rows"]
    def _hist_rows_ui(w):
        bw = _by_user(w["db"][("begin", "statement")])
        ew = _by_user(w["db"][("end", "statement")])
        rs = []
        for k in set(bw) | set(ew):
            b = bw.get(k, {})
            e = ew.get(k, {})
            calls = to_num(e.get("n_calls", 0)) - to_num(b.get("n_calls", 0))
            if calls <= 0:
                continue
            fetched = to_num(e.get("n_blocks_fetched", 0)) - to_num(b.get("n_blocks_fetched", 0))
            hit = to_num(e.get("n_blocks_hit", 0)) - to_num(b.get("n_blocks_hit", 0))
            db_t = to_num(e.get("db_time",0)) - to_num(b.get("db_time",0))
            cpu = to_num(e.get("cpu_time",0)) - to_num(b.get("cpu_time",0))
            io  = to_num(e.get("data_io_time",0)) - to_num(b.get("data_io_time",0))
            sort = to_num(e.get("sort_time",0)) - to_num(b.get("sort_time",0))
            hash_ = to_num(e.get("hash_time",0)) - to_num(b.get("hash_time",0))
            plan = to_num(e.get("plan_time",0)) - to_num(b.get("plan_time",0))
            rows = to_num(e.get("n_returned_rows",0)) - to_num(b.get("n_returned_rows",0))
            def _ms_per_call(v):
                return "%.2f" % (v / 1e3 / calls) if (v >= 0 and calls > 0) else "-"
            rs.append([k[0], k[1],
                       "%d" % calls,
                       "%.2f" % (db_t / 1e3) if db_t >= 0 else "-",
                       "%.2f" % ((db_t / 1e3) / calls) if db_t >= 0 and calls > 0 else "-",
                       _ms_per_call(cpu), _ms_per_call(io),
                       _ms_per_call(sort), _ms_per_call(hash_),
                       _ms_per_call(plan),
                       "%.1f" % (fetched / calls) if (fetched >= 0 and calls > 0) else "-",
                       "%.1f" % ((fetched - hit) / calls) if (fetched - hit >= 0 and calls > 0) else "-",
                       "%.1f" % (rows / calls) if (rows >= 0 and calls > 0) else "-"])
        rs.sort(key=lambda r: -int(r[2]))
        return rs or None

    all_rows = _hist_rows_ui(win) or []
    # prefix whole-window label so detail rows stand apart
    labeled = [["whole window"] + r for r in all_rows] if all_rows else []
    if detail_wins:
        for dw in detail_wins:
            m = dw["meta"]
            tr = "%s-%s" % (_short_ts(m.get("begin_ts", "")),
                            _short_ts(m.get("end_ts", ""))[-5:])
            for r in (_hist_rows_ui(dw) or []):
                labeled.append([tr] + r)
    if not labeled:
        lines.append("sql_id %s: no executions in this window" % sql_id)
        return 1, "\n".join(lines)
    # user column: redundant when ONE user owns every row -- the banner right
    # above already names them (user 2026-09-17) -- so strip it; several users
    # -> the banner deliberately stays silent, the column is the only thing
    # telling them apart, keep it
    if len({r[1] for r in labeled}) == 1:
        labeled = [[r[0]] + r[2:] for r in labeled]
        cols, align = ["time_range", "sql_id"] + headers[1:], "l" * 2 + "r" * 11
    else:
        cols, align = ["time_range", "user", "sql_id"] + headers[1:], "l" * 3 + "r" * 11
    # rows carry [time_range, (user,) sql_id, calls, ...] -- keep 'calls' in
    # the header (headers[1:]); the old headers[2:] dropped it, shifting every
    # numeric one column right and silently losing the last cell
    lines.append("")
    lines.append(_text_table(cols, labeled, align=align))
    return 0, "\n".join(lines)

def _short_ts(ts):
    ts = str(ts)
    return ts[5:10].replace("-", "") + " " + ts[11:16] if len(ts) >= 16 else ts

def text_ltx(win, repl_dir=None):
    """awrrpt Long Transaction Monitor as a screen table: per-5-min ltx60_*
    counts + oldest-txn details from the lt_*.log sampler -- same source and
    columns as the html report's folded detail table. One row per 5-min sample
    in ts order; window summary line stays on top. Needs 'awr enable' sampler
    (one sample every 5 min).

    Compact column layout (vs the 12-col html): oldest_pid|state(act|itx)|
    xact_start folded into one col, state+wait_event dropped, usi renamed
    sql_id, current_xid dropped. Age -> 'duration' with auto unit (s/m/h/d)."""
    lines = _text_banner("awr ltx detail", win)
    m = win["meta"]
    samples = (load_lt_samples(repl_dir, m.get("begin_ts", ""), m.get("end_ts", ""))
               if repl_dir else {"files": []})
    if not samples.get("files"):
        lines.append("(no long-transaction samples in this period -- the sampler runs")
        lines.append(" while 'awr enable' is on; manual snapshots alone carry no series)")
        return 0, "\n".join(lines)
    rows = sorted(samples["rows"], key=lambda r: r[0])
    if not rows or samples["n_data"] == 0:
        lines.append("(no usable long-transaction samples in this period "
                     "(%d sample error(s)))" % samples["n_error"])
        return 0, "\n".join(lines)
    # window summary: peak long-txn count and worst oldest-txn duration, with times
    peak_cnt = peak_dur = -1
    peak_cnt_ts = peak_dur_ts = ""
    for ts, kind, f in rows:
        if kind != "data":
            continue
        cnt = (f + [""] * 12)[0]
        try:
            c = int(cnt)
            if c > peak_cnt: peak_cnt, peak_cnt_ts = c, ts
        except ValueError:
            pass
        te, xe = _ts_epoch(ts), _ts_epoch((f + [""] * 12)[4])
        if te is not None and xe is not None:
            a = te - xe
            if a > peak_dur: peak_dur, peak_dur_ts = a, ts
    lines.append("%d sample(s); peak ltx60_cnt %d at %s; worst oldest-txn duration %s at %s."
                % (samples["n_data"], peak_cnt, peak_cnt_ts or "-",
                   _fmt_duration(peak_dur) if peak_dur >= 0 else "-",
                   peak_dur_ts or "-"))
    lines.append("")
    headers = ["time", "ltx60_cnt|itx|act",
               "pid|state|xact_start", "duration", "sql_id", "oldestxmin"]
    out_rows = []
    for ts, kind, f in rows:
        if kind != "data":
            out_rows.append([ts] + ["(sample error)"] + [""] * 4)
            continue
        cnt, itx, act, pid, xstart, state, ws, we, usi, oxmin, txid = (f + [""] * 11)[:11]
        te, xe = _ts_epoch(ts), _ts_epoch(xstart)
        if te is not None and xe is not None:
            dur = _fmt_duration(te - xe)
        else:
            dur = "-"
        # oldest_pid|state(act|itx)|xact_start -- state tag is the SHORT
        # 'act' or 'itx' (matches the per-state counter columns above) so
        # the reader can tell which bucket that PID is in at a glance.
        # 'idle in transaction*' is the "itx" bucket; everything else is "act"
        # (we don't break out other sub-states -- the column is informational,
        # the wait_event column was dropped to keep the table narrow).
        # When there is no long-tx in this sample (pid is empty), the state
        # tag has no meaning either -- emit just '-' for the whole cell.
        if not pid:
            pid_xstart = "-"
        else:
            state_tag = "itx" if (state and state.startswith("idle in transaction")) else "act"
            if xstart:
                pid_xstart = "%s|%s|%s" % (pid, state_tag, xstart)
            else:
                pid_xstart = "%s|%s|-" % (pid, state_tag)
        sql_id_cell = "-" if usi in ("", "0") else usi
        # the three count columns collapsed into one cell with pipe-delimited
        # values: "N|N|N" (no leading/trailing pipe). Header mirrors the same
        # shape: "ltx60_cnt|itx60|act60" -- keeps the row narrow and matches
        # the merged-column look in the next col.
        counts_cell = "%s|%s|%s" % (cnt or "-", itx or "-", act or "-")
        out_rows.append([ts, counts_cell, pid_xstart, dur, sql_id_cell, oxmin or "-"])
    lines.append(_text_table(headers, out_rows, align="l" + "r" * 5))
    return 0, "\n".join(lines)


def text_pagew(win, repl_dir=None):
    """awr pagewriter status as a screen table: per-5-min flush/dirty series
    from the pw_*.log sampler -- same source as the html report's Pagewriter
    Status section. flush_d = delta of the cumulative pgwr_actual_flush_total_num
    (kernel pagewriter.cpp: fetch_add only, never reset); last_batch =
    pgwr_last_flush_num (zeroed each batch round); dirty = remain_dirty_page_num
    (current queue length); behind = current_xlog_insert_lsn -
    queue_head_page_rec_lsn. R = restart (counter reset, interval excluded).
    Needs 'awr enable' sampler (one sample every 5 min)."""
    lines = _text_banner("awr pagew flush", win)
    m = win["meta"]
    samples = (load_pw_samples(repl_dir, m.get("begin_ts", ""), m.get("end_ts", ""))
               if repl_dir else {"files": []})
    if not samples.get("files"):
        lines.append("(no pagewriter samples in this period -- the sampler runs")
        lines.append(" while 'awr enable' is on; manual snapshots alone carry no series)")
        return 0, "\n".join(lines)
    rows, s = pw_derive_rows(samples)
    if not rows:
        lines.append("(no usable pagewriter samples in this period "
                     "(%d sample error(s)))" % samples["n_error"])
        return 0, "\n".join(lines)
    # node column only when the series carries more than one node
    # (user 2026-10-21); screen table keeps medium-width headers, the html
    # report carries the full kernel-native names
    multi_node = len(set(r[1] for r in rows)) > 1
    headers = (["time", "node"] if multi_node else ["time"]) + \
              ["flush_delta", "pages_per_s", "last_flush_num", "dirty_pages",
               "queue_head_rec_lsn", "behind_xlog_mb"]
    out_rows = []
    # error minutes surface as gap rows so cadence breaks stay visible
    # (walk the sorted union of data + error sample timestamps)
    data_by_ts = {}
    for ts, node, delta, rate, lastf, dirty, qh, behind, restarted, redo in rows:
        r_ = ["R" if restarted else (fmt_int(delta) if delta is not None else "-"),
              ("%.1f" % rate) if rate is not None else "-",
              lastf or "-",
              fmt_int(dirty) if dirty is not None else "-",
              qh or "-",
              ("%.1f" % behind) if behind is not None else "-"]
        if multi_node:
            r_ = [node] + r_
        data_by_ts.setdefault(ts, []).append([ts] + r_)
    all_ts = sorted(set(list(data_by_ts.keys()) +
                        [ts for ts, kind, f in samples["rows"] if kind == "error"]))
    for t in all_ts:
        if t in data_by_ts:
            out_rows.extend(data_by_ts[t])
        else:
            out_rows.append([t, "(sample error)"] + [""] * (len(headers) - 2))
    lines.append(_text_table(headers, out_rows,
                             align="l" + ("l" if multi_node else "") + "r" * 6))
    return 0, "\n".join(lines)


def main():
    argv = sys.argv[1:]
    awr_dir = current_dir = single_dir = begin_dir = end_dir = out_html = ""
    awrdiff_dirs = []
    repl_dir = None
    sqltext_root = None
    name_prefix = "awr"
    text_section = None
    text_db = text_schema = text_table = text_event_name = text_sql_id = None
    metric = "dbtime"
    metric_given = False
    sql_id_given = False
    top_n = 30
    n_given = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--awr" and i + 1 < len(argv):
            awr_dir = argv[i + 1]; i += 2
        elif a == "--current" and i + 1 < len(argv):
            current_dir = argv[i + 1]; i += 2
        elif a == "--single" and i + 1 < len(argv):
            single_dir = argv[i + 1]; i += 2
        elif a == "--begin" and i + 1 < len(argv):
            begin_dir = argv[i + 1]; i += 2
        elif a == "--end" and i + 1 < len(argv):
            end_dir = argv[i + 1]; i += 2
        elif a == "--repl-dir" and i + 1 < len(argv):
            repl_dir = argv[i + 1] or None; i += 2   # empty string == not supplied
        elif a == "--sqltext-root" and i + 1 < len(argv):
            sqltext_root = argv[i + 1] or None; i += 2
        elif a == "--name-prefix" and i + 1 < len(argv):
            name_prefix = argv[i + 1] or "awr"; i += 2
        elif a == "--awrdiff" and i + 4 < len(argv):
            awrdiff_dirs = argv[i + 1:i + 5]; i += 5
        elif a == "-o" and i + 1 < len(argv):
            out_html = argv[i + 1]; i += 2
        elif a == "-m" and i + 1 < len(argv):
            metric = argv[i + 1]; metric_given = True; i += 2
        elif a == "-n" and i + 1 < len(argv):
            try:
                top_n = int(argv[i + 1])
                n_given = True
            except ValueError:
                sys.stderr.write("Error: -n expects an integer, got %r\n" % argv[i + 1]); return 2
            i += 2
        elif a == "--text" and i + 1 < len(argv):
            text_section = argv[i + 1]; i += 2
        elif a == "--sql-id" and i + 1 < len(argv):
            text_sql_id = argv[i + 1]; sql_id_given = True; i += 2
        elif a == "--event" or (a == "-E" and i + 1 < len(argv)):
            if i + 1 >= len(argv):
                sys.stderr.write("Error: %s requires a value\n" % a); return 2
            text_event_name = argv[i + 1]; i += 2
        elif a == "--db" or (a == "-d" and i + 1 < len(argv)):
            if i + 1 >= len(argv):
                sys.stderr.write("Error: %s requires a value\n" % a); return 2
            text_db = argv[i + 1]; i += 2
        elif a == "--schema" or (a == "-s" and i + 1 < len(argv)):
            if i + 1 >= len(argv):
                sys.stderr.write("Error: %s requires a value\n" % a); return 2
            text_schema = argv[i + 1]; i += 2
        elif a == "--table" or (a == "-t" and i + 1 < len(argv)):
            if i + 1 >= len(argv):
                sys.stderr.write("Error: %s requires a value\n" % a); return 2
            text_table = argv[i + 1]; i += 2
        else:
            if a.startswith("-"):
                # unknown option, or a value-taking option stranded at the end
                # (e.g. '... -E' with no value): never render a silently
                # wrong-scoped report -- usage error, rc=2
                sys.stderr.write("Error: unknown or incomplete option %r\n" % a)
                return 2
            i += 1

    def _fallback_dbname(meta):
        # snapshots whose node-name probes all failed (e.g. G100 2.2.10:
        # pg_node_env empty + pgxc_node_name blank) carry db_name "?" which
        # sanitizes to nothing -> "unknown" in the filename. Fall back to the
        # snapshot's OWN hostname (user 2026-10-20: NOT the database name --
        # "postgres" identifies nothing; hostname identifies the node). Pure
        # offline read from meta -- works for pre-fix snapshots too.
        return str(meta.get("hostname") or "")

    def _default_html(meta):
        # default name: {prefix}_{DB_NAME}_{BEGINTIME}_{ENDTIME}.html under awr_reports/
        # (prefix "awr" for awrrpt windows, "baseline" for baseline reports)
        _dn = meta.get("db_name") or meta.get("name") or ""
        _dn = "".join(c for c in str(_dn) if c.isalnum() or c in "_-")
        if not _dn:
            _dn = _fallback_dbname(meta)
            _dn = "".join(c for c in str(_dn) if c.isalnum() or c in "_-")
        _dn = _dn or "unknown"
        _b = str(meta.get("begin_ts", "")).replace("-", "").replace(":", "").replace(" ", "")
        _e = str(meta.get("end_ts", "")).replace("-", "").replace(":", "").replace(" ", "")
        _reports_dir = os.path.join(os.path.expanduser(os.environ.get("VB_TOOL_HOME", "~/.vb_tool")),
                                    "awr_reports")
        return os.path.join(_reports_dir, "%s_%s_%s_%s.html" % (name_prefix, _dn, _b, _e))

    def _default_awrdiff_html(meta1, meta2):
        # awrdiff_{DB}_{P1_begin}_{P2_begin}.html (each period identified by begin ts)
        _dn = meta2.get("db_name") or meta1.get("db_name") or ""
        _dn = "".join(c for c in str(_dn) if c.isalnum() or c in "_-")
        if not _dn:
            _dn = _fallback_dbname(meta2) or _fallback_dbname(meta1)
            _dn = "".join(c for c in str(_dn) if c.isalnum() or c in "_-")
        _dn = _dn or "unknown"
        _p1 = str(meta1.get("begin_ts", "")).replace("-", "").replace(":", "").replace(" ", "")
        _p2 = str(meta2.get("begin_ts", "")).replace("-", "").replace(":", "").replace(" ", "")
        _reports_dir = os.path.join(os.path.expanduser(os.environ.get("VB_TOOL_HOME", "~/.vb_tool")),
                                    "awr_reports")
        return os.path.join(_reports_dir, "awrdiff_%s_%s_%s.html" % (_dn, _p1, _p2))

    # db tables each text section actually reads via delta_rows(). Skipping
    # the other 17+ CSVs per snap is the single biggest perf win for text
    # commands (each snap is ~20 small gz CSVs, gzip+DictReader overhead
    # dominates when only 1-6 tables are needed). Set is built from grep'ing
    # `delta_rows(win, "<table>"` inside every text_* function.
    # topsql's set is metric-conditional: -m memory/spill also rank from
    # statement_mem.csv (KB), so it rides along only for those dims.
    TEXT_DB_TABLES = {
        "topsql":  frozenset({"statement", "statement_mem"}
                             if metric in MEM_DIM_COLUMNS else {"statement"}),
        "event":   frozenset({"instance_time", "wait_events"}),
        "summary": frozenset({"instance_time", "database", "statement",
                              "rel_iostat", "file_redo_iostat"}),
        "tabstat": frozenset({"object_tables"}),
        "sqlhist": frozenset({"statement"}),
        # OS/sampler-log-only commands load ZERO db CSVs (audit 2026-10-30):
        # cpu/io/page/mem/net/tcp/tcpstat/fd read os_*.log, replstat/replslot/
        # replay read repl_/slot_/walrcv_*.log, ltx/pagew read lt_/pw_*.log --
        # all via load_os_samples, which never goes through db_tables. The old
        # default full load (19 CSVs x2 snaps, statement.csv is MB-scale) made
        # these CLI calls several times slower for nothing.
        "cpu": frozenset(), "io": frozenset(), "page": frozenset(),
        "mem": frozenset(), "net": frozenset(), "tcp": frozenset(),
        "tcpstat": frozenset(), "fd": frozenset(),
        "replstat": frozenset(), "replslot": frozenset(), "replay": frozenset(),
        "ltx": frozenset(), "pagew": frozenset(),
    }
    text_db_tables = TEXT_DB_TABLES.get(text_section)

    if text_section:
        if not (begin_dir and end_dir):
            sys.stderr.write("Error: --text needs --begin DIR and --end DIR\n"); return 2
        if text_section not in ("topsql", "event", "summary", "tabstat",
                                "cpu", "io", "page", "mem", "net", "tcp", "tcpstat", "fd",
                                "replstat", "replslot",
                                "replay", "ltx", "pagew", "sqlhist"):
            sys.stderr.write("Error: --text expects topsql|event|summary|tabstat"
                             "|cpu|io|page|mem|net|tcp|tcpstat|fd"
                             "|replstat|replslot|replay|ltx|pagew|sqlhist\n"); return 2
        # ★选项归属校验 (2026-10-11, user: 给错子命令的选项要报错, 不再静默吞):
        #   text 模式下 -m/-n 只属于 topsql, -E 只属于 event, -d/-s/-t 只属于
        #   tabstat, --sql-id 只属于 sqlhist; 其余 8 个 section 不吃任何选项。
        #   (html 模式的 -m/-n 不在此列。)
        if text_section:
            _opt_owner = {"m": ("topsql",), "n": ("topsql",), "E": ("event",),
                          "d": ("tabstat",), "s": ("tabstat",), "t": ("tabstat",),
                          "sql-id": ("sqlhist",)}
            for _opt, _owners in _opt_owner.items():
                _given = {"m": metric_given, "n": n_given, "E": bool(text_event_name),
                          "d": bool(text_db), "s": bool(text_schema), "t": bool(text_table),
                          "sql-id": sql_id_given}.get(_opt, False)
                if _given and text_section not in _owners:
                    sys.stderr.write("Error: -%s is only valid for 'awr %s' (got section '%s')\n"
                                     % (_opt, "'|'".join(_owners), text_section)); return 2
        if not repl_dir:
            # per-minute series (os_*.log) live in the snapshot root,
            # next to the snap_<id> dirs the text reports are given
            repl_dir = os.path.dirname(os.path.abspath(begin_dir))
        win = build_window_from_snaps(begin_dir, end_dir, sqltext_root,
                                     load_sqltext=False, db_tables=text_db_tables)
        patch_win_pagewriter_from_pw(win, repl_dir)
        if text_section == "topsql" and not n_given:
            top_n = 10        # awr topsql default differs from awrrpt's 30
        if text_section == "tabstat" and not (text_db and text_schema and text_table):
            sys.stderr.write("Error: --text tabstat needs --db NAME --schema NAME --table NAME\n"); return 2
        if text_section == "sqlhist" and not text_sql_id:
            sys.stderr.write("Error: --text sqlhist needs --sql-id ID\n"); return 2

        def _run(w, dw=None):
            if text_section == "topsql":
                if metric not in DIM_COLUMNS:
                    sys.stderr.write("Error: -m expects one of %s, got %r\n"
                                     % ("|".join(DIM_COLUMNS), metric)); return 2, ""
                return text_topsql(w, metric, top_n, detail_wins=dw)
            elif text_section == "event":
                return text_event(w, text_event_name, detail_wins=dw)
            elif text_section == "summary":
                return text_summary(w, detail_wins=dw)
            elif text_section == "cpu":
                return text_cpu(w, repl_dir)
            elif text_section == "io":
                return text_io(w, repl_dir)
            elif text_section == "page":
                return text_page(w, repl_dir)
            elif text_section == "mem":
                return text_mem(w, repl_dir)
            elif text_section == "net":
                return text_net(w, repl_dir)
            elif text_section == "tcpstat":
                return text_tcpstat(w, repl_dir)
            elif text_section == "tcp":
                return text_tcp(w, repl_dir)
            elif text_section == "fd":
                return text_fd(w, repl_dir)
            elif text_section == "replstat":
                return text_replstat(w, repl_dir)
            elif text_section == "replslot":
                return text_replslot(w, repl_dir)
            elif text_section == "replay":
                return text_replay(w, repl_dir)
            elif text_section == "ltx":
                return text_ltx(w, repl_dir)
            elif text_section == "pagew":
                return text_pagew(w, repl_dir)
            elif text_section == "sqlhist":
                return text_sqlhist(w, sql_id=text_sql_id, detail_wins=dw,
                                    sqltext_root=sqltext_root)
            else:
                return text_tabstat(w, text_db, text_schema, text_table, detail_wins=dw)

        # per-snapshot-interval breakdown (user 2026-09-12): topsql / event /
        # summary / tabstat render the WHOLE window plus one wdr-style row
        # group per consecutive snapshot pair inside the SAME table (time_range
        # leading column, one banner/header); a 1-interval window (end-begin
        # == 1) keeps just the whole-window report
        detail_wins = None
        if text_section in ("topsql", "event", "summary", "tabstat", "sqlhist"):
            seq = snap_seq_dirs(begin_dir, end_dir)
            if len(seq) > 2:
                detail_wins = [build_window_from_snaps(a, b, sqltext_root,
                                                      load_sqltext=False, db_tables=text_db_tables)
                               for a, b in zip(seq, seq[1:])]
        rc, out = _run(win, detail_wins)
        if rc == 2:
            return 2
        sys.stdout.write(out + "\n")
        return rc
    if awrdiff_dirs:
        if len(awrdiff_dirs) != 4:
            sys.stderr.write("Error: --awrdiff needs 4 snap dirs: p1_begin p1_end p2_begin p2_end\n")
            sys.exit(2)
        w1 = build_window_from_snaps(awrdiff_dirs[0], awrdiff_dirs[1], sqltext_root)
        w2 = build_window_from_snaps(awrdiff_dirs[2], awrdiff_dirs[3], sqltext_root)
        if not out_html:
            out_html = _default_awrdiff_html(w1["meta"], w2["meta"])
        render_awrdiff(w1, w2, metric, top_n, out_html)
        return
    if begin_dir and end_dir:
        win = build_window_from_snaps(begin_dir, end_dir, sqltext_root)
        if not out_html:
            out_html = _default_html(win["meta"])
        render_single_awr(win, metric, top_n, out_html, repl_dir=repl_dir)
        return
    if single_dir:
        win = load_window(single_dir)
        if not out_html:
            out_html = _default_html(win["meta"])
        render_single_awr(win, metric, top_n, out_html)
        return
    if not awr_dir or not current_dir:
        sys.stderr.write("usage: compare_render.py --awr DIR --current DIR "
                         "[-m dbtime|cpu|io] [-n N] -o FILE\n"
                         "       compare_render.py --single DIR "
                         "[-m dbtime|cpu|io] [-n N] [-o FILE]\n"
                         "       compare_render.py --begin DIR --end DIR "
                         "[-m dbtime|cpu|io] [-n N] [--repl-dir DIR] [-o FILE]\n"
                         "       compare_render.py --awrdiff D1 D2 D3 D4 "
                         "(p1_begin p1_end p2_begin p2_end) [-m ..] [-n N] [-o FILE]\n")
        sys.exit(2)
    render(awr_dir, current_dir, metric, top_n, out_html)

if __name__ == "__main__":
    sys.exit(main())
VB_BL_COMPARE_PY
    # bytecode cache (user 2026-09-13: text/report commands felt slow): the
    # ~300KB embedded interpreter was re-COMPILED from source on every run
    # (~2s CPU) because python never caches a __main__ script. Keep it as an
    # imported MODULE under $VB_TOOL_HOME/.render_cache/ instead -- python
    # writes __pycache__ once per binary version and later runs just load the
    # .pyc. Any cache failure falls back to running the plain tmp script.
    local cache="${VB_TOOL_HOME:-$HOME/.vb_tool}/.render_cache" mod="" rc
    if mkdir -p "$cache" 2>/dev/null; then
        mod="$cache/awr_render.py"
        if [ ! -f "$mod" ] || ! cmp -s "$tmp" "$mod"; then
            # atomic publish: write a sibling temp then mv -- a concurrent
            # first-run used to cat > directly and could expose a half-written
            # module to the other process's cmp/import
            local _cnew="$cache/awr_render.$$.py"
            if cat "$tmp" > "$_cnew" 2>/dev/null && mv -f "$_cnew" "$mod" 2>/dev/null; then
                :
            else
                rm -f "$_cnew" 2>/dev/null; mod=""
            fi
        fi
        [ -f "$mod" ] && cmp -s "$tmp" "$mod" || mod=""
    fi
    if [ -n "$mod" ]; then
        python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); del sys.argv[1]; import awr_render; sys.exit(awr_render.main())' "$cache" "$@"
        rc=$?
    else
        python3 "$tmp" "$@"
        rc=$?
    fi
    rm -f "$tmp"
    return $rc
}

# _awr_lt_stack_sample <root> <ts>  -- 5-minute long-txn + callstack sample.
# Called by _awr_repl_sample at the end of every minute run (same repl.lock),
# self-gated on minute % 5 == 0 from the passed ts ('%F %T'). Writes two day
# logs next to the repl_/os_ ones:
#
# lt_<YYYYMMDD>.log row grammar (comma, renderer = load_lt_samples):
#   data : ts,ltx60_cnt,ltx60_itx_cnt,ltx60_active_cnt,oldest_pid,
#          oldest_xact_start,oldest_state,oldest_wait_status,
#          oldest_wait_event,oldest_unique_sql_id,oldestxmin,txid_current
#          (12 fields; oldest_* are empty strings when no open transaction
#          exists at sample time; ltx60_* = 0 is a HEALTHY sample and is still
#          written as a data row. ltx60_itx_cnt = long txns in
#          'idle in transaction*' state, ltx60_active_cnt = active ones.
#          The WLM monitor's resident session (application_name='workload',
#          query 'WLM fetch collect info from data nodes', xact_start pinned
#          since instance start) is excluded from counts and the oldest pick,
#          and so is the WDR snapshot session (application_name='WDRSnapshot',
#          same pinned-xact_start problem -- it would fake the oldest long
#          transaction).
#          oldestxmin = gs_txid_oldestxmin() (primary vacuum horizon; stays 0
#          on a standby -- not maintained in recovery). A brief 2026-09-12
#          experiment logged a recentxmin column (txid_current_snapshot()
#          xmin) before txid_current; removed -- it is the snapshot's xmin,
#          NOT the kernel RecentGlobalXmin (a sticky u_sess variable based on
#          globalxmin - vacuum_defer_cleanup_age, slot-adjusted). The loader
#          still tolerates those rows.)
#   error: ts,error   (psql failed)
#
# stack_<YYYYMMDD>.log row grammar (PIPE-separated -- C++ symbols and wait
# strings can contain commas; gs_stack frames never contain '|'):
#   ts|be|thread_name|tid|wait_status|wait_event|cpu|chain   backend thread:
#          Wal Writer (+ Auxiliary -- the standby-side counterpart),
#          CheckPointer, every walsender / wal receiver thread
#          ('WalSender to Standby[...]' xN on the primary, 'Wal Receiver' +
#          'Wal Receive Writer' on a standby), and on a standby the Startup
#          (replay) thread plus parallel redo workers. AutoVacWorkers do NOT
#          appear here (own 'av' row below). cpu = that thread's CPU% over
#          the 1s /proc/<tgid>/task/<lwpid>/stat utime+stime window taken
#          with the sample
#          ('' = lwpid unreadable -> '-' in the report; 6-field rows from
#          older samplers = no cpu column yet). These threads have NO
#          pg_stat_activity row: state/wait come from pg_thread_wait_status
#          (LEFT JOIN; absent -> 'none').
#   ts|av|worker_cnt|cpu_sum|chain   autovacuum workers, their OWN section:
#          worker_cnt = autovac worker threads alive at the sample (0 row is
#          still written -- 0 is information), cpu_sum = SUM of all workers'
#          cpu%, chain = the highest-cpu worker's stack ('' when cnt = 0).
#          txid_current() is recovery-guarded: '-' on a standby (it cannot
#          assign xids there -- hard error without the CASE).
#   ts|fe|wait_event|pid|unique_sql_id|event_cnt|chain   frontend session:
#          per LWLock wait event (pg_thread_wait_status.wait_event joined to
#          dbe_perf.wait_events type='LWLOCK_EVENT') the ONE longest-running
#          session (earliest xact_start, then query_start), event_cnt = how
#          many sessions were waiting on that event at the sample. LWLock
#          waits on ACTIVE sessions only (a.state = 'active'). An
#          experimental '(no event)' pick (longest query_start, no wait) was
#          removed the same day: a no-wait row under an LWLock-waits heading
#          made no sense.
#   ts|be|error / ts|fe|error   (that group's query failed; the other group
#          still writes its rows)
# chain = gs_stack(tid): one text with embedded newlines, leaf frame first ->
# newlines joined ' <- ' (trailing separator trimmed). Frames are written IN
# FULL: ' + 0x...' offsets and raw 0x addresses stay -- the report shows ONE
# stack per thread per sample (no aggregation), so the pt-pmp normalization
# vb_tool stack applies would only throw information away.
# Always returns 0 (cron-friendly; failures are data, not exit codes).
# _awr_thr_cpu_ticks <lwpid> -> that thread's OWN utime+stime (clock ticks).
# Only /proc/<tgid>/task/<lwpid>/stat is per-thread: EVERY top-level
# /proc/<pid-or-tid>/stat -- including /proc/<tid>/stat for a plain worker
# thread -- reports the whole thread GROUP's aggregated utime+stime (identical
# numbers for every thread; this is the `ps` process view, and it is why
# top -H reads the task dir). Reading the top-level path made every
# Background Threads CPU% show the whole-instance CPU (~5000% on a busy box,
# all rows in lockstep). tgid is resolved from the thread's own status file;
# unreadable lwpid -> empty output (caller renders '-').
_awr_thr_cpu_ticks() {
    local tg
    tg=$(timeout -k 2 10 awk '/^Tgid:/{print $2}' "/proc/$1/status" 2>/dev/null)
    timeout -k 2 10 awk '{n=split($0,p,")"); m=split(p[2],f," "); print f[12]+f[13]}' "/proc/${tg:-$1}/task/$1/stat" 2>/dev/null
}
_awr_lt_stack_sample() {
    local root="$1" ts="$2"
    # 5-minute cadence gate from the sample ts (minute = chars 15-16)
    local mm="${ts:14:2}"
    case "$mm" in [0-9][0-9]) ;; *) return 0;; esac
    [ $((10#$mm % 5)) -ne 0 ] && return 0
    local lf="$root/lt_$(date +%Y%m%d).log"
    local sf="$root/stack_$(date +%Y%m%d).log"
    local out
    # ---- long transaction monitor: exactly one row per sample ----
    out=$(PGCONNECT_TIMEOUT=15 PGOPTIONS='-c statement_timeout=15000' \
          psql -d postgres -tAF',' -c "with lt as (select count(*)::text as long_cnt, coalesce(sum(case when state like 'idle in transaction%' then 1 else 0 end),0)::text as itx_cnt, coalesce(sum(case when state = 'active' then 1 else 0 end),0)::text as act_cnt from pg_stat_activity where xact_start is not null and xact_start < now() - interval '60 seconds' and pid <> pg_backend_pid() and application_name not in ('workload','WDRSnapshot','AutoVacWorker') and (state like 'idle in transaction%' or state = 'active')), o as (select a.pid::text as pid, a.xact_start::timestamp(0)::text as xstart, a.state as state, coalesce(w.wait_status,'') as ws, coalesce(w.wait_event,'') as we, a.unique_sql_id::text as usi from (select * from pg_stat_activity where xact_start is not null and pid <> pg_backend_pid() and application_name not in ('workload','WDRSnapshot') and (state like 'idle in transaction%' or state = 'active') order by xact_start, pid limit 1) a left join pg_thread_wait_status w on w.tid = a.pid) select lt.long_cnt, lt.itx_cnt, lt.act_cnt, coalesce(o.pid,''), coalesce(o.xstart,''), coalesce(o.state,''), coalesce(o.ws,''), coalesce(o.we,''), coalesce(o.usi,''), gs_txid_oldestxmin()::text, case when pg_is_in_recovery() then '-' else txid_current()::text end from lt left join o on true" 2>/dev/null)
    if [ "$?" -ne 0 ] || [ -z "$out" ]; then
        printf '%s,error\n' "$ts" >> "$lf"
    else
        printf '%s,%s\n' "$ts" "$out" >> "$lf"
    fi
    # ---- pagewriter: dirty-page flush series (dbe_perf.global_pagewriter_status).
    # Column semantics pinned from kernel pagewriter.cpp (g_pagewriter_view_col):
    #   pgwr_actual_flush_total_num  CUMULATIVE since startup
    #                               (pg_atomic_fetch_add_u64, never reset) --
    #                               the renderer takes per-node deltas
    #   pgwr_last_flush_num          pages flushed in the MOST RECENT batch
    #                               round (zeroed at each round start) -- as-is
    #   remain_dirty_page_num        current dirty-page queue length
    #                               (+1 new dirty / -1 flushed) -- as-is
    #   the 4 LSN cols               point-in-time positions
    # last col pg_postmaster_start_time: restart guard -- deltas are only
    # valid between samples with the SAME start time (user 2026-10-21); a
    # changed start time (or a counter that went backwards) marks R.
    local pf="$root/pw_$(date +%Y%m%d).log"
    out=$(PGCONNECT_TIMEOUT=15 PGOPTIONS='-c statement_timeout=15000' \
          psql -d postgres -tAF',' -c "select node_name,pgwr_actual_flush_total_num,pgwr_last_flush_num,remain_dirty_page_num,queue_head_page_rec_lsn,queue_rec_lsn,current_xlog_insert_lsn,ckpt_redo_point,(select pg_postmaster_start_time()::timestamp(0)::text) from dbe_perf.global_pagewriter_status order by node_name" 2>/dev/null)
    if [ "$?" -ne 0 ] || [ -z "$out" ]; then
        printf '%s,error\n' "$ts" >> "$pf"
    else
        printf '%s\n' "$out" | sed "s|^|$ts,|" >> "$pf"
    fi
    # ---- callstack: backend-thread candidates (name/wait from the thread
    # status view; lwpid is the OS tid used for the AutoVacWorker CPU pick) ----
    local be_list
    be_list=$(PGCONNECT_TIMEOUT=15 PGOPTIONS='-c statement_timeout=15000' \
          psql -d postgres -tAF'|' -c "select t.thread_name, t.pid, coalesce(w.wait_status,'none'), coalesce(w.wait_event,'none'), t.lwpid from pg_os_threads t left join pg_thread_wait_status w on w.tid = t.pid where t.thread_name in ('Wal Writer','Wal Writer Auxiliary','CheckPointer') or (t.thread_name ~* 'autovac' and t.thread_name ~* 'worker') or t.thread_name ~* 'walsend|wal ?rec|walrcv' or t.thread_name ~* '^(startup|startupxlog|parallel redo|redoworker|parallel replay)' order by t.thread_name, t.pid" 2>/dev/null)
    if [ "$?" -ne 0 ]; then
        printf '%s|be|error\n' "$ts" >> "$sf"
        be_list=""
    fi
    # ---- per-thread CPU% over ONE 1s /proc window, taken with the sample:
    # utime+stime (clock ticks, /proc/<tgid>/task/<tid>/stat fields 14+15 of
    # the post-comm portion -- the task path, see _awr_thr_cpu_ticks) read
    # twice 1s apart on every candidate lwpid; delta*100/CLK_TCK
    # = CPU% (same formula as `top -Hp`). The same delta picks the highest-CPU
    # AutoVacWorker when several run. Unreadable lwpid -> ''.
    # USER_HZ is 100 on Linux and that's what /proc/<tid>/stat utime/stime
    # are counted in. Some embedded kernels / containers return 1 instead
    # of 100 from `getconf CLK_TCK`, which inflates the formula by 100x.
    # Use getconf as primary; only trust 100; fall back to 100 otherwise
    # (matches the actual /proc/<tid>/stat tick unit).
    # The awk splits on ')' first so comm containing spaces (Wal Writer /
    # Wal Writer Auxiliary / WalSender to Standby[dn_6002] / parallel redo
    # worker ...) does not shift the utime/stime field positions.
    local clk
    clk=$(getconf CLK_TCK 2>/dev/null)
    case "$clk" in 100) ;; *) clk=100 ;; esac
    local -a rows=() cpu1=() cpu=()
    local idx=0 name tid ws we lwp x d i avbest=-1
    while IFS='|' read -r name tid ws we lwp; do
        [ -n "$name" ] || continue
        rows[idx]="$name|$tid|$ws|$we|$lwp"
        cpu1[idx]=$(_awr_thr_cpu_ticks "$lwp")
        idx=$((idx+1))
    done < <(printf '%s\n' "$be_list")
    [ "$idx" -gt 0 ] && sleep 1
    i=0
    while [ "$i" -lt "$idx" ]; do
        lwp="${rows[$i]##*|}"
        x=$(_awr_thr_cpu_ticks "$lwp")
        if [ -n "$x" ] && [ -n "${cpu1[$i]}" ]; then
            d=$(( x - cpu1[$i] )); [ "$d" -lt 0 ] && d=0
            cpu[$i]=$(awk -v d="$d" -v c="$clk" 'BEGIN{printf "%d", d*100/c}')
        else
            cpu[$i]=""
        fi
        i=$((i+1))
    done
    # ---- selection: fixed threads pass through with their cpu; AutoVacWorker
    # rows collapse into ONE 'av' sample (worker count, SUM of all workers'
    # cpu, stack of the highest-cpu worker) -- its own report sub-section ----
    local be_out="" av_cnt=0 av_sum=0 av_tid=""
    i=0
    while [ "$i" -lt "$idx" ]; do
        IFS='|' read -r name tid ws we lwp <<< "${rows[$i]}"
        if printf '%s' "$name" | grep -qi 'autovac' && printf '%s' "$name" | grep -qi 'worker'; then
            av_cnt=$((av_cnt+1))
            case "${cpu[$i]:-}" in ''|*[!0-9]*) ;; *) av_sum=$((av_sum + cpu[$i]));; esac
            if [ "$avbest" -lt 0 ] || [ "${cpu[$i]:-0}" -gt "${cpu[$avbest]:-0}" ]; then
                avbest=$i
            fi
        else
            be_out+="$name|$tid|$ws|$we|${cpu[$i]}"$'\n'
        fi
        i=$((i+1))
    done
    if [ "$avbest" -ge 0 ]; then
        IFS='|' read -r name tid ws we lwp <<< "${rows[$avbest]}"
        av_tid="$tid"
    fi
    # ---- callstack: frontend candidates -- one longest-running session per
    # LWLock wait event (LWLock waits ONLY: '(no event)' picks were removed --
    # a no-wait session under an LWLock-waits heading made no sense)
    local fe_list
    fe_list=$(PGCONNECT_TIMEOUT=15 PGOPTIONS='-c statement_timeout=15000' \
          psql -d postgres -tAF'|' -c "select distinct on (w.wait_event) w.wait_event, a.pid, a.unique_sql_id::text, count(*) over (partition by w.wait_event)::text as ecnt from pg_stat_activity a join pg_thread_wait_status w on w.tid = a.pid join dbe_perf.wait_events e on e.event = w.wait_event and e.type = 'LWLOCK_EVENT' where a.pid <> pg_backend_pid() and a.state = 'active' order by w.wait_event, a.xact_start nulls last, a.query_start nulls last, a.pid" 2>/dev/null)
    if [ "$?" -ne 0 ]; then
        printf '%s|fe|error\n' "$ts" >> "$sf"
        fe_list=""
    fi
    # ---- one psql for every stack (backend tids + top autovac + frontend) ----
    local tids="" chain wev pid usi cpup
    while IFS='|' read -r name tid ws we cpup; do
        [ -n "$name" ] && tids+=",(${tid}::bigint)"
    done < <(printf '%s\n' "$be_out")
    [ -n "$av_tid" ] && tids+=",(${av_tid}::bigint)"
    while IFS='|' read -r wev pid usi ecnt; do
        [ -n "$wev" ] && tids+=",(${pid}::bigint)"
    done < <(printf '%s\n' "$fe_list")
    local stacks="" stk_tf=""
    if [ -n "$tids" ]; then
        tids="${tids#,}"
        # stderr goes to a scratch file, NOT /dev/null: a failed fetch (auth /
        # privilege / statement timeout / OOM) must leave a trace -- otherwise
        # the rows below ship empty chains with no hint WHY (vdb1 2026-11-01:
        # a full hour of '-' stacks, the cause was invisible in the day log)
        stk_tf=$(mktemp /tmp/vb_stk.XXXXXX) || stk_tf=""
        stacks=$(PGCONNECT_TIMEOUT=15 PGOPTIONS='-c statement_timeout=30000' \
              psql -d postgres -tAF'|' -c "select v.tid::text || '|' || coalesce((select replace(gs_stack, chr(10), ' <- ') from gs_stack(v.tid)), '') from (values ${tids}) v(tid)" 2>${stk_tf:-/dev/null})
        if [ "$?" -ne 0 ] || [ -z "$stacks" ]; then
            # tids were pending, so a successful fetch ALWAYS prints >= 1 row;
            # empty output counts as failure too. Message sanitized to ONE
            # line with no '|' (pipe is the row separator) / no tabs.
            printf '%s|st|error|%s\n' "$ts" \
                "$(head -1 "$stk_tf" 2>/dev/null | tr '\t|' ' /' | cut -c1-180)" >> "$sf"
        elif [ "$(printf '%s\n' "$stacks" | awk -F'|' '{sub(/^[^|]*\|/,""); if ($0 != "") c++} END{print c+0}')" -eq 0 ]; then
            # fetch SUCCEEDED but every chain came back empty (gs_stack returned
            # NULL/'' for all tids, rc=0, nothing in pg_log) -- the signature
            # seen on a G100 V2.2 Build 19 box (V3.0 Build 8 returns full
            # chains). Rows below will all show '-'; leave the telltale.
            printf '%s|st|error|%s\n' "$ts" \
                "gs_stack returned empty chain for every tid (rc=0; kernel build behavior?)" >> "$sf"
        fi
        [ -n "$stk_tf" ] && rm -f "$stk_tf"
    fi
    # ---- emit rows: chain looked up by tid from the stacks output ----
    while IFS='|' read -r name tid ws we cpup; do
        [ -n "$name" ] || continue
        chain=$(printf '%s\n' "$stacks" | awk -F'|' -v t="$tid" '$1==t{sub(/^[^|]*\|/,""); print; exit}')
        chain="${chain% <- }"   # gs_stack's trailing newline -> trailing sep
        printf '%s|be|%s|%s|%s|%s|%s|%s\n' "$ts" "$name" "$tid" "$ws" "$we" "$cpup" "$chain" >> "$sf"
    done < <(printf '%s\n' "$be_out")
    # autovac summary row: count / SUM cpu / top-cpu worker's stack (always
    # written -- 0 workers is itself information, like ltx60_cnt = 0)
    chain=""
    if [ -n "$av_tid" ]; then
        chain=$(printf '%s\n' "$stacks" | awk -F'|' -v t="$av_tid" '$1==t{sub(/^[^|]*\|/,""); print; exit}')
        chain="${chain% <- }"
    fi
    printf '%s|av|%d|%d|%s\n' "$ts" "$av_cnt" "$av_sum" "$chain" >> "$sf"
    while IFS='|' read -r wev pid usi ecnt; do
        [ -n "$wev" ] || continue
        chain=$(printf '%s\n' "$stacks" | awk -F'|' -v t="$pid" '$1==t{sub(/^[^|]*\|/,""); print; exit}')
        chain="${chain% <- }"
        printf '%s|fe|%s|%s|%s|%s|%s\n' "$ts" "$wev" "$pid" "$usi" "$ecnt" "$chain" >> "$sf"
    done < <(printf '%s\n' "$fe_list")
    # ---- session memory: ONE max-total session per 5-min sample (own log,
    # pipe grammar, renderer = load_sessmem_samples). Ranking and context
    # sizes are ALL totalsize (user decision: totalsize only, no usedsize).
    # v2.5.14: context names go through the SAME family rule as mem/awr/vtop
    # (operator suffix merge) -- raw per-node names would let one family
    # occupy all top3 slots.
    # LEFT JOIN activity: the top-memory session may already be gone from
    # pg_stat_activity (memory rows outlive the activity row). Empty output
    # writes 'unknown' (user decision), psql failure writes 'error'. v2.4.7:
    # 8th field client_info = application_name|client_addr|client_port (LEFT
    # JOIN activity; empty for background threads -> '||'). v2.5.6: sessions
    # running unique_sql_id 1171918037 / 4104764068 (the two AWR snapshot
    # gs_session_memory_detail COPY aggregates) are EXCLUDED from top1 --
    # their in-flight SRF tuplestore (hundreds of MB while the SRF
    # materializes) would otherwise always win top1 and pollute the
    # max-session-memory curve. If the snapshot SQL text ever changes, re-
    # derive the two ids from dbe_perf.statement and update them here. ----
    local mlf="$root/sessmem_$(date +%Y%m%d).log" mout
    mout=$(PGCONNECT_TIMEOUT=15 PGOPTIONS='-c statement_timeout=15000' \
          psql -d postgres -tAF'|' -c "with p as (select d.sessid, case when d.contextname ~ '^SIRW(_[0-9]+)+\$' then 'SIRW' else regexp_replace(regexp_replace(d.contextname, '_[0-9]{10,}_[0-9]+\$', ''), '_[0-9]{10,}\$', '') end contextname, sum(d.totalsize) tot from gs_session_memory_detail d where not exists (select 1 from pg_stat_activity a2 where a2.pid::text = split_part(d.sessid, '.', 2) and a2.unique_sql_id in (1171918037, 4104764068)) group by d.sessid, case when d.contextname ~ '^SIRW(_[0-9]+)+\$' then 'SIRW' else regexp_replace(regexp_replace(d.contextname, '_[0-9]{10,}_[0-9]+\$', ''), '_[0-9]{10,}\$', '') end), top1 as (select sessid, sum(tot) session_tot from p group by sessid order by session_tot desc limit 1), top3 as (select contextname, tot from p where sessid in (select sessid from top1) order by tot desc limit 3) select top1.sessid, top1.session_tot, coalesce(a.pid::text,''), coalesce(a.usename,''), coalesce(a.state,''), coalesce(a.unique_sql_id::text,''), (select string_agg(concat(contextname,'(',tot,')'), ', ') from top3), concat(coalesce(a.application_name,''),'|',coalesce(a.client_addr::text,''),'|',coalesce(a.client_port::text,'')) from top1 left join pg_stat_activity a on a.pid::text = split_part(top1.sessid, '.', 2)" 2>/dev/null)
    if [ "$?" -ne 0 ]; then
        printf '%s|error\n' "$ts" >> "$mlf"
    elif [ -z "$mout" ]; then
        printf '%s|unknown\n' "$ts" >> "$mlf"
    else
        printf '%s|%s\n' "$ts" "$mout" >> "$mlf"
    fi
    return 0
}

# _awr_repl_sample  -- role-aware per-minute DB replication sample + ONE OS
# counters sample appended to <root>/os_<YYYYMMDD>.log. primary: ONE
# pg_stat_replication sample -> repl_<YYYYMMDD>.log plus ONE pg_replication_slots
# sample -> slot_<YYYYMMDD>.log. standby: the walsender views are always empty
# there, so instead ONE pg_stat_get_wal_receiver() sample ->
# walrcv_<YYYYMMDD>.log (15 cols). OS part is role-independent (the name keeps
# "_repl" because deployed crontabs call `awr _repl-sample` -- do not rename).
# Row grammar (repl/slot logs):
#   data : ts,<view columns as selected below>
#   null : ts,null     (view = 0 rows: no standby / no slot)
#   error: ts,error    (psql failed; sampler keeps running, cron stays quiet)
# walrcv_<YYYYMMDD>.log row grammar (standby role only):
#   data : ts,receiver_pid,local_role,peer_role,peer_state,state,
#          sender_sent_location,sender_write_location,sender_flush_location,
#          sender_replay_location,receiver_received_location,
#          receiver_write_location,receiver_flush_location,
#          receiver_replay_location,sync_percent,channel   (15 fields)
#   null : ts,null     (no walreceiver: standalone primary or post-promote)
#   error: ts,error    (psql failed; sampler keeps running, cron stays quiet)
# The slot query is independent: its failure never disturbs the stat rows
# (and vice versa -- each log gets its own data/error/null row per minute).
# The OS sample is independent too: /proc reads only, no psql, its own log.
# At the very end this function also fires the 5-minute long-txn + callstack
# sampler (_awr_lt_stack_sample, own lt_/stack_ logs, same lock).
# os_<YYYYMMDD>.log row grammar (renderer = load_os_samples in the python):
#   cpu,<ts>,user,nice,system,idle,iowait,irq,softirq,steal,procs_running,procs_blocked
#   pg,<ts>,pgpgin,pgpgout,pswpin,pswpout,pgfault,pgmajfault          (vmstat)
#   mem,<ts>,MemTotal,MemFree,MemAvailable,Buffers,Cached,Slab,SwapFree (kB)
#          [,ZoneFree,ZoneMin,ZoneLow,ZoneHigh] (kB; zone watermarks summed
#          over all zones, appended when /proc/zoneinfo was readable)
#   dsk,<ts>,<raw /proc/diskstats line>   (spaces, no commas; renderer
#          re-parses with proc_disk_devs so partition filtering matches)
#   net,<ts>,<raw /proc/net/dev iface line>  (same; proc_net_ifaces filters)
#   tcp,<ts>,ActiveOpens,PassiveOpens,CurrEstab,OutSegs,RetransSegs  (snmp)
#   tcpext,<ts>,ListenDrops,ListenOverflows,Timeouts,SynRetrans      (netstat TcpExt)
#   conntrack,<ts>,count,max   (nf_conntrack; row omitted when module absent)
#   lstn,<ts>,recvq,sendq      (VB-port listener accept queue; ss -lnt,
#          dual stack; max queue across a v4+v6 listener pair)
#   lstnsock,<ts>,<state>,<count>  (TCP sockets whose LOCAL port is the DB
#          port, one row per state per minute; ss -tan sport = :PORT)
#   dbfd,<ts>,dbfile_live,dbfile_del,tmp_live,tmp_del,xlog_live,xlog_del
#          (REG fds of the DB port's postmaster under $PGDATA only: dbfile /
#          pgsql_tmp tempfile / pg_xlog, live + deleted-but-held; row absent
#          when the postmaster or its fd dir was not readable)
#   netmiss,<ts>,iface,rx_missed (sysfs rx_missed_errors, written even when 0)
#   ssrtt,<ts>,conns,rtt_min,rtt_avg,rtt_max,rtt_p95,worst_peer,worst_rtt
#          (ss -ti over ESTABLISHED, loopback peers excluded; rtt = kernel
#           smoothed estimate in ms; worst_rtt is worst_peer's rtt. Row is
#           omitted when 0 qualifying conns / no ss -> renderer hides RTT)
#   sspeer,<ts>,peer,lport,rtt,rttvar,cwnd,retrans,mss,sendq,rcv_rtt,min_rtt
#          (last two are EMPTY when ss did not print that field -- they are
#           conditional on the socket having a receive queue / a recorded
#           min_rtt; empty renders as '-' rather than a fake 0.000. The
#           8-field form without them is still accepted when reading old logs)
#          (per-CONNECTION rows, only the minute's top offenders: top 3 by
#           sendq (non-zero) + top 3 by rtt, deduped. Gives the renderer
#           window-PEAK per-peer tables instead of a single END-snap instant;
#           bounded ~6 rows/min worst case)
# Always returns 0 (cron-friendly; failures are data, not exit codes).
_awr_repl_sample() {
    local _plock; _plock=$(_awr_port_lockfile)
    mkdir -p "$(dirname "$_plock")" 2>/dev/null
    exec 8>"$_plock"
    flock -n -s 8 || { return 0; }   # migration in progress: skip this minute
    local root; root=$(_awr_root)
    umask 077   # per-minute logs carry standby addrs/LSNs: 0600 like snapshots
    mkdir -p "$root" 2>/dev/null || return 0
    local f ts out sf of og od8 today wrf
    f="$root/repl_$(date +%Y%m%d).log"
    sf="$root/slot_$(date +%Y%m%d).log"
    # Non-blocking mutual exclusion: if the previous run is still alive (DB
    # unreachable and hanging inside connect), skip this minute entirely --
    # no zombie pile-up, and no two instances interleaving rows (row order
    # must stay ts-monotonic for the renderer's last-seen logic). The fd is
    # inherited by psql, so the lock is held for the whole attempt.
    exec 9>"$root/repl.lock"
    flock -n 9 || return 0
    ts=$(date '+%F %T')
    # ---- role-aware source, re-checked EVERY minute so a switchover flips the
    # source mid-day without operator action. primary: walsender side
    # (pg_stat_replication + pg_replication_slots, unchanged). standby: the
    # walsender views are always empty there -- sample the walreceiver side
    # instead (pg_stat_get_wal_receiver(), the openGauss counterpart of PG's
    # pg_stat_wal_receiver view) into its own walrcv_<YYYYMMDD>.log. A failed
    # role probe falls through to the primary branch (which writes its own
    # error rows). The OS sample below runs for BOTH roles either way.
    wrf="$root/walrcv_$(date +%Y%m%d).log"
    # statement_timeout here too (audit 2026-10-30): without it a hung DB
    # (connects fine, queries never return) parks this psql forever, holding
    # repl.lock so every later minute's flock -n skips -- the OS /proc series
    # would stop exactly when a hang needs it most
    if PGCONNECT_TIMEOUT=15 PGOPTIONS='-c statement_timeout=15000' psql -d postgres -tAc "select pg_is_in_recovery()" 2>/dev/null | grep -qx 't'; then
        out=$(PGCONNECT_TIMEOUT=15 PGOPTIONS='-c statement_timeout=15000' \
              psql -d postgres -tAF',' -c "select receiver_pid,local_role,peer_role,peer_state,state,sender_sent_location,sender_write_location,sender_flush_location,sender_replay_location,receiver_received_location,receiver_write_location,receiver_flush_location,receiver_replay_location,sync_percent,channel from pg_stat_get_wal_receiver()" 2>/dev/null)
        if [ "$?" -ne 0 ]; then
            printf '%s,error\n' "$ts" >> "$wrf"
        elif [ -z "$out" ]; then
            printf '%s,null\n' "$ts" >> "$wrf"
        else
            printf '%s\n' "$out" | sed "s|^|$ts,|" >> "$wrf"
        fi
    else
    # Bound the attempt: connect fails fast (15s) and the query itself is
    # statement-timeout guarded, so one bad minute cannot stretch into a
    # multi-minute hang that blocks every later sample behind the lock.
    out=$(PGCONNECT_TIMEOUT=15 PGOPTIONS='-c statement_timeout=15000' \
          psql -d postgres -tAF',' -c "select application_name,client_addr,state,sync_state,sender_sent_location,receiver_write_location,receiver_flush_location,receiver_replay_location from pg_stat_replication order by application_name" 2>/dev/null)
    if [ "$?" -ne 0 ]; then
        printf '%s,error\n' "$ts" >> "$f"
    elif [ -z "$out" ]; then
        printf '%s,null\n' "$ts" >> "$f"
    else
        printf '%s\n' "$out" | sed "s|^|$ts,|" >> "$f"
    fi
    # ---- slot sample: same minute, same lock, own log; failure is contained.
    # confirmed_flush is not universal (G100 2.2.10's pg_replication_slots ends
    # at dummy_standby, user 2026-10-20): probe per sample, substitute an empty
    # alias when absent -- the 10-field log grammar (and the renderer's strict
    # 10-comma data-row check) stays byte-stable either way.
    local cf_col="confirmed_flush"
    PGCONNECT_TIMEOUT=15 PGOPTIONS='-c statement_timeout=15000' \
        psql -d postgres -tAc "select 1 from pg_attribute a, pg_class b, pg_namespace c where a.attrelid=b.oid and b.relnamespace=c.oid and b.relname='pg_replication_slots' and c.nspname='pg_catalog' and a.attname='confirmed_flush' limit 1" 2>/dev/null | grep -qx 1 || cf_col="''::text as confirmed_flush"
    out=$(PGCONNECT_TIMEOUT=15 PGOPTIONS='-c statement_timeout=15000' \
          psql -d postgres -tAF',' -c "select slot_name,plugin,slot_type,database,active,xmin,catalog_xmin,restart_lsn,dummy_standby,$cf_col from pg_replication_slots order by slot_name" 2>/dev/null)
    if [ "$?" -ne 0 ]; then
        printf '%s,error\n' "$ts" >> "$sf"
    elif [ -z "$out" ]; then
        printf '%s,null\n' "$ts" >> "$sf"
    else
        printf '%s\n' "$out" | sed "s|^|$ts,|" >> "$sf"
    fi
    fi   # end role-aware DB sample
    # ---- OS counters sample: same minute, same lock, own log; /proc reads
    # only (no psql) so it cannot hang; a failed read just writes fewer rows.
    # One awk over seven /proc files; dsk/net rows carry the raw line (fields
    # are space-separated, never contain commas), cpu/pg/mem carry numbers.
    of="$root/os_$(date +%Y%m%d).log"
    timeout -k 2 10 awk -v ts="$ts" -v pgkb="$(( $(getconf PAGE_SIZE 2>/dev/null || echo 4096) / 1024 ))" '
        /^cpu /           { if (!cudone) { cu=$2","$3","$4","$5","$6","$7","$8","$9; cudone=1 } }
        /^procs_running / { pr=$2 }
        /^procs_blocked / { pb=$2 }
        /^pgpgin /        { pgi=$2 }
        /^pgpgout /       { pgo=$2 }
        /^pswpin /        { psi=$2 }
        /^pswpout /       { pso=$2 }
        /^pgfault /       { pf=$2 }
        /^pgmajfault /    { pmf=$2 }
        /^MemTotal:/      { mt=$2 }
        /^MemFree:/       { mfr=$2 }
        /^MemAvailable:/  { mav=$2 }
        /^Buffers:/       { buf=$2 }
        /^Cached:/        { cach=$2 }
        /^Slab:/          { slab=$2 }
        /^SwapFree:/      { swf=$2 }
        # zoneinfo watermarks, summed over all zones (pages -> kB via pgkb);
        # EOL-anchored so the per-cpu pageset "high:" lines cannot match
        /^ +pages free +[0-9]+$/ { zf += $3 }
        /^ +min +[0-9]+$/        { zn++; zmin += $2 }
        /^ +low +[0-9]+$/        { zlow += $2 }
        /^ +high +[0-9]+$/       { zhigh += $2 }
        # snmp proto lines (header AND values) are consumed here with `next`
        # so the net/dev rule below can never mistake "Ip:"/"Tcp:" lines
        # (colon-terminated $1, NF>=17) for iface rows; the Tcp VALUES line
        # ($2 numeric) yields the tcp row counters
        /^(Ip|Icmp|IcmpMsg|Tcp|Udp|UdpLite): / {
            if ($1 == "Tcp:" && $2 ~ /^[0-9]+$/) { taop=$6; tpop=$7; tces=$10; tosg=$12; trsg=$13; tcpok=1 }
            next
        }
        # netstat TcpExt/IpExt: header line lays down column names, values line
        # (numeric $2) picks listen/congestion counters; `next` keeps these
        # colon-terminated NF>=17 lines out of the net/dev iface rule below
        $1 == "TcpExt:" || $1 == "IpExt:" {
            if ($1 == "TcpExt:") {
                if ($2 ~ /^[0-9]+$/) {
                    for (i = 2; i <= NF; i++) {
                        if (extn[i] == "ListenDrops") tld = $i
                        else if (extn[i] == "ListenOverflows") tlo = $i
                        else if (extn[i] == "TCPTimeouts") tto = $i
                        else if (extn[i] == "TCPSynRetrans") tsr = $i
                    }
                    extok = 1
                } else { for (i = 2; i <= NF; i++) extn[i] = $i }
            }
            next
        }
        # diskstats line shape: <major> <minor> <name> <14+ counters>, all-numeric
        # fields; skip ramN/loopN (always idle, never rendered, ~24 junk rows/min)
        NF>=14 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 !~ /^(ram|loop)[0-9]+$/ { print "dsk," ts "," $0 }
        # net/dev iface line shape: <iface>: <16 counters> (header lines have no colon-terminated $1)
        $1 ~ /:$/ && NF>=17 { print "net," ts "," $0 }
        END {
            if (cu) print "cpu," ts "," cu "," pr+0 "," pb+0
            if (pgi != "") print "pg," ts "," pgi+0 "," pgo+0 "," psi+0 "," pso+0 "," pf+0 "," pmf+0
            if (mt != "") {
                s = "mem," ts "," mt+0 "," mfr+0 "," mav+0 "," buf+0 "," cach+0 "," slab+0 "," swf+0
                if (zn) s = s "," zf*pgkb "," zmin*pgkb "," zlow*pgkb "," zhigh*pgkb
                print s
            }
            if (tcpok) print "tcp," ts "," taop+0 "," tpop+0 "," tces+0 "," tosg+0 "," trsg+0
            if (extok) print "tcpext," ts "," tld+0 "," tlo+0 "," tto+0 "," tsr+0
        }
    ' /proc/stat /proc/vmstat /proc/meminfo /proc/zoneinfo /proc/diskstats /proc/net/dev /proc/net/snmp /proc/net/netstat > "$of.part" 2>/dev/null \
        && cat "$of.part" >> "$of" 2>/dev/null
    rm -f "$of.part"
    # (2026-11-01: the read is timeout-bounded and stage-filed -- a wedged
    # seq_file used to park this awk forever WITH the sampler flock held, so
    # every later minute hit 'flock -n' and skipped: the whole per-minute OS
    # series silently stopped exactly during the storm being diagnosed. A
    # timed-out minute now simply contributes no rows; a partial write can
    # never merge into the next minute's first line.)
    # ---- conntrack count (firewall/nat only; file absent = no conntrack module) ----
    if [ -r /proc/sys/net/netfilter/nf_conntrack_count ]; then
        ccount=$(timeout -k 2 10 cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null)
        cmax=$(timeout -k 2 10 cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null)
        [ -n "$ccount" ] && printf 'conntrack,%s,%s,%s\n' "$ts" "${ccount:-0}" "${cmax:-0}" >> "$of" 2>/dev/null
    fi
    # ---- per-interface rx_missed_errors (ring-full drops). /proc/net/dev's
    # "drop" already merges rx_missed into rx_dropped, so this is the SPLIT
    # (not a duplicate): missed = ring-overflow subset of that merged drop.
    for _m in /sys/class/net/*/statistics/rx_missed_errors; do
        [ -r "$_m" ] || continue
        _mif=${_m%/statistics/rx_missed_errors}; _mif=${_mif##*/}
        case "$_mif" in lo|veth*|br-*|docker*|virbr*|tap*|tunl*) continue;; esac
        _mv=$(timeout -k 2 10 cat "$_m" 2>/dev/null)
        # written even when 0: 0 = ring never overflowed, no row = unknown
        [ -n "$_mv" ] && printf 'netmiss,%s,%s,%s\n' "$ts" "$_mif" "$_mv" >> "$of" 2>/dev/null
    done
    # ---- listener accept queue + per-state socket count on the VB port ----
    _ssbin=$(command -v ss 2>/dev/null || echo /usr/sbin/ss)
    if [ -x "$_ssbin" ]; then
        # the listen socket itself: Recv-Q = accept-queue depth (backlog not yet
        # accepted), Send-Q = backlog capacity. Sampled per minute.
        # dual stack on purpose: the snapshot-level socket table counts v4+v6,
        # so the per-minute series must too. A dual-stack listener binds two
        # sockets sharing one backlog -> report the largest queue seen.
        lstn=$(timeout -k 2 10 "$_ssbin" -lnt sport = :"${PGPORT:-5432}" 2>/dev/null | \
               awk 'BEGIN { rq = 0; sq = 0 }
                    NR>1 && $1=="LISTEN" { if ($2+0 > rq) rq=$2+0; if ($3+0 > sq) sq=$3+0; n++ }
                    END { if (n) print rq "," sq }')
        [ -n "$lstn" ] && printf 'lstn,%s,%s\n' "$ts" "$lstn" >> "$of" 2>/dev/null
        # every TCP socket whose LOCAL port is the DB port, counted by state.
        # ALL states are written every minute (0 when absent) so a missing row
        # always means "not sampled", never "none". $1 is the State column --
        # skip it unless it is a real state token, so an old iproute2 without
        # that column cannot feed Recv-Q numbers in. A state this kernel prints
        # but the canonical list lacks still gets its own row.
        # ss failing (missing, bad port filter) must yield NO rows: all-zero
        # rows would read as "measured: none", which is a different claim.
        _sout=$(timeout -k 2 10 "$_ssbin" -tan sport = :"${PGPORT:-5432}" 2>/dev/null)
        [ -n "$_sout" ] && printf '%s\n' "$_sout" | \
            awk -v ts="$ts" '
                BEGIN { n = split("LISTEN ESTAB SYN-SENT SYN-RECV FIN-WAIT-1 FIN-WAIT-2 TIME-WAIT CLOSE-WAIT CLOSING LAST-ACK CLOSED", S, " ");
                        for (i = 1; i <= n; i++) std[S[i]] = 1 }
                NR > 1 && $1 ~ /^[A-Z][A-Z0-9-]*$/ { c[$1]++ }
                END { for (i = 1; i <= n; i++) printf "lstnsock,%s,%s,%d\n", ts, S[i], c[S[i]] + 0
                      for (s in c) if (!(s in std)) printf "lstnsock,%s,%s,%d\n", ts, s, c[s] }' \
            >> "$of" 2>/dev/null
    fi
    # ---- db fd holdings (user 2026-10-30): REG fds of the DB port's
    # postmaster under $PGDATA only, three buckets -- dbfile / tempfile
    # (pgsql_tmp trees: sort/hash spills, routinely deleted-while-held) /
    # xlog (pg_xlog, user: 单独算). VB is single-process multi-thread, every
    # backend's fd lives on the postmaster, so ONE /proc walk covers the
    # whole instance (same pid discovery as the snapshot-side db_proc
    # collector; postmaster runs with cwd=$PGDATA). Tablespaces outside
    # $PGDATA are deliberately NOT counted (user: 只统计 DATADIR 下). The row
    # is written whenever the postmaster and its fd dir are readable --
    # 0 included; no pid / unreadable fd dir -> NO rows (missing row = not
    # sampled, never "none").
    _dpid=$(timeout -k 2 10 ss -lntp 2>/dev/null | grep -oP ":${PGPORT:-5432}\b.*pid=\K[0-9]+" | head -1)
    if [ -n "$_dpid" ] && [ -d "/proc/$_dpid/fd" ]; then
        _pdd=$(timeout -k 2 10 readlink "/proc/$_dpid/cwd" 2>/dev/null)
        if [ -n "$_pdd" ]; then
            _pdd="${_pdd%/}/"
            _fdout=$(timeout -k 2 10 ls -l "/proc/$_dpid/fd" 2>/dev/null)
            [ -n "$_fdout" ] && printf '%s\n' "$_fdout" | \
                awk -v ts="$ts" -v pd="$_pdd" '
                    { t = $0; sub(/^.* -> /, "", t)
                      if (t ~ / \(deleted\)$/) { d = 1; sub(/ \(deleted\)$/, "", t) } else d = 0
                      if (t !~ /^\//) next                      # socket:[..] pipe:[..] anon_inode:..
                      if (t ~ /^\/dev\//) next                  # device nodes
                      if (substr(t, 1, length(pd)) != pd) next  # outside $PGDATA
                      r = substr(t, length(pd) + 1)
                      b = "db"
                      if (index("/" r, "/pgsql_tmp/") > 0) b = "tmp"
                      else if (substr(r, 1, 8) == "pg_xlog/" || substr(r, 1, 7) == "pg_wal/") b = "xlog"
                      cl[b]++; if (d) cd[b]++ }
                    END { printf "dbfd,%s,%d,%d,%d,%d,%d,%d\n", ts, cl["db"]+0, cd["db"]+0,
                            cl["tmp"]+0, cd["tmp"]+0, cl["xlog"]+0, cd["xlog"]+0 }' \
                >> "$of" 2>/dev/null
        fi
    fi
    # ---- TCP RTT sample: ss -ti over ESTABLISHED sockets; loopback peers are
    # excluded (their sub-0.1ms rtt would pin rtt_min to ~0 and drown the real
    # network signal). Emits per minute: ONE aggregate ssrtt row (iff >=1
    # qualifying conn) + sspeer rows for the minute's worst connections (top 3
    # by sendq non-zero + top 3 by rtt, deduped) so reports show window PEAKS
    # per peer instead of a single END-snap instant. A missing/unreadable ss
    # writes no rows (renderer hides the RTT tables). Header layout differs by
    # iproute2 age: with State column ($1=ESTAB) vs State-column-less under
    # state filters ($1=Recv-Q numeric); info line carries rtt:a/b (kernel
    # smoothed estimate, ms), cwnd:, retrans:, mss:. p95 via insertion sort
    # (portable awk -- no asort); top-k via repeated max-extraction.
    sscmd=$(command -v ss 2>/dev/null || echo /usr/sbin/ss)
    if [ -x "$sscmd" ]; then
        timeout -k 2 10 "$sscmd" -tin state established 2>/dev/null | head -c 524288 | awk -v ts="$ts" '
            function flushconn() {
                if (peer != "" && keep && gotrtt) {
                    n++; sum += rttv; v[n] = rttv
                    if (minv == "" || rttv < minv) minv = rttv
                    if (rttv > maxv) { maxv = rttv; wp = peer }
                    ci++; cpeer[ci] = peer; clport[ci] = lport; crt[ci] = rttv
                    crtv[ci] = rttvv; ccw[ci] = cwndv + 0; cre[ci] = retrv + 0
                    cmss[ci] = mssv + 0; csq[ci] = sqv + 0
                    crcr[ci] = rcrvs; cmnr[ci] = mnrs
                }
                peer = ""; keep = 0; gotrtt = 0; rttv = rttvv = 0
                cwndv = retrv = mssv = 0; rcrvs = mnrs = ""
            }
            $1 == "ESTAB" || ($1 ~ /^[0-9]+$/ && NF >= 4) {
                flushconn()
                if ($1 == "ESTAB") { sqv = $3; lport = $4; peer = $5 }
                else              { sqv = $2; lport = $3; peer = $4 }
                sub(/^.*:/, "", lport)
                keep = (peer !~ /^127\./ && peer !~ /^\[::1\]/ && peer !~ /^::1:/)
                next
            }
            {
                if (peer != "" && keep) {
                    if (!gotrtt && match($0, /rtt:[0-9]+\.?[0-9]*\/[0-9]+\.?[0-9]*/)) {
                        split(substr($0, RSTART + 4, RLENGTH - 4), ab, "/")
                        rttv = ab[1] + 0; rttvv = ab[2] + 0; gotrtt = 1
                    }
                    if (!cwndv && match($0, /cwnd:[0-9]+/)) cwndv = substr($0, RSTART + 5, RLENGTH - 5) + 0
                    if (!retrv && match($0, /retrans:[0-9]+\//)) retrv = substr($0, RSTART + 8, RLENGTH - 8) + 0
                    if (!mssv && match($0, /mss:[0-9]+/)) mssv = substr($0, RSTART + 4, RLENGTH - 4) + 0
                    # rcv_rtt / min_rtt are CONDITIONAL in ss -ti
                    # (printed only once the socket has a receive queue / a
                    # recorded min_rtt). Keep "absent" distinct from a real 0
                    # by holding them as strings: "" prints as an empty field,
                    # the renderer shows '-' instead of a fake 0.000.
                    if (rcrvs == "" && match($0, /rcv_rtt:[0-9]+\.?[0-9]*/)) rcrvs = substr($0, RSTART + 8, RLENGTH - 8) + 0
                    if (mnrs == "" && match($0, /min_rtt:[0-9]+\.?[0-9]*/)) mnrs = substr($0, RSTART + 8, RLENGTH - 8) + 0
                }
            }
            END {
                flushconn()
                if (n > 0) {
                    for (i = 2; i <= n; i++) {
                        x = v[i]
                        for (j = i - 1; j >= 1 && v[j] + 0 > x + 0; j--) v[j+1] = v[j]
                        v[j+1] = x
                    }
                    pi = int(n * 0.95); if (pi < 1) pi = 1; if (pi > n) pi = n
                    printf "ssrtt,%s,%d,%.3f,%.3f,%.3f,%.3f,%s,%.3f\n", \
                           ts, n, minv, sum / n, maxv, v[pi], wp, maxv
                }
                # sspeer: top 3 by sendq (non-zero) then top 3 by rtt, deduped
                if (ci > 0) {
                    for (r = 1; r <= 3; r++) {
                        bi = 0; best = 0
                        for (i = 1; i <= ci; i++)
                            if (!used[i] && csq[i] > best) { best = csq[i]; bi = i }
                        if (bi) used[bi] = emit[bi] = 1
                    }
                    for (r = 1; r <= 3; r++) {
                        bi = 0; best = -1
                        for (i = 1; i <= ci; i++)
                            if (!used[i] && crt[i] > best) { best = crt[i]; bi = i }
                        if (bi) used[bi] = emit[bi] = 1
                    }
                    for (i = 1; i <= ci; i++) if (emit[i])
                        printf "sspeer,%s,%s,%s,%.3f,%.3f,%d,%d,%d,%d,%s,%s\n", \
                               ts, cpeer[i], clport[i], crt[i], crtv[i], \
                               ccw[i], cre[i], cmss[i], csq[i], \
                               crcr[i], cmnr[i]
                }
            }
        ' >> "$of" 2>/dev/null
    fi
    # ---- gzip past days' os logs (~10x smaller on these repetitive lines;
    # the renderer reads both os_*.log and os_*.log.gz). Today's file stays
    # plain so the per-minute append keeps working. The lt_/stack_/pw_ logs
    # join the pass (same reader discipline). ----
    today=$(date +%Y%m%d)
    for og in "$root"/os_*.log "$root"/lt_*.log "$root"/stack_*.log "$root"/sessmem_*.log "$root"/pw_*.log; do
        [ -f "$og" ] || continue
        od8=$(basename "$og" .log); od8="${od8#os_}"; od8="${od8#lt_}"; od8="${od8#stack_}"; od8="${od8#sessmem_}"; od8="${od8#pw_}"
        case "$od8" in
            [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
            *) continue;;
        esac
        [ "$od8" -lt "$today" ] && gzip -f "$og" 2>/dev/null
    done
    # ---- 5-minute extras: long-txn + callstack sample (same lock, own logs;
    # _awr_lt_stack_sample self-gates on minute % 5 == 0) ----
    _awr_lt_stack_sample "$root" "$ts"
    return 0
}

# _awr_snap [--root <dir>]  -- allocate snap_id, collect, write meta. The core
# primitive used by both manual `create` and the cron-fired `create`.
# _awr_db_up  -- cheap DB reachability probe: one psql connect + select 1,
# bounded by PGCONNECT_TIMEOUT so a blackholed network fails in 15s, not the
# kernel's ~127s SYN retries. Used by _awr_snap to gate BEFORE any snap work.
_awr_db_up() {
    PGCONNECT_TIMEOUT=15 PGOPTIONS="-c statement_timeout=60000" \
        psql -d postgres -tAc "select 1" >/dev/null 2>&1
}

_awr_snap() {
    # SHARED port lock (migration holds the exclusive one while moving the
    # root); -n: under a migrating root, skipping THIS minute is correct
    local _plock; _plock=$(_awr_port_lockfile)
    mkdir -p "$(dirname "$_plock")" 2>/dev/null
    exec 8>"$_plock"
    flock -n -s 8 || { echo "  [WARN] datadir migration in progress, snapshot skipped this round" >&2; return 0; }
    umask 077   # snapshots carry SQL literals: force 0700/0600 regardless of caller umask
    local root_override=""
    if [ "${1:-}" = "--root" ]; then root_override="${2:-}"; shift 2; fi
    local root; root="${root_override:-$(_awr_root)}"
    mkdir -p "$root" 2>/dev/null || { echo "Error: cannot create $root" >&2; return 1; }
    # Non-blocking mutual exclusion (kernel flock on a lockfile, shared across
    # the manual foreground run and the cron-fired runs): a previous create
    # still in flight (e.g. DB unreachable, hanging inside the probe) means
    # this run exits immediately -- no overlapping collectors, no duplicated
    # snap work. fd 9 is inherited by every psql below, so the lock covers the
    # whole collection.
    exec 9>"$root/create.lock"
    if ! flock -n 9; then
        echo "Error: another awr create is still running (lock $root/create.lock) -- try again later" >&2
        return 1
    fi
    # DB must be UP before ANY snap work (user decision 2026-09-03): no
    # snap_id consumed, no dir created, no OS collection, nothing to clean up.
    # _awr_collect keeps its own probe as a second guard (DB can die during
    # the ~5-10s collection window) -- that path removes the in-flight dir.
    if ! _awr_db_up; then
        echo "Error: cannot reach the database (port ${PGPORT:-5432}) -- snapshot NOT taken" >&2
        return 1
    fi
    local sid ts ts_ep dir
    sid=$(_awr_next_id) || return 1
    dir="$root/snap_$sid"
    # refuse to overwrite a COMPLETE snapshot (audit 2026-10-30): a corrupted/
    # truncated sequence file resets the id to 1 and would silently rm -rf the
    # existing snap_1, snap_2 ... one per create. In-flight leftovers carry no
    # meta.json (written only after a successful collect) and stay clearable.
    if [ -f "$dir/meta.json" ]; then
        echo "Error: snap_$sid already exists -- refusing to overwrite (sequence corrupt? inspect $root/sequence)" >&2
        return 1
    fi
    rm -rf "$dir" 2>/dev/null
    mkdir -p "$dir" 2>/dev/null || { echo "Error: cannot create $dir" >&2; return 1; }
    ts=$(date '+%F %T'); ts_ep=$(date +%s)
    echo "capturing snap $sid -> $dir"
    # collection failed midway (e.g. DB died during collection): discard the
    # in-flight dir -- a snap without db/ data would poison awr list/reports.
    if ! _awr_collect "$dir"; then
        rm -rf "$dir" 2>/dev/null
        echo "  [WARN] snap $sid skipped, nothing kept (collection failed)" >&2
        return 1
    fi
    if ! _awr_write_meta "$dir" "$sid" "$ts" "$ts_ep"; then
        rm -rf "$dir" 2>/dev/null
        echo "  [WARN] snap $sid skipped, nothing kept (meta write failed)" >&2
        return 1
    fi
    echo "snap $sid captured at $ts"
    _awr_purge_expired
    return 0
}

# awr create -- manual single-point snapshot (foreground, no -d, no html).
_awr_create() {
    local root_override=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --root)    [ $# -lt 2 ] && { echo "Error: --root requires a path" >&2; return 2; }
                       root_override="$2"; shift 2;;
            -h|--help) awr_help; return 0;;
            -d)        echo "Error: 'awr create' is a single-point snapshot (no -d). Use 'awr config interval <min>' + 'awr enable' for periodic capture." >&2; return 2;;
            --force)   echo "Error: --force not applicable to single-point snapshots" >&2; return 2;;
            *)         echo "Error: unexpected argument '$1' (awr create takes no name / no -d)" >&2; return 2;;
        esac
    done
    _awr_snap ${root_override:+--root "$root_override"}
}

# _awr_check_uptime <dir1> <dir2>  -- error+return 1 if the two snap DIRS span
# a DB restart (cumulative counters reset; end-begin meaningless). db_start_time
# = pg_postmaster_start_time(). Lenient: skipped if either snap lacks the field.
# (Dirs, not ids: callers may pass snap dirs that live under a baseline copy
# root, not only the main awrs root -- baseline support 2026-09-10.)
_awr_check_uptime() {
    local d1="$1" d2="$2"
    local s1 s2
    command -v python3 >/dev/null 2>&1 || { echo "Error: python3 required for restart guard (cannot read meta.json)" >&2; return 1; }
    s1=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('db_start_time',''))" "$d1/meta.json" 2>/dev/null)
    s2=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('db_start_time',''))" "$d2/meta.json" 2>/dev/null)
    if [ -n "$s1" ] && [ -n "$s2" ] && [ "$s1" != "$s2" ]; then
        echo "Error: DB restarted between the two snaps -- cumulative counters reset, no valid diff." >&2
        echo "       snap dir $d1 db_start_time: $s1" >&2
        echo "       snap dir $d2 db_start_time: $s2" >&2
        echo "       (pick snaps within the same DB uptime, or recreate after the restart)" >&2
        return 1
    fi
    return 0
}

# _awr_snap_root <begin_id> <end_id>  -- echo the root that holds BOTH snaps:
# the main awrs root if both are there, else the first baseline copy dir that
# contains both. rc 1 + stderr when the pair cannot be served from one storage
# area (one in main + one in a baseline is rejected: cross-root windows have
# no shared per-minute logs). (baseline support 2026-09-10)
_awr_snap_root() {
    local b="$1" e="$2"
    local root; root=$(_awr_root)
    if [ -d "$root/snap_$b" ] && [ -d "$root/snap_$e" ]; then
        echo "$root"; return 0
    fi
    local d found_b="" found_e=""
    for d in "$root"/baselines/*/; do
        [ -d "$d" ] || continue
        if [ -d "${d}snap_$b" ] && [ -d "${d}snap_$e" ]; then
            echo "${d%/}"; return 0
        fi
        [ -d "${d}snap_$b" ] && found_b=1
        [ -d "${d}snap_$e" ] && found_e=1
    done
    if { [ -n "$found_b" ] || [ -d "$root/snap_$b" ]; } && { [ -n "$found_e" ] || [ -d "$root/snap_$e" ]; }; then
        echo "Error: snaps $b and $e are not in the same storage area (main awrs root or one baseline) -- pick both ids from the main library or both from one baseline." >&2
    elif [ -z "$found_b" ] && [ ! -d "$root/snap_$b" ]; then
        echo "Error: snap $b not found (neither main root nor any baseline)" >&2
    else
        echo "Error: snap $e not found (neither main root nor any baseline)" >&2
    fi
    return 1
}

# _awr_baseline_json_get <baseline_dir> <key>  -- read one key from baseline.json
_awr_baseline_json_get() {
    python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get(sys.argv[2],''))" "$1/baseline.json" "$2" 2>/dev/null
}

# awr baseline begin <id> end <id>  -- register a baseline: SELF-CONTAINED copy
# (both endpoint snaps + the per-minute logs covering [begin-65s, end]) under
# awrs/<port>/baselines/<id>/. The main library keeps purging normally --
# baselines/ never matches the purge globs (top-level snap_*/repl_* etc only).
_awr_baseline_begin() {
    local _plock; _plock=$(_awr_port_lockfile)
    mkdir -p "$(dirname "$_plock")" 2>/dev/null
    exec 8>"$_plock"
    flock -n -s 8 || { echo "  [WARN] datadir migration in progress, retry later" >&2; return 1; }
    local begin_id="" end_id=""
    while [ $# -gt 0 ]; do
        case "$1" in
            begin)     [ $# -lt 2 ] && { echo "Error: 'begin' requires a snap_id" >&2; return 2; }
                       begin_id="$2"; shift 2;;
            end)       [ $# -lt 2 ] && { echo "Error: 'end' requires a snap_id" >&2; return 2; }
                       end_id="$2"; shift 2;;
            -h|--help) awr_help; return 0;;
            *)         echo "Error: unknown token '$1' (usage: baseline begin <snap_id> end <snap_id>)" >&2; return 2;;
        esac
    done
    if [ -z "$begin_id" ] || [ -z "$end_id" ]; then
        echo "Error: usage 'awr baseline begin <snap_id> end <snap_id>'" >&2; return 2
    fi
    case "$begin_id$end_id" in ''|*[!0-9]*)
        echo "Error: snap ids must be integers" >&2; return 2;; esac
    if [ "$begin_id" -ge "$end_id" ]; then
        echo "Error: begin snap ($begin_id) must be LOWER than end snap ($end_id)" >&2
        # rc=1 (data error): caller already gave clear guidance; awr_help would be noise
        return 1
    fi
    local root; root=$(_awr_root)
    local bdir="$root/snap_$begin_id" edir="$root/snap_$end_id"
    [ -d "$bdir" ] || { echo "Error: snap $begin_id not found in the MAIN library ($bdir) -- baselines register from the main library" >&2; return 1; }
    [ -d "$edir" ] || { echo "Error: snap $end_id not found in the MAIN library ($edir)" >&2; return 1; }
    _awr_check_uptime "$bdir" "$edir" || return 1
    umask 077
    # non-blocking mutual exclusion for the id scan+mkdir (same discipline as
    # create.lock): two concurrent 'baseline begin' would race max+1
    # ★fd 9 而非重绑 fd 8 (2026-11-26): exec 8> 会先关闭 fd 8 上的迁移锁文件 ⇒
    #   共享锁提前释放, 后面整个快照+日志拷贝期间数据目录迁移可并发推进。
    #   fd 8 保持 _plock 到函数结束, baselines.lock 走 fd 9(跨函数复用既有模式)。
    exec 9>"$root/baselines.lock"
    if ! flock -n 9; then
        echo "Error: another baseline operation is running -- try again" >&2
        return 1
    fi
    mkdir -p "$root/baselines" 2>/dev/null
    # next baseline id = max existing + 1
    local newid=1 d n
    for d in "$root"/baselines/*/; do
        [ -d "$d" ] || continue
        n=$(basename "$d")
        case "$n" in ''|*[!0-9]*) continue;; esac
        [ "$n" -ge "$newid" ] && newid=$((n+1))
    done
    local broot="$root/baselines/$newid"
    rm -rf "$broot"
    mkdir -p "$broot" || { echo "Error: cannot create $broot" >&2; return 1; }
    # copy endpoints + covering logs; any failure drops the half-made dir
    local f day
    if ! cp -a "$bdir" "$edir" "$broot"/ 2>/dev/null; then
        rm -rf "$broot"; echo "Error: copying snaps into $broot failed (disk full?)" >&2; return 1
    fi
    # day set = natural days spanned by [begin_ts - 65s, end_ts] (the renderers
    # load window is [begin-65s, end]: the 65s pre-sample needs the prior day
    # when the window starts just past midnight)
    local days
    days=$(python3 - "$bdir" "$edir" <<'PYBL'
import datetime, json, sys
tb = json.load(open(sys.argv[1] + "/meta.json"))["ts"]
te = json.load(open(sys.argv[2] + "/meta.json"))["ts"]
t0 = datetime.datetime.strptime(tb, "%Y-%m-%d %H:%M:%S") - datetime.timedelta(seconds=65)
t1 = datetime.datetime.strptime(te, "%Y-%m-%d %H:%M:%S")
d = t0.date()
while d <= t1.date():
    print(d.strftime("%Y%m%d")); d += datetime.timedelta(days=1)
PYBL
)
    if [ -z "$days" ]; then
        rm -rf "$broot"; echo "Error: cannot read snap timestamps for the log day set" >&2; return 1
    fi
    local _cpfail=0
    for day in $days; do
        # pw_ too (audit 2026-10-30): pagewriter's 5-min log is a first-class
        # series (awr pagew / Pagewriter Status) -- a baseline copy without it
        # breaks the self-contained promise for exactly that section
        for f in os_ repl_ slot_ walrcv_ lt_ pw_ stack_ sessmem_; do
            # design rule: a failed copy = incomplete self-contained baseline
            # -> roll the whole registration back (never half-register)
            [ -f "$root/${f}${day}.log" ] && { cp -p "$root/${f}${day}.log" "$broot/" 2>/dev/null || _cpfail=1; }
            [ -f "$root/${f}${day}.log.gz" ] && { cp -p "$root/${f}${day}.log.gz" "$broot/" 2>/dev/null || _cpfail=1; }
        done
    done
    if [ "$_cpfail" -ne 0 ]; then
        rm -rf "$broot"
        echo "Error: baseline log copy failed (disk full / permission?) -- half-registered baseline removed" >&2
        return 1
    fi
    if ! python3 - "$broot" "$newid" "$begin_id" "$end_id" "$bdir" "$edir" <<'PYBJ' 2>/dev/null
import datetime, json, sys
broot, newid, b, e, bdir, edir = sys.argv[1:7]
mb = json.load(open(bdir + "/meta.json")); me = json.load(open(edir + "/meta.json"))
json.dump({"baseline_id": int(newid), "begin_id": int(b), "end_id": int(e),
           "begin_ts": mb.get("ts", ""), "end_ts": me.get("ts", ""),
           "db_start_time": me.get("db_start_time", mb.get("db_start_time", "")),
           "created": datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")},
          open(broot + "/baseline.json", "w"), indent=2)
PYBJ
    then
        rm -rf "$broot"; echo "Error: writing baseline.json failed" >&2; return 1
    fi
    echo "baseline $newid created: snap $begin_id -> $end_id ($broot)"
}

# awr baseline info  -- list registered baselines (dynamic column widths).
_awr_baseline_info() {
    [ $# -eq 0 ] || { echo "Error: unexpected argument '$1' (usage: awr baseline info)" >&2; return 2; }
    local root; root=$(_awr_root)
    [ -d "$root/baselines" ] || { echo "(no baselines at $root)"; return 0; }
    python3 - "$root/baselines" <<'PYBI'
import glob, json, os, sys
rows = []
def _dn(p):   # numeric dir names sort numerically (1,2,...,10,11); junk last
    n = os.path.basename(p)
    return (0, int(n)) if n.isdigit() else (1, 0)
for d in sorted(glob.glob(os.path.join(sys.argv[1], "*")), key=_dn):
    if not os.path.isdir(d): continue
    try: m = json.load(open(os.path.join(d, "baseline.json")))
    except Exception: continue
    ok = (os.path.isdir(os.path.join(d, "snap_%s" % m.get("begin_id", ""))) and
          os.path.isdir(os.path.join(d, "snap_%s" % m.get("end_id", ""))))
    rows.append([str(m.get("baseline_id", "?")), str(m.get("begin_id", "?")),
                 str(m.get("end_id", "?")), m.get("begin_ts", "?"),
                 m.get("end_ts", "?"), m.get("db_start_time", "-"),
                 m.get("created", "?"), "" if ok else "MISSING"])
if not rows:
    print("(no baselines at %s)" % sys.argv[1]); sys.exit(0)
hdr = ["BASELINE_ID", "BEGIN", "END", "BEGIN_TS", "END_TS", "DB_START", "CREATED", "STATUS"]
w = [max(len(str(r[i])) for r in rows + [hdr]) for i in range(len(hdr))]
print(" ".join(h.ljust(w[i]) for i, h in enumerate(hdr)).rstrip())
print(" ".join("-" * min(w[i], 24) for i in range(len(hdr))))
for r in rows:
    print(" ".join(str(c).ljust(w[i]) for i, c in enumerate(r)).rstrip())
PYBI
}

# awr baseline delete <id>  -- drop the COPY dir only; the main library never
# knew about it.
_awr_baseline_delete() {
    local _plock; _plock=$(_awr_port_lockfile)
    mkdir -p "$(dirname "$_plock")" 2>/dev/null
    exec 8>"$_plock"
    flock -n -s 8 || { echo "  [WARN] datadir migration in progress, retry later" >&2; return 1; }
    [ $# -eq 1 ] || { echo "Error: usage 'awr baseline delete <baseline_id>'" >&2; return 2; }
    case "$1" in ''|*[!0-9]*) echo "Error: baseline id must be an integer" >&2; return 2;; esac
    local root; root=$(_awr_root)
    local broot="$root/baselines/$1"
    [ -d "$broot" ] || { echo "Error: baseline $1 not found ($broot)" >&2; return 1; }
    rm -rf "$broot"
    echo "baseline $1 deleted ($broot)"
}

# awr baseline report <id>  -- html report for a registered baseline. Same
# chain as awrrpt: root = the baseline copy dir (self-contained snaps + logs),
# sql_text falls back to the MAIN store (never purged there).
_awr_baseline_report() {
    [ $# -eq 1 ] || { echo "Error: usage 'awr baseline report <baseline_id>'" >&2; return 2; }
    case "$1" in ''|*[!0-9]*) echo "Error: baseline id must be an integer" >&2; return 2;; esac
    local root; root=$(_awr_root)
    local broot="$root/baselines/$1"
    [ -f "$broot/baseline.json" ] || { echo "Error: baseline $1 not found ($broot)" >&2; return 1; }
    local b e
    b=$(_awr_baseline_json_get "$broot" begin_id)
    e=$(_awr_baseline_json_get "$broot" end_id)
    [ -n "$b" ] && [ -n "$e" ] || { echo "Error: baseline $1 has no usable begin/end ids" >&2; return 1; }
    local bdir="$broot/snap_$b" edir="$broot/snap_$e"
    [ -d "$bdir" ] && [ -d "$edir" ] || { echo "Error: baseline $1 endpoint snaps missing (copy incomplete?)" >&2; return 1; }
    _awr_check_uptime "$bdir" "$edir" || return 1
    echo "baseline : report snap $b -> snap $e"
    # report name: baseline_{db}_{begin}_{end}.html (same default-naming rule as
    # awrrpt, only the prefix differs -- user 2026-09-11)
    _awr_render --begin "$bdir" --end "$edir" --repl-dir "$broot" --sqltext-root "$root" --name-prefix baseline -m dbtime -n 30
}

# awr baseline <begin|info|report|delete> -- dispatch
_awr_baseline() {
    local sub="$1"
    if [ -z "$sub" ]; then
        echo "Error: usage 'awr baseline <begin <id> end <id>|info|report <id>|delete <id>>'" >&2; return 2
    fi
    shift
    case "$sub" in
        begin)  _awr_baseline_begin begin "$@";;
        info)   _awr_baseline_info "$@";;
        report) _awr_baseline_report "$@";;
        delete) _awr_baseline_delete "$@";;
        -h|--help) awr_help; return 0;;
        *) echo "Error: unknown baseline subcommand '$sub' (begin|info|report|delete)" >&2; return 2;;
    esac
}


# awr awrrpt begin <id> end <id>  -- render diff html between two snaps.
_awr_awrrpt() {
    local begin_id="" end_id="" awr_only=""
    while [ $# -gt 0 ]; do
        case "$1" in
            begin)     [ $# -lt 2 ] && { echo "Error: 'begin' requires a snap_id" >&2; return 2; }
                       begin_id="$2"; shift 2;;
            end)       [ $# -lt 2 ] && { echo "Error: 'end' requires a snap_id" >&2; return 2; }
                       end_id="$2"; shift 2;;
            awronly)   awr_only=1; shift;;
            -h|--help) awr_help; return 0;;
            *)         echo "Error: unknown token '$1' (usage: awrrpt begin <id> end <id> [awronly])" >&2; return 2;;
        esac
    done
    if [ -z "$begin_id" ] || [ -z "$end_id" ]; then
        echo "Error: usage 'awr awrrpt begin <snap_id> end <snap_id> [awronly]'" >&2; return 2
    fi
    local root; root=$(_awr_snap_root "$begin_id" "$end_id") || return 1
    local bdir edir
    bdir="$root/snap_$begin_id"; edir="$root/snap_$end_id"
    if [ "$begin_id" -ge "$end_id" ] 2>/dev/null; then
        echo "Error: begin snap ($begin_id) must be LOWER than end snap ($end_id) -- 1-snap windows (begin==end) have no delta to render" >&2
        # rc=1 (data error): caller already gave clear guidance; awr_help would be noise
        return 1
    fi
    # restart guard (shared helper)
    _awr_check_uptime "$bdir" "$edir" || return 1
    echo "awrrpt : snap $begin_id -> snap $end_id"
    local rc=0 out rpt=""
    out=$(_awr_render --begin "$bdir" --end "$edir" --repl-dir "$root" --sqltext-root "$(_awr_root)" -m dbtime -n 30 2>&1) || rc=$?
    printf '%s\n' "$out"
    [ $rc -ne 0 ] && return $rc
    [ -n "$awr_only" ] && return 0

    # 同窗口日志分析（默认开，awronly 跳过）：时间取快照 meta 的 begin_ts/end_ts
    # （snap_id 兜底，其为 YYYYMMDDHHMMSS）；输出与 AWR 报告同目录配对命名
    # （awr_{db}_{b}_{e}.html -> analyze_log_{db}_{b}_{e}.html）。
    # 分析失败只警告，绝不影响 awrrpt 自身退出码。
    local bt et log_out
    # 单点快照模型：窗口 = 起快照采集时刻 ts -> 止快照采集时刻 ts；
    # begin_ts/end_ts（窗口模型 meta）优先，二者兼容。
    bt=$(python3 -c "import json;m=json.load(open('$bdir/meta.json'));print(m.get('begin_ts') or m.get('ts',''))" 2>/dev/null)
    et=$(python3 -c "import json;m=json.load(open('$edir/meta.json'));print(m.get('end_ts') or m.get('ts',''))" 2>/dev/null)
    [ -z "$bt" ] && [[ "$begin_id" =~ ^20[0-9]{12}$ ]] && bt="${begin_id:0:4}-${begin_id:4:2}-${begin_id:6:2} ${begin_id:8:2}:${begin_id:10:2}:${begin_id:12:2}"
    [ -z "$et" ] && [[ "$end_id" =~ ^20[0-9]{12}$ ]] && et="${end_id:0:4}-${end_id:4:2}-${end_id:6:2} ${end_id:8:2}:${end_id:10:2}:${end_id:12:2}"
    if [ -z "$bt" ] || [ -z "$et" ]; then
        echo "Warning: cannot resolve snapshot window (meta.json/snap_id), log analysis skipped" >&2
        return 0
    fi
    rpt=$(printf '%s\n' "$out" | sed -n 's/^  report : //p' | tail -1)
    echo "logrpt : $bt -> $et"
    # 静默执行：过程输出吞进变量（analyze_log_v2 本体不改），成功只报产物
    # 一行；失败一行告警。失败不影响 awrrpt 退出码。
    local rc2=0 lg_out="" lg_path=""
    if [ -n "$rpt" ]; then
        log_out="$(dirname "$rpt")/analyze_log_$(basename "$rpt" | sed 's/^awr_//; s/\.html$//').html"
        lg_out=$(run_analyze_log_v2 -b "$bt" -e "$et" -m all -o "$log_out" 2>&1) || rc2=$?
    else
        lg_out=$(run_analyze_log_v2 -b "$bt" -e "$et" -m all 2>&1) || rc2=$?
    fi
    if [ $rc2 -eq 0 ]; then
        lg_path=$(printf '%s\n' "$lg_out" | sed -n 's/^已生成HTML报告: //p' | tail -1)
        [ -z "$lg_path" ] && lg_path="$log_out"
        echo "  report : ${lg_path:-<analyze_log_v2 output>}"
    else
        echo "  error : logrpt failed" >&2
    fi
    # ---- 双产物打包 (user 2026-10-20): AWR + 配对日志分析两份 html 打成
    # awr_<begin><end>.tar,awr_reports 目录只留 tar;awronly / logrpt 失败
    # 不打包(各自只留单份 html)。tar 成功且非空才删原 html,失败原样保留。
    if [ $rc2 -eq 0 ] && [ -n "$rpt" ] && [ -n "${lg_path:-}" ] \
       && [ "$(dirname "$rpt")" = "$(dirname "$lg_path")" ] \
       && [ -s "$rpt" ] && [ -s "$lg_path" ]; then
        local tb te tarf
        tb=$(printf '%s' "$bt" | tr -d -- '-: ')
        te=$(printf '%s' "$et" | tr -d -- '-: ')
        tarf="$(dirname "$rpt")/awr_${tb}_${te}.tar"
        if tar -cf "$tarf" -C "$(dirname "$rpt")" "$(basename "$rpt")" "$(basename "$lg_path")" 2>/dev/null && [ -s "$tarf" ]; then
            rm -f "$rpt" "$lg_path"
            echo "packed : $tarf"
        else
            rm -f "$tarf"
            echo "Warning: pack failed, both html kept" >&2
        fi
    fi
    return 0
}

# awr awrdiff begin <a> end <b> begin <c> end <d>
#   period1 = snap a->b, period2 = snap c->d. AWR-style 3-col diff report.
# awr awrdiff begin <x> end <y> baseline <id>
#   period1 = the registered baseline (reference), period2 = snap x->y.
_awr_awrdiff() {
    local ids=() base_ref="" _expect="begin"
    while [ $# -gt 0 ]; do
        case "$1" in
            begin)     [ $# -lt 2 ] && { echo "Error: 'begin' requires a snap_id" >&2; return 2; }
                       # strict begin/end alternation (audit 2026-10-30):
                       # 'begin 1 begin 2 end 3 end 4' used to pair positionally
                       # into P1=1->2 / P2=3->4 silently
                       [ "$_expect" = "begin" ] || { echo "Error: expected 'end' before this 'begin' (begin/end must strictly alternate)" >&2; return 2; }
                       ids+=("$2"); _expect="end"; shift 2;;
            end)       [ $# -lt 2 ] && { echo "Error: 'end' requires a snap_id" >&2; return 2; }
                       [ "$_expect" = "end" ] || { echo "Error: expected 'begin' before this 'end' (begin/end must strictly alternate)" >&2; return 2; }
                       ids+=("$2"); _expect="begin"; shift 2;;
            baseline)  [ $# -lt 2 ] && { echo "Error: 'baseline' requires a baseline id" >&2; return 2; }
                       [ -n "$base_ref" ] && { echo "Error: only one 'baseline <id>' reference allowed" >&2; return 2; }
                       base_ref="$2"; shift 2;;
            -h|--help) awr_help; return 0;;
            *)         echo "Error: unknown token '$1' (usage: awrdiff begin <a> end <b> begin <c> end <d> | begin <x> end <y> baseline <id>)" >&2; return 2;;
        esac
    done
    local p1b p1e p2b p2e root1 root2
    if [ -n "$base_ref" ]; then
        # P1 = baseline (reference), P2 = explicit window (current): delta = P2 - P1
        # keeps the awrdiff header contract 'Delta = P2-P1' with the baseline
        # as the reference value (design doc 2026-09-10).
        [ "${#ids[@]}" -eq 2 ] || { echo "Error: 'baseline <id>' form expects exactly ONE begin/end pair plus the baseline (got ${#ids[@]} ids)" >&2; return 2; }
        case "$base_ref" in ''|*[!0-9]*) echo "Error: baseline id must be an integer" >&2; return 2;; esac
        local root; root=$(_awr_root)
        root1="$root/baselines/$base_ref"
        [ -f "$root1/baseline.json" ] || { echo "Error: baseline $base_ref not found ($root1)" >&2; return 1; }
        p1b=$(_awr_baseline_json_get "$root1" begin_id)
        p1e=$(_awr_baseline_json_get "$root1" end_id)
        [ -n "$p1b" ] && [ -n "$p1e" ] || { echo "Error: baseline $base_ref has no usable begin/end ids" >&2; return 1; }
        p2b="${ids[0]}"; p2e="${ids[1]}"
        root2=$(_awr_snap_root "$p2b" "$p2e") || return 1
    else
        [ "${#ids[@]}" -ne 4 ] && { echo "Error: usage 'awr awrdiff begin <a> end <b> begin <c> end <d>' (got ${#ids[@]} snap ids, need 4)" >&2; return 2; }
        p1b="${ids[0]}"; p1e="${ids[1]}"; p2b="${ids[2]}"; p2e="${ids[3]}"
        root1=$(_awr_snap_root "$p1b" "$p1e") || return 1
        root2=$(_awr_snap_root "$p2b" "$p2e") || return 1
    fi
    local d1b d1e d2b d2e
    d1b="$root1/snap_$p1b"; d1e="$root1/snap_$p1e"; d2b="$root2/snap_$p2b"; d2e="$root2/snap_$p2e"
    local d
    for d in "$d1b" "$d1e" "$d2b" "$d2e"; do
        [ -d "$d" ] || { echo "Error: snap dir not found: $d" >&2; return 1; }
    done
    # ordering errors (fatal): reversed periods produce negative counters that
    # mislead; overlap is just a warn since awrdiff tolerates the comparison.
    # rc=1 (data error): awr_help would be noise on top of the clear message.
    if [ "$p1b" -ge "$p1e" ] 2>/dev/null; then
        echo "Error: period1 begin ($p1b) must be LOWER than end ($p1e) -- 1-snap windows have no delta to render" >&2
        return 1
    fi
    if [ "$p2b" -ge "$p2e" ] 2>/dev/null; then
        echo "Error: period2 begin ($p2b) must be LOWER than end ($p2e) -- 1-snap windows have no delta to render" >&2
        return 1
    fi
    # id-space comparison is meaningless for the baseline form (P1 ids are from
    # registration time and can be anywhere vs current ids) -- WARN only when
    # both periods are current-window ids
    [ -z "$base_ref" ] && [ "$p1e" -gt "$p2b" ] 2>/dev/null && echo "  [WARN] period1 end ($p1e) > period2 begin ($p2b); periods overlap" >&2
    # restart guard PER PERIOD (each period's begin/end must be same uptime;
    # cross-period restart is allowed -- each period's delta is self-contained).
    _awr_check_uptime "$d1b" "$d1e" || return 1
    _awr_check_uptime "$d2b" "$d2e" || return 1
    # equal-window guard: the diff report's headline delta columns (DB Time,
    # per-SQL times, wait totals) are raw window deltas -- comparable only
    # across equally long periods (the per-second columns normalize, the deltas
    # do not). Primary rule (user): periods spanning the SAME NUMBER of
    # snapshot intervals (equal snap_id gap) pass -- with a uniform interval
    # that IS equal length. Equal gap but skewed real durations (manual snaps
    # inside a window) still pass, with a WARN. Fallback for differing gaps:
    # durations must match within 600s (cron :00 jitter is seconds).
    python3 - "$p1b" "$p1e" "$p2b" "$p2e" "$root1" "$root2" <<'PYDUR' || return 1
import json, sys
root1, root2 = sys.argv[5], sys.argv[6]
