                        # right behind the ESC (coalesced/scripted input) pre-fills it --
                        # bash cannot push a byte back to stdin.
                        # ★ESC 同时把框回 HINT (2026-11-17 复核): hint_cur 原先只有
                        #   0→1 和环形移动, 没有任何回 0 的路径 ⇒ 误按一次方向键后, 主屏
                        #   Enter 永远变成"进所选子屏", 用户文档里的 Enter=cmd 再也回不来。
                        #   ESC 本就是"原路径/命令行"的入口 (用户令 "原有进入方式也支持"),
                        #   用它顺手把框撤回 HINT (0), 两种 Enter 语义就都能到达。
                        hint_cur=0
                        _vtop_cmd_exec "$_vtop_drain_ret"
                        [ "$_vtop_cmd_quit" = "1" ] && break
                    fi
                    ;;
                $'\n'|$'\r')
