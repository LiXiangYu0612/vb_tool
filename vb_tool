        t1=$(date +%s%3N); d1=$(_vtop_diskstats "$dev"); c1=$(_vtop_cpustat); n1=$(_vtop_net)
        dt=$(( t1 - t0 )); [ "$dt" -le 0 ] && dt=1
        read -r a_us a_sy a_id a_wa a_st <<< "$(awk -v a="$c0" -v b="$c1" 'BEGIN{split(a,x);split(b,y);d=y[1]-x[1];if(d<=0)d=1;printf "%.1f %.1f %.1f %.1f %.1f", (y[2]-x[2])*100/d, (y[3]-x[3])*100/d, (y[4]-x[4])*100/d, (y[5]-x[5])*100/d, (y[6]-x[6])*100/d}')"
        read -r d_rops d_rmb d_rms d_wops d_wmb d_wms d_util <<< "$(awk -v a="$d0" -v b="$d1" -v ms="$dt" 'BEGIN{split(a,x);split(b,y);for(i=1;i<=7;i++){if(x[i]=="")x[i]=0;if(y[i]=="")y[i]=0}
            ro=y[1]-x[1]; rs=(y[2]-x[2])*512; rt=y[3]-x[3]; wo=y[4]-x[4]; ws=(y[5]-x[5])*512; wt=y[6]-x[6]; it=y[7]-x[7];
            if(ro<0)ro=0; if(rs<0)rs=0; if(rt<0)rt=0; if(wo<0)wo=0; if(ws<0)ws=0; if(wt<0)wt=0; if(it<0)it=0;
            s=ms/1000; rl=(ro>0)?rt/ro:0; wl=(wo>0)?wt/wo:0; u=(it*100/ms); if(u>100)u=100;
            printf "%.0f %.1f %.1f %.0f %.1f %.1f %.0f", ro/s, rs/1048576/s, rl, wo/s, ws/1048576/s, wl, u}')"
        read -r n_rx n_tx <<< "$(awk -v a="$n0" -v b="$n1" -v ms="$dt" 'BEGIN{split(a,x);split(b,y);s=ms/1000; printf "%.1f %.1f", (y[1]-x[1])/1048576/s, (y[2]-x[2])/1048576/s}')"
        read -r mt mf ma mbc mst msf <<< "$(_vtop_mem)"
        local mep
        mep=$(awk -v t="$mt" -v a="$ma" 'BEGIN{printf (t>0)?int((t-a)*100/t):0}')

        # ---- DB sections ----
        local db section="" h_node h_ver h_up s_tot s_act s_iit s_idle s_ltx m_used m_max m_dyu m_dym m_dyp m_shr m_shrp m_sbuf
        local r_sqlid r_cpu r_ns r_rn r_et r_st r_we r_sql ms_sid ms_usr ms_db ms_sz ms_sql
        local cpupairs="0,0" VT_TOP
        if [ -n "$pm_pid" ]; then
            cpupairs=$(top -b -d0.3 -n2 -H -p "$pm_pid" 2>/dev/null \
                | awk '/^ *PID USER/ {n++; ci=0; for(i=1;i<=NF;i++) if($i=="%CPU") ci=i; next} n==2 && /^ *[0-9]+ / {if(ci) print $1 "," $ci}' \
                | paste -sd ';')
        fi
        [ -n "$cpupairs" ] || cpupairs="0,0"
        VT_TOP="\echo ===TOP
with cput as (
  select split_part(result, ',', 1) lwpid, split_part(result, ',', 2)::numeric cpu_usage
  from regexp_split_to_table('${cpupairs}', ';') as result),
cpu as (
  select coalesce(a.unique_sql_id::text,'pid:'||a.pid::text) k, round(sum(t.cpu_usage),1) cpu
  from cput t
  join pg_os_threads s on s.lwpid = t.lwpid
  join pg_stat_activity a on s.pid = a.pid
  group by coalesce(a.unique_sql_id::text,'pid:'||a.pid::text))
select g.k, coalesce(cpu,0.0) cpu, g.ns, g.rn, coalesce(g.et::text,'-') et, g.sql
from (
  select k, count(*) ns, sum(rn) rn, sum(et) et,
         max(sql) sql
  from (
    select coalesce(a.unique_sql_id::text,'pid:'||a.pid::text) k,
           case when coalesce(w.wait_event,'-') = 'none' then 1 else 0 end rn,
           extract(epoch from (now()-a.query_start))::bigint et,
           coalesce(substr(regexp_replace(regexp_replace(a.query,'(\r|\n)+',' '),' {2,}',' '),1,150),'-') sql
    from pg_stat_activity a
    left join dbe_perf.thread_wait_status w on a.sessionid = w.sessionid
    where a.state <> 'idle' and a.datname is not null
      and coalesce(a.application_name,'') not in ('JobScheduler','Asp','workload','WdrSnapshot')
  ) t group by k
) g
left join cpu on cpu.k = g.k
order by cpu desc, rn desc, ns desc, et desc nulls last
limit ${topn};"
        db=$(printf '%s\n%s\n' "$VT_SQL" "$VT_TOP" | PGCONNECT_TIMEOUT=5 psql -d postgres -X -At -F'|' 2>/dev/null)
        {
        if [ -z "$db" ]; then
            printf 'vbtop: (db unreachable)   port %s   refresh %ds   %s cores   %s\n' \
                "${PGPORT:-5432}" "$interval" "$cores" "$(date '+%F %T')"
            _vtop_print_os
        else
            ev_buf="" ctx_txt="" blk_raw="" ltx_raw=""
            while IFS= read -r line; do
                case "$line" in
                    ===HDR)  section=HDR; continue;;
                    ===SESS) section=SESS; continue;;
                    ===ISTAT) section=ISTAT; continue;;
                    ===DBM)  section=DBM; continue;;
                    ===CTX)  section=CTX; continue;;
                    ===BLK)  section=BLK; continue;;
                    ===WAIT) section=WAIT; continue;;
                    ===LTX)  section=LTX; continue;;
                    ===MEMSES)
                        printf 'vbtop: %s  %s\n' "$h_node" "$h_ver"
                        printf 'port %s   up %s   refresh %ds   %s   %s\n' \
                            "${PGPORT:-5432}" \
                            "$(awk -v s="$h_up" 'BEGIN{printf "%dd%02dh%02dm", int(s/86400), int(s%86400/3600), int(s%3600/60)}')" \
                            "$interval" "$cores" "$(date '+%F %T')"
                        _vtop_print_os
                        if [ -n "$s_tot" ]; then
                            local ltx_disp="$s_ltx"
                            [ "$s_ltx" -gt 0 ] 2>/dev/null && ltx_disp="${c_red}${s_ltx}${c_off}"
                            printf 'SESS    tot %s   act %s   idl %s   idtx %s   ltx60 %s\n' \
                                "$s_tot" "$s_act" "$s_idle" "$s_iit" "$ltx_disp"
                        fi
                        if [ -n "$ltx_raw" ]; then
                            printf 'LTX     %-14s %-9s %-9s %-8s %7s %-19s %s\n' "SID" "USER" "DB" "STATE" "AGE" "EVENT" "SQLTEXT"
                            _vtop_rule_cols '        ' 14 9 9 8 7 19 40
                            local l_sid l_usr l_db l_st l_age l_we l_sql l_ah
                            while IFS='|' read -r l_sid l_usr l_db l_st l_age l_we l_sql; do
                                [ -z "$l_sid" ] && continue
                                l_ah=$(awk -v x="$l_age" 'BEGIN{s=x;d=int(s/86400);h=int(s%86400/3600);m=int(s%3600/60);ss=s%60; if(d>0)printf "%dd%02dh",d,h; else if(h>0)printf "%dh%02dm",h,m; else printf "%dm%02ds",m,ss}')
                                printf '%s' "$c_red"
                                printf '        %-14.14s %-9.9s %-9.9s %-8.8s %7s %-19.19s %.40s\n' "$l_sid" "$l_usr" "$l_db" "$l_st" "$l_ah" "$l_we" "$l_sql"
                                printf '%s' "$c_off"
                            done <<< "$ltx_raw"
                        else
                            printf 'LTX     none\n'
                        fi
                        printf 'ISTAT   %s\n' "${ist_txt:--}"
            if [ -n "$ev_buf" ]; then
                            printf 'EVENT   %-28s %10s %8s %7s  CLASS\n' "NAME(RT)" "WAITS" "TIME" "AVG"
                            _vtop_rule_cols '        ' 28 10 8 7 7
                            printf '%s' "$ev_buf" | sort -t'|' -k1,1rn | head -5 | while IFS='|' read -r _dt _dw _cl _nm; do
                                [ -z "$_nm" ] && continue
                                _avg=0; [ "$_dw" -gt 0 ] 2>/dev/null && _avg=$((_dt / _dw))
                                printf '        %-28.28s %10d %8s %7s  %s\n' "$_nm" "$_dw" "$(_vtop_fmt_us $_dt)" "$(_vtop_fmt_us $_avg)" "$_cl"
                            done
                        else
                            printf 'EVENT   (no waits in this interval)\n'
                        fi
                        local mem_col=""
                        if awk -v p="$m_used" -v m="$m_max" -v y="$m_dyu" -v n="$m_dym" 'BEGIN{exit !((m>0 && p/m*100>=90) || (n>0 && y/n*100>=90))}'; then mem_col=$c_red
                        elif awk -v p="$m_used" -v m="$m_max" 'BEGIN{exit !(m>0 && p/m*100>=75)}'; then mem_col=$c_ylw; fi
                        if [ -n "$m_used" ]; then
                            printf '%s' "$mem_col"
                            printf 'DBMEM   process %sG/%sG   dynamic %sG/%sG (peak %sG)   dynamic-shared %sG (peak %sG)   shared_buffers %s\n' \
                                "$m_used" "$m_max" "$m_dyu" "$m_dym" "$m_dyp" "$m_shr" "$m_shrp" "${m_sbuf:--}"
                            printf '%s' "$c_off"
                        fi
                        [ -n "$ctx_txt" ] && printf 'MEMCTX  %s\n' "$ctx_txt"
                        printf 'TOPMEM  %-14s %-9s %-9s %-8s %9s %s\n' "SID" "USER" "DB" "STATE" "MEM" "SQLTEXT"
                        _vtop_rule_cols '        ' 14 9 9 8 9 68
                        section=MEMSES; continue;;
                    ===TOP)
                        printf 'TOPSQL  %-11s %6s %7s %7s %s\n' "SQLID" "CPU%" "RUN/TOT" "ET(s)" "SQLTEXT"
                        _vtop_rule_cols '        ' 11 6 7 7 100
                        section=TOP; continue;;
                esac
                case "$section" in
                    HDR)  IFS='|' read -r h_node h_ver h_up <<< "$line";;
                    SESS) IFS='|' read -r s_tot s_act s_iit s_idle s_ltx <<< "$line";;
                    ISTAT) IFS='|' read -r i_xc i_xr i_br i_bh i_tb i_lsn <<< "$line"
                          # counters restart at 0 on instance restart: negative deltas -> treat as first frame
                          if [ -n "$prev_lsn" ] && [ "$dt" -gt 0 ] && [ "$i_lsn" -ge "$prev_lsn" ] 2>/dev/null; then
                              _tps=$(( (i_xc - prev_xc + i_xr - prev_xr) * 1000 / dt ))
                              _rb=$(( (i_xr - prev_xr) * 1000 / dt ))
                              _lg=$(( (i_br - prev_br + i_bh - prev_bh) * 1000 / dt * 8192 ))
                              _ph=$(( (i_br - prev_br) * 1000 / dt * 8192 ))
                              _rd=$(( (i_lsn - prev_lsn) * 1000 / dt ))
                              _tp=$(( (i_tb - prev_tb) * 1000 / dt ))
                              ist_txt="tps $_tps (roll $_rb)   logical $(_vtop_fmt_b $_lg)/s   physical $(_vtop_fmt_b $_ph)/s   redo $(_vtop_fmt_b $_rd)/s   temp $(_vtop_fmt_b $_tp)/s"
                          fi
                          prev_xc=$i_xc; prev_xr=$i_xr; prev_br=$i_br; prev_bh=$i_bh; prev_tb=$i_tb; prev_lsn=$i_lsn;;
                    DBM)  IFS='|' read -r m_used m_max m_dyu m_dym m_dyp m_shr m_shrp m_sbuf <<< "$line";;
                    CTX)  ctx_txt="$line";;
                    BLK)  blk_raw="${blk_raw}${line}"$'\n';;
                    LTX)  ltx_raw="${ltx_raw}${line}"$'\n';;
                    WAIT) IFS='|' read -r wc_type ev_name ev_w ev_t <<< "$line"
                          key="${wc_type}|${ev_name}"
                          pw=${_vw_prev[$key]:-}
                          pt=${_vt_prev[$key]:-}
                          if [ -n "$pw" ]; then
                              dw=$((ev_w - pw)); dt=$((ev_t - pt))
                              [ "$dt" -gt 0 ] 2>/dev/null && ev_buf="${ev_buf}${dt}|${dw}|${wc_type%_EVENT}|${ev_name}"$'\n'
                          fi
                          _vw_prev[$key]=$ev_w; _vt_prev[$key]=$ev_t;;
                    MEMSES) IFS='|' read -r ms_sid ms_usr ms_db ms_st ms_sz ms_sql <<< "$line"
                            printf '        %-14.14s %-9.9s %-9.9s %-8.8s %9s %.68s\n' "$ms_sid" "$ms_usr" "$ms_db" "$ms_st" "$ms_sz" "$ms_sql";;
                    TOP)  IFS='|' read -r r_sqlid r_cpu r_ns r_rn r_et r_sql <<< "$line"
                          local sql_col=""
                          awk -v c="$r_cpu" 'BEGIN{exit !(c>=90)}' && sql_col=$c_red
                          printf '%s' "$sql_col"
                          printf '        %-11.11s %6s %7s %7s %.100s\n' "$r_sqlid" "${r_cpu}%" "${r_rn}/${r_ns}" "$r_et" "$r_sql"
                          printf '%s' "$c_off";;
                esac
            done <<< "$db"
            if [ -n "$blk_raw" ]; then
                printf 'LOCK    %-7s %-7s %-15s %-8s %4s  %s\n' "AGE" "STATE" "FINAL BLOCKER" "USER" "BLK" "QUERY"
                _vtop_rule_cols '        ' 7 7 15 8 4 40
                local k_lvl k_st k_sid k_usr k_blk k_age k_sql k_ah
                while IFS='|' read -r k_lvl k_st k_sid k_usr k_blk k_age k_sql; do
                    [ -z "$k_sid" ] && continue
                    k_ah=$(awk -v x="$k_age" 'BEGIN{s=x;d=int(s/86400);h=int(s%86400/3600);m=int(s%3600/60);ss=s%60; if(d>0)printf "%dd%02dh",d,h; else if(h>0)printf "%dh%02dm",h,m; else if(m>0)printf "%dm%02ds",m,ss; else printf "%ds",ss}')
                    printf '%s' "$c_red"
                    printf '        %-7s %-7s %-15.15s %-8.8s %4s  %s\n' "$k_ah" "$k_st" "$k_sid" "$k_usr" "$k_blk" "$k_sql"
                    printf '%s' "$c_off"
                done <<< "$blk_raw"
            else
                printf 'LOCK    none\n'
            fi
        fi
        } > "$_vtop_f"
        if [ -t 1 ]; then
            printf '\033[H'
            while IFS= read -r _fl; do printf '%s\033[K\n' "$_fl"; done < "$_vtop_f"
            printf '\033[J'
        else
            cat "$_vtop_f"
        fi
        [ "$once" = "1" ] && break
        t0=$t1; d0=$d1; c0=$c1; n0=$n1
    done
    rm -f "$_vtop_f"
    return 0
}

# ---- global -P <port>: multi-instance support (all database commands) ------
# Resolved ONCE here (before dispatch) and exported as PGPORT for this process
# only: every child psql/vsql connection inherits it; nothing persists after
# the run. Without -P the current $PGPORT environment variable applies
# (libpq's built-in 5432 is reached only when PGPORT is unset).
# NOTE: keep this block OUTSIDE the awr region (above its header): the awr
# build/merge chain replaces [awr header .. column-0 'case "$1" in'] verbatim.
_vb_port_args=()
while [ $# -gt 0 ]; do
    case "$1" in
        -P)
            if [ $# -lt 2 ] || ! printf '%s' "${2:-}" | grep -qE '^[0-9]+$' || [ "${2:-}" -lt 1 ] || [ "${2:-}" -gt 65535 ]; then
                echo "Error: -P expects a port number (1-65535), e.g. -P 5433" >&2
                exit 2
            fi
            export PGPORT="$2"; shift 2;;
        -P[0-9]*)
            _vb_p="${1#-P}"
            if [ "$_vb_p" -lt 1 ] || [ "$_vb_p" -gt 65535 ]; then
                echo "Error: -P expects a port number (1-65535), e.g. -P 5433" >&2
                exit 2
            fi
            export PGPORT="$_vb_p"; shift
            unset _vb_p;;
        *)
            _vb_port_args+=("$1"); shift;;
    esac
done
set -- ${_vb_port_args[@]+"${_vb_port_args[@]}"}
unset _vb_port_args

# ================== se: show-event knowledge base (oerr style) ==================
# vb_tool se <event>     exact match -> unique substring -> candidate list;
#                        prints the FULL event name, type, meaning, kernel
#                        source trigger points, wait causes and fixes.
# vb_tool se -l [<kw>]   list events (optional substring filter).
# The knowledge base lives at the bottom of this file as a gzip+base64
# comment block (#@@KB markers + #K lines) -- run_se decodes it on demand,
# so the 450 KB of plain text costs ~185 KB in the shipped script and adds
# zero startup cost for other commands. Editable source of truth:
# vb_tool_baseline/se_kb.txt (plain) -> re-embed via the assembler.
# Grounded in the openGauss 6.0.0 kernel source; fully offline. This block
# sits BEFORE the awr region so resync leaves it alone.
se_help() {
    cat <<'EOF'
Usage: vb_tool se <event_name>       explain one wait event (oerr style)
       vb_tool se -l [<keyword>]     list events (optional substring filter)

  Wait-event knowledge base (419 events of dbe_perf.wait_events: LOCK /
  IO / STATUS / LWLOCK families): full event name, type, meaning,
  kernel-source trigger points, why sessions wait on it, and what to do.
  Matching is case-insensitive: exact name first, then unique substring
  (e.g. se procarray resolves ProcArrayLock, se walwritelock the WAL lock);
  ambiguous or unknown input lists candidates and hints.
  Fully offline -- nothing touches the database.
EOF
}

run_se() {
    local mode="show" q=""
    if [ "$1" = "-l" ] || [ "$1" = "--list" ]; then
        mode="list"; shift
    fi
    q="$1"
    if [ -z "$q" ] && [ "$mode" != "list" ]; then
        echo "Error: se needs an event name (vb_tool se procarray) or -l" >&2
        return 2
    fi
    _se_kb_dump | awk -v q="$q" -v mode="$mode" '
    function lc(s) { return tolower(s) }
    function stripped(s) { gsub(/[^a-z0-9]/, "", s); return s }
    function show(i) {
        printf "Event:    %s\n", name[i]
        printf "Type:     %s\n", type[i]
        printf "Meaning:  %s\n", desc[i]
        printf "Triggers: (openGauss 6.0.0 source sites)\n"
        pr_body(body[i, "trig"])
        printf "Why:\n"
        pr_body(body[i, "cause"])
        printf "Fix:\n"
        pr_body(body[i, "fix"])
    }
    function pr_body(s) {
        if (s == "") { printf "  (none)\n"; return }
        m = split(s, L, "\n")
        for (k = 1; k <= m; k++) if (L[k] != "") printf "  %s\n", L[k]
    }
    {
        line = $0
        sub(/^# ?/, "", line)
        if (line ~ /^@@NAME@@ /) {
            n++; name[n] = substr(line, 10); f = ""
        } else if (line ~ /^@@TYPE@@ /) { type[n] = substr(line, 10); f = "" }
        else if (line ~ /^@@DESC@@ /) { desc[n] = substr(line, 10); f = "" }
        else if (line == "@@TRIG@@")  { f = "trig" }
        else if (line == "@@CAUSE@@") { f = "cause" }
        else if (line == "@@FIX@@")   { f = "fix" }
        else if (line == "@@END@@")   { f = "" }
        else if (f != "" && n > 0)    { body[n, f] = body[n, f] line "\n" }
    }
    END {
        if (mode == "list") {
            cnt = 0
            for (i = 1; i <= n; i++) if (!(name[i] in seen2) && (q == "" || index(lc(name[i]), lc(q)) > 0)) {
                seen2[name[i]]
                printf "  %-44s [%s]\n", name[i], type[i]; cnt++
            }
            if (q == "") printf "\n  %d event(s) in the knowledge base\n", cnt
            else         printf "\n  %d event(s) matched [%s]  (vb_tool se <name> for details)\n", cnt, q
            exit 0
        }
        qq = lc(q)
        for (i = 1; i <= n; i++) if (lc(name[i]) == qq) { show(i); exit 0 }
        h = 0
        for (i = 1; i <= n; i++) if (index(lc(name[i]), qq) > 0) { h++; hi = i }
        if (h == 1) { show(hi); exit 0 }
        if (h > 1) {
            printf "Error: [%s] matches %d events -- pick one:\n\n", q, h
            c = 0
            for (i = 1; i <= n; i++) if (index(lc(name[i]), qq) > 0 && c < 25) {
                printf "  %-44s [%s]\n", name[i], type[i]; c++ }
            if (h > 25) printf "  ... (%d more)\n", h - 25
            printf "\n  usage: vb_tool se <full_event_name>\n"
            exit 1
        }
        sq = stripped(qq); ntok = split(qq, tok, /[^a-z0-9]+/)
        for (i = 1; i <= n; i++) {
            if (stripped(lc(name[i])) == sq) { show(i); exit 0 }
            ok = 1; nt = 0
            for (t = 1; t <= ntok; t++) if (length(tok[t]) >= 2) {
                nt++
                if (index(lc(name[i]), tok[t]) == 0) { ok = 0 }
            }
            if (nt > 0 && ok) { show(i); exit 0 }
        }
        printf "Error: no event matches [%s].\n\n", q
        c = 0
        for (i = 1; i <= n; i++) {
            for (t = 1; t <= ntok; t++) if (length(tok[t]) >= 3 && index(lc(name[i]), tok[t]) > 0) {
                printf "  %-44s [%s]\n", name[i], type[i]; c++; break }
            if (c >= 10) break
        }
        if (c > 0) printf "\n  similar event(s) above -- maybe one of these?\n"
        printf "  hint: list all events:  vb_tool se -l    (filter: vb_tool se -l wal)\n"
        printf "  examples: vb_tool se procarray | se walwritelock | se transactionid | se Sort\n"
        exit 1
    }
    '
    return $?
}

# dump the embedded knowledge base: sed-extract the #K block from this very
# script, drop the comment prefix, then base64+gunzip back to plain text.
_se_kb_dump() {
    sed -n '/^#@@KB-START@@/,/^#@@KB-END@@/p' "$0" \
        | sed -e '1d;$d' -e 's/^#K //' \
        | base64 -d 2>/dev/null | gzip -dc 2>/dev/null
}

# ================== awr management (v1) ==================
#
# Oracle-style single-point performance snapshots. Each `awr create` captures one
# instantaneous OS+DB sample (a "snap") tagged with a monotonic snap_id. A report
# (`awr awrrpt`) is the cumulative-counter delta between two snaps (end - begin),
# like an AWR single-period report. Periodic capture via `awr enable` (crontab).

awr_help() {
    cat <<'EOF'
Usage: vb_tool awr <create|enable|disable|awrrpt|awrdiff|topsql|event|summary|tabstat|cpu|io|page|replstat|replslot|replay|list|show|delete|config> [options]

Single-point performance snapshots (Oracle AWR style). Each snapshot is an
instantaneous OS+DB sample assigned a monotonic snap_id. An AWR report is the
counter delta between two snapshots (end - begin).

  create  [--root <dir>]    capture ONE single-point snapshot now (foreground,
                            ~5-10s), assigns the next snap_id. No html.
                            --root overrides the storage root (default:
                            $VB_TOOL_HOME/awrs/<port>)
  enable                    install crontab entries: snapshot every <interval>
                            MINUTES (see 'config interval', default 60) +
                            replication sampler every 1 minute; expired data
                            auto-purged after each capture
  disable                   remove both crontab entries (snapshot + sampler).
  awrrpt  begin <id> end <id>
                            render AWR html = snap<end_id> - snap<begin_id>;
                            written to ~/.vb_tool/awr_reports/awr_{db}_{begin}_{end}.html
  awrdiff begin <a> end <b> begin <c> end <d>
                            render AWR DIFF html (3-col: Period1 | Period2 | Δ);
                            period1 = snap a->b, period2 = snap c->d;
                            both periods must span the same number of snapshot
                            intervals (equal snap_id gap; differing gaps need
                            durations within 10 min) -- Δ columns are raw
                            window deltas;
                            written to awrdiff_{db}_{p1_begin}_{p2_begin}.html
  topsql  begin <id> end <id> [-n N] [-m dbtime|cpu|io|calls|lreads|preads|rows]
                            print the window's Top SQL to the SCREEN (no html);
                            ranking dimension via -m (default dbtime); the pct%
                            and total columns follow it (e.g. -m cpu prints
                            total_cputime); -n top N (default 10)
  event   begin <id> end <id> [-E <event>]
                            print top wait events to the screen (CPU time +
                            events by total wait time, 5 rows, wdr_event style);
                            -E prints only that event (case-insensitive match)
  summary begin <id> end <id>
                            print a one-line workload summary to the screen
                            (dbtime/aas/tps/iops/mbps/... wdr_summary style);
                            iops/mbps/wal need snaps captured by this vb_tool
                            or newer (older snaps show '-')
  tabstat begin <id> end <id> -d <db> -s <schema> -t <table>
                            print one table's window scan/DML deltas plus
                            live/dead tuple counts (wdr_tabstat style); works
                            for tables of ANY database (all-db capture)
  cpu     begin <id> end <id>
                            print the window's PER-MINUTE CPU utilization to
                            the screen (busy/user/nice/system/iowait/irq/
                            softirq/steal/idle + run/block procs -- awrrpt CPU
                            per-minute detail fields; needs 'awr enable')
  io      begin <id> end <id>
                            print the window's PER-MINUTE per-device IO to the
                            screen (r/s w/s rB/s wB/s + separate r/w await ms
                            per minute -- awrrpt 'Disk I/O' per-minute detail
                            fields; idle device-minutes hidden; needs 'awr
                            enable')
  page    begin <id> end <id>
                            print the window's PER-MINUTE paging series to the
                            screen (pgpgin/pgpgout/pswpin/pswpout/pgfault/
                            pgmajfault per sec + MemUsed/MemAvail + zone
                            watermarks -- awrrpt 'Memory / Paging' per-minute
                            detail fields; needs 'awr enable' sampler logs)
  replstat begin <id> end <id>
                            print the window's PER-MINUTE pg_stat_replication
                            samples (standby/addr/state/sync + sent/write/
                            flush/replay LSNs + net/fsync/apply/total byte
                            lags; all-zero-lag healthy minutes hidden -- awrrpt
                            'Replication Stat' fields; needs 'awr enable')
  replslot begin <id> end <id>
                            print the window's PER-MINUTE pg_replication_slots
                            samples (slot/type/plugin/db/active/restart_lsn/
                            xmin/catalog_xmin/dummy_stby/confirmed_flush --
                            awrrpt 'Replication Slots' fields; needs 'awr
                            enable')
  replay  begin <id> end <id>
                            print the window's PER-MINUTE walreceiver samples
                            to the screen (STANDBY side: state/peer + sent/
                            received/flush/replay LSNs + net/fsync/apply/total
                            byte lags + sync%/channel -- awrrpt 'Wal Receiver'
                            fields; every minute shown, no hiding; on the
                            primary there is no walreceiver; needs 'awr
                            enable')
  list    [YYYY-MM-DD]     list stored snapshots (snap_id / ts / host / db),
                            newest first; default latest 30, a date lists
                            that whole day
  show                      awr overview: run status (crontab entries),
                            data dir (absolute path), sampling interval,
                            retention, oldest/newest snapshot, snapshot
                            count; while ENABLED also last-snap age
                            (ok / STALE liveness hint)
  delete  until <time>      delete snapshots (by ts), html reports (by mtime) and
                            old repl_/walrcv_/os_*.log (by whole day) older than
                            <time>; e.g. '2026-08-11' or '2026-08-11 12:00:00'
  config                    show current retention / interval values
  config  retention <days>  set retention in days (default 8; 0 = never purge).
                            Immediately purges already-expired snaps, repl/slot/walrcv/os
                            logs and html reports.
  config  interval <min>    set sampling interval in minutes (default 60,
                            1-60, cron minute-field limit). If periodic capture
                            is enabled the crontab entry is rewritten at once.

Storage (per snapshot; <root> = $VB_TOOL_HOME/awrs/<port>, per instance):
  snapshot:   <root>/snap_<id>/{meta.json, os/<proc files>, db/<views>.csv}
  sequence:   <root>/sequence            (next snap_id to allocate)
  retention:  <root>/retention           (days to keep; default 8, 0 = forever)
  interval:   <root>/interval            (snapshot interval min; default 60)
  html:       ~/.vb_tool/awr_reports/awr_{db}_{begin}_{end}.html  (by compare_render.py)
  repl logs:  <root>/repl_<YYYYMMDD>.log  per-minute pg_stat_replication samples
              (ts,app,addr,state,sync,sent,write,flush,replay LSN; no standby -> ts,null)
  slot logs:  <root>/slot_<YYYYMMDD>.log  per-minute pg_replication_slots samples
              (ts,slot,plugin,type,db,active,xmin,cat_xmin,restart_lsn,dummy,conf_flush;
               no slot -> ts,null)
  os logs:    <root>/os_<YYYYMMDD>.log  per-minute OS counters for awrrpt detail
              (cpu/pg/mem numeric rows + dsk/net raw /proc lines; same cron as
               repl/slot sampling -- 'awr enable' starts all three)
  iostat:     <root>/snap_<id>/db/file_iostat.csv  per-file rows (filenum/
              dbid/spcid + phyrds/phywrts/phyblkrd/phyblkwrt) -- the renderer
              diffs per file so temp/log file churn cannot skew the sums;
              file_redo_iostat.csv = single global row. For the awr summary
              iops/mbps/wal columns (this vb_tool version+)

Env: VB_TOOL_HOME  base dir (default ~/.vb_tool); snaps under $VB_TOOL_HOME/awrs/<port>/snap_<id>/
Port:   -P <port> anywhere on the command line selects the instance (default: current $PGPORT)
Multi-instance: storage, config and crontab entries are all PER PORT -- each
        instance gets its own snap_id sequence / retention / interval / repl
        logs and its own crontab pair (port pinned via PGPORT= in the entry),
        so several instances can be enabled side by side; enable/disable/show/
        list/config always operate on the current port only.

Requirements: dbe_perf + gs_instance_time (same as `workload`). Not on PG-only
kernels lacking dbe_perf (e.g. E100/v0).
EOF
}

# _awr_root  -- per-PORT storage root: <VB_TOOL_HOME>/awrs/<port>/. Every awr
# subcommand (create/list/show/reports/purge/config) operates on the instance
# the CURRENT port points at (from $PGPORT, or -P which exports it), so several
# instances can run awr side by side without sharing snap_ids, config or logs.
# Migrates the pre-multi-instance flat layout once, under a lock.
_awr_root() {
    local base="${VB_TOOL_HOME:-$HOME/.vb_tool}/awrs"
    local port="${PGPORT:-5432}"
    local root="$base/$port"
    if [ -d "$base" ] && [ ! -d "$root" ] && ls "$base"/snap_* >/dev/null 2>&1; then
        (
            flock -n 9 || exit 0
            [ ! -d "$root" ] && ls "$base"/snap_* >/dev/null 2>&1 || exit 0
            mkdir -p "$root"
            mv "$base"/snap_* "$base"/sequence "$base"/retention "$base"/interval \
               "$base"/repl_*.log "$base"/slot_*.log "$base"/os_*.log "$base"/os_*.log.gz "$root"/ 2>/dev/null
            echo "awr: migrated existing snapshots/config into per-port layout $root" >&2
        ) 9>"$base/.migrate.lock"
    fi
    echo "$root"
}

# _awr_next_id  -- atomically allocate and return the next snap_id.
# Maintains <root>/sequence (= next id). Concurrent-safe via flock (util-linux).
_awr_next_id() {
    local root; root=$(_awr_root)
    mkdir -p "$root" 2>/dev/null || { echo "Error: cannot create $root" >&2; return 1; }
    local seq="$root/sequence"
    local cur
    cur=$( (
        # NB: the 9> redirect must wrap the subshell -- a redirect on the
        # assignment itself never reaches inside $( ) (bash expands first)
        flock 9
        v=$(cat "$seq" 2>/dev/null)
        case "$v" in ''|*[!0-9]*) v=1;; esac
        echo $((v + 1)) > "$seq"
        echo "$v"
    ) 9>"$seq.lock" )
    [ -z "$cur" ] && { echo "Error: snap_id allocation failed" >&2; return 1; }
    echo "$cur"
}

# _awr_collect <target_dir>  -- single-point snapshot into target/{os,db}.
# (Renamed from _awr_collect_window <target> <phase>; phase dropped: files live
#  directly under os/ and db/, no begin/end subdir.)
_awr_collect() {
    local target="$1"
    local osd="$target/os" dbd="$target/db"
    mkdir -p "$osd" "$dbd" || { echo "  [ERROR] cannot mkdir $osd / $dbd" >&2; return 1; }
    # ---- OS (/proc) ----
    local f
    for f in diskstats stat interrupts softirqs meminfo cpuinfo vmstat loadavg; do
        if [ -r "/proc/$f" ]; then cp "/proc/$f" "$osd/$f" 2>/dev/null
        else echo "  [WARN] /proc/$f not readable" >&2; fi
    done
    if [ -r /proc/net/dev ]; then cp /proc/net/dev "$osd/net_dev" 2>/dev/null
    else echo "  [WARN] /proc/net/dev not readable" >&2; fi
    if [ -r /proc/net/snmp ]; then cp /proc/net/snmp "$osd/net_snmp" 2>/dev/null; fi
    if [ -r /proc/net/netstat ]; then cp /proc/net/netstat "$osd/net_netstat" 2>/dev/null; fi
    if [ -r /proc/net/softnet_stat ]; then cp /proc/net/softnet_stat "$osd/softnet_stat" 2>/dev/null; fi
    # net_rtt: raw `ss -tin state established` (END-snap instantaneous per-conn
    # tcp_info: rtt/cwnd/retrans/send-q; loopback included here, the renderer
    # filters). Capped at 512 KB so a many-thousand-conn instance cannot bloat
    # every snap; the possibly-cut tail row dies in the parser. No ss / no conns
    # -> no file -> the renderer hides the RTT sections (old snaps unaffected).
    sscmd=$(command -v ss 2>/dev/null || echo /usr/sbin/ss)
    if [ -x "$sscmd" ]; then
        "$sscmd" -tin state established 2>/dev/null | head -c 524288 > "$osd/net_rtt"
        [ -s "$osd/net_rtt" ] || rm -f "$osd/net_rtt"
    fi
    # ---- NUMA topology + numastat (per-node cumulative counters; renderer computes end-begin) ----
    # File format (one stanza per node, blank-line separated):
    #   node <id>
    #   cpulist <0-15>
    #   MemTotal:       <kB> / MemFree:        <kB>   (from node meminfo, node prefix stripped)
    #   distance <row>
    #   stat <name> <value>   (numa_hit numa_miss numa_foreign interleave_hit local_node other_node)
    {
        _nd=/sys/devices/system/node
        if [ -d "$_nd" ]; then
            for _n in $(ls "$_nd" 2>/dev/null | grep '^node[0-9]*$' | sort -V); do
                echo "node ${_n#node}"
                [ -r "$_nd/$_n/cpulist" ] && echo "cpulist $(cat "$_nd/$_n/cpulist")"
                [ -r "$_nd/$_n/meminfo" ] && grep -E 'MemTotal|MemFree' "$_nd/$_n/meminfo" | sed 's/^Node [0-9]* //'
                [ -r "$_nd/$_n/distance" ] && echo "distance $(cat "$_nd/$_n/distance")"
                [ -r "$_nd/$_n/numastat" ] && sed 's/^/stat /' "$_nd/$_n/numastat"
                echo ""
            done
        fi
    } > "$osd/numa" 2>/dev/null
    [ -s "$osd/numa" ] || echo "  [WARN] NUMA info unavailable (no /sys/devices/system/node or empty)" >&2
    # ---- block-device / NIC / DMI identity (END-snap state; renderer joins by name) ----
    # blockdev_meta: run_lsds --raw TSV (name|size|type|sched|rot|qdepth|nr_rq|wcache|model|vendor)
    run_lsds --raw > "$osd/blockdev_meta" 2>/dev/null || rm -f "$osd/blockdev_meta"
    # netdev_meta: iface|speed|duplex|nrxq|ntxq|rx_max|rx_cur|tx_max|tx_cur  ('-' = unavailable)
    {
        for _if in $(ls /sys/class/net 2>/dev/null | grep -vE '^(lo|vir)'); do
            _p="/sys/class/net/$_if"
            [ -d "$_p" ] || continue
            _sp=$(cat "$_p/speed"  2>/dev/null) || _sp=-
            _dp=$(cat "$_p/duplex" 2>/dev/null) || _dp=-
            _nrx=$(ls -d "$_p/queues/rx-"* 2>/dev/null | wc -l)
            _ntx=$(ls -d "$_p/queues/tx-"* 2>/dev/null | wc -l)
            _rmax=-; _rcur=-; _tmax=-; _tcur=-
            if command -v ethtool >/dev/null 2>&1; then
                _ring=$(ethtool -g "$_if" 2>/dev/null | awk '
                    /Pre-set maximums:/         {sec="max"; next}
                    /Current hardware settings:/{sec="cur"; next}
                    sec=="max" && /^RX:/ {rmax=$2}
                    sec=="max" && /^TX:/ {tmax=$2}
                    sec=="cur" && /^RX:/ {rcur=$2}
                    sec=="cur" && /^TX:/ {tcur=$2}
                    END { printf "%s|%s|%s|%s",
                          (rmax==""?"-":rmax), (rcur==""?"-":rcur),
                          (tmax==""?"-":tmax), (tcur==""?"-":tcur) }')
                IFS='|' read -r _rmax _rcur _tmax _tcur <<< "$_ring"
            fi
            echo "$_if|$_sp|$_dp|$_nrx|$_ntx|$_rmax|$_rcur|$_tmax|$_tcur"
        done
    } > "$osd/netdev_meta" 2>/dev/null
    # dmi: arch/vendor/product lines (world-readable; absent on some ARM/containers -> empty file)
    {
        _a=$(lscpu 2>/dev/null | awk -F: '$1=="Architecture"{gsub(/^[ \t]+/,"",$2); print $2; exit}')
        [ -n "$_a" ] && echo "arch $_a" || { command -v uname >/dev/null 2>&1 && echo "arch $(uname -m)"; }
        [ -r /sys/class/dmi/id/sys_vendor ]   && echo "vendor $(cat /sys/class/dmi/id/sys_vendor)"
        [ -r /sys/class/dmi/id/product_name ] && echo "product $(cat /sys/class/dmi/id/product_name)"
    } > "$osd/dmi" 2>/dev/null
    # ---- DB reachability probe + bounded timeouts ----
    # One cheap probe before ~30 psql invocations below (heredoc + per-db object
    # loops + meta queries): if the DB is unreachable, fail fast ONCE instead of
    # hanging through every invocation (kernel SYN retries ~127s each when the
    # network blackholes). Timeouts are passed as PER-COMMAND env prefixes
    # (session-level, only that psql process sees them) -- never exported into
    # the script's global environment.
    local _ct=15 _st="-c statement_timeout=60000"
    if ! PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAc "select 1" >/dev/null 2>&1; then
        echo "  [ERROR] cannot reach the database (connect probe failed, skipped DB collection)" >&2
        return 1
    fi
    # ---- db role: primary vs physical standby, detected ONCE here (before any
    # sampler) and threaded through. On a standby the ASH flush must read
    # local_active_session ONLY: gs_asp is a normal heap table whose inserts
    # WAL-replicate from the primary, so on a standby it holds the PRIMARY's
    # session history. And the replication-side single-point sample switches
    # to the walreceiver function. meta.json reuses the same value.
    local m_role is_standby=0
    m_role=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAq -c "select case when pg_is_in_recovery() then 'physical standby' else 'primary' end;" 2>/dev/null | head -1 | tr -d '"\r\n')
    [ "$m_role" = "physical standby" ] && is_standby=1
    # ---- ASH flush window: [previous snap ts, now]. Output replicates the
    # `vb_tool asp` command (per-second counts rolled to 5-minute buckets,
    # max/avg columns; top-5 SQL per bucket; both sources gs_asp AND
    # get_local_active_session() tagged g/l -- the live stream hands off (the
    # dbe_perf.local_active_session VIEW is deliberately NOT used anywhere:
    # its WITH RECURSIVE final_block_sessionid walks every row even when
    # nobody is blocked -- linear-cost recursion per snap (user 2026-09-08);
    # the waitchain queries grow their own chain from blocked rows ONLY)
    # between them, observed on 204; the renderer's per-bucket source pick
    # dedupes the seam, same as asp). Flushing at every create keeps each
    # snap self-contained and bounds query cost to one interval. Neither
    # table available (PG / enable_asp off) -> \copy errors swallowed ->
    # no ash_*.csv -> renderer still shows the section with a no-data note.
    local ash_b ash_e _ash_prev="" _id _best=-1 _d
    ash_e=$(date '+%F %T')
    for _d in "${target%/*}"/snap_*; do
        [ -f "$_d/meta.json" ] || continue
        [ "$_d" = "$target" ] && continue
        _id=${_d##*snap_}
        case "$_id" in ''|*[!0-9]*) continue;; esac
        if [ "$_id" -gt "$_best" ]; then
            _best=$_id
            _ash_prev=$(sed -n 's/.*"ts" *: *"\([^"]*\)".*/\1/p' "$_d/meta.json" 2>/dev/null | head -1)
        fi
    done
    if [ -n "$_ash_prev" ]; then ash_b="$_ash_prev"; else ash_b=$(date -d '-60 minutes' '+%F %T'); fi
    # local_active_session schema version (same probe the asp command uses):
    # 3 = cur_event+state (204), 2 = cur_event only, 4 = event, 0 = missing.
    # Drives the waitchain query's condition substitution below.
    local ash_las_flag ash_c1 ash_c6 ash_c7 ash_c8 ash_c9
    ash_las_flag=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -qAtXc "select is_event + is_curevent + is_state as las_flag from (select coalesce(sum(case when attname='event' then 4 else 0 end),0) is_event, coalesce(sum(case when attname='cur_event' then 2 else 0 end),0) is_curevent, coalesce(sum(case when attname='state' then 1 else 0 end),0) is_state from pg_attribute a, pg_class b, pg_namespace c where a.attrelid=b.oid and b.relnamespace=c.oid and b.relname='local_active_session' and c.nspname='dbe_perf')" 2>/dev/null)
    case "$ash_las_flag" in
        3) ash_c1="state='active'"; ash_c6="a.state='active'"; ash_c7="las.state='active'"
           ash_c8="a.xact_start_time::timestamp(0)"; ash_c9="las.xact_start_time::timestamp(0)";;
        *) ash_c1="1=1"; ash_c6="1=1"; ash_c7="1=1"; ash_c8="' '"; ash_c9="' '";;
    esac
    # ---- DB: \copy views to CSV with header (column order stable per view) ----
    # unquoted heredoc so $dbd expands; no other $ in the SQL. psql continues
    # past a missing view (no ON_ERROR_STOP) -> we warn about empty CSVs below.
    PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres 2>&1 <<PSQL | grep -v '^$' >&2 || true
-- statement: FULL numeric detail, query column dropped -- text lives in the
-- shared per-root sql_text.csv (filled by the merge step below, driven by the
-- keys in this file -- ALL texts, no top-N filter). 95% of the old file was
-- text; numbers-only keeps every row so sum-of-delta stays the exact pct base
-- (2026-09-09-awr-statement-slim-design.md).
\copy (SELECT user_name, unique_sql_id, n_calls, n_blocks_fetched, n_blocks_hit, n_soft_parse, n_hard_parse, db_time, cpu_time, execution_time, plan_time, data_io_time, n_returned_rows FROM dbe_perf.statement) TO '$dbd/statement.csv' WITH CSV HEADER
\copy (SELECT * FROM dbe_perf.wait_events)              TO '$dbd/wait_events.csv'   WITH CSV HEADER
\copy (SELECT * FROM gs_instance_time)                  TO '$dbd/instance_time.csv' WITH CSV HEADER
\copy (SELECT * FROM pg_stat_database)                  TO '$dbd/database.csv'      WITH CSV HEADER
\copy (SELECT * FROM dbe_perf.global_pagewriter_status) TO '$dbd/pagewriter.csv'    WITH CSV HEADER
\copy (SELECT memorytype, sum(memorymbytes) AS mb FROM dbe_perf.memory_node_detail WHERE memorymbytes>0 GROUP BY memorytype) TO '$dbd/memory_node_detail.csv' WITH CSV HEADER
\copy (SELECT contextname, count(*) AS cnt, sum(totalsize) AS total FROM gs_shared_memory_detail GROUP BY contextname) TO '$dbd/shared_memory.csv' WITH CSV HEADER
\copy (SELECT contextname, count(*) AS cnt, sum(totalsize) AS total FROM gs_session_memory_detail GROUP BY contextname) TO '$dbd/session_memory.csv' WITH CSV HEADER
\copy (SELECT sessid, sum(totalsize) AS total FROM gs_session_memory_detail GROUP BY sessid) TO '$dbd/session_by_sess.csv' WITH CSV HEADER
\copy (SELECT name,setting,unit,context,short_desc FROM pg_settings ORDER BY name) TO '$dbd/pg_settings.csv' WITH CSV HEADER
\copy (SELECT application_name, client_addr, state, sync_state, sender_sent_location, receiver_write_location, receiver_flush_location, receiver_replay_location FROM pg_stat_replication ORDER BY application_name) TO '$dbd/replication.csv' WITH CSV HEADER
\copy (SELECT slot_name, plugin, slot_type, database, active, xmin, catalog_xmin, restart_lsn, dummy_standby, confirmed_flush FROM pg_replication_slots ORDER BY slot_name) TO '$dbd/replication_slots.csv' WITH CSV HEADER
\copy (SELECT filenum, dbid, spcid, phyrds, phywrts, phyblkrd, phyblkwrt FROM dbe_perf.file_iostat) TO '$dbd/file_iostat.csv' WITH CSV HEADER
\copy (SELECT sum(phywrts) phywrts, sum(phyblkwrt) phyblkwrt FROM dbe_perf.file_redo_iostat) TO '$dbd/file_redo_iostat.csv' WITH CSV HEADER
PSQL
    # ---- ASH flush sources. primary: gs_asp('g') + local_active_session('l')
    # dual source (the live stream hands off between them, observed on 204).
    # standby: las ONLY -- gs_asp rows on a standby are the primary's history
    # (physically replicated), including them would put the primary's workload
    # into the standby's report.
    if [ "$is_standby" = "1" ]; then
        PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres 2>&1 <<PSQL3 | grep -v '^$' >&2 || true
