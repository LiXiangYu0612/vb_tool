        row = '<tr><td>%s</td>' % esc(name)
        if _dmeta:
            row += ''.join('<td class="n">%s</td>' % esc(c) for c in disk_meta_cells(name, _dmeta))
        row += ('<td class="n">%.1f</td><td class="n">%.1f</td><td class="n">%.1f</td><td class="n">%.1f</td>'
                '<td class="n">%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>' % (
                    a.get("read_iops", 0), b.get("read_iops", 0),
                    a.get("write_iops", 0), b.get("write_iops", 0),
                    fmt_bytes(a.get("read_bytes", 0) / ddur1), fmt_bytes(b.get("read_bytes", 0) / ddur2),
                    fmt_bytes(a.get("write_bytes", 0) / ddur1), fmt_bytes(b.get("write_bytes", 0) / ddur2)))
        if _dsup:
            row += ('<td class="n">%.1f</td><td class="n">%.1f</td><td class="n">%.1f</td><td class="n">%.1f</td>'
                    % (a.get("discard_iops") or 0.0, b.get("discard_iops") or 0.0,
                       a.get("flush_iops") or 0.0, b.get("flush_iops") or 0.0))
        row += '</tr>'
        parts.append(row)
    parts.append('</table>')
    sub("Network per interface")
    _i1 = {it["name"]: it for it in osd1.get("ifaces", [])}
    _i2 = {it["name"]: it for it in osd2.get("ifaces", [])}
    _nmeta = osd2.get("net_meta") or osd1.get("net_meta") or {}
    _nh = '<th>Interface</th><th class="n">P1 RX B</th><th class="n">P2 RX B</th><th class="n">P1 TX B</th><th class="n">P2 TX B</th><th class="n">P1 errs</th><th class="n">P2 errs</th>'
    if _nmeta:
        _nh += '<th class="n">Speed</th><th class="n">Duplex</th><th class="n">Queues</th><th class="n">RX ring</th><th class="n">TX ring</th>'
    _nh += '</tr>'
    parts.append('<table class="t"><tr>' + _nh)
    _inames = sorted(set(_i1) | set(_i2))
    if not _inames:
        parts.append('<tr><td colspan="%d" class="note">no network interfaces</td></tr>' % (7 + (5 if _nmeta else 0)))
    du1 = osd1.get("dur", 1.0) or 1.0; du2 = osd2.get("dur", 1.0) or 1.0
    for name in _inames:
        a = _i1.get(name, {}); b = _i2.get(name, {})
        row = '<tr><td>%s</td><td class="n">%.0f</td><td class="n">%.0f</td><td class="n">%.0f</td><td class="n">%.0f</td><td class="n">%.0f</td><td class="n">%.0f</td>' % (
                         esc(name), a.get("rx_bytes", 0) / du1, b.get("rx_bytes", 0) / du2,
                         a.get("tx_bytes", 0) / du1, b.get("tx_bytes", 0) / du2,
                         a.get("rx_errs", 0) + a.get("tx_errs", 0), b.get("rx_errs", 0) + b.get("tx_errs", 0))
        if _nmeta:
            row += ''.join('<td class="n">%s</td>' % esc(c) for c in net_meta_cells(name, _nmeta))
        row += '</tr>'
        parts.append(row)
    parts.append('</table>')

    _s1, _s2 = osd1.get("softnet"), osd2.get("softnet")
    if _s1 is not None or _s2 is not None:
        sub("Softnet")
        parts.append('<table class="t"><tr><th>Metric</th><th class="n">P1</th>'
                     '<th class="n">P2</th><th class="n">&Delta;</th></tr>')
        for _lbl, _key, _b, _r in (("packets processed", "packets", None, None),
                                   ("dropped", "dropped", 0, 100),
                                   ("time_squeeze", "squeezed", 0, 1000)):
            _v1 = (_s1 or {}).get(_key, 0) / (du1 or 1.0)
            _v2 = (_s2 or {}).get(_key, 0) / (du2 or 1.0)
            parts.append('<tr><td>%s</td><td class="n%s">%s</td><td class="n%s">%s</td>'
                         '<td class="n">%s</td></tr>'
                         % (esc(_lbl),
                            thr_cell_cls(_v1, _b, _r) if _b is not None else "", fmt_num(_v1),
                            thr_cell_cls(_v2, _b, _r) if _b is not None else "", fmt_num(_v2),
                            fmt_num(_v2 - _v1)))
        parts.append('</table>')

    if osd1.get("netstat_ok") or osd2.get("netstat_ok"):
        sub("Network Protocol Errors")
        parts.append('<table class="t"><tr><th>Protocol</th><th>Counter</th>'
                     '<th class="n">P1 &Delta;</th><th class="n">P2 &Delta;</th><th class="n">&Delta;</th></tr>')
        # Core rows in fixed order
        dur1 = osd1.get("dur", 1.0) or 1.0
        dur2 = osd2.get("dur", 1.0) or 1.0
        for proto, name, label, d1, d2, d_diff in netstat_core_rows_awrdiff(win1["os"], dur1, win2["os"], dur2):
            _m = " class=\"n muted\"" if (not d1 and not d2) else " class=\"n\""
            parts.append('<tr><td>%s</td><td>%s</td><td%s>%s</td><td%s>%s</td><td%s>%s</td></tr>'
                         % (esc(proto), esc(label),
                            _m, ("%.0f" % d1) if d1 is not None else "-",
                            _m, ("%.0f" % d2) if d2 is not None else "-",
                            _m, ("%.0f" % d_diff) if d_diff is not None else "-"))
        # Tail rows (union of non-core counters with nonzero in either period)
        tail1 = netstat_err_deltas(
            [("snmp", win1["os"].get(("begin", "net_snmp"), "")),
             ("netstat", win1["os"].get(("begin", "net_netstat"), ""))],
            [("snmp", win1["os"].get(("end", "net_snmp"), "")),
             ("netstat", win1["os"].get(("end", "net_netstat"), ""))], osd1.get("dur", 1.0) or 1.0)
        tail2 = netstat_err_deltas(
            [("snmp", win2["os"].get(("begin", "net_snmp"), "")),
             ("netstat", win2["os"].get(("begin", "net_netstat"), ""))],
            [("snmp", win2["os"].get(("end", "net_snmp"), "")),
             ("netstat", win2["os"].get(("end", "net_netstat"), ""))], osd2.get("dur", 1.0) or 1.0)
        if tail1 or tail2:
            _e1 = {(r["proto"], r["name"]): r for r in tail1}
            _e2 = {(r["proto"], r["name"]): r for r in tail2}
            _keys = sorted(set(_e1) | set(_e2),
                           key=lambda k: -max(abs(_e1.get(k, {}).get("delta", 0)),
                                              abs(_e2.get(k, {}).get("delta", 0))))[:20]
            for k in _keys:
                d1 = _e1.get(k, {}).get("delta"); d2 = _e2.get(k, {}).get("delta")
                _m = " class=\"n muted\"" if (not d1 and not d2) else " class=\"n\""
                parts.append('<tr><td>%s</td><td>%s</td><td%s>%s</td><td%s>%s</td><td%s>%s</td></tr>'
                             % (esc(k[0]), esc(k[1]),
                                _m, ("%.0f" % d1) if d1 is not None else "-",
                                _m, ("%.0f" % d2) if d2 is not None else "-",
                                _m, ("%.0f" % (d2 - d1)) if (d1 is not None and d2 is not None) else "-"))
        parts.append('</table>')

    # ================= Time Model System Stats =================
    sec("Time Model System Stats")
    it_keys = sorted(set(IT1) | set(IT2),
                     key=lambda k: max(IT1.get(k, {}).get("value", 0), IT2.get(k, {}).get("value", 0)), reverse=True)
    parts.append('<table class="t"><tr><th>Stat</th><th class="n">P1 (s)</th>'
                 '<th class="n">P2 (s)</th><th class="n">&Delta; (s)</th></tr>')
    if not it_keys:
        parts.append('<tr><td colspan="4" class="note">no data</td></tr>')
    for k in it_keys:
        v1 = IT1.get(k, {}).get("value", 0.0); v2 = IT2.get(k, {}).get("value", 0.0)
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td></tr>' % (esc(k), s_of(v1), s_of(v2), s_of(v2 - v1)))
    parts.append('</table>')

    # ================= Load Profile =================
    def _dbsum(d, col):
        return sum(v.get(col, 0.0) for v in d.values())
    def _lsn(lsn):
        try:
            hi, lo = (lsn or "").split("/")
            return (int(hi, 16) << 32) + int(lo, 16)
        except Exception:
            return 0
    def _pwlsn_delta(win, col):
        _e = sum(_lsn(r.get(col, "")) for r in win["db"].get(("end", "pagewriter"), []))
        _b = sum(_lsn(r.get(col, "")) for r in win["db"].get(("begin", "pagewriter"), []))
        return _e - _b
    sec("Load Profile")
    parts.append('<table class="t"><tr><th>Metric</th><th class="n">P1 total</th>'
                 '<th class="n">P2 total</th><th class="n">&Delta;</th>'
                 '<th class="n">P1 /s</th><th class="n">P2 /s</th></tr>')
    for lbl, col in [("blocks read", "blks_read"), ("blocks hit", "blks_hit"),
                     ("rows returned", "tup_returned"), ("rows fetched", "tup_fetched"),
                     ("rows inserted", "tup_inserted"), ("rows updated", "tup_updated"),
                     ("rows deleted", "tup_deleted"), ("commits", "xact_commit"),
                     ("rollbacks", "xact_rollback"), ("deadlocks", "deadlocks"),
                     ("conflicts", "conflicts"), ("temp bytes", "temp_bytes")]:
        v1 = _dbsum(db1, col); v2 = _dbsum(db2, col)
        fb = fmt_bytes if col == "temp_bytes" else fmt_int
        parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td></tr>' % (
                         esc(lbl), fb(v1), fb(v2), fb(v2 - v1), fmt_num(v1 / dur1), fmt_num(v2 / dur2)))
    # role-aware WAL movement: a standby writes no local WAL (xlog insert lsn
    # sits at a static near-zero there) -- on standby windows use the standby's
    # own walreceiver replay lsn delta; "-" when that window has no
    # walreceiver row on both sides (old snaps / window spans a promote)
    def _walval(win, standby):
        if not standby:
            return _pwlsn_delta(win, "current_xlog_insert_lsn")
        rb = win["db"].get(("begin", "walreceiver"), [])
        re_ = win["db"].get(("end", "walreceiver"), [])
        if not rb or not re_:
            return None
        return (sum(_lsn_to_int(r.get("receiver_replay_location", "")) for r in re_)
                - sum(_lsn_to_int(r.get("receiver_replay_location", "")) for r in rb))
    _sb1 = "standby" in str(m1.get("db_role", "")); _sb2 = "standby" in str(m2.get("db_role", ""))
    _w1 = _walval(win1, _sb1); _w2 = _walval(win2, _sb2)
    _wl = ("WAL replayed (receiver replay lsn)" if _sb1 and _sb2 else
           ("WAL written / WAL replayed (P1 / P2)" if _sb1 or _sb2 else "WAL written"))
    _fmtw = lambda v: "-" if v is None else fmt_bytes(v)
    parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>'
                 '<td class="n">%s</td><td class="n">%s</td></tr>' % (
                     esc(_wl), _fmtw(_w1), _fmtw(_w2),
                     "-" if (_w1 is None or _w2 is None) else fmt_bytes(_w2 - _w1),
                     "-" if _w1 is None else fmt_bytes(_w1 / dur1),
                     "-" if _w2 is None else fmt_bytes(_w2 / dur2)))
    _pf1 = _pwlsn_delta(win1, "ckpt_redo_point"); _pf2 = _pwlsn_delta(win2, "ckpt_redo_point")
    parts.append('<tr><td>pagewriter written</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>'
                 '<td class="n">%s</td><td class="n">%s</td></tr>' % (
                     fmt_bytes(_pf1), fmt_bytes(_pf2), fmt_bytes(_pf2 - _pf1),
                     fmt_bytes(_pf1 / dur1), fmt_bytes(_pf2 / dur2)))
    parts.append('</table>')

    # ================= Cache Hit Ratio =================
    sec("Cache Hit Ratio")
    def _hit(d, dn):
        h = d.get(dn, {}).get("blks_hit", 0); r = d.get(dn, {}).get("blks_read", 0); t = h + r
        return (h / t * 100.0) if t else 0.0
    _dns = sorted((set(db1) | set(db2)) - {"template0", "template1"})
    _cr = [(_dn, _hit(db1, _dn), _hit(db2, _dn)) for _dn in _dns]
    _cr = [r for r in _cr if r[1] or r[2]]
    _cr.sort(key=lambda x: max(x[1], x[2]), reverse=True)
    parts.append('<table class="t"><tr><th>Database</th><th class="n">P1 Hit%</th>'
                 '<th class="n">P2 Hit%</th><th class="n">&Delta;</th></tr>')
    if not _cr:
        parts.append('<tr><td colspan="4" class="note">no data</td></tr>')
    for _dn, r1, r2 in _cr:
        parts.append('<tr><td>%s</td><td class="n">%.2f%%</td><td class="n">%.2f%%</td>'
                     '<td class="n">%+.2f%%</td></tr>' % (esc(_dn), r1, r2, r2 - r1))
    parts.append('</table>')

    # ================= Database Memory =================
    sec("Database Memory")
    sub("Memory GUCs - live")
    _rows = psql_query("SELECT name, decode(unit,'8kB',setting*8||'kB',setting||COALESCE(unit,' ')) AS setting "
                       "FROM pg_settings WHERE name IN ('maintenance_work_mem','work_mem','shared_buffers',"
                       "'max_process_memory','wal_buffers','effective_cache_size','cstore_buffers',"
                       "'segment_buffers','temp_buffers','local_syscache_threshold','max_connections') ORDER BY name")
    if not _rows:
        parts.append('<div class="note">no data</div>')
    else:
        parts.append('<table class="t"><tr><th>Name</th><th>Setting</th></tr>')
        for r in _rows:
            parts.append('<tr><td>%s</td><td>%s</td></tr>' % (esc(r.get("name", "")), esc(r.get("setting", ""))))
        parts.append('</table>')
    def _grp(rows, key, val):
        out = {}
        for r in rows:
            try:
                out[r.get(key, "")] = out.get(r.get(key, ""), 0) + to_num(r.get(val, 0) or 0)
            except Exception:
                pass
        return out
    def be_diff(label, end_r1, end_r2, key_col, val_col, fmt_fn, top=10):
        sub(label)
        d1 = _grp(end_r1, key_col, val_col); d2 = _grp(end_r2, key_col, val_col)
        _keys = sorted(set(d1) | set(d2), key=lambda k: max(d1.get(k, 0), d2.get(k, 0)), reverse=True)[:top]
        parts.append('<table class="t"><tr><th>%s</th><th class="n">P1</th><th class="n">P2</th>'
                     '<th class="n">&Delta;</th></tr>' % esc(key_col))
        if not _keys:
            parts.append('<tr><td colspan="4" class="note">no data</td></tr>')
        for k in _keys:
            v1 = d1.get(k, 0); v2 = d2.get(k, 0)
            parts.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td></tr>' % (esc(k), fmt_fn(v1), fmt_fn(v2), fmt_fn(v2 - v1)))
        parts.append('</table>')
    be_diff("Total Memory by Type (MB)",
            win1["db"].get(("end", "memory_node_detail"), []),
            win2["db"].get(("end", "memory_node_detail"), []),
            "memorytype", "mb", lambda v: fmt_bytes(v * 1024 * 1024), top=20)
    be_diff("Top 10 Shared Memory Context",
            win1["db"].get(("end", "shared_memory"), []),
            win2["db"].get(("end", "shared_memory"), []),
            "contextname", "total", fmt_bytes, top=10)
    be_diff("Top 10 Session Memory Context",
            win1["db"].get(("end", "session_memory"), []),
            win2["db"].get(("end", "session_memory"), []),
            "contextname", "total", fmt_bytes, top=10)

    # ================= Object Statistics =================
    sec("Object Statistics")
    note("Per-object window-delta counters (end-begin) compared P1 vs P2. Top by (P1+P2) of the sort metric.")
    def obj_diff(label, begin_r1, end_r1, begin_r2, end_r2, key_cols, cnt_cols, sort_col, top=30):
        sub(label)
        def _key(r):
            return tuple(r.get(k, "") for k in key_cols)
        def _delta(begin, end):
            b = {}
            for r in begin:
                b[_key(r)] = {c: to_num(r.get(c, 0) or 0) for c in cnt_cols}
            e = {}
            for r in end:
                e[_key(r)] = {c: to_num(r.get(c, 0) or 0) for c in cnt_cols}
            out = {}
            for k in set(b) | set(e):
                out[k] = {c: e.get(k, {}).get(c, 0) - b.get(k, {}).get(c, 0) for c in cnt_cols}
            return out
        d1 = _delta(begin_r1, end_r1); d2 = _delta(begin_r2, end_r2)
        _keys = sorted(set(d1) | set(d2),
                       key=lambda k: d2.get(k, {}).get(sort_col, 0) + d1.get(k, {}).get(sort_col, 0), reverse=True)[:top]
        _hdr = list(key_cols) + [c + " P1" for c in cnt_cols] + [c + " P2" for c in cnt_cols] + [c + " &Delta;" for c in cnt_cols]
        _num = [False] * len(key_cols) + [True] * (3 * len(cnt_cols))
        parts.append('<table class="t"><tr>' + ''.join(
            '<th%s>%s</th>' % (' class="n"' if nu else '', esc(c))
            for c, nu in zip(_hdr, _num)) + '</tr>')
        if not _keys:
            parts.append('<tr><td colspan="%d" class="note">no data</td></tr>' % len(_hdr))
        for k in _keys:
            cells = ''.join('<td>%s</td>' % esc(x) for x in k)
            for c in cnt_cols:
                cells += '<td class="n">%s</td>' % fmt_int(d1.get(k, {}).get(c, 0))
            for c in cnt_cols:
                cells += '<td class="n">%s</td>' % fmt_int(d2.get(k, {}).get(c, 0))
            for c in cnt_cols:
                cells += '<td class="n">%s</td>' % fmt_int(d2.get(k, {}).get(c, 0) - d1.get(k, {}).get(c, 0))
            parts.append('<tr>' + cells + '</tr>')
        parts.append('</table>')
    obj_diff("Top Tables by Activity",
             win1["db"].get(("begin", "object_tables"), []), win1["db"].get(("end", "object_tables"), []),
             win2["db"].get(("begin", "object_tables"), []), win2["db"].get(("end", "object_tables"), []),
             ("dbname", "schema", "object"),
             ("seq_scan", "seq_tup_read", "idx_scan", "idx_tup_fetch", "n_tup_upd", "n_tup_del"), "seq_tup_read")
    obj_diff("Top Indexes by Scans",
             win1["db"].get(("begin", "object_indexes"), []), win1["db"].get(("end", "object_indexes"), []),
             win2["db"].get(("begin", "object_indexes"), []), win2["db"].get(("end", "object_indexes"), []),
             ("dbname", "schema", "object", "index"),
             ("idx_scan", "idx_tup_read", "idx_tup_fetch"), "idx_scan")
    obj_diff("Top Objects by Dead Tuples (window Δ)",
             win1["db"].get(("begin", "object_dead"), []), win1["db"].get(("end", "object_dead"), []),
             win2["db"].get(("begin", "object_dead"), []), win2["db"].get(("end", "object_dead"), []),
             ("dbname", "schema", "object"),
             ("n_dead_tup", "n_live_tup"), "n_dead_tup")

    # ================= Top 10 Wait Events =================
    sec("Top 10 Wait Events by Total Wait Time")
    _we_top = sorted(set(WE1) | set(WE2),
                     key=lambda k: max(WE1.get(k, {}).get("total_wait_time", 0), WE2.get(k, {}).get("total_wait_time", 0)),
                     reverse=True)[:10]
    parts.append('<table class="t"><tr><th>Event</th><th>Class</th>'
                 '<th class="n">P1 Waits</th><th class="n">P2 Waits</th>'
                 '<th class="n">P1 Time (s)</th><th class="n">P2 Time (s)</th><th class="n">&Delta; (s)</th></tr>')
    if not _we_top:
        parts.append('<tr><td colspan="7" class="note">no data</td></tr>')
    for k in _we_top:
        d1 = WE1.get(k, {}); d2 = WE2.get(k, {})
        cls_ = ((d2 or d1).get("__row") or {}).get("type", "")
        t1 = d1.get("total_wait_time", 0.0); t2 = d2.get("total_wait_time", 0.0)
        _badge = " <span class='bad'>[NEW]</span>" if k not in WE1 else (" <span class='note'>[GONE]</span>" if k not in WE2 else "")
        parts.append('<tr><td>%s%s</td><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td><td class="n">%s</td></tr>' % (
                         esc(k), _badge, esc(cls_), fmt_int(d1.get("wait", 0)), fmt_int(d2.get("wait", 0)),
                         s_of(t1), s_of(t2), s_of(t2 - t1)))
    parts.append('</table>')

    # ================= SQL Statistics =================
    sec("SQL Statistics")
    note("Per-SQL Period 1 vs Period 2. %%Diff = (P2-P1)/|P1|. [NEW] = only in P2; [GONE] = only in P1.\n"
         "Top %d by max(P1,P2) of each ordering metric." % top_n)
    shown_sql = {}
    def sql_block_diff(label, order_col, dim_header, dim_fmt):
        sub(label)
        _sum1 = sum(d.get(order_col, 0.0) for d in ST1.values())
        _sum2 = sum(d.get(order_col, 0.0) for d in ST2.values())
        keys = sorted(set(ST1) | set(ST2),
                      key=lambda k: max(ST1.get(k, {}).get(order_col, 0.0), ST2.get(k, {}).get(order_col, 0.0)),
                      reverse=True)[:top_n]
        parts.append('<table class="t"><tr><th>#</th><th>SQL Id</th><th>User</th>'
                     '<th class="n">P1 Exec</th><th class="n">P2 Exec</th>'
                     '<th class="n">P1 %s</th><th class="n">P2 %s</th>'
                     '<th class="n">P1 %%T</th><th class="n">P2 %%T</th>'
                     '<th class="n">%%Diff</th><th>note</th></tr>' % (dim_header, dim_header))
        if not keys:
            parts.append('<tr><td colspan="11" class="note">no data</td></tr>')
        for i, k in enumerate(keys, 1):
            d1 = ST1.get(k); d2 = ST2.get(k)
            row = ((d2 or d1) or {}).get("__row") or {}
            if k not in shown_sql:
                shown_sql[k] = row
            e1 = (d1 or {}).get("n_calls", 0.0); e2 = (d2 or {}).get("n_calls", 0.0)
            v1 = (d1 or {}).get(order_col, 0.0); v2 = (d2 or {}).get(order_col, 0.0)
            badge = ""
            if not d1 and d2:
                badge = "<span class='bad'>[NEW]</span>"
            elif d1 and not d2:
                badge = "<span class='note'>[GONE]</span>"
            _pdiff = "new" if (v1 == 0 and v2 > 0) else ("%+.1f%%" % pctdiff(v1, v2))
            parts.append('<tr><td>%d</td><td><a href="#sql-%s">%s</a></td><td>%s</td>'
                         '<td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%.1f%%</td><td class="n">%.1f%%</td>'
                         '<td class="n">%s</td><td>%s</td></tr>' % (
                             i, esc(k), esc(k), esc(row.get("user_name") or ""),
                             fmt_int(e1), fmt_int(e2), dim_fmt(v1), dim_fmt(v2),
                             pct(v1, _sum1), pct(v2, _sum2), _pdiff, badge))
        parts.append('</table>')
    sql_block_diff("SQL ordered by DB Time", "db_time", "DB Time (s)", s_of)
    sql_block_diff("SQL ordered by CPU Time", "cpu_time", "CPU Time (s)", s_of)
    sql_block_diff("SQL ordered by IO Time", "data_io_time", "IO Time (s)", s_of)
    sql_block_diff("SQL ordered by Logical Reads", "n_blocks_fetched", "logical reads", fmt_int)
    sql_block_diff("SQL ordered by Physical Reads", "physical_reads", "physical reads", fmt_int)
    sql_block_diff("SQL ordered by Executions", "n_calls", "Executions", fmt_int)

    # ================= Wait Events (full) =================
    sec("Wait Events", fold=True)
    _we_all = sorted(set(WE1) | set(WE2),
                     key=lambda k: max(WE1.get(k, {}).get("total_wait_time", 0), WE2.get(k, {}).get("total_wait_time", 0)),
                     reverse=True)
    parts.append('<table class="t"><tr><th>Event</th><th>Class</th>'
                 '<th class="n">P1 Waits</th><th class="n">P2 Waits</th>'
                 '<th class="n">P1 Time (s)</th><th class="n">P2 Time (s)</th><th class="n">&Delta; (s)</th></tr>')
    if not _we_all:
        parts.append('<tr><td colspan="7" class="note">no data</td></tr>')
    for k in _we_all:
        d1 = WE1.get(k, {}); d2 = WE2.get(k, {})
        cls_ = ((d2 or d1).get("__row") or {}).get("type", "")
        t1 = d1.get("total_wait_time", 0.0); t2 = d2.get("total_wait_time", 0.0)
        parts.append('<tr><td>%s</td><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%s</td><td class="n">%s</td></tr>' % (
                         esc(k), esc(cls_), fmt_int(d1.get("wait", 0)), fmt_int(d2.get("wait", 0)),
                         s_of(t1), s_of(t2), s_of(t2 - t1)))
    parts.append('</table>')

    # ================= SQL Text (union of both periods) =================
    sec("SQL Text", fold=True)
    if not shown_sql:
        parts.append('<div class="note">no data</div>')
    else:
        parts.append('<table class="t"><tr><th>SQL Id</th><th>SQL Text</th></tr>')
        for uid in sorted(shown_sql):
            row = shown_sql[uid] or {}
            parts.append('<tr id="sql-%(u)s"><td class="sqlid">%(u)s</td>'
                         '<td><pre class="sqlfull">%(q)s</pre></td></tr>'
                         % {"u": esc(uid), "q": esc(normalize_sql(
                             sql_text_of(win2, row, uid)
                             or sql_text_of(win1, row, uid)
                             or "(text not collected: absent from sql_text store)"))})
        parts.append('</table>')

    # ================= Database Parameters (CHANGED between period1 and period2) =================
    # pg_settings is a STATE snapshot (not a cumulative counter), so each period is
    # represented by its END snap's value. Only params whose decoded setting differs
    # between period1.end and period2.end are shown.
    sec("Database Parameters - changed only", fold=True)
    _pgs1 = win1["db"].get(("end", "pg_settings"), [])
    _pgs2 = win2["db"].get(("end", "pg_settings"), [])
    def _pgmap(rows):
        m = {}
        for r in rows:
            n = r.get("name")
            if n:
                m[n] = r
        return m
    def _decode(setting, unit):
        if unit == "8kB":
            try:
                return "%dkB" % (int(float(setting)) * 8)
            except Exception:
                return "%s kB" % setting
        return "%s%s" % (setting, unit if unit else "")
    parts.append('<table class="t params"><colgroup>'
                 '<col style="width:22%"><col style="width:18%"><col style="width:18%">'
                 '<col style="width:8%"><col style="width:10%"><col style="width:24%">'
                 '</colgroup>'
                 '<tr><th>Name</th><th>Period 1 Setting</th><th>Period 2 Setting</th>'
                 '<th>Unit</th><th>Context</th><th>Description</th></tr>')
    if not _pgs1 or not _pgs2:
        note("pg_settings not captured in one or both periods (snap predates pg_settings "
             "capture); parameter diff unavailable.")
        parts.append('<tr><td colspan="6" class="note">(no parameter diff available)</td></tr>')
    else:
        _m1, _m2 = _pgmap(_pgs1), _pgmap(_pgs2)
        _changed = [n for n in sorted(set(_m1) | set(_m2))
                    if _decode(_m1.get(n, {}).get("setting", ""), _m1.get(n, {}).get("unit", ""))
                       != _decode(_m2.get(n, {}).get("setting", ""), _m2.get(n, {}).get("unit", ""))]
        if not _changed:
            note("No GUC parameter changes between Period 1 (snap end) and Period 2 (snap end).")
            parts.append('<tr><td colspan="6" class="note">No parameter changes between Period 1 and Period 2.</td></tr>')
        else:
            for _n in _changed:
                _r1 = _m1.get(_n, {}); _r2 = _m2.get(_n, {})
                _s1 = _decode(_r1.get("setting", ""), _r1.get("unit", ""))
                _s2 = _decode(_r2.get("setting", ""), _r2.get("unit", ""))
                _u = _r2.get("unit", "") or _r1.get("unit", "")
                _c = _r2.get("context", "") or _r1.get("context", "")
                _d = _r2.get("short_desc", "") or _r1.get("short_desc", "")
                parts.append('<tr><td title="%s">%s</td><td title="%s">%s</td><td title="%s">%s</td>'
                             '<td>%s</td><td>%s</td><td class="wrap">%s</td></tr>'
                             % (esc(_n), esc(_n), esc(_s1), esc(_s1), esc(_s2), esc(_s2),
                                esc(_u), esc(_c), esc(_d)))
            note("%d GUC parameter(s) changed between Period 1 and Period 2." % len(_changed))
    parts.append('</table>')

    _toc_html = '<div class="toc" id="toc"><b>Contents</b><ul>' + "".join(
        '<li><a href="#%s">%s</a></li>' % (_id, esc(t)) for t, _id in _toc) + '</ul></div>'
    parts.insert(_toc_pos, _toc_html)

    _close_foldsec()
    parts.append('<div class="foot">Generated by vb_tool awr awrdiff &middot; diff report &middot; '
                 'each value = period(end-begin); &Delta; = P2-P1; %%Diff = (P2-P1)/|P1|.</div>')
    parts.append('</body></html>')

    htmls = "".join(parts)
    if out_html:
        os.makedirs(os.path.dirname(os.path.abspath(out_html)), exist_ok=True)
        with open(out_html, "w") as f:
            f.write(htmls)
        print("report written: %s" % out_html)
    else:
        sys.stdout.write(htmls)


# =============================================================================
# text (screen) reports -- awr topsql/event/summary/tabstat
# Screen variants of the wdr_* commands, computed from LOCAL awr snapshots
# (begin/end snap pair) instead of in-DB WDR tables. Each text_* returns
# (rc, text); the --text main() branch prints it. No files are written.
# =============================================================================

def _text_banner(title, win, extra=""):
    """Report header: title bar + one window line (db / window / snap ids)."""
    m = win["meta"]
    def _short(ts):
        # '2026-09-07 10:00:03' -> '0907 10:00'
        return ts[5:10].replace("-", "") + " " + ts[11:16] if len(ts) >= 16 else ts
    beg_ts, end_ts = str(m.get("begin_ts", "")), str(m.get("end_ts", ""))
    beg = _short(beg_ts)
    # same date -> end shows time only (design: 'window: 0907 10:00-10:10')
    end = end_ts[11:16] if (len(end_ts) >= 16 and len(beg_ts) >= 16
                            and end_ts[5:10] == beg_ts[5:10]) else _short(end_ts)
    bar = "=" * max(20, len(title) + 2)
    dur = to_num(m.get("duration"))
    line = "  db: %s   window: %s-%s (%ds)   snap %s -> %s" % (
        m.get("db_name", "?"), beg, end, int(dur),
        m.get("snap_id_begin", "?"), m.get("snap_id_end", "?"))
    if extra:
        line += "   " + extra
    return [bar, " " + title, bar, line, ""]

def _text_table(headers, rows, align=None):
    """psql-style aligned table; align = per-column 'l'/'r' (default all 'l')."""
    align = align or "l" * len(headers)
    n = len(headers)
    widths = [len(str(h)) for h in headers]
    for r in rows:
        for i in range(n):
            widths[i] = max(widths[i], len(str(r[i])))
    out = [" | ".join(str(h).ljust(widths[i]) for i, h in enumerate(headers))]
    out.append("-+-".join("-" * w for w in widths))
    for r in rows:
        out.append(" | ".join(
            (str(r[i]).rjust(widths[i]) if align[i] == "r" else str(r[i]).ljust(widths[i]))
            for i in range(n)))
    return "\n".join(out)

# topsql ranking dimensions; values are statement.csv delta column names
# (preads is computed: fetched - hit)
DIM_COLUMNS = {
    "dbtime": "db_time",
    "cpu":    "cpu_time",
    "io":     "data_io_time",
    "calls":  "n_calls",
    "lreads": "n_blocks_fetched",
    "preads": None,
    "rows":   "n_returned_rows",
}

def _dim_value(metric, d):
    """Dimension value of one statement delta row; None = off this board
    (negative delta -- wdr semantics NULLs the row)."""
    if metric == "preads":
        v = to_num(d.get("n_blocks_fetched", 0)) - to_num(d.get("n_blocks_hit", 0))
    else:
        v = to_num(d.get(DIM_COLUMNS[metric], 0))
    return v if v >= 0 else None

def text_topsql(win, metric, top_n):
    """wdr_topsql screen equivalent for one awr window. avg_tt uses db_time
    (same source as the awrrpt Top SQL by DB Time section)."""
    lines = _text_banner("awr topsql summary", win, extra="dim: %s" % metric)
    ST = delta_rows(win, "statement", "unique_sql_id",
                    ["n_calls", "db_time", "cpu_time", "data_io_time",
                     "execution_time", "n_blocks_fetched", "n_blocks_hit",
                     "n_returned_rows"])
    board = []
    for k, d in ST.items():
        if to_num(d.get("n_calls", 0)) <= 0:
            continue
        v = _dim_value(metric, d)
        if v is None:
            continue
        board.append((v, k, d))
    if not board:
        lines.append("(no rows: window has no statement deltas on dimension '%s')" % metric)
        return 0, "\n".join(lines)
    board.sort(key=lambda t: t[0], reverse=True)
    total = sum(t[0] for t in board)
    # the total column FOLLOWS the -m dimension (total_cputime under -m cpu,
    # ...); time dimensions print seconds, count dimensions print integers.
    # avg_dbtime / avg_rows stay dimension-independent.
    dim_total_headers = {"dbtime": "total_dbtime", "cpu": "total_cputime",
                         "io": "total_iotime", "calls": "total_calls",
                         "lreads": "total_lreads", "preads": "total_preads",
                         "rows": "total_rows"}
    headers = ["uname", "sql_id", "calls", dim_total_headers[metric],
               "total_pr", "avg_dbtime", "avg_et", "avg_cpu", "avg_io",
               "avg_cr", "avg_pr", "avg_rows", "pct%"]
    rows = []
    for v, k, d in board[:top_n]:
        row = d.get("__row") or {}
        calls = to_num(d.get("n_calls", 0))
        def per(col):
            x = to_num(d.get(col, 0))
            return "%.1f" % (x / 1000.0 / calls) if (calls > 0 and x >= 0) else "-"
        fetched = to_num(d.get("n_blocks_fetched", 0))
        hit = to_num(d.get("n_blocks_hit", 0))
        pr = fetched - hit
        cr_per = fetched / calls if (calls > 0 and fetched >= 0) else None
        pr_per = pr / calls if (calls > 0 and pr >= 0) else None
        pct = 100.0 * v / total if total > 0 else None
        rows_delta = to_num(d.get("n_returned_rows", 0))
        rows_per = rows_delta / calls if (calls > 0 and rows_delta >= 0) else None
        total_cell = ("%.1f" % (v / 1e6)) if metric in ("dbtime", "cpu", "io") else ("%d" % v)
        rows.append([row.get("user_name", ""), str(k), "%d" % calls,
                     total_cell,                               # total of the -m dimension
                     "%d" % pr if pr >= 0 else "-",
                     per("db_time"), per("execution_time"), per("cpu_time"),
                     per("data_io_time"),
                     "%.1f" % cr_per if cr_per is not None else "-",
                     "%.1f" % pr_per if pr_per is not None else "-",
                     "%.1f" % rows_per if rows_per is not None else "-",
                     "%.1f" % pct if pct is not None else "-"])
    lines.append(_text_table(headers, rows, align="l" + "r" * 12))
    return 0, "\n".join(lines)

def text_event(win, event_filter=None):
    """wdr_event screen equivalent: 'CPU time' pseudo-row + wait events ranked
    by total wait time, top 5 total rows (wdr rn<=5). -E prints only that one
    event (case-insensitive), no CPU row, no top-N cap."""
    lines = _text_banner("awr topevent summary", win,
                         extra=("event: %s" % event_filter) if event_filter else "")
    IT = delta_rows(win, "instance_time", "stat_name", ["value"])
    def inst(name):
        v = to_num(IT.get(name, {}).get("value", 0))
        return v if v >= 0 else None
    db_time, cpu_time = inst("DB_TIME"), inst("CPU_TIME")
    WE = delta_rows(win, "wait_events", "event", ["wait", "total_wait_time"])
    entries = []
    if event_filter is None and cpu_time is not None:
        entries.append(("CPU time", "", cpu_time, None))
    for k, d in WE.items():
        if k in ("none", "wait cmd"):
            continue
        waits = to_num(d.get("wait", 0))
        t = to_num(d.get("total_wait_time", 0))
        if waits < 0 or t < 0:
            continue
        if event_filter is not None and k.lower() != event_filter.lower():
            continue
        if event_filter is None and waits == 0:
            continue                      # wdr: where waits > 0
        entries.append((k, (d.get("__row") or {}).get("type", ""), t, waits))
    if not entries:
        lines.append("(no events with waits>0 in this window)" if event_filter is None
                     else "(event '%s' not seen in this window)" % event_filter)
        return 0, "\n".join(lines)
    entries.sort(key=lambda e: e[2], reverse=True)
    if event_filter is None:
        entries = entries[:5]
    headers = ["db_time_s", "event", "event_type", "wait_time_s", "waits",
               "avg_wait_ms", "db_time_pct"]
    rows = []
    for ev, etype, t, waits in entries:
        avg = t / 1000.0 / waits if (waits is not None and waits > 0) else None
        pct = 100.0 * t / db_time if (db_time and db_time > 0) else None
        rows.append(["%.1f" % (db_time / 1e6) if db_time is not None else "-",
                     ev, etype,
                     "%.1f" % (t / 1e6),
                     "%d" % waits if waits is not None else "-",
                     "%.1f" % avg if avg is not None else "-",
                     ("%.1f%%" % pct) if pct is not None else "-"])
    lines.append(_text_table(headers, rows, align="rllrrrr"))
    return 0, "\n".join(lines)

def text_summary(win):
    """wdr_summary screen equivalent: one row for the whole window."""
    lines = _text_banner("awr workload summary", win)
    el = to_num(win["meta"].get("duration"))
    IT = delta_rows(win, "instance_time", "stat_name", ["value"])
    def inst(name):
        v = to_num(IT.get(name, {}).get("value", 0))
        return v if v >= 0 else None
    db_time, cpu_time, io_time = inst("DB_TIME"), inst("CPU_TIME"), inst("DATA_IO_TIME")
    db = delta_rows(win, "database", "datname", ["xact_commit", "xact_rollback", "blks_read"])
    for _tpl in ("template0", "template1"):
        db.pop(_tpl, None)
    def agg(col):
        vals = [to_num(v.get(col, 0)) for v in db.values()]
        if any(v < 0 for v in vals):
            return None
        return sum(vals)
    commits, rollbacks, cr = agg("xact_commit"), agg("xact_rollback"), agg("blks_read")
    txns = None if (commits is None or rollbacks is None) else commits + rollbacks
    ST = delta_rows(win, "statement", "unique_sql_id",
                    ["n_calls", "n_soft_parse", "n_hard_parse"])
    def sagg(col):
        vals = [to_num(d.get(col, 0)) for d in ST.values()]
        if any(v < 0 for v in vals):
            return None
        return sum(vals)
    calls, soft, hard = sagg("n_calls"), sagg("n_soft_parse"), sagg("n_hard_parse")
    parse = None if (soft is None or hard is None) else soft + hard
    def _io_delta(table, cols):
        b, e = win["db"][("begin", table)], win["db"][("end", table)]
        if not b or not e:
            return [None] * len(cols)
        out = []
        for c in cols:
            bv = sum(to_num(r.get(c, 0)) for r in b)
            ev = sum(to_num(r.get(c, 0)) for r in e)
            out.append(ev - bv if ev - bv >= 0 else None)
        return out
    # file_iostat rows are PER FILE (filenum/dbid/spcid); the membership drifts
    # between snaps (temp/log files come and go), so the delta of the row-SUM
    # goes negative on a healthy window (observed on the test cluster). Diff
    # per file key instead: dropped files excluded, new files fully counted.
    def _io_delta_keyed(table, cols):
        b_rows = win["db"][("begin", table)]
        e_rows = win["db"][("end", table)]
        def _has_keys(rows):
            return any(str(r.get("filenum", "")).strip() for r in rows)
        # missing csv / empty / pre-keyed aggregate rows (older captures) ->
        # no per-file data -> caller shows '-'
        if not b_rows or not e_rows or not _has_keys(b_rows) or not _has_keys(e_rows):
            return [None] * len(cols)
        def _sums(rows):
            out = {}
            for r in rows:
                k = (r.get("filenum", ""), r.get("dbid", ""), r.get("spcid", ""))
                s = out.setdefault(k, [0.0] * len(cols))
                for i, c in enumerate(cols):
                    s[i] += to_num(r.get(c, 0))
            return out
        b = _sums(b_rows)
        e = _sums(e_rows)
        tot = [0.0] * len(cols)
        zero = [0.0] * len(cols)
        for k in set(b) | set(e):
            for i in range(len(cols)):
                d = e.get(k, zero)[i] - b.get(k, zero)[i]
                if d > 0:
                    tot[i] += d
        return tot
    phyrds, phywrts, phyblkrd, phyblkwrt = _io_delta_keyed(
        "file_iostat", ["phyrds", "phywrts", "phyblkrd", "phyblkwrt"])
    # file_redo_iostat is a global aggregate (no per-file key): plain row-sum
    redo_blkwrt = _io_delta("file_redo_iostat", ["phywrts", "phyblkwrt"])[-1]
    def rate(num):
        return None if (num is None or not el or el <= 0) else num / el
    def f1(x):
        return "-" if x is None else "%.1f" % x
    def minutes(us):
        return None if us is None else us / 60.0 / 1e6
    iops = rate(phyrds + phywrts if (phyrds is not None and phywrts is not None) else None)
    mbps = rate((phyblkrd + phyblkwrt) * 8.0 / 1024
                if (phyblkrd is not None and phyblkwrt is not None) else None)
    wal = rate(redo_blkwrt * 8.0 / 1024 if redo_blkwrt is not None else None)
    headers = ["dbtime", "aas", "cputime", "iotime", "tps", "cr/s", "iops",
               "mbps", "wal_mb/s", "call/s", "parse/s", "hard/s"]
    row = [f1(minutes(db_time)),
           f1(rate(db_time / 1e6 if db_time is not None else None)),
           f1(minutes(cpu_time)), f1(minutes(io_time)),
           f1(rate(txns)), f1(rate(cr)), f1(iops), f1(mbps), f1(wal),
           f1(rate(calls)), f1(rate(parse)), f1(rate(hard))]
    lines.append(_text_table(headers, [row], align="r" * 12))
    if iops is None and mbps is None and wal is None:
        lines.append("")
        lines.append("note: iops/mbps/wal_mb/s = '-' -- snaps lack db/file_iostat*.csv "
                     "(captured only by vb_tool versions with the iostat capture)")
    return 0, "\n".join(lines)

def _f1(x):
    return "-" if x is None else "%.1f" % x

def text_cpu(win, repl_dir=None):
    """awrrpt CPU 'Per-minute detail' as a screen table: per-minute CPU
    percent breakdown (busy..idle) + run/block procs from the per-minute os
    sampler logs -- same source and columns as the html report's folded
    detail table. The sampler runs while 'awr enable' is on."""
    lines = _text_banner("awr cpu detail", win)
    m = win["meta"]
    samples = (load_os_samples(repl_dir, m.get("begin_ts", ""), m.get("end_ts", ""))
               if repl_dir else {"files": []})
    if not samples.get("files"):
        lines.append("(no per-minute OS samples in this period -- the sampler runs")
        lines.append(" while 'awr enable' is on; manual snapshots alone carry no series)")
        return 0, "\n".join(lines)
    bts = str(m.get("begin_ts", ""))
    series = [r for r in os_minute_cpu_series(samples) if (not bts or r[0] >= bts)]
    if not series:
        lines.append("(no usable per-minute samples in this period)")
        return 0, "\n".join(lines)
    headers = ["time"] + list(_CPUF) + ["r", "b"]
    rows = [[ts] + ["%.1f" % d[f] for f in _CPUF] + ["%d" % r, "%d" % b]
            for ts, d, r, b in series]
    lines.append(_text_table(headers, rows, align="l" + "r" * (len(headers) - 1)))
    return 0, "\n".join(lines)

def text_io(win, repl_dir=None):
    """awrrpt 'Disk I/O per device' PER-MINUTE detail as a screen table:
    per-minute per-device rates + separate r/w await from the per-minute os
    sampler logs -- same source and columns as the html report's folded
    detail table (idle device-minutes skipped; discard/flush columns appear
    when the kernel counts them)."""
    lines = _text_banner("awr io detail", win)
    m = win["meta"]
    samples = (load_os_samples(repl_dir, m.get("begin_ts", ""), m.get("end_ts", ""))
               if repl_dir else {"files": []})
    if not samples.get("files"):
        lines.append("(no per-minute OS samples in this period -- the sampler runs")
        lines.append(" while 'awr enable' is on; manual snapshots alone carry no series)")
        return 0, "\n".join(lines)
    bts = str(m.get("begin_ts", ""))
    per, dsup = os_minute_disk_series(samples)
    rows = sorted((ts, dev, rt, ra, wa)
                  for dev, lst in per.items() for ts, rt, ra, wa in lst
                  if (not bts or ts >= bts))
    if not rows:
        lines.append("(no active disk device-minutes in this period)")
        return 0, "\n".join(lines)
    headers = ["time", "dev", "r/s", "w/s", "rB/s", "wB/s"]
    align = "ll" + "r" * 4
    if dsup:
        headers += ["dc/s", "flush/s"]
        align += "rr"
    headers += ["r_await (ms)", "w_await (ms)"]
    align += "rr"
    out = []
    for ts, dev, rt, ra, wa in rows:
        row = [ts, dev, "%.1f" % rt["read_iops"], "%.1f" % rt["write_iops"],
               fmt_bytes(rt["read_bytes_s"]), fmt_bytes(rt["write_bytes_s"])]
        if dsup:
            row += [("%.1f" % rt["discard_iops"]) if rt["discard_iops"] is not None else "-",
                    ("%.1f" % rt["flush_iops"]) if rt["flush_iops"] is not None else "-"]
        row += [("%.1f" % ra) if ra is not None else "-",
                ("%.1f" % wa) if wa is not None else "-"]
        out.append(row)
    lines.append(_text_table(headers, out, align=align))
    return 0, "\n".join(lines)

def text_page(win, repl_dir=None):
    """awrrpt 'Memory / Paging' PER-MINUTE detail as a screen table:
    per-minute paging rates + meminfo gauges + summed-zone watermarks from
    the per-minute os sampler logs -- same source and columns as the html
    report's folded 'Per-minute detail' table. The sampler runs while
    'awr enable' is on; manual snapshots alone carry no series."""
    lines = _text_banner("awr page detail", win)
    m = win["meta"]
    samples = (load_os_samples(repl_dir, m.get("begin_ts", ""), m.get("end_ts", ""))
               if repl_dir else {"files": []})
    if not samples.get("files"):
        lines.append("(no per-minute OS samples in this period -- the sampler runs")
        lines.append(" while 'awr enable' is on; manual snapshots alone carry no series)")
        return 0, "\n".join(lines)
    bts = str(m.get("begin_ts", ""))
    series = {ts: d for ts, d in os_minute_pg_series(samples)
              if (not bts or ts >= bts)}
    gauges = {ts: g for ts, g in os_minute_mem_gauges(samples).items()
              if (not bts or ts >= bts)}
    if not series and not gauges:
        lines.append("(no usable per-minute samples in this period)")
        return 0, "\n".join(lines)
    has_wm = any(g[2] is not None for g in gauges.values())
    headers = ["time", "pgpgin/s", "pgpgout/s", "pswpin/s", "pswpout/s",
               "pgfault/s", "pgmajfault/s", "memused_mb", "memavail_mb"]
    if has_wm:
        # text-only: min/low/high merged into one field (awrrpt keeps 3 cols)
        headers += ["wm_free_mb", "wm_min/low/high_mb"]
    rows = []
    for ts in sorted(set(series) | set(gauges)):
        d = series.get(ts)
        g = gauges.get(ts)
        row = [ts] + [fmt_num(d[k]) if d else "-" for k in _PGK]
        row += ["%.0f" % g[0] if g else "-", "%.0f" % g[1] if g else "-"]
        if has_wm:
            row += ["%.0f" % g[2][0] if (g and g[2]) else "-",
                    "/".join("%.0f" % x for x in g[2][1:]) if (g and g[2]) else "-"]
        rows.append(row)
    lines.append(_text_table(headers, rows, align="l" + "r" * (len(headers) - 1)))
    return 0, "\n".join(lines)

def text_replstat(win, repl_dir=None):
    """awrrpt 'Replication Stat' table as a screen report: per-minute
    pg_stat_replication samples with computed byte lags -- same source,
    fields and healthy-minute hiding as the html Replication section
    (zero-lag minutes are hidden with a count; null/error sampler minutes
    render as gap rows)."""
    lines = _text_banner("awr replstat detail", win)
    m = win["meta"]
    repl = load_repl_samples(repl_dir, m.get("begin_ts", ""), m.get("end_ts", ""))
    if not repl["files"]:
        lines.append("(no replication samples in this period -- the sampler runs")
        lines.append(" while 'awr enable' is on)")
        return 0, "\n".join(lines)
    rows = sorted(repl["rows"], key=lambda r: r[0])   # stable: same-minute standbys keep order
    if repl["n_data"] == 0:
        lines.append("(no standby connected at any sample in this period")
        lines.append(" (%d samples: %d null, %d error))"
                     % (len(rows), repl["n_null"], repl["n_error"]))
        return 0, "\n".join(lines)
    headers = ["time", "standby", "addr", "state", "sync", "sent_lsn", "write_lsn",
               "flush_lsn", "replay_lsn", "net_lag", "fsync_lag", "apply_lag", "total_lag"]
    out = []
    zhidden = 0
    for ts, kind, f in rows:
        if kind != "data":
            msg = "(no standby connected)" if kind == "null" else "(sample error)"
            out.append([ts, msg] + [""] * 11)
            continue
        sent, write, flush, replay = f[4], f[5], f[6], f[7]
        L = [_lsn64(x) for x in (sent, write, flush, replay)]
        def _seg(i, j):
            a, b = L[i], L[j]
            return fmt_bytes(a - b) if (a is not None and b is not None and a >= b) else "n/a"
        # healthy minute: sent==write==flush==replay => all four lags 0 => noise row, hidden
        if all(L[i] is not None and L[i] == L[j] for (i, j) in ((0, 1), (1, 2), (2, 3))):
            zhidden += 1
            continue
        out.append([ts, f[0], f[1], f[2], f[3], sent, write, flush, replay,
                    _seg(0, 1), _seg(1, 2), _seg(2, 3), _seg(0, 3)])
    if zhidden == repl["n_data"] and repl["n_null"] == 0 and repl["n_error"] == 0:
        lines.append("(replication healthy the whole window: all %d samples had zero lag" % zhidden)
        lines.append(" (net / fsync / apply / total) -- healthy minutes not shown)")
        return 0, "\n".join(lines)
    lines.append(_text_table(headers, out, align="l" * 9 + "rrrr"))
    if zhidden:
        lines.append("")
        lines.append("  %d minute(s) with all lags 0 hidden -- healthy minutes." % zhidden)
    return 0, "\n".join(lines)

