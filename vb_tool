            if is_max_long or is_qry_long:
                # 超长：复制按钮→下载完整 SQL(gzip 压缩)；生成 Prepared→下载预先生成的完整 prepared 文本(gzip 压缩)
                max_copy_btn = f"<button class='copy-btn' data-sql-b64=\"{max_b64}\" data-filename=\"sql_{unique_id_safe}_max.txt.gz\" onclick=\"downloadEmbeddedText(this)\">📥 下载完整SQL(.gz)</button>"
