    local t0 t1 d0 d1 c0 c1 n0 n1 dt key rrc rd_tmo _wk _ss_t0 _last_work_ms=0
    local ist_w rp_w ist_wmax rp_wmax   # DB 侧两段各自的实测窗口(ms)与过期上限
    local a_user a_nice a_sys a_idle a_iowait a_irq a_softirq a_steal a_fmax a_fmin a_favg
    local a_vbcpu v0 v1 clk
    local t_lis t_est t_sr t_ss t_f1 t_f2 t_tw t_cw t_la t_cl t_oth
    local p_rq p_bq p_proc p_ctxt p_fork p_csw p_dthr p_cur p_raw p0
    # ★lcpu 数, 一次性取 (PROCS 行染红用, 用户令 2026-11-18: "r+b队列>lcpu数"):
    #   与页头 l_ncpu 同源算法但那是页头函数的 local, 这里独立采样一次复用全程。
    local n_lcpu; n_lcpu=$(timeout 3 nproc 2>/dev/null || grep -c ^processor /proc/cpuinfo)
    local g_flt g_mflt g_pi g_po g_si g_so g_af g_if g_aa g_ia g_raw
    local g_fr g_sk g_sd g_st g_cac g_buf g_sc g_mp g_drt
    local g_fltr g_mfltr g_pir g_por g_sir g_sor g_cur g0
    local d_rops d_rmb d_rms d_wops d_wmb d_wms d_util n_rp n_tp n_re n_te n_rd n_td n_rb n_tb
    local mt ma mst msf
    t0=$(date +%s%3N)
    d0=$(_vtop_dsample); c0=$(_vtop_cpustat); n0=$(_vtop_net); p0=$(_vtop_procs); g0=$(_vtop_pgc)
    # ★vbcpu% (user 2026-11-14): instance-tree CPU via /proc counter deltas --
    # needs CLK_TCK once and a first tree sample so frame 1 already shows a value
    clk=$(getconf CLK_TCK 2>/dev/null); case "$clk" in ''|*[!0-9]*) clk=100;; esac
    v0=$(_vtop_vbcpu "$(_vtop_vbcpu_pid)")
    local first=1 sub_first=0 _vtop_notice_on=0
    while :; do
        if [ "$once" = "1" ]; then
            # ★--once 是"一帧快照"不是"主屏节律" (2026-11-17 复核): collect_log 的
            #   vtop 段文档写每帧 ~6s (两次采样), 实际却睡了整个 -i (默认 15s) ——
            #   3 帧 45s+, 且每个速率是 15s 均值而不是文档说的 ~5s 窗。封顶 5s。
            if [ "$interval" -gt 5 ]; then sleep 5; else sleep "$interval"; fi
        elif [ "$first" = "1" ]; then
            sleep 1; first=0          # first frame lands fast on a 1s mini-window
        else
            # ★sub-screen refresh pace (user's call 2026-09-26): 3x the main
            # interval, CAPPED at 15s -- with the default -i 15 the page would
            # otherwise sit still for 45s. Enter refreshes immediately on ANY
            # screen (see the key dispatch); other keys keep their old meaning.
            if [ "$screen" = "main" ]; then
                rd_tmo=$os_tick
            else
                # ★DB sub-screens follow -i (default 5s, user 2026-11-16);
                # replaces the old 3x-interval-capped-15 pacing
                rd_tmo=$dbsub
                # ★OS-side pages: flat 3s, and the 5s first-refresh rule below does
                # NOT apply to them (user's call 2026-09-28). Inert while
                # _vtop_os_screens is empty -- no OS page exists yet.
                case " ${_vtop_os_screens} " in *" ${screen} "*)
                    rd_tmo=$ossub; sub_first=0;;
                esac
                # ★only the DELTA pages keep the quick 5s first refresh (user's call
                # 2026-09-28: 「m的时候 第一次刷新也是15s吧 因为这个不需要增量 而且
                # 会话多查询ctx会比较慢」+「[SESS]也没增量的 也可以弄成15s吧」):
                # every other page is instantaneous readings, where the quick
                # re-sample would only re-run its (possibly expensive) queries and
                # re-stamp the same values. They open at their steady cadence.
                case " ${_vtop_quick_first_screens} " in
                    *" ${screen} "*) : ;;                    # delta page: keep 5s
                    *) sub_first=0 ;;                        # everything else: no
                esac
                # ★first auto-refresh after ENTERING a sub-screen: 5s, not the
                # cadence above (user's call 2026-09-27: "子界面由于有些是算增量值的,
                # 所以子界面的第一次刷新5s吧 第二次开始 再按当前规则") -- pages with
                # window/incremental values get their re-sample quickly; from the
                # second refresh on it is back to 3x/15s above. min(5, cadence):
                # a tiny -i makes the cadence itself faster than 5s and must not
                # be slowed down by this. The flag is set at every sub-screen
                # entry (the command line -- the only entry since 2026-09-28)
                # and consumed HERE -- a manual
                # Enter-refresh inside the window does not consume it: the next
                # auto refresh simply comes 5s after that manual frame.
                [ "$sub_first" = "1" ] && { [ "$rd_tmo" -gt 5 ] && rd_tmo=5; sub_first=0; }
            fi
            # ★墙钟锚定 (2026-11-16, 用户看 CPU 子屏横幅 3s 实际 5s): read 超时是
            #   "静默时长", 不是帧间墙钟 —— 帧本身还有工作量(OS 采样/DB 采集/页内
            #   自带采样窗, cpu 页 mpstat 1 2 就 ≈2s)。下一拍扣除上一帧实测工作量,
            #   "refresh Ns"=帧落地节律; 工作量≥节律时扣到 1s, 墙钟=物理最短。
            _wk=$(( _last_work_ms / 1000 ))
            # ★无条件扣再钳 1 (2026-11-17 复核): 旧门 [ rd_tmo > _wk ] 让工作量≥节律时
            #   减法整个跳过 (iostat 页工作量 ~4s > ossub 3s ⇒ 实际周期 ~7s, 横幅却印
            #   refresh 3s); 扣到负由下一行钳 1, 墙钟 = 物理最短。
            [ "$_wk" -gt 0 ] && rd_tmo=$(( rd_tmo - _wk ))
            [ "$rd_tmo" -lt 1 ] && rd_tmo=1
            IFS= read -r -t "$rd_tmo" -n 1 key
            rrc=$?
            # ---- key dispatch (case-sensitive)
            #   main: q / Ctrl+C quit with no Enter; ESC **and Enter** open the
            #         command line ("Enter:" prompt, one letter per page) -- the
            #         ONLY way into a sub-screen (user's call 2026-09-28: 「不要
            #         双入口 必须弹出enter 之后输入才能进入」; the bare-key
            #         drill-down is gone). Every other bare key is inert (no
            #         refresh, no DB work).
            #   sub : ESC = back to main; q / Ctrl+C = quit; other key (incl.
            #         Enter) = refresh
            case "$key" in
                q) break ;;
                $'\x1b')
                    _vtop_drain_keys                    # eat the escape-sequence tail
                    if [ -n "$_vtop_drain_seq" ]; then
                        # the ESC was an arrow/function key, not an ESC press.
                        # ★方向键 = 主屏 HINT 光标 (用户令 2026-11-17: 上下左右移动光标
                        #   到子屏条目、回车进对应屏, 且不影响父屏刷新): A=up/D=left
                        #   = 前一项, B=down/C=right = 后一项, 15 项环形回绕; 0=未激活,
                        #   首次按 ↓/→ 从 1 号起, 首次按 ↑/← 从 15 号起 (环形语义:
                        #   1 号的前一项就是末项)。其它序列 (PgUp/F1 等) 在主屏仍惰性,
                        #   子屏方向键维持原语义 (=refresh)。
                        if [ "$screen" = "main" ]; then
                            case "${_vtop_drain_fin:-}" in
                                A|D) if [ "${hint_cur:-0}" -le 1 ]; then hint_cur=15; else hint_cur=$((hint_cur-1)); fi ;;
                                B|C) if [ "${hint_cur:-0}" -eq 0 ] || [ "${hint_cur:-0}" -ge 15 ]; then hint_cur=1; else hint_cur=$((hint_cur+1)); fi ;;
                                *) continue ;;
                            esac
                            # ★光标移动只重画 HINT 两行, 不跑整帧 (2026-11-17 复核): 落到
                            #   帧底 = 一次完整采样 (20+ fork) + 可能正好踩中 DB 采集 (12s
                            #   截止) + 重置 t0/d0 基线 (连按方向键把速率窗截成 200ms)。
                            #   光标移动不产生任何新数据, 原地改最后两行足够; 帧数据的
                            #   旧值仍留在屏上, 下一次正常刷新照常整帧覆盖。
                            # ★窄终端不许走两行重画 (2026-11-17 立, 2026-11-18 改[]
                            #   标记后复核): 激活态 HINT 一行 = 111 字符条目 + 每条目
                            #   两侧 2 列 (15×2) + "HINT    " 前缀 8 ⇒ 恒 149 列 (与
                            #   光标位置无关); 终端窄于它时这一行会折成两行, `\033[2A`
                            #   就退到折行中间, 把 HINT 上半截涂掉、旧标记还留在下面。
                            #   宽度不够一律退回整帧 (整帧有 \033[H + \033[J, 折行也
                            #   不残留)。
                            if [ "${vtop_ctl:-0}" = "1" ] && [ -z "$_vtop_notice" ] \
                               && [ "${_vtop_notice_on:-0}" != "1" ] \
                               && [ "${_vtop_w:-0}" -ge 150 ]; then
                                printf '\033[2A'
                                _vtop_keys_hint main | while IFS= read -r _vtop_hl; do
                                    printf '%s\033[K\n' "$_vtop_hl"
                                done
                                printf '\033[J'
                                continue
                            fi
                            # 非 ANSI 终端 (vtop_ctl=0) 或本帧有 notice 要显示: 退回整帧
                        fi
                    elif [ "$screen" != "main" ]; then
                        screen=main
                        # ★光标一并回 HINT (2026-11-17 复核, 2026-11-27 语义改): hint_cur
                        #   若跨子屏存活, 回到主屏后的第一次 Enter 会直接再进该子屏, 而不
                        #   是文档写的命令行 -- 与主屏 ESC 的语义保持一致: ESC 永远回 0=
                        #   框在 HINT 标签 (Enter=命令行), 光标要靠方向键重新走进条目。
                        hint_cur=0
                        # fresh sampling baseline: without this the first main frame
                        # after coming back would average over the whole sub-screen
                        # stay (tps / iops / EVENT would show a bogus value)
                        t0=$(date +%s%3N); d0=$(_vtop_dsample); c0=$(_vtop_cpustat); n0=$(_vtop_net); p0=$(_vtop_procs); g0=$(_vtop_pgc); v0=$(_vtop_vbcpu "$(_vtop_vbcpu_pid)")
                        prev_xc=""; prev_xr=""; prev_br=""; prev_bh=""; prev_tb=""; prev_lsn=""; ist_qps=""; ist_cm=""; ist_roll=""; ist_tps=""; ist_lg=""; ist_ph=""; ist_pw=""; ist_rd=""; ist_tp=""; ist_dl=""
                        prev_ist_ms=0
                        # ★REPL 每帧复位:显示值 + 基线。基线一并清 ⇒ 备库消失/重连后的首帧显示 '-'(不会跨空档算出一个巨大的假增量)
                        r_app=""; r_state=""; r_sync=""; r_sent=""; r_wr=""; r_fl=""; r_rp=""; r_slot=""
                        r_dsent=""; r_dwr=""; r_dfl=""; r_drp=""; r_net=""; r_fs=""; r_ap=""; r_tot=""
                        prev_rsent=""; prev_rwr=""; prev_rfl=""; prev_rrp=""
                        prev_rp_ms=0
                        # (原来的 _vw_prev=()/_vt_prev=() 两行是死代码: 这两个名字在
                        #  全文件再无第二处 —— wait 页早已改用 vbtop_wait.$$.prev 基线文件。
                        #  2026-09-28 审计发现并删除。)
                        first=1
