def parse_softnet(txt):
    """/proc/net/softnet_stat summed over CPUs -> (processed, dropped, time_squeeze).
    Columns are hex without headers; only the first three are portable."""
    t = d = s = 0
    for ln in (txt or "").splitlines():
        f = ln.split()
        if len(f) < 3:
            continue
        try:
            t += int(f[0], 16); d += int(f[1], 16); s += int(f[2], 16)
        except ValueError:
            continue
    return t, d, s

