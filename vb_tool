                # parent; "(other)" rows sort LAST within their sibling group
                # (user 2026-09-20 -- plain lexicographic put "(" before
                # every name); non-path buckets ("reg other") go last overall
                def _fd_path_key(k):
                    return tuple("\x7f" + c if c == "(other)" else c
                                 for c in k.strip("/").split("/"))
                out.sort(key=lambda k: (0, _fd_path_key(k)) if k.startswith("/") else (1, (k,)))
                return out
            def _fd_top(m, fc, subs):
                v = m.get(fc)
                if v is not None:
                    return v
                if fc == "reg":           # old snaps: no collector reg row
                    b = (0, 0)
                    for k in subs:
                        kb, ke = m.get(k, (0, 0))
