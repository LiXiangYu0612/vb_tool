"""
    m1, m2 = win1["meta"], win2["meta"]
    dur1 = to_num(m1.get("duration")) or 1.0
    dur2 = to_num(m2.get("duration")) or 1.0

    IT1 = delta_rows(win1, "instance_time", "stat_name", ["value"])
    IT2 = delta_rows(win2, "instance_time", "stat_name", ["value"])
    dbt1 = IT1.get("DB_TIME", {}).get("value", 0.0)
    dbt2 = IT2.get("DB_TIME", {}).get("value", 0.0)

    _dbcols = ["xact_commit", "xact_rollback", "blks_read", "blks_hit", "deadlocks",
               "tup_returned", "tup_fetched", "tup_inserted", "tup_updated", "tup_deleted",
               "conflicts", "temp_bytes", "temp_files"]
    db1 = delta_rows(win1, "database", "datname", _dbcols)
    db2 = delta_rows(win2, "database", "datname", _dbcols)
    for _tpl in ("template0", "template1"):   # exclude template DBs from all db aggregates
        db1.pop(_tpl, None); db2.pop(_tpl, None)

    _stcols = ["n_calls", "db_time", "cpu_time", "data_io_time", "plan_time", "sort_time",
               "hash_time", "n_blocks_fetched", "n_blocks_hit", "n_returned_rows"]
    ST1 = delta_rows(win1, "statement", "unique_sql_id", _stcols)
    ST2 = delta_rows(win2, "statement", "unique_sql_id", _stcols)
    _stmcols = ["sort_mem_used", "hash_mem_used", "sort_spill_size", "hash_spill_size"]
    STM1 = delta_rows(win1, "statement_mem", "unique_sql_id", _stmcols)
    STM2 = delta_rows(win2, "statement_mem", "unique_sql_id", _stmcols)
    for _st, _stm in ((ST1, STM1), (ST2, STM2)):
        for _k in _st:
            _m = _stm.get(_k, {})
            _st[_k]["work_mem_used"] = _m.get("sort_mem_used", 0.0) + _m.get("hash_mem_used", 0.0)
            _st[_k]["temp_spill_size"] = _m.get("sort_spill_size", 0.0) + _m.get("hash_spill_size", 0.0)
    for _k in ST1:
        ST1[_k]["physical_reads"] = ST1[_k].get("n_blocks_fetched", 0.0) - ST1[_k].get("n_blocks_hit", 0.0)
    for _k in ST2:
        ST2[_k]["physical_reads"] = ST2[_k].get("n_blocks_fetched", 0.0) - ST2[_k].get("n_blocks_hit", 0.0)

    WE1 = delta_rows(win1, "wait_events", "event", ["wait", "total_wait_time"])
    WE2 = delta_rows(win2, "wait_events", "event", ["wait", "total_wait_time"])
    for _idle in ("wait cmd", "none"):   # drop idle/non-wait events (like Oracle idle events)
        WE1.pop(_idle, None); WE2.pop(_idle, None)

    osd1 = os_window_deltas(win1)
    osd2 = os_window_deltas(win2)

    def pct(num, den):
        return (num / den * 100.0) if den > 0 else 0.0
    def s_of(us):
        return "%.2f" % (to_num(us) / 1_000_000.0)
    def ms_of(us):
        return "%.2f" % (to_num(us) / 1000.0)
    def ms_of_g(us):
        # ms with thousands separators -- SQL Statistics time dimensions render
        # window totals in ms now and the totals run into the millions
        return format(to_num(us) / 1000.0, ",.2f")
    def pctdiff(b, c):
        return ((c - b) / abs(b) * 100.0) if b else 0.0

    parts = []
    parts.append("<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'>")
    parts.append("<title>Vastbase Performance AWR Diff Report</title><style>%s</style></head><body>" % CSS_AWR)

    _toc = []
    _used = set()
    def _slug(t):
        s = "".join(c if c.isalnum() else "-" for c in (t or "").lower()).strip("-") or "sec"
        slug = s; i = 2
        while slug in _used:
            slug = "%s-%d" % (s, i); i += 1
        _used.add(slug); return slug
    _foldsec_open = False
    def _close_foldsec():
        nonlocal _foldsec_open
        if _foldsec_open:
            parts.append('</details>')
            _foldsec_open = False
    def sec(t, fold=False):
        nonlocal _foldsec_open
        _close_foldsec()
        _id = _slug(t); _toc.append([t, _id, []])   # [title, anchor, [(sub title, anchor), ...]]
        if fold:
            parts.append('<details class="secfold" id="%s"><summary>%s <a class="totop" href="#toc">↑ Top</a></summary>'
                         % (_id, esc(t)))
            _foldsec_open = True
        else:
            parts.append('<div class="sec" id="%s"><h2>%s <a class="totop" href="#toc">↑ Top</a></h2></div>' % (_id, esc(t)))
    def sub(t):
        # sub-topics get their own anchor + a hierarchical TOC entry under the
        # last sec (subs only follow a plain, non-folded sec in both renderers,
        # so the anchor jump always lands on visible content)
        _id = _slug(t)
        if _toc:
            _toc[-1][2].append((t, _id))
        parts.append('<div class="sub" id="%s">%s</div>' % (_id, esc(t)))
    def note(t):
        for _l in t.split("\n"):
            parts.append('<div class="note">%s</div>' % esc(_l))

    # ================= Report Summary =================
    _compat_raw = psql_show("sql_compatibility")
    _compat = {"A": "A (Oracle)", "B": "B (MySQL)", "C": "C (MySQL)",
               "PG": "PG (PostgreSQL)"}.get(_compat_raw, _compat_raw) or "?"
    parts.append(
        '<div class="rhead"><div class="title">Vastbase Performance AWR Diff Report</div>'
        '<table><tr><th>Instance Name</th><th>Host Name</th><th>OS Version</th><th>DB Role</th><th>DB Compatibility</th></tr>'
        '<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr></table>'
        '<table><tr><th>Release</th><th>vb_tool (snap / report)</th></tr>'
        '<tr><td>%s</td><td>%s / %s</td></tr></table>'
        '<table><tr><th class="nobg"></th><th class="n">Snaps</th><th class="c">Window</th><th class="n">Duration (s)</th></tr>'
        '<tr><td>Period 1:</td><td class="n">%s &rarr; %s</td><td class="c">%s &rarr; %s</td><td class="n">%s</td></tr>'
