# ================== vtop: oratop-style real-time view ==================
vtop_help() {
    echo "Options for vtop:"
    echo "  Usage: vb_tool vtop [-i <sec>] [-n <topn>] [--once]"
    echo "  Description: real-time monitor -- CPU / memory / PGDATA disk IO"
    echo "               (iops, MB/s, avg latency; read and write split)"
    echo "               + network / dbmem (proc & dynamic, peak) / top-3 memory
               contexts / top-5 mem sessions / block roots / top SQL
               (grouped by sqlid, ranked by real CPU%) / wait distribution"
    echo "    -P <port>: database port (default: current \$PGPORT)"
    echo "    -i <sec>:   refresh interval, 1-60 (default 5)"
    echo "    -n <topn>:  top session rows, 1-50 (default 10)"
    echo "    --once:     print one frame and exit (non-interactive)"
    echo "    keys:       q = quit; any other key = refresh immediately"
    echo ""
}

# _vtop_disk_dev <dir> -> name as it appears in /proc/diskstats (exact
# partition if present, else its parent disk; dm/md/loop kept as-is)
_vtop_disk_dev() {
    local src try i
    src=$(df -P "$1" 2>/dev/null | awk 'NR==2{print $1}')
    [ -z "$src" ] && return 1
    # LVM/multipath: df reports /dev/mapper/vg-lv (or /dev/vg/lv, /dev/disk/by-*),
    # none of which exist as names in /proc/diskstats -- resolve the symlink to
    # its real /dev/dm-N first, otherwise the DSK section can never match.
    if [ -L "$src" ]; then
        src=$(readlink -f "$src" 2>/dev/null || echo "$src")
    fi
    try="${src#/dev/}"
    i=0
    while [ "$i" -lt 4 ]; do
        if awk -v d="$try" '$3==d{f=1} END{exit !f}' /proc/diskstats 2>/dev/null; then
            echo "$try"; return 0
        fi
        case "$try" in
            dm-*|md[0-9]*|loop[0-9]*|sr[0-9]*) return 1;;
            *p[0-9]) try="${try%p*}";;
            *[0-9])  try="${try%[0-9]}";;
            *) return 1;;
        esac
        i=$((i+1))
    done
    return 1
}

# r_ops r_sec r_ms w_ops w_sec w_ms io_ticks
_vtop_diskstats() {
    awk -v d="$1" '$3==d{print $4, $6, $7, $8, $10, $11, $13; exit}' /proc/diskstats 2>/dev/null
}

# parent disk for sysfs queue attributes (vda1 -> vda, nvme0n1p2 -> nvme0n1)
_vtop_parent_dev() {
    case "$1" in
        dm-*|md[0-9]*|loop[0-9]*) echo "$1"; return;;
        *p[0-9]) echo "${1%p*}"; return;;
        *[0-9])  local p="${1%[0-9]}"; [ -n "$p" ] && echo "$p" || echo "$1"; return;;
        *) echo "$1"; return;;
    esac
}

# "<parent> <size> <rot> <sched> <qd>" for the device holding PGDATA
_vtop_devinfo() {
    local p sz rot sch qd base
    p=$(_vtop_parent_dev "$1")
    base="/sys/class/block/$p"
    [ -d "$base" ] || { p="$1"; base="/sys/class/block/$p"; }
    sz=$(awk -v s="$(cat "$base/size" 2>/dev/null)" 'BEGIN{if(s>0) printf "%.0fG", s*512/1000000000; else printf "?"}')
    rot=$(cat "$base/queue/rotational" 2>/dev/null); [ -n "$rot" ] || rot="?"
    sch=$(cat "$base/queue/scheduler" 2>/dev/null | sed 's/.*\[//;s/\].*//')
    [ -z "$sch" ] && sch=$(awk '{print $1}' "$base/queue/scheduler" 2>/dev/null)
    [ -n "$sch" ] || sch="?"
    qd=$(cat "$base/queue/nr_requests" 2>/dev/null); [ -n "$qd" ] || qd="?"
    echo "$p $sz $rot $sch $qd"
}

# total user sys idle iowait steal (ticks)
_vtop_cpustat() {
    head -n1 /proc/stat | awk '{print $2+$3+$4+$5+$6+$7+$8+$9, $2, $4, $5, $6, $9}'
}

# rx_bytes tx_bytes (sum of physical-ish interfaces)
_vtop_net() {
    awk 'NR>2 && $1 !~ /^(lo|veth|br-|docker|virbr|tap)[0-9:a-z]*:?$/ {sub(":","",$1); r+=$2; t+=$10} END{print r+0, t+0}' /proc/net/dev
}

# MemTotal MemFree MemAvailable Buffers+Cached+SReclaimable SwapTotal SwapFree (kB)
_vtop_mem() {
    awk '/^(MemTotal|MemFree|MemAvailable|Buffers|Cached|SReclaimable|SwapTotal|SwapFree):/{a[$1]=$2} END{print a["MemTotal:"], a["MemFree:"], a["MemAvailable:"], a["Buffers:"]+a["Cached:"]+a["SReclaimable:"], a["SwapTotal:"], a["SwapFree:"]}' /proc/meminfo
}

_vtop_print_os() { # oratop-style coded-header sections; reads caller-scope vars
    printf 'OS      %5s %5s %5s %5s %6s %6s %6s %6s %6s %11s %8s %8s\n' CPUus CPUsy CPUid CPUwa MEMt MEMu MEMf MEMa MEMbc 'SWAPf/t' NETrx NETtx
    _vtop_rule_cols '        ' 5 5 5 5 6 6 6 6 6 11 8 8
    local os_col=""
    if awk -v u="$a_us" -v sy="$a_sy" -v w="$a_wa" 'BEGIN{exit !(u+sy+w>=80 || w>=20)}'; then os_col=$c_red
    elif awk -v u="$a_us" -v sy="$a_sy" 'BEGIN{exit !(u+sy>=60)}'; then os_col=$c_ylw; fi
    printf '%s' "$os_col"
    printf '        %5.1f %5.1f %5.1f %5.1f %6s %6s %6s %6s %6s %11s %8.1f %8.1f\n' \
        "$a_us" "$a_sy" "$a_id" "$a_wa" \
        "$(_vtop_hum "$mt")" "$(_vtop_hum $((mt - ${ma:-0})))" "$(_vtop_hum "${mf:-0}")" \
        "$(_vtop_hum "$ma")" "$(_vtop_hum "${mbc:-0}")" \
        "$(_vtop_hum "${msf:-0}")/$(_vtop_hum "$mst")" "$n_rx" "$n_tx"
    printf '%s' "$c_off"
    if [ -n "$dev" ]; then
        local dpar dsz drot dsch dqd
        read -r dpar dsz drot dsch dqd <<< "$devinfo"
        printf 'DSK     %s @ %s   [%s %s  rot:%s  sched:%s  qd:%s]\n' "$dev" "$datadir" "$dpar" "$dsz" "$drot" "$dsch" "$dqd"
        printf '        %5s %6s %6s  %5s %6s %6s %5s\n' riops rMB/s ravms wiops wMB/s wavms util
        printf '        ----- ------ ------  ----- ------ ------ -----\n'
        local dsk_col=""
        if awk -v u="$d_util" -v r="$d_rms" -v w="$d_wms" 'BEGIN{exit !(u>=90 || r>20 || w>20)}'; then dsk_col=$c_red
        elif awk -v u="$d_util" 'BEGIN{exit !(u>=70)}'; then dsk_col=$c_ylw; fi
        printf '%s' "$dsk_col"
        printf '        %5s %6.1f %6.1f  %5s %6.1f %6.1f %5.0f\n' \
            "$d_rops" "$d_rmb" "$d_rms" "$d_wops" "$d_wmb" "$d_wms" "$d_util"
        printf '%s' "$c_off"
    else
        printf 'DSK     (cannot map %s to a /proc/diskstats device)\n' "$datadir"
    fi
}

_vtop_fmt_rate() { awk -v v="$1" 'BEGIN{
    if (v<0) v=0
    if (v<1000)         printf "%d", v
    else if (v<1000000) printf "%.1fK", v/1000
    else                printf "%.1fM", v/1000000}'; }
_vtop_fmt_b() { awk -v v="$1" 'BEGIN{
    if (v<0) v=0
    if (v<1024)            printf "%dB", v
    else if (v<1048576)    printf "%.1fKB", v/1024
    else if (v<1073741824) printf "%.1fMB", v/1048576
    else                   printf "%.1fGB", v/1073741824}'; }

_vtop_fmt_us() { # microseconds -> oratop style: u / m(ms) / s / M(min) / h
    awk -v u="$1" 'BEGIN{
        if (u<0) u=0
        if (u<1000)            printf "%dus", u
        else if (u<1000000)    printf "%.0fms", u/1000
        else if (u<60000000)   printf "%.1fs", u/1000000
        else if (u<3600000000) printf "%.1fmin", u/60000000
        else                   printf "%.1fh", u/3600000000}'
}

_vtop_rule_cols() { # $1=indent rest=col widths -> per-column dashed ruler
    local ind="$1"; shift
    local out="" w
    for w in "$@"; do
        out="${out:+$out }$(printf '%*s' "$w" '' | tr ' ' '-')"
    done
    printf '%s%s\n' "$ind" "$out"
}

_vtop_hum() { # kB -> human
    awk -v kb="$1" 'BEGIN{u="KMGTPE"; v=kb+0; i=1; while(v>=1024&&i<6){v/=1024;i++} printf (i==1)?"%d%s":"%.1f%s", v, substr(u,i,1)}'
}

run_vtop() {
    local interval=5 topn=10 once=0
    while [ $# -gt 0 ]; do
        case "$1" in
            -i)       [ $# -lt 2 ] && { echo "Error: -i requires a value (seconds)" >&2; return 2; }
                      interval="$2"; shift 2;;
            -n)       [ $# -lt 2 ] && { echo "Error: -n requires a value (top N)" >&2; return 2; }
                      topn="$2"; shift 2;;
            --once)   once=1; shift;;
            -h|--help) vtop_help; return 0;;
            *)        echo "Error: unknown option '$1' (usage: vb_tool vtop [-i <sec>] [-n <topn>] [--once])" >&2; return 2;;
        esac
    done
    case "$interval" in ''|*[!0-9]*) echo "Error: -i expects seconds (1-60)" >&2; return 2;; esac
    if [ "$interval" -lt 1 ] || [ "$interval" -gt 60 ]; then echo "Error: -i must be 1-60" >&2; return 2; fi
    case "$topn" in ''|*[!0-9]*) echo "Error: -n expects a row count (1-50)" >&2; return 2;; esac
    if [ "$topn" -lt 1 ] || [ "$topn" -gt 50 ]; then echo "Error: -n must be 1-50" >&2; return 2; fi

