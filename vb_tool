            "$current_timestamp" "$INTERFACE" "RX" \
            "$rx_byte_increment" "$rx_error_increment" "$rx_dropped_increment" "$rx_overrun_increment" \
            "$tcp_retrans_increment" "$syn_retrans_increment" "$lost_retrans_increment" "$ip_reasm_increment"
        printf "| %-19s | %-9s | %-9s | %-11d | %-6d | %-7d | %-7s | %-14d | %-14d | %-18d | %-13d |\n" \
            "$current_timestamp" "$INTERFACE" "TX" \
            "$tx_byte_increment" "$tx_error_increment" "$tx_dropped_increment" "-" \
            "$tcp_retrans_increment" "$syn_retrans_increment" "$lost_retrans_increment" "$ip_reasm_increment"
