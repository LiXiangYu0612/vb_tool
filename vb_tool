        for k in ("io.throttle.r", "io.throttle.w"):
            _vb = _cgb2.get("kv", {}).get(k) if _cgb2 else None
            _ve = _cge2.get("kv", {}).get(k) if _cge2 else None
            if _vb is None and _ve is None:
                continue
            h.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">-</td></tr>' % (esc(k),
                     esc(trunc(_vb, 40)) if _vb is not None else "-",
                     esc(trunc(_ve, 40)) if _ve is not None else "-"))
        # hugetlb: limit = static config, usage = cumulative row
        for k in sorted(set(_cgb2.get("kv", {})) | set(_cge2.get("kv", {}))):
            if not k.startswith("hugetlb."):
                continue
            vb_ = _cgb2.get("kv", {}).get(k)
            ve_ = _cge2.get("kv", {}).get(k)
            if k.endswith(".limit"):
