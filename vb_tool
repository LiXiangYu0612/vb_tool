def _normalize_ip(ip_str):
    """归一化 IP 字符串: 剥离 (port) 或 :port 后缀。

    示例:
      '192.168.131.51(33090)' -> '192.168.131.51'
      '192.168.131.51:33090'  -> '192.168.131.51'
      '192.168.131.51'        -> '192.168.131.51'
      'localhost' / ''        -> 原样返回
    """
    if not ip_str:
        return ip_str or ''
    m = _IP_STRIP_PORT_RE.match(ip_str.strip())
    if m:
        return m.group(1)
    return ip_str.strip()


def _is_likely_ip_token(tok):
    """判断 token 是否形如 IP(可带端口)"""
    return bool(tok) and bool(_ADAPTIVE_IP_RE.match(tok))


def _is_parse_suspicious(parsed):
    """Layer 2 校验: 判断 parse_log_line 结果是否可疑(字段串位)。

    命中任一规则视为可疑:
      - remote_host 不是 IP 形态(如被错位成了用户名 'bkj_admin')
      - user / database 是 IP 形态(被错位成了 IP)
      - thread_id 含字母(被错位成了 session_id 或用户名)
      - session_id 含字母+下划线且不含 hex 形态(被错位成了用户名)
    """
    if not parsed:
        return False
    rh = (parsed.get('remote_host') or '').strip()
    user = (parsed.get('user') or '').strip()
    db = (parsed.get('database') or '').strip()
    tid = (parsed.get('thread_id') or '').strip()

    # remote_host 应为 IP
    if rh and not _is_likely_ip_token(rh) and rh != 'localhost' and rh != '-':
        # 排除'-' 占位(CSV 转换空字段) 和 hostname(无数字)
        # 如果含字母+下划线(典型用户名/库名),几乎肯定是错位
        if any(c.isalpha() for c in rh) and not _is_likely_ip_token(rh):
            # 再看 user/database 是否被错放成 IP
            if _is_likely_ip_token(user) or _is_likely_ip_token(db):
                return True
            # 或者 remote_host 本身明显是个标识符(含下划线)
            if '_' in rh:
                return True
    # user/database 不应是 IP
    if _is_likely_ip_token(user) or _is_likely_ip_token(db):
        return True
    # user/database 不应是日志级别关键字
    if user.rstrip(':').upper() in _ADAPTIVE_LEVEL_TOKENS:
        return True
    if db.rstrip(':').upper() in _ADAPTIVE_LEVEL_TOKENS:
        return True
    # thread_id 通常是纯数字
    if tid and not tid.isdigit() and tid != '-':
        # thread_id 含字母,可能错位成了 session_id 或其他
        if _ADAPTIVE_SESSION_RE.match(tid) is None:
            return True
    return False


def _remap_by_token_features(prefix_line, unique_fields):
    """Layer 3: IP 位置对但其他字段语义错乱时,按 token 特征重新分配字段。

    Args:
        prefix_line (str): 日志行前缀(已按 _prefix_key 截断)
        unique_fields (list): log_line_prefix 解析出的字段顺序(不含 timestamp)

    Returns:
        dict | None: 重建后的字段字典;无法重建时返回 None
    """
    if not prefix_line or not unique_fields:
        return None
    tokens = prefix_line.strip().split()
    if not tokens:
        return None

    # timestamp 占 2 个 token (YYYY-MM-DD HH:MM:SS.mmm) 或 1 个 (ISO 格式)
    # 跳过前 1-2 个 token 作为 timestamp
    ts_skip = 0
    if len(tokens) >= 2 and re.match(r'^\d{4}-\d{2}-\d{2}$', tokens[0]) \
            and re.match(r'^\d{2}:\d{2}:\d{2}', tokens[1]):
        ts_skip = 2
    elif re.match(r'^\d{4}-\d{2}-\d{2}T', tokens[0]):
        ts_skip = 1
    elif re.match(r'^\d{4}-\d{2}-\d{2}$', tokens[0]):
        ts_skip = 1
    work_tokens = tokens[ts_skip:]
    if not work_tokens:
        return None

    result = {}
    remaining = list(work_tokens)  # 保留顺序
    used = [False] * len(remaining)
    fields_to_assign = [f for f in unique_fields if f != 'timestamp']

    # Pass 1: 定位 IP -> remote_host (锚点)
    ip_idx = -1
    for i, t in enumerate(remaining):
        if _is_likely_ip_token(t):
            ip_idx = i
            break
    if ip_idx >= 0:
        result['remote_host'] = _normalize_ip(remaining[ip_idx])
        used[ip_idx] = True
        if 'remote_host' in fields_to_assign:
            fields_to_assign.remove('remote_host')

    # Pass 2: session_id (hex.hex 形态)
    if 'session_id' in fields_to_assign:
        for i, t in enumerate(remaining):
            if used[i]:
                continue
            # 必须含 '.',左右都是 hex
            if '.' in t and _ADAPTIVE_SESSION_RE.match(t):
                result['session_id'] = t
                used[i] = True
                fields_to_assign.remove('session_id')
                break

    # Pass 3: transaction_id (通常带方括号 [123] 或是数字)
    if 'transaction_id' in fields_to_assign:
        for i, t in enumerate(remaining):
            if used[i]:
                continue
            if t.startswith('[') and t.endswith(']') and t[1:-1].isdigit():
                result['transaction_id'] = t[1:-1]
                used[i] = True
                fields_to_assign.remove('transaction_id')
                break

    # Pass 4: thread_id (纯数字,通常是 5 位以上的进程号)
    if 'thread_id' in fields_to_assign:
        for i, t in enumerate(remaining):
            if used[i]:
                continue
            if t.isdigit() and len(t) >= 5:
                result['thread_id'] = t
                used[i] = True
                fields_to_assign.remove('thread_id')
                break

    # Pass 5: 其他字段 (user/database/log_line_number/virtual_transaction_id/
    #         backend_type/application_name) 按剩余 token 顺序填充
    # 跳过纯数字 (避免把小数字错配给 user/database)
    text_candidates = []
    for i, t in enumerate(remaining):
        if used[i]:
            continue
        # 跳过方括号数字 (可能是 transaction_id 残留)
        if t.startswith('[') and t.endswith(']'):
            continue
        # 跳过纯数字 (大概率是 queryid/txid 残留)
        if t.isdigit():
            continue
        # 跳过日志级别关键字 (消息起点)
        if t.rstrip(':').upper() in _ADAPTIVE_LEVEL_TOKENS:
            break  # 后续是消息体,不再分配
        text_candidates.append(t)

    # 按字段顺序从 text_candidates 中分配
    for f in fields_to_assign:
        if not text_candidates:
            break
        result[f] = text_candidates.pop(0)

    # 至少要有 remote_host + (user 或 database) 才认为重建成功
    if 'remote_host' not in result:
        return None
    if 'user' not in result and 'database' not in result:
        return None
    return result


def check_memory_usage(threshold_mb=2048, raise_exception=True):
    """
    Args:
        threshold_mb (float): 内存阈值（MB），默认为2048MB（2GB）
        raise_exception (bool): 是否在超过阈值时抛出异常，默认为True
    """
    # ★先算后抛 (2026-11-26 复核): 原写法 raise MemoryError 位于自家 try 内,
    #   被 except Exception 吞掉 ⇒ 2GB 护栏永不生效。try 只罩 rusage 读取,
    #   阈值判断与 raise 移出。
    try:
        if resource is None:
            print("警告: 当前系统不支持内存检查（resource模块不可用）")
            return
        # ★读当前 RSS 而非 ru_maxrss (2026-11-27 复核): maxrss 是高水位标记,
        #   一旦某文件峰值越限, 之后每个文件(哪怕很小)都会被整体丢弃——大跑
        #   尾段产出全零。/proc/self/status VmRSS 为当前值; 非 Linux 回退 maxrss。
        memory_kb = 0
        try:
            with open('/proc/self/status', 'r') as _st:
                for _line in _st:
                    if _line.startswith('VmRSS:'):
                        memory_kb = int(_line.split()[1])   # kB
                        break
        except (OSError, ValueError, IndexError):
            memory_kb = 0
        if memory_kb <= 0:
            memory_kb = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
        memory_mb = memory_kb / 1024
    except Exception:
        print("警告: 内存检查失败，请注意内存使用")
        return

    if memory_mb > 0:
        if memory_mb > threshold_mb:
            error_msg = f"内存使用超过限制: {memory_mb:.2f}MB > MAX_LIMIT:  {threshold_mb}MB "
            if raise_exception:
                raise MemoryError(error_msg)
        else:
            print(f"内存使用正常: {memory_mb:.2f}MB    MAX_LIMIT: {threshold_mb}MB ")
    else:
        print("警告: 内存检查失败，请注意内存使用")
 

## @function 获取数据库日志行前缀格式
## @description 通过vsql命令获取log_line_prefix参数
## @return {string} 日志行前缀格式，如果获取失败则返回None
def get_log_line_prefix():
    try:
        # 使用PIPE来捕获输出，兼容旧版本Python
        process = subprocess.Popen(
            ['vsql', '-q', '-A', '-t', '-c', 'show log_line_prefix'],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            universal_newlines=True
        )
        # ★timeout (2026-11-26 复核): 数据库挂起时裸 communicate 会无限等, 整个
        #   分析卡死; 同文件其他 vsql 助手均已带 timeout, 这三处是漏网点
        try:
            stdout, stderr = process.communicate(timeout=10)
        except subprocess.TimeoutExpired:
            process.kill(); process.communicate()
            print("WARNING: 查询 log_line_prefix 超时(10s)，数据库无响应")
            return None

        if process.returncode != 0:
            print("WARNING: 无法从数据库获取日志行前缀格式")
            return None

        log_prefix = stdout.strip()

        return log_prefix
    except FileNotFoundError:
        print("ERROR: 未找到vsql命令，请确保已正确安装并配置数据库客户端")
        return None
    except Exception as e:
        print(f"ERROR: 获取日志行前缀格式时发生错误: {str(e)}")
        return None

## @function 获取数据库日志目录
## @description 通过vsql命令获取数据库日志目录
## @return {string} 数据库日志目录的绝对路径，如果获取失败则返回None
def get_db_log_directory():
    try:
        #print("DEBUG: 正在执行vsql命令获取log_directory参数")
        # 使用PIPE来捕获输出，兼容旧版本Python
        process = subprocess.Popen(
            ['vsql', '-q', '-A', '-t', '-c', 'show log_directory'],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            universal_newlines=True
        )
        try:
            stdout, stderr = process.communicate(timeout=10)
        except subprocess.TimeoutExpired:
            process.kill(); process.communicate()
            print("WARNING: 查询 log_directory 超时(10s)，数据库无响应")
            return None

        if process.returncode != 0:
            print("WARNING: 无法从数据库获取日志目录，请指定日志文件")
            return None

        log_directory = stdout.strip()
        #print(f"DEBUG: 获取到的日志目录: {log_directory}")
        
        # 如果是相对路径，则转换为绝对路径
        if not os.path.isabs(log_directory):
            # 获取数据库数据目录
            process_data = subprocess.Popen(
                ['vsql', '-q', '-A', '-t', '-c', 'show data_directory'],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                universal_newlines=True
            )
            try:
                stdout_data, stderr_data = process_data.communicate(timeout=10)
            except subprocess.TimeoutExpired:
                process_data.kill(); process_data.communicate()
                print("WARNING: 查询 data_directory 超时(10s)，数据库无响应")
                return None

            if process_data.returncode != 0:
                print(f"ERROR: 获取data_directory失败: {stderr_data.strip()}")
                return None
                
            data_directory = stdout_data.strip()
            log_directory = os.path.join(data_directory, log_directory)
            #print(f"DEBUG: 转换为绝对路径: {log_directory}")
            
        return log_directory
    except FileNotFoundError:
        print("ERROR: 未找到vsql命令，请确保已正确安装并配置数据库客户端")
        return None
    except Exception as e:
        print(f"ERROR: 获取日志目录时发生错误: {str(e)}")
        return None


def get_default_log_directory():
    """
    尝试从环境变量 PGDATA 获取默认日志目录，返回 $PGDATA/pg_log 绝对路径。
    如果环境变量不存在，返回 None。
    """
    pgdata = os.environ.get('PGDATA')
    if pgdata and pgdata.strip():
        return os.path.join(os.path.abspath(pgdata.strip()), 'pg_log')
    return None


