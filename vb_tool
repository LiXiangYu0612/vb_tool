            # 旧代码这里是 `sleep "$rd_tmo"` 后继续循环 —— 那是 CPU 空转的补丁，
            # 但代价是 **vtop 永不退出**。终端/ssh/su 会话先消失时 read 立刻 EOF
            # (不等待) ⇒ 老代码每 rd_tmo 秒睡一下就继续刷帧, 于是 vtop 变成后台
            # 遗留进程。没人能再按键了, 直接干净退出 (trap 还原 tty + 清临时文件 +
            # 收子进程)。非交互 (管道喂键 / 重定向) 也一样: 键喂完就该结束。
            if [ "$rrc" -eq 1 ]; then
                [ "$interactive" = "1" ] && printf '\n%sstdin closed -- exiting%s\n' "${c_dim:-}" "${c_off:-}"
                break
            fi
        fi
