            {
            printf "%s[vbtop]%s %s%s%s  %s│%s  %sLinux %s%s  %s│%s  %s%s%s\n" \
                "$c_sec" "$c_off" "$c_grn" "$h_node" "$c_off" \
                "$c_lbl" "$c_off" "$c_blu" "$kver" "$c_off" \
                "$c_lbl" "$c_off" "$c_grn" "$h_ver" "$c_off"
            printf "${c_lbl}port${c_off} ${c_grn}%s${c_off}   ${c_lbl}up${c_off} %s   %s\n" \
                "${PGPORT:-5432}" \
                "$(awk -v s="$h_up" 'BEGIN{printf "%dd%02dh%02dm", int(s/86400), int(s%86400/3600), int(s%3600/60)}')" \
                "$cores"
