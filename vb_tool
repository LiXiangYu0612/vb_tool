    if [ -z "${_VB_TOOL_CMDS:-}" ]; then
        _VB_TOOL_CMDS="$( "${_VB_TOOL_BIN:-vb_tool}" -h 2>/dev/null \
            | sed -n 's/^  \([a-z_][a-z0-9_]*\) .*/\1/p' | grep -v '^vb_tool$' | sort -u | tr '\n' ' ' )"
    fi
    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=( $(compgen -W "$_VB_TOOL_CMDS" -- "$cur") )
