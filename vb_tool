                    else:
                        _dv2 = _ecs[k2] - _bcs[k2]
                        _fd = ("+" + fmt_int(_dv2)) if _dv2 else fmt_int(0)
                else:
                    _fd = "-"
                h.append('<tr><td>cpu.%s</td><td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td></tr>' % (k2, _fb, _fe, _fd))
        # memory.events (v2): ABSOLUTE per-snapshot counters, never a plain
        # window delta (user 2026-11-01: an OOM kill takes the DB down -- no
