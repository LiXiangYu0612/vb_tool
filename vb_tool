    @staticmethod
    def _normalize_error_msg(msg, max_len=200):
        """归一化错误消息,用于聚合相似错误。

        注意：TRUNCATE 级别消息格式固定为 "truncate table <rel_name>"，
        其中 rel_name 是通过 OID 反查得到的真实表名，不能归一化
        （即使是纯数字，不同表名代表不同对象）。
        """
        s = msg or ''

        # TRUNCATE / DROP / ALTER 消息特殊处理：拆分前缀与对象名，只归一化前缀，保留对象名
        # 消息形如 "truncate table public.t1" / "drop table public.t1" / "alter table t1" 等
        _ddl_prefixes = ('truncate table ',)
        # drop/alter 支持多种对象类型: drop table/view/index/... / alter table/index/...
        _s_lower = s.lower()
        if _s_lower.startswith('drop '):
            # 提取 "drop <type> " 作为前缀
            _m = re.match(r'(drop\s+\w+\s+)', s, re.IGNORECASE)
            if _m:
                _ddl_prefixes = (_m.group(1),)
        elif _s_lower.startswith('alter '):
            # 提取 "alter <type> " 作为前缀
            _m = re.match(r'(alter\s+\w+\s+)', s, re.IGNORECASE)
            if _m:
                _ddl_prefixes = (_m.group(1),)
        for _ddl_prefix in _ddl_prefixes:
            if _s_lower.startswith(_ddl_prefix):
                prefix = s[:len(_ddl_prefix)]
                table_name = s[len(_ddl_prefix):]
                # 前缀部分正常归一化（一般不会变），对象名原样保留
                prefix_norm = _ERR_NORM_WS_RE.sub(' ', prefix).strip()
                result = prefix_norm + ' ' + table_name
                if len(result) > max_len:
                    result = result[:max_len] + ' ...'
                return result

        s = _ERR_NORM_SQ_RE.sub("'xxx'", s)
        s = _ERR_NORM_DQ_RE.sub('"xxx"', s)
        s = _ERR_NORM_NUM_RE.sub('xxx', s)
        s = _ERR_NORM_WS_RE.sub(' ', s).strip()
        if len(s) > max_len:
            s = s[:max_len] + ' ...'
        return s

    @staticmethod
    def _error_level_stats(error_list):
        """统计各级别错误数量与按小时分布,返回 (level_counter, hour_counter)。"""
        # 类级缓存:同一 error_list 多次调用时直接复用,避免 O(N) 全量扫描
        cache = getattr(ReportGenerator, '_err_level_stats_cache', None)
        if cache is None:
            cache = ReportGenerator._err_level_stats_cache = {}
        cache_key = (id(error_list), len(error_list))
        if cache_key in cache:
            return cache[cache_key]
        level_counter = defaultdict(int)
        hour_counter = defaultdict(int)
        for e in error_list:
            level_counter[e['level']] += 1
            t = e.get('time')
            if t is not None:
                hour_counter[t.strftime('%H:00')] += 1
        result = (level_counter, hour_counter)
        # 只缓存最近 4 个不同的 error_list,避免内存膨胀
        if len(cache) >= 4:
            cache.clear()
        cache[cache_key] = result
        return result

    @staticmethod
    def _describe_peak_hour(error_list, peak_hour):
        """生成高峰时段的简要描述: top 错误消息(含用户)。"""
        # 类级缓存:同一 (error_list, peak_hour) 组合直接复用
        cache = getattr(ReportGenerator, '_err_peak_hour_cache', None)
        if cache is None:
            cache = ReportGenerator._err_peak_hour_cache = {}
        cache_key = (id(error_list), len(error_list), peak_hour)
        if cache_key in cache:
            return cache[cache_key]
        msgs = defaultdict(int)
        users = defaultdict(int)
        for e in error_list:
            t = e.get('time')
            if t is None or t.strftime('%H:00') != peak_hour:
                continue
            key = ReportGenerator._normalize_error_msg(e['message'], max_len=80)
            msgs[key] += 1
            if e.get('user'):
                users[e['user']] += 1
        if not msgs:
            desc = ''
        else:
            top_msgs = sorted(msgs.items(), key=lambda x: x[1], reverse=True)[:2]
            parts = []
            for m, c in top_msgs:
                parts.append('"%s" x%d' % (m, c) if c > 1 else '"%s"' % m)
            desc = ' + '.join(parts)
            if len(users) == 1:
                desc = '%s 用户 ' % list(users.keys())[0] + desc
        if len(cache) >= 8:
            cache.clear()
        cache[cache_key] = desc
        return desc

    @staticmethod
    def _build_overview_table(all_total_list, error_list, statement_filter='query', opt_params_info=None):
        """构建汇总信息表格(展示在导航栏下方、饼图上方)。"""
        opt_params_info = opt_params_info or {}
        rows = []
        # ---- 数据库版本（--detail 时查询，含参数下载按钮） ----
        db_version = (opt_params_info.get('version') or '').strip()
        params_text = opt_params_info.get('params_text') or ''
        if db_version:
            version_html = '<pre class="ov-version">%s</pre>' % html.escape(db_version)
            if params_text:
                params_b64 = _gz_b64_text(params_text)
                version_html += ('<button class="copy-btn" data-sql-b64="%s" data-filename="opt_params.txt.gz" '
                                 'data-done-text="已下载" onclick="downloadEmbeddedText(this)">下载参数配置(.gz)</button>' % params_b64)
            rows.append(('数据库版本', version_html))
        elif opt_params_info.get('error'):
            rows.append(('数据库版本', '<span class="ov-na">未获取（%s）</span>' % html.escape(str(opt_params_info['error']))))
        # ---- 错误统计 ----
        if statement_filter == 'query':
            # query 模式未提取错误日志，显示 N/A 并给出提示
            rows.append(('ERROR / WARNING / FATAL',
                         '<span class="ov-na">N/A（当前 --mode=query 模式未分析错误日志，如需分析请使用 --mode error 或 --mode all）</span>'))
            rows.append(('错误最多时段', '<span class="ov-na">N/A</span>'))
        else:
            level_counter, hour_counter = ReportGenerator._error_level_stats(error_list)
            n_error = level_counter.get('ERROR', 0)
            n_warning = level_counter.get('WARNING', 0)
            n_fatal = level_counter.get('FATAL', 0) + level_counter.get('PANIC', 0)
            err_cls = 'ov-bad' if (n_error or n_fatal) else ('ov-warn' if n_warning else '')
            rows.append(('ERROR / WARNING / FATAL',
                         '<span class="%s">%d / %d / %d 条</span>' % (err_cls, n_error, n_warning, n_fatal)))
            if hour_counter:
                peak_hour, peak_cnt = max(hour_counter.items(), key=lambda x: x[1])
                desc = ReportGenerator._describe_peak_hour(error_list, peak_hour)
                peak_txt = '%s 时段(%d 条' % (peak_hour, peak_cnt)
                peak_txt += ('，' + desc if desc else '') + ')'
                rows.append(('错误最多时段', '<span class="ov-bad">%s</span>' % html.escape(peak_txt)))
            else:
                rows.append(('错误最多时段', '无错误/警告记录'))

        # ---- 慢 SQL 统计（按 DQL/DDL 拆分） ----
        total_slow = len(all_total_list)
        dml_list = [item for item in all_total_list if item.get('sql_type') != 'ddl']
        ddl_list = [item for item in all_total_list if item.get('sql_type') == 'ddl']

        def _build_slow_sql_stats(items, label):
            """构建单个类型的慢 SQL 统计行(空数据下返回完整 4 行结构,保持报告一致性)"""
            if not items:
                return [
                    (f'{label} 慢 SQL 触发次数', '0 次'),
                    (f'{label} 慢 SQL 总耗时', '<span class="ov-na">无记录</span>'),
                    (f'{label} 慢 SQL 最多时段', '<span class="ov-na">无记录</span>'),
                    (f'{label} 最长慢语句', '<span class="ov-na">无记录</span>'),
                ]
            sub_rows = []
            total = len(items)
            durations = [item['duration'] for item in items]
            avg_dur = sum(durations) / total
            total_dur = sum(durations)
            sub_rows.append((f'{label} 慢 SQL 触发次数', f'{total} 次，平均 {avg_dur:.2f} s'))
            sub_rows.append((f'{label} 慢 SQL 总耗时', f'{total_dur:.2f} s'))
            slow_hours = defaultdict(int)
            for item in items:
                t = item.get('time')
                if t is not None:
                    slow_hours[t.strftime('%H:00')] += 1
            if slow_hours:
                ph, pc = max(slow_hours.items(), key=lambda x: x[1])
                sub_rows.append((f'{label} 慢 SQL 最多时段', f'<span class="ov-bad">{ph} 时段({pc} 条)</span>'))
            else:
                sub_rows.append((f'{label} 慢 SQL 最多时段', '<span class="ov-na">无有效时间</span>'))
            max_item = max(items, key=lambda x: x['duration'])
            sub_rows.append((f'{label} 最长慢语句',
                             f'<span class="ov-bad">{max_item["duration"]:.2f} s</span>'))
            return sub_rows

        # 无论是否有慢SQL记录,都展示完整栏目结构(总次数独占一行 + DQL/DDL 左右两块对称展示)
        if total_slow:
            _total_dur = sum(item['duration'] for item in all_total_list)
            _avg_dur = _total_dur / total_slow
            rows.append(('慢 SQL 触发', f'总次数: {total_slow} 次, 总耗时: {_total_dur:.2f} s, 平均耗时: {_avg_dur:.2f} s'))
        else:
            rows.append(('慢 SQL 触发', '总次数: 0 次, 总耗时: <span class="ov-na">无记录</span>, 平均耗时: <span class="ov-na">无记录</span>'))

        def _render_split_cell(split_rows):
            """把一个类型的 4 行统计渲染成内部小表(用于左右并排)"""
            return ''.join(
                '<tr><td class="ov-label ov-split-label">%s</td><td class="ov-value">%s</td></tr>' % (k, v)
                for k, v in split_rows
            )

        dml_rows = _build_slow_sql_stats(dml_list, 'DQL')
        ddl_rows = _build_slow_sql_stats(ddl_list, 'DDL')
        split_html = (
            '<div class="ov-split">'
            '<div class="ov-split-col"><table class="ov-split-table">%s</table></div>'
            '<div class="ov-split-col"><table class="ov-split-table">%s</table></div>'
            '</div>'
        ) % (_render_split_cell(dml_rows), _render_split_cell(ddl_rows))
        rows.append(('慢 SQL 明细', split_html))

        body = ''.join(
            '<tr><td class="ov-label">%s</td><td class="ov-value">%s</td></tr>' % (k, v)
            for k, v in rows
        )
        return ('<div class="overview-box"><h3 class="overview-title">📋 汇总信息</h3>'
                '<table class="overview-table">%s</table></div>' % body)

    @staticmethod
    def generate_error_section(error_list, statement_filter='query'):
        """生成"错误日志分析"栏目 HTML(级别卡片 + 消息聚合 + 明细表)。"""
        ReportGenerator._err_group_table_seq = 0
        if statement_filter == 'query':
            return """
            <section id="error-section">
                <h2>⚠️ 错误日志分析</h2>
                <p class="error-empty">当前 <code>--mode=query</code> 模式未分析错误日志。如需查看 ERROR / WARNING / FATAL / PANIC 记录，请使用 <code>--mode error</code> 或 <code>--mode all</code> 重新分析。</p>
            </section>
            """
        if not error_list:
            return """
            <section id="error-section">
                <h2>⚠️ 错误日志分析</h2>
                <p class="error-empty">日志中未发现 ERROR / WARNING / FATAL / PANIC 记录。</p>
            </section>
            """

        level_counter, hour_counter = ReportGenerator._error_level_stats(error_list)
        parts = ['<section id="error-section"><h2>⚠️ 错误日志分析</h2>']

        # ---- 1. 级别统计卡片 ----
        level_meta = [('ERROR', '#e74c3c'), ('WARNING', '#f39c12'),
                      ('FATAL', '#c0392b'), ('PANIC', '#8e44ad'),
                      ('BUG', '#8e44ad'), ('TRUNCATE', '#16a085'), ('DROP', '#2980b9'),
                      ('ALTER', '#e67e22')]
        parts.append('<div class="summary-stats"><div class="stats-grid">')
        for lv, color in level_meta:
            cnt = level_counter.get(lv, 0)
            parts.append(f"""
                <div class="stat-item" style="border-left-color: {color};">
                    <span class="range-name">{lv}</span>
                    <span class="range-count">{cnt} 条</span>
                </div>
            """)
        # 错误最多时段卡片
        if hour_counter:
            peak_hour, peak_cnt = max(hour_counter.items(), key=lambda x: x[1])
            parts.append(f"""
                <div class="stat-item" style="border-left-color: #e67e22;">
                    <span class="range-name">错误最多时段</span>
                    <span class="range-count">{peak_hour}({peak_cnt} 条)</span>
                </div>
            """)
        parts.append('</div></div>')

        # ---- 2. 按 (level, 归一化消息) 全量聚合 ----
        groups = {}
        for e in error_list:
            key = (e['level'], ReportGenerator._normalize_error_msg(e['message']))
            g = groups.setdefault(key, {'count': 0, 'first': None, 'last': None,
                                        'users': set(), 'dbs': set()})
            g['count'] += 1
            t = e.get('time')
            if t is not None:
                if g['first'] is None or t < g['first']:
                    g['first'] = t
                if g['last'] is None or t > g['last']:
                    g['last'] = t
            if e.get('user'):
                g['users'].add(e['user'])
            if e.get('database'):
                g['dbs'].add(e['database'])
        # 按次数降序,作为基础排序(后续按级别再分流)
        sorted_groups = sorted(groups.items(), key=lambda kv: kv[1]['count'], reverse=True)

        # 按级别拆分:TRUNCATE / DROP / ALTER / WARNING / ERROR/FATAL/PANIC 各自分流
        # TRUNCATE / DROP / ALTER 分开统计，但在同一聚合表中展示
        truncate_groups = [(k, v) for k, v in sorted_groups if k[0] == 'TRUNCATE']
        drop_groups = [(k, v) for k, v in sorted_groups if k[0] == 'DROP']
        alter_groups = [(k, v) for k, v in sorted_groups if k[0] == 'ALTER']
        warning_groups = [(k, v) for k, v in sorted_groups if k[0] == 'WARNING']
        critical_groups = [(k, v) for k, v in sorted_groups if k[0] in ('ERROR', 'FATAL', 'PANIC', 'BUG')]

        def _render_group_table(group_items, title, limit=None, more_note=True):
            """渲染消息聚合表。limit=None 表示全部展示。"""
            table_id = f'err-group-table-{ReportGenerator._err_group_table_seq}'
            ReportGenerator._err_group_table_seq += 1
            parts_html = [f"""<div class="err-group-header">
                <h3>{title}(共 {len(group_items)} 类)</h3>
                <div class="err-group-filter">
                    <label>用户:</label><div class="multi-filter" data-filter-kind="user" data-table="{table_id}"></div>
                    <label>数据库:</label><div class="multi-filter" data-filter-kind="db" data-table="{table_id}"></div>
                </div>
            </div>"""]
            parts_html.append(f"""<table class="error-table error-group-table" id="{table_id}">
                <thead><tr>
                    <th>级别</th><th>次数</th><th>错误消息(归一化)</th>
                    <th>涉及用户</th><th>涉及数据库</th><th>首次出现</th><th>最近出现</th>
                </tr></thead><tbody>""")
            shown = group_items if limit is None else group_items[:limit]
            fmt = lambda t: t.strftime('%Y-%m-%d %H:%M:%S') if t else '-'
            for (lv, nmsg), g in shown:
                users_attr = html.escape(json.dumps(sorted(g['users']), ensure_ascii=False), quote=True)
                dbs_attr = html.escape(json.dumps(sorted(g['dbs']), ensure_ascii=False), quote=True)
                parts_html.append(f"""<tr data-users="{users_attr}" data-dbs="{dbs_attr}">
                    <td><span class="err-lv err-lv-{lv}">{lv}</span></td>
                    <td>{g['count']}</td>
                    <td class="error-msg-cell">{html.escape(nmsg)}</td>
                    <td>{html.escape(', '.join(sorted(g['users'])) or '-')}</td>
                    <td>{html.escape(', '.join(sorted(g['dbs'])) or '-')}</td>
                    <td>{fmt(g['first'])}</td>
                    <td>{fmt(g['last'])}</td>
                </tr>""")
            parts_html.append('</tbody></table>')
            if more_note and limit and len(group_items) > limit:
                parts_html.append(f'<p class="error-more-note">仅显示前 {limit} 类,共 {len(group_items)} 类。</p>')
            return ''.join(parts_html)

        # ---- 2a. ERROR/FATAL/PANIC 聚合表(全部展示) ----
        if critical_groups:
            parts.append(_render_group_table(
                critical_groups,
                title='ERROR / FATAL / PANIC / BUG',
                limit=None,
                more_note=False,
            ))

        # ---- 2b. WARNING 聚合表(仅前 20 类) 无明细----
        if warning_groups:
            parts.append(_render_group_table(
                warning_groups,
                title='WARNING(仅top 20 类),无明细数据',
                limit=20,
                more_note=True,
            ))

        # ---- 2c. TRUNCATE / DROP / ALTER 聚合表(按对象名归一,全部展示) ----
        # TRUNCATE / DROP / ALTER 分开统计级别，但合并到同一个聚合表展示，按次数统一降序排序
        if truncate_groups or drop_groups or alter_groups:
            _ddl_groups = sorted(
                truncate_groups + drop_groups + alter_groups,
                key=lambda kv: kv[1]['count'], reverse=True
            )
            parts.append(_render_group_table(
                _ddl_groups,
                title='TRUNCATE / DROP / ALTER 语句(按对象名归一聚合)',
                limit=None,
                more_note=False,
            ))

        # ---- 3. ERROR/FATAL/PANIC/TRUNCATE/DROP/ALTER 明细表(按聚合组只保留首尾 2 条,标注执行编号) ----
        # WARNING 不进明细表(数量过大,只在聚合卡片查看)。TRUNCATE/DROP/ALTER 进明细(可按对象名搜索)。
        critical_errors = [e for e in error_list if e['level'] in ('ERROR', 'FATAL', 'PANIC', 'BUG', 'TRUNCATE', 'DROP', 'ALTER')]
        if critical_errors:
            sorted_all_errors = sorted(critical_errors,
                                        key=lambda e: e['time'] or datetime.min,
                                        reverse=True)
            visible_rows = 10

            # 按 (level, 归一化消息) 分组,每组只保留首尾两条
            # TRUNCATE / DROP / ALTER 组也纳入（其归一消息即 truncate table <表名> / drop <type> <对象名> / alter <type> <对象名>，可按对象名搜索）
            # 优化:一次遍历完成分组,避免 O(N×G) 全量重扫
            _norm = ReportGenerator._normalize_error_msg
            groups_map = {}
            for e in critical_errors:
                k = (e['level'], _norm(e['message']))
                groups_map.setdefault(k, []).append(e)
            detail_groups = critical_groups + truncate_groups + drop_groups + alter_groups
            first_last_rows = []  # [(seq_no, total, e), ...]  seq_no=该组内执行编号(1=最早,N=最近)
            for (lv, nmsg), g in detail_groups:
                group_errors = groups_map.get((lv, nmsg), [])
                if not group_errors:
                    continue
                group_errors.sort(key=lambda e: e['time'] or datetime.min)
                total = len(group_errors)
                pick_idx = [0] if total == 1 else [0, total - 1]
                for i in pick_idx:
                    first_last_rows.append((i + 1, total, group_errors[i]))

            # 明细表行按时间倒序展示
            first_last_rows.sort(key=lambda x: x[2]['time'] or datetime.min, reverse=True)

            parts.append(f"""
                <div class="error-detail-header">
                    <h3>日志明细(共 {len(sorted_all_errors)} 条 按消息聚合后展示首尾 {len(first_last_rows)} 条)</h3>
                    <div class="err-group-filter">
                        <label class="search-exclude-label"><input type="checkbox" id="error-search-exclude" onchange="applyErrorSearch()">排除</label>
                        <label class="search-exclude-label"><input type="checkbox" id="error-search-regex" onchange="applyErrorSearch()">正则</label>
                        <input type="text" id="error-search" placeholder="输入错误消息/表名关键词过滤..." onkeydown="if(event.key==='Enter')applyErrorSearch()" />
                        <label>级别:</label><div class="multi-filter" data-filter-kind="level" data-table="error-detail-table"></div>
                        <label>用户:</label><div class="multi-filter" data-filter-kind="user" data-table="error-detail-table"></div>
                        <label>数据库:</label><div class="multi-filter" data-filter-kind="db" data-table="error-detail-table"></div>
                    </div>
                </div>
                <table class="error-table" id="error-detail-table">
                <thead><tr>
                    <th>#</th><th>时间</th><th>级别</th><th>用户</th>
                    <th>数据库</th><th>客户端</th><th>错误消息</th>
                </tr></thead><tbody>""")
            for idx, (seq_no, total, e) in enumerate(first_last_rows, 1):
                t = e.get('time')
                ts_txt = t.strftime('%Y-%m-%d %H:%M:%S') if t else e.get('timestamp', '-')
                row_cls = ' class="error-row-hidden"' if idx > visible_rows else ''
                msg_disp = html.escape(e['message'][:1000])

                # 构建前后3行日志上下文,首行追加执行编号说明(仅在详情展开后可见)
                seq_txt = f"第 {seq_no} 次 / 共 {total} 次执行"
                context_parts = [f"[执行编号] {seq_txt}"]
                for line in e.get('context_before', [])[-3:]:
                    context_parts.append(f"  {line}")
                context_parts.append(f"> {e.get('full_log', e['message'])}")
                for line in e.get('context_after', [])[:3]:
                    context_parts.append(f"  {line}")
                context_text = '\n'.join(context_parts)
                context_escaped = html.escape(context_text, quote=True)
                context_copy = html.escape(json.dumps(context_text, ensure_ascii=False), quote=True)

                parts.append(f"""<tr{row_cls} data-user="{html.escape(e.get('user') or '', quote=True)}" data-db="{html.escape(e.get('database') or '', quote=True)}" data-level="{e['level']}">
                    <td>{idx}</td>
                    <td>{ts_txt}</td>
                    <td><span class="err-lv err-lv-{e['level']}">{e['level']}</span></td>
                    <td>{html.escape(e.get('user') or '-')}</td>
                    <td>{html.escape(e.get('database') or '-')}</td>
                    <td>{html.escape(e.get('IP') or '-')}</td>
                    <td class="error-msg-cell">
                        <pre>{msg_disp}</pre>
                        <div class="error-action-btns">
                            <button class="error-detail-btn" onclick="toggleErrorDetail(this)" title="查看前后3行日志">详情</button>
                            <button class="copy-btn" data-copy-text="{context_copy}" onclick="copyToClipboard(this)" title="复制上下文日志">复制</button>
                        </div>
                        <div class="error-context-detail" style="display:none;">
                            <pre>{context_escaped}</pre>
                        </div>
                    </td>
                </tr>""")
            parts.append('</tbody></table>')
            total_rows = len(first_last_rows)
            if total_rows > visible_rows:
                parts.append(f"""
                <div class="expand-container" id="error-expand-container">
                    <button class="expand-btn" id="error-expand-btn" onclick="loadMoreErrorRows()">
                        加载更多 (剩余 {total_rows - visible_rows} 行)
                    </button>
                    <button class="expand-btn" id="error-expand-all-btn" onclick="toggleAllErrorRows()">
                        <span class="expand-text">展开全部</span>
                        <span class="collapse-text" style="display:none;">收起全部</span>
                    </button>
                </div>""")
            else:
                parts.append("""
                <div class="expand-container" id="error-expand-container" style="display:none;">
                    <button class="expand-btn" id="error-expand-btn" onclick="loadMoreErrorRows()">
                        加载更多
                    </button>
                    <button class="expand-btn" id="error-expand-all-btn" onclick="toggleAllErrorRows()">
                        <span class="expand-text">展开全部</span>
                        <span class="collapse-text" style="display:none;">收起全部</span>
                    </button>
                </div>""")
        parts.append('</section>')
        return ''.join(parts)

    @staticmethod
    def generate_deadlock_section(deadlock_list):
        """
        生成死锁分析HTML片段（合并为单一“死锁分析”表格）

        Args:
            deadlock_list: 死锁记录列表，每项为包含以下字段的字典：
                timestamp, process_a, txid_a, process_b, txid_b,
                lock_duration_ms, lock_type, sql_a, sql_b,
                unique_id_a, unique_id_b, related_lock_events, full_context

        Returns:
            str: HTML 字符串，如果没有死锁记录则返回空字符串
        """
        if not deadlock_list:
            return ''

        # 按发生时间排序并只显示最近10条死锁
        recent_deadlocks = sorted(deadlock_list, key=lambda x: x.get('timestamp', ''))[-10:]
        total_count = len(deadlock_list)

        html_parts = []
        html_parts.append(f"""
        <h3 id="deadlock-ranking">死锁分析</h3>
        <div class="top10-container deadlock-container">
            <div class="top10-section deadlock-section top10-always" data-sql-type="deadlock">
                <h4>死锁会话汇总（死锁：{total_count} 次，显示最近10条）</h4>
                <table class="top10-table deadlock-table">
                    <tr>
                        <th>序号</th>
                        <th>发生时间</th>
                        <th>会话信息(sessionid/txid)</th>
                        <th>Unique ID</th>
                        <th>SQL 摘要</th>
                        <th>锁类型</th>
                        <th>检测耗时 (ms)</th>
                        <th>相关日志</th>
                    </tr>
        """)

        for idx, item in enumerate(recent_deadlocks, 1):
            timestamp = html.escape(str(item.get('timestamp', '')), quote=True)
