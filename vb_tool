    # ================= Active Session History =================
    # gs_asp/local_active_session = persisted 1-second kernel ASP samples;
    # every create flushes [prev snap, now]; the window unions every flush
    # in (begin, end]. Output mirrors the `vb_tool asp` command: 5-minute
    # buckets of per-second counts (max/avg), source tag per bucket, top-5
    # SQL per bucket. Section renders UNCONDITIONALLY (user 2026-09-02):
    # an absent section reads as "feature missing", an empty one reads as
    # "no samples in this window" (idle standby / enable_asp off / PG).
    _ash = (load_ash_flushes(repl_dir, m.get("begin_ts", ""), m.get("end_ts", ""))
            if repl_dir is not None else {"cnt": {}, "event": {}, "sql": {}, "waitchain": {}})
    _ash_qtext = {}   # unique_query_id -> unique_query text (ASH Top SQL links)
    sec("Active Session History")
    if _ash["cnt"] or _ash["event"] or _ash["sql"] or _ash["waitchain"]:
        def _ash_dt(src, bk):
            from datetime import datetime, timedelta
            tag = "[gs_asp]" if src == "g" else "[local_active_session]"
            try:
                t0 = datetime.strptime(bk, "%Y-%m-%d %H:%M")
                return "%s %s-%s" % (tag, t0.strftime("%Y-%m-%d %H:%M:%S"),
                                     (t0 + timedelta(minutes=5)).strftime("%H:%M:%S"))
            except ValueError:
                return "%s %s" % (tag, bk)
        # Count/Event/Top SQL render UNCONDITIONALLY (waitchain precedent,
        # user 2026-09-16): an absent sub reads as "feature missing", an
        # empty one reads as "no samples of this kind in this window"
        sub("Active Session History Count")
        _h = ['<table class="t"><tr><th>date_time</th><th class="n">max_sess</th>'
              '<th class="n">avg_sess</th><th class="n">max_active_sess</th>'
              '<th class="n">wait_lock</th><th class="n">wait_lwlock</th>'
              '<th class="n">wait_io</th><th class="n">wait_wal_sync</th>'
              '<th class="n">wait_trans_sync</th></tr>']
        if _ash["cnt"]:
            for (src, bk) in sorted(_ash["cnt"], key=lambda k: k[1]):
                v = _ash["cnt"][(src, bk)]
                _h.append('<tr><td>%s</td>%s</tr>'
                          % (_ash_dt(src, bk),
                             "".join('<td class="n">%s</td>' % fmt_int(x) for x in v)))
        else:
            _h.append('<tr><td colspan="9" class="note">no data</td></tr>')
        _h.append('</table>')
        parts.append("".join(_h))
        sub("Active Session History Event")
        _h = ['<table class="t"><tr><th>date_time</th><th>event_type</th>'
              '<th>event</th><th class="n">max_cnt</th><th class="n">avg_cnt</th></tr>']
        if _ash["event"]:
            for (src, bk, ev), v in sorted(_ash["event"].items(),
                                           key=lambda kv: (kv[0][1], -kv[1][1])):
                _h.append('<tr><td>%s</td><td>%s</td><td>%s</td>'
                          '<td class="n">%s</td><td class="n">%s</td></tr>'
                          % (_ash_dt(src, bk), esc(v[0]), esc(ev),
                             fmt_int(v[1]), fmt_int(v[2])))
        else:
            _h.append('<tr><td colspan="5" class="note">no data</td></tr>')
        _h.append('</table>')
        parts.append("".join(_h))
        sub("Active Session History Top SQL")
        _h = ['<table class="t"><tr><th>date_time</th><th class="n">unique_query_id</th>'
              '<th>unique_query</th><th class="n">max_cnt</th>'
              '<th class="n">avg_cnt</th></tr>']
        if _ash["sql"]:
            for (src, bk, qid), v in sorted(_ash["sql"].items(),
                                            key=lambda kv: (kv[0][1], -kv[1][1])):
                _ash_qtext[qid] = v[0]
                _h.append('<tr><td>%s</td><td class="n">%s</td><td>%s</td>'
                          '<td class="n">%s</td><td class="n">%s</td></tr>'
                          % (_ash_dt(src, bk), sql_anchor(qid), esc(v[0]),
                             fmt_int(v[1]), fmt_int(v[2])))
        else:
            _h.append('<tr><td colspan="5" class="note">no data</td></tr>')
        _h.append('</table>')
        parts.append("".join(_h))
        # waitchain header is unconditional within the section: an absent
        # table reads as "feature missing", an empty one reads as "no chains
        # in this window" -- the latter is the information the reader wants
        _h = ['<table class="t"><tr><th>date_time</th><th>root_block_sessid</th>'
              '<th class="n">max_b_cnt</th><th>h_sql</th><th>w_sql</th></tr>']
        if _ash["waitchain"]:
            for (dt, rt), v in sorted(_ash["waitchain"].items(),
                                      key=lambda kv: (kv[0][0], -kv[1][0])):
                _h.append('<tr><td>%s</td><td>%s</td><td class="n">%s</td>'
                          '<td>%s</td><td>%s</td></tr>'
                          % (esc(dt), esc(rt), fmt_int(v[0]), esc(v[1]), esc(v[2])))
        else:
            _h.append('<tr><td colspan="5" class="note">no data</td></tr>')
        _h.append('</table>')
        sub("Active Session History Waitchain")
        parts.append("".join(_h))
    else:
        parts.append('<div class="note">no data</div>')

    # ================= Wait Events =================
    sec("Wait Events", fold=True)
    parts.append('<table class="t"><tr><th>Event</th><th>Class</th><th class="n">Waits</th>'
                 '<th class="n">Total Wait Time (s)</th><th class="n">Avg wait (ms)</th>'
                 '<th class="n">% DB time</th></tr>')
    if not we_sorted:
        parts.append('<tr><td colspan="6" class="note">no data</td></tr>')
    for k in we_sorted:
        d = WE[k]; w = d.get("wait", 0.0); t = d.get("total_wait_time", 0.0)
        cls_ = (d.get("__row") or {}).get("type", "")
        avg = (t / w) if w else 0.0
        parts.append('<tr><td>%s</td><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td><td class="n">%.2f%%</td></tr>' % (
                         esc(k), esc(cls_), fmt_int(w), s_of(t), ms_of(avg), pct(t, dbt)))
    parts.append('</table>')

    # ================= SQL Text (full normalized queries, AWR-style) =================
    # ids linked from the sampler sub-tables (lt/callstack/sessmem/ASH) get
    # anchor rows too, so every link lands on its text (user 2026-10-15)
    for _uid, _u in _sql_ids:
        if _uid and _uid not in shown_sql:
            shown_sql[_uid] = {"user_name": _u}
    sec("SQL Text", fold=True)
    if not shown_sql and not _ash_qtext:
        parts.append('<div class="note">no data</div>')
    else:
        parts.append('<table class="t"><tr><th>SQL Id</th><th>SQL Text</th></tr>')
        _any_missing = False
        for uid in sorted(shown_sql.keys()):
            row = shown_sql[uid] or {}
            _q = sql_text_of(win, row, uid)
            if _q is None:
                # sampler-collected ids carry no statement row: try the shared
                # text store by uid alone (user unknown there)
                _q = next((t for (_u, _i), t in (win.get("_sqltext") or {}).items()
                           if _i == str(uid)), None)
            if _q is None:
                _any_missing = True
            parts.append('<tr id="sql-%(u)s"><td class="sqlid">%(u)s</td>'
                         '<td><pre class="sqlfull">%(q)s</pre></td></tr>'
                         % {"u": esc(uid), "q": esc(normalize_sql(
                             _q or "(text not collected: absent from sql_text store)"))})
        for _qid, _q in sorted(_ash_qtext.items()):
            if _qid in shown_sql:
                continue
            parts.append('<tr id="sql-%(u)s"><td class="sqlid">%(u)s</td>'
                         '<td><pre class="sqlfull">%(q)s</pre></td></tr>'
                         % {"u": esc(_qid), "q": esc(normalize_sql(_q or "-"))})
        if _any_missing and win.get("_sqltext_missing"):
            parts.append('</table><div class="note">WARNING: shared sql_text store '
                         '(sql_text.csv.gz) not found next to the snapshots -- texts above are '
                         'unavailable. Restore the store file, or take a new snapshot to '
                         're-collect texts for still-running SQL. Numbers are unaffected.</div>')
        parts.append('</table>')

    # ================= Database Parameters (pg_settings, live query) =================
    sec("Database Parameters", fold=True)
    pgset = fetch_pg_settings()
    parts.append('<table class="t params"><colgroup>'
                 '<col style="width:24%"><col style="width:14%"><col style="width:12%"><col style="width:50%">'
                 '</colgroup><tr><th>Name</th><th>Setting</th>'
                 '<th>Context</th><th>Description</th></tr>')
    if not pgset:
        parts.append('<tr><td colspan="4" class="note">no data</td></tr>')
    else:
        def decode_setting(setting, unit):
            if unit == "8kB":
                try:
                    return "%dkB" % (int(float(setting)) * 8)
                except Exception:
                    return "%s kB" % setting
            return "%s%s" % (setting, unit if unit else "")
        for r in sorted(pgset, key=lambda x: x.get("name", "")):
            _n = r.get("name", "")
            _s = decode_setting(r.get("setting", ""), r.get("unit", ""))
            _c = r.get("context", "")
            _d = r.get("short_desc", "")
            parts.append('<tr><td title="%s">%s</td><td title="%s">%s</td><td>%s</td><td class="wrap">%s</td></tr>'
                         % (esc(_n), esc(_n), esc(_s), esc(_s), esc(_c), esc(_d)))
    parts.append('</table>')
    # ---- Role / Database-level GUC overrides (pg_db_role_setting) ----
    # VB supports per-user GUC overrides (ALTER ROLE ... SET, plus the
    # per-role-per-database and per-database forms); none of those appear in
    # pg_settings above (instance-level view), so list them here. Values come
    # from the END snapshot's csv (user ruling 2026-11-24: report the
    # window-end state, not a live query). '-' = role-only (any database) /
    # db-only (any role) entry.
    parts.append('<div class="sub">Role / Database-level GUC</div>')
    pgrs = win["db"].get(("end", "pg_db_role_setting"), [])
    parts.append('<table class="t params"><colgroup>'
                 '<col style="width:16%"><col style="width:16%"><col style="width:26%"><col style="width:42%">'
                 '</colgroup><tr><th>Role</th><th>Database</th>'
                 '<th>Parameter</th><th>Value</th></tr>')
    if not win.get("_role_guc_captured", {}).get("end"):
        note("pg_db_role_setting not captured in the end snapshot (snapshot "
             "predates this capture); role-level GUC overrides unavailable.")
        parts.append('<tr><td colspan="4" class="note">(not captured in end snapshot)</td></tr>')
    elif not pgrs:
        parts.append('<tr><td colspan="4" class="note">no role-level or database-level GUC overrides set</td></tr>')
    else:
        for r in pgrs:
            parts.append('<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>'
                         % (esc(r.get("rolname", "")), esc(r.get("datname", "")),
                            esc(r.get("param", "")), esc(r.get("value", ""))))
    parts.append('</table>')
    # ================= OS Kernel Parameters =================
    # curated sysctl set captured as vastbase (unreadable/absent entries were
    # filtered at collection); single Value column from END, a mid-window
    # change shows as "old -> new"
    def _sysctl_map(txt):
        out = {}
        for ln in (txt or "").splitlines():
            if "|" in ln:
                k, v = ln.split("|", 1)
                out[k.strip()] = v.strip()
        return out
    _syb = _sysctl_map(win["os"].get(("begin", "sysctl"), ""))
    _sye = _sysctl_map(win["os"].get(("end", "sysctl"), ""))
    if _sye or _syb:
        sec("OS Kernel Parameters", fold=True)
        parts.append('<table class="t"><tr><th>Parameter</th>'
                     '<th>Begin</th><th>End</th></tr>')
        for k in (list(_sye) + [x for x in _syb if x not in _sye]):
            parts.append('<tr><td>%s</td><td>%s</td><td>%s</td></tr>'
                         % (esc(k), esc(_syb.get(k, "-")), esc(_sye.get(k, "-"))))
        parts.append('</table>')
        _close_foldsec()

    _toc_html = ('<div class="toc" id="toc"><b>Contents</b><ul>' + "".join(
        '<li><a href="#%s">%s</a>%s</li>' % (_id, esc(t),
            ('<ul>%s</ul>' % "".join('<li><a href="#%s">%s</a></li>' % (cid, esc(ct))
                                     for ct, cid in ch)) if ch else "")
        for t, _id, ch in _toc) + '</ul></div>')
    parts.insert(_toc_pos, _toc_html)

    # ================= Footer =================
    _close_foldsec()
    parts.append('<div class="foot">Generated by vb_tool awr report &middot; '
                 'single-window report &middot; all values = window(end-begin) &middot; '
                 '% DB time = metric / DB_TIME.</div>')
    parts.append('</body></html>')

    htmls = "".join(parts)
    if out_html:
        os.makedirs(os.path.dirname(os.path.abspath(out_html)), exist_ok=True)
        with open(out_html, "w") as f:
            f.write(htmls)
        print("  report : %s" % out_html)
    else:
        sys.stdout.write(htmls)


def render_awrdiff(win1, win2, metric, top_n, out_html):
    """AWR-style DIFF report: Period 1 vs Period 2. Each period is a
    build_window_from_snaps() result (its own end-begin delta). Every metric =
    P1 | P2 | delta (delta = P2-P1; %Diff where sensible). Mirrors render_single_awr
    sections. metric unused (all 6 SQL orderings shown)."""
    CSS_AWR = """
