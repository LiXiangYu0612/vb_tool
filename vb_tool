                max_param_types_html = html.escape(_prepare_param_types(qry_text_full, stat.get('qry_params', '')), quote=True)
                max_prepared_btn = f"<button class='copy-btn' data-query-template=\"{qry_text_html}\" data-param-types=\"{max_param_types_html}\" data-execute-stmt=\"{max_execute_html}\" onclick=\"generatePreparedStatement(this)\">生成 Prepared</button>"

            # sqlhc 下载按钮：有数据（--detail）才生成，无数据则隐藏
            sqlhc_content = sqlhc_data.get(str(unique_id).strip(), '')
