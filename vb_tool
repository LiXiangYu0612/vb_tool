                                  -v dq=$((i_nc - prev_nc)) -v dc=$((i_xc - prev_xc)) \
                                  -v dr=$((i_xr - prev_xr)) -v ddl=$((i_dl - prev_dl)) \
                                  -v dg=$((i_br - prev_br + i_bh - prev_bh)) -v dp=$((i_br - prev_br)) \
                                  -v dlsn=$((i_lsn - prev_lsn)) -v dtp=$((i_tb - prev_tb)) \
                                  -v dpw=$((i_pw - prev_pw)) 'BEGIN{
                                  printf "%.0f %.0f %.0f %.0f %d %d %d %d %d",
                                      dq*1000/w, dc*1000/w, dr*1000/w, ddl*1000/w,
                                      dg*8000.0/w*1.024, dp*8000.0/w*1.024, dlsn*1000/w, dtp*8000.0/w*1.024, dpw*8000.0/w*1.024 }')"
                              # pagewrite: pagewriter 累计刷页数的间隔增量,再 ×8192 转字节
                              # (与 logical/physical 同口径;也即 AWR join 里的 pages × BLCKSZ 8K)
                              # deadlocks/s (user's call 2026-09-28): plain counter delta,
                              # same sampling-interval convention as every other rate here
                              # values carry NO /s: the labels already say it (and the OS block
                              # never doubled it -- fault/s shows a bare number)
                              ist_qps=$_qps; ist_cm=$_cm; ist_roll=$_rb; ist_tps=$(( _cm + _rb ))
                              ist_lg="$(_vtop_fmt_b $_lg)"; ist_ph="$(_vtop_fmt_b $_ph)"
                              ist_rd="$(_vtop_fmt_b $_rd)"; ist_tp="$(_vtop_fmt_b $_tp)"
                              ist_pw="$(_vtop_fmt_b $_pw)"; ist_dl=$_dl
                          else
                              # ★守卫失败帧清空 (2026-10-10 补): 注释一直声称"本帧全 '-'",
                              # 但 ist_* 只在守卫通过时赋值 ⇒ 重启/reset 那帧会**沿用上一帧
                              # 的旧速率**看着像实时(===EOD 哨兵注释点名要防的同一类
                              # 陈旧数据)。清空后渲染端 ${ist_*:--} 自然打 '-'。
                              ist_qps=""; ist_cm=""; ist_roll=""; ist_tps=""
                              ist_lg=""; ist_ph=""; ist_rd=""; ist_tp=""; ist_pw=""; ist_dl=""
                          fi
                          # roll the baselines ONLY on a non-empty ISTAT row: a
                          # timed-out/empty segment must not wipe them (an empty
                          # prev made the NEXT collect's guard fail on empty
                          # strings -> a '-' chain until fresh baselines built)
                          if [ -n "$i_lsn" ]; then
                              prev_xc=$i_xc; prev_xr=$i_xr; prev_br=$i_br; prev_bh=$i_bh; prev_tb=$i_tb; prev_lsn=$i_lsn; prev_nc=$i_nc; prev_pw=$i_pw; prev_dl=$i_dl
                              prev_ist_ms=$t1
                          fi;;
                    XLOG) IFS='|' read -r x_cur x_ckr x_old x_cbm x_cnt x_sz x_rest x_arch <<< "$line";;
                    REPL) IFS='|' read -r r_app r_state r_sync r_sent r_wr r_fl r_rp r_slot <<< "$line"
                          # ★LSN 四列按"每秒推进量"显示(user's call 2026-09-26),与全帧其它速率列同口径;
                          # 四个 lag 仍为瞬时值,由当前位点相减得到。首帧无基线 ⇒ 全 '-'
                          # ★窗口 = prev_rp_ms(本段基线盖章)→本帧 (2026-11-16 终版):
                          # 四列统一, 替代 dbdt(上次采集尝试时刻差——断库恢复帧会拿
                          # ~interval 窗口除整个断档的 delta, 一帧 N 倍虚高);
                          # 过期规则统一走 _vtop_lim_ms (q=2 同 ISTAT 段的最坏帧墙钟)。
                          rp_w=0
                          [ "$prev_rp_ms" -gt 0 ] && [ "$t1" -gt "$prev_rp_ms" ] && rp_w=$(( t1 - prev_rp_ms ))
                          rp_wmax=$(_vtop_lim_ms "$interval" 2)
                          [ "$rp_w" -gt "$rp_wmax" ] && rp_w=0
                          # ★四个 lag 是**当前行瞬时差**, 不需要基线 (2026-11-16 复核修):
                          # 原来困在速率守卫里, 首帧/ESC 返回/断库恢复帧会连 lag 一起
                          # 清成 '-' —— 恰恰是用户盯着看延迟的时刻; 子屏 REPL 一直就是
                          # 无基线也渲染 lag 的, 主屏对齐。仅需本行值非空。
                          # ★四列全非空才算 (2026-11-17 独立复核): walsender startup/重连
                          #   态 sent 可用而 write/flush/replay 为 NULL, psql 空字段进 bash
                          #   算术按 0 ⇒ net_lag/total_lag = 整个 WAL 偏移的假延迟、r_fs
                          #   负值被 fmt_b 钳 0B 假追平。子屏同位置走 _vtop_delta, 这里对齐。
                          if [ -n "$r_sent" ] && [ -n "$r_wr" ] && [ -n "$r_fl" ] && [ -n "$r_rp" ]; then
                              r_net=$(( r_sent - r_wr )); r_fs=$(( r_wr - r_fl ))
                              r_ap=$(( r_fl - r_rp )); r_tot=$(( r_sent - r_rp ))
                          fi
                          if [ -n "$prev_rsent" ] && [ -n "$r_sent" ] && [ -n "$r_wr" ] && [ -n "$r_fl" ] && [ -n "$r_rp" ] && [ "$rp_w" -gt 0 ] 2>/dev/null; then
                              r_dsent=$(( (r_sent - prev_rsent) * 1000 / rp_w ))
                              r_dwr=$(( (r_wr - prev_rwr) * 1000 / rp_w ))
                              r_dfl=$(( (r_fl - prev_rfl) * 1000 / rp_w ))
                              r_drp=$(( (r_rp - prev_rrp) * 1000 / rp_w ))
                              # 备库切换/重启: 位点可倒退, 负 delta 钳 0 (对齐 _vtop_delta;
                              #   2026-11-17 起基线不再被 n_repl=0 清, 此钳是倒退防线)
                              [ "$r_dsent" -lt 0 ] && r_dsent=0
                              [ "$r_dwr" -lt 0 ] && r_dwr=0
                              [ "$r_dfl" -lt 0 ] && r_dfl=0
                              [ "$r_drp" -lt 0 ] && r_drp=0
                          fi
                          # ★基线只在行值非空时滚动 (2026-11-16 复核修, 对齐 ISTAT 段):
                          # walsender 重连/startup 态某帧 LSN 列可为 NULL, 无条件滚动
                          # 会把 prev 写成空串, 下一帧守卫 [ -n ] 失败多空一帧。
                          # ★基线四列全非空才滚动 (2026-11-17 复核): 只守 sent 会把部分
                          #   NULL 的行写进 prev, 下一帧守卫失败多空一帧。
                          if [ -n "$r_sent" ] && [ -n "$r_wr" ] && [ -n "$r_fl" ] && [ -n "$r_rp" ]; then
                              prev_rsent=$r_sent; prev_rwr=$r_wr; prev_rfl=$r_fl; prev_rrp=$r_rp
                              prev_rp_ms=$t1
                          fi;;
                    DBM)  IFS='|' read -r m_used m_max m_shmax m_shused m_dyu m_dym m_dyp m_shr m_shrp m_other m_sbuf <<< "$line";;
                    WAIT) IFS='|' read -r w_io w_lock w_lwlock w_stat w_cpu <<< "$line";;
                    CTX)  ctx_txt="$line";;
                    LKA)  IFS='|' read -r lk_chains lk_blocked lk_w_rel lk_w_xid lk_w_vxid lk_w_tuple lk_w_part <<< "$line";;
                    LWL)  lwl_txt="$line";;   # 已由 SQL 用 ';' 拼好的一整行 (同 CTX 的写法)
                    BLK)  blk_raw="${blk_raw}${line}"$'\n';;
                    LTX)  ltx_raw="${ltx_raw}${line}"$'\n';;
                    LTXC) IFS='|' read -r ltxc_a ltxc_i <<< "$line";;   # active_ltx / idle_tx_ltx 计数
                    MEMSES) IFS='|' read -r ms_sid ms_styp ms_st ms_sz ms_sql <<< "$line"
                            printf '           %-14s %-22s %-8.8s %-9s %.62s\n' "$ms_sid" "$ms_styp" "$ms_st" "$ms_sz" "$ms_sql"
                            n_mem=$((n_mem+1));;
                    TOP)  IFS='|' read -r r_sqlid r_cpu r_ns r_rn r_et r_sql <<< "$line"
                          local sql_col=""
                          awk -v c="$r_cpu" 'BEGIN{exit !(c>=90)}' && sql_col=$c_red
                          printf '%s' "$sql_col"
                          printf '           %-11s %-15s %-10s %-13s %.82s\n' "$r_sqlid" "$r_rn" "${r_cpu}%" "$r_et" "$r_sql"
                          printf '%s' "$c_off"
                          n_top=$((n_top+1));;
                esac
            done <<< "$db"
            # ★REPL 段被 12s 帧截止砍掉 (只发标记无行) 与"真没备库"(掉线/槽删)不可区分
            #   —— 旧代码在这里连基线一起清, 慢库上 REPL 四列永久 '-' 而 ISTAT 正常
            #   (2026-11-17 独立复核)。对齐 ISTAT 段既立规矩: 空段不擦基线。假 sent/s 由过期守卫挡
            #   (prev_rp_ms 太旧 ⇒ rp_w > rp_wmax ⇒ 速率跳过、下一帧重锚), 备库切换的
            #   倒退 delta 由速率块新加的负钳挡; 真清基线只剩 ESC 回主屏一条路。
            # ★no TOP SQL rows this frame -> keep the header's column structure readable with a
            # "-" row (user's call 2026-09-26, same rule as LTX/LOCK). TOPMEM gets the same
            # treatment at the ===TOP marker above, because its rows have to be flushed
            # BEFORE the TOPSQL header is printed.
            [ "${n_top:-0}" -eq 0 ] && printf '           %-11s %-15s %-10s %-13s %.82s\n' "-" "-" "-" "-" "-"
            # ★LOCK is a 2-line SUMMARY (user's call 2026-09-26: "能不能打印一个总览??
            # 主屏这边尽量控制在 2 行"). The per-session blocker chain used to print 1+N
            # rows -- the ONLY unbounded section in the frame -- and moves to a sub-screen.
            # ★lock_chains / blocked / wait_xid_lock / wait_regular_lock come from
            # ===LKA (2026-09-26):
            # chains = final blockers, 1:1 with blocking chains, EXACT -- ===BLK below is
            # still the source of max_blocker_time / max_blocker_sid but capped at LIMIT 5; blocked =
            # distinct sessions holding an ungranted pg_locks row ("请求不到");
            # wait_xid_lock / wait_regular_lock split those by locktype (transactionid
            # 行锁 vs 常规锁 rest); "regular" is spelled out (user's call 2026-09-26:
            # "写常规锁写全称吧") -- no "reg" abbreviation in the frame.
            local lk_max=0 lk_bsid="-" lk_btime="-"
            local k_lvl k_st k_sid k_usr k_blk k_age k_sql
            while IFS='|' read -r k_lvl k_st k_sid k_usr k_blk k_age k_sql; do
                [ -z "$k_sid" ] && continue
                # ===BLK returns ROOT blockers only (WHERE lvl = 0, top 5); its age_s is
                # the ROOT's own xact age -- the only thing still taken from here.
                # ★max_blocker_* (user's call 2026-09-27): the value is the ROOT
                # BLOCKER's xact age and the sid the BLOCKER's, so the field names say
                # blocker -- max_wait_time/longest_wait_sid read as the waiter's wait,
                # which this never was (waiter wait <= blocker xact age).
                if [ "${k_age:-0}" -gt "$lk_max" ] 2>/dev/null; then lk_max=${k_age:-0}; lk_bsid="$k_sid"; fi
            done <<< "$blk_raw"
            if [ "$lk_max" -gt 0 ] 2>/dev/null; then
                lk_btime=$(awk -v s="$lk_max" 'BEGIN{d=int(s/86400);h=int(s%86400/3600);m=int(s%3600/60);ss=s%60; if(d>0)printf "%dd%02dh",d,h; else if(h>0)printf "%dh%02dm",h,m; else if(m>0)printf "%dm%02ds",m,ss; else printf "%ds",ss}')
            fi
            # LKA always emits one row; "-" here means the query never ran (db unreachable)
            # ★按 locktype 细分 (用户 2026-09-28): 取代原来的 wait_xid_lock/wait_regular_lock
            #   两分法, 也取代了中途试过的"动态 top-5"(那样空闲时一列都不出, 看不出改过)。
            #   现在 = **固定五列** rel/xid/vxid/tuple/partition 的等待会话数, **恒写**(0 也显示);
            #   短名按用户点名(transactionid→xid、virtualxid→vxid)。
            #   宽度: 五列约 +67 ⇒ 这行约 133/148, 仍在框内。
            _vtop_lv LOCK "" \
                "lock_chains|${lk_chains:--}" "blocked|${lk_blocked:--}" \
                "wait_rel|${lk_w_rel:-0}" "wait_xid|${lk_w_xid:-0}" "wait_vxid|${lk_w_vxid:-0}" \
                "wait_tuple|${lk_w_tuple:-0}" "wait_partition|${lk_w_part:-0}" \
                "max_blocker_time|$lk_btime" "max_blocker_sid|$lk_bsid"
            # ★[LWLOCK] sits directly under [LOCK] (user's call 2026-09-26/27): the TOP-5
            # LWLock wait events by waiting SESSION count, MEMCTX-style -- the label row
            # carries the event names, the value row the counts, so N waiters render as
            # N columns, up to 5 (user: "有一个就只有一列，有两个就两列，有三个就三列" →
            # 2026-09-27: "列前5多的会话数的event吧 感觉写的下").
            # Width: 5 event names (≤ ~20 cols each) + gutter stays far inside _vtop_w.
            # ★instantaneous, not cumulative (user: "瞬时刷新值"): ===LWL reads the live
            # wait status of active sessions. ★no waiters at all -> one "NONE" field
            # (user: "没有就显示NONE"); the 2-row shape is kept so the frame height
            # never moves with the data.
            local _lwl
            if [ -n "$lwl_txt" ]; then
                IFS=';' read -r -a _lwl <<< "$lwl_txt"
                _vtop_lv LWLOCK "" "${_lwl[@]}"
            else
                # '-' rather than a second NONE: the label says there is no event, and
                # '-' is this frame's marker for "no value to show" (greyed by _vtop_lv).
                _vtop_lv LWLOCK "" "NONE|-"
            fi
        fi
        } > "$_vtop_f"
        # cache the DATA tail (banner onward, NO notice/hint lines: the
        # interactive zone is appended per-frame below -- baking it into the
        # cache would double-print HINT and replay one-frame notices for a
        # whole -i window) for the OS-tick frames
        awk '/VASTBASE Statistics/{f=1} f{print}' "$_vtop_f" > "$_vtop_dbcache" 2>/dev/null
        db_dirty=0
        fi
        # per-frame interactive zone (both full and compact frames append it)
        # ★_vtop_notice_on (2026-11-17 三轮复核): 本帧印了通知就立旗 —— 通知只活一帧,
        #   但它印在 HINT 上方; 下一次方向键快刷只重写 HINT 两行, 旧通知会残留在屏上。
        #   快刷路径见旗就退回整帧 (整帧把旧行清干净)。
        if [ -n "$_vtop_notice" ]; then _vtop_notice_on=1; else _vtop_notice_on=0; fi
        if [ "$interactive" = "1" ]; then
            { [ -n "$_vtop_notice" ] && printf '%s\n' "$_vtop_notice"
              _vtop_keys_hint "$screen"; } >> "$_vtop_f"
        fi
        _vtop_notice=""          # a notice lives exactly one frame
        _vtop_print_frame "$_vtop_f"
        _last_work_ms=$(( $(date +%s%3N) - t1 ))   # 主屏帧工作量: t1(帧构建起点, 含 OS 采样/采集)→出屏
        [ "$once" = "1" ] && break
        t0=$t1; d0=$d1; c0=$c1; n0=$n1; p0=$p_cur; g0=$g_cur; v0=$v1
    done
    rm -f "$_vtop_f" "$_vtop_dbcache"
    # ★进程级状态还原 (2026-11-17 复核, 安装处有完整注释): 先做一次自己的清理
    #   (idempotent), 再把 7 个 trap 复位成进入前的样子, umask 也还回去。信号路径
    #   不在这里 —— 那些路径直接 exit, 由 trap 自己收尾。
    _vtop_cleanup
    _vtop_stty=""; _vtop_f=""
    trap - EXIT INT TERM HUP QUIT TSTP CONT
    [ -n "${_vtop_traps_bak:-}" ] && eval "$_vtop_traps_bak"
    [ -n "${_vtop_umask_bak:-}" ] && umask "$_vtop_umask_bak"
    return 0
}

# ---- global -P <port>: multi-instance support (all database commands) ------
# Resolved ONCE here (before dispatch) and exported as PGPORT for this process
# only: every child psql/psql connection inherits it; nothing persists after
# the run. Without -P the current $PGPORT environment variable applies
# (libpq's built-in 5432 is reached only when PGPORT is unset).
# NOTE: keep this block OUTSIDE the awr region (above its header): the awr
# build/merge chain replaces [awr header .. column-0 'case "$1" in'] verbatim.
_vb_port_args=()
while [ $# -gt 0 ]; do
    case "$1" in
        -P)
            if [ $# -lt 2 ] || ! printf '%s' "${2:-}" | grep -qE '^[0-9]+$' || [ "${2:-}" -lt 1 ] || [ "${2:-}" -gt 65535 ]; then
                echo "Error: -P expects a port number (1-65535), e.g. -P 5433" >&2
                exit 2
            fi
            export PGPORT="$2"; shift 2;;
        -P[0-9]*)
            _vb_p="${1#-P}"
            if ! printf '%s' "$_vb_p" | grep -qE '^[0-9]+$' || [ "$_vb_p" -lt 1 ] || [ "$_vb_p" -gt 65535 ]; then
                echo "Error: -P expects a port number (1-65535), e.g. -P 5433" >&2
                exit 2
            fi
            export PGPORT="$_vb_p"; shift
            unset _vb_p;;
        *)
            _vb_port_args+=("$1"); shift;;
    esac
done
set -- ${_vb_port_args[@]+"${_vb_port_args[@]}"}
unset _vb_port_args

# ================== se: show-event knowledge base (oerr style) ==================
# vb_tool se <event>     exact match -> unique substring -> candidate list;
#                        prints the FULL event name, type, meaning, kernel
#                        source trigger points, wait causes and fixes.
# vb_tool se -l [<kw>]   list events (optional substring filter).
# The knowledge base lives at the bottom of this file as a gzip+base64
# comment block (#@@KB markers + #K lines) -- run_se decodes it on demand,
# so the 450 KB of plain text costs ~185 KB in the shipped script and adds
# zero startup cost for other commands. Editable source of truth:
# vb_tool_baseline/se_kb.txt (plain) -> re-embed via the assembler.
# Grounded in the openGauss 6.0.0 kernel source; fully offline. This block
# sits BEFORE the awr region so resync leaves it alone.
se_help() {
    cat <<'EOF'
Usage: vb_tool se <event_name>       explain one wait event (oerr style)
       vb_tool se -l [<keyword>]     list events (optional substring filter)

  Wait-event knowledge base (417 events of dbe_perf.wait_events: LOCK /
  IO / STATUS / LWLOCK families): full event name, type, meaning,
  kernel-source trigger points, why sessions wait on it, and what to do.
  Matching is case-insensitive: exact name first, then unique substring
  (e.g. se procarray resolves ProcArrayLock, se walwritelock the WAL lock);
  ambiguous or unknown input lists candidates and hints.
  Fully offline -- nothing touches the database.
EOF
}

run_se() {
    local mode="show" q=""
    if [ "$1" = "-l" ] || [ "$1" = "--list" ]; then
        mode="list"; shift
    fi
    q="$1"
    if [ -z "$q" ] && [ "$mode" != "list" ]; then
        echo "Error: se needs an event name (vb_tool se procarray) or -l" >&2
        return 2
    fi
    _se_kb_dump | awk -v q="$q" -v mode="$mode" '
    function lc(s) { return tolower(s) }
    function stripped(s) { gsub(/[^a-z0-9]/, "", s); return s }
    function show(i) {
        printf "Event:    %s\n", name[i]
        printf "Type:     %s\n", type[i]
        printf "Meaning:  %s\n", desc[i]
        printf "Triggers: (openGauss 6.0.0 source sites)\n"
        pr_body(body[i, "trig"])
        printf "Why:\n"
        pr_body(body[i, "cause"])
        printf "Fix:\n"
        pr_body(body[i, "fix"])
    }
    function pr_body(s) {
        if (s == "") { printf "  (none)\n"; return }
        m = split(s, L, "\n")
        for (k = 1; k <= m; k++) if (L[k] != "") printf "  %s\n", L[k]
    }
    {
        line = $0
        sub(/^# ?/, "", line)
        if (line ~ /^@@NAME@@ /) {
            n++; name[n] = substr(line, 10); f = ""
        } else if (line ~ /^@@TYPE@@ /) { type[n] = substr(line, 10); f = "" }
        else if (line ~ /^@@DESC@@ /) { desc[n] = substr(line, 10); f = "" }
        else if (line == "@@TRIG@@")  { f = "trig" }
        else if (line == "@@CAUSE@@") { f = "cause" }
        else if (line == "@@FIX@@")   { f = "fix" }
        else if (line == "@@END@@")   { f = "" }
        else if (f != "" && n > 0)    { body[n, f] = body[n, f] line "\n" }
    }
    END {
        if (mode == "list") {
            cnt = 0
            for (i = 1; i <= n; i++) if (!(name[i] in seen2) && (q == "" || index(lc(name[i]), lc(q)) > 0)) {
                seen2[name[i]]
                printf "  %-44s [%s]\n", name[i], type[i]; cnt++
            }
            if (q == "") printf "\n  %d event(s) in the knowledge base\n", cnt
            else         printf "\n  %d event(s) matched [%s]  (vb_tool se <name> for details)\n", cnt, q
            exit 0
        }
        qq = lc(q)
        for (i = 1; i <= n; i++) if (lc(name[i]) == qq) { show(i); exit 0 }
        h = 0
        for (i = 1; i <= n; i++) if (index(lc(name[i]), qq) > 0) { h++; hi = i }
        if (h == 1) { show(hi); exit 0 }
        if (h > 1) {
            printf "Error: [%s] matches %d events -- pick one:\n\n", q, h
            c = 0
            for (i = 1; i <= n; i++) if (index(lc(name[i]), qq) > 0 && c < 25) {
                printf "  %-44s [%s]\n", name[i], type[i]; c++ }
            if (h > 25) printf "  ... (%d more)\n", h - 25
            printf "\n  usage: vb_tool se <full_event_name>\n"
            exit 1
        }
        sq = stripped(qq); ntok = split(qq, tok, /[^a-z0-9]+/)
        for (i = 1; i <= n; i++) {
            if (stripped(lc(name[i])) == sq) { show(i); exit 0 }
            ok = 1; nt = 0
            for (t = 1; t <= ntok; t++) if (length(tok[t]) >= 2) {
                nt++
                if (index(lc(name[i]), tok[t]) == 0) { ok = 0 }
            }
            if (nt > 0 && ok) { show(i); exit 0 }
        }
        printf "Error: no event matches [%s].\n\n", q
        c = 0
        for (i = 1; i <= n; i++) {
            for (t = 1; t <= ntok; t++) if (length(tok[t]) >= 3 && index(lc(name[i]), tok[t]) > 0) {
                printf "  %-44s [%s]\n", name[i], type[i]; c++; break }
            if (c >= 10) break
        }
        if (c > 0) printf "\n  similar event(s) above -- maybe one of these?\n"
        printf "  hint: list all events:  vb_tool se -l    (filter: vb_tool se -l wal)\n"
        printf "  examples: vb_tool se procarray | se walwritelock | se transactionid | se Sort\n"
        exit 1
    }
    '
    return $?
}

# dump the embedded knowledge base: sed-extract the #K block from this very
# script, drop the comment prefix, then base64+gunzip back to plain text.
_se_kb_dump() {
    sed -n '/^#@@KB-START@@/,/^#@@KB-END@@/p' "$0" \
        | sed -e '1d;$d' -e 's/^#K //' \
        | base64 -d 2>/dev/null | gzip -dc 2>/dev/null
}

# ================== awr management (v1) ==================
#
# Oracle-style single-point performance snapshots. Each `awr create` captures one
# instantaneous OS+DB sample (a "snap") tagged with a monotonic snap_id. A report
# (`awr awrrpt`) is the cumulative-counter delta between two snaps (end - begin),
# like an AWR single-period report. Periodic capture via `awr enable` (crontab).

awr_help() {
    cat <<'EOF'
Usage: vb_tool awr <create|enable|disable|awrrpt|awrdiff|baseline|topsql|event|summary|tabstat|cpu|io|page|mem|net|tcp|tcpstat|fd|replstat|replslot|replay|ltx|pagew|sqlhist|list|show|delete|config> [options]

  create  [--root <dir>]   one snapshot now, no html
  enable | disable         start/stop the crontab sampler (snapshot every
                           'config interval' min + per-minute OS/repl sampling);
                           enable -d <retention_days> -i <interval_min> -D <datadir>
                           (all optional: 8 days / 60 min / $HOME; -D moves existing data)
  awrrpt  begin <id> end <id> [awronly]
                           AWR html; paired log analysis by default, awronly skips
  awrdiff begin <a> end <b> begin <c> end <d>
                           3-col diff html (both windows equal-length)
  awrdiff begin <x> end <y> baseline <id>
                           current window vs baseline diff
  baseline begin <id> end <id> | info | report <id> | delete <id>
                           register / list / render / drop baselines
  topsql  begin <id> end <id> [-n N] [-m <dim>]
                           Top SQL on screen; dim = dbtime|cpu|io|plan|lreads|preads|memory|spill|calls|rows
  event   begin <id> end <id> [-E <event>]
                           top wait events; -E one event only
  summary begin <id> end <id>
                           one-line workload summary
  tabstat begin <id> end <id> -d <db> -s <schema> -t <table>
                           one table's window deltas (any database)
  cpu | io | page          begin <id> end <id> -- per-minute CPU / disk IO / paging
  mem | net                begin <id> end <id> -- per-minute memory level / per-NIC traffic
  tcpstat                  begin <id> end <id> -- per-minute TCP counters + RTT + accept queue (host L4)
  tcp                      begin <id> end <id> -- per-minute DB-port socket states + conntrack
  fd                       begin <id> end <id> -- per-minute postmaster fd buckets (dbfile/tempfile/xlog)
  replstat | replslot | replay
                           begin <id> end <id> -- per-minute replication / slots /
                           walreceiver samples
  ltx     begin <id> end <id>
                           per-5min long-transaction monitor
  pagew   begin <id> end <id>
                           per-5min pagewriter flush/dirty-page series
                           (R = restart: interval excluded from deltas)
  sqlhist <sql_id> begin <id> end <id>
                           one SQL's per-interval history
  list [YYYY-MM-DD]        list snapshots (newest first)
  show                     run status / interval / retention / snapshot overview
  delete until <time>      purge old snapshots + logs + reports
  config                   show retention / interval
  config retention <days> | interval <min>
                           set them
EOF

}

# _awr_root  -- per-PORT storage root: <VB_TOOL_HOME>/awrs/<port>/. Every awr
# subcommand (create/list/show/reports/purge/config) operates on the instance
# the CURRENT port points at (from $PGPORT, or -P which exports it), so several
# instances can run awr side by side without sharing snap_ids, config or logs.
# Migrates the pre-multi-instance flat layout once, under a lock.
# _awr_port_lockfile -- per-port advisory lock OUTSIDE any datadir (it must
# survive its own migration). CREATION/SAMPLING take a SHARED lock (they can
# run concurrently with each other); DATADIR MIGRATION takes EXCLUSIVE --
# closing the race where a cron create fires in the migration gap, recreates
# the OLD root and scatters data across roots (2026-11-01 incident on 204:
# snap history reset by repeated suite migrations racing the sampler).
_awr_port_lockfile() { echo "${VB_TOOL_HOME:-$HOME/.vb_tool}/awr_port_${PGPORT:-5432}.lock"; }
# _awr_datadir_* -- per-PORT data root overrides (user 2026-10-31, layout
# "A"): the override dir plays the $HOME role, everything under it keeps the
# exact default shape <dir>/.vb_tool/awrs/<port>/... The override table lives
# OUTSIDE any datadir (it must survive its own migration):
# $HOME/.vb_tool/awr_datadir, one "port|dir" line per override.
_awr_datadir_get() {   # -> override dir for the current port ("" = default)
    local f="${HOME}/.vb_tool/awr_datadir"
    [ -r "$f" ] && awk -F'|' -v p="${PGPORT:-5432}" '$1==p{print $2; exit}' "$f" 2>/dev/null
}
_awr_datadir_set() {   # _awr_datadir_set <port> <dir>   ("" clears the entry)
    local f="${HOME}/.vb_tool/awr_datadir" p="$1" d="$2"
    mkdir -p "${HOME}/.vb_tool" 2>/dev/null || return 1
    (
        flock -w 5 9 || exit 1
        # first write: the table file does not exist yet -- awk on a missing
        # input errors out (204 live bug: data moved, config write failed,
        # resolver left pointing at the old path); seed an empty file instead
        [ -f "$f" ] || : > "$f"
        awk -v p="$p" -v d="$d" 'BEGIN{FS=OFS="|"} $1!=p{print} END{if(d!="")print p "|" d}' \
            "$f" > "$f.new" && mv "$f.new" "$f"
    ) 9>"${f}.lock"
}
# _awr_datadir_migrate <dir|default> -- switch THIS port's data root. Fail
# hard (user order 2026-10-31): existing content is MOVED, not copied; any
# error (permission, unwritable target, non-empty target) aborts the command
# with the raw error and leaves the config untouched.
# Independent-review fixes (2026-10-31): F1 reject '|'/'\n' in the dir (the
# "port|dir" table would truncate the entry and orphan the moved data); F5
# normalize the path before comparing (trailing '/' made the same physical
# dir look like a foreign non-empty target); F2 "default" resolves through
# the no-override base (VB_TOOL_HOME-aware), never a raw
# $HOME, and CLEARS the override; an explicitly given dir equal to the
# default root still stores an explicit override (equivalent today, keeps
# working if VB_TOOL_HOME appears later);
# F7 a datadir-set failure after a successful mv rolls the mv back (no
# split-brain window); F9 relative path returns rc=1 (rc=2 dumps full help).
_awr_default_base() {   # per-port root the resolver uses with NO override
    echo "${VB_TOOL_HOME:-$HOME/.vb_tool}/awrs/${PGPORT:-5432}"
}
_awr_datadir_migrate() {
    local newhome="$1" port="${PGPORT:-5432}"
    # EXCLUSIVE port lock: no snapshot/sampler may resolve-and-write while
    # the root moves underneath them (they wait, then resolve to the NEW root)
    local _plock; _plock=$(_awr_port_lockfile)
    mkdir -p "$(dirname "$_plock")" 2>/dev/null
    exec 8>"$_plock"
    if ! flock -w 30 -x 8; then
        echo "Error: cannot acquire the port lock ($_plock) -- a snapshot or sampler is mid-run; retry shortly" >&2
        return 1
    fi
    [ "$newhome" = "default" ] && newhome=""
    if [ -n "$newhome" ]; then
        case "$newhome" in
            /*) ;;
            *)  echo "Error: datadir must be an absolute path (got '$newhome')" >&2; return 1;;
        esac
        case "$newhome" in
            *'|'*|*$'\n'*|*$'\r'*|*'\'*)
                echo "Error: datadir must not contain '|', newlines, carriage returns or backslashes (config table format; backslash paths break the table encoding)" >&2; return 1;;
        esac
        # F5: normalize trailing slashes so /data3 and /data3/ compare equal
        while [ "${#newhome}" -gt 1 ] && [ "${newhome: -1}" = "/" ]; do
            newhome="${newhome%/}"
        done
    fi
    local old_root; old_root=$(_awr_root)
    local new_root
    if [ -n "$newhome" ]; then
        new_root="$newhome/.vb_tool/awrs/$port"
    else
        new_root=$(_awr_default_base)   # F2: VB_TOOL_HOME-aware default
        newhome=""                      # clear-the-override semantics
    fi
    if [ "$old_root" = "$new_root" ]; then
        echo "awr: datadir for port $port already $new_root"
        return 0
    fi
    if [ -e "$new_root" ]; then
        if [ -n "$(ls -A "$new_root" 2>/dev/null)" ]; then
            echo "Error: target $new_root already exists and is not empty -- resolve it manually first" >&2
            return 1
        fi
        rmdir "$new_root" 2>/dev/null || { echo "Error: cannot clear empty target $new_root" >&2; return 1; }
    fi
    local had_data=0
    if [ -d "$old_root" ] && [ -n "$(ls -A "$old_root" 2>/dev/null)" ]; then
        had_data=1
        mkdir -p "$(dirname "$new_root")" 2>/dev/null
        if ! mv "$old_root" "$new_root" 2>"${TMPDIR:-/tmp}/vb_tool_awr_mv.err"; then
            echo "Error: moving $old_root -> $new_root failed: $(cat "${TMPDIR:-/tmp}/vb_tool_awr_mv.err" 2>/dev/null)" >&2
            rm -f "${TMPDIR:-/tmp}/vb_tool_awr_mv.err"
            return 1
        fi
        rm -f "${TMPDIR:-/tmp}/vb_tool_awr_mv.err"
    else
        mkdir -p "$new_root" 2>/dev/null || { echo "Error: cannot create $new_root (permission?)" >&2; return 1; }
    fi
    if ! _awr_datadir_set "$port" "$newhome"; then
        echo "Error: cannot write the datadir config" >&2
        if [ "$had_data" -eq 1 ]; then
            # F7: roll the mv back -- config unchanged, data back in place,
            # no split-brain window where data and config disagree. N6: only
            # claim success when the rollback really landed, and never blind-
            # mv into an old_root that something (e.g. this port's cron firing
            # in the failure window) recreated meanwhile -- that would nest
            # the whole tree one level deep.
            if [ -e "$old_root" ]; then
                echo "       (rollback skipped: $old_root reappeared during the failure -- resolve manually; data is at $new_root)" >&2
            elif mv "$new_root" "$old_root" 2>/dev/null; then
                echo "       (data rolled back to $old_root)" >&2
            else
                echo "       (rollback FAILED -- data is at $new_root, config unchanged; move it manually)" >&2
            fi
        fi
        return 1
    fi
    local note=""
    [ "$had_data" -eq 1 ] && note=" (existing data moved)"
    # F4: a datadir switch must not leave old-form crontab entries pointing
    # at the interval file that just moved away -- reinstall in gated form
    # N4: a heal failure must be HEARD (warn; the switch itself succeeded).
    # Three-state (round-3 F-1): rc=3 means "no entries, not enabled" -- a
    # NORMAL state that must stay silent, never a warning
    _awr_cron_ensure_gated "$port"
    _hrc=$?
    [ "$_hrc" -eq 1 ] && echo "Warning: crontab entry heal failed after the datadir switch -- the old cadence may persist; run 'awr config interval <min>' to retry" >&2
    if [ -z "$newhome" ]; then
        echo "awr: port $port datadir reset to default $new_root$note"
    else
        echo "awr: port $port datadir -> $new_root$note"
    fi
    return 0
}
_awr_root() {
    local _awrh; _awrh=$(_awr_datadir_get)
    local base
    if [ -n "$_awrh" ]; then base="$_awrh/.vb_tool/awrs"
    else base="${VB_TOOL_HOME:-$HOME/.vb_tool}/awrs"; fi
    local port="${PGPORT:-5432}"
    local root="$base/$port"
    if [ -d "$base" ] && [ ! -d "$root" ] && ls "$base"/snap_* >/dev/null 2>&1; then
        (
            flock -n 9 || exit 0
            [ ! -d "$root" ] && ls "$base"/snap_* >/dev/null 2>&1 || exit 0
            mkdir -p "$root"
            mv "$base"/snap_* "$base"/sequence "$base"/retention "$base"/interval \
               "$base"/repl_*.log "$base"/slot_*.log "$base"/os_*.log "$base"/os_*.log.gz \
               "$base"/walrcv_*.log "$base"/lt_*.log "$base"/lt_*.log.gz \
               "$base"/pw_*.log "$base"/stack_*.log "$base"/stack_*.log.gz \
               "$base"/sessmem_*.log "$base"/sessmem_*.log.gz "$root"/ 2>/dev/null
            echo "awr: migrated existing snapshots/config into per-port layout $root" >&2
        ) 9>"$base/.migrate.lock"
    fi
    echo "$root"
}

# _awr_cron_ensure_gated <port> -- (re)install THIS port's two crontab
# entries in the path-free gated form; rc: 0=rewritten, 3=no entries (not
# enabled -- crontab untouched), 1=rewrite failed, removing any old-form (baked interval
# path) or legacy port-less entries first. Under the SAME cross-port crontab
# lock as enable/disable (independent review F10: the old inline rewriter in
# 'config interval' was an unlocked read-check-write). Anchored marker
# matches only THIS port (port 5432 no longer strips 54321's entries).
_awr_cron_ensure_gated() {
    local cport="$1"
    local _ctlock="${VB_TOOL_HOME:-$HOME/.vb_tool}/awr_crontab.lock"
    mkdir -p "${VB_TOOL_HOME:-$HOME/.vb_tool}" 2>/dev/null
    (
        flock -w 30 9 || { echo "Error: cannot acquire $_ctlock" >&2; exit 1; }
        crontab -l 2>/dev/null | grep -qE "# vb_tool_awr_repl_p${cport}\$" \
            || crontab -l 2>/dev/null | grep -qE "# vb_tool_awr_p${cport}\$" \
            || crontab -l 2>/dev/null | grep -qE '# vb_tool_awr(_repl)? *$' || exit 3
        # rc: 3 = no awr entries for this port (not enabled) -- crontab
        # untouched, callers stay silent (round-2 N1: claiming "ensured"
        # on a disabled port misled users into thinking capture was on)
        local self; self=$(readlink -f "$0" 2>/dev/null || echo "$0")
        local entry="* * * * * /bin/bash -lc 'PGPORT=$cport $self awr _gated-create >/dev/null 2>&1'  # vb_tool_awr_p$cport"
        local rentry="* * * * * /bin/bash -lc 'PGPORT=$cport $self awr _repl-sample >/dev/null 2>&1'  # vb_tool_awr_repl_p$cport"
        if ! ( crontab -l 2>/dev/null | grep -vE "# vb_tool_awr_repl_p${cport}\$" | grep -vE "# vb_tool_awr_p${cport}\$" | grep -vE '# vb_tool_awr(_repl)? *$'; echo "$rentry"; echo "$entry" ) | crontab -; then
            echo "Error: failed to rewrite crontab entries (permissions or disk?)" >&2
            exit 1
        fi
    ) 9>"$_ctlock"
}
# _awr_gated_create -- crontab entry body (2026-10-31): the OLD entry baked
# the interval file's full path into cron, so a datadir switch silently broke
# interval changes (cron kept reading the old path, modulo fell back to 60).
# The gate resolves the CURRENT root at runtime; cron lines carry no path.
_awr_gated_create() {
    local r; r=$(_awr_interval_read)
    case "$r" in ''|0|*[!0-9]*) r=60;; esac
    [ $(( $(date +%s) / 60 % r )) -eq 0 ] || return 0
    _awr_create
}
# _awr_next_id  -- atomically allocate and return the next snap_id.
# Maintains <root>/sequence (= next id). Concurrent-safe via flock (util-linux).
_awr_next_id() {
    local root; root=$(_awr_root)
    mkdir -p "$root" 2>/dev/null || { echo "Error: cannot create $root" >&2; return 1; }
    local seq="$root/sequence"
    local cur
    cur=$( (
        # NB: the 9> redirect must wrap the subshell -- a redirect on the
        # assignment itself never reaches inside $( ) (bash expands first)
        flock 9
        v=$(cat "$seq" 2>/dev/null)
        case "$v" in ''|*[!0-9]*) v=1;; esac
        echo $((v + 1)) > "$seq"
        echo "$v"
    ) 9>"$seq.lock" )
    [ -z "$cur" ] && { echo "Error: snap_id allocation failed" >&2; return 1; }
    echo "$cur"
}

# _awr_collect <target_dir>  -- single-point snapshot into target/{os,db}.
# (Renamed from _awr_collect_window <target> <phase>; phase dropped: files live
#  directly under os/ and db/, no begin/end subdir.)
_awr_collect() {
    local target="$1"
    local osd="$target/os" dbd="$target/db"
    mkdir -p "$osd" "$dbd" || { echo "  [ERROR] cannot mkdir $osd / $dbd" >&2; return 1; }
    # ---- OS (/proc) ----
    # seq_file reads are kernel-side iteration and CAN block on real boxes
    # (irq_desc locks under handler storms / old-kernel O(n^2) restart on
    # many-core+many-irq machines -- the historical 'workload 卡' root cause,
    # user 2026-10-31): bound every /proc copy so one wedged file can never
    # stall the whole snapshot loop. -k: TERM at 10s, KILL at +2s.
    local f
    for f in diskstats stat interrupts softirqs meminfo cpuinfo vmstat loadavg; do
        if [ -r "/proc/$f" ]; then
            # L-6 (round-4): a killed cp leaves a HALF file whose numbers look
            # plausible -- remove it so the renderer degrades instead of lying
            timeout -k 2 10 cp "/proc/$f" "$osd/$f" 2>/dev/null \
                || { rm -f "$osd/$f"; echo "  [WARN] /proc/$f copy timed out or failed (partial removed)" >&2; }
        else
            echo "  [WARN] /proc/$f not readable" >&2
        fi
    done
    # irqbalance only (2026-10-30; affinity mask collection DROPPED, user
    # order 2026-10-31: /proc/irq/*/[smp_]affinity* are root-only on this OS
    # family (204 openEuler verified 0600, plain smp_affinity included) and
    # the awr collector always runs as the non-root DB user -- confirmed
    # unreadable, so don't collect. File keeps its historical name for old
    # snaps; content is a single line "irqbalance|active|inactive" (pgrep
    # works non-root). The per-CPU distribution matrix in the report already
    # shows where the kernel actually delivers.
    {
        if pgrep -x irqbalance >/dev/null 2>&1; then
            echo "irqbalance|active|-"
        else
            echo "irqbalance|inactive|-"
        fi
    } > "$osd/irq_affinity" 2>/dev/null
    if [ -r /proc/net/dev ]; then timeout -k 2 10 cp /proc/net/dev "$osd/net_dev" 2>/dev/null || { rm -f "$osd/net_dev"; echo "  [WARN] /proc/net/dev copy timed out or failed" >&2; }
    else echo "  [WARN] /proc/net/dev not readable" >&2; fi
    if [ -r /proc/net/snmp ]; then timeout -k 2 10 cp /proc/net/snmp "$osd/net_snmp" 2>/dev/null || { rm -f "$osd/net_snmp"; echo "  [WARN] /proc/net/snmp copy timed out or failed" >&2; }; fi
    if [ -r /proc/net/netstat ]; then timeout -k 2 10 cp /proc/net/netstat "$osd/net_netstat" 2>/dev/null || { rm -f "$osd/net_netstat"; echo "  [WARN] /proc/net/netstat copy timed out or failed" >&2; }; fi
    if [ -r /proc/net/softnet_stat ]; then timeout -k 2 10 cp /proc/net/softnet_stat "$osd/softnet_stat" 2>/dev/null || { rm -f "$osd/softnet_stat"; echo "  [WARN] /proc/net/softnet_stat copy timed out or failed" >&2; }; fi
    # buddyinfo: free pages per zone per order -> snapshot-level fragmentation
    # (2MB+ contiguous availability), rendered as Begin/End in the report
    if [ -r /proc/buddyinfo ]; then timeout -k 2 10 cp /proc/buddyinfo "$osd/buddyinfo" 2>/dev/null || { rm -f "$osd/buddyinfo"; echo "  [WARN] /proc/buddyinfo copy timed out or failed" >&2; }; fi
    # bond 三态 (mode / active slave / slave list); /proc/net/bonding absent = no bond
    if [ -d /proc/net/bonding ]; then
        : > "$osd/bonding" 2>/dev/null
        for _b in /proc/net/bonding/*; do
            [ -f "$_b" ] || continue
            _bn=$(basename "$_b")
            _mode=$(timeout -k 2 10 awk -F: '/^Bonding Mode:/{gsub(/^ +/,"",$2); print $2}' "$_b" 2>/dev/null)
            _act=$(timeout -k 2 10 awk -F: '/^Currently Active Slave:/{gsub(/^ +/,"",$2); print $2}' "$_b" 2>/dev/null)
            _slv=$(timeout -k 2 10 awk -F: '/^Slave Interface:/{gsub(/^ +/,"",$2); print $2}' "$_b" 2>/dev/null | tr '\n' ',' | sed 's/,$//')
            echo "${_bn}|${_mode}|${_act}|${_slv}" >> "$osd/bonding" 2>/dev/null
        done
    fi
    # file-nr: "<allocated> <unused> <max>" system-wide handle gauge. Kept in
    # the snapshot for on-site OS-level checks; NOT rendered -- System
    # Activity's File Handles is process-scoped since 2026-10-30 (postmaster
    # fd count vs its /proc/<pid>/limits Max open files).
    if [ -r /proc/sys/fs/file-nr ]; then timeout -k 2 10 cp /proc/sys/fs/file-nr "$osd/file_nr" 2>/dev/null || { rm -f "$osd/file_nr"; echo "  [WARN] /proc/sys/fs/file-nr copy timed out or failed" >&2; }; fi
    # irq -> node (2026-10-31): /proc/irq/N/node IS world-readable (unlike
    # the affinity masks) -- which node each IRQ is steered to; the renderer
    # adds a Node column to the IRQ legend. -1 = no node binding.
    : > "$osd/irq_node" 2>/dev/null
    for _iq in /proc/irq/[0-9]*; do
        [ -d "$_iq" ] || continue
        _iv=$(timeout -k 2 10 cat "$_iq/node" 2>/dev/null) || continue
        [ -n "$_iv" ] && echo "${_iq##*/}|$_iv" >> "$osd/irq_node" 2>/dev/null
    done
    # db_proc: identity of THIS instance's postmaster. The awr context
    # already guarantees the right port ($PGPORT: -P export / cron pin; the
    # storage root awrs/<port>/ and every \copy above use it) -- so map
    # port -> listener pid via ss (listener socket owned by vastbase itself,
    # same-user /proc visibility). pid|VmSize(kB)|VmRSS(kB)|Threads plus the
    # kernel's EFFECTIVE affinity (Cpus_allowed_list: cpuset cgroup + any
    # taskset pinning, already merged) from the same status file.
    _dpid=$(timeout -k 2 10 ss -lntp 2>/dev/null | grep -oP ":${PGPORT:-5432}\b.*pid=\K[0-9]+" | head -1)
    if [ -n "$_dpid" ] && [ -r "/proc/$_dpid/status" ]; then
        timeout -k 2 10 awk -v p="$_dpid" '/^VmSize:/{v=$2} /^VmRSS:/{r=$2} /^Threads:/{t=$2} \
                /^Cpus_allowed_list:/{c=$2} \
                /^nonvoluntary_ctxt_switches:/{nv=$2} /^voluntary_ctxt_switches:/{vl=$2} \
                /^VmPTE:/{pte=$2} /^VmSwap:/{swp=$2} \
                END{print p"|"v+0"|"r+0"|"t+0; if (c != "") print "cpuset " c; if (nv != "") print "nvcswch " nv+0"|"vl+0; if (pte != "") print "vmpte " pte; if (swp != "") print "vmswap " swp}' \
                "/proc/$_dpid/status" > "$osd/db_proc" 2>/dev/null
    fi
    # limits: the POSTMASTER's ACTUAL rlimits (/proc/<pid>/limits, world-
    # readable) -- deliberately NOT a fresh login shell's `ulimit -a`: the
    # running process's limits are the authoritative ones (limits.conf,
    # systemd overrides and inherited env all already resolved at start; the
    # DB user's name is irrelevant and need not be guessed). First line =
    # "user <name>" for context; the rest is the proc file verbatim.
    if [ -n "$_dpid" ] && [ -r "/proc/$_dpid/limits" ]; then
        { echo "user $(id -un 2>/dev/null)"; timeout -k 2 10 cat "/proc/$_dpid/limits"; } > "$osd/limits" 2>/dev/null
    fi
    # db_numa_maps (2026-10-31): the POSTMASTER's numa_maps aggregated per
    # node -- WHERE the DB's memory actually faulted. numactl not required:
    # numa_maps is owner-readable and the awr user owns the DB processes.
    # Output: "pages|<faulted-total>|N0=<n>|N1=<n>|...|unfaulted=<vmas with
    # no per-node counts yet>" + per-mapping lines (ALL of them, sorted by
    # faulted pages; the renderer takes the top 10):
    #   "map|<pages>|N0=<n>|N1=<n>|...|<desc (flags minus the per-node
    #    counters)>" -- the per-node split stays per-mapping so the report
    #   can show WHERE each block landed (user 2026-10-31), not just totals.
    # Counts are PAGES; kernelpagesize_kB inside desc says which page size.
    if [ -n "$_dpid" ] && [ -r "/proc/$_dpid/numa_maps" ]; then
        timeout -k 2 10 awk '{
                tot = 0
                split("", lnode)
                for (i = 1; i <= NF; i++)
                    if ($i ~ /^N[0-9]+=[0-9]+$/) {
                        split($i, a, "="); tot += a[2]
                        ncnt[a[1]] += a[2]; lnode[a[1]] += a[2]
                    }
                if ($0 !~ / N[0-9]+=/) unf++
                gtot += tot
                desc = $0
                gsub(/ N[0-9]+=[0-9]+/, "", desc)
                # front the page-size token: the renderer weights DB Share by
                # it, and a long file path would push it past the 90-char
                # truncation below (2026-11-01: on 204 the /SYSV shared
                # segment lost it exactly this way)
                if (match($0, /kernelpagesize_kB=[0-9]+/))
                    desc = substr($0, RSTART, RLENGTH) " " desc
                else
                    desc = "kernelpagesize_kB=4 " desc
                ml = "map|" tot
                for (n in lnode) ml = ml "|" n "=" lnode[n]
                printf "%s|%s\n", ml, substr(desc, 1, 90)
            }
            END {
                line = "pages|" gtot
                for (n in ncnt) line = line "|" n "=" ncnt[n]
                print line "|unfaulted=" (unf + 0)
            }' "/proc/$_dpid/numa_maps" 2>/dev/null \
            | sort -t'|' -k1,1r -k2,2rn > "$osd/db_numa_maps" 2>/dev/null
        [ -s "$osd/db_numa_maps" ] || rm -f "$osd/db_numa_maps"
    fi
    # db_cgroup (2026-10-31): the postmaster's cgroup resource envelope --
    # CPU quota / actual usage / throttle counters, memory limit+usage+failcnt
    # (+swap accounting), blkio throttle+service bytes, pids limit, cpuset
    # (cpus AND mems -- the NUMA-node pinning that explains DB Memory
    # Placement), hugetlb. All files are world-readable (0644 root-owned) --
    # verified non-root on 204 (openEuler cgroup v1) and WSL (v2).
    # Format: "raw|<line of /proc/<pid>/cgroup>" xN, "mode|v1|v2",
    # "<ctrl>|<hierarchy path>" then "<key>|<value>" lines per controller.
    # v1 mountpoint map comes from /proc/self/mountinfo (super-options are a
    # single comma string -- comma-split them; hierarchy paths may contain
    # ':' themselves (Gaussdb:vastbase), so paths are extracted by stripping
    # the first TWO colon fields, never by -F: field count.
    if [ -n "$_dpid" ] && [ -r "/proc/$_dpid/cgroup" ]; then
        {
            while IFS= read -r _cl; do echo "raw|$_cl"; done < "/proc/$_dpid/cgroup"
            _cg_rd() { [ -r "$1" ] && timeout -k 2 10 cat "$1" 2>/dev/null; }
            _cg_rel() {
                awk -F: -v c="$1" 'index(","$2",", ","c","){sub(/^[^:]*:[^:]*:/,""); print; exit}' "/proc/$_dpid/cgroup"
            }
            if [ -r /sys/fs/cgroup/cgroup.controllers ]; then
                echo "mode|v2"
                _REL=$(awk -F: '$1=="0"{sub(/^[^:]*:[^:]*:/,""); print; exit}' "/proc/$_dpid/cgroup")
                _D="/sys/fs/cgroup$_REL"
                echo "cpu|$_REL"
                _v=$(_cg_rd "$_D/cpu.max"); [ -n "$_v" ] && echo "cpu.max|$_v"
                _v=$(_cg_rd "$_D/cpu.stat" | awk '{printf "%s=%s;",$1,$2}'); [ -n "$_v" ] && echo "cpu.stat|$_v"
                echo "memory|$_REL"
                _v=$(_cg_rd "$_D/memory.max"); [ -n "$_v" ] && echo "memory.limit|$_v"
                _v=$(_cg_rd "$_D/memory.current"); [ -n "$_v" ] && echo "memory.usage|$_v"
                _v=$(_cg_rd "$_D/memory.events" | awk '{printf "%s=%s;",$1,$2}'); [ -n "$_v" ] && echo "memory.events|$_v"
                echo "io|$_REL"
                # io.max/io.stat are PER-DEVICE (multi-line): join with ';' so
                # every device survives the "k|v" single-line format (raw
                # lines 2+ used to land unprefixed and be dropped by the parser)
                _v=$(_cg_rd "$_D/io.max" | awk '{printf "%s;",$0}'); [ -n "$_v" ] && echo "io.max|$_v"
                _v=$(_cg_rd "$_D/io.stat" | awk '{printf "%s;",$0}'); [ -n "$_v" ] && echo "io.stat|$_v"
                echo "pids|$_REL"
                _v=$(_cg_rd "$_D/pids.max"); [ -n "$_v" ] && echo "pids.max|$_v"
                _v=$(_cg_rd "$_D/pids.current"); [ -n "$_v" ] && echo "pids.current|$_v"
                echo "cpuset|$_REL"
                _v=$(_cg_rd "$_D/cpuset.cpus"); [ -n "$_v" ] && echo "cpuset.cpus|$_v"
                _v=$(_cg_rd "$_D/cpuset.cpus.effective"); [ -n "$_v" ] && echo "cpuset.effective|$_v"
                _v=$(_cg_rd "$_D/cpuset.mems"); [ -n "$_v" ] && echo "cpuset.mems|$_v"
            else
                echo "mode|v1"
                declare -A _CG_MP
                while read -r _ml; do
                    rt="${_ml#* - }"
                    [ "${rt%% *}" = "cgroup" ] || continue
                    lt="${_ml%% - *}"
                    _mp=$(printf '%s\n' "$lt" | awk '{print $5}')
                    _so=$(printf '%s\n' "$rt" | awk '{o="";for(i=3;i<=NF;i++)o=o" "$i;print o}')
                    for _o in ${_so//,/ }; do
                        case "$_o" in
                            cpu|cpuacct|memory|blkio|pids|cpuset|hugetlb) _CG_MP[$_o]="$_mp" ;;
                        esac
                    done
                done < /proc/self/mountinfo
                for _c in cpu cpuacct memory blkio pids cpuset hugetlb; do
                    _mp=${_CG_MP[$_c]:-}
                    [ -n "$_mp" ] || continue
                    _rel=$(_cg_rel "$_c")
                    [ -n "$_rel" ] || continue
                    _cd="$_mp$_rel"
                    case "$_c" in
                        cpu)
                            echo "cpu|$_rel"
                            _v=$(_cg_rd "$_cd/cpu.cfs_quota_us"); [ -n "$_v" ] && echo "cpu.quota|$_v"
                            _v=$(_cg_rd "$_cd/cpu.cfs_period_us"); [ -n "$_v" ] && echo "cpu.period|$_v"
                            _v=$(_cg_rd "$_cd/cpu.stat" | awk '{printf "%s=%s;",$1,$2}'); [ -n "$_v" ] && echo "cpu.stat|$_v" ;;
                        cpuacct)
                            echo "cpuacct|$_rel"
                            _v=$(_cg_rd "$_cd/cpuacct.usage"); [ -n "$_v" ] && echo "cpuacct.usage|$_v" ;;
                        memory)
                            echo "memory|$_rel"
                            _v=$(_cg_rd "$_cd/memory.limit_in_bytes"); [ -n "$_v" ] && echo "memory.limit|$_v"
                            _v=$(_cg_rd "$_cd/memory.usage_in_bytes"); [ -n "$_v" ] && echo "memory.usage|$_v"
                            _v=$(_cg_rd "$_cd/memory.failcnt"); [ -n "$_v" ] && echo "memory.failcnt|$_v"
                            _v=$(_cg_rd "$_cd/memory.memsw.limit_in_bytes"); [ -n "$_v" ] && echo "memsw.limit|$_v" ;;
                        blkio)
                            echo "blkio|$_rel"
                            _v=$(_cg_rd "$_cd/blkio.throttle.read_bps_device"); [ -n "$_v" ] && echo "io.throttle.r|$_v"
                            _v=$(_cg_rd "$_cd/blkio.throttle.write_bps_device"); [ -n "$_v" ] && echo "io.throttle.w|$_v"
                            _v=$(_cg_rd "$_cd/blkio.io_service_bytes" | tr '\n' ';'); [ -n "$_v" ] && echo "io.service|$_v" ;;
                        pids)
                            echo "pids|$_rel"
                            _v=$(_cg_rd "$_cd/pids.max"); [ -n "$_v" ] && echo "pids.max|$_v"
                            _v=$(_cg_rd "$_cd/pids.current"); [ -n "$_v" ] && echo "pids.current|$_v" ;;
                        cpuset)
                            echo "cpuset|$_rel"
                            _v=$(_cg_rd "$_cd/cpuset.cpus"); [ -n "$_v" ] && echo "cpuset.cpus|$_v"
                            _v=$(_cg_rd "$_cd/cpuset.effective_cpus"); [ -n "$_v" ] && echo "cpuset.effective|$_v"
                            _v=$(_cg_rd "$_cd/cpuset.mems"); [ -n "$_v" ] && echo "cpuset.mems|$_v" ;;
                        hugetlb)
                            echo "hugetlb|$_rel"
                            for _hf in "$_cd"/hugetlb.*.limit_in_bytes; do
                                [ -r "$_hf" ] || continue
                                _sz=${_hf##*/hugetlb.}; _sz=${_sz%.limit_in_bytes}
                                printf 'hugetlb.%s.limit|%s\n' "$_sz" "$(_cg_rd "$_hf")"
                                printf 'hugetlb.%s.usage|%s\n' "$_sz" "$(_cg_rd "${_hf/limit_in_bytes/usage_in_bytes}")"
                            done ;;
                    esac
                done
            fi
        } > "$osd/db_cgroup" 2>/dev/null
        [ -s "$osd/db_cgroup" ] || rm -f "$osd/db_cgroup"
    fi
    # open fd classification: SAME postmaster, SAME instant as status/limits
    # above. VB is single-process multi-thread -- every backend's fd lives on
    # the postmaster, so ONE /proc/<pid>/fd walk covers the whole instance.
    # v2.5.6 (user): top level = professional fd TYPE (reg / pipe / socket /
    # dev / other); reg is SUB-CLASSIFIED by DIRECTORY with the ABSOLUTE PATH
    # as the row key, ALLOWLIST style -- only the meaningful $PGDATA dirs
    # (_pref relative names; pg_location one level deeper = one bucket per
    # tablespace; base/<dbid> one bucket per database + base/pgsql_tmp = the
    # sort/hash spill dir, user 2026-09-20) plus absolute prefixes
    # (archive_dest GUC target, pg_tblspc symlink targets -- a tablespace's
    # files resolve THERE, not under pg_tblspc) and the $PGHOME install tree
    # (first-level dirs, bin/version.cfg its own full-path row -- leak
    # indicator, user 2026-09-20) become their own rows. EVERYTHING else reg
    # -- asp_data/gs_profile/sql_monitor/unlisted dirs/datadir-root files --
    # goes to "reg other" (user 2026-09-19).
    # Deleted fds count per row as a second number; the renderer shows merged
    # "live(N deleted)" cells ONLY for the reg family. Output: "reg|live|
    # deleted", "pipe|..", "socket|..", "dev|..", "other|..", then one row per
    # seen bucket directory (pref order first).
    if [ -n "$_dpid" ] && [ -d "/proc/$_dpid/fd" ]; then
        _pd=$(readlink "/proc/$_dpid/cwd" 2>/dev/null)
        [ -n "$_pd" ] && _pd="$_pd/"
        # $PGHOME from the postmaster binary itself (exe -> $GAUSSHOME/bin/
        # gaussdb); same-user /proc read, no env needed -- cron-safe
        _gh=$(readlink "/proc/$_dpid/exe" 2>/dev/null)
        case "$_gh" in
            */bin/*) _gh=$(dirname "$(dirname "$_gh")") ;;
            *)       [ -n "$_gh" ] && _gh=$(dirname "$_gh") ;;
        esac
        # row-key ENUMERATION from the filesystem (user 2026-09-20 老规矩:
        # enumerated classes are always written, 0 included -- every database
        # dir under base/, every $PGHOME first-level dir, and version.cfg
        # wherever it lives; the awk END emits each with live+deleted counts)
        local _baseids="" _ghcfg=""
        if [ -n "$_pd" ] && [ -d "${_pd}base" ]; then
            for _d in "${_pd}base"/*; do
                [ -d "$_d" ] || continue
                _n=$(basename "$_d")
                case "$_n" in
                    pgsql_tmp) continue ;;
                    *[!0-9]*|'') continue ;;
                esac
                _baseids="$_baseids|$_d"
            done
        fi
        if [ -n "$_gh" ] && [ -d "$_gh" ]; then
            for _c in "$_gh/version.cfg" "$_gh/bin/version.cfg"; do
                [ -f "$_c" ] && _ghcfg="$_ghcfg|$_c"
            done
        fi
        local _pref="base|base/pgsql_tmp|global|pg_xlog|pg_wal|pg_arch|pg_clog|pg_csnlog|pg_multixact|pg_twophase|pg_log|pg_audit|pg_replslot|pg_stat_tmp|pgsql_tmp|pg_tblspc|pg_location|pg_logical|pg_notify|pg_perf|pg_serial|pg_snapshots|mem_log|pg_errorinfo|pg_llog|undo"
        _arc=$(PGCONNECT_TIMEOUT=3 PGOPTIONS='-c statement_timeout=5000' psql -d postgres -tAc "show archive_dest" 2>/dev/null | head -1 | tr -d ' ')
        case "$_arc" in
            /*) _pref="$_pref|$_arc" ;;
            ??*) [ -n "$_pd" ] && _pref="$_pref|$_pd$_arc" ;;
        esac
        # user 2026-09-20: pg_tblspc is THE tablespace registry (custom
        # tablespaces do NOT have to live under pg_location); resolve every
        # symlink with readlink -f into a canonical absolute target -- the
        # awk gets them as tblist (one always-0 row per tablespace plus its
        # pgsql_tmp); targets OUTSIDE $PGDATA also stay in _pref as prefixes
        _tblist=""
        if [ -n "$_pd" ] && [ -d "${_pd}pg_tblspc" ]; then
            for _t in "${_pd}pg_tblspc"/*; do
                [ -L "$_t" ] || continue
                _tt=$(readlink -f "$_t" 2>/dev/null)
                [ -n "$_tt" ] && [ -d "$_tt" ] || continue
                case "$_tt" in
                    "$_pd"*) ;;    # under $PGDATA: keyed via its own absolute path
                    *) _pref="$_pref|$_tt" ;;
                esac
                _tblist="$_tblist|$_tt"
            done
        fi
        timeout -k 2 10 ls -l "/proc/$_dpid/fd" 2>/dev/null | awk -v pd="$_pd" -v gh="$_gh" -v baseids="$_baseids" -v ghcfg="$_ghcfg" -v tblist="$_tblist" -v pref="$_pref" '
            BEGIN { np = split(pref, prefarr, "|")
                    for (j = 1; j <= np; j++) {
                        it = prefarr[j]
                        if (it != "" && index(it, "/") == 0) bucket1[it] = 1
                    }
                    nt2 = split(tblist, tarr2, "|")
                    if (pd != "") { pr = pd; sub(/\/$/, "", pr) } }
            { t = $0; sub(/^.* -> /, "", t)
              dflag = 0
              if (t ~ / \(deleted\)$/) { dflag = 1; sub(/ \(deleted\)$/, "", t) }
              type = "reg"
              if (t ~ /^socket:\[/)    type = "socket"
              else if (t ~ /^pipe:\[/) type = "pipe"
              else if (t ~ /^\/dev\//) type = "dev"
              else if (t !~ /^\//)     type = "other"     # anon_inode:[...] etc
              if (type == "reg") {
                  # $PGDATA / $PGHOME tree TOTALS (user 2026-09-20: the two
                  # first-level reg trees, always present) -- counted straight
                  # off the fd target, independent of bucketing
                  if (pd != "" && index(t, pd) == 1) { pdtot++; if (dflag) pddel++ }
                  if (gh != "" && index(t, gh "/") == 1) { ghtot++; if (dflag) ghdel++ }
                  # tablespaces FIRST (pg_tblspc registry, user 2026-09-20):
                  # a tablespace may live under pg_location OR anywhere on
                  # disk; its own pgsql_tmp buckets one level deeper
                  c = ""
                  for (i = 1; i <= nt2; i++) {
                      tb = tarr2[i]; if (tb == "") continue
                      if (index(t, tb "/") == 1) {
                          rem2 = substr(t, length(tb) + 2)
                          c = (rem2 ~ /^pgsql_tmp\//) ? tb "/pgsql_tmp" : tb
                          break
                      }
                  }
                  if (c == "" && pd != "" && index(t, pd) == 1) {
                      rel = substr(t, length(pd) + 1)
                      ti = index(rel, "/pgsql_tmp/")
                      if (ti > 0) {
                          # the sort/hash spill dir -- own bucket (user: must count)
                          c = pd substr(rel, 1, ti + 9)
                      } else if (rel ~ /^pg_location\//) {
                          # one bucket per tablespace dir; the per-tablespace
                          # pgsql_tmp gets its own bucket one level deeper
                          # (user 2026-09-20, same layout as base)
                          rest = substr(rel, 13)
                          ti2 = index(rest, "/pgsql_tmp/")
                          if (ti2 > 0) { c = pd "pg_location/" substr(rest, 1, ti2 + 9) }
                          else {
                              s2 = index(rest, "/")
                              c = (s2 > 1) ? pd "pg_location/" substr(rest, 1, s2 - 1) : pd "pg_location"
                          }
                      } else if (rel ~ /^base\/[0-9]+\//) {
                          # one bucket per DATABASE dir under base/ (user
                          # 2026-09-20, same indented display as pgsql_tmp);
                          # temp relation segments (base/<db>/tNNN) fold in
                          rest = substr(rel, 6)
                          s2 = index(rest, "/")
                          c = pd "base/" substr(rest, 1, s2 - 1)
                      } else {
                          sl = index(rel, "/")
                          f1 = (sl > 1) ? substr(rel, 1, sl - 1) : ""
                          # allowlisted first-level dirs get their own row;
                          # everything else under $PGDATA (unlisted dirs such
                          # as asp_data/gs_profile/sql_monitor, pg_cbm, and
                          # datadir-root files -- user 2026-09-20) folds into
                          # the PGDATA-tree "(other)" row
                          c = (f1 != "" && f1 in bucket1) ? pd f1 : pr "/(other)"
                      }
                  } else if (c == "" && gh != "" && index(t, gh "/") == 1) {
                      # $PGHOME install tree (user 2026-09-20): bucket by
                      # first-level dir; bin/version.cfg gets its OWN row
                      # with the full file path -- a known open-without-close
                      # LEAK in VB, a growing count must be instantly visible
                      rel2 = substr(t, length(gh) + 2)
                      nn = split(rel2, seg, "/")
                      if (seg[nn] == "version.cfg") { c = t }
                      else { c = (nn > 1) ? gh "/" seg[1] : gh }
                  } else if (c == "") {
                      for (j = 1; j <= np; j++) {
                          it = prefarr[j]
                          if (it != "" && substr(it, 1, 1) == "/" && index(t, it) == 1) {
                              c = it; break
                          }
                      }
                      if (c == "") c = "reg other"
                  }
              } else c = type
              live[c]++; if (dflag) dcount[c]++
            }
            END { topreg = topregd = 0
                  for (k in live)
                      if (k != "pipe" && k != "socket" && k != "dev" && k != "other") {
                          topreg += live[k]; topregd += dcount[k]
                      }
                  print "reg|" topreg+0 "|" topregd+0
                  print "pipe|" live["pipe"]+0 "|" dcount["pipe"]+0
                  print "socket|" live["socket"]+0 "|" dcount["socket"]+0
                  print "dev|" live["dev"]+0 "|" dcount["dev"]+0
                  print "other|" live["other"]+0 "|" dcount["other"]+0
                  if (pd != "") { r = pd; sub(/\/$/, "", r); print r "|" pdtot+0 "|" pddel+0 }
                  if (gh != "") print gh "|" ghtot+0 "|" ghdel+0
                  for (i = 1; i <= np; i++) {
                      it = prefarr[i]; if (it == "") continue
                      if (pd != "" && (it == "base" || it == "pg_location")) continue   # total rows emitted below
                      k = (substr(it, 1, 1) == "/") ? it : pd it
                      if (k in live) { print k "|" live[k]+0 "|" dcount[k]+0; seen[k] = 1 }
                  }
                  # user 2026-09-20 老规矩: ENUMERATED classes are always
                  # written, 0 included -- every database dir under base/,
                  # every $PGHOME first-level dir, version.cfg wherever it
                  # lives; base itself gets a TOTAL row (direct files + every
                  # child bucket). A snapshot instant almost never catches a
                  # live spill or leak -- absence must show as 0, never as a
                  # missing row.
                  nb = split(baseids, barr, "|")
                  for (i = 1; i <= nb; i++) {
                      k = barr[i]; if (k == "") continue
                      print k "|" live[k]+0 "|" dcount[k]+0; seen[k] = 1
                  }
                  ng = split(ghcfg, carr, "|")
                  for (i = 1; i <= ng; i++) {
                      k = carr[i]; if (k == "") continue
                      print k "|" live[k]+0 "|" dcount[k]+0; seen[k] = 1
                  }
                  if (pd != "") {
                      bk = pd "base"; bt = live[bk]; bd = dcount[bk]
                      for (k in live)
                          if (index(k, bk "/") == 1) { bt += live[k]; bd += dcount[k] }
                      print bk "|" bt+0 "|" bd+0; seen[bk] = 1
                      sk = pd "base/pgsql_tmp"
                      if (!(sk in seen)) { print sk "|" live[sk]+0 "|" dcount[sk]+0; seen[sk] = 1 }
                      # tablespaces from the pg_tblspc registry (user
                      # 2026-09-20): one row per tablespace -- total incl.
                      # its pgsql_tmp child -- plus the tmp row itself; ALL
                      # always written, 0 included
                      for (i = 1; i <= nt2; i++) {
                          tb = tarr2[i]; if (tb == "") continue
                          tv = live[tb]; dv = dcount[tb]
                          for (k in live)
                              if (index(k, tb "/") == 1) { tv += live[k]; dv += dcount[k] }
                          print tb "|" tv+0 "|" dv+0; seen[tb] = 1
                          tk = tb "/pgsql_tmp"
                          print tk "|" live[tk]+0 "|" dcount[tk]+0; seen[tk] = 1
                      }
                      # pg_location parent total (pg_location-style
                      # tablespaces nest under it; 0 included)
                      pk = pd "pg_location"; pt2 = live[pk]; pdl2 = dcount[pk]
                      for (k in live)
                          if (index(k, pk "/") == 1) { pt2 += live[k]; pdl2 += dcount[k] }
                      print pk "|" pt2+0 "|" pdl2+0; seen[pk] = 1
                      # PGDATA-tree catch-all (user 2026-09-20): fds under
                      # NON-allowlisted first-level dirs + datadir-root files
                      ok = pr "/(other)"
                      print ok "|" live[ok]+0 "|" dcount[ok]+0; seen[ok] = 1
                  }
                  # neither-tree fds (outside $PGDATA and $PGHOME); always
                  # written, 0 included (老规矩)
                  print "reg other|" live["reg other"]+0 "|" dcount["reg other"]+0; seen["reg other"] = 1
                  for (k in live) {
                      if (k == "reg" || k == "pipe" || k == "socket" || k == "dev" || k == "other" || seen[k]) continue
                      # PGHOME tree prints ONLY its total + version.cfg rows
                      # (user 2026-09-20) -- per-dir buckets stay unprinted
                      if (gh != "" && (k == gh || index(k, gh "/") == 1) && k !~ /\/version\.cfg$/) continue
                      print k "|" live[k]+0 "|" dcount[k]+0; seen[k] = 1
                  } }' \
            > "$osd/db_fd_types" 2>/dev/null
    fi
    # TCP socket states on THIS port (kernel view; the fd socket row only
    # counts fds the postmaster HOLDS -- time-wait/close-wait are kernel
    # state and never appear there, yet they are the diagnostic gold:
    # close-wait piling = server side not closing, time-wait surge = short
    # connection storm). sport= filter: listener AND accepted connections
    # both have local port = PGPORT; outbound sockets (walrcv, db links)
    # match dport instead and stay out. No -p: the port filter alone runs
    # fine as the DB user, root is not needed. Fixed state order, zeros
    # included, same always-display rule as the fd classes.
    timeout -k 2 10 ss -tanH "sport = :${PGPORT:-5432}" 2>/dev/null | awk '
        # other 列与 vtop 同一修法 (2026-11-17): 未知状态名真计入 other, 不再恒 0
        BEGIN { n = split("listen|established|syn-recv|syn-sent|fin-wait-1|fin-wait-2|time-wait|close-wait|last-ack|closing", ord, "|")
                for (i = 1; i <= n; i++) known[ord[i]] = 1 }
        { s = tolower($1)
          if (s == "estab") s = "established"
          if (s in known) cnt[s]++; else oth++ }
        END { for (i = 1; i <= n; i++) print ord[i] "|" cnt[ord[i]]+0
              print "other|" oth+0 }' \
        > "$osd/db_tcp_states" 2>/dev/null
    # sysctl: FULL kernel parameter dump via `sysctl -a` (user 2026-09-17:
    # the complete set, not a curated list). Keys the collector user cannot
    # read are printed to stderr by sysctl and simply do not appear -- that
    # IS the permission filter. Split at the FIRST " = " so values may
    # themselves contain " = ". "key|value" lines; renderer hides old snaps.
    if command -v sysctl >/dev/null 2>&1; then
        LC_ALL=C timeout -k 2 10 sysctl -a 2>/dev/null | sed -E 's/^([^=]+) = (.*)$/\1|\2/' > "$osd/sysctl" || { rm -f "$osd/sysctl"; echo '  [WARN] sysctl -a timed out or failed' >&2; }
        [ -s "$osd/sysctl" ] || rm -f "$osd/sysctl"
    fi
    # THP is a sysfs knob, not a sysctl: only whether it is on/off matters here
    # (user 2026-10-27), so map the effective value (bracketed one of
    # "always [madvise] never") to enabled/disabled and file it with the rest
    # of the kernel parameters.
    if [ -r /sys/kernel/mm/transparent_hugepage/enabled ]; then
        _thpv=$(timeout -k 2 10 sed -n 's/.*\[\([^]]*\)\].*/\1/p' /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null)
        case "$_thpv" in
            "")        ;;
            never)     echo "transparent_hugepage|disabled" >> "$osd/sysctl" ;;
            *)         echo "transparent_hugepage|enabled"  >> "$osd/sysctl" ;;
        esac
    fi
    # dmesg: INCREMENTAL kernel capture -- only lines NEWER than the last
    # line of the PREVIOUS snapshot's os/dmesg (first snapshot = full dump;
    # no blind tail: window coverage is by construction). Each snap stores
    # its own chunk; the renderer unions the chunks of every snap with ts in
    # (begin, end] -- the same tiling as the ASH flush. gawk mktime()
    # converts the "Thu Sep 17 00:53:07 2026" prefix (LC_ALL=C keeps it
    # English) for the floor comparison; untimestamped continuation lines
    # ride their parent's decision. dmesg_restrict=1 -> "status denied".
    _dmout=$(LC_ALL=C timeout 10 dmesg -T 2>&1); _dmrc=$?
    # "denied" ONLY on a real auth failure (restrict=1) or an EMPTY failed
    # read; a timeout kill (rc=124) that already yielded timestamped lines
    # is still usable partial data, not "denied"
    if printf '%s' "$_dmout" | head -1 | grep -qi "read kernel buffer failed\|permission denied" \
       || { [ "$_dmrc" -ne 0 ] && ! printf '%s' "$_dmout" | grep -q '^\['; }; then
        echo "status denied" > "$osd/dmesg"
    elif ! awk 'BEGIN{print mktime("2026 1 1 0 0 0")}' 2>/dev/null | grep -q '^1[0-9]\{9\}$'; then
        # mktime()/3-arg match() are GAWK extensions; mawk/busybox would
        # print NOTHING (silent chunk loss, the worst failure mode) --
        # make the incapacity explicit instead
        echo "status nogawk" > "$osd/dmesg"
    else
        # floor = LAST line of the CHRONOLOGICALLY newest previous snap's
        # chunk: ls -dt (mtime) newest-first + break (glob order is
        # lexicographic -- snap_999 sorts AFTER snap_1172 and would feed a
        # stale floor -> duplicate lines; the break also avoids reading all
        # history chunks every create)
        _dmfloor=""
        for _d in $(ls -dt "${target%/*}"/snap_* 2>/dev/null); do
            [ -f "$_d/os/dmesg" ] && [ "$_d" != "$target" ] || continue
            _lts=$(sed -n 's/^\[\([A-Z][a-z][a-z] [A-Z][a-z][a-z] [ 0-9][0-9] [0-9:]* [0-9]*\)\].*/\1/p' "$_d/os/dmesg" | tail -1)
            [ -n "$_lts" ] && { _dmfloor=$(date -d "$_lts" +%s 2>/dev/null); break; }
        done
        printf 'status ok\n' > "$osd/dmesg"
        # NO truncation (user 2026-09-17): only the FIRST-ever dump can be
        # large (full ring, one-time per install); incremental chunks after
        # it are naturally tiny -- completeness over size
        printf '%s\n' "$_dmout" | awk -v floor="$_dmfloor" '
            BEGIN { n = split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", mo, " ")
                    for (i = 1; i <= n; i++) M[mo[i]] = i
                    laste = -1 }
            { if (match($0, /^\[[A-Z][a-z][a-z] ([A-Z][a-z][a-z]) +([0-9]+) ([0-9][0-9]:[0-9][0-9]:[0-9][0-9]) ([0-9]{4})\]/, m)) {
                  split(m[3], T, ":")
                  e = mktime(m[4] " " M[m[1]] " " m[2] " " T[1] " " T[2] " " T[3])
                  laste = e
                  if (floor == "" || e > floor) print
              } else if (laste >= 0 && (floor == "" || laste > floor)) print }' >> "$osd/dmesg"
    fi
    # net_rtt: raw `ss -tin state established` (END-snap instantaneous per-conn
    # tcp_info: rtt/cwnd/retrans/send-q; loopback included here, the renderer
    # filters). Capped at 512 KB so a many-thousand-conn instance cannot bloat
    # every snap; the possibly-cut tail row dies in the parser. No ss / no conns
    # -> no file -> the renderer hides the RTT sections (old snaps unaffected).
    sscmd=$(command -v ss 2>/dev/null || echo /usr/sbin/ss)
    if [ -x "$sscmd" ]; then
        timeout -k 2 10 "$sscmd" -tin state established 2>/dev/null | head -c 524288 > "$osd/net_rtt"
        [ -s "$osd/net_rtt" ] || rm -f "$osd/net_rtt"
    fi
    # df_fs: filesystem inventory at snap time -- space (df -TPk, 1K blocks,
    # Available) and inodes (df -TPi) dumped raw into ONE file with an '@ino@'
    # separator; the renderer merges by (device, mount). NOTHING is filtered
    # (user 2026-11-24: tmpfs must be visible); df's own zero-size hiding
    # (proc/sysfs) applies. Each df runs
    # under `timeout 10` + line-buffered (stdbuf -oL; same coreutils package as
    # df, always present together): a hard-mounted network fs with a dead
    # network blocks statfs in the kernel -- the kill keeps the snapshot alive
    # and line buffering keeps rows df already printed; a timed-out half leaves
    # a '# df-timeout' marker the renderer turns into a note. No df / empty
    # -> no file -> renderer hides the sub-section (old snaps unaffected).
    if command -v df >/dev/null 2>&1; then
        _dfto=""
        { timeout 10 stdbuf -oL df -TPk 2>/dev/null || _dfto=1
          printf '@ino@\n'
          timeout 10 stdbuf -oL df -TPi 2>/dev/null || _dfto=1
          [ -n "$_dfto" ] && printf '# df-timeout\n'; } > "$osd/df_fs"
        [ -s "$osd/df_fs" ] || rm -f "$osd/df_fs"
    fi
    # dirsz: du -k totals of the instance's own trees at snap time (user
    # 2026-11-24): data_dir + the WAL dir + every custom tablespace target.
    # data_dir from the postmaster's cwd (same trick as the fd walk; cron
    # safe, no env needed); tablespaces via the pg_tblspc symlink registry +
    # readlink -f -- a tablespace's files resolve at the TARGET, not under
    # pg_tblspc, and du does not follow symlinks mid-traversal, so the
    # data_dir total never double-counts an OUTSIDE target. A target under
    # $PGDATA (pg_location style) IS inside the data_dir total -- the
    # renderer marks such rows instead of subtracting. Names come from
    # pg_tablespace by oid (symlink basename; fallback = oid when the psql
    # probe fails). Every du runs under `timeout 120`: a multi-TB walk must
    # not wedge the snapshot; a timed-out row keeps its label with '-'.
    # Lines: <label>|<path>|<KB or -> ; no postmaster / no data dir -> no
    # file -> renderer hides the table (old snaps unaffected).
    {
        _dspid=$(timeout -k 2 10 ss -lntp 2>/dev/null | grep -oP ":${PGPORT:-5432}\b.*pid=\K[0-9]+" | head -1)
        _dsd=""
        [ -n "$_dspid" ] && _dsd=$(readlink "/proc/$_dspid/cwd" 2>/dev/null)
        if [ -n "$_dsd" ] && [ -d "$_dsd" ]; then
            _dsk=$(timeout -k 2 120 du -sk "$_dsd" 2>/dev/null | awk '{print $1}')
            printf 'data_dir|%s|%s\n' "$_dsd" "${_dsk:--}"
            _dsxl=""
            for _dsc in pg_xlog pg_wal; do [ -d "$_dsd/$_dsc" ] && _dsxl="$_dsd/$_dsc" && break; done
            if [ -n "$_dsxl" ]; then
                _dsk=$(timeout -k 2 120 du -sk "$_dsxl" 2>/dev/null | awk '{print $1}')
                printf 'pg_xlog|%s|%s\n' "$_dsxl" "${_dsk:--}"
            fi
            if [ -d "$_dsd/pg_tblspc" ]; then
                _dsnames=$(PGCONNECT_TIMEOUT=3 PGOPTIONS='-c statement_timeout=5000' psql -d postgres -tAc "select oid||' '||spcname from pg_tablespace" 2>/dev/null)
                for _dst in "$_dsd"/pg_tblspc/*; do
                    [ -L "$_dst" ] || continue
                    _dstt=$(readlink -f "$_dst" 2>/dev/null)
                    [ -n "$_dstt" ] && [ -d "$_dstt" ] || continue
                    _dsnm=$(printf '%s\n' "$_dsnames" | awk -v o="${_dst##*/}" '$1==o{print $2; exit}')
                    [ -n "$_dsnm" ] || _dsnm="${_dst##*/}"
                    _dsk=$(timeout -k 2 120 du -sk "$_dstt" 2>/dev/null | awk '{print $1}')
                    printf 'tblspc %s|%s|%s\n' "$_dsnm" "$_dstt" "${_dsk:--}"
                done
            fi
        fi
    } > "$osd/dirsz"
    [ -s "$osd/dirsz" ] || rm -f "$osd/dirsz"
    # ---- NUMA topology + numastat (per-node cumulative counters; renderer computes end-begin) ----
    # File format (one stanza per node, blank-line separated):
    #   node <id>
    #   cpulist <0-15>
    #   MemTotal:       <kB> / MemFree:        <kB>   (from node meminfo, node prefix stripped)
    #   distance <row>
    #   stat <name> <value>   (numa_hit numa_miss numa_foreign interleave_hit local_node other_node)
    {
        _nd=/sys/devices/system/node
        if [ -d "$_nd" ]; then
            for _n in $(ls "$_nd" 2>/dev/null | grep '^node[0-9]*$' | sort -V); do
                echo "node ${_n#node}"
                [ -r "$_nd/$_n/cpulist" ] && echo "cpulist $(timeout -k 2 10 cat "$_nd/$_n/cpulist")"
                [ -r "$_nd/$_n/meminfo" ] && timeout -k 2 10 grep -E 'MemTotal|MemFree' "$_nd/$_n/meminfo" | sed 's/^Node [0-9]* //'
                [ -r "$_nd/$_n/distance" ] && echo "distance $(timeout -k 2 10 cat "$_nd/$_n/distance")"
                [ -r "$_nd/$_n/numastat" ] && timeout -k 2 10 sed 's/^/stat /' "$_nd/$_n/numastat"
                echo ""
            done
        fi
    } > "$osd/numa" 2>/dev/null
    [ -s "$osd/numa" ] || echo "  [WARN] NUMA info unavailable (no /sys/devices/system/node or empty)" >&2
    # ---- block-device / NIC / DMI identity (END-snap state; renderer joins by name) ----
    # blockdev_meta: run_lsds --raw TSV (name|size|type|sched|rot|qdepth|nr_rq|wcache|model|vendor)
    run_lsds --raw > "$osd/blockdev_meta" 2>/dev/null || rm -f "$osd/blockdev_meta"
    # netdev_meta: iface|speed|duplex|nrxq|ntxq|rx_max|rx_cur|tx_max|tx_cur  ('-' = unavailable)
    {
        for _if in $(ls /sys/class/net 2>/dev/null | grep -vE '^(lo|vir)'); do
            _p="/sys/class/net/$_if"
            [ -d "$_p" ] || continue
            _sp=$(cat "$_p/speed"  2>/dev/null) || _sp=-
            _dp=$(cat "$_p/duplex" 2>/dev/null) || _dp=-
            _nrx=$(ls -d "$_p/queues/rx-"* 2>/dev/null | wc -l)
            _ntx=$(ls -d "$_p/queues/tx-"* 2>/dev/null | wc -l)
            _rmax=-; _rcur=-; _tmax=-; _tcur=-
            if command -v ethtool >/dev/null 2>&1; then
                _ring=$(timeout -k 2 10 ethtool -g "$_if" 2>/dev/null | awk '
                    /Pre-set maximums:/         {sec="max"; next}
                    /Current hardware settings:/{sec="cur"; next}
                    sec=="max" && /^RX:/ {rmax=$2}
                    sec=="max" && /^TX:/ {tmax=$2}
                    sec=="cur" && /^RX:/ {rcur=$2}
                    sec=="cur" && /^TX:/ {tcur=$2}
                    END { printf "%s|%s|%s|%s",
                          (rmax==""?"-":rmax), (rcur==""?"-":rcur),
                          (tmax==""?"-":tmax), (tcur==""?"-":tcur) }')
                IFS='|' read -r _rmax _rcur _tmax _tcur <<< "$_ring"
            fi
            echo "$_if|$_sp|$_dp|$_nrx|$_ntx|$_rmax|$_rcur|$_tmax|$_tcur"
        done
    } > "$osd/netdev_meta" 2>/dev/null
    # dmi: arch/vendor/product lines (world-readable; absent on some ARM/containers -> empty file)
    {
        _a=$(timeout -k 2 10 lscpu 2>/dev/null | awk -F: '$1=="Architecture"{gsub(/^[ \t]+/,"",$2); print $2; exit}')
        [ -n "$_a" ] && echo "arch $_a" || { command -v uname >/dev/null 2>&1 && echo "arch $(uname -m)"; }
        [ -r /sys/class/dmi/id/sys_vendor ]   && echo "vendor $(cat /sys/class/dmi/id/sys_vendor)"
        [ -r /sys/class/dmi/id/product_name ] && echo "product $(cat /sys/class/dmi/id/product_name)"
    } > "$osd/dmi" 2>/dev/null
    # ---- DB reachability probe + bounded timeouts ----
    # One cheap probe before ~30 psql invocations below (heredoc + per-db object
    # loops + meta queries): if the DB is unreachable, fail fast ONCE instead of
    # hanging through every invocation (kernel SYN retries ~127s each when the
    # network blackholes). Timeouts are passed as PER-COMMAND env prefixes
    # (session-level, only that psql process sees them) -- never exported into
    # the script's global environment.
    local _ct=15 _st="-c statement_timeout=60000"
    if ! PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAc "select 1" >/dev/null 2>&1; then
        echo "  [ERROR] cannot reach the database (connect probe failed, skipped DB collection)" >&2
        return 1
    fi
    # ---- db role: primary vs physical standby, detected ONCE here (before any
    # sampler) and threaded through. On a standby the ASH flush must read
    # local_active_session ONLY: gs_asp is a normal heap table whose inserts
    # WAL-replicate from the primary, so on a standby it holds the PRIMARY's
    # session history. And the replication-side single-point sample switches
    # to the walreceiver function. meta.json reuses the same value.
    local m_role is_standby=0
    m_role=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -tAq -c "select case when pg_is_in_recovery() then 'physical standby' else 'primary' end;" 2>/dev/null | head -1 | tr -d '"\r\n')
    [ "$m_role" = "physical standby" ] && is_standby=1
    # ---- ASH flush window: [previous snap ts, now]. Output replicates the
    # `vb_tool asp` command (per-second counts rolled to 5-minute buckets,
    # max/avg columns; top-5 SQL per bucket; both sources gs_asp AND
    # get_local_active_session() tagged g/l -- the live stream hands off (the
    # dbe_perf.local_active_session VIEW is deliberately NOT used anywhere:
    # its WITH RECURSIVE final_block_sessionid walks every row even when
    # nobody is blocked -- linear-cost recursion per snap (user 2026-09-08);
    # the waitchain queries grow their own chain from blocked rows ONLY)
    # between them, observed on 204; the renderer's per-bucket source pick
    # dedupes the seam, same as asp). Flushing at every create keeps each
    # snap self-contained and bounds query cost to one interval. Neither
    # table available (PG / enable_asp off) -> \copy errors swallowed ->
    # no ash_*.csv -> renderer still shows the section with a no-data note.
    local ash_b ash_e _ash_prev="" _ts _d
    ash_e=$(date '+%F %T')
    # previous snap = the one with the LATEST ts, not the highest snap_id: ids
    # are usually monotonic with time, but manual --root mixes and guard
    # discards (id allocated then thrown away) can break that assumption.
    # '%F %T' strings compare chronologically as plain strings.
    for _d in "${target%/*}"/snap_*; do
        [ -f "$_d/meta.json" ] || continue
        [ "$_d" = "$target" ] && continue
        _ts=$(sed -n 's/.*"ts" *: *"\([^"]*\)".*/\1/p' "$_d/meta.json" 2>/dev/null | head -1)
        [ -z "$_ts" ] && continue
        if [ -z "$_ash_prev" ] || [[ "$_ts" > "$_ash_prev" ]]; then
            _ash_prev="$_ts"
        fi
    done
    if [ -n "$_ash_prev" ]; then ash_b="$_ash_prev"; else ash_b=$(date -d '-60 minutes' '+%F %T'); fi
    # local_active_session schema version (same probe the asp command uses):
    # 3 = cur_event+state (204), 2 = cur_event only, 4 = event, 0 = missing.
    # Drives the waitchain query's condition substitution below.
    local ash_las_flag ash_c1 ash_c6 ash_c7 ash_c8 ash_c9 ash_ce
    ash_las_flag=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -qAtXc "select is_event + is_curevent + is_state as las_flag from (select coalesce(sum(case when attname='event' then 4 else 0 end),0) is_event, coalesce(sum(case when attname='cur_event' then 2 else 0 end),0) is_curevent, coalesce(sum(case when attname='state' then 1 else 0 end),0) is_state from pg_attribute a, pg_class b, pg_namespace c where a.attrelid=b.oid and b.relnamespace=c.oid and b.relname='local_active_session' and c.nspname='dbe_perf')" 2>/dev/null)
    case "$ash_las_flag" in
        3) ash_c1="state='active'"; ash_c6="a.state='active'"; ash_c7="las.state='active'"
           ash_c8="a.xact_start_time::timestamp(0)"; ash_c9="las.xact_start_time::timestamp(0)"; ash_ce="a.cur_event";;
        2) ash_c1="1=1"; ash_c6="1=1"; ash_c7="1=1"; ash_c8="' '"; ash_c9="' '"; ash_ce="a.cur_event";;
        4) ash_c1="1=1"; ash_c6="1=1"; ash_c7="1=1"; ash_c8="' '"; ash_c9="' '"; ash_ce="a.event";;
        *) ash_c1="1=1"; ash_c6="1=1"; ash_c7="1=1"; ash_c8="' '"; ash_c9="' '"; ash_ce="a.cur_event";;
    esac
    # ---- gs_asp schema probe (user 2026-10-20, G100 2.2.10): unlike las, the
    # gs_asp half of the primary-branch ASH queries historically hardcoded
    # a.state/a.event -- on kernels whose gs_asp lacks 'state' (G100 2.2.10)
    # all three \copy failed and the report's ASH section went empty. Same
    # treatment as las above: probe once, substitute. state missing -> 1=1
    # (the identical degradation the las flag 2/4 branches already ship --
    # active_cnt then equals cnt, ash_event still drops none/wait cmd);
    # event expression prefers event, falls back to cur_event (las default).
    local gs_flag gs_c6 gs_c6u gs_ce
    gs_flag=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -qAtXc "select coalesce(sum(case when a.attname='state' then 4 else 0 end),0) + coalesce(sum(case when a.attname='event' then 2 else 0 end),0) + coalesce(sum(case when a.attname='cur_event' then 1 else 0 end),0) as gs_flag from pg_attribute a, pg_class b, pg_namespace c where a.attrelid=b.oid and b.relnamespace=c.oid and b.relname='gs_asp' and c.nspname='pg_catalog'" 2>/dev/null)
    case "$gs_flag" in
        ''|*[!0-9]*) gs_flag=0;;
    esac
    gs_c6="1=1"; gs_c6u="1=1"; gs_ce="a.cur_event"
    [ $((gs_flag & 4)) -ne 0 ] && { gs_c6="a.state='active'"; gs_c6u="state='active'"; }
    [ $((gs_flag & 2)) -ne 0 ] && gs_ce="a.event"

    # waitchain root-blocker annotation, same rule as `asp waitchain`: full
    # sessid(a/iit(xact_start)) only when the source carries BOTH columns
    # (probed per source); G100 2.2.10 (neither column on gs_asp nor
    # local_active_session) gets the bare sessionid. Per-source expressions
    # also unbreak the merged variant's gs_part on mixed kernels, which
    # used the las-side column refs unconditionally.
    case "$ash_las_flag" in ''|*[!0-9]*) ash_las_flag=0;; esac
    local ash_xact_l ash_xact_g
    ash_xact_l=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -qAtXc "select 1 from pg_attribute a,pg_class b,pg_namespace c where a.attrelid=b.oid and b.relnamespace=c.oid and b.relname='local_active_session' and c.nspname='dbe_perf' and a.attname='xact_start_time' limit 1" 2>/dev/null)
    ash_xact_g=$(PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -qAtXc "select 1 from pg_attribute a,pg_class b,pg_namespace c where a.attrelid=b.oid and b.relnamespace=c.oid and b.relname='gs_asp' and c.nspname='pg_catalog' and a.attname='xact_start_time' limit 1" 2>/dev/null)
    local ash_wcsuf_l="las.sessionid::text"
    local ash_wcsuf_g="las.sessionid::text"
    if [[ "$ash_xact_l" = 1 && $((ash_las_flag & 1)) -ne 0 ]]; then
        ash_wcsuf_l="CONCAT(las.sessionid::text, '(', case when $ash_c7 then 'a' else 'iit' end, '(', las.xact_start_time::timestamp(0)::text, '))')"
    fi
    if [[ "$ash_xact_g" = 1 && $((gs_flag & 4)) -ne 0 ]]; then
        ash_wcsuf_g="CONCAT(las.sessionid::text, '(', case when las.state='active' then 'a' else 'iit' end, '(', las.xact_start_time::timestamp(0)::text, '))')"
    fi
    # ---- pg_replication_slots confirmed_flush probe (user 2026-10-20, G100
    # 2.2.10): that kernel's view ends at dummy_standby -- no confirmed_flush.
    # Placeholder keeps the 10-column csv/log grammar (and the renderer)
    # untouched; kernels with the column keep the identical query.
    local slots_cf="'' as confirmed_flush"
    PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres -qAtXc "select 1 from pg_attribute a, pg_class b, pg_namespace c where a.attrelid=b.oid and b.relnamespace=c.oid and b.relname='pg_replication_slots' and c.nspname='pg_catalog' and a.attname='confirmed_flush' limit 1" 2>/dev/null | grep -qx 1 && slots_cf="confirmed_flush"
    # ---- DB: \copy views to CSV with header (column order stable per view) ----
    # unquoted heredoc so $dbd expands; no other $ in the SQL. psql continues
    # past a missing view (no ON_ERROR_STOP) -> we warn about empty CSVs below.
    PGCONNECT_TIMEOUT=$_ct PGOPTIONS="$_st" psql -d postgres 2>&1 <<PSQL | grep -vE '^(COPY [0-9]+)?$' >&2 || true
-- statement: FULL numeric detail, query column dropped -- text lives in the
-- shared per-root sql_text.csv (filled by the merge step below, driven by the
-- keys in this file -- ALL texts, no top-N filter). 95% of the old file was
-- text; numbers-only keeps every row so sum-of-delta stays the exact pct base
-- (2026-09-09-awr-statement-slim-design.md).
\copy (SELECT user_name, unique_sql_id, n_calls, n_blocks_fetched, n_blocks_hit, n_soft_parse, n_hard_parse, db_time, cpu_time, execution_time, plan_time, data_io_time, n_returned_rows, sort_time, hash_time FROM dbe_perf.statement) TO '$dbd/statement.csv' WITH CSV HEADER
-- sort/hash work-mem + temp-spill per unique sql (KB; separate file so kernels
-- without these columns degrade to a skipped section, never a broken
-- statement.csv). Kernel instruments Sort executor nodes + HashJoin only;
