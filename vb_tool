        ;;
    asp)
        if [[ "$2" == "-help" || "$2" == "--help" ]]; then
            asp_help
            exit 0
        fi
        if [ -z "$2" ]; then
            echo "Error: asp requires a type parameter" >&2
            asp_help
            exit 1
        fi
        if ! run_asp "${@:2}"; then
            asp_help
            exit 1
        fi
        ;;
      sqltext)
            if [[ "$2" == "-help" || "$2" == "--help" ]]; then
