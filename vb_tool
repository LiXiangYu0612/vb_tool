run_kill_sessions() {
    CONDITIONS=()
    PSQL_OPTS=()

    while getopts ":i:s:p:q:d:abu:t:" opt; do
      case $opt in
        i) CONDITIONS+=("client_addr = ''$OPTARG'' and datname not in (''postgres'',''vastbase'',''panweidb'')") ;;
        s) case "$OPTARG" in
             a)    SF="active" ;;
             i)    SF="idle" ;;
             iit)  SF="idle in transaction" ;;
             iita) SF="idle in transaction (aborted)" ;;
             *)    SF="$OPTARG" ;;   # full name or prefix
           esac
           if [ "$SF" = "$OPTARG" ]; then
             # user-supplied string: exact OR prefix match ("id" hits all idle* states)
             CONDITIONS+=("(state = ''$SF'' or state like ''$SF%'') and datname not in (''postgres'',''vastbase'',''panweidb'')")
           else
             # known abbreviation: exact match only ("i" is pure idle, NOT idle-in-transaction)
             CONDITIONS+=("state = ''$SF'' and datname not in (''postgres'',''vastbase'',''panweidb'')")
           fi ;;
        p) CONDITIONS+=("pid = ''$OPTARG''") ;;
        q) CONDITIONS+=("unique_sql_id = ''$OPTARG''") ;;
        d) CONDITIONS+=("application_name = ''$OPTARG'' and datname not in (''postgres'',''vastbase'',''panweidb'')") ;;
        a) CONDITIONS+=("datname not in (''postgres'',''vastbase'',''panweidb'')") ;;
        b) MODE_BLOCKER=1 ;;
        u) CONDITIONS+=("usename = ''$OPTARG'' and datname not in (''postgres'',''vastbase'',''panweidb'')") ;;
        t) CONDITIONS+=("EXTRACT(EPOCH FROM (now() - xact_start))>$OPTARG and datname not in (''postgres'',''vastbase'',''panweidb'')") ;;
        \?) echo "Invalid option: -$OPTARG" >&2; exit 1 ;;
        :) echo "Option -$OPTARG requires argument" >&2; exit 1 ;;
      esac
    done
    shift $((OPTIND-1))
    PSQL_OPTS=("$@")

    if [ -n "$MODE_BLOCKER" ]; then
      # root blockers of current lock wait chains (same pairs/roots logic as
      # lockchain); live sessions are terminated, prepared roots are reported
      # only (pg_terminate_backend cannot clear a prepared transaction).
      psql -d postgres "${PSQL_OPTS[@]}" <<'EOF'
DO $$
DECLARE
  r record; result boolean; n_roots int := 0; killed int := 0; n_2pc int := 0;
BEGIN
  FOR r IN
    WITH l AS (
      SELECT sessionid, pid, locktype, granted, virtualtransaction,
        ROW(locktype,database,relation,page,tuple,virtualxid,transactionid,classid,objid,objsubid) obj,
        CASE WHEN pid IS NULL AND virtualtransaction LIKE '-1/%'
             THEN 'P:' || split_part(virtualtransaction, '/', 2)
             ELSE COALESCE(sessionid::text, 'pid:' || pid::text) END AS holder
      FROM pg_locks
    ), pairs AS (
      SELECT DISTINCT w.holder waiter, l.holder locker
      FROM l w
      JOIN l ON l.obj IS NOT DISTINCT FROM w.obj AND l.locktype=w.locktype
            AND l.holder IS NOT NULL AND w.holder IS NOT NULL
            AND l.holder IS DISTINCT FROM w.holder AND l.granted
      WHERE NOT w.granted
    ), roots AS (
      SELECT DISTINCT locker FROM pairs p
      WHERE NOT EXISTS (SELECT 1 FROM pairs WHERE waiter=p.locker)
    )
    SELECT rt.locker, a.pid, a.usename, a.datname,
           (clock_timestamp()-a.xact_start)::interval(3) AS xage,
           (SELECT count(*) FROM pairs WHERE locker=rt.locker) AS direct_waiters,
           substr(regexp_replace(regexp_replace(coalesce(a.query,''),'(\r|\n)+',' '),' {2,}',' '),1,60) AS q,
           px.gid
    FROM roots rt
    LEFT JOIN pg_stat_activity a ON a.sessionid::text = rt.locker AND a.pid <> pg_backend_pid()
    LEFT JOIN pg_prepared_xacts px ON rt.locker = 'P:' || px.transaction::text
  LOOP
    n_roots := n_roots + 1;
    IF r.locker LIKE 'P:%' THEN
      n_2pc := n_2pc + 1;
      RAISE NOTICE 'root blocker % is PREPARED (gid %, % waiter(s)): cannot kill - use ROLLBACK PREPARED', r.locker, r.gid, r.direct_waiters;
    ELSIF r.pid IS NOT NULL THEN
      BEGIN
        EXECUTE 'SELECT pg_terminate_backend(' || r.pid || ')' INTO result;
        IF result THEN
          killed := killed + 1;
          RAISE NOTICE 'root blocker % (% %, xact %, % waiter(s)): TERMINATED - %', r.locker, r.usename, r.datname, r.xage, r.direct_waiters, r.q;
        END IF;
      EXCEPTION WHEN OTHERS THEN
        RAISE NOTICE 'root blocker %: terminate failed: %', r.locker, SQLERRM;
      END;
    ELSE
      RAISE NOTICE 'root blocker %: no live backend (holder gone), nothing to kill', r.locker;
    END IF;
  END LOOP;
  IF n_roots = 0 THEN
    RAISE NOTICE 'no lock wait chains, nothing to kill';
  ELSE
    RAISE NOTICE 'root blockers: % (terminated %, prepared %)', n_roots, killed, n_2pc;
  END IF;
END;
$$;
EOF
      return 0
    fi

    if [ ${#CONDITIONS[@]} -eq 0 ]; then
      echo "Error: At least one filter condition required"
      kill_help
      exit 1
    fi

    WHERE_CLAUSE=''
    
    for condition in "${CONDITIONS[@]}"; do
      if [ -z "$WHERE_CLAUSE" ]; then
        WHERE_CLAUSE="$condition"
      else
        WHERE_CLAUSE="$WHERE_CLAUSE AND $condition"
      fi
    done

    psql -d postgres "${PSQL_OPTS[@]}" <<EOF
DO \$\$
DECLARE
  r record;
  result boolean;
  total int := 0;
  killed int := 0;
BEGIN
  FOR r IN EXECUTE 'SELECT pid FROM pg_stat_activity WHERE $WHERE_CLAUSE AND PID<>pg_backend_pid()'
  LOOP
    BEGIN
      EXECUTE 'SELECT pg_terminate_backend(' || r.pid || ')' INTO result;
      IF result THEN 
        killed := killed + 1;
      END IF;
    EXCEPTION WHEN OTHERS THEN
      RAISE NOTICE 'Error terminating PID %: %', r.pid, SQLERRM;
    END;
  END LOOP;
  
  RAISE NOTICE 'Terminated % sessions', killed;
END;
\$\$;
EOF
}

run_lock_details() {
    # -q: VastBase psql echoes every \pset ("Showing only tuples." etc.)
    psql -q -d postgres -P footer=off <<EOF
\pset format unaligned
\pset tuples_only on
\echo '=========================='
\echo 'detailed lock information'
\echo '=========================='
WITH t_wait AS (
  SELECT a.mode,a.locktype,a.database,a.relation,a.page,a.tuple,a.classid,a.granted,
         a.objid,a.objsubid,a.pid,a.virtualtransaction,a.virtualxid,a.transactionid,a.fastpath,
         b.state,b.query,b.xact_start,b.query_start,b.usename,b.datname,b.client_addr,b.client_port,b.application_name
  FROM pg_locks a,pg_stat_activity b WHERE a.pid=b.pid AND NOT a.granted
),
t_run AS (
  /* 2PC: prepared transactions hold locks with pid IS NULL + vxid '-1/<xid>'
     (same signature as lockchain); plain pid join dropped those holders */
  SELECT a.mode,a.locktype,a.database,a.relation,a.page,a.tuple,a.classid,a.granted,
         a.objid,a.objsubid,a.pid,a.virtualtransaction,a.virtualxid,a.transactionid,a.fastpath,
         CASE WHEN b.pid IS NOT NULL THEN b.state
              WHEN px.gid IS NOT NULL THEN '2pc-prepared' ELSE NULL END state,
         b.query,
         COALESCE(b.xact_start,px.prepared) xact_start,b.query_start,
         COALESCE(b.usename,px.owner) usename,b.datname,b.client_addr,b.client_port,b.application_name
  FROM pg_locks a
  LEFT JOIN pg_stat_activity b ON a.pid=b.pid
  LEFT JOIN pg_prepared_xacts px ON a.pid IS NULL
       AND a.virtualtransaction LIKE '-1/%'
       AND px.transaction::text = split_part(a.virtualtransaction, '/', 2)
  WHERE a.granted
),
t_overlap AS (
  SELECT r.* FROM t_wait w JOIN t_run r ON
  (
    r.locktype IS NOT DISTINCT FROM w.locktype AND
    r.database IS NOT DISTINCT FROM w.database AND
    r.relation IS NOT DISTINCT FROM w.relation AND
    r.page IS NOT DISTINCT FROM w.page AND
    r.tuple IS NOT DISTINCT FROM w.tuple AND
    r.virtualxid IS NOT DISTINCT FROM w.virtualxid AND
    r.transactionid IS NOT DISTINCT FROM w.transactionid AND
    r.classid IS NOT DISTINCT FROM w.classid AND
    r.objid IS NOT DISTINCT FROM w.objid AND
    r.objsubid IS NOT DISTINCT FROM w.objsubid AND
    r.pid IS DISTINCT FROM w.pid
  )
),
t_unionall AS (
  SELECT r.* FROM t_overlap r
  UNION ALL
  SELECT w.* FROM t_wait w
)
SELECT 
  'Lock Type: ' || COALESCE(locktype::text, 'NULL') || E'\n' ||
  'Database: ' || COALESCE(datname::text, 'NULL') || E'\n' ||
  'Relation: ' || COALESCE(relation::regclass::text, 'NULL') || E'\n' ||
  'Page: ' || COALESCE(page::text, 'NULL') || E'\n' ||
  'Tuple: ' || COALESCE(tuple::text, 'NULL') || E'\n' ||
  'VirtualXID: ' || COALESCE(virtualxid::text, 'NULL') || E'\n' ||
  'TransactionID: ' || COALESCE(transactionid::text, 'NULL') || E'\n' ||
  'ClassID: ' || COALESCE(classid::regclass::text, 'NULL') || E'\n' ||
  'ObjID: ' || COALESCE(objid::text, 'NULL') || E'\n' ||
  'ObjSubID: ' || COALESCE(objsubid::text, 'NULL') || E'\n' ||
  E'\nLock Holders/Waiters:\n' || 
  string_agg(
    'PID: ' || COALESCE(pid::text, 'NULL') || E'\n' ||
    'Lock Granted: ' || COALESCE(granted::text, 'NULL') || ' , Mode: ' || COALESCE(mode::text, 'NULL') || ' , FastPath: ' || COALESCE(fastpath::text, 'NULL') || E'\n' ||
    'VirtualTransaction: ' || COALESCE(virtualtransaction::text, 'NULL') || ' , State: ' || COALESCE(state::text, 'NULL') || E'\n' ||
    'User: ' || COALESCE(usename::text, 'NULL') || ' , Client: ' || COALESCE(client_addr::text, 'NULL') || ':' || COALESCE(client_port::text, 'NULL') || E'\n' ||
    'Application: ' || COALESCE(application_name::text, 'NULL') || E'\n' ||
    'Xact Start: ' || COALESCE(xact_start::text, 'NULL') || ' , Query Start: ' || COALESCE(query_start::text, 'NULL') || E'\n' ||
    'Xact Duration: ' || COALESCE((now()-xact_start)::text, 'NULL') || ' , Query Duration: ' || COALESCE((now()-query_start)::text, 'NULL') || E'\n' ||
    'Query: ' || E'\n' || COALESCE(substr(regexp_replace(regexp_replace(query, E'[\\n\\r]+', ' ', 'g'), ' ',''), 1, 100), 'NULL') || E'\n' ||
    E'\n----------------------------------------\n',
    E'\n' ORDER BY 
    (CASE mode
      WHEN 'INVALID' THEN 0
      WHEN 'AccessShareLock' THEN 1
      WHEN 'RowShareLock' THEN 2
      WHEN 'RowExclusiveLock' THEN 3
      WHEN 'ShareUpdateExclusiveLock' THEN 4
      WHEN 'ShareLock' THEN 5
      WHEN 'ShareRowExclusiveLock' THEN 6
      WHEN 'ExclusiveLock' THEN 7
      WHEN 'AccessExclusiveLock' THEN 8
      ELSE 0
    END) DESC,
    (CASE WHEN granted THEN 0 ELSE 1 END)
  ) AS lock_conflict
FROM t_unionall
GROUP BY locktype,datname,relation,page,tuple,virtualxid,transactionid::text,classid,objid,objsubid;
EOF
}

