                        hiddenRows[i].classList.remove('period-row-hidden');
                    }}
                    
                    const remainingHidden = table.querySelectorAll('tr.period-row-hidden:not(.row-hidden)').length;
                    if (remainingHidden === 0) {{
                        arrowEl.classList.add('expanded');
