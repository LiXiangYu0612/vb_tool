            def _fd_cell(v, is_reg):
                # "live(deleted deleted)" for the reg family, plain otherwise
                return "%d(%d deleted)" % (v[0], v[1]) if is_reg else "%d" % v[0]
            def _fd_reg_subs(*maps):
                out = []
                for m in maps:
