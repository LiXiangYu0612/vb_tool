        print(f"[DEBUG] sqlhc tabsize 完整 SQL:\n{query}", file=sys.stderr)
    args = _append_vsql_commands(
        ['vsql', '-d', db_name, '-X', '-P', 'footer=off'], query)
    try:
        # 脚本内全部语句经 _append_vsql_commands 合并为单个 -c 执行(多个 -c 仅输出最后一条)。
        process = subprocess.Popen(
            args, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            universal_newlines=True
        )
        stdout, stderr = process.communicate(timeout=timeout)
    except FileNotFoundError:
        return "vsql not found, skip tabsize."
    except subprocess.TimeoutExpired:
        process.kill()
        process.communicate()
        if debug:
            print(f"[DEBUG] sqlhc tabsize: 单查超时 {timeout}s，已终止", file=sys.stderr)
