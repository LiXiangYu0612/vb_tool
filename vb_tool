def _parse_detail_arg(value):
    """解析 --detail 参数值。

    合法取值:
        top       -> ('top', 20)      # 默认 Top20
        top:N     -> ('top', N)       # 自定义 Top N
        all       -> ('all', None)    # 所有慢 SQL

    Returns:
        tuple: (mode, topn)
    """
    if value is None:
        return ('top', 20)  # nargs='?' 时 const 兜底, 正常不会走到
    v = str(value).strip().lower()
    if v == 'top':
        return ('top', 20)
    if v == 'all':
        return ('all', None)
    if v.startswith('top:'):
        n_str = v[4:].strip()
        try:
            n = int(n_str)
            if n <= 0:
                raise ValueError
            return ('top', n)
        except ValueError:
            raise argparse.ArgumentTypeError(
                f"--detail top:N 中 N 必须为正整数, 收到: '{n_str}'")
    raise argparse.ArgumentTypeError(
        f"无效的 --detail 取值 '{value}', 支持: top / top:N / all")


