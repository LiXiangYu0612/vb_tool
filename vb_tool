                    # (user's call 2026-09-27: "主页面的Enter也等于cmd" -- it used to
                    # refresh). On a SUB-screen Enter is still the manual refresh
                    # (user's call 2026-09-26), which is why that branch falls through
                    # to the render below. A raw \r only reaches here on a terminal
                    # with icrnl off; with icrnl on (the norm) Enter is an EMPTY key
                    # and lands in the "" branch below.
                    if [ "$screen" = "main" ]; then
                        # ★光标激活时 Enter = 进所选子屏 (用户令 2026-11-17); 未激活
                        #   = 原命令行 (用户令"原有进入子屏的方式也支持", 2026-09-27
                        #   "主页面的Enter也等于cmd"语义不变)。
                        if [ "${hint_cur:-0}" -ge 1 ] 2>/dev/null; then
                            screen=${_hint_screens[$((hint_cur-1))]}
                            sub_first=1
                        else
                            _vtop_cmd_exec ""
                            [ "$_vtop_cmd_quit" = "1" ] && break
                        fi
                    fi
                    ;;
                "")
