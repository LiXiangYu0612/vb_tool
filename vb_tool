def _fs_otype(r):
    """object_type cell (user-named column): partitioned tables get their own
    label via VastBase's Oracle-compat pg_class.parttype ('p' partitioned /
    's' subpartitioned / 'n' ordinary)."""
    if not r.get("relkind"):
        return "-"
    if r["relkind"] == "m":
        return "matview"
    if r.get("parttype") in ("p", "s"):
        return "partitioned table"
    return "table"

# ---- Kernel messages (dmesg) ---- pattern categories merged from the
# first-pass list AND kernel-source-verified strings (arch/x86/mm/fault.c
# "segfault at", sch_generic.c "NETDEV WATCHDOG", tcp_input.c "Possible SYN
# flooding", mm/oom_kill.c "Killed process", watchdog.c "BUG: soft lockup",
# rcu/tree_stall.h "self-detected stall", therm_throt "clock throttled");
# 204 live-buffer tested: zero false positives on a healthy 975-line buffer.
_DMESG_PATTERNS = [
    ("Kernel crash", r"kernel panic|oops:|kernel bug|general protection fault|unable to handle kernel|call trace"),
    ("Memory/OOM", r"out of memory|oom-killer|killed process|memory cgroup out of memory|page allocation failure|bad page state|slab out of memory|oom_reaper"),
    ("Process crash", r"segfault at|traps:|core dump"),
    ("Storage", r"i/o error|medium error|critical (target|medium) error|device offline|rejecting i/o|timeout.*(abort|reset)|task abort|scsi.*(error|reset|abort)|nvme.*(timeout|resetting)|(mpt3sas|megaraid|qla2xxx|aacraid|hpsa).*(error|fail|down)|write same failed|lost page write|device-mapper.*(error|fail)"),
    ("Multipath", r"path (failed|reinstate)|multipath.*(fail|error)"),
    ("Filesystem", r"ext4-fs (error|warning)|xfs.*(error|corrupt|log_force)|journal has aborted|metadata corruption|(remounting|filesystem).*read-only|overlayfs.*error"),
    ("CPU/Sched", r"soft lockup|hard lockup|nmi watchdog|rcu.*stall|detected stall|blocked for more than|hung task|scheduling while atomic|stuck on cpu"),
    ("Network", r"netdev watchdog|transmit (queue .*timed|timed)|syn flooding|orphaned sockets|tcp: out of memory|conntrack.*(full|dropping)|nic link is down|link is (down|not ready)|reset adapter|link status definitely|bond.*(down|up)"),
    ("Power/HW", r"machine check|mce:|hardware error|edac|ecc.*(error|corrected|uncorrected)|temperature above threshold|clock throttled|power limit|thermal|clocksource.*unstable"),
]
_DMESG_EXCLUDE = re.compile(r"^(audit:|selinux:|systemd\[|type=1400)", re.I)
# context lines that ride the previous matched event even when the kernel
# split the dump into separately-timestamped printks (newer kernels do):
# stack frames (" func+0x1a/0x30"), register/code dumps, trace headers
_DMESG_CONTEXT = re.compile(
    r"^\s*[\w.\[\]:]+\+0x[0-9a-fA-F]+/"
    r"|^(Code|RSP|RIP|Call Trace|CPU|PGD|P4D|Oops|Hardware name|Comm|Tainted|Mem-Info|Modules|CR2|DS|ES|FS|GS):?"
    r"|^\s*\?+$|^---+ cut here ---")
_DMESG_REBOOT = re.compile(r"^Linux version ", re.I)
_DMESG_TS = re.compile(r"^\[([A-Z][a-z]{2} [A-Z][a-z]{2} +\d+ \d\d:\d\d:\d\d \d{4})\] ?(.*)$")

def load_dmesg_chunks(win, repl_dir):
    """Union the INCREMENTAL os/dmesg chunks of every snap with ts in
    (begin_ts, end_ts] -- the collector stores only lines newer than the
    previous snap's last line, so the union tiles the window exactly (same
    model as the ASH flush). Returns ([(epoch, text, cont)], statuses-set);
    statuses in {"ok","denied","nogawk"} per contributing chunk."""
    if not repl_dir:
        return [], None
    from datetime import datetime
    bts = str(win["meta"].get("begin_ts", ""))
    ets = str(win["meta"].get("end_ts", ""))
    lines, statuses = [], set()
    for d in sorted(glob.glob(os.path.join(repl_dir, "snap_*"))):
        mp = os.path.join(d, "meta.json")
        f = os.path.join(d, "os", "dmesg")
        if not os.path.isfile(mp) or not os.path.isfile(f):
            continue
        try:
            ts = json.load(open(mp)).get("ts", "")
        except Exception:
            continue
        if not (bts < ts <= ets):
            continue
        try:
            txt = open(f, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        _last_e = None
        for ln in txt.splitlines():
            if ln.startswith("status "):
                statuses.add(ln[7:].strip())
                continue
            m = _DMESG_TS.match(ln)
            if m:
                try:
                    e = datetime.strptime(m.group(1), "%a %b %d %H:%M:%S %Y").timestamp()
                except ValueError:
                    continue
                _last_e = e
                lines.append((e, m.group(2), False))
            elif _last_e is not None:
                # continuation line (call-trace stack frames, Code:/RSP:
                # dumps carry no timestamp of their own) rides the parent
                lines.append((_last_e, ln, True))
    # dedupe insurance: overlapping chunk boundaries (manual snaps / floor
    # races) must not duplicate an event row -- preserve first-seen order,
    # then a STABLE sort on epoch only: intra-event line order (trace
    # frames!) must survive, sorting by text would alphabetize the stack
    seen = set()
    lines = [l for l in lines if not (l in seen or seen.add(l))]
    lines.sort(key=lambda t: t[0])
    return lines, statuses

def loadprofile_iostat_rows(win, duration):
    """(label, begin, end, delta, per_sec, mode, ok) rows from rel_iostat.csv --
    ONE cumulative row captured from pg_catalog.get_local_rel_iostat() (the
    kernel fileIOStat DIRECT counters, uncapped; replaced the 2000-slot-LRU
    gs_file_stat per-file capture on 2026-09-16). mode 'count' = IO operations
    (fmt_int/fmt_rate), 'blocks' = 8K pages (fmt_blocks/fmt_blocks_ps composites,
    Begin/End stay raw page counts). ok False on pre-change snaps (no csv) ->
    callers print '-' cells."""
    def _sum(phase, col):
        return sum(to_num(r.get(col, 0)) for r in win["db"].get((phase, "rel_iostat"), []))
    ok = bool(win["db"].get(("begin", "rel_iostat"))) and bool(win["db"].get(("end", "rel_iostat")))
    rows = []
    for label, col, mode in (("read iops", "phyrds", "count"),
                             ("write iops", "phywrts", "count"),
                             ("read data", "phyblkrd", "blocks"),
                             ("write data", "phyblkwrt", "blocks")):
        b, e = _sum("begin", col), _sum("end", col)
        rows.append((label, b, e, e - b, ((e - b) / duration) if duration else 0.0, mode, ok))
    return rows

def loadprofile_wal_pw_rows(win, duration):
    """(label, begin, end, delta, per_sec, ok, as_bytes, as_pages) tuples for the WAL-write and
    pagewriter-flush Load Profile rows (v2.4.5). WAL = file_redo_iostat
    (= gs_redo_stat = pg_stat_get_redo_stat, XLogWrite cumulative under
    WALWriteLock, primary-valid); pagewriter = pagewriter.csv
    pgwr_actual_flush_total_num (cumulative pages flushed by the pagewriter --
    an actual page count, unlike ckpt_redo_point which is an LSN POSITION).
    ok=False only on the writetim row when EITHER side lacks writetim
    (legacy snaps have no writetim column; a mixed begin/end window must not
    inflate the delta to the full END cumulative) -> caller prints '-' cells.
    per_sec=0 when duration<=0."""
    def _sum(phase, table, col):
        return sum(to_num(r.get(col, 0)) for r in win["db"].get((phase, table), []))
    # ★双侧存在性守卫 (2026-11-26, 与 loadprofile_iostat_rows 同规矩): 混代窗口
    #   (begin 快照早于该表上线)一侧空表时, 老写法 begin 按 0 求和 ⇒ delta = END
    #   自启动累积值冒充窗口增量。整表缺失 → ok=False → 调用方印 '-'。
    io_ok = (bool(win["db"].get(("begin", "file_redo_iostat")))
             and bool(win["db"].get(("end", "file_redo_iostat"))))
    tim_ok = (any("writetim" in r for r in win["db"].get(("end", "file_redo_iostat"), []))
              and any("writetim" in r for r in win["db"].get(("begin", "file_redo_iostat"), [])))
    rows = []
    for label, table, col in (("WAL writes", "file_redo_iostat", "phywrts"),
                              ("WAL blocks written", "file_redo_iostat", "phyblkwrt"),
                              ("WAL write time (ms)", "file_redo_iostat", "writetim")):
        b, e = _sum("begin", table, col), _sum("end", table, col)
        ok = io_ok and ((col != "writetim") or tim_ok)
        rows.append((label, b, e, e - b, ((e - b) / duration) if duration else 0.0, ok, False, False))
    # pagewriter: Begin/End stay RAW PAGE COUNTS (user 2026-09-15: keep the
    # original unit there); only Delta Total / Delta Per Second are byte-scaled
    # (pages x BLCKSZ 8K) and rendered via fmt_bytes like the 'WAL written
    # (xlog insert lsn)' row's deltas
    _pb = _sum("begin", "pagewriter", "pgwr_actual_flush_total_num")
    _pe = _sum("end", "pagewriter", "pgwr_actual_flush_total_num")
    _pd = _pe - _pb   # raw PAGES; renderer prints pages(bytes) via as_pages flag
    # ★同上双侧守卫: begin 侧无 pagewriter.csv(混代窗口)时原样 ok=True ⇒ delta
    #   = END 累计刷页数冒充窗口增量
    pw_ok = (bool(win["db"].get(("begin", "pagewriter")))
             and bool(win["db"].get(("end", "pagewriter"))))
    rows.append(("pagewriter flushed", _pb, _pe, _pd,
                 (_pd / duration) if duration else 0.0, pw_ok, False, True))
    return rows

# ---- Long-txn + callstack samplers (awrrpt only; 5-min cadence, written by
# _awr_lt_stack_sample in bash, piggybacked on the per-minute sampler cron) ----
# lt_<YYYYMMDD>.log[.gz] row grammar (comma):
#   data : ts,long_cnt,oldest_pid,oldest_xact_start,oldest_state,
#          oldest_wait_status,oldest_wait_event,oldest_unique_sql_id,
#          oldestxmin,txid_current    (10 fields; oldest_* empty = no open txn)
#   error: ts,error
# stack_<YYYYMMDD>.log[.gz] row grammar (PIPE-separated -- C++ symbols and
# wait strings can hold commas, gs_stack frames never hold '|'):
#   ts|be|thread_name|tid|wait_status|wait_event|chain
#   ts|fe|wait_event|pid|unique_sql_id|chain
#   ts|be|error / ts|fe|error   (that group's query failed)
#   ts|st|error|msg             the ONE gs_stack fetch psql failed (it covers
#          the chains of this sample's be+av+fe rows); msg = first stderr
#          line, '|' and tabs stripped, 180 chars. Rows still go out with
#          empty chains -- the msg says why they are empty

def _iter_lt_stack_logs(repl_dir, prefix, begin_ts, end_ts, files):
    """Shared day-log reader for the lt_/stack_ samplers: yields lines of every
    matching .log/.log.gz with the same pre-filter-by-day discipline as
    load_repl_samples(); row-level ts filtering is the caller's."""
    if not repl_dir or not os.path.isdir(repl_dir):
        return
    bd = str(begin_ts or "")[:10].replace("-", "")
    ed = str(end_ts or "")[:10].replace("-", "")
    for f in sorted(glob.glob(os.path.join(repl_dir, prefix + "*.log")) +
                    glob.glob(os.path.join(repl_dir, prefix + "*.log.gz"))):
        m = re.search(re.escape(prefix) + r"(\d{8})\.log(\.gz)?$", f)
        if m:
            fd = m.group(1)
            if bd and fd < bd: continue
            if ed and fd > ed: continue
        try:
            if f.endswith(".gz"):
                with gzip.open(f, "rt") as fh:
                    lines = fh.read().splitlines()
            else:
                lines = open(f).read().splitlines()
        except Exception:
            continue
        files.append(os.path.basename(f))
        for ln in lines:
            yield ln

def load_lt_samples(repl_dir, begin_ts, end_ts):
    """Read lt_*.log[.gz] rows with ts in [begin_ts, end_ts] (inclusive). One
    row per 5-min sample. Returns {"rows":[(ts,kind,fields)], "n_data":N,
    "n_error":N, "files":[names]}."""
    out = {"rows": [], "n_data": 0, "n_error": 0, "files": []}
    for ln in _iter_lt_stack_logs(repl_dir, "lt_", begin_ts, end_ts, out["files"]):
        ln = ln.strip()
        if not ln: continue
        ts, rest = (ln.split(",", 1) + [""])[:2]
        if begin_ts and ts < str(begin_ts): continue
        if end_ts and ts > str(end_ts): continue
        if rest == "error":
            out["rows"].append((ts, "error", [])); out["n_error"] += 1
        elif ln.count(",") == 11:
            # strict 12-field data row (ts + 11 cols); anything else is dropped
            out["rows"].append((ts, "data", ln.split(",")[1:])); out["n_data"] += 1
        elif ln.count(",") == 12:
            # 2026-09-12 interim rows carried a recentxmin col (snapshot xmin,
            # removed): drop it -> [cnt,itx,act,pid..usi,oxmin,'',txid minus rxmin]
            g = ln.split(",")[1:]
            out["rows"].append((ts, "data", g[:10] + g[11:12])); out["n_data"] += 1
        elif ln.count(",") == 9:
            # legacy 10-field sampler rows (pre itx/active columns):
            # remap [cnt,pid..usi,oxmin,txid] -> [cnt,'','',pid..usi,oxmin,txid]
            g = ln.split(",")[1:]
            out["rows"].append((ts, "data", g[:1] + ["", ""] + g[1:7] + g[7:9]))
            out["n_data"] += 1
    return out

def load_stack_samples(repl_dir, begin_ts, end_ts):
    """Read stack_*.log[.gz] rows with ts in [begin_ts, end_ts] (inclusive).
    Returns {"be":[(ts,thread,tid,wait_status,wait_event,chain)],
    "fe":[(ts,wait_event,pid,unique_sql_id,chain)], "be_err":N, "fe_err":N,
    "st_err":N, "st_last":"msg" (the ONE gs_stack fetch psql covers be+av+fe
    chains; its failure used to hide behind 2>/dev/null and empty Stack cells),
    "files":[names]}."""
    out = {"be": [], "av": [], "fe": [], "be_err": 0, "fe_err": 0,
           "st_err": 0, "st_last": "", "files": []}
    for ln in _iter_lt_stack_logs(repl_dir, "stack_", begin_ts, end_ts, out["files"]):
        ln = ln.strip()
        if not ln: continue
        ts, rest = (ln.split("|", 1) + [""])[:2]
        if begin_ts and ts < str(begin_ts): continue
        if end_ts and ts > str(end_ts): continue
        p = rest.split("|")
        if p[0] == "av" and len(p) == 4:
            # autovac summary: worker count / SUM cpu / top-cpu worker's stack
            out["av"].append((ts, p[1], p[2], p[3]))
        elif p[0] == "be" and len(p) == 7:
            out["be"].append((ts, p[1], p[2], p[3], p[4], p[5], p[6]))
        elif p[0] == "be" and len(p) == 6:
            # older sampler rows carry no cpu field
            out["be"].append((ts, p[1], p[2], p[3], p[4], "", p[5]))
        elif p[0] == "fe" and len(p) == 6:
            if p[1] == "(no event)":
                continue   # retracted 2026-09-12 pick: hide rows older samplers logged
            out["fe"].append((ts, p[1], p[2], p[3], p[4], p[5]))
        elif p[0] == "fe" and len(p) == 5:
            # older sampler rows carry no event_cnt field
            out["fe"].append((ts, p[1], p[2], p[3], "", p[4]))
        elif len(p) >= 2 and p[0] == "st" and p[1] == "error":
            # stack-fetch failure row (gs_stack psql): counts every failed
            # 5-min fetch; st_last keeps the newest sanitized message
            out["st_err"] += 1
            if len(p) > 2 and p[2]:
                out["st_last"] = p[2]
        elif p == ["be", "error"]:
            out["be_err"] += 1
        elif p == ["fe", "error"]:
            out["fe_err"] += 1
    return out

def load_sessmem_samples(repl_dir, begin_ts, end_ts):
    """Read sessmem_*.log[.gz] rows with ts in [begin_ts, end_ts] (inclusive).
    One row per 5-min sample (written by _awr_lt_stack_sample's session-memory
    block, same lock/gate as lt_/stack_):
      ts|sessid|total_bytes|pid|usename|state|unique_sql_id|ctxs[|client_info]
        (data; client_info = application_name|client_addr|client_port, v2.4.7+)
      ts|unknown    query OK but empty output (user: empty -> unknown)
      ts|error      query failed
    ctxs = 'name(bytes), name(bytes), name(bytes)' (top 3 contexts by
    totalsize within that session)."""
    out = {"rows": [], "n_data": 0, "n_unknown": 0, "n_error": 0, "files": []}
    for ln in _iter_lt_stack_logs(repl_dir, "sessmem_", begin_ts, end_ts, out["files"]):
        ln = ln.strip()
        if not ln:
            continue
        ts, rest = (ln.split("|", 1) + [""])[:2]
        if begin_ts and ts < str(begin_ts):
            continue
        if end_ts and ts > str(end_ts):
            continue
        if rest == "error":
            out["rows"].append((ts, "error", [])); out["n_error"] += 1
        elif rest == "unknown":
            out["rows"].append((ts, "unknown", [])); out["n_unknown"] += 1
        else:
            p = rest.split("|")
            # first 7 fields are fixed (sessid..ctxs; ctxs itself never holds a
            # '|'); everything past field 7 is joined back together as the ONE
            # client_info field -- it uses '|' as its inner separator
            # (application_name|client_addr|client_port) by design, so a v2.4.7
            # row splits into 9-10 tokens. 7 tokens = pre-v2.4.7 row (no tail).
            if len(p) >= 7:
                out["rows"].append((ts, "data", p[:7] + ["|".join(p[7:])])); out["n_data"] += 1
            # anything else: malformed row (too few fields) -- dropped
    return out

def load_pw_samples(repl_dir, begin_ts, end_ts):
    """Read pw_*.log[.gz] rows with ts in [begin_ts, end_ts] (inclusive). One
    row per node per 5-min sample (written by _awr_lt_stack_sample's pagewriter
    block, same lock/gate as lt_/stack_/sessmem_):
      ts,node,actual_flush_total,last_flush,remain_dirty,queue_head_lsn,
      queue_rec_lsn,xlog_insert_lsn,ckpt_redo,db_start   (data, v2.5.16+)
      ts,node,...,ckpt_redo                              (data, legacy 9-field)
      ts,error                                           (query failed)
    db_start = pg_postmaster_start_time() -- restart guard: deltas are only
    valid between samples with the SAME start time (user 2026-10-21); legacy
    rows carry "" and fall back to the counter-went-backwards check alone.
    Also returns out["pre"]: per node, the LAST data row strictly BEFORE
    begin_ts (searched one day back -- the shared root-level day logs keep
    the series running across snapshot windows, so the first in-window
    sample can still be differenced against it)."""
    out = {"rows": [], "n_data": 0, "n_error": 0, "files": [], "pre": {}}
    # widen the day window one day back so the pre-begin baseline is reachable
    bd = str(begin_ts or "")[:10]
    try:
        import datetime as _dt
        bd_back = (_dt.datetime.strptime(bd, "%Y-%m-%d") - _dt.timedelta(days=1)).strftime("%Y-%m-%d")
    except ValueError:
        bd_back = ""
    pre_rows = []
    for ln in _iter_lt_stack_logs(repl_dir, "pw_", bd_back or begin_ts, end_ts, out["files"]):
        ln = ln.strip()
        if not ln: continue
        ts, rest = (ln.split(",", 1) + [""])[:2]
        if rest == "error":
            if begin_ts and ts >= str(begin_ts) and (not end_ts or ts <= str(end_ts)):
                out["rows"].append((ts, "error", [])); out["n_error"] += 1
            continue
        if ln.count(",") == 9:
            f = ln.split(",")[1:]          # v2.5.16+: ts + node + 8 cols
        elif ln.count(",") == 8:
            f = ln.split(",")[1:] + [""]   # legacy: no db_start col
        else:
            continue                       # malformed row -- dropped
        if begin_ts and ts < str(begin_ts):
            pre_rows.append((ts, f))       # pre-window baseline candidate
            continue
        if end_ts and ts > str(end_ts): continue
        out["rows"].append((ts, "data", f)); out["n_data"] += 1
    for ts, f in pre_rows:
        out["pre"][f[0] or "-"] = (ts, f)   # keep only the LAST per node
    return out

def _pw_endpoints(repl_dir, begin_ts, end_ts):
    """Per-node pagewriter state at the two window boundaries, read from the
    shared pw_<day>.log series (user 2026-10-21: snapshots no longer capture
    pagewriter.csv): the LAST sample at-or-before begin_ts, and the LAST one
    at-or-before end_ts. Returns {"begin": {node:(ts,total,dbstart)},
    "end": {...}}; nodes present on only one side are dropped (no delta)."""
    from collections import OrderedDict
    sides = {"begin": {}, "end": {}}
    b, e = str(begin_ts or ""), str(end_ts or "")
    day_back = ""
    try:
        import datetime as _dt
        day_back = (_dt.datetime.strptime(b[:10], "%Y-%m-%d") - _dt.timedelta(days=1)).strftime("%Y-%m-%d")
    except ValueError:
        pass
    files = []
    for ln in _iter_lt_stack_logs(repl_dir, "pw_", day_back or b, e, files):
        ln = ln.strip()
        if not ln: continue
        ts, rest = (ln.split(",", 1) + [""])[:2]
        if rest == "error": continue
        if ln.count(",") == 9:
            f = ln.split(",")[1:]
        elif ln.count(",") == 8:
            f = ln.split(",")[1:] + [""]
        else:
            continue
        try: tot = int(f[1])
        except ValueError: continue
        node = f[0] or "-"
        # begin side: latest sample AT OR BEFORE begin_ts; end side: latest
        # AT OR BEFORE end_ts (a sample ts == begin_ts belongs to begin side)
        # ★第 4 元=f[6] current_xlog_insert_lsn (2026-11-27 复核): 合成行原先
        #   丢掉 LSN ⇒ WAL written 行空 Begin/End + 0 B, 而 pw 日志里带着真值
        if b and ts <= b:
            cur = sides["begin"].get(node)
            if cur is None or ts >= cur[0]: sides["begin"][node] = (ts, tot, f[8], f[6])
        if e and ts <= e:
            cur = sides["end"].get(node)
            if cur is None or ts >= cur[0]: sides["end"][node] = (ts, tot, f[8], f[6])
    return sides

def patch_win_pagewriter_from_pw(win, repl_dir):
    """Synthesize win["db"][("begin"|"end","pagewriter")] rows from the shared
    pw_<day>.log when the snaps carry no pagewriter.csv (post-change snaps).
    Same dict shape/column names as the old csv so loadprofile_wal_pw_rows
    keeps working untouched. Per node, synthesis is skipped when either
    endpoint's sample is stale (>6 min from its snap time -- sampler outage)
    or the two endpoints' postmaster start times are missing/mismatched
    (restart inside the window: the flush delta would be garbage); Load
    Profile then prints '-' for that node."""
    if not repl_dir:
        return
    db = win.get("db", {})
    if db.get(("begin", "pagewriter")) or db.get(("end", "pagewriter")):
        return
    m = win.get("meta", {})
    sides = _pw_endpoints(repl_dir, m.get("begin_ts", ""), m.get("end_ts", ""))
    b, e = sides["begin"], sides["end"]
    if not b or not e:
        return
    def _near(sample_ts, ref_ts):
        """staleness cap (user 2026-10-21: endpoints must be the ADJACENT
        5-min samples): a sample more than 6 min (one cycle + slack) older
        than the snap time -- e.g. from a sampler outage -- is rejected."""
        sa, ra = _ts_epoch(sample_ts), _ts_epoch(ref_ts)
        return sa is not None and ra is not None and 0 <= ra - sa <= 360
    for node in list(b.keys()):
        if node not in e:
            continue
        # restart guard (user 2026-10-21: 启动时间一样才能算增量): BOTH
        # endpoints must carry a postmaster start time and they must MATCH;
        # anything else leaves this node unsynthesized (Load Profile '-')
        if not b[node][2] or not e[node][2] or b[node][2] != e[node][2]:
            continue
        if not _near(b[node][0], m.get("begin_ts", "")) or \
           not _near(e[node][0], m.get("end_ts", "")):
            continue
        for ph, side in (("begin", b), ("end", e)):
            db.setdefault((ph, "pagewriter"), []).append({
                "node_name": node,
                "pgwr_actual_flush_total_num": side[node][1],
                "pgwr_last_flush_num": "",
                "remain_dirty_page_num": "",
                "queue_head_page_rec_lsn": "",
                "queue_rec_lsn": "",
                "current_xlog_insert_lsn": side[node][3],
                "ckpt_redo_point": ""})

def _pw_lsn(v):
    """'X/X' -> int byte offset, else None."""
    try:
        a, b = v.split("/")
        return (int(a, 16) << 32) | int(b, 16)
    except Exception:
        return None

def pw_derive_rows(pw):
    """Pagewriter per-node 5-min series with derived cells. Returns
    (rows, summary). rows: (ts, node, flush_delta, pages_per_s, last_flush,
    remain_dirty, queue_head_lsn, behind_mb, restarted, ckpt_redo).
    - flush_delta = actual_flush_total difference vs the node's PREVIOUS
      sample (per node, ts order); the FIRST in-window sample is differenced
      against the last pre-window sample (pw["pre"], shared day logs -- user
      2026-10-21) when one exists
    - RESTART GUARD (user 2026-10-21): a delta is only valid between samples
      with the SAME pg_postmaster_start_time; a changed start time (or a
      counter that went backwards) -> restarted=True, delta None, excluded
      from sums. Legacy rows without a start time fall back to the
      counter-went-backwards check alone.
    - pages_per_s = flush_delta / seconds between the two samples
    - behind_mb = current_xlog_insert_lsn - queue_head_page_rec_lsn in MB:
      how far the OLDEST dirty page's rec_lsn trails the insert point --
      dirty backlog pressure (growing behind + growing dirty = flushing is
      falling behind the write rate)"""
    by_node = {}
    order = []
    for ts, kind, f in sorted(pw["rows"], key=lambda r: r[0]):
        if kind != "data": continue
        node, tot, lastf, dirty, qh, qr, xi, redo, dbstart = (f + [""] * 9)[:9]
        key = node or "-"
        if key not in by_node:
            by_node[key] = []
            order.append(key)
        try: tot_i = int(tot)
        except ValueError: tot_i = None
        try: dirty_i = int(dirty)
        except ValueError: dirty_i = None
        by_node[key].append((ts, tot_i, lastf, dirty_i, qh, xi, redo, dbstart))
    rows = []
    total_flush = 0
    peak_dirty = -1; peak_dirty_ts = ""
    dirty_sum = 0; dirty_n = 0
    peak_rate = None; peak_rate_ts = ""
    for node in order:
        # prev = (ts, tot, db_start); seeded from the last PRE-WINDOW sample
        # of this node when the shared day logs reach back that far.
        # STALENESS CAP (user 2026-10-21: the baseline must be the PREVIOUS
        # 5-min sample -- a sample from a sampler outage must not stand in):
        # baseline older than 6 min (one 5-min cycle + 60s slack for cron/
        # manual timing drift) is discarded; the first row then shows '-'
        prev = None
        _pre = pw.get("pre", {}).get(node)
        if _pre is not None and by_node[node]:
            _fe, _pe = _ts_epoch(by_node[node][0][0]), _ts_epoch(_pre[0])
            if _fe is None or _pe is None or not (0 <= _fe - _pe <= 360):
                _pre = None
        if _pre is not None:
            _pf = (_pre[1] + [""] * 9)[:9]
            # baseline must carry a postmaster start time AND it must match
            # the first in-window sample's (user 2026-10-21: 启动时间一样才
            # 能算增量); legacy rows without one are not trusted as baselines
            if not _pf[8] or (_pf[8] != by_node[node][0][7]):
                _pre = None
        if _pre is not None:
            try: _pt = int(_pf[1])
            except ValueError: _pt = None
            prev = (_pre[0], _pt, _pf[8])
        for ts, tot_i, lastf, dirty_i, qh, xi, redo, dbstart in by_node[node]:
            delta = None; rate = None; restarted = False
            if prev is not None and tot_i is not None and prev[1] is not None:
                # restart guard: start time must MATCH across the interval;
                # counter going backwards catches legacy rows without it
                if (prev[2] and dbstart and prev[2] != dbstart) or tot_i < prev[1]:
                    restarted = True
                else:
                    d = tot_i - prev[1]
                    delta = d
                    total_flush += d
                    te, pe = _ts_epoch(ts), _ts_epoch(prev[0])
                    if te is not None and pe is not None and te > pe:
                        rate = d / float(te - pe)
                        if peak_rate is None or rate > peak_rate:
                            peak_rate, peak_rate_ts = rate, ts
            if dirty_i is not None:
                dirty_sum += dirty_i; dirty_n += 1
                if dirty_i > peak_dirty: peak_dirty, peak_dirty_ts = dirty_i, ts
            xi_b, qh_b = _pw_lsn(xi), _pw_lsn(qh)
            behind = None
            # qh == 0/0 means the dirty-page queue is EMPTY (ckpt_get_min_rec_lsn
            # returns 0 when no dirty page): nothing trails the insert point,
            # behind is meaningless (live 204: remain_dirty=0 -> 0/0) -- show '-'
            if xi_b is not None and qh_b is not None and qh_b > 0 and xi_b >= qh_b:
                behind = (xi_b - qh_b) / 1048576.0
            rows.append((ts, node, delta, rate, lastf, dirty_i, qh,
                         behind, restarted, redo))
            prev = (ts, tot_i, dbstart)
    summary = {"total_flush": total_flush,
               "peak_dirty": peak_dirty if peak_dirty >= 0 else None,
               "peak_dirty_ts": peak_dirty_ts,
               "avg_dirty": (dirty_sum / dirty_n) if dirty_n else None,
               "peak_rate": peak_rate, "peak_rate_ts": peak_rate_ts}
    return rows, summary

def pagewriter_section_html(pw, meta):
    """Pagewriter Status body (caller emits the sec() title): window summary
    line + one row per node per 5-min sample. flush_d is the per-interval
    DELTA of the cumulative counter; a 'R' cell marks a restart (counter
    reset) whose interval is excluded from the window sums."""
    if not pw["files"]:
        return ('<div class="note">no pagewriter samples in this period '
                '(sampler runs while awr is enabled, one sample every 5 min)</div>')
    if pw["n_data"] == 0:
        return ('<div class="note">no usable pagewriter samples in this period '
                '(%d sample error(s))</div>' % pw["n_error"])
    rows, s = pw_derive_rows(pw)
    if not rows:
        return '<div class="note">no usable pagewriter samples in this period</div>'
    # no summary note line (user 2026-10-21): the table alone carries the section
    h = []
    # full kernel-native column names (user 2026-10-21: no over-abbreviated
    # headers); the Node column is hidden on single-node reports and only
    # appears when the series actually carries more than one node
    multi_node = len(set(r[1] for r in rows)) > 1
    h.append('<table class="t"><tr><th>Sample Time</th>%s'
             '<th class="n">flush Delta (pgwr_actual_flush_total_num)</th>'
             '<th class="n">pages/s</th>'
             '<th class="n">pgwr_last_flush_num</th>'
             '<th class="n">remain_dirty_page_num</th>'
             '<th>queue_head_page_rec_lsn</th>'
             '<th class="n">behind xlog_insert (MB)</th>'
             '<th>ckpt_redo_point</th></tr>'
             % ('<th>Node</th>' if multi_node else ''))
    for ts, node, delta, rate, lastf, dirty, qh, behind, restarted, redo in rows:
        delta_cell = "R" if restarted else (fmt_int(delta) if delta is not None else "-")
        node_cell = ('<td>%s</td>' % esc(node)) if multi_node else ''
        h.append('<tr><td>%s</td>%s<td class="n">%s</td><td class="n">%s</td>'
                 '<td class="n">%s</td><td class="n">%s</td><td>%s</td><td class="n">%s</td><td>%s</td></tr>'
                 % (esc(ts), node_cell, delta_cell,
                    ("%.1f" % rate) if rate is not None else "-",
                    esc(lastf or "-"),
                    fmt_int(dirty) if dirty is not None else "-",
                    esc(qh or "-"),
                    ("%.1f" % behind) if behind is not None else "-",
                    esc(redo or "-")))
    h.append('</table>')
    return "".join(h)

def _chain_html(chain, width=200):
    """One gs_stack chain rendered vb_tool-stack-summary style: leaf-first
    frames joined ' <- ', wrapped at `width` chars (wide: the stack tables are
    width:100% and the Stack column absorbs the slack; anything past the
    browser's cell width re-wraps via pre-wrap), continuation lines starting
    '<- ' aligned under the chain start."""
    if not chain:
        return '<span class="muted">-</span>'
    frames = chain.split(" <- ")
    if frames and frames[-1] == "":
        frames.pop()   # tolerate a trailing separator from older samplers
    lines = []
    cur = ""
    for fr in frames:
        if not cur:
            cur = fr
        elif len(cur) + 4 + len(fr) <= width:
            cur += " <- " + fr
        else:
            lines.append(cur)
            cur = "<- " + fr
    lines.append(cur)
    return '<div class="sqlfull">%s</div>' % "\n".join(esc(x) for x in lines)

def ctx_family(name):
    """normalize per-node dynamic memory contexts to their family name
    (user 2026-10-15: one context per query/plan object, unaggregated they
    fragment the Top-10 session context ranking; 2026-10-16 tightened to
    operator-memory suffixes only, user's call). Suffix sites in the kernel:
    - EVERY plan node: execProcnode.cpp:518 builds "<NodeTag>_<sid>" where
      sid = MyProcPid = gs_thread_self() = pthread_self() (gs_thread.cpp:409)
      -- a userspace thread address, ALWAYS >= 10 digits (204 live:
      Hash_47286009923328, 14 digits); family = any nodeTagToString() name
      (Hash/HashJoin/Sort/Agg/Limit/NestLoop/.../Stream/Vec*/BatchSort...;
      static HashTableContext/HashBatchContext aside)
    - stream top consumers (SMP/stream plans, execProcnode.cpp:525):
      "<NodeTag>_<queryId>_<planNodeId>" -- same operator families, queryId is
      uint64 (>= 10 digits) -> stripped together with the planNodeId so the
      stream-top node joins its family row (user 2026-10-16 拍板)
    - ShareInputScan (nodeShareInputScan.cpp:471): "SIRW_<sessid>_<shareid>_
      <smpid>" -> literal SIRW family (user 2026-10-16 拍板)
    - PL/pgSQL: "PL/pgSQL function context_<debug_query_id>" (pl_comp.cpp),
      "PL/pgSQL package context_<debug_query_id>" (pl_package.cpp) --
      queryId is uint64, rides along with the >= 10 digit rule
    - planner (planner.cpp:1385/2911/3038): QueryRewrite/PlanGenerate/
      PathGenerateContext_<query_level> -- small int, NOT merged: optimizer
      memory (not executor operator memory), transient, and only a handful
      of level values so they never fragment the ranking
    No static context name ends in 10+ digits (or in _<big>_<small>), so
    nothing static can be merged by accident. mem subcommand's "top 10
    session memory context" and vtop use the identical rule in SQL."""
    n = name or ""
    if re.match(r"^SIRW(_[0-9]+)+$", n):
        return "SIRW"
    n = re.sub(r"_[0-9]{10,}_[0-9]+$", "", n)
    return re.sub(r"_[0-9]{10,}$", "", n)

def sql_anchor(v):
    """SQL id cell -> anchor link to its text row in the SQL Text section
    (every unique_sql_id / unique_query_id cell is clickable, user 2026-10-15)."""
    return '<a href="#sql-%s">%s</a>' % (esc(v), esc(v))

def longtxn_section_html(lt, sql_ids=None):
    """Long Transaction Monitor body (caller emits the sec() title). A compact
    window summary line stays visible; the per-sample table folds. Error
    minutes render as muted gap rows."""
    if not lt["files"]:
        return ('<div class="note">no long transaction samples in this period '
                '(sampler runs while awr is enabled, one sample every 5 min)</div>')
    rows = sorted(lt["rows"], key=lambda r: r[0])
    if lt["n_data"] == 0:
        return ('<div class="note">no usable long transaction samples in this period '
                '(%d sample error(s))</div>' % lt["n_error"])
    # window summary: peak long-txn count and worst oldest-txn age, with times
    peak_cnt = peak_age = -1
    peak_cnt_ts = peak_age_ts = ""
    for ts, kind, f in rows:
        if kind != "data": continue
        cnt = (f + [""] * 12)[0]
        try:
            c = int(cnt)
            if c > peak_cnt: peak_cnt, peak_cnt_ts = c, ts
        except ValueError: pass
        te, xe = _ts_epoch(ts), _ts_epoch((f + [""] * 12)[4])
        if te is not None and xe is not None:
            a = te - xe
            if a > peak_age: peak_age, peak_age_ts = a, ts
    h = ['<div class="note">%d sample(s); peak ltx60_cnt %d at %s; worst oldest-txn age %s at %s.</div>'
         % (lt["n_data"], peak_cnt, esc(peak_cnt_ts or "-"),
