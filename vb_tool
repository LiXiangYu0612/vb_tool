            html_parts.append(f"""
                        <tr class="lock-summary-row">
                            <td>{idx}</td>
                            <td>{timestamp}</td>
                            <td class="deadlock-pid-col">
                                <strong>A:</strong> {process_a}/{txid_a}<br>
                                <strong>B:</strong> {process_b}/{txid_b}
                            </td>
                            <td>
                                <strong>A:</strong> {uid_a_link}<br>
                                <strong>B:</strong> {uid_b_link}
                            </td>
                            <td class="sql-text-col">
                                {sql_summary}
                            </td>
                            <td>{lock_type}</td>
                            <td>{lock_duration_ms:.3f}</td>
                            <td class="sql-text-col">
                                <div class="lock-action-btns">
                                    <button class="lock-detail-btn" onclick="toggleLockDetail(this)" title="查看详情">详情</button>
                                    <button class="copy-btn" data-copy-text="{full_context_copy}" onclick="copyToClipboard(this)" title="复制相关日志">复制</button>
                                </div>
                            </td>
                        </tr>
                        <tr class="lock-detail-card-row" style="display:none;">
                            <td colspan="8">
                                <div class="lock-event-detail-card">
                                    <div class="lock-detail-card-header">
                                        <h5>死锁会话详情</h5>
                                        <span class="lock-detail-card-meta">{timestamp}</span>
                                    </div>
                                    <div class="lock-detail-card-body">
                                        <p><strong>会话 A SQL:</strong></p>
                                        <pre>{sql_a_escaped}</pre>
                                        <p><strong>会话 B SQL:</strong></p>
                                        <pre>{sql_b_escaped}</pre>
                                        <p><strong>死锁行前3行日志:</strong></p>
                                        <pre>{dl_context_escaped}</pre>
                                        <p><strong>完整死锁上下文:</strong></p>
                                        <pre>{full_context_escaped}</pre>
                                        <p><strong>相关锁定事件时间线:</strong></p>
                                        {lock_events_html}
                                    </div>
                                </div>
                            </td>
                        </tr>
            """)

        html_parts.append("""
                </table>
            </div>
        </div>
        """)

        return ''.join(html_parts)

    @staticmethod
    def generate_lock_chain_section(lock_chain_list):
        """
        生成锁等待链章节 HTML：按等待事务分组，展示等待者 ← 持有者及其语句。
        """
        if not lock_chain_list:
            return ''

        # 只保留有阻塞者信息的 acquired 事件（waiting 已合并到 acquired），按 holder_txid 分组
        # 注意：holder_txid 可能为空字符串，此时仍应显示（标记为未知阻塞者）
        chain_events = [
            ev for ev in lock_chain_list
            if ev.get('event_kind') == 'acquired'
        ]
        if not chain_events:
            return ''

        # 全局归一（跨阻塞者事务）：相同等待语句，Unique ID 相同即归为一组；
        # 无 Unique ID 时退化为等待语句 SQL 指纹。指纹/UID 相同视为同一组事件，
        # 记录发生次数与累计耗时，按累计耗时降序取 Top MAX_CHAIN_WAITER_ROWS。
        # 阻塞者信息不再按 holder 分组渲染（组数 x 行数会导致行数膨胀），
        # 而是：行内"阻塞事务"列显示事务数（悬停列出各事务及其次数/最长耗时），
        # 详情卡保留耗时最长一次的上下文与该次阻塞者的语句。

        def _waiter_agg_key(ev):
            _uid = str(ev.get('unique_id', '')).strip()
            if _uid:
                return 'uid:' + _uid
            _sql = str(ev.get('sql_text', '') or '')
            return 'fp:' + _sql_fingerprint_id(_sql) if _sql else ''

        agg_map = {}
        for ev in chain_events:
            _key = _waiter_agg_key(ev)
            _a = agg_map.get(_key)
            if _a is None:
                _ts = str(ev.get('waiting_timestamp') or ev.get('timestamp', ''))
                _a = agg_map[_key] = {
                    'count': 0, 'sum_ms': 0.0, 'max_ms': -1.0, 'max_ev': None,
                    'first_ev': ev, 'first_ts': _ts, 'last_ts': _ts,
                    'sessions': set(), 'holders': {}
                }
            _ms = ev.get('wait_time_ms', 0) or 0
            _a['count'] += 1
            _a['sum_ms'] += _ms
            if _ms > _a['max_ms']:
                _a['max_ms'] = _ms
                _a['max_ev'] = ev
            # 首次/末次按时间戳字符串比较（日志时间格式统一，字典序即时间序）
            _ts = str(ev.get('waiting_timestamp') or ev.get('timestamp', ''))
            if _ts < _a['first_ts']:
                _a['first_ts'] = _ts
                _a['first_ev'] = ev
            if _ts >= _a['last_ts']:
                _a['last_ts'] = _ts
            _a['sessions'].add(str(ev.get('session_id', '')))
            # 阻塞者事务维度：只统计次数与各事务代表事件（含 holder_all_sql）
            _holder = str(ev.get('holder_txid', '') or '')
            _h = _a['holders'].get(_holder)
            if _h is None:
                _h = _a['holders'][_holder] = {'count': 0, 'max_ms': -1.0, 'rep_ev': ev}
            _h['count'] += 1
            if _ms > _h['max_ms']:
                _h['max_ms'] = _ms
                _h['rep_ev'] = ev

        sorted_agg = sorted(agg_map.values(), key=lambda x: x['sum_ms'], reverse=True)
        total_agg_rows = len(sorted_agg)
        show_agg = sorted_agg[:MAX_CHAIN_WAITER_ROWS]
        truncated_agg_rows = total_agg_rows - len(show_agg)
