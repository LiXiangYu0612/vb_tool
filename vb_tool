_vtop_cmd_quit=0     # set by _vtop_cmd_exec when the typed command was 'q'
_vtop_cmd_exec() { # $1 = prefill; opens the command line, then runs what was typed
    # ★The letter table lives HERE, once: both openers use it -- ESC, and
    # since 2026-09-27 a plain Enter on the main screen as well (user: "主页面
    # 的Enter也等于cmd"). Since 2026-09-28 it is the ONLY entry into a
    # sub-screen (user: 「不要双入口 必须弹出enter 之后输入才能进入」) --
    # the bare-key map in run_vtop was removed, so this table has no twin to
    # keep in step with.
    # `screen` is run_vtop's local and `_vtop_notice` is a global: both are
    # reached/assigned by DYNAMIC SCOPE on purpose -- that is how a helper
    # switches the caller's screen.
    _vtop_cmd_quit=0
    _vtop_cmd_line "${1:-}"
    case "$_vtop_cmd" in
        "") : ;;                    # empty Enter: plain redraw
        q)  _vtop_cmd_quit=1 ;;
        s)  screen=sess ;;
        l)  screen=ltx ;;
        a)  screen=istat ;;
        e)  screen=wait ;;
        x)  screen=xlog ;;
        r)  screen=repl ;;
        m)  screen=memctx ;;    # ★the memory page lives on m now (user's call
                                #   2026-09-27: 「这三个的子界面一个就弄完了…
                                #   输出就是 b，但是我们改成 m 吧」) -- DBEMEM,
                                #   MEMCTX and TOPMEM are one memory page in
                                #   vtop. (there is no 'b' entry in the table below -- typing b
                                #   yields 未知命令; the old 注释 claimed it was an alias.)
        t)  screen=topsql ;;
        k)  screen=lock ;;
        g)  screen=stack ;;    # vb_tool stack's summary, one instant dump (2026-09-29)
        d)  screen=iostat ;;   # OS page: iostat -xm for the data_dir fs's devices only (2026-11-14)
        c)  screen=cpu ;;      # OS page: mpstat -P ALL, per-core split (2026-11-14)
        v)  screen=vmstat ;;   # OS page: vmstat, mem/swap/paging (2026-11-14)
        n)  screen=net ;;      # OS page: sar -n DEV, per-interface rates (2026-11-14)
        f)  screen=osmem ;;    # OS page: meminfo + faults/reclaim + buddyinfo (2026-11-16)
        *)  _vtop_notice="unknown command: ${_vtop_cmd}   (one letter per built page -- see the HINT line at the bottom)" ;;
    esac
    # a sub-screen chosen via the command line gets the quick first refresh
    # (sub_first is run_vtop's local: dynamic scope, like screen)
    [ "$screen" != "main" ] && sub_first=1
}

_vtop_keys_hint() { # $1=screen -> key legend line, interactive mode only.
    # ★only pages that EXIST are advertised (2026-09-27: the eleven VASTBASE
    # drill-downs). The old two-line 21-section map advertised letters with
    # nothing behind them, so pressing one did nothing at all (user: "v进入…算了")
    # -- the legend is ONE line now and every other letter (c p v h n o d i f)
    # is silently inert: no notice, no advertisement.
    # ★the label is HINT, not KEYS (user's call 2026-09-26: "KEY: 改成提示吧"):
    # this line is the key legend -- a different thing from the one-frame
    # _vtop_notice error line printed above it.
    # ★the placeholder mem page opens ONLY through the ESC/Enter command line, like
    # every other page since 2026-09-28 -- bare keys are inert (no entry needed here).
    # ★colour (user's call 2026-09-26, second pass: "HINT用绿色吧，后面Enter=refresh
    # ESC=cmd q=quit 颜色也弄啊"): label GREEN (c_grn -- the frame's "live/good" green,
    # also used for port/up), key list cyan (c_sec, the section-title colour, so the
    # letters read as the interactive part), tail YELLOW (c_ylw). The one-frame
    # _vtop_notice stays uncoloured on purpose (it is an error, not a legend).
    # The frame-rewrite pass strips ANSI before matching ^HINT, so the colour is safe.
    # ★"s=sess" with '=', not 's:sess' (user: "前面的y:怎么是冒号 用=吧") -- the same
    # '=' the tail uses, so the whole line has ONE separator convention.
    # Letters must match _vtop_cmd_exec's command-line table (the only entry
    # into a sub-screen since 2026-09-28 -- there is no bare-key map anymore).
    # ★per user's terminal: TUI colours are NOT rendered on his client at all
    # (see memory user_terminal_no_ansi_color) -- the text carries the meaning, the
    # colour is a bonus for everyone whose terminal does render it.
    # ★the sub-screen cadence hint MOVED to the page header (user's call
    # 2026-09-27: "auto-refresh=15s 不要写hint那里，写开头 refresh 15s 就行" +
    # "HINT auto-refresh=15s去掉"): _vtop_pg prints "refresh Ns" on the first
    # line of every page, this legend is keys-only again. The main screen does
    # not need it either: its header line already prints "refresh 15s".
    case "$1" in
        main)
            # ★光标标记 = 半角[]吃掉两侧分隔空格 (用户令 2026-11-18: "【】太大、移动
            #   时整行文字跟着挪 看着很花; 搞[]这种 避免文字位置移动; 选中处黄色粗体
            #   区分")。激活态每个条目恒占 len+2 列 (未选中=两侧各1空格, 选中=两侧
            #   括号), 条目间无额外分隔 ⇒ 整行宽度与光标位置无关, 移动零位移; 括号
            #   仍是字符载体 (用户终端不渲染颜色 ⇒ 标记必须字符承载), c_ybd 黄色
            #   粗体是彩终端加成, --plain 下退化为纯括号。★选中项收尾必须重发
            #   off+sec 恢复行色: 首版只发 off 把行首 c_sec 一并杀掉, 光标右侧条目
            #   全变白、"走过才变蓝" (用户 2026-11-18 实测反馈), res=off+sec 后
            #   未选中条目全行统一蓝。hint_cur 经动态作用域取 run_vtop 的 local。
            local _hl="s=sess l=ltx a=istat e=wait x=xlog r=repl m=dbmem+memctx+topmem t=topsql k=lock g=stack d=iostat c=cpu v=vmstat n=net f=osmem"
            if [ "${hint_cur:-0}" -ge 1 ] 2>/dev/null && [ "${hint_cur:-0}" -le 15 ] 2>/dev/null; then
                _hl=$(printf '%s\n' "$_hl" | awk -v n="$hint_cur" -v on="${c_ybd:-}" -v res="${c_off:-}${c_sec:-}" '
                    { for (i = 1; i <= NF; i++)
                          printf "%s%s%s", (i == n ? on "[" : " "), $i, (i == n ? "]" res : " ") }
                    END { printf "\n" }')
                printf '%sHINT%s    %s%s%s\n        %s←→↑↓=move  Enter=open  ESC=cmd  q=quit%s\n' \
                          "${c_grn:-}" "${c_off:-}" "${c_sec:-}" "$_hl" "${c_off:-}" "${c_ylw:-}" "${c_off:-}"
                return
            fi
            # ★hint_cur=0 = 默认框在 HINT 标签上 (用户令 2026-11-27: "默认框放在HINT那里
            #   吧" -- 推翻 11-18 "默认放第一个": 框落在 s=sess 时开屏一按回车就直进
            #   [SESS], "ENTER:" 命令行反而够不着)。框在 HINT ⇒ Enter=原命令行 (分派处
            #   hint_cur>=1 才进子屏, 0 天然落到 cmd), 方向键才把光标走进条目 (→ 到
            #   1 号 s=sess, ← 到 15 号 f=osmem)。★标签宽度恒 8 列: "HINT    "=4+4,
            #   "[HINT]  "=6+2, 条目起始列不动, 两行重画路径的 149 列前提不破。
            printf '%s[HINT]%s  %s%s%s\n        %s←→↑↓=move  Enter=cmd  ESC=cmd  q=quit%s\n' \
                      "${c_ybd:-}" "${c_off:-}${c_sec:-}" "${c_sec:-}" "$_hl" "${c_off:-}" "${c_ylw:-}" "${c_off:-}" ;;
        *)    printf '%sHINT%s    %sESC=back%s   %sEnter=refresh  q=quit%s\n' \
                      "${c_grn:-}" "${c_off:-}" "${c_sec:-}" "${c_off:-}" "${c_ylw:-}" "${c_off:-}" ;;
    esac
}

_vtop_drain_ret=""   # set by _vtop_drain_keys when a real key followed the ESC
_vtop_drain_seq=""   # set to 1 when the ESC turned out to be part of a sequence
_vtop_drain_fin=""   # final byte of the eaten sequence (A/B/C/D = arrows, 2026-11-17)
_vtop_drain_keys() { # ESC arrived: eat the escape-sequence tail, nothing else
    # up = ESC [ A , ctrl+right = ESC [ 1 ; 5 C ...: read -n1 only takes the ESC
    # byte. Only a real CSI/SS3 sequence is eaten: any other byte (a key that
    # followed the ESC) is handed back untouched, and nothing beyond it is read
    # -- otherwise a coalesced "ESC m <Enter>" would lose its Enter. bash cannot
    # push a byte back to stdin, hence the hand-back variable.
    # _vtop_drain_seq tells the caller "that ESC was an arrow/function key, not
    # a real ESC press"; _vtop_drain_fin keeps the final byte so the caller can
    # tell WHICH arrow it was (cursor feature 2026-11-17).
    local _d
    _vtop_drain_ret=""; _vtop_drain_seq=""; _vtop_drain_fin=""
    IFS= read -r -t 0.08 -n 1 _d || return 0
    case "$_d" in
        '['|'O') ;;                              # CSI / SS3 introducer: eat the tail
        *) _vtop_drain_ret="$_d"; return 0 ;;    # real key: hand back, stop reading
    esac
    _vtop_drain_seq=1
    while IFS= read -r -t 0.08 -n 1 _d; do
        case "$_d" in
            [0-9\;\?\ ]) : ;;                    # parameter bytes
            *) _vtop_drain_fin="$_d"; return 0 ;;# final byte: sequence complete
        esac
    done
}

# Wrap the OS / VASTBASE sections of the finished frame in a 150-column box with
# the label centred on the top edge (user's call 2026-09-26). Runs as a post-pass
# over the frame file, so every scattered printf inside a section gets boxed
# without touching any of them. Section boundaries are the existing
# "-- <LABEL> ----…" banner lines: a box closes at the next banner, at the
# HINT/notice tail, or at EOF. If this pass fails in any way the banner just stays
# as it was -- i.e. it degrades safely back to the previous look.
# ★LC_ALL=C on purpose: widths are computed from BYTE counts via cols(), which is
# identical on every machine regardless of locale. (204's locale falls back to C,
# WSL's is UTF-8 -- without pinning it the two would disagree.)
_vtop_boxify() { # $1 = frame file, rewritten in place
    local f="$1" t
    t=$(mktemp "${f}.box.XXXXXX") || return 0
    if LC_ALL=C awk -v outer="${_vtop_w:-150}" -v bc="${c_lbl:-}" -v bdg="${c_bdg:-}" -v off="${c_off:-}" '
    BEGIN { inner = outer - 2 }        # the frame eats one column each side
    # ★QUADRUPLE dash ┈ (U+2508) + ┊ (U+250A) vertical: the user wanted the frame
    # LIGHT rather than solid ("实线感觉很呆", 2026-09-26). Both are 3-byte UTF-8 /
    # ONE display column and both sit in the same EastAsianWidth class as the old
    # ─│ (A = ambiguous), so cols() and the width arithmetic are untouched.
    # ★Do NOT "fix" the banner glyphs in _vtop_sec to match: the section detection
    # below keys on the LITERAL "── " (U+2500) the banner is made of, and the
    # banner is always replaced by top(). Change one without the other and the
    # boxes silently stop being drawn.
    function dashes(n,   s) { s = ""; while (n-- > 0) s = s "┈"; return s }
    # display columns: 2-byte UTF-8 -> 1 col, 3-byte (CJK) -> 2, 4-byte -> 2
    function cols(s,   t, u) {
        t = s; gsub(/[\300-\377]/, "", t)
        u = s; gsub(/[\360-\367]/, "", u)
        return length(t) - (length(s) - length(u))
    }
    # Square corners (user call 2026-09-26: "不要圆角了" -- was rounded ╭╮╰╯) +
    # the section title as a FILLED BADGE (user call 2026-09-26:
    # "这行看着很单调" -- hierarchy, not more glyphs). The badge brings its own
    # background (SGR 30;46 = black on cyan) so it reads as a plate sitting on the
    # frame, while the frame itself is the SAME dim cyan as the metric-name rows:
    # one colour for scaffolding, so the box belongs to the block instead of
    # looking like a separate outline around it.
    function top(lab,   blk, pad, l, odd) {
        blk = " " lab " "
        pad = inner - length(blk)
        l = int(pad / 2)
        # ★The two dash runs must stay EXACTLY equal (inner is even). An odd pad
        # is absorbed as ONE space just outside the badge -- NOT by padding the
        # badge itself, so the badge stays symmetric too. (Earlier the odd dash
        # simply landed on the right: 66 vs 67, which read as "not centred".)
        odd = pad - 2 * l                                  # 0 or 1
        return bc "┌" dashes(l) off bdg blk off bc (odd ? " " : "") dashes(l) "┐" off
    }
    function bot() { return bc "└" dashes(inner) "┘" off }
    {
        plain = $0
        gsub(/\033\[[0-9;]*m/, "", plain)
        # ★ANY _vtop_sec banner opens a box (was /^(OS|VASTBASE)/ only until
        # 2026-09-27, when the sess page started carrying its own banners --
        # "要不也整一点方框"). Pages that print no banner stay untouched.
        if (plain ~ /^── /) {
            # label runs from after the leading "-- " up to the first box-dash;
            # ★must NOT cut at the first space -- labels may contain spaces
            # ("OS Statistics"). index() is a byte search, which is exactly
            # right under LC_ALL=C.
            lab = plain
            sub(/^── +/, "", lab)
            i = index(lab, "─")
            if (i > 0) lab = substr(lab, 1, i - 1)
            sub(/ +$/, "", lab)
            if (inbox) print bot()
            print top(lab)
            inbox = 1
            saw = 1
            next
        }
        # ★"!!" 通知同样按"帧外文本"处理 (2026-11-17 复核): PGDATA 端口不匹配 /
        #   窄终端 / 非 UTF-8 locale 三条通知都以 "!! " 开头; 旧正则不认识 ⇒ 它们
        #   落在 LWLOCK 方框内, 被垫成一行数据 (┊ 前缀+右边框), 与 HINT 等其它通知
        #   两种长相, 还让方框看起来多了一行假数据。
        #   ★"[HINT]" 豁免 (2026-11-27): hint_cur=0 时默认框落在 HINT 标签上, 该行
        #   素文本变成 "[HINT]  s=sess..." 开头; 旧正则不认识 ⇒ 这行被垫成假数据行。
        if (plain ~ /^(HINT |\[HINT\]|unknown command|command line |!! )/) {
            if (inbox) { print bot(); inbox = 0 }
            print $0
            next
        }
        if (!inbox) { print $0; next }
        w = cols(plain)
        if (w >= inner) { print bc "┊" off $0 bc "┊" off; next }
        printf "%s┊%s%s%*s%s┊%s\n", bc, off, $0, inner - w, "", bc, off
    }
    END { if (inbox) print bot()
          # no section banner at all (the memory sub-screen): leave the frame
          # alone -- the caller sees the non-zero exit and drops the temp file,
          # so we skip a pointless mktemp+mv every frame on that screen.
          if (!saw) exit 3 }
    ' "$f" > "$t"; then
        mv "$t" "$f"
    else
        rm -f "$t"
    fi
}

_vtop_print_frame() { # $1=frame file: redraw in place, or plain dump
    # ★vtop_ctl (set by run_vtop, dynamic scope) decides HOW to print; it is 0
    # when stdout is not a tty OR the terminal was judged unable to eat ANSI
    # (TERM=dumb/empty, --plain). In that case the frame is dumped line by line
    # and the frames simply scroll -- readable beats pretty.
    local _f="$1" _fl
    _vtop_boxify "$_f"
    if [ "${vtop_ctl:-0}" = "1" ]; then
        printf '\033[H'
        while IFS= read -r _fl; do printf '%s\033[K\n' "$_fl"; done < "$_f"
        printf '\033[J'
    else
        cat "$_f"
    fi
}

# ---- vtop 退出清理 (2026-09-26: 用户「假如 vtop 已经 esc 或者 q 退出了 确保不能再遗留
# 任何 vtop 相关的进程 之前出现过几次了」) --------------------------------------------------
# 三件事一次做完, 且**必须幂等** (信号处理器里 exit 会再触发 EXIT trap):
#   1) 收掉我们自己的子进程。★用 $BASHPID 而不是 $$: 在命令替换/管道子 shell 里 $$ 仍是
#      主进程 pid, 那样 pkill -P 会去杀"兄弟"进程。★只 pkill -P(只自己的孩子), 绝不
#      kill 0 / 杀进程组 —— vtop 通常从 `su - vastbase` 里起, 进程组就是用户那个登录
#      shell, 杀组等于把人家 shell 一起干掉。
#   2) 删临时帧文件 (含 _vtop_boxify 的 .box 残骸)。
#   3) 还原 tty 回显 —— stty -echo 是我们关的; 不还原 = 用户终端"打字看不见"。
# ★守卫 [ BASHPID = $$ ] (2026-09-28 审计订正了这里的说法): 实测 bash 5.2 下
#   **子 shell 退出并不执行 EXIT trap** (命令替换/括号子 shell 跑完, trap 只在主 shell
#   触发一次), 所以这句更准确的定位是**防御性写法**: 万一某个 bash 版本/某条路径让
#   子 shell 也跑到这里, 守卫保证只有主进程去删帧文件、开回显 —— 否则每帧几十个子
#   shell 会互相把对方的帧文件删掉。守卫本身无害, 保留; 只是原来那句因果关系是错的。
_vtop_cleanup() {
    [ "${BASHPID:-$$}" = "$$" ] || return 0
    pkill -P "$BASHPID" 2>/dev/null
    rm -f "${_vtop_f:-}" "${_vtop_f:-}.box."* "${_vtop_dbcache:-}" "${TMPDIR:-/tmp}/vbtop_q.$$.err" \
          "${TMPDIR:-/tmp}/vbtop_wait.$$.prev" "${TMPDIR:-/tmp}/vbtop_istat.$$.prev" "${TMPDIR:-/tmp}/vbtop_repl.$$.prev" \
          "${TMPDIR:-/tmp}"/vbtop_stack."$$".* "${TMPDIR:-/tmp}"/vbtop_stkch."$$".* "${TMPDIR:-/tmp}"/vbtop_stkagg."$$".* 2>/dev/null
    # ★主屏并行采集的分段结果目录 (信号打断帧时车道文件会残留; SIGKILL 后启动清扫
    #   也会回收 vbtop_dbc.* , 这里退出时一并收走, 客户机上不留垃圾)
    rm -rf "${TMPDIR:-/tmp}/vbtop_dbc.$$" 2>/dev/null
    # ★`stty echo ICANON` -- icanon too: bash's own `read -n1` switches the tty
    # to non-canonical while it reads, and a signal landing mid-read (Ctrl+C)
    # unwinds that restore; we are the reason the tty was touched at all, so
    # the cleanup puts BOTH bits back. (Observed 2026-09-27: INT exit left
    # ICANON off with echo on.) /dev/tty fallback: stdin can already be in a
    # broken state (EIO after a suspend mess) where a plain `stty` fails --
    # the ioctl on the tty itself still works.
    [ -n "${_vtop_stty:-}" ] && { stty echo icanon 2>/dev/null || stty -F /dev/tty echo icanon 2>/dev/null; }
    return 0
}

# ---- vtop 挂起 (Ctrl+Z) ------------------------------------------------------
# ★与 _vtop_cleanup 分开 (2026-11-17 复核): 挂起不是退出 —— 循环在 fg 之后原地继续,
#   文件和数据都必须还在。旧版复用 _vtop_cleanup, 它 rm 掉帧文件与 dbcache, 恢复后
#   第一帧被迫走全采路径、却拿旧 db 文本重算, 打出一帧"新时间戳 + 全 0 速率"的假数据。
#   这里只做挂起真正需要的两件事: tty 还回去 (挂起期间终端不能是 -echo), 真停。
_vtop_suspend() {
    [ "${BASHPID:-$$}" = "$$" ] || return 0
    [ -n "${_vtop_stty:-}" ] && { stty echo icanon 2>/dev/null || stty -F /dev/tty echo icanon 2>/dev/null; }
    kill -STOP "$$"
}

sqlpatch_help() {
    cat <<'SPH'
Usage: vb_tool sqlpatch create|enable|disable|drop -d <db_name> -s <unique_sql_id> [-h <hint_string>]

  -d  database name (required: gs_sql_patch is per-database)
  -s  unique_sql_id the patch anchors on
  -h  hint, create only. Three forms:
      bare:    set(query_dop 1) / set(rewrite_rule 'magicset,predpushnormal')
      wrapped: '/*+ ... */' (the wrapper is stripped automatically)
      file:    @/path/file -- put exactly the hint lines you want into a file
               (any subset of the outline block, cp'd by hand); line breaks
               are joined and stray BEGIN/END_OUTLINE_DATA marker lines are
               dropped. Double quotes (@\"SEL$1\") never pass the shell
      inline:  paste the hint EXACTLY as it appears in the outline output.
               If the shell ate the inner single quotes around a set() value
               (comma/space-containing bare value -- grammatically
               impossible on purpose), the tool re-quotes it automatically.

  Patch name is always derived: patch_<unique_sql_id>
SPH
}

# SQL PATCH wrapper (user 2026-11-15: "记不住创建和删除 sqlpatch 的 schema 和
# 函数名"). Design per user spec: actions create|enable|disable|drop, required
# -d (gs_sql_patch is NOT shared across databases), -s anchors the patch,
# -h only for create, name always 'patch_'||unique_sql_id.
run_sqlpatch() {
    local act="${1:-}"
    case "$act" in
    create|enable|disable|drop) ;;
    *)
        echo "Error: sqlpatch action must be create|enable|disable|drop" >&2
        sqlpatch_help
        return 2
        ;;
    esac
    shift

    local db="" uid="" hint=""
    while [ $# -gt 0 ]; do
        case "$1" in
        -d) [ $# -ge 2 ] || { echo "Error: -d needs <db_name>" >&2; return 2; }
            db="$2"; shift 2;;
        -s) [ $# -ge 2 ] || { echo "Error: -s needs <unique_sql_id>" >&2; return 2; }
            uid="$2"; shift 2;;
        -h) [ $# -ge 2 ] || { echo "Error: -h needs <hint_string>" >&2; return 2; }
            hint="$2"; shift 2;;
        *)  echo "Error: unknown option '$1'" >&2; return 2;;
        esac
    done
    [ -n "$db" ]  || { echo "Error: -d <db_name> is required (gs_sql_patch is per-database)" >&2; return 2; }
    [ -n "$uid" ] || { echo "Error: -s <unique_sql_id> is required" >&2; return 2; }
    case "$uid" in ''|*[!0-9]*) echo "Error: -s expects a numeric unique_sql_id" >&2; return 2;; esac
    if [ "$act" = create ] && [ -z "$hint" ]; then
        echo "Error: create needs -h '<hint_string>'" >&2; return 2
    fi

    local name="patch_${uid}"
    # Hint normalization (create only): the engine wants the BARE hint text.
    #  1. -h @file: read the hint from a file -- EXPLAIN (OUTLINE) output can
    #     be cp'd straight in (double quotes like @"SEL$1" never survive shell
    #     quoting; a file bypasses the shell entirely)
    #  2. drop BEGIN_OUTLINE_DATA / END_OUTLINE_DATA marker lines, collapse
    #     CR/newlines into single spaces (outline blocks are multi-line)
    #  3. strip a '/*+ ... */' wrapper if present
    if [ "$act" = create ]; then
        case "$hint" in
        @?*)
            local hf="${hint#@}"
            [ -r "$hf" ] || { echo "Error: -h @$hf: file not readable" >&2; return 2; }
            hint=$(cat "$hf")
            ;;
        esac
        # The file holds EXACTLY the hint the user curated -- any subset of
        # the outline block (one line or several). Transport only: drop stray
        # CR and the two outline marker tokens if they were copied along,
        # join the lines, no content decisions.
        hint=$(printf '%s' "$hint" | tr -d '\r' \
            | sed -e '/^[[:space:]]*BEGIN_OUTLINE_DATA[[:space:]]*$/d' -e '/^[[:space:]]*END_OUTLINE_DATA[[:space:]]*$/d' \
            | awk 'NF { printf "%s ", $0 }')
        hint="${hint% }"
        [ -n "$hint" ] || { echo "Error: -h produced an empty hint after normalization" >&2; return 2; }
        case "$hint" in
        '/*+'*'*/') hint="${hint#/\*+}"; hint="${hint%\*/}"; hint="${hint#"${hint%%[![:space:]]*}"}"; hint="${hint%"${hint##*[![:space:]]}"}";;
        esac
        # Auto-repair quotes the SHELL ate: '-h 'SET(x 'a,b')'' loses its
        # inner single quotes to shell concatenation, so a set() value that
        # contains commas/spaces but no quotes can only mean that. A bare
        # value with commas/spaces is grammatically impossible, so re-quoting
        # is deterministic, never a guess (user 2026-11-16: 原样贴, 工具转义).
        hint=$(printf '%s' "$hint" | awk '
        {
            q = sprintf("%c", 39); s = $0; out = ""
            while (1) {
                idx = index(tolower(s), "set(")
                if (idx == 0) { out = out s; break }
                out = out substr(s, 1, idx + 3)
                rest = substr(s, idx + 4)
                ci = index(rest, ")")
                if (ci == 0) { out = out rest; break }
                grp = substr(rest, 1, ci - 1)
                if (match(grp, /^[[:space:]]*[^[:space:]]+[[:space:]]+/)) {
                    head = substr(grp, 1, RLENGTH)
                    val = substr(grp, RLENGTH + 1)
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
                    fv = substr(val, 1, 1); lv = substr(val, length(val), 1)
                    if (val != "" && !(fv == q && lv == q) && (val ~ /,/ || val ~ / /)) {
                        val = q val q
                    }
                    grp = head val
                }
                out = out grp ")"
                s = substr(rest, ci + 1)
            }
            print out
        }')
    fi
    if [ "$act" = create ]; then
        [ -n "${NETDIAG_SP_DEBUG:-}" ] && printf 'DBG hint=[%s]\n' "$hint" >&2
        psql -d "$db" -P footer=off -v n="$name" -v i="$uid" -v h="$hint" <<'SQLEOF'
\echo '=========================='
\echo 'create_hint_sql_patch'
\echo '=========================='
SELECT dbe_sql_util.create_hint_sql_patch(:'n', :'i'::bigint, :'h', NULL, true) AS created;
SELECT patch_name, unique_sql_id, enable, abort, status,
       coalesce(hint_string, '-') AS hint_string
FROM gs_sql_patch WHERE unique_sql_id = :'i'::bigint;
SQLEOF
    else
        local fn="${act}_sql_patch"
        psql -d "$db" -P footer=off -v n="$name" -v i="$uid" <<SQLEOF
\echo '=========================='
\echo $act: state before
\echo '=========================='
SELECT patch_name, unique_sql_id, enable, abort, status,
       coalesce(hint_string, '-') AS hint_string
FROM gs_sql_patch WHERE unique_sql_id = :'i'::bigint;
SELECT dbe_sql_util.$fn(:'n') AS ${act}_result;
SELECT patch_name, unique_sql_id, enable, abort, status,
       coalesce(hint_string, '-') AS hint_string
FROM gs_sql_patch WHERE unique_sql_id = :'i'::bigint;
SQLEOF
    fi
}

# ---- vtop: 解析 data dir 与数据盘 (2026-11-17 复核抽成函数) -------------------
# 原来是"启动时一次性": 实例 down 时 `show data_directory` 失败 ⇒ datadir=unknown
# 永久空着 —— 实例恢复后 DSK/I-O/FS/TOPSQL 与表空间链整场 '-', 一帧半活半死
# (_vtop_vbcpu_pid 早就是每帧重锚, 这里对齐)。结果写**调用者的局部变量** (动态作用域):
# datadir dev devs ndev devinfos d_pick tsdevs devinfo
_vtop_resolve_datadir() {
    local _pgd_port="" _xdevs _vd _t _tdir _tdev _d
    datadir="${PGDATA:-}"
    # ★$PGDATA 必须与本次连接的端口是同一个实例 (2026-11-17 复核): 一台机器多实例时
    #   PGDATA 完全可能是"另一个库"的 (204 上 su - vastbase 的 .bashrc 就把 PGPORT 劫持
    #   到 9432, 而 PGDATA 还指着 5432 的 data dir)。不信的后果: DSK/I-O/FS 行描述的是
    #   另一个实例的盘, [TOPSQL] 拿错 pid 的 top -p 恒空而静默 '-', 整帧自相矛盾。
    #   判据照抄 _vtop_vbcpu_pid: postmaster.pid 第 4 行 = 端口, 必须等于 $(PGPORT)。
    #   实例 down / pid 文件不可读时无法证伪, 保留 $PGDATA (data dir 本身仍然有意义)。
    if [ -n "$datadir" ] && [ -d "$datadir" ]; then
        if [ -r "$datadir/postmaster.pid" ]; then
            _pgd_port=$(sed -n '4p' "$datadir/postmaster.pid" 2>/dev/null | tr -d ' \t\r')
        fi
        if [ -n "$_pgd_port" ] && [ "$_pgd_port" != "${PGPORT:-5432}" ]; then
            datadir=""
            _vtop_notice="!! \$PGDATA ($_pgd_port) is a different instance than port ${PGPORT:-5432}: data-dir rows resolved from the DB"
        fi
    fi
    if [ -z "$datadir" ] || [ ! -d "$datadir" ]; then
        datadir=$(PGCONNECT_TIMEOUT=5 timeout 5 psql -d postgres -tAc "show data_directory" 2>/dev/null | head -1 | tr -d ' ')
    fi
    dev=""
    if [ -n "$datadir" ] && [ -d "$datadir" ]; then
        dev=$(_vtop_disk_dev "$datadir")
    fi
    # ★partition lifted to the PARENT WHOLE DISK (user 2026-11-17: '都是vda 为什么
    #   是vda1??'). df resolves the data fs to its partition (vda1), but everything
    # around it already speaks whole-disk: the DSK row's queue attrs (sched/qdepth/
    #   nr_rq) read the PARENT, the multi-disk path lifts leaf partitions to parents
    #   for its counters, and the iostat page's stack lifts partitions too -- a plain
    #   single-partition fs showing vda1 made the main screen disagree with iostat on
    #   the same box, and partition-line io_ticks would under-report util when a
    #   NEIGHBOUR partition is the one saturating the physical disk. dm/md fs devices
    #   are NOT lifted (no sysfs partition file): the dm layer is the fs's own device
    #   and keeps 2026-11-01's dm-on-one-disk semantics. The [FS] row still carries
    #   the filesystem view (fstype/fs-size/mount), so nothing is lost by this.
    if [ -n "$dev" ] && [ -f "/sys/class/block/$dev/partition" ]; then
        dev=$(_vtop_parent_dev "$dev")
    fi
    # ★multi-disk filesystem (user 2026-11-01): the data fs spanning several
    # physical disks (LVM/RAID) used to show ONE averaged dm/md line, which
    # hides the straggler -- DSK/I-O rows now follow the WORST disk by read+
    # write service time. Single physical disk behind the fs (incl. dm on one
    # disk): unchanged view.
    devs="$dev"; ndev=1; devinfos=""; d_pick="$dev"
    if [ -n "$dev" ] ; then
        _xdevs=$(_vtop_disk_expand "$dev")
        if [ "$(printf '%s\n' "$_xdevs" | wc -w)" -gt 1 ]; then
            devs="$_xdevs"; ndev=$(printf '%s\n' "$devs" | wc -w); d_pick="${devs%% *}"
            for _vd in $devs; do
                devinfos=$(printf '%s%s|%s\n' "$devinfos" "$_vd" "$(_vtop_devinfo "$_vd")")
            done
        fi
    fi
    datadir="${datadir:-unknown}"
    # Custom tablespaces (and a relocated WAL dir) can live on OTHER
    # filesystems: their device stacks are resolved ONCE here and reused by
    # the iostat page every frame (same-fs ones dedup away silently).
    tsdevs=""
    if [ -d "$datadir/pg_tblspc" ]; then
        for _t in "$datadir"/pg_tblspc/* "$datadir"/pg_xlog "$datadir"/pg_wal; do
            [ -L "$_t" ] || continue
            _tdir=$(readlink -f "$_t" 2>/dev/null)
            [ -n "$_tdir" ] && [ -d "$_tdir" ] || continue
            _tdev=$(_vtop_disk_dev "$_tdir") || continue
            for _d in $(_vtop_disk_stack "$_tdev"); do
                case " $tsdevs " in *" $_d "*) ;; *) tsdevs="$tsdevs $_d";; esac
            done
        done
        tsdevs="${tsdevs# }"
    fi
    devinfo=""
    [ -n "$dev" ] && devinfo=$(_vtop_devinfo "$dev")
    return 0
}

run_vtop() {
    local interval=15 osint=3 dbsub=5 ossub=3 dbint="" once=0 want_color="" want_plain=0
    while [ $# -gt 0 ]; do
        case "$1" in
            -I)       [ $# -lt 2 ] && { echo "Error: -I requires a value (seconds)" >&2; return 2; }
                      dbint="$2"; shift 2;;
            -i)       [ $# -lt 2 ] && { echo "Error: -i requires a value (seconds)" >&2; return 2; }
                      dbsub="$2"; shift 2;;
            -O)       [ $# -lt 2 ] && { echo "Error: -O requires a value (seconds)" >&2; return 2; }
                      osint="$2"; shift 2;;
            -o)       [ $# -lt 2 ] && { echo "Error: -o requires a value (seconds)" >&2; return 2; }
                      ossub="$2"; shift 2;;
            -n)       echo "Error: -n is no longer supported (the main screen's TOPSQL shows one top-1 row, and only when cpu_usage% > 50)" >&2; return 2;;
            --once)   once=1; shift;;
            # ---- terminal capability switches (user's question 2026-09-27:
            # "有些终端没设置显示颜色 怎么办") -- see the block further down.
            --color)    want_color=1; shift;;
            --no-color) want_color=0; shift;;
            --plain)    want_plain=1; shift;;    # no colour AND no cursor control
            -h|--help) vtop_help; return 0;;
            *)        echo "Error: unknown option '$1' (usage: vb_tool vtop [-I <db_sec>] [-i <db_sub>] [-O <os_sec>] [-o <os_sub>] [--once] [--color|--no-color|--plain])" >&2; return 2;;
        esac
    done
    # ★2026-11-16 旗标改版清障: 这里原有一段对 `interval` 的校验 (文案还写着 -i),
    # 但 -I 的值在下方才经 dbint 落进 interval -- 该段校验的永远是常量默认 15,
