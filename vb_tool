                            _vtop_lv SESS "" \
                                "total_sess|$s_tot" "active|$s_act" \
                                "idle|$s_idle" "idle_tx|$s_iit" \
                                "longtx_60s^|$s_ltx" \
                                "autovac_workers|$s_avac" \
                                "smp_workers|$s_smp" \
                                "jdbc_workers|$s_jdbc"
                        fi
                        if [ -n "$ltx_raw" ]; then
                            printf "${c_sec}[LTX]${c_off}      ${c_lbl}%-10s %-11s %-14s %-9s %-9s %-8s %-8s %-19s %s${c_off}\n" "active_ltx" "idle_tx_ltx" "sid" "user" "db" "state" "xact_age" "event" "sqltext"
                            local l_sid l_usr l_db l_st l_age l_we l_sql l_ah
                            while IFS='|' read -r l_sid l_usr l_db l_st l_age l_we l_sql; do
                                [ -z "$l_sid" ] && continue
                                l_ah=$(awk -v x="$l_age" 'BEGIN{s=x;d=int(s/86400);h=int(s%86400/3600);m=int(s%3600/60);ss=s%60; if(d>0)printf "%dd%02dh",d,h; else if(h>0)printf "%dh%02dm",h,m; else printf "%dm%02ds",m,ss}')
                                printf '%s' "$c_red"
                                printf '           %-10s %-11s %-14.14s %-9.9s %-9.9s %-8.8s %-8s %-19.19s %.40s\n' "${ltxc_a:-0}" "${ltxc_i:-0}" "$l_sid" "$l_usr" "$l_db" "$l_st" "$l_ah" "$l_we" "$l_sql"
                                printf '%s' "$c_off"
                            done <<< "$ltx_raw"
                        else
                            # empty: keep the header visible and put a "-" under every
                            # column (user's call 2026-09-26 -- no bare "none"; the column
                            # structure should always be readable)
                            printf "${c_sec}[LTX]${c_off}      ${c_lbl}%-10s %-11s %-14s %-9s %-9s %-8s %-8s %-19s %s${c_off}\n" "active_ltx" "idle_tx_ltx" "sid" "user" "db" "state" "xact_age" "event" "sqltext"
                            printf '           %-10s %-11s %-14.14s %-9.9s %-9.9s %-8.8s %-8s %-19.19s %.40s\n' "${ltxc_a:-0}" "${ltxc_i:-0}" "-" "-" "-" "-" "-" "-" "-"
                        fi
                        _vtop_lv ISTAT "" \
                            "tps|${ist_tps:--}" "qps|${ist_qps:--}" "commit/s|${ist_cm:--}" "rollback/s|${ist_roll:--}" \
                            "deadlocks/s|${ist_dl:--}" \
                            "logical_read/s|${ist_lg:--}" "physical_read/s|${ist_ph:--}" \
                            "pagewrite/s|${ist_pw:--}" \
                            "redo/s|${ist_rd:--}" "temp_byte/s|${ist_tp:--}"
                        # ★[WAIT] sits right under [ISTAT] (user's call 2026-09-26, moved
                        # here from the first idea of under-[REPL]): active-session
                        # wait-event classes. on_cpu = active AND (event IS NULL OR
                        # 'none'); wait_status = STATUS class minus 'none' (gtm /
                        # wait cmd / Sort、HashAgg 算子态). ★the five sum EXACTLY to
                        # active_sess: every event falls in exactly one of the four
                        # classes (204-verified), none/null -> on_cpu.
                        _vtop_lv WAIT "" \
                            "wait_io|${w_io:--}" "wait_lock|${w_lock:--}" \
                            "wait_lwlock|${w_lwlock:--}" "wait_status|${w_stat:--}" \
                            "on_cpu|${w_cpu:--}"
            # ★[XLOG] 取代原 [TOPEVENT](user's call 2026-09-26)，字段参照 vb_tool xloghc；
            # 数值已在 204 上与 xloghc 逐字段对账一致（ckpt_redo/ckpt_lsn/total_count/total_size 全等）。
            _vtop_lv XLOG "" \
                "curr_redo_lsn|${x_cur:--}" "oldest_xlog_lsn|${x_old:--}" \
                "ckpt_redo_lsn|${x_ckr:--}" \
                "cbm_tracked_lsn|${x_cbm:--}" "min_restart_lsn|${x_rest:--}" \
                "min_need_archive|${x_arch:--}" \
                "total_count|${x_cnt:--}" "total_size|${x_sz:--}"
            # ★[REPL] 与 awr 的 Replication Stat 同源同字段(pg_stat_replication);
