                row_count = 0
                for time_label, uid_escaped, uid_safe, count, bg_color in table_rows:
                    row_count += 1
                    row_class = "period-row-hidden" if row_count > 10 else ""
                    html_parts.append(f"""
                        <tr class="{row_class}" style="background-color: {bg_color};">
                            <td>{time_label}</td>
                            <td><a href="#detail-{uid_safe}" class="uid-link" onclick="goToDetail('{uid_safe}', event)">{uid_escaped}</a></td>
                            <td>{count}</td>
                        </tr>
                    """)
                
                html_parts.append("""
                </table>
                """)
                
                if len(table_rows) > 10:
                    html_parts.append(f"""
                    <div class="period-table-arrow" data-table-id="{table_id}" data-dim-id="{dim_id}" onclick="expandPeriodTableStep('{table_id}', '{dim_id}', this)">
                        <svg viewBox="0 0 24 24" width="16" height="16"><path d="M7 10l5 5 5-5z" fill="#3498db"/></svg>
                    </div>
                    """)
                
                html_parts.append('</div>')
            
            html_parts.append('</div>')
        
        if sql_type:
            # 当指定 sql_type 时，不生成外层容器的关闭标签，由外层容器统一控制
            pass
        else:
            html_parts.append("""
            </div>
            """)

            html_parts.append("</div>")

        return ''.join(html_parts), chart_data
    
    @staticmethod
    def generate_full_html_report(sorted_data, summary_info, time_analysis_info, overall_min_time, overall_max_time, total_size_mb_all, total_elapsed_seconds_all, all_total_list, deadlock_list=None, lock_event_list=None, lock_chain_list=None, error_list=None, statement_filter='query', sqlhc_data=None, opt_params_info=None, debug=False):
        """生成完整的HTML报告，包含导航栏和所有三个部分。

        超长 SQL 不落地外置文件，而是以 Base64 内嵌进 HTML，点击按钮时由前端
        解码并通过 Blob 触发 txt 下载，兼顾单文件便携与页面渲染性能。
        """
        deadlock_list = deadlock_list or []
        lock_event_list = lock_event_list or []
        lock_chain_list = lock_chain_list or []
        error_list = error_list or []
        sqlhc_data = sqlhc_data or {}
        opt_params_info = opt_params_info or {}

        # ===== HTML 体积埋点统计(调试用,仅 debug=True 时输出) =====
        _debug = bool(debug)
        import time as _time_mod
        _html_size_stats = {}
        _html_size_t0 = _time_mod.time()
        def _record_size(name, content, is_html=True):
            """记录某段内容大小。仅 debug 模式下保留数据,否则空操作"""
            if not _debug:
                return
            if content is None:
                content = ''
            if not isinstance(content, str):
                content = str(content)
            _html_size_stats[name] = {
                'chars': len(content),
                'bytes': len(content.encode('utf-8')),
                'rows': content.count('<tr') if is_html else 0,
            }
        # ===== 埋点统计结束 =====

        def _b64(text):
            """将文本 UTF-8 编码后做 Base64，用于安全内嵌进 HTML data 属性。"""
            return base64.b64encode((text or '').encode('utf-8')).decode('ascii')

        def _gz_b64(text):
            """将文本 UTF-8 编码后 gzip 压缩,再 Base64 编码,用于超长内容内嵌。
            相比 _b64 体积可减少 90%+,下载后为 .gz 文件,用户用桌面工具
            (7-Zip/WinRAR/macOS 解压)解压得到 .txt。浏览器侧不解压。
            compresslevel=6:gzip 默认级别,相比 level=9 速度提升 2-3 倍,压缩率仅损失约 2%"""
            if not text:
                return ''
            return base64.b64encode(gzip.compress(text.encode('utf-8'), compresslevel=6)).decode('ascii')
        # 2. 生成锁/死锁相关章节
        deadlock_section = ReportGenerator.generate_deadlock_section(deadlock_list)
        _record_size('deadlock_section', deadlock_section)
        _record_size('input_deadlock_list', f'count={len(deadlock_list)}', is_html=False)

        lock_event_section = ReportGenerator.generate_lock_event_section(lock_event_list)
        _record_size('lock_event_section', lock_event_section)
        _record_size('input_lock_event_list', f'count={len(lock_event_list)}', is_html=False)

        lock_chain_section = ReportGenerator.generate_lock_chain_section(lock_chain_list)
        _record_size('lock_chain_section', lock_chain_section)
        _record_size('input_lock_chain_list', f'count={len(lock_chain_list)}', is_html=False)

        # 3. 锁/死锁详情分析部分（独立栏目，无内容时隐藏）
        has_lock_content = deadlock_section or lock_event_section or lock_chain_section
        if has_lock_content:
            lock_section_html = f"""
            <section id="lock-section">
                <h2>锁/死锁详情分析</h2>
