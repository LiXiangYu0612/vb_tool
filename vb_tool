SELECT n.nspname AS "Schema",c.relname,decode(c.relkind,'r','table','v','view') as type FROM pg_class c join pg_catalog.pg_namespace n ON n.oid = c.relnamespace WHERE c.relname LIKE concat('%', :'name', '%') and c.relkind in ('r','v');
