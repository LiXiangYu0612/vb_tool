        lines.append(" while 'awr enable' is on; manual snapshots alone carry no series)")
        return 0, "\n".join(lines)
    # window filter (audit 2026-10-30): drop the loader's pre-begin warmup
    # minute -- gauges need no diff baseline, same as text_tcp/text_mem
    _bts = str(m.get("begin_ts", ""))
