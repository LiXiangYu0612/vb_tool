        </tr>
        """)
        detail_html_parts.append('</thead><tbody>')
        
        visible_rows = 10
        _total_detail_rows = len(sorted_data)
        _detail_t0 = _time_mod.time()
        for idx, (unique_id, stat) in enumerate(sorted_data):
            # 进度日志:每 50 行输出一次,以及第 1 行(让用户尽早看到进度)
            if idx == 0 or (idx + 1) % 50 == 0:
                _elapsed = _time_mod.time() - _detail_t0
                print(f"[进度] 慢SQL详情生成: {idx + 1}/{_total_detail_rows} 行, 耗时 {_elapsed:.1f}s", file=sys.stderr)
            row_class_base = ""
            avg_duration = stat['avg_duration']
            for min_t, max_t, color, rname in ReportGenerator.TIME_RANGES:
                if min_t <= avg_duration < max_t:
                    row_class_base = f"range-{rname.replace('以上', 'above').replace('-', 'to').replace('s', '').replace('以下', 'below')}"
                    break
            
            row_visibility_class = "" if idx < visible_rows else "detail-row-hidden"
            full_row_class = f"{row_class_base} {row_visibility_class}".strip()

            # URL 安全标识提前定义：超长 SQL 的下载文件名、行 id 都需要用到
            unique_id_safe = ReportGenerator._make_id_safe(unique_id)
            
            # 生成详细执行语句HTML：超长 SQL 仅截断展示，完整内容以 Base64 内嵌进
            # data 属性，点击按钮时由前端解码并通过 Blob 触发 txt 下载；避免数百万字符
            # 的 SQL 被 normalize/escape/json.dumps 反复处理导致卡顿
            # 注意:HTML 展示截断阈值 MAX_HTML_INLINE_SQL_LEN(默认 1000)仅控制页面展示体积,
            # 不影响 fill_sql_params 的参数填充逻辑——所有 SQL 均已完成变量替换,
            # 超长内容在替换后由 Base64 压缩下载承担。
            max_full = stat['max_duration_query']
