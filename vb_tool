    h.append('<table class="t"><tr><th>Sample Time</th><th class="n">ltx60_cnt</th>'
             '<th class="n">ltx60_itx_cnt</th><th class="n">ltx60_active_cnt</th>'
             '<th class="n">Oldest PID</th><th>Oldest Xact Start</th><th class="n">duration</th>'
             '<th>State</th><th>Wait Event</th><th class="n">unique_sql_id</th>'
             '<th class="n">OldestXmin</th><th class="n">Current Xid</th></tr>')
    for ts, kind, f in rows:
