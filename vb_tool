    @staticmethod
    def generate_lock_chain_section(lock_chain_list):
        """
        生成锁等待链章节 HTML：按等待事务分组，展示等待者 ← 持有者及其语句。
        """
        if not lock_chain_list:
            return ''

        # 只保留有阻塞者信息的 acquired 事件（waiting 已合并到 acquired），按 holder_txid 分组
        # 注意：holder_txid 可能为空字符串，此时仍应显示（标记为未知阻塞者）
        chain_events = [
            ev for ev in lock_chain_list
            if ev.get('event_kind') == 'acquired'
        ]
        if not chain_events:
            return ''

        # 按 holder_txid 分组，按等待耗时降序排序
        from collections import defaultdict
        grouped = defaultdict(list)
        for ev in chain_events:
            grouped[ev['holder_txid']].append(ev)

        # 按组内最大等待耗时降序排列
        sorted_groups = sorted(
            grouped.items(),
            key=lambda x: max(ev.get('wait_time_ms', 0) for ev in x[1]),
            reverse=True
        )

        html_parts = []
        html_parts.append("""
        <h3 id="lock-chain-ranking">锁等待链分析</h3>
        <div class="top10-container lock-chain-container">
            <div class="top10-section lock-chain-section" data-sql-type="lock-chain">
                <h4>按阻塞者事务分组（阻塞链：{} 条）</h4>
        """.format(len(chain_events)))

        for holder_txid, events in sorted_groups:
            # 组内按等待耗时降序
            events_sorted = sorted(events, key=lambda x: x.get('wait_time_ms', 0), reverse=True)
            # 优先从 acquired 事件取 holder 信息（此时事务语句已完整记录）
            holder_session = ''
            holder_unique_id = ''
            holder_all_sql = []
            for ev in events_sorted:
                if ev.get('event_kind') == 'acquired' and ev.get('holder_all_sql'):
                    holder_session = ev.get('holder_session', '')
                    holder_unique_id = ev.get('holder_unique_id', '')
                    holder_all_sql = ev.get('holder_all_sql', [])
                    break
            if not holder_all_sql:
                holder_session = events_sorted[0].get('holder_session', '')
                holder_unique_id = events_sorted[0].get('holder_unique_id', '')
                holder_all_sql = events_sorted[0].get('holder_all_sql', [])

            # 阻塞者标识：有 txid 显示 txid，否则显示"未知阻塞者"
            holder_txid_display = html.escape(holder_txid, quote=True) if holder_txid else '未知阻塞者'

            # 阻塞者 Unique ID 链接
            if holder_unique_id:
                holder_uid_safe = ReportGenerator._make_id_safe(holder_unique_id)
                holder_uid_link = f'<a href="#detail-{holder_uid_safe}" class="uid-link" onclick="goToDetail(\'{holder_uid_safe}\', event)">{html.escape(holder_unique_id, quote=True)}</a>'
            else:
                holder_uid_link = '-'

            # 阻塞者事务语句列表
            holder_sql_html = ''
            if holder_all_sql:
                holder_sql_items = []
                for s in holder_all_sql[:10]:  # 最多展示10条
                    s_escaped = html.escape(s[:300], quote=True)
                    if len(s) > 300:
                        s_escaped += '...'
                    holder_sql_items.append(f"<li><pre>{s_escaped}</pre></li>")
                if len(holder_all_sql) > 10:
                    holder_sql_items.append(f"<li>... 共 {len(holder_all_sql)} 条语句</li>")
                holder_sql_html = f'<ol class="holder-sql-list">{"".join(holder_sql_items)}</ol>'
            else:
                holder_sql_html = '<p class="no-holder-sql">未捕获到阻塞者事务语句</p>'

            # 等待者列表：所有 acquired 事件（waiting 已合并）
            waiter_rows = []
            for ev in events_sorted:
                # 优先用 waiting_timestamp（等待开始时间），否则用 acquired 时间
                ev_timestamp = html.escape(str(ev.get('waiting_timestamp') or ev.get('timestamp', '')), quote=True)
                ev_session = html.escape(str(ev.get('session_id', '')), quote=True)
                ev_txid = html.escape(str(ev.get('txid', '')), quote=True)
                ev_lock_type = html.escape(str(ev.get('lock_type', '')), quote=True)
                ev_target = html.escape(str(ev.get('target', '')), quote=True)
                ev_wait_ms = ev.get('wait_time_ms', 0)
                ev_unique_id = str(ev.get('unique_id', '')).strip()
                ev_sql = html.escape(str(ev.get('sql_text', ''))[:150], quote=True)
