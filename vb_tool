                          # integer expression expected, 不该刷到用户屏幕上。
                          if { [ -n "$prev_lsn" ] && [ "$ist_w" -gt 0 ] \
                               && [ "$i_lsn" -ge "$prev_lsn" ] && [ "$i_xc" -ge "$prev_xc" ] \
                               && [ "$i_xr" -ge "$prev_xr" ] && [ "$i_br" -ge "$prev_br" ] \
                               && [ "$i_bh" -ge "$prev_bh" ] && [ "$i_tb" -ge "$prev_tb" ] \
                               && [ "$i_nc" -ge "$prev_nc" ] && [ "$i_pw" -ge "$prev_pw" ] \
                               && [ "$i_dl" -ge "$prev_dl" ]; } 2>/dev/null; then
                              # ★every rate below is a DELTA over the sampling interval (user's spec)
                              # ★全部走 awk 浮点 (2026-11-17 三轮复核): 旧 bash 整数式先截断再
                              #   乘 —— delta=1 块/15s ⇒ (1*1000/15000)=0 ⇒ ×8192 还是 0, 帧上
                              #   印 0B/0 次, 真值 546B/s。计数列四舍五入, 字节列先乘后取整。
