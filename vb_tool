def walreceiver_subtable_html(wr):
    """Wal Receiver sub-table body html (standby role only). Mirrors the primary
    table's pipeline-lag view from the receiving end: the pipeline runs
    sender_sent -> received -> write -> flush -> replay, so
    Net = sender_sent-received, Fsync = received-flush, Apply = flush-replay,
    Total = sender_sent-replay. sync_percent/channel come from the view."""
    parts = []
    if not wr["files"]:
        return '<div class="note">no walreceiver samples in this period</div>'
