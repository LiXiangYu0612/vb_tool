            lock_section_html = ''

        # 1. 构建导航栏（无锁定内容时不显示锁详情分析链接）
        lock_nav_link = '<a href="#lock-section">🔒 锁详情分析</a>' if has_lock_content else ''
        error_section_html = ReportGenerator.generate_error_section(error_list, statement_filter)
        _record_size('error_section', error_section_html)
        _record_size('input_error_list', f'count={len(error_list)}', is_html=False)
        try:
            _total_err_bytes = sum(
                len((e.get('context_before') or '').encode('utf-8')) +
                len((e.get('context_after') or '').encode('utf-8')) +
                len((e.get('full_log') or '').encode('utf-8')) +
                len((e.get('message') or '').encode('utf-8'))
                for e in error_list
            )
            _record_size('input_error_list_bytes', f'bytes={_total_err_bytes}', is_html=False)
        except Exception:
            pass
        nav_html = f"""
        <div id="report-nav">
            <h2>慢查询分析报告导航</h2>
            <div class="nav-links">
                <a href="#summary-section">📊 SQL汇总统计</a>
