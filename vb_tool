        for k in _CFGQ:
            vb_ = _cgb2.get("kv", {}).get(k)
            ve_ = _cge2.get("kv", {}).get(k)
            if vb_ is None and ve_ is None:
                continue
            # (user 2026-11-01: Begin shows the BEGIN snapshot's own value,
            # End the END snapshot's -- printing one side's value in both
            # cells masked mid-window config changes)
            cb = _cfg_cell(k, vb_)
            ce = _cfg_cell(k, ve_)
            h.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">-</td></tr>' % (esc(k),
                     esc(trunc(cb, 40)) if cb is not None else "-",
                     esc(trunc(ce, 40)) if ce is not None else "-"))
        for k in _CUMQ:
            vb_ = _cgb2.get("kv", {}).get(k)
            ve_ = _cge2.get("kv", {}).get(k)
            if vb_ is None and ve_ is None:
                continue
            fb = fmt_int(to_num(vb_)) if vb_ is not None else "-"
            fe = fmt_int(to_num(ve_)) if ve_ is not None else "-"
            if vb_ is not None and ve_ is not None:
                # gauges (memory.usage / pids.current) may legitimately fall;
                # only MONOTONIC counters running backwards mean "cgroup
                # recreated" (2026-11-01: a clamped 0 delta contradicted the
                # row's own cells in exactly the restart scenario)
                if to_num(ve_) < to_num(vb_) and k in ("cpuacct.usage", "memory.failcnt"):
                    fd = "reset"
                else:
                    _dv = max(0, to_num(ve_) - to_num(vb_))
                    fd = ("+" + fmt_int(_dv)) if _dv else fmt_int(0)
            else:
                fd = "-"
            h.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td></tr>' % (esc(k), fb, fe, fd))
        # cpu.stat: split into per-counter rows (user 2026-10-31: every row
        # Begin/End/Delta -- nr_throttled / throttled_time deltas > 0 mean
        # the quota actually bit in this window; v2 throttled_usec likewise)
        def _statmap(d, key):
            out = {}
            for part in ((d or {}).get("kv", {}).get(key) or "").split(";"):
                if "=" in part:
                    k2, v2 = part.split("=", 1)
                    try:
                        out[k2] = to_num(v2)
                    except Exception:
                        pass
            return out
        _bcs, _ecs = _statmap(_cgb2, "cpu.stat"), _statmap(_cge2, "cpu.stat")
        for k2 in ("nr_periods", "nr_throttled", "throttled_time", "throttled_usec", "usage_usec"):
            if k2 in _bcs or k2 in _ecs:
                _fb = fmt_int(_bcs[k2]) if k2 in _bcs else "-"
                _fe = fmt_int(_ecs[k2]) if k2 in _ecs else "-"
                if k2 in _bcs and k2 in _ecs:
                    # cpu.stat counters are monotonic -- backwards = recreated
                    if _ecs[k2] < _bcs[k2]:
                        _fd = "reset"
                    else:
                        _dv2 = _ecs[k2] - _bcs[k2]
                        _fd = ("+" + fmt_int(_dv2)) if _dv2 else fmt_int(0)
                else:
                    _fd = "-"
                h.append('<tr><td>cpu.%s</td><td class="n">%s</td><td class="n">%s</td>'
                         '<td class="n">%s</td></tr>' % (k2, _fb, _fe, _fd))
        # memory.events (v2): ABSOLUTE per-snapshot counters, never a plain
        # window delta (user 2026-11-01: an OOM kill takes the DB down -- no
        # end snap gets taken; and after the restart the cgroup is RECREATED
        # and its counters restart at zero, so end-begin would read 0 and
        # bury the kill. The absolute values are the record; the delta column
        # only carries a number while the counter ran MONOTONICALLY through
        # the window -- end < begin means cgroup recreated = restart marker.)
        _meb, _mee = _statmap(_cgb2, "memory.events"), _statmap(_cge2, "memory.events")
        for k2 in ("low", "high", "max", "oom", "oom_kill"):
            if k2 not in _meb and k2 not in _mee:
                continue
            _fb = fmt_int(_meb[k2]) if k2 in _meb else "-"
            _fe = fmt_int(_mee[k2]) if k2 in _mee else "-"
            if k2 in _meb and k2 in _mee:
                if _mee[k2] < _meb[k2]:
                    _fd = "reset"
                else:
                    _dv5 = _mee[k2] - _meb[k2]
                    _fd = ("+" + fmt_int(_dv5)) if _dv5 else fmt_int(0)
            else:
                _fd = "-"
            h.append('<tr><td>memory.events %s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td></tr>' % (k2, _fb, _fe, _fd))
        # blkio service bytes: per-device Read/Write rows, window delta =
        # the group's IO throughput ("Total N" line -> io.total row)
        def _iomap(d):
            out = {}
            for item in ((d or {}).get("kv", {}).get("io.service") or "").split(";"):
                f = item.split()
                if len(f) >= 5 and f[0] != "Total":
                    try:
                        out[(f[0], "read")] = to_num(f[2])
                        out[(f[0], "write")] = to_num(f[4])
                    except Exception:
                        pass
                elif len(f) == 2 and f[0] == "Total":
                    try:
                        out[("total", "")] = to_num(f[1])
                    except Exception:
                        pass
            return out
        _bio, _eio = _iomap(_cgb2), _iomap(_cge2)
        for _dk in sorted(set(_bio) | set(_eio)):
            _fb = fmt_int(_bio[_dk]) if _dk in _bio else "-"
            _fe = fmt_int(_eio[_dk]) if _dk in _eio else "-"
            if _dk in _bio and _dk in _eio:
                # blkio service bytes are monotonic -- backwards = cgroup
                # recreated (same rule as cpuacct.usage, 2026-11-01)
                if _eio[_dk] < _bio[_dk]:
                    _fd = "reset"
                else:
                    _dv3 = _eio[_dk] - _bio[_dk]
                    _fd = ("+" + fmt_int(_dv3)) if _dv3 else fmt_int(0)
            else:
                _fd = "-"
            h.append('<tr><td>io %s %s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">%s</td></tr>' % (esc(_dk[0]), esc(_dk[1]), _fb, _fe, _fd))
        # (2026-11-01, enumerated-classes rule) an EMPTY v1 throttle file is
        # "confirmed: no device limited" -- write it explicitly instead of
        # letting the absent rows read as "not collected"
        if ((_cge2 or _cgb2).get("paths", {}).get("blkio")
                and not _cgb2.get("kv", {}).get("io.throttle.r")
                and not _cge2.get("kv", {}).get("io.throttle.r")
                and not _cgb2.get("kv", {}).get("io.throttle.w")
                and not _cge2.get("kv", {}).get("io.throttle.w")):
            h.append('<tr><td>io.throttle</td><td class="n">none (no device limited)</td>'
                     '<td class="n">none (no device limited)</td><td class="n">-</td></tr>')
        # v2 io (2026-11-01): io.max = per-device throttle CONFIG ("maj:min
        # rbps=.. wbps=.."), io.stat = per-device cumulative "maj:min
        # rbytes=.. wbytes=.. [dbytes=.. ios=..]" -- collected since 10-31
        # but never rendered, so every v2 host showed an empty IO block that
        # read as "no io limit". Config rows per-side; stat rows carry the
        # monotonic reset rule.
        def _v2io(d, key, numeric):
            out = {}
            for item in ((d or {}).get("kv", {}).get(key) or "").split(";"):
                f = item.split()
                if len(f) < 2:
                    continue
                for _pr in f[1:]:
                    if "=" not in _pr:
                        continue
                    _kk, _vv = _pr.split("=", 1)
                    if numeric:
                        # STRICT float (2026-11-01): to_num returns 0.0 on
                        # junk, turning corrupt data into "confirmed zero"
                        try:
                            out[(f[0], _kk)] = float(_vv)
                        except ValueError:
                            pass
                    else:
                        out[(f[0], _kk)] = _vv
            return out
        _bmx, _emx = _v2io(_cgb2, "io.max", False), _v2io(_cge2, "io.max", False)
        for _dk in sorted(set(_bmx) | set(_emx)):
            _cb = _bmx.get(_dk) or "-"
            _ce = _emx.get(_dk) or "-"
            h.append('<tr><td>io.max %s %s</td><td class="n">%s</td><td class="n">%s</td>'
                     '<td class="n">-</td></tr>' % (esc(_dk[0]), esc(_dk[1]),
                     esc(trunc(_cb, 40)), esc(trunc(_ce, 40))))
        # (2026-11-01, enumerated-classes rule) empty io.max = "confirmed:
        # no device throttled" -- an explicit row, not an invisible absence
        if ((_cge2 or _cgb2).get("paths", {}).get("io") and not _bmx and not _emx):
            h.append('<tr><td>io.max</td><td class="n">none (no device throttled)</td>'
                     '<td class="n">none (no device throttled)</td><td class="n">-</td></tr>')
        _bst, _est = _v2io(_cgb2, "io.stat", True), _v2io(_cge2, "io.stat", True)
        for _dk in sorted(set(_bst) | set(_est)):
            _fb = fmt_int(_bst[_dk]) if _dk in _bst else "-"
            _fe = fmt_int(_est[_dk]) if _dk in _est else "-"
            if _dk in _bst and _dk in _est:
