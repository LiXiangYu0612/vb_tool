def _parse_event_filter_arg(value):
    """解析 --exclude / --include 的单个筛选参数，逗号分隔时返回多个条件。"""
    if value is None:
        raise argparse.ArgumentTypeError("过滤条件不能为空")
    conditions = []
    field = ''
    for item in str(value).split(','):
        s = item.strip()
        if ':' in s:
            field, _, val = s.partition(':')
            field = field.strip().lower()
            val = val.strip()
        elif field:
            val = s
            if not val:
                continue
        else:
            raise argparse.ArgumentTypeError(
                f"无效的过滤条件 '{s}'，格式应为 db:xxx / user:xxx / sql_id:xxx / table:xxx")
        field_alias = {
            'db': 'db', 'database': 'db',
            'user': 'user', 'username': 'user', 'u': 'user',
            'sql_id': 'sql_id', 'sqlid': 'sql_id', 'unique_id': 'sql_id',
            'uniqueid': 'sql_id', 'uid': 'sql_id',
            'table': 'table', 'tab': 'table',
        }
        if field not in field_alias:
            raise argparse.ArgumentTypeError(
                f"无效的过滤字段 '{field}'，支持: db / user / sql_id / table")
        if not val:
            raise argparse.ArgumentTypeError(f"过滤条件 '{s}' 的值不能为空")
        conditions.append((field_alias[field], val))
    if not conditions:
        raise argparse.ArgumentTypeError("过滤条件不能为空")
    return conditions[0] if len(conditions) == 1 else conditions


def _normalize_event_filter(items):
    """归一化为 {'db': set(), 'user': set(), 'sql_id': set(), 'table': set()}。

    db/user/sql_id 精确匹配，table 支持 table 或 schema.table 精确匹配。
    """
    norm = {'db': set(), 'user': set(), 'sql_id': set(), 'table': set()}
    if not items:
        return norm

    def add_condition(condition):
        if not (isinstance(condition, (list, tuple)) and len(condition) == 2
                and isinstance(condition[0], str) and condition[0] in norm):
            return
        field, val = condition
        value = str(val).strip().replace('"', '').lower()
        if field == 'table':
            parts = value.split('.')
            value = (None, parts[0]) if len(parts) == 1 else (parts[-2], parts[-1])
        norm[field].add(value)

    def visit(item):
        if (isinstance(item, (list, tuple)) and len(item) == 2
                and isinstance(item[0], str) and item[0] in norm):
            add_condition(item)
        elif isinstance(item, (list, tuple)):
            for sub in item:
                visit(sub)

    visit(items)
    return norm


def _event_passes_filter(database, user, unique_id, include, exclude, sql_text=None):
    """判断事件是否通过 include/exclude 过滤；table 条件按 SQL 实际引用对象匹配。"""
    db_v = (database or '').lower()
    user_v = (user or '').lower()
    uid_v = str(unique_id).strip() if unique_id else ''
    table_include = include.get('table', set()) if include else set()
    table_exclude = exclude.get('table', set()) if exclude else set()

    def table_matches(tables):
        if not sql_text:
            return False
        # SQL 对象解析开销较大，仅在配置 table 条件时执行，并按 SQL+用户缓存。
        objects = _extract_event_sql_objects(sql_text, user_v)
        return any(
            (schema is None and table == object_name)
            or (schema is not None and schema == owner and table == object_name)
            for owner, object_name in objects
            for schema, table in tables
        )

    # include table 只筛选有 SQL 文本的事件；其余 db/user/sql_id 规则保持不变。
    if table_include and not sql_text:
        return False
    if exclude:
        if db_v and db_v in exclude.get('db', ()):
            return False
        if user_v and user_v in exclude.get('user', ()):
            return False
        if uid_v and uid_v in exclude.get('sql_id', ()):
            return False
        if table_exclude and table_matches(table_exclude):
            return False

    if include and any(include.values()):
        if db_v and db_v in include.get('db', ()):
            return True
        if user_v and user_v in include.get('user', ()):
            return True
        if uid_v and uid_v in include.get('sql_id', ()):
            return True
        if table_include and table_matches(table_include):
            return True
        return False

    return True


