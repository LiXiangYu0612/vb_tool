    except Exception as e:
        return f"Query error: {e}"

    if debug and stderr.strip():
        print(f"[DEBUG] sqlhc tabsize vsql stderr:\n{stderr.strip()}", file=sys.stderr)
    if process.returncode != 0:
        return f"Query failed: {stderr.strip()}"

    result = _strip_echo_headers(stdout).rstrip()
    if debug:
        print(f"[DEBUG] sqlhc tabsize: db={db_name}, 返回长度={len(result)}", file=sys.stderr)
    return result


def _run_vsql_batch(db_name, blocks, timeout=120, debug=False, label='sqlhc batch',
                    extra_args=None):
    """每块用一次 vsql -c 执行，结果直接关联 marker，不依赖输出分隔标记。

    Vastbase 在一个进程中使用多个 -c 时仅输出最后一条查询结果；块内仍保留
    多条 SQL 及标题。单块失败不影响其他块，超时时回收已完成块。

    Args:
        extra_args: 额外的 vsql 参数（插在 -X 之后）。如 ['-A', '-t'] 输出
                    非对齐纯文本（无列头/分隔线/续行 + 标记），供对象定义等
                    需要原始多行文本的调用方使用；默认不传保持对齐格式。
    """
    results = {}
    if not blocks:
        return results, None

    deadline = time.monotonic() + timeout * len(blocks)
    errors = []
    for marker, query in blocks:
        args = _append_vsql_commands(
            ['vsql', '-d', db_name, '-X'] + list(extra_args or []) + ['-P', 'footer=off'],
            query)
        remaining = max(0.1, deadline - time.monotonic())
        try:
            process = subprocess.Popen(
                args, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                universal_newlines=True
            )
            stdout, stderr = process.communicate(timeout=remaining)
        except FileNotFoundError:
            return results, 'vsql not found.'
        except subprocess.TimeoutExpired:
            process.kill()
            process.communicate()
            missing = [m for m, _ in blocks if m not in results]
            error = (f'batch query timeout after {timeout * len(blocks)}s: '
                     f'已回收 {len(results)}/{len(blocks)} 块, 未完成: {", ".join(missing)}')
            return results, error
        except Exception as e:
            return results, f'batch query error: {e}'

        if debug:
            print(f'[DEBUG] {label}({marker}): returncode={process.returncode}, '
                  f'stdout长度={len(stdout)}, stderr={stderr.strip()!r}', file=sys.stderr)
        if process.returncode != 0:
            errors.append(f'{marker}: {stderr.strip() or f"vsql exit code {process.returncode}"}')
            continue
        results[marker] = _strip_echo_headers(stdout).strip('\n')

    if debug:
        print(f'[DEBUG] {label}: 解析出 {len(results)}/{len(blocks)} 块', file=sys.stderr)
    return results, '; '.join(errors) if errors else None


def batch_query_sqlhc_statement_stats(unique_ids, timeout=120, debug=False):
    """批量查询所有 uid 的 sqlstat（postgres 库，一次 vsql 会话）。

    Args:
        unique_ids: unique_query_id 集合/列表
        timeout: 单块超时时间（秒）
        debug: 是否打印调试日志

    Returns:
        dict: uid字符串 -> 格式化文本；查询失败的 uid 不在结果中（由调用方回退单查）
    """
    blocks, uid_by_marker = [], {}
    for uid in unique_ids:
        uid_str = str(uid).strip()
        try:
            u = int(uid_str)
        except (ValueError, TypeError):
            continue
        marker = f"__SQLHC_BLOCK__:{u}:sqlstat__"
        blocks.append((marker, _build_sqlhc_statement_stats_query(u)))
        uid_by_marker[marker] = uid_str

    results, error = _run_vsql_batch(
        'postgres', blocks, timeout=timeout, debug=debug, label='sqlhc statement stats batch')
    if error:
        print(f"WARNING: sqlhc statement stats 批量查询: {error}", file=sys.stderr)
    return {uid_by_marker[m]: body for m, body in results.items()}


def batch_query_sqlhc_table_info(uid_tables, db_name, timeout=120, debug=False, workers=6):
    """批量查询多个 uid 的 tabstat + tabsize（同一库）。

    优化:
      1. 表集合去重 —— 表集合完全相同的 uid 只查一次，结果共享（输出一致）
      2. 动态并行 —— 每个唯一表集合一个任务，工作线程做完即取下一个，
         避免静态分片时慢表集合（大分区表 tabsize）拖尾

    Args:
        uid_tables: [(uid_str, resolved_tables), ...]，resolved_tables 为
                    已解析 schema 的表列表 [(schema, table), ...]
        db_name: 数据库名（SQL 执行的库）
        timeout: 保留的参数；每类 tabstat 及 tabsize 分别固定 15 秒超时
        debug: 是否打印调试日志
        workers: 并行 vsql 会话数

    Returns:
        (dict, dict): uid -> tabstat文本, uid -> tabsize文本；
                      查询失败的 uid 不在结果中（由调用方回退单查）
    """
    # 1. 按"表集合"去重: 相同集合的 uid 共享同一次查询
    set_key_to_uids = {}  # 表集合key -> [uid_str, ...]
    for uid_str, tables in uid_tables:
        uid_str = str(uid_str).strip()
        if not tables or not re.fullmatch(r'[A-Za-z0-9_-]+', uid_str):
            continue
        key = tuple(sorted(set(tables)))
        set_key_to_uids.setdefault(key, []).append(uid_str)

    unique_sets = list(set_key_to_uids.keys())
    if not unique_sets:
        return {}, {}

    # 2. 动态并行: 一个表集合一个任务（tabstat 分 8 段独立查询 + tabsize 单查）
    workers = max(1, min(workers, len(unique_sets)))

    def _run_set(idx, key):
        tables = list(key)
        m_size = f"__SQLHC_BLOCK__:s{idx}:tabsize__"
        _t = time.monotonic()
        # 8 类 tabstat 分别独立 vsql -c，每段 15 秒，失败不影响其他段。
        tabstats_text = query_sqlhc_tabstats(
            tables, db_name, timeout=15, debug=debug,
            label=f'sqlhc table info({db_name})#{idx}:tabstat')
        results, error = _run_vsql_batch(
            db_name, [(m_size, _build_sqlhc_tabsize_query(tables))],
            timeout=15, debug=debug,
            label=f'sqlhc table info({db_name})#{idx}:tabsize')
        results[f"__SQLHC_BLOCK__:s{idx}:tabstat__"] = tabstats_text
        if error and 'batch query timeout' in error:
            # 仅 tabsize 超时: 保留已完成的 8 段 tabstat,避免误判整集合失败。
            results[m_size] = (
                "table size 查询超时，已跳过单查回退；"
                "请使用 --debug 输出的 SQL 单独排查。"
            )
            error = None
        if debug:
            tables_show = ','.join(f'{o}.{t}' for o, t in key)
            print(f"[DEBUG] sqlhc table info({db_name})#{idx}: {tables_show} 耗时 {time.monotonic() - _t:.1f}s", file=sys.stderr)
        return idx, key, results, error

    with ThreadPoolExecutor(max_workers=workers) as executor:
        set_results = list(executor.map(
            lambda arg: _run_set(*arg), list(enumerate(unique_sets))))

    # 3. 汇总: marker -> 表集合key，再映射回所有共享 uid
    key_to_tabstats, key_to_tabsize = {}, {}
    failed_table_queries = set()
    for idx, key, results, error in set_results:
        if error:
            print(f"WARNING: sqlhc table info 批量查询({db_name})#{idx}: {error}", file=sys.stderr)
            if 'batch query timeout' in error:
                # 该表集合的批量查询已超时,不再对 tabstat/tabsize 单查回退。
                failed_table_queries.add(key)
        for marker, body in results.items():
            if marker.endswith(':tabstat__'):
                key_to_tabstats[key] = body
            elif '超时被中断' in body:
                # 查询超时后不再立即用同一 SQL 回退单查，避免重复等待。
                failed_table_queries.add(key)
            else:
                key_to_tabsize[key] = body

    tabstats_map, tabsize_map = {}, {}
    for key, uids in set_key_to_uids.items():
        if key in key_to_tabstats or key in key_to_tabsize or key in failed_table_queries:
            for uid_str in uids:
                if key in key_to_tabstats:
                    tabstats_map[uid_str] = key_to_tabstats[key]
                elif key in failed_table_queries:
                    tabstats_map[uid_str] = (
                        "table statistics 批量查询超时，已跳过单查回退；"
                        "请使用 --debug 输出的 SQL 单独排查。"
                    )
                if key in key_to_tabsize:
                    tabsize_map[uid_str] = key_to_tabsize[key]
                elif key in failed_table_queries:
                    tabsize_map[uid_str] = (
                        "table size 查询超时，已跳过重复回退查询；"
                        "请使用 --debug 输出的 SQL 单独排查。"
                    )
    if debug:
        print(f"[DEBUG] sqlhc table info({db_name}): {len(uid_tables)} 个 uid 去重为 {len(unique_sets)} 个表集合, {workers} 并行会话(动态)", file=sys.stderr)
    return tabstats_map, tabsize_map


def _batch_collect_object_definitions(def_by_db, timeout=120, debug=False):
    """按库批量收集 def_by_db 中所有视图/函数的完整定义（非对齐纯文本，用于报告展示）。

    复用 _run_vsql_batch block 模式：每个对象一个 block（marker 区分），
    同名函数重载全部输出；vsql 附加 --pset=pager=off -q -A -t 参数（非对齐 +
    只输出元组），输出即 pg_get_viewdef/pg_get_functiondef 的原始多行文本，
    无对齐格式的列头/分隔线/行尾 "+" 续行标记与列宽空格填充。

    Args:
        def_by_db: {db_name: [{'depth','objects': [...]}, ...]}（原地填充 define_sql）
        timeout: 单块超时时间（秒）
        debug: 是否打印调试日志
    """
    for db_name, groups in (def_by_db or {}).items():
        blocks, obj_by_marker = [], {}
        idx = 0
        for group in groups:
            for obj in group.get('objects', []):
                schema, name = obj.get('schema', ''), obj.get('name', '')
                if not schema or not name:
                    continue
                marker = f"__SQLHC_BLOCK__:def{idx}:{obj.get('type', 'view')}__"
                idx += 1
                if obj.get('type') == 'view':
                    query = (
                        "SELECT pg_catalog.pg_get_viewdef(c.oid, true)"
                        " FROM pg_catalog.pg_class c"
                        " JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace"
                        " WHERE c.relkind IN ('v','m')"
                        f"  AND n.nspname = '{schema}' AND c.relname = '{name}';"
                    )
                else:
                    query = (
                        "SELECT pg_catalog.pg_get_functiondef(p.oid)"
                        " FROM pg_catalog.pg_proc p"
                        " JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace"
                        " WHERE p.prokind IN ('f','p')"
                        f"  AND n.nspname = '{schema}' AND p.proname = '{name}';"
                    )
                blocks.append((marker, query))
                obj_by_marker[marker] = obj
        if not blocks:
            continue
        results, error = _run_vsql_batch(
            db_name, blocks, timeout=timeout, debug=debug,
            label=f'sqlhc object definitions({db_name})',
            extra_args=['--pset=pager=off', '-q', '-A', '-t'])
        if error:
            print(f"WARNING: sqlhc 对象定义批量查询({db_name}): {error}", file=sys.stderr)
        for marker, body in results.items():
            obj = obj_by_marker.get(marker)
            if obj is None:
                continue
            text = (body or '').strip('\r\n')
            if text.strip():
                obj['define_sql'] = text
                obj['errors'] = [e for e in obj.get('errors', []) if '无法获取定义' not in e]


def expand_objects_for_uids(uid_objs, uid_db_map, timeout=60, debug=False, max_depth=5):
    """批量按 view_table_usage 递归展开所有 UID 的视图依赖。

    每层合并同库视图批量查询直接依赖；视图/函数定义仅用于展示，函数不再
    从定义文本提取内部表。visited 去重防循环，max_depth 限制递归深度。

    Args:
        uid_objs: {uid_str: [(owner, name), ...]} 各 uid 的初始对象
        uid_db_map: {uid_str: db_name}
        timeout: vsql 超时时间（秒）
        debug: 是否打印调试日志
        max_depth: 最大递归深度

    Returns:
        (tables_by_uid, def_by_db, uid_objects, truncated):
          tables_by_uid: {uid_str: [(schema, name), ...]} 递归展开后的最终表集合
          def_by_db: {db_name: [{'depth','objects'}]} 按递归层级排列（同库多 uid
                     共享对象的定义只出现一次，用于定义批量收集去重）
          uid_objects: {uid_str: {(schema, name), ...}} 各 uid 递归链路涉及的
                       视图/函数对象（用于按 uid 过滤定义，避免同库其他 SQL
                       的定义被误追加）
          truncated: bool，达到 max_depth 仍有未展开对象时为 True
    """
    db_frontier = {}   # db_name -> [(owner, name, default_user, uid_set), ...]
    # uid -> {(schema, name)}：该 uid 递归链路涉及的视图/函数
    uid_objects = {uid_str: set() for uid_str in (uid_objs or {})}
    for uid_str, objs in (uid_objs or {}).items():
        if not objs:
            continue
        db_name = (uid_db_map or {}).get(uid_str, 'postgres')
        for owner, name in objs:
            key = (owner, name, owner, {uid_str})
            existing = db_frontier.setdefault(db_name, [])
            # 同名对象合并 uid 集合
            hit = next((e for e in existing if e[0] == owner and e[1] == name), None)
            if hit is not None:
                hit[3].add(uid_str)
            else:
                existing.append(list(key))

    tables_by_uid = {uid_str: [] for uid_str in (uid_objs or {})}
    def_by_db = {}
    truncated = False
    visited = set()  # (db, schema, name) 已查询过的对象，避免重复取定义
    processed = set()  # (db, schema, name, uid)：对象可重复进入 frontier 以补齐各 UID 依赖

    for depth in range(1, max_depth + 1):
        had_expandable = False
        for db_name, pending in list(db_frontier.items()):
            pending = [(o, t, d, u) for o, t, d, u in pending
                       if any((db_name, o, t, uid) not in processed for uid in u)]
            if not pending:
                db_frontier[db_name] = []
                continue
            processed.update((db_name, o, t, uid) for o, t, _, u in pending for uid in u)
            pending_keys = {(o, t) for o, t, _, _ in pending}
            new_keys = pending_keys - visited
            visited.update(new_keys)
            frontier = [(o, t) for o, t, _, _ in pending]

            kinds = _query_object_kinds([t for _, t in frontier], db_name, timeout=timeout, debug=debug)
            # 逐对象分类：default_schema 取该 frontier 条目的 default_user（与来源
            # SQL 相同的 schema），跨 schema 同名对象不会互相误挂 uid
            obj_uids = {}   # (schema, name) -> set(uid_str)
            obj_class = {}  # (schema, name) -> 'table'/'view'/'function'/...
            unresolved = []  # [(owner, name)] 保留原猜测
            for o, t, d, u in pending:
                tables, views, funcs, unres = _classify_frontier(
                    [(o, t)], kinds, db_name, default_schema=d or 'public')
                for key in tables + views + funcs:
                    obj_uids.setdefault(key, set()).update(u)
                for key in tables:
                    obj_class.setdefault(key, 'table')
                for key in views:
                    obj_class.setdefault(key, 'view')
                for key in funcs:
                    obj_class.setdefault(key, 'function')
                for key in unres:
                    if key not in unresolved:
                        unresolved.append(key)
                    obj_uids.setdefault(key, set()).update(u)
            tables = [k for k, c in obj_class.items() if c == 'table']
            views = [k for k, c in obj_class.items() if c == 'view']
            funcs = [k for k, c in obj_class.items() if c == 'function']
            if debug:
                print(f"[DEBUG] 批量递归展开({db_name}) depth={depth}: 表={tables}, 视图={views}, 函数={funcs}, 未解析={unresolved}", file=sys.stderr)
            for schema, name in tables + unresolved:
                for uid_str in obj_uids.get((schema, name), set()):
                    if (schema, name) not in tables_by_uid.setdefault(uid_str, []):
                        tables_by_uid[uid_str].append((schema, name))

            if not views and not funcs:
                db_frontier[db_name] = []
                continue  # 该库已收敛为纯表
            had_expandable = True

            def_map = _query_object_definitions(views, funcs, db_name, timeout=timeout, debug=debug)
            dependency_map = _query_view_dependencies(views, db_name, timeout=timeout, debug=debug)
            objects = []
            new_objs = []
            # 已访问对象不再重复生成定义，但其直接依赖必须传播给新的 UID。
            for schema, name in views:
                defs = def_map.get((schema, name), [])
                uids = obj_uids.get((schema, name), set())
                for uid_str in uids:
                    uid_objects.setdefault(uid_str, set()).add((schema, name))
                if (schema, name) in new_keys:
                    objects.append({'type': 'view', 'schema': schema, 'name': name,
                                    'signature': '', 'define_sql': '',
                                    'defs': defs,
                                    'errors': [] if defs else ['无法获取定义（权限不足/对象被删/查询失败）']})
                for owner, table_name in dependency_map.get((schema, name), []):
                    new_objs.append((owner, table_name, schema, uids))
            for schema, name in funcs:
                defs = def_map.get((schema, name), [])
                uids = obj_uids.get((schema, name), set())
                for uid_str in uids:
                    uid_objects.setdefault(uid_str, set()).add((schema, name))
                signature = _extract_routine_signature(defs[0]) if defs else ''
                if (schema, name) in new_keys:
                    objects.append({'type': 'function', 'schema': schema, 'name': name,
                                    'signature': signature, 'define_sql': '',
                                    'defs': defs,
                                    'errors': [] if defs else ['无法获取定义（权限不足/对象被删/查询失败）']})
            if objects:
                def_by_db.setdefault(db_name, []).append({'depth': depth, 'objects': objects})
            # 新对象去重后作为下一轮 frontier（同名对象合并 uid 集合）
            merged = {}  # (owner, name) -> [owner, name, default_user, uid_set]
            for o, t, d, u in new_objs:
                key = (o, t)
                if key in merged:
                    merged[key][3].update(u)
                else:
                    merged[key] = [o, t, d, set(u)]
            db_frontier[db_name] = [tuple(v) for v in merged.values()]
        if not had_expandable:
            break
    else:
        truncated = True  # 达到 max_depth 仍有新对象：可能循环依赖

    if debug:
        print(f"[DEBUG] 批量递归展开完成: uid 数={len(tables_by_uid)}, 定义库数={len(def_by_db)}, 深度超限={truncated}", file=sys.stderr)
    return tables_by_uid, def_by_db, uid_objects, truncated


def _format_wait_events_for_sqlhc(records):
    """把等待事件记录格式化为 SQLHC 文本块。

    每个 SQL 输出最大/最小执行时间点两条记录，分三部分:
      1. statement_history 记录  —— 指定业务列(_SH_COLS)一行输出 col=val | ...
      2. 执行计划 query_plan      —— 单独列出
      3. 等待事件 event_text      —— 单独列出 (statement_detail_decode 解码, 保留多行)

    Args:
        records: query_wait_events_for_sql_ids 返回的记录列表(含 pick 标签)

    Returns:
        str: 文本块；records 为空时返回空串
    """
    if not records:
        return ''

    def _oneline(v):
        return str(v if v is not None else '').replace('\r', ' ').replace('\n', ' ')

    max_recs = [r for r in records if str(r.get('pick', '')) == 'max']
    min_recs = [r for r in records if str(r.get('pick', '')) == 'min']
    # 兼容无 pick 标签的记录：按一条处理
    if not max_recs and not min_recs:
        max_recs = records[:1]

    groups = []  # [(标签, record)]
    if max_recs:
        groups.append(('最大执行时间点', max_recs[0]))
    if min_recs:
        groups.append(('最小执行时间点', min_recs[0]))
    if len(groups) == 1:
        # 时间范围内仅 1 条记录（最大/最小为同一次执行）
        groups = [('最大/最小执行时间点(同一次执行)', groups[0][1])]

    lines = ["================", "等待事件信息", "================"]

    # 1. statement_history 记录（指定业务列，一行输出）
    for tag, rec in groups:
        lines.append("")
        lines.append(f"------ statement_history 记录 ({tag}) ------")
        pairs = [f"{c}={_oneline(rec.get(c))}" for c in _SH_COLS if c in rec]
        lines.append(' | '.join(pairs) if pairs else '(无记录)')

    # 2. 执行计划 query_plan（单独列出，最大/最小各一个）
    for tag, rec in groups:
        lines.append("")
        lines.append(f"------ 执行计划 query_plan ({tag}) ------")
        plan = str(rec.get('query_plan', '') or '').strip('\r\n')
        lines.append(plan if plan else '(无执行计划)')

    # 3. 等待事件（单独列出，最大/最小各一个，保留原始多行）
    for tag, rec in groups:
        lines.append("")
        lines.append(f"------ 等待事件 ({tag}) ------")
        event_text = str(rec.get('event_text', '') or '').strip('\r\n')
        lines.append(event_text if event_text else '(无等待事件明细)')

    return '\n'.join(lines).rstrip()


def generate_sqlhc_content(unique_id, stat, db_name, timeout=120, wait_events_records=None, debug=False,
                           statement_stats_text=None, resolved_tables=None, tabstats_text=None, tabsize_text=None,
                           object_definitions=None):
    """生成单个 SQL 的 SQLHC 报告文本。

    信息收集参考 vb_tool v2.0.8 run_sqlhc:
      1. sqltext            —— 日志中提取（参数已填充）
      2. 执行统计            —— 日志侧统计（次数/耗时/锁等待）
      3. 等待事件信息        —— dbe_perf.statement_history（postgres 库）: 指定业务列一行输出，
                              query_plan 和等待事件(statement_detail_decode)单独列出，最大/最小各一条
      4. sqlstat            —— postgres 库: sqlstat from statement
      5. object definitions —— V2 新增: 视图/函数/存储过程完整定义（按递归层级），
                              并从定义中递归展开引用对象，直到收敛为纯表
      6. tabstat            —— SQL 执行的库: table/index/column/partition/subpartition/extended statistics
      7. tabsize            —— SQL 执行的库: table/indexes/toast/total size

    Args:
        unique_id: SQL 的 unique_query_id
        stat: 该 SQL 的统计信息字典（含 database/user/qry_text/max_duration_query 等）
        db_name: 数据库名（SQL 执行的库，用于表统计/表大小查询）
        timeout: vsql 超时时间
        wait_events_records: 该 SQL 的等待事件记录列表（query_wait_events_for_sql_ids 返回）
        debug: 是否打印调试日志
        statement_stats_text: 批量收集的 sqlstat 文本；None 时本函数内单查（回退）
        resolved_tables: 批量递归展开后的最终表列表 [(schema, table), ...]；
                         None 时本函数内提取并递归展开（回退）
        tabstats_text: 批量收集的 tabstat 文本；None 时本函数内单查（回退）
        tabsize_text: 批量收集的 tabsize 文本；None 时本函数内单查（回退）
        object_definitions: 批量递归展开的定义组 [{'depth','objects'}]；
                            None 且 resolved_tables 为 None 时回退路径自动执行递归展开

    Returns:
        str: 完整的 SQLHC 文本报告
    """
    lines = []
    lines.append("================")
    lines.append(f"SQLHC Report for unique_query_id: {unique_id}")
    lines.append("================")
    lines.append("")

    sql_text = stat.get('max_duration_query', '') or stat.get('qry_text', '')
    user = (stat.get('user') or 'public').strip().lower()
    if user == 'vastbase':
        user = 'public'
    if debug:
        print(f"[DEBUG] sqlhc[{unique_id}]: db={db_name}, user={user}, wait_events={len(wait_events_records or [])}", file=sys.stderr)

    # 1. SQL 文本（日志中获取，参数已填充）
    lines.append("================")
    lines.append(f"sqltext(database: {db_name}  user: {user})")
    lines.append("================")
    if sql_text.startswith('-- parameters:'):
        sql_text = re.sub(r'(\n)(?!-- )', '\n\n\n', sql_text, count=1)
    lines.append(sql_text)
    lines.append("")

    # 2. 执行统计（日志侧）
    lines.append("================")
    lines.append("Execution Statistics (from log)")
    lines.append("================")
    lines.append(f"Total calls : {stat.get('count', 0)}")
    lines.append(f"Sum duration: {stat.get('sum_duration', 0):.3f}s")
    lines.append(f"Avg duration: {stat.get('avg_duration', 0):.3f}s")
    lines.append(f"Max duration: {stat.get('max_duration', 0):.3f}s")
    lines.append(f"Min duration: {stat.get('min_duration', 0):.3f}s")
    lines.append(f"Stddev      : {stat.get('duration_stddev', 0):.3f}s")
    lines.append(f"Lock wait   : {stat.get('sum_lock_wait_time_ms', 0)/1000:.3f}s")
    lines.append("")

    # 3. 等待事件信息（postgres 库 dbe_perf.statement_history，
    #    最大/最小执行时间点各 1 条: 业务列一行输出 + query_plan 单独列出
    #    + statement_detail_decode 等待事件单独列出）
    wait_events_block = _format_wait_events_for_sqlhc(wait_events_records)
    if wait_events_block:
        lines.append(wait_events_block)
    else:
        lines.append("================")
        lines.append("等待事件信息")
        lines.append("================")
        lines.append("No wait events found in statement_history.")
    lines.append("")

    # 4. sqlstat（postgres 库: dbe_perf.statement 实时统计 / opt params）
    if statement_stats_text is not None:
        lines.append(statement_stats_text)
    else:
        lines.append(query_sqlhc_statement_stats(unique_id, timeout=timeout, debug=debug))
    lines.append("")

    # 5. object definitions + tabstat（V2：视图/函数定义 → 递归展开后的完整基表集合）
    if resolved_tables is not None:
        # 批量模式: 对象已在主流程完成"分类 → 定义 → 递归展开"
        tables = resolved_tables
        def_groups = object_definitions or []
        def_truncated = False
    else:
        # 回退路径: 本函数内执行完整"分类 → 定义 → 递归展开"流程
        objs0 = _extract_tables_from_sql(sql_text, default_user=user)
        if debug:
            print(f"[DEBUG] sqlhc[{unique_id}]: 提取对象数量={len(objs0)}, 默认 user={user}, objs={objs0}", file=sys.stderr)
        tables, def_groups, def_truncated = _expand_objects_recursive(
            objs0, db_name, timeout=timeout, debug=debug)
        # 展示用定义（多行原文）用 block 模式单独补采；失败则回退折叠版
        if def_groups:
            _batch_collect_object_definitions(
                {'_': def_groups}, timeout=timeout, debug=debug)
        if object_definitions is not None:
            def_groups = object_definitions

    definitions_block = _format_object_definitions(def_groups, def_truncated)
    if definitions_block:
        lines.append(definitions_block)
        lines.append("")

    if tables:
        lines.append(f"Tables found (递归展开后): {', '.join(f'{o}.{t}' for o, t in tables)}")
        lines.append("")
        if tabstats_text is not None:
            lines.append(tabstats_text)
        else:
            lines.append(query_sqlhc_tabstats(tables, db_name, timeout, debug=debug))
    else:
        lines.append("No tables extracted from SQL, skip table statistics.")
    lines.append("")

    # 6. tabsize（SQL 执行的库: 表/索引/toast 大小）
    if tables:
        if tabsize_text is not None:
            lines.append(tabsize_text)
        else:
            lines.append(query_sqlhc_tabsize(tables, db_name, timeout, debug=debug))
    else:
        lines.append("No tables extracted from SQL, skip table size.")
    lines.append("")

    return '\n'.join(lines)


