# _osw_netstat_one <interface> <file>  -- analyze ONE oswnetstat archive file.
# Prints the delta table for the given interface. Returns 1 on format/interface error.
_osw_netstat_one() {
    local INTERFACE="$1"
    local LOG_FILE="$2"

    if [[ ! -f "$LOG_FILE" ]]; then
        echo "Error: file not found: $LOG_FILE" >&2
        return 1
    fi

    # ---- transparent gzip -> temp file (POSIX-safe, no process substitution) ----
    local TMP_DATA
    TMP_DATA=$(mktemp /tmp/osw_netstat.XXXXXX) || { echo "Error: mktemp failed" >&2; return 1; }
    if [[ "$LOG_FILE" == *.gz ]]; then
        zcat "$LOG_FILE" > "$TMP_DATA" 2>/dev/null || { echo "Error: cannot zcat $LOG_FILE" >&2; rm -f "$TMP_DATA"; return 1; }
    else
        cat "$LOG_FILE" > "$TMP_DATA" 2>/dev/null || { echo "Error: cannot read $LOG_FILE" >&2; rm -f "$TMP_DATA"; return 1; }
    fi

    echo "|      Timestamp      | Interface | Direction |    Bytes    | Errors | Dropped | Overrun | TcpRetransSegs | TCPSynRetrans  | TCPLostRetransmit  | IpReasmFails  |"
    echo "|---------------------|-----------|-----------|-------------|--------|---------|---------|----------------|----------------|--------------------|---------------|"

    local previous_timestamp="" previous_rx_errors="" previous_rx_bytes="" previous_rx_dropped="" previous_rx_overrun=""
    local previous_tx_bytes="" previous_tx_errors="" previous_tx_dropped=""
    local current_timestamp="" current_rx_errors="" current_rx_bytes="" current_rx_dropped="" current_rx_overrun=""
    local current_tx_bytes="" current_tx_errors="" current_tx_dropped=""
    local prev_tcp_retrans_value=0 prev_syn_retrans_value=0 prev_lost_retrans_value=0 prev_ip_reasm_fails_value=0
    local tcp_retrans_value=0 syn_retrans_value=0 lost_retrans_value=0 ip_reasm_fails_value=0
    local in_interface_block=false
    local blocks_seen=0 rows_emitted=0
    local line new_timestamp data_line

    _osw_netstat_convert_ts() {
        # input: "Thu Aug 17 03:00:14 CST 2026" (inside zzz ***...***)
        local parsed_ts
        parsed_ts=$(echo "$1" | awk '{print $2" "$3" "$6" "$4}')
        date -d "$parsed_ts" +"%Y-%m-%d %H:%M:%S" 2>/dev/null
    }

    _osw_netstat_emit() {
        local rx_error_increment=$((current_rx_errors - previous_rx_errors))
        local rx_byte_increment=$((current_rx_bytes - previous_rx_bytes))
        local rx_dropped_increment=$((current_rx_dropped - previous_rx_dropped))
        local rx_overrun_increment=$((current_rx_overrun - previous_rx_overrun))
        local tx_byte_increment=$((current_tx_bytes - previous_tx_bytes))
        local tx_error_increment=$((current_tx_errors - previous_tx_errors))
        local tx_dropped_increment=$((current_tx_dropped - previous_tx_dropped))
        local tcp_retrans_increment=$((tcp_retrans_value - prev_tcp_retrans_value))
        local syn_retrans_increment=$((syn_retrans_value - prev_syn_retrans_value))
        local lost_retrans_increment=$((lost_retrans_value - prev_lost_retrans_value))
        local ip_reasm_increment=$((ip_reasm_fails_value - prev_ip_reasm_fails_value))
        # counter reset/restart (negative delta) -> show 0, not a bogus negative
        (( rx_byte_increment    < 0 )) && rx_byte_increment=0
        (( rx_error_increment   < 0 )) && rx_error_increment=0
        (( rx_dropped_increment < 0 )) && rx_dropped_increment=0
        (( rx_overrun_increment < 0 )) && rx_overrun_increment=0
        (( tx_byte_increment    < 0 )) && tx_byte_increment=0
        (( tx_error_increment   < 0 )) && tx_error_increment=0
        (( tx_dropped_increment < 0 )) && tx_dropped_increment=0
        (( tcp_retrans_increment  < 0 )) && tcp_retrans_increment=0
        (( syn_retrans_increment   < 0 )) && syn_retrans_increment=0
        (( lost_retrans_increment  < 0 )) && lost_retrans_increment=0
        (( ip_reasm_increment      < 0 )) && ip_reasm_increment=0
        printf "| %-19s | %-9s | %-9s | %-11d | %-6d | %-7d | %-7d | %-14d | %-14d | %-18d | %-13d |\n" \
            "$current_timestamp" "$INTERFACE" "RX" \
            "$rx_byte_increment" "$rx_error_increment" "$rx_dropped_increment" "$rx_overrun_increment" \
            "$tcp_retrans_increment" "$syn_retrans_increment" "$lost_retrans_increment" "$ip_reasm_increment"
        printf "| %-19s | %-9s | %-9s | %-11d | %-6d | %-7d | %-7s | %-14d | %-14d | %-18d | %-13d |\n" \
            "$current_timestamp" "$INTERFACE" "TX" \
            "$tx_byte_increment" "$tx_error_increment" "$tx_dropped_increment" "-" \
            "$tcp_retrans_increment" "$syn_retrans_increment" "$lost_retrans_increment" "$ip_reasm_increment"
        rows_emitted=$((rows_emitted + 1))
    }

    while IFS= read -r line; do
        # ---- timestamp: v8.x bare "YYYY-MM-DD HH:MM:SS" (anchored full line) ----
        if [[ "$line" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}:[0-9]{2}$ ]]; then
            new_timestamp="$line"
        # ---- classic "zzz ***Thu Aug 17 03:00:14 CST 2006***" (any case of zzz).
        # OSWbb v8.4 writes the SAME line WITHOUT the closing asterisks
        # ("zzz ***Wed Aug 26 14:00:03 CST 2026") -- accept both ----
        elif [[ "$line" =~ ^[Zz][Zz][Zz][[:space:]]+\*\*\*(.*)$ ]]; then
            new_timestamp=$(_osw_netstat_convert_ts "${BASH_REMATCH[1]%\*\*\*}")
        else
            new_timestamp=""
        fi

        if [[ -n "$new_timestamp" ]]; then
            blocks_seen=$((blocks_seen + 1))
            if [[ -n "$current_timestamp" && -n "$current_rx_errors" && -n "$current_tx_errors" ]]; then
                if [[ -n "$previous_timestamp" ]]; then
                    _osw_netstat_emit
                fi
                previous_timestamp="$current_timestamp"
                previous_rx_errors="$current_rx_errors"
                previous_rx_bytes="$current_rx_bytes"
                previous_rx_dropped="$current_rx_dropped"
                previous_rx_overrun="$current_rx_overrun"
                previous_tx_bytes="$current_tx_bytes"
                previous_tx_errors="$current_tx_errors"
                previous_tx_dropped="$current_tx_dropped"
                prev_tcp_retrans_value="$tcp_retrans_value"
                prev_syn_retrans_value="$syn_retrans_value"
                prev_lost_retrans_value="$lost_retrans_value"
                prev_ip_reasm_fails_value="$ip_reasm_fails_value"
            fi
            current_timestamp="$new_timestamp"
            in_interface_block=false
            continue
        fi

        if [[ "$line" =~ ^[0-9]+:\ $INTERFACE: ]]; then
            in_interface_block=true
            continue
        fi

        if [[ "$in_interface_block" == true ]]; then
            if [[ "$line" =~ ^[[:space:]]+RX:[[:space:]]+bytes ]]; then
                IFS= read -r data_line
                current_rx_bytes=$(echo "$data_line" | awk '{print $1}')
                current_rx_errors=$(echo "$data_line" | awk '{print $3}')
                current_rx_dropped=$(echo "$data_line" | awk '{print $4}')
                current_rx_overrun=$(echo "$data_line" | awk '{print $5}')
                continue
            fi
            if [[ "$line" =~ ^[[:space:]]+TX:[[:space:]]+bytes ]]; then
                IFS= read -r data_line
                current_tx_bytes=$(echo "$data_line" | awk '{print $1}')
                current_tx_errors=$(echo "$data_line" | awk '{print $3}')
                current_tx_dropped=$(echo "$data_line" | awk '{print $4}')
                in_interface_block=false
                continue
            fi
        fi

        if [[ "$line" =~ ^TcpRetransSegs[[:space:]]+([0-9]+) ]]; then
            tcp_retrans_value="${BASH_REMATCH[1]}"
            continue
        fi
        if [[ "$line" =~ ^TcpExtTCPSynRetrans[[:space:]]+([0-9]+) ]]; then
            syn_retrans_value="${BASH_REMATCH[1]}"
            continue
        fi
        if [[ "$line" =~ ^TcpExtTCPLostRetransmit[[:space:]]+([0-9]+) ]]; then
            lost_retrans_value="${BASH_REMATCH[1]}"
            continue
        fi
        if [[ "$line" =~ ^IpReasmFails[[:space:]]+([0-9]+) ]]; then
            ip_reasm_fails_value="${BASH_REMATCH[1]}"
            continue
        fi
    done < "$TMP_DATA"

    # ---- flush last block ----
    if [[ -n "$current_timestamp" && -n "$previous_timestamp" && -n "$current_rx_errors" && -n "$current_tx_errors" ]]; then
        _osw_netstat_emit
    fi
    rm -f "$TMP_DATA"

    if [[ "$blocks_seen" -eq 0 ]]; then
        echo "Error: no timestamp blocks recognized in $LOG_FILE (unknown OSW format?)" >&2
        return 1
    fi
    if [[ "$rows_emitted" -eq 0 ]]; then
        echo "Error: interface '$INTERFACE' not found in any timestamp block of $LOG_FILE" >&2
        return 1
    fi
    return 0
}

run_osw_netstat() {
    if [[ $# -ne 2 ]]; then
        echo "Error: osw_netstat requires <interface> and <file|dir>" >&2
        return 1
    fi
    local INTERFACE="$1" TARGET="$2"
    local rc=0 f

    if [[ -d "$TARGET" ]]; then
        # directory: analyze every netstat archive in filename order
        local files=()
        while IFS= read -r f; do
            files+=("$f")
        done < <(ls -1 "$TARGET" | grep -E '_netstat_[0-9]{2}\.[0-9]{2}\.[0-9]{2}\.[0-9]{4}\.dat(\.gz)?$' | sort | sed "s|^|$TARGET/|")
        if [[ ${#files[@]} -eq 0 ]]; then
            echo "Error: no oswnetstat .dat/.gz files found in $TARGET" >&2
            return 1
        fi
        for f in "${files[@]}"; do
            echo ""
            echo "==== $f ===="
            _osw_netstat_one "$INTERFACE" "$f" || rc=1
        done
        return $rc
    elif [[ -f "$TARGET" ]]; then
        _osw_netstat_one "$INTERFACE" "$TARGET"
    else
        echo "Error: not a file or directory: $TARGET" >&2
        return 1
    fi
}

