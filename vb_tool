def text_replay(win, repl_dir=None):
    """awrrpt 'Wal Receiver' table as a screen report (standby role):
    per-minute pg_stat_get_wal_receiver samples -- same source, fields and
    order as the html Replication sub-table. Every minute is shown (the html
    walrcv table has no healthy-minute hiding, unlike repl stat); null/error
    sampler minutes render as gap rows. lag = LSN byte distance: Net =
    sender_sent-received, Fsync = received-flush, Apply = flush-replay,
    Total = sender_sent-replay."""
    lines = _text_banner("awr replay detail", win)
    m = win["meta"]
    wr = load_walrcv_samples(repl_dir, m.get("begin_ts", ""), m.get("end_ts", ""))
    if not wr["files"]:
        lines.append("(no walreceiver samples in this period -- the sampler runs")
        lines.append(" while 'awr enable' is on)")
        return 0, "\n".join(lines)
    rows = sorted(wr["rows"], key=lambda r: r[0])   # stable: same-minute rows keep order
    if wr["n_data"] == 0:
        lines.append("(no walreceiver at any sample in this period")
        lines.append(" (%d samples: %d null, %d error))"
                     % (len(rows), wr["n_null"], wr["n_error"]))
        return 0, "\n".join(lines)
    headers = ["time", "state", "peer", "sent_lsn", "received_lsn", "flush_lsn",
               "replay_lsn", "net_lag", "fsync_lag", "apply_lag", "total_lag",
               "sync%", "channel"]
    out = []
    for ts, kind, f in rows:
        if kind != "data":
            msg = ("(no walreceiver -- primary role or disconnected)" if kind == "null"
                   else "(sample error)")
            out.append([ts, msg] + [""] * 11)
            continue
        # f: 0 pid, 1 local_role, 2 peer_role, 3 peer_state, 4 state, 5 sent,
        #    6 sender_write, 7 sender_flush, 8 sender_replay, 9 received,
        #    10 receiver_write, 11 receiver_flush, 12 receiver_replay,
        #    13 sync_percent, 14 channel
        sent, received, flush, replay = f[5], f[9], f[11], f[12]
        L = [_lsn64(x) for x in (sent, received, flush, replay)]
        def _seg(i, j):
            a, b = L[i], L[j]
            return fmt_bytes(a - b) if (a is not None and b is not None and a >= b) else "n/a"
        out.append([ts, f[4], "%s/%s" % (f[2], f[3]), sent, received, flush, replay,
                    _seg(0, 1), _seg(1, 2), _seg(2, 3), _seg(0, 3), f[13], f[14]])
    lines.append(_text_table(headers, out,
                             align="l" * 7 + "r" * 4 + "r" + "l"))
    return 0, "\n".join(lines)

def text_tabstat(win, dbname, schema, table):
    """wdr_tabstat screen equivalent for one table (any database; the capture
    loops all datallowconn databases). Counters = window delta (negative ->
    '-'), alive/dead = END snap gauges."""
    lines = _text_banner("awr tabstat summary", win,
                         extra="db: %s  schema: %s  table: %s" % (dbname, schema, table))
    def _index(rows):
        idx = {}
        for r in rows:
            idx.setdefault((r.get("dbname", ""), r.get("schema", ""),
                            r.get("object", "")), []).append(r)
        return idx
    b = _index(win["db"][("begin", "object_tables")])
    e = _index(win["db"][("end", "object_tables")])
    key = (dbname, schema, table)
    if key not in b and key not in e:
        lines.append("(table '%s.%s.%s' not found in either snapshot's "
                     "object_tables capture)" % (dbname, schema, table))
        return 1, "\n".join(lines)
    def d(col):
        bv = sum(to_num(r.get(col, 0)) for r in b.get(key, []))
        ev = sum(to_num(r.get(col, 0)) for r in e.get(key, []))
        dv = ev - bv
        return dv if dv >= 0 else None
    def endv(col):
        rows = e.get(key, [])
        return sum(to_num(r.get(col, 0)) for r in rows) if rows else None
    def i(x):
        return "-" if x is None else "%d" % int(x)
    headers = ["seqscan", "idxscan", "ins", "upd", "del", "hotupd", "alive", "dead"]
    row = [i(d("seq_scan")), i(d("idx_scan")), i(d("n_tup_ins")), i(d("n_tup_upd")),
           i(d("n_tup_del")), i(d("n_tup_hot_upd")),
           i(endv("n_live_tup")), i(endv("n_dead_tup"))]
    lines.append(_text_table(headers, [row], align="r" * 8))
    if key not in b:
        lines.append("")
        lines.append("note: table absent in BEGIN snap -- deltas count from zero")
    return 0, "\n".join(lines)


def main():
    argv = sys.argv[1:]
    awr_dir = current_dir = single_dir = begin_dir = end_dir = out_html = ""
    awrdiff_dirs = []
    repl_dir = None
    text_section = None
    text_db = text_schema = text_table = text_event_name = None
    metric = "dbtime"
    top_n = 30
    n_given = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--awr" and i + 1 < len(argv):
            awr_dir = argv[i + 1]; i += 2
        elif a == "--current" and i + 1 < len(argv):
            current_dir = argv[i + 1]; i += 2
        elif a == "--single" and i + 1 < len(argv):
            single_dir = argv[i + 1]; i += 2
        elif a == "--begin" and i + 1 < len(argv):
            begin_dir = argv[i + 1]; i += 2
        elif a == "--end" and i + 1 < len(argv):
            end_dir = argv[i + 1]; i += 2
        elif a == "--repl-dir" and i + 1 < len(argv):
            repl_dir = argv[i + 1] or None; i += 2   # empty string == not supplied
        elif a == "--awrdiff" and i + 4 < len(argv):
            awrdiff_dirs = argv[i + 1:i + 5]; i += 5
        elif a == "-o" and i + 1 < len(argv):
            out_html = argv[i + 1]; i += 2
        elif a == "-m" and i + 1 < len(argv):
            metric = argv[i + 1]; i += 2
        elif a == "-n" and i + 1 < len(argv):
            try:
                top_n = int(argv[i + 1])
                n_given = True
            except ValueError:
                sys.stderr.write("Error: -n expects an integer, got %r\n" % argv[i + 1]); return 2
            i += 2
        elif a == "--text" and i + 1 < len(argv):
            text_section = argv[i + 1]; i += 2
        elif a == "--event" or (a == "-E" and i + 1 < len(argv)):
            if i + 1 >= len(argv):
                sys.stderr.write("Error: %s requires a value\n" % a); return 2
            text_event_name = argv[i + 1]; i += 2
        elif a == "--db" or (a == "-d" and i + 1 < len(argv)):
            if i + 1 >= len(argv):
                sys.stderr.write("Error: %s requires a value\n" % a); return 2
            text_db = argv[i + 1]; i += 2
        elif a == "--schema" or (a == "-s" and i + 1 < len(argv)):
            if i + 1 >= len(argv):
                sys.stderr.write("Error: %s requires a value\n" % a); return 2
            text_schema = argv[i + 1]; i += 2
        elif a == "--table" or (a == "-t" and i + 1 < len(argv)):
            if i + 1 >= len(argv):
                sys.stderr.write("Error: %s requires a value\n" % a); return 2
            text_table = argv[i + 1]; i += 2
        else:
            i += 1

    def _default_html(meta):
        # default name: awr_{DB_NAME}_{BEGINTIME}_{ENDTIME}.html under awr_reports/
        _dn = meta.get("db_name") or meta.get("name") or "unknown"
        _dn = "".join(c for c in str(_dn) if c.isalnum() or c in "_-") or "unknown"
        _b = str(meta.get("begin_ts", "")).replace("-", "").replace(":", "").replace(" ", "")
        _e = str(meta.get("end_ts", "")).replace("-", "").replace(":", "").replace(" ", "")
        _reports_dir = os.path.join(os.path.expanduser(os.environ.get("VB_TOOL_HOME", "~/.vb_tool")),
                                    "awr_reports")
        return os.path.join(_reports_dir, "awr_%s_%s_%s.html" % (_dn, _b, _e))

    def _default_awrdiff_html(meta1, meta2):
        # awrdiff_{DB}_{P1_begin}_{P2_begin}.html (each period identified by begin ts)
        _dn = meta2.get("db_name") or meta1.get("db_name") or "unknown"
        _dn = "".join(c for c in str(_dn) if c.isalnum() or c in "_-") or "unknown"
        _p1 = str(meta1.get("begin_ts", "")).replace("-", "").replace(":", "").replace(" ", "")
        _p2 = str(meta2.get("begin_ts", "")).replace("-", "").replace(":", "").replace(" ", "")
        _reports_dir = os.path.join(os.path.expanduser(os.environ.get("VB_TOOL_HOME", "~/.vb_tool")),
                                    "awr_reports")
        return os.path.join(_reports_dir, "awrdiff_%s_%s_%s.html" % (_dn, _p1, _p2))

    if text_section:
        if not (begin_dir and end_dir):
            sys.stderr.write("Error: --text needs --begin DIR and --end DIR\n"); return 2
        if text_section not in ("topsql", "event", "summary", "tabstat",
                                "cpu", "io", "page", "replstat", "replslot",
                                "replay"):
            sys.stderr.write("Error: --text expects topsql|event|summary|tabstat"
                             "|cpu|io|page|replstat|replslot|replay\n"); return 2
        if not repl_dir:
            # per-minute series (os_*.log) live in the snapshot root,
            # next to the snap_<id> dirs the text reports are given
            repl_dir = os.path.dirname(os.path.abspath(begin_dir))
        win = build_window_from_snaps(begin_dir, end_dir)
        if text_section == "topsql":
            if not n_given:
                top_n = 10        # awr topsql default differs from awrrpt's 30
            if metric not in DIM_COLUMNS:
                sys.stderr.write("Error: -m expects one of %s, got %r\n"
                                 % ("|".join(DIM_COLUMNS), metric)); return 2
            rc, out = text_topsql(win, metric, top_n)
        elif text_section == "event":
            rc, out = text_event(win, text_event_name)
        elif text_section == "summary":
            rc, out = text_summary(win)
        elif text_section == "cpu":
            rc, out = text_cpu(win, repl_dir)
        elif text_section == "io":
            rc, out = text_io(win, repl_dir)
        elif text_section == "page":
            rc, out = text_page(win, repl_dir)
        elif text_section == "replstat":
            rc, out = text_replstat(win, repl_dir)
        elif text_section == "replslot":
            rc, out = text_replslot(win, repl_dir)
        elif text_section == "replay":
            rc, out = text_replay(win, repl_dir)
        else:
            if not (text_db and text_schema and text_table):
                sys.stderr.write("Error: --text tabstat needs --db NAME --schema NAME --table NAME\n"); return 2
            rc, out = text_tabstat(win, text_db, text_schema, text_table)
        sys.stdout.write(out + "\n")
        return rc
    if awrdiff_dirs:
        if len(awrdiff_dirs) != 4:
            sys.stderr.write("Error: --awrdiff needs 4 snap dirs: p1_begin p1_end p2_begin p2_end\n")
            sys.exit(2)
        w1 = build_window_from_snaps(awrdiff_dirs[0], awrdiff_dirs[1])
        w2 = build_window_from_snaps(awrdiff_dirs[2], awrdiff_dirs[3])
        if not out_html:
            out_html = _default_awrdiff_html(w1["meta"], w2["meta"])
        render_awrdiff(w1, w2, metric, top_n, out_html)
        return
    if begin_dir and end_dir:
        win = build_window_from_snaps(begin_dir, end_dir)
        if not out_html:
            out_html = _default_html(win["meta"])
        render_single_awr(win, metric, top_n, out_html, repl_dir=repl_dir)
        return
    if single_dir:
        win = load_window(single_dir)
        if not out_html:
            out_html = _default_html(win["meta"])
        render_single_awr(win, metric, top_n, out_html)
        return
    if not awr_dir or not current_dir:
        sys.stderr.write("usage: compare_render.py --awr DIR --current DIR "
                         "[-m dbtime|cpu|io] [-n N] -o FILE\n"
                         "       compare_render.py --single DIR "
                         "[-m dbtime|cpu|io] [-n N] [-o FILE]\n"
                         "       compare_render.py --begin DIR --end DIR "
                         "[-m dbtime|cpu|io] [-n N] [--repl-dir DIR] [-o FILE]\n"
                         "       compare_render.py --awrdiff D1 D2 D3 D4 "
                         "(p1_begin p1_end p2_begin p2_end) [-m ..] [-n N] [-o FILE]\n")
        sys.exit(2)
    render(awr_dir, current_dir, metric, top_n, out_html)

if __name__ == "__main__":
    sys.exit(main())
