            # $PGHOME, then "reg other"). NO separate Deleted rows: a reg
            # row's count cells read "live(deleted deleted)" -- e.g.
            # "22(2 deleted)" -- and the delta column sums BOTH numbers
            # (live+deleted on each side). Old snaps carry the old flat role
            # classes (data files (base), device, ...): "device" folds into
            # "dev" in _fdmap, the remaining old classes render as reg
            # sub-rows via _FD_DISP's pretty names, and the reg top row is
            # recomputed as their sum when the collector row is absent.
            _FD_DISP = {"data files (base)": "Data Files (Base)",
                        "data files (global)": "Data Files (Global)",
                        "temp files": "Temp Files", "wal segments": "WAL Segments",
                        "tx status": "TX Status", "double write": "Double Write",
                        "cbm": "CBM", "pg logs": "PG Logs",
                        "lock files": "Lock Files", "reg other": "reg (other)"}
            _FD_TOP = ("reg", "pipe", "socket", "dev", "other")
            def _fd_cell(v, is_reg):
                # "live(deleted deleted)" for the reg family, plain otherwise
                return "%d(%d deleted)" % (v[0], v[1]) if is_reg else "%d" % v[0]
            def _fd_reg_subs(*maps):
                out = []
                for m in maps:
                    for k in m:
                        if k not in _FD_TOP and k not in out:
                            out.append(k)
                # hierarchical order: component-wise so children follow their
                # parent; "(other)" rows sort LAST within their sibling group
                # (user 2026-09-20 -- plain lexicographic put "(" before
                # every name); non-path buckets ("reg other") go last overall
                def _fd_path_key(k):
                    return tuple("\x7f" + c if c == "(other)" else c
                                 for c in k.strip("/").split("/"))
                out.sort(key=lambda k: (0, _fd_path_key(k)) if k.startswith("/") else (1, (k,)))
                return out
            def _fd_top(m, fc, subs):
                v = m.get(fc)
                if v is not None:
                    return v
                if fc == "reg":           # old snaps: no collector reg row
                    b = (0, 0)
                    for k in subs:
                        kb, ke = m.get(k, (0, 0))
                        b = (b[0] + kb, b[1] + ke)
                    return b
                return (0, 0)
            _subs = _fd_reg_subs(_fdb, _fde)
            _tb = _te = 0
            for _fc in _FD_TOP:
                _isreg = _fc == "reg"
                _b = _fd_top(_fdb, _fc, _subs); _e = _fd_top(_fde, _fc, _subs)
                _tb += _b[0] + _b[1]; _te += _e[0] + _e[1]
                parts.append('<tr><td>%s</td><td class="n">%s</td>'
                             '<td class="n">%s</td><td class="n">%+d</td></tr>'
                             % (esc("fd " + _fc), esc(_fd_cell(_b, _isreg)),
                                esc(_fd_cell(_e, _isreg)),
                                (_e[0] + _e[1]) - (_b[0] + _b[1])))
                if _isreg:
                    # user 2026-09-20: $PGDATA (PGBASE) and $PGHOME are THE two
                    # first-level reg trees; indent is relative to the shallowest
                    # ANCESTOR present among the rows -- a key whose parent is
                    # absent starts its own tree at level 0, so roots of
                    # different absolute depths (/data/vastdata vs /home/
                    # vastbase/vasthome_29407) both sit at the top, and
                    # version.cfg nests under its PGHOME root
                    _sset = set(_subs)
                    _dcache = {}
                    def _treedepth(k):
                        if k in _dcache:
                            return _dcache[k]
                        # nearest MEMBER ancestor (missing intermediates
                        # collapse, e.g. pg_location/<tbs> keys have no
                        # pg_location parent row yet must nest under $PGDATA);
                        # the "/"+ guard keeps slash-free keys terminating
                        p = k.rsplit("/", 1)[0]
                        while p and p not in _sset and "/" in p:
                            p = p.rsplit("/", 1)[0]
                        d = _treedepth(p) + 1 if p else 0
                        _dcache[k] = d
                        return d
                    for _s in _subs:
                        _sb = _fdb.get(_s, (0, 0)); _se = _fde.get(_s, (0, 0))
                        _pad = "%dem" % (2 + 2 * _treedepth(_s)) if _s.startswith("/") else "2em"
                        # user 2026-09-20: normal text color (was class=muted
                        # gray); indent kept for hierarchy
                        parts.append('<tr><td style="padding-left:%s">%s</td>'
                                     '<td class="n">%s</td><td class="n">%s</td><td class="n">%+d</td></tr>'
                                     % (_pad, esc("fd " + _FD_DISP.get(_s, _s)),
                                        esc(_fd_cell(_sb, True)), esc(_fd_cell(_se, True)),
                                        (_se[0] + _se[1]) - (_sb[0] + _sb[1])))
            parts.append('<tr><td><b>fd Total</b></td><td class="n"><b>%d</b></td>'
                         '<td class="n"><b>%d</b></td><td class="n"><b>%+d</b></td></tr>'
                         % (_tb, _te, _te - _tb))
        parts.append('</table>')
        # per-minute detail (user 2026-10-30): the former standalone TCP
        # Sockets section now lives here, folded by default exactly like CPU
        # utilization's per-minute detail, and carries the dbfd columns --
