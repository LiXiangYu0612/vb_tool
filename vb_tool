run_collect_log_param() {
    local param_name=$1
    # ★禁写死 /data/vastdata (2026-11-26): vb309=/data309、156 等布局各异, PGDATA
    #   未设时盲读固定路径会拿错实例的配置产出静默错数据。PGDATA 缺失时先从
    #   psql 问 data_directory; 两者都拿不到就放弃离线解析(不猜)。
    local pgdata_dir="${PGDATA:-}"
    local param_value=""

    # 1. Attempt retrieval via psql (Online Method)
    # -t: tuples only, -A: unaligned, -c: execute command
    param_value=$(psql -tAc "show $param_name" 2>/dev/null)
    if [ -z "$pgdata_dir" ]; then
        pgdata_dir=$(psql -tAc "show data_directory" 2>/dev/null)
    fi

    # 2. Fallback to configuration files if psql fails or returns empty (Offline Method)
    if [[ -z "$param_value" && -n "$pgdata_dir" ]]; then
        # Read files in reverse using 'tac' as PostgreSQL honors the last defined setting.
        # Search scope: postgresql.base.conf and postgresql.conf
        # GNU tac reverses each file separately keeping file order: main config
        # must come FIRST so its (reversed) definitions are found before base.conf
        param_value=$(tac "$pgdata_dir/postgresql.conf" "$pgdata_dir/postgresql.base.conf" 2>/dev/null | \
                      grep -E "^[[:space:]]*$param_name" | head -n 1 | \
                      sed -E "s/^[[:space:]]*$param_name[[:space:]]*=[[:space:]]*['\"]?([^'\"]*)['\"?].*/\1/")
    fi

    # 3. Path Resolution Logic (Append PGDATA if the value is a relative directory/file path)
    if [[ -n "$param_value" ]]; then
        if [[ "$param_name" == *"directory"* || "$param_name" == *"file"* ]]; then
            if [[ "$param_value" != /* && -n "$pgdata_dir" ]]; then
                param_value="$pgdata_dir/$param_value"
            fi
        fi
        echo "$param_value"
    else
        return 1 # Return non-zero status if parameter is not found
    fi
}


run_sqltext() {
    # SQL text may hold non-ASCII: keep python3 stdout UTF-8 even under LANG=C
    export PYTHONIOENCODING=utf-8
    local unique_id="$1"

    local gauss_log
    gauss_log="${GAUSSLOG:-}"
    if [[ -z "$gauss_log" ]]; then
        echo "Error: not found GAUSSLOG path" >&2
        return 1
    fi
    if [[ ! -d "$gauss_log" ]]; then
        echo "Error: GAUSSLOG path not exits: $gauss_log" >&2
        return 1
    fi

    local logfiles _sqlhc_lg_root
    # ★只在 pg_log 里找 (user's call 2026-10-10): unique_id 的 duration/STATEMENT
    #   行只可能出现在 pg_log; 原来整树 find 会把 asp_data/sql_monitor 的滚动日志
    #   卷进候选, 轻则白 grep, 重则把 pg_log 现行文件挤出 50 窗口(156 实测误报
    #   not found)。GAUSSLOG 直指 pg_log 本身的部署用自身兜底。
    _sqlhc_lg_root="$gauss_log/pg_log"
    [ -d "$_sqlhc_lg_root" ] || _sqlhc_lg_root="$gauss_log"
    logfiles=$(find "$_sqlhc_lg_root" \( -name "*.log" -o -name "*.log.gz" -o -name "*.csv" -o -name "*.csv.gz" \) -type f -printf '%T@ %p\n' 2>/dev/null | \
               sort -rn | \
               head -n 50 | \
               cut -d' ' -f2-)

    if [[ -z "$logfiles" ]]; then
        echo "Warning: $gauss_log not found postgresql log" >&2
        return 1
    fi

    # pre-filter by content: zgrep for .gz, grep for plain (grep treats gz as binary and misses)
    local grep_hits=""
    local _lf _hits_tmp
    _hits_tmp=$(mktemp /tmp/vb_tool_sqlhc_hits.XXXXXX)
    while IFS= read -r _lf; do
        [[ -z "$_lf" ]] && continue
        case "$_lf" in
            *.gz) zgrep -l "$unique_id" "$_lf" 2>/dev/null ;;
            *)    grep  -l "$unique_id" "$_lf" 2>/dev/null ;;
        esac
    done <<< "$logfiles" | sort -u > "$_hits_tmp"
    grep_hits=$(cat "$_hits_tmp")
    rm -f "$_hits_tmp"

    if [[ -z "$grep_hits" ]]; then
        echo "Error: not found unique_id=${unique_id} in any log file" >&2
        return 1
    fi

    local matched_logfiles
    matched_logfiles=$(echo "$logfiles" | grep -Fx -f <(echo "$grep_hits"))

    SQLHC_LOGFILES="$matched_logfiles" python3 - "$unique_id" << 'PYEOF'
import sys
import re
import unicodedata
import subprocess
import os

unique_id = sys.argv[1]
logfiles = os.environ.get('SQLHC_LOGFILES', '').strip().splitlines()

def get_log_line_prefix():
    try:
        p = subprocess.Popen(
            ['psql', '-t', '-A', '-c', "SHOW log_line_prefix", '-d', 'postgres'],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True
        )
        try:
            stdout, _ = p.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            p.kill(); p.communicate()
            return None
        if p.returncode == 0 and stdout.strip():
            return stdout.strip()
    except Exception:
        pass

    try:
        p = subprocess.Popen(
            ['psql', '-t', '-A', '-c', "SHOW config_file", '-d', 'postgres'],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True
        )
        try:
            stdout, _ = p.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            p.kill(); p.communicate()
            return None
        if p.returncode == 0:
            config_file = stdout.strip()
            if config_file and os.path.exists(config_file):
                with open(config_file, 'r') as f:
                    for line in f:
                        line = line.strip()
                        if line.startswith('log_line_prefix') and not line.startswith('#'):
                            parts = line.split('=', 1)
                            if len(parts) == 2:
                                return parts[1].strip().strip("'\"")
    except Exception:
        pass

    val = os.environ.get('PGLOG_LINE_PREFIX', '')
    if val:
        return val

    print("ERROR: Cannot determine log_line_prefix", file=sys.stderr)
    sys.exit(1)

def parse_log_line_prefix(prefix):
    PLACEHOLDER_PATTERNS = {
        '%m': (r'\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d+(?:\s+\S+)?', False),
        '%t': (r'\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}(?:\s+\S+)?',       False),
        '%u': (r'(\S+)',          True),
        '%d': (r'(\S+)',          True),
        '%p': (r'(\d+|\[\d+\])', True),
        '%h': (r'\S+',            False),
        '%r': (r'\S+',            False),
        '%l': (r'\d+',            False),
        '%s': (r'\S+',            False),
        '%c': (r'\S+',            False),
        '%x': (r'\S+',            False),
        '%v': (r'\S+',            False),
        '%n': (r'\S+',            False),
        '%i': (r'\S*',            False),
        '%e': (r'\S+',            False),
        '%q': (r'',               False),
        '%%': (r'%',              False),
    }
    regex_parts = []
    capture_order = []
    i = 0
    while i < len(prefix):
        if prefix[i] == '%' and i + 1 < len(prefix):
            ph = prefix[i:i+2]
            if ph in PLACEHOLDER_PATTERNS:
                pat, capture = PLACEHOLDER_PATTERNS[ph]
            else:
                pat, capture = (r'\S+', False)
            regex_parts.append(pat)
            if capture:
                capture_order.append(ph)
            i += 2
        else:
            regex_parts.append(re.escape(prefix[i]))
            i += 1

    full_pattern = (
        r'^' +
        ''.join(regex_parts) +
        r'(?:\s+\d+)?'
        r'\s*(?:\[\w+\])?\s*'
        r'(?:LOG|ERROR|WARNING|FATAL|PANIC|DEBUG\d*|INFO|NOTICE|DETAIL)'
        r':\s+'
    )
    compiled = re.compile(full_pattern)

    user_idx = db_idx = pid_idx = None
    for idx, ph in enumerate(capture_order, 1):
        if ph == '%u' and user_idx is None: user_idx = idx
        elif ph == '%d' and db_idx   is None: db_idx   = idx
        elif ph == '%p' and pid_idx  is None: pid_idx  = idx

    if user_idx is None:
        print(f"ERROR: log_line_prefix '{prefix}' missing %u", file=sys.stderr)
        sys.exit(1)
    if db_idx is None:
        print(f"ERROR: log_line_prefix '{prefix}' missing %d", file=sys.stderr)
        sys.exit(1)

    return compiled, user_idx, db_idx, pid_idx

log_line_prefix = get_log_line_prefix()
header_re, user_idx, db_idx, pid_idx = parse_log_line_prefix(log_line_prefix)

def extract_meta(line):
    m = header_re.match(line)
    if not m:
        return 'unknown', 'unknown', None
    g = m.groups()
    db   = g[db_idx   - 1] if db_idx   <= len(g) else 'unknown'
    user = g[user_idx - 1] if user_idx <= len(g) else 'unknown'
    pid  = g[pid_idx  - 1].strip('[]') if (pid_idx and pid_idx <= len(g)) else None
    return db, user, pid

def normalize_user(user):
    return 'public' if user.lower() == 'vastbase' else user

def _split_ident(raw):
    """★引号感知的点号切分 (2026-09-28 修): 返回 [(文本, 是否带过引号), ...]。
    双引号内的点号**不是**分隔符, 引号本身不进入结果。
    老写法 raw.strip('"') 只去掉首尾引号, 于是:
      「"Sales".t1」 -> ['sales"', 't1']   schema 名里带一个残留双引号, 永远查不到
      「"sales".t1」 -> ['sales"', 't1']   同上(小写名写法也坏)
      「"a.b".t1」   -> ['a', 'b"', 't1']  schema 名本身带点时被切碎成三段
    大小写**一律折叠小写**(见 _q_ident); 注意下游 tabstat SQL 是按
    n.nspname / c.relname 原样大小写比较的, 库里若真有大小写敏感的 schema/表名会匹配不上
    —— 这是用户拍板的口径。"""
    out, cur, inq, qf = [], '', False, False
    for ch in raw:
        if ch == '"':
            inq = not inq
            qf = True
            continue
        if ch == '.' and not inq:
            out.append((cur, qf)); cur, qf = '', False
        else:
            cur += ch
    out.append((cur, qf))
    return out

def _q_ident(text, quoted):
    """标识符**一律折叠小写** (用户 2026-09-28 拍板: 「一律小写」)。
    ★严格按 PG 规则本该区分: 带引号的标识符大小写敏感(「"Sales".t1」指名为 Sales 的
    schema), 不带引号的才折叠小写; 这里按用户口径统一成全小写, 与本工具其它地方
    (库名/用户名一律 lower)一致。`quoted` 参数保留, 只为不改 _split_ident 的返回形状与
    两处调用点。"""
    return text.strip().lower()

KW_NEWLINE = re.compile(
    r'\b('
    r'SELECT|FROM'
    r'|LEFT\s+OUTER\s+JOIN|RIGHT\s+OUTER\s+JOIN|FULL\s+OUTER\s+JOIN'
    r'|LEFT\s+JOIN|RIGHT\s+JOIN|INNER\s+JOIN|CROSS\s+JOIN|JOIN'
    r'|WHERE|GROUP\s+BY|ORDER\s+BY|HAVING|LIMIT|OFFSET'
    r'|ON\b|SET|VALUES|INSERT\s+INTO|UPDATE|DELETE\s+FROM'
    r'|WITH|UNION\s+ALL|UNION|INTERSECT|EXCEPT'
    r')\b',
    re.IGNORECASE
)

def format_sql(sql):
    sql = ' '.join(sql.split())
    def repl(m):
        return '\n' + re.sub(r'\s+', ' ', m.group(0).upper())
    sql = KW_NEWLINE.sub(repl, sql)
    lines = [ln.strip() for ln in sql.split('\n')]
    return '\n'.join(ln for ln in lines if ln).strip()

def parse_params(text):
    # VastBase new log format appends " type = <typename>" after each parameter
    # value, e.g. "$1 = '100' type = bigint, $2 = 'x' type = varchar". Strip the
    # annotations first so old and new formats parse identically. The strip is
    # anchored on the quoted value ('' escapes included) and stops at the next
    # ", $N = " or end of line, so type names like numeric(10,2) survive intact
    # and values merely containing "type = " are never touched.
    text = re.sub(
        r"('(?:[^']|'')*'|NULL)\s*,?\s*type\s*=\s*.*?(?=\s*,\s*\$\d+\s*=|\s*$)",
        r"\1",
        text)
    result = {}
    token_re = re.compile(r'\$(\d+)\s*=\s*')
    matches = list(token_re.finditer(text))
    for k, m in enumerate(matches):
        idx = int(m.group(1))
        val_start = m.end()
        val_end   = matches[k + 1].start() if k + 1 < len(matches) else len(text)
        val = text[val_start:val_end].strip().rstrip(',').strip()
        result[idx] = val
    return result

def replace_params(sql, params):
    for idx in sorted(params.keys(), reverse=True):
        sql = sql.replace('$' + str(idx), params[idx])
    return sql

def display_width(s):
    w = 0
    for c in s:
        ea = unicodedata.east_asian_width(c)
        w += 2 if ea in ('W', 'F', 'A') else 1
    return w

def _explain_version_tuple(ver_str, _depth=0):
    """vb_version()/version.cfg 的 G100 版本串 -> (major, minor, patch)。
    ★vb_version() 是多行输出(204 实测): 同串含 'version:V3.0 (Build 8)' 与
    'openGauss version:6.0.0' —— 裸抓首个 X.Y.Z 会拿 6.0.0 误开 outline。
    优先解析专门的 'version:' 行; 没有才回落整串首个 X.Y.Z; 'V3.0 (Build 8)'
    形态映射 (3,0,8)。内核 'PostgreSQL 9.2.4' 类不认。"""
    if ver_str is None:
        return None
    if _depth == 0:
        mv = re.search(r'(?im)^\s*version:\s*(.+)$', ver_str)
        if mv:
            t = _explain_version_tuple(mv.group(1).strip(), 1)
            if t:
                return t
    m = re.search(r'(\d+)\.(\d+)\.(\d+)', ver_str)
    if m:
        return (int(m.group(1)), int(m.group(2)), int(m.group(3)))
    m = re.search(r'V(\d+)[^)]*?Build\s+(\d+)', ver_str, re.IGNORECASE)
    if m:
        return (int(m.group(1)), 0, int(m.group(2)))
    return None

def _psql_query(db, sql):
    try:
        p = subprocess.Popen(['psql', '-X', '-t', '-A', '-c', sql, '-d', db],
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                             universal_newlines=True)
        try:
            out, _ = p.communicate(timeout=10)
        except subprocess.TimeoutExpired:
            p.kill(); p.communicate(); return None
        return out.strip() if p.returncode == 0 else None
    except Exception:
        return None

_SQLTEXT_SCHEMA_CACHE = {}

def _lookup_schema(db_name, raw_user, uid):
    """按 unique_query_id 反查 statement_history.schema_name(=执行时 search_path 原串),
    按 PG 规则解析($user 展开/去引号/逐项验 pg_namespace, 取第一个真实存在的项)。
    与 sqlhc 的 lookup_schema 同规则同口径(用户 2026-10-11: sqltext 也要走反查);
    连接库先试语句自己的库再试 postgres(204 实测可见性怪癖), 失败/超时一律回落 None。"""
    uid = (uid or '').strip()
    if not uid.isdigit():
        return None
    key = (db_name, uid)
    if key in _SQLTEXT_SCHEMA_CACHE:
        return _SQLTEXT_SCHEMA_CACHE[key]
    resolved = None
    try:
        lit = uid.replace("'", "''")
        q = ("select schema_name from dbe_perf.statement_history "
             "where unique_query_id = '%s' and schema_name is not null "
             "order by start_time desc limit 1" % lit)
        rows = []
        for cand_db in ([db_name] if db_name == 'postgres' else [db_name, 'postgres']):
            rows = _psql_query(cand_db, q)
            if rows:
                break
        if rows:
            existing = set((_psql_query(db_name, "select nspname from pg_namespace")
                            or '').split())
            _sh_row = rows.splitlines()[0] if rows.splitlines() else ''
            for raw in _sh_row.split(','):
                cand = raw.strip().strip('"').strip()
                if not cand:
                    continue
                if cand == '$user':
                    cand = raw_user
                if cand in existing:
                    resolved = cand
                    break
    except Exception:
        resolved = None
    _SQLTEXT_SCHEMA_CACHE[key] = resolved
    return resolved

def _line_schema(line):
    """行内字面量 schema=xxx (用户 2026-10-11: 日志前缀写 dbname=x user=y schema=z)。
    没有则 None(204 前缀是占位符式, 无 schema 位)。"""
    m = re.search(r'(?:^|\s)schema=([^\s,]+)', line or '')
    return m.group(1) if m else None

def print_sql_text(db_name, user_name, sql_raw, params, line_schema=None):
    raw_user   = user_name.strip()               # 反查里 $user 的展开源(未 normalize)
    user_name  = normalize_user(user_name)
    sql_final  = replace_params(sql_raw, params) if params else sql_raw
    formatted  = format_sql(sql_final)

    title = f'sqltext(database: {db_name}  user: {user_name})'
    sep   = '=' * display_width(title)
    print(sep)
    print(title)
    print(sep)
    print(formatted)

    # ---- part 2: EXPLAIN in the parsed database (user's call 2026-10-11):
    # plain EXPLAIN only -- never ANALYZE, the statement is NOT executed.
    # vb_version() >= 3.0.9 -> explain (outline); below -> plain explain.
    # ★search_path 取值顺序与 sqlhc 对齐 (用户 2026-10-11): ① 按 unique_query_id
    #   反查 statement_history(执行时 search_path 原串, PG 规则解析) ② 日志行内
    #   schema=xxx 字面量 ③ SQL 首个限定表名推导 ④ 都无=会话默认。
    ver = None
    if db_name:
        ver = _psql_query(db_name, 'select vb_version()')
        vt = _explain_version_tuple(ver)
        if vt is None:
            # vb_version() absent/unparseable: fall back to version.cfg (the
            # `version` command's own fallback); kernel version() is never
            # trusted here (9.2.4 would wrongly pass the >=3.0.9 gate)
            try:
                gh = os.environ.get('GAUSSHOME', '')
                cfg = os.path.join(gh, 'version.cfg') if gh else ''
                if cfg and os.path.isfile(cfg):
                    vt = _explain_version_tuple(open(cfg, encoding='utf-8',
                                                     errors='replace').read(512))
            except Exception:
                pass
        outline = bool(vt and vt >= (3, 0, 9))
        # best-effort schema: log prefix carries no schema; take the first
        # schema-qualified table in the SQL itself so unqualified refs in the
        # same statement resolve. Plain-identifier schemas only (no injection).
        sp = ''
        msp = re.search(r'(?:from|join|update|into)\s+([A-Za-z_][\w$]*)\.',
                        sql_final, re.IGNORECASE)
        if msp:
            sp = msp.group(1)
        sh_schema = _lookup_schema(db_name, raw_user, unique_id)
        if sh_schema:
            sp = sh_schema            # ① statement_history 反查(sqlhc 同规则)
        elif line_schema:
            sp = line_schema          # ② 行内 schema=xxx 字面量
        env = dict(os.environ)
        if sp:
            # ★与 sqlhc 完全同口径 (SET search_path = <sp>, public): 反查/推导只拿到
            #   单个 schema(原 search_path 首个真实存在项 / SQL 首个限定表), 不补
            #   public 的话语句里未限定且落在 public 的表会误报 relation does not
            #   exist (204 实测红例: from s1.t_a join t_b -> search_path=s1 -> t_b 丢)。
            #   sp 已是 public 则不重复。
            sp_set = sp if sp.lower() == 'public' else sp + ',public'
            env['PGOPTIONS'] = (env.get('PGOPTIONS', '') +
                                (' ' if env.get('PGOPTIONS') else '') +
                                '-c search_path=' + sp_set).strip()
        sql_clean = sql_final.strip().rstrip(';').strip()
        if sql_clean:
            expl = ('explain (outline) ' if outline else 'explain ') + sql_clean
            # search_path 恒写: 没设也明示 (default), 不留"看不出设没设"的空位
            t2 = 'sqlplan(explain%s database: %s  search_path: %s)' % (
                ' outline' if outline else '', db_name, sp if sp else '(default)')
            print()
            print('=' * display_width(t2))
            print(t2)
            print('=' * display_width(t2))
            try:
                env['PGCONNECT_TIMEOUT'] = env.get('PGCONNECT_TIMEOUT') or '5'
                p = subprocess.Popen(['psql', '-X', '-P', 'footer=off',
                                      '-d', db_name, '-c', expl],
                                     env=env, universal_newlines=True)
                try:
                    p.communicate(timeout=60)
                except subprocess.TimeoutExpired:
                    p.kill(); p.communicate()
                    print('(explain timed out after 60s)', file=sys.stderr)
            except Exception as e:
                print('(explain failed: %s)' % e, file=sys.stderr)
    sys.exit(0)

uid_esc          = re.escape(unique_id)
duration_val_re  = re.compile(r'duration:\s+([\d.]+)\s+ms',  re.IGNORECASE)
queryid_re       = re.compile(r'\bqueryid\s+(\d+)',           re.IGNORECASE)

format1_re = re.compile(
    r'\bunique\s+id\s+' + uid_esc +
    r'\s+(?:bind|execute)\s+\S+:\s*(.+)$',
    re.IGNORECASE
)
format2_re = re.compile(
    r'(?:LOG|INFO):\s+(?:execute|bind)\s+\S+\s+unique\s+id\s+' + uid_esc +
    r'\s*:\s*(.+)$',
    re.IGNORECASE
)
format3_re = re.compile(
    r'(?:LOG|INFO):\s+duration:\s+([\d.]+)\s+ms'
    r'(?:\s+queryid\s+(\d+))?'
    r'.*?\bunique\s+id\s+' + uid_esc +
    r'\s+execute\s+\S+:\s*(.+)$',
    re.IGNORECASE
)
inline_statement_re = re.compile(
    r'(?:LOG|INFO):\s+duration:\s+([\d.]+)\s+ms'
    r'(?:\s+queryid\s+(\d+))?'
    r'.*?\bunique\s+id\s+' + uid_esc +
    r'\s+statement:\s+(.+)$',
    re.IGNORECASE
)
duration_only_re = re.compile(
    r'(?:LOG|INFO):\s+duration:.*?\bunique\s+id\s+' + uid_esc + r'\s*$',
    re.IGNORECASE
)
statement_re = re.compile(r'(?:LOG|INFO):\s+statement:\s+(.+)$', re.IGNORECASE)
detail_re    = re.compile(r'DETAIL:\s+parameters:\s+(.+)$',       re.IGNORECASE)

_READ_LOG_MAX_BYTES = 2 * 1024 * 1024 * 1024  # 2GB guard, same as analyze v2
_READ_LOG_BACK  = 10001                       # lines kept before the hit (the look-back scans <=10000)
_READ_LOG_AHEAD = 20000                       # lines kept after the hit

def read_log_lines(path, needle):
    """Return ONLY a bounded slice around the FIRST line of `path` that contains
    `needle`: the `_READ_LOG_BACK` lines before it, that line, and the
    `_READ_LOG_AHEAD` lines after it. Both callers stop at the first match
    (their print_sql_text/print_result ends in sys.exit(0)) and the look-back
    scan reaches at most 10000 lines, so the slice is all they ever touch.

    Peak memory is O(back+ahead) lines, NOT O(file): the old fh.read(2GB)
    allocated a 2GB buffer up front (MemoryError on a host with <2GB free, which
    the caller swallowed as "unique_id not found"), and any whole-file read
    would hold a multi-GB log in RAM. An over-size file is rejected by SIZE
    (O(1) for plain files; a .gz is counted while streaming)."""
    import gzip
    import os
    from collections import deque
    is_gz = path.endswith('.gz')
    if not is_gz:
        try:
            if os.path.getsize(path) >= _READ_LOG_MAX_BYTES:
                print("Error: %s is too large (>= %d bytes); truncate or split it first"
                      % (path, _READ_LOG_MAX_BYTES), file=sys.stderr)
                sys.exit(1)
        except OSError:
            pass
    opener = gzip.open if is_gz else open

    # Log files may be UTF-8 (default), GB18030/GBK (Chinese sites) or anything
    # else; decode per line (a 0x0A newline never falls inside a multi-byte
    # sequence), latin-1 is the never-fail fallback.
    def _decode(bl):
        for enc in ('utf-8', 'gb18030'):
            try:
                return bl.decode(enc)
            except (UnicodeDecodeError, ValueError):
                continue
        return bl.decode('latin-1')

    win = deque(maxlen=_READ_LOG_BACK)
    total = 0
    hit_line = None
    tail = []
    with opener(path, 'rb') as fh:
        for bl in fh:
            total += len(bl)
            if total >= _READ_LOG_MAX_BYTES:
                print("Error: %s is too large (>= %d bytes); truncate or split it first"
                      % (path, _READ_LOG_MAX_BYTES), file=sys.stderr)
                sys.exit(1)
            line = _decode(bl).rstrip('\r\n')
            if hit_line is None:
                if needle in line:
                    hit_line = line
                else:
                    win.append(line)
                continue
            tail.append(line)
            if len(tail) >= _READ_LOG_AHEAD:
                break
    if hit_line is None:
        return []
    return list(win) + [hit_line] + tail

for logfile in logfiles:
    try:
        lines = read_log_lines(logfile, unique_id)
    except Exception:
        continue

    n = len(lines)

    for i, line in enumerate(lines):
        if unique_id not in line:
            continue

        def collect_sql_and_params(start_idx, sql_body):
            cont = []
            detail_text = None
            j = start_idx
            while j < n:
                ln = lines[j]
                dp = detail_re.search(ln)
                if dp:
                    detail_text = dp.group(1)
                    j += 1
                    while j < n and not header_re.match(lines[j]):
                        if not detail_re.search(lines[j]):
                            detail_text += lines[j]
                        j += 1
                    break
                if header_re.match(ln):
                    break
                cont.append(ln.strip())
                j += 1
            full_sql = ' '.join([sql_body] + [c for c in cont if c])
            params = parse_params(detail_text) if detail_text else None
            return full_sql, params

        m3 = format3_re.search(line)
        if m3:
            db_name, user_name, _ = extract_meta(line)
            sql_body = m3.group(3).strip()
            full_sql, params = collect_sql_and_params(i + 1, sql_body)
            print_sql_text(db_name, user_name, full_sql, params, _line_schema(line))

        m_inline = inline_statement_re.search(line) if not m3 else None
        if m_inline:
            db_name, user_name, _ = extract_meta(line)
            sql_body = m_inline.group(3).strip()
            full_sql, _ = collect_sql_and_params(i + 1, sql_body)
            print_sql_text(db_name, user_name, full_sql, None, _line_schema(line))

        m1 = format1_re.search(line) if not (m3 or m_inline) else None
        m2 = format2_re.search(line) if (not m1 and not m3 and not m_inline) else None
        m_exec = m1 or m2

        if m_exec:
            db_name, user_name, _ = extract_meta(line)
            sql_body = m_exec.group(1).strip()
            full_sql, params = collect_sql_and_params(i + 1, sql_body)
            print_sql_text(db_name, user_name, full_sql, params, _line_schema(line))

        elif duration_only_re.search(line) and not (m3 or m_inline):
            db_name, user_name, pid = extract_meta(line)
            full_sql = None
            for j in range(i - 1, max(i - 10000, -1), -1):
                prev = lines[j]
                if pid:
                    _, _, prev_pid = extract_meta(prev)
                    if prev_pid and prev_pid != pid:
                        continue
                sm = statement_re.search(prev)
                if sm:
                    sql_head = sm.group(1).strip()
                    cont = []
                    for k in range(j + 1, i):
                        if header_re.match(lines[k]):
                            break
                        cont.append(lines[k].strip())
                    full_sql = ' '.join([sql_head] + cont)
                    break
            if full_sql:
                print_sql_text(db_name, user_name, full_sql, None, _line_schema(line))

print(f"not found unique_id: {unique_id}", file=sys.stderr)
sys.exit(1)
PYEOF

    local py_exit=$?
    if [[ $py_exit -ne 0 ]]; then
        echo "Error: failed to parse log for unique_id=${unique_id}" >&2
        return 1
    fi
}

run_collect_log_cmdn() {
    local begin_time="$1"
    local end_time="$2"
    local output_dir="$3"

    # Define a helper to process and back up leaf nodes
    # Usage: process_leaf <absolute_path> <relative_path> <target_root>
    process_leaf() {
        local leaf_path="$1"
        local rel_path="$2"
        local dst_root="$3"

        # 1. Independent Cut-off Calibration
        # Locate the first file modified after end_time to ensure continuity
        local first_after
        first_after=$(find "$leaf_path" -maxdepth 1 -type f -newermt "$end_time" -printf '%T@ %p\n' 2>/dev/null | sort -n | head -n 1 | cut -d' ' -f2-)
        
        local final_cutoff="$end_time"
        [[ -n "$first_after" ]] && final_cutoff=$(stat -c '%y' "$first_after")

        # 2. Execution of Copy via Relative Pathing
        # Using -exec ... + minimizes process forks for better throughput
        (
            cd "$GAUSSLOG" || exit
            find "$rel_path" -maxdepth 1 -type f -newermt "$begin_time" ! -newermt "$final_cutoff" \
                -exec cp --parents -t "$dst_root" {} + 2>/dev/null
        )
    }

    echo "[INFO ] Initiating hierarchical log harvest from $GAUSSLOG..."
    # Identify leaf directories (depth 1-3) and delegate to process_leaf
    # Logic: Find directories that contain files but no sub-directories
    # This replaces manual recursion with a highly optimized C-level scan
    while IFS= read -r dir; do
        [[ -z "$dir" ]] && continue
        
        # Determine category and destination
        local rel_dir="${dir#$GAUSSLOG/}"
        local top_level="${rel_dir%%/*}"
        local target_path="$output_dir/cmlog"
        
        [[ "$top_level" == "pg_log" ]] && target_path="$output_dir/pglog"
		[[ "$top_level" == "ffic_log" ]] && target_path="$output_dir/ffic_log"
        
        # Only process relevant categories: bin, cm, om, pg_log
        case "$top_level" in
            bin|cm|om|pg_log|ffic_log)
                process_leaf "$dir" "$rel_dir" "$target_path"
                ;;
        esac
    done < <(find "$GAUSSLOG" -mindepth 1 -maxdepth 3 -type d \
             -exec sh -c 'ls -d "$1"/*/ >/dev/null 2>&1 || echo "$1"' _ {} \;)
}

run_collect_log_xlog() {
    # Description: Collects PostgreSQL WAL (xlog) files within a specific time range,
    #              considering both local and archived directories.
	local begin_time="$1"
	local end_time="$2"
	local max_xlog="$3"
    local output_dir="$4"
    local temp_list=$(mktemp)

    # 1. Resolve WAL Source Path
    # Prioritizes custom configuration before falling back to default PGDATA locations.
    local wal_dir=$(run_collect_log_param "vb_wal_directory")
    [[ -z "$wal_dir" ]] && wal_dir="$PGDATA/pg_xlog"

    # 2. Establish WAL Filename Boundary
    # Converts the latest LSN to a 24-character hex string to filter out pre-allocated future files.
    local raw_lsn=$(pg_controldata | awk -F': +' '/Latest checkpoint location/ {print $2}')
    local lsn_high="${raw_lsn%/*}"
    local lsn_low="${raw_lsn#*/}"
	local lsn_low_padded=$(printf "%08s" "$lsn_low" | tr ' ' '0')
	# timeline from pg_controldata (hardcoded 1 missed every WAL after a
    # failover/PITR -- timeline>=2 names sort AFTER the boundary and got dropped)
	local tli=$(pg_controldata 2>/dev/null | awk -F': +' '/TimeLineID/ {print $2; exit}')
	[[ "$tli" =~ ^[0-9]+$ ]] || tli=1
	local boundary_wal=$(printf "%08X%08X000000%02X" "$tli" "0x$lsn_high" "0x${lsn_low_padded:0:2}")

    # 3. Timestamp Normalization (End Time Calibration)
    # Buffers the search window to ensure files modified shortly after the end_time are considered.
    local search_limit
    search_limit=$(date -d "@$(( $(date -d "$end_time" +%s) + 3600 ))" +"%Y-%m-%d %H:%M:%S")
    local adj_end_ts_raw
    adj_end_ts_raw=$(find "$wal_dir" -maxdepth 1 -type f -newermt "$end_time" ! -newermt "$search_limit" -printf "%T@\n" | sort -n | head -1)
    
    local adj_end_ts
    adj_end_ts=$( [[ -n "$adj_end_ts_raw" ]] && echo "${adj_end_ts_raw%.*}" || date -d "$end_time" +%s )

    # 4. Local WAL Discovery
    # Scans the active WAL directory and filters by the LSN boundary.
    find "$wal_dir" -maxdepth 1 -type f -newermt "$begin_time" ! -newermt "@$adj_end_ts" -printf "%f\t%p\n" | \
        awk -v boundary="$boundary_wal" '$1 <= boundary {print $2}' | \
        head -n "$max_xlog" > "$temp_list"

    # 5. Archive Retrieval Decision Logic
    # If the local count is insufficient and archive_mode is enabled, probe the archive repository.
    local current_count
    current_count=$(wc -l < "$temp_list")
    local archive_mode
    archive_mode=$(run_collect_log_param "archive_mode")

    if [[ "$archive_mode" == "on" && "$current_count" -lt "$max_xlog" ]]; then
        # Check if the earliest required WAL has already been recycled from local storage.
        local oldest_valid_local
        oldest_valid_local=$(find "$wal_dir" -maxdepth 1 -type f -not -newermt "$begin_time" -printf "%f\n" | \
            awk -v boundary="$boundary_wal" '$1 <= boundary {print $1}' | head -1)

        if [[ -z "$oldest_valid_local" ]]; then
            local arch_path=""
            local arch_dest
            arch_dest=$(run_collect_log_param "archive_dest")
            
            # Resolve archive path from destination or by parsing the archive command.
            if [[ -n "$arch_dest" ]]; then
                arch_path="$arch_dest"
            else
                local arch_cmd
                arch_cmd=$(run_collect_log_param "archive_command")
                # Extract path components (supports custom instance-based directory structures).
                if [[ "$arch_cmd" =~ "-B" ]]; then
                    local b_p=$(echo "$arch_cmd" | sed -n 's/.*-B \([^ ]*\).*/\1/p')
                    local inst=$(echo "$arch_cmd" | sed -n 's/.*--instance \([^ ]*\).*/\1/p')
                    arch_path="${b_p}/wal/${inst}"
                else
                    arch_path=$(echo "$arch_cmd" | awk '{print $3}' | xargs dirname 2>/dev/null)
                fi
            fi

            # Append segments found in the archive repository.
            if [[ -d "$arch_path" ]]; then
                find "$arch_path" -maxdepth 1 -type f -newermt "$begin_time" ! -newermt "@$adj_end_ts" | \
                    head -n "$((max_xlog - current_count))" >> "$temp_list"
            fi
        fi
    fi

    # 6. Consolidation and Compression
    local final_dir="$output_dir/xlog"
    mkdir -p "$final_dir"

    sort -u "$temp_list" | head -n "$max_xlog" | xargs -I {} cp -p {} "$final_dir/"

    # WAL segments stay as raw files under xlog/ (outermost bundle tar is the
    # single packaging step; the old inner tar.gz was created and immediately
    # deleted -- dead work, removed)
    if [[ -n "$(ls -A "$final_dir" 2>/dev/null)" ]]; then
        echo "[INFO ] Successfully collected $(ls "$final_dir" | wc -l) WAL segment(s)."
    else
        echo "[WARN ] No WAL segments found within the specified time range."
    fi

    rm -f "$temp_list"
}
